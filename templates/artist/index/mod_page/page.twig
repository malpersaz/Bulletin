{% extends "layouts/base.twig" %}

{% set d = ctx_get('d') %}
{% set list_root = ctx_get('list_root') %}
{% set parent_id_list = ctx_get('parent_id_list') %}
{% set list = ctx_get('list') %}
{% set parent_id_list_root = ctx_get('parent_id_list_root') %}
{% set res = ctx_get('res') %}
{% set dosya = ctx_get('file') %}
{% set altsayfalar = ctx_get('altsayfalar') %}
{% set contents = ctx_get('contents') %}

{% block title %}
    <title>{{ d.name }} - {{ site.title }}</title>
{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{ d.name }}",
  "description": "{{ d.content|striptags|slice(0, 160) }}",
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.title }}"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
    "@type": "ListItem",
    "position": 1,
    "name": "{{ lang.index.home }}",
    "item": "{{ site.sadres }}"
  },{
    "@type": "ListItem",
    "position": 2,
    "name": "{{ d.name }}"
  }]
}
</script>
{% endblock %}

{% block content %}
<div class="row mt-4" id="mod_page">
    <div class="col-lg-8 offset-lg-2">
        <article class="card shadow-sm border-0 overflow-hidden">
            <div class="card-header bg-body-secondary border-0 py-3 px-4">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0" itemscope itemtype="https://schema.org/BreadcrumbList">
                        <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                            <a itemprop="item" href="{{ site.sadres }}" class="text-decoration-none"><span itemprop="name">{{ lang.index.home }}</span></a>
                            <meta itemprop="position" content="1" />
                        </li>
                        <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                            <span itemprop="name">{{ d.name }}</span>
                            <meta itemprop="position" content="2" />
                        </li>
                    </ol>
                </nav>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
                    <h1 class="display-5 fw-bold text-akm-primary mb-0 border-start border-5 border-akm-primary ps-3">{{ d.name }}</h1>
                    <div class="btn-group shadow-sm rounded-pill overflow-hidden" role="group">
                        <a href="{{ site.sadres }}tools/saveHtml/mod_page/{{ d.id }}" class="btn btn-light border-end" data-bs-toggle="tooltip" title="{{ lang.index.mod_gallery.1 }}"><i class="bi bi-filetype-html"></i></a>
                        <a href="{{ site.sadres }}tools/saveText/mod_page/{{ d.id }}" class="btn btn-light border-end" data-bs-toggle="tooltip" title="{{ lang.index.mod_gallery.2 }}"><i class="bi bi-file-earmark-text"></i></a>
                        {% if res is not empty %}
                            <a href="{{ site.sadres }}tools/saveAll/mod_page/{{ d.id }}" class="btn btn-light border-end" data-bs-toggle="tooltip" title="{{ lang.index.mod_gallery.3 }}"><i class="bi bi-images"></i></a>
                        {% endif %}
                        <a href="javascript:void(0)" onclick="window.print();" class="btn btn-light" data-bs-toggle="tooltip" title="{{ lang.index.mod_gallery.4 }}"><i class="bi bi-printer"></i></a>
                    </div>
                </div>

                <div class="mb-4">
                    {% include "partials/share.twig" %}
                </div>

                <div id="akm_icerik" class="content-wrapper">
                    <div class="clearfix">
                        {% if d.image != '' %}
                            <div class="float-md-start me-md-4 mb-4 text-center" style="max-width: 400px;">
                                <a href="{{ site.radres }}mod_page/{{ d.image }}" data-bs-toggle="lightbox" data-gallery="page-main">
                                    <img src="{{ site.radres }}mod_page/{{ d.image }}" class="img-fluid rounded shadow-sm" alt="{{ d.name }}">
                                </a>
                            </div>
                        {% endif %}

                        {% if d.spot is defined and d.spot == 'y' and d.summary is not empty %}
                            <div class="alert-akm-primary mb-4 fs-5 fw-medium">
                                {{ d.summary }}
                            </div>
                        {% endif %}

                        <div class="content-body fs-5 lh-lg">
                            {{ d.content|raw }}
                        </div>
                    </div>
                </div>

                {# Image Gallery #}
                {% if res is not empty %}
                <section class="mt-5 pt-5 border-top">
                    <h2 class="h4 mb-4 fw-bold"><i class="bi bi-images me-2 text-akm-primary"></i>Resimler</h2>
                    <div class="row g-3" data-masonry='{"percentPosition": true }'>
                        {% for r in res %}
                            <div class="col-6 col-md-4">
                                <div class="card h-100 shadow-sm gallery-item border-0">
                                    <a href="{{ site.radres }}mod_gallery/mod_page/original/{{ r.url }}"
                                       data-bs-toggle="lightbox"
                                       data-gallery="multiimages"
                                       data-title="{{ r.name }}">
                                        <img src="{{ site.radres }}mod_gallery/mod_page/thumb/{{ r.url }}" class="card-img-top rounded" alt="{{ r.name }}" style="height: 200px; object-fit: cover;">
                                    </a>
                                    {% if r.name %}
                                        <div class="card-body p-2 text-center small text-muted">
                                            {{ r.name }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>
                {% endif %}

                {# Files and Subpages #}
                <div class="row mt-5 g-4">
                    {% if dosya is not empty %}
                    <div class="col-md-6">
                        <section class="card h-100 shadow-sm border-0 bg-light">
                            <div class="card-header bg-transparent py-3 border-0">
                                <h3 class="h6 mb-0 fw-bold text-akm-primary text-uppercase"><i class="bi bi-download me-2"></i>{{ lang.index.mod_page.1 }}</h3>
                            </div>
                            <div class="list-group list-group-flush bg-transparent">
                                {% for do in dosya %}
                                    <a href="{{ site.adres }}tools/saveFile/mod_page/{{ d.id }}/{{ do.id }}" class="list-group-item list-group-item-action d-flex align-items-center bg-transparent">
                                        <i class="bi bi-file-earmark-arrow-down me-2 text-secondary"></i>
                                        <span class="text-truncate">{{ do.name }}</span>
                                    </a>
                                {% endfor %}
                            </div>
                        </section>
                    </div>
                    {% endif %}

                    {% if altsayfalar is not empty %}
                    <div class="col-md-6">
                        <section class="card h-100 shadow-sm border-0 bg-light">
                            <div class="card-header bg-transparent py-3 border-0">
                                <h3 class="h6 mb-0 fw-bold text-akm-primary text-uppercase"><i class="bi bi-layers me-2"></i>{{ lang.index.mod_page.3 }}</h3>
                            </div>
                            <div class="list-group list-group-flush bg-transparent">
                                {% for sayfa in altsayfalar %}
                                    <a href="{{ site.sadres }}s/{{ sayfa.seo }}" class="list-group-item list-group-item-action bg-transparent" data-bs-toggle="tooltip" title="{{ sayfa.summary|striptags|slice(0, 100) }}">
                                        <i class="bi bi-file-text me-2 text-secondary"></i>
                                        {{ sayfa.name }}
                                    </a>
                                {% endfor %}
                            </div>
                        </section>
                    </div>
                    {% endif %}
                </div>

                {# Navigation Pages (Sidebar replacement) #}
                {% if list is not empty or parent_id_list is not empty %}
                <section class="mt-5 border-top pt-5">
                    <h3 class="h5 mb-4 fw-bold text-akm-primary"><i class="bi bi-folder2-open me-2"></i>Têkildar</h3>
                    <div class="row g-3">
                        {% for l in list %}
                            {% if list_root != l.id and l.lang == site.lang %}
                                <div class="col-md-4">
                                    <a href="{{ site.sadres }}s/{{ l.seo }}" class="card h-100 text-decoration-none hover-shadow transition-custom border-0 shadow-sm">
                                        <div class="card-body p-3 d-flex align-items-center">
                                            <i class="bi bi-link-45deg me-2 text-akm-primary"></i>
                                            <span class="text-dark fw-medium {% if d.seo == l.seo %} text-akm-primary{% endif %}">{{ l.name }}</span>
                                        </div>
                                    </a>
                                </div>
                            {% endif %}
                        {% endfor %}
                        {% if parent_id_list is not empty %}
                            {% for l in parent_id_list %}
                                {% if parent_id_list_root != l.id and l.lang == site.lang %}
                                    <div class="col-md-4">
                                        <a href="{{ site.sadres }}s/{{ l.seo }}" class="card h-100 text-decoration-none hover-shadow transition-custom border-0 shadow-sm">
                                            <div class="card-body p-3 d-flex align-items-center">
                                                <i class="bi bi-link-45deg me-2 text-akm-primary"></i>
                                                <span class="text-dark fw-medium {% if d.seo == l.seo %} text-akm-primary{% endif %}">{{ l.name }}</span>
                                            </div>
                                        </a>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    </div>
                </section>
                {% endif %}

                {# Related Content #}
                {% if contents is not empty %}
                <section class="mt-5 border-top pt-5">
                    <h3 class="h5 mb-4 fw-bold text-akm-primary"><i class="bi bi-journal-text me-2"></i>{{ lang.index.mod_page.2 }}</h3>
                    <div class="row g-3">
                        {% for content in contents %}
                            <div class="col-md-6">
                                <a href="{{ site.sadres }}article/{{ content.seo }}" target="_blank" class="card h-100 text-decoration-none hover-shadow transition-custom border-0 shadow-sm">
                                    <div class="card-body p-3 d-flex align-items-center">
                                        <i class="bi bi-journal-text me-3 fs-5 text-secondary"></i>
                                        <span class="fw-medium text-dark">{{ content.name }}</span>
                                    </div>
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </section>
                {% endif %}
            </div>
        </article>
    </div>
</div>
{% endblock %}

{% block js_custom %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    // Lightbox
    const lightbox = GLightbox({ selector: '[data-bs-toggle="lightbox"]' });
    
    // Masonry
    var grid = document.querySelector('[data-masonry]');
    if (grid) {
        imagesLoaded(grid, function() {
            new Masonry(grid, { percentPosition: true });
        });
    }

    // Tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    });
});
</script>
<style>
    .transition-custom { transition: all 0.3s ease; }
    .hover-shadow:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
</style>
{% endblock %}
