{% extends "layouts/base.twig" %}

{% block content %}

<div class="container py-5">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h2 class="display-5 fw-light">
                {{ lang.index.search.searchsonuc|format(kelime)|raw }}
            </h2>
            <div class="mt-2 text-muted small uppercase tracking-widest">{{ lang.index.search.results_found|default('Encam hatin dîtin') }}</div>
        </div>
    </div>

    <div class="row g-4">
        {% if contents is empty and announcements is empty and sayfalar is empty and videos is empty %}
            <div class="col-12 text-center py-5">
                <div class="py-5 glass-card rounded-4">
                    <i class="bi bi-search-heart display-1 text-muted opacity-25 mb-3"></i>
                    <p class="lead text-muted">{{ lang.index.search.not_found }}</p>
                </div>
            </div>
        {% endif %}

        {% if contents is not empty %}
            <div class="col-12 col-lg-6">
                <div class="p-4 glass-card rounded-4 shadow-sm border h-100">
                    <h5 class="mb-4 d-flex align-items-center">
                        <span class="p-2 bg-primary bg-opacity-10 text-primary rounded-3 me-3">
                            <i class="bi bi-journal-text"></i>
                        </span>
                        {{ lang.index.search.mod_content|format(kelime)|raw }}
                    </h5>
                    <div class="list-group list-group-flush custom-list">
                        {% for content in contents %}
                            <a href="{{ site.sadres }}article/{{ content.seo }}" 
                               class="list-group-item list-group-item-action border-0 px-0 py-3 d-flex align-items-center"
                               target="_blank">
                                <div class="flex-grow-1">
                                    <div class="fw-medium result-title">{{ content.name }}</div>
                                    {% if content.summary %}
                                        <div class="text-muted small text-truncate mt-1" style="max-width: 300px;">{{ content.summary|striptags }}</div>
                                    {% endif %}
                                </div>
                                <i class="bi bi-arrow-up-right text-muted ms-2 small"></i>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}

        {% if videos is not empty %}
            <div class="col-12 col-lg-6">
                <div class="p-4 glass-card rounded-4 shadow-sm border h-100">
                    <h5 class="mb-4 d-flex align-items-center">
                        <span class="p-2 bg-danger bg-opacity-10 text-danger rounded-3 me-3">
                            <i class="bi bi-play-btn"></i>
                        </span>
                        {{ lang.index.search.mod_video_embed|format(kelime)|raw }}
                    </h5>
                    <div class="list-group list-group-flush custom-list">
                        {% for video in videos %}
                            <a href="{{ site.sadres }}video/{{ video.id }}-{{ video.name|sefurl }}" 
                               class="list-group-item list-group-item-action border-0 px-0 py-3 d-flex align-items-center"
                               target="_blank">
                                <div class="p-2 bg-light bg-opacity-10 rounded-circle me-3">
                                    <i class="bi bi-play-fill text-danger"></i>
                                </div>
                                <div class="flex-grow-1 fw-medium result-title">{{ video.name }}</div>
                                <i class="bi bi-arrow-up-right text-muted ms-2 small"></i>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}

        {% if announcements is not empty %}
            <div class="col-12 col-lg-6">
                <div class="p-4 glass-card rounded-4 shadow-sm border h-100">
                    <h5 class="mb-4 d-flex align-items-center">
                        <span class="p-2 bg-success bg-opacity-10 text-success rounded-3 me-3">
                            <i class="bi bi-megaphone"></i>
                        </span>
                        {{ lang.index.search.mod_announcements|format(kelime)|raw }}
                    </h5>
                    <div class="list-group list-group-flush custom-list">
                        {% for announcement in announcements %}
                            <a href="{{ site.sadres }}announcement/{{ announcement.id }}-{{ announcement.name|sefurl }}" 
                               class="list-group-item list-group-item-action border-0 px-0 py-3 d-flex align-items-center"
                               target="_blank">
                                <div class="flex-grow-1 fw-medium result-title">{{ announcement.name }}</div>
                                <i class="bi bi-arrow-up-right text-muted ms-2 small"></i>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}

        {% if sayfalar is not empty %}
            <div class="col-12 col-lg-6">
                <div class="p-4 glass-card rounded-4 shadow-sm border h-100">
                    <h5 class="mb-4 d-flex align-items-center">
                        <span class="p-2 bg-info bg-opacity-10 text-info rounded-3 me-3">
                            <i class="bi bi-files"></i>
                        </span>
                        {{ lang.index.search.mod_page|format(kelime)|raw }}
                    </h5>
                    <div class="list-group list-group-flush custom-list">
                        {% for sayfa in sayfalar %}
                            <a href="{{ site.sadres }}s/{{ sayfa.seo }}" 
                               class="list-group-item list-group-item-action border-0 px-0 py-3 d-flex align-items-center"
                               target="_blank">
                                <div class="flex-grow-1 fw-medium result-title">{{ sayfa.name }}</div>
                                <i class="bi bi-arrow-up-right text-muted ms-2 small"></i>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.7) !important;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
    }

    [data-bs-theme="dark"] .glass-card {
        background: rgba(33, 37, 41, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
    }

    .custom-list .list-group-item {
        background: transparent !important;
        transition: all 0.2s ease;
        padding-left: 10px !important;
        padding-right: 10px !important;
        border-radius: 12px !important;
        margin-bottom: 4px;
    }

    .custom-list .list-group-item:hover {
        background: rgba(var(--bs-primary-rgb), 0.1) !important;
        transform: translateX(5px);
    }

    .result-title {
        color: var(--bs-body-color) !important;
    }
</style>
{% endblock %}
