<footer class="site-footer mt-auto mb-4">
    <div class="container">
        <div class="footer-floating-bar mx-auto py-2 px-4 shadow-lg d-flex align-items-center justify-content-between">
            <!-- Left: Brand & Copyright -->
            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <button class="footer-action-btn footer-copyright-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Copyright">
                        <i class="bi bi-c-circle fs-6"></i>
                    </button>
                    <ul class="dropdown-menu p-3 shadow-xl glass-dropdown">
                        <li>
                            <span class="dropdown-item-text text-wrap">
                                &copy; {{ site.established_year }} - {{ "now"|date("Y") }} <strong>{{ site.owner_name }}</strong>. {{ lang.index.copyright }}
                            </span>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><span class="dropdown-item-text small opacity-75">{{ lang.index.developer|raw }}</span></li>
                    </ul>
                </div>
            </div>

            <!-- Center: Social Icons (Most important for artists) -->
            {% if site.social_links is not empty %}
                <div class="footer-social-dock d-flex gap-2">
                    {% for link in site.social_links %}
                        {# LinkedIn neçalak e — ji bo çalakkirinê vê şîroveyê jê bibe #}
                        {% if link.platform|lower != 'linkedin' and link.url|trim is not empty %}
                        <a href="{{ link.url }}" class="social-dock-btn" target="_blank" title="{{ link.platform|capitalize }}">
                            <i class="{{ link.icon_class }}"></i>
                        </a>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}

            <!-- Right: Action / Contact Mini Toggle -->
            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <button class="footer-action-btn footer-contact-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="{{ lang.index.contact }}">
                        <i class="bi bi-info-circle fs-6"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end p-3 shadow-xl glass-dropdown">
                        {% if site.phone is not empty %}
                            <li><a class="dropdown-item mb-2" href="tel:{{ site.phone }}"><i class="bi bi-phone me-2 text-primary"></i> {{ site.phone }}</a></li>
                        {% endif %}
                        {% if site.whatsapp is not empty %}
                            <li><a class="dropdown-item mb-2" href="https://wa.me/{{ site.whatsapp }}"><i class="bi bi-whatsapp me-2 text-success"></i> WhatsApp</a></li>
                        {% endif %}
                        {% if site.mail is not empty %}
                            <li><a class="dropdown-item mb-2" href="mailto:{{ site.mail }}"><i class="bi bi-envelope me-2 text-info"></i> {{ site.mail }}</a></li>
                        {% endif %}
                        {% if site.office_address is not empty %}
                            <li><span class="dropdown-item-text small mb-2"><i class="bi bi-building me-2 text-warning"></i>{{ site.office_address|raw }}</span></li>
                        {% endif %}
                        {% if site.work_address is not empty %}
                            <li><span class="dropdown-item-text small mb-2"><i class="bi bi-geo-alt me-2 text-danger"></i>{{ site.work_address|raw }}</span></li>
                        {% endif %}
                        <li class="dropdown-divider"></li>
                        <li class="px-3 small opacity-75">{{ site.description }}</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</footer>

<!-- Footer CSS -->
<link rel="stylesheet" href="{{ site.tadres }}{{ site.app_template }}/static/css/footer.css?v={{ "now"|date("U") }}">
