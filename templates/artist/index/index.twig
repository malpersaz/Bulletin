{% extends "layouts/base.twig" %}

{% block css_custom %}
<style>
/* Slîderê bikin bingeha(paşxaneya) rûpelê (wekî soul dirb) */
body {
    background-image: none !important;
    height: 100vh;
    overflow: hidden;
}
main > .container {
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
}
#mainSlider, #mainSliderFallback {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -100;
    border-radius: 0;
    margin: 0 !important;
}
#mainSlider .carousel-inner,
#mainSlider .carousel-item {
    height: 100vh;
}
#mainSlider .carousel-item img, #mainSliderFallback img {
    height: 100vh;
    object-fit: cover;
    object-position: center;
}
.site-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 1030;
}
</style>
{% endblock %}

{% block js_custom %}
<script type="text/javascript">
$(document).ready(function() {
    // Bootstrap 5 ve jQuery çakışmasını aşmak için jQuery ile manuel başlatma
    var mainSlider = $('#mainSlider');
    if (mainSlider.length) {
        mainSlider.carousel({
            interval: 5000,
            wrap: true
        });
    }
});
</script>
{% endblock %}



{% block content %}
<!-- START: index/index.twig -->


    {# Include slider when needed #}
    {% include 'index/mod_slider/slider.twig' %}
    
    {# latest_content is hidden for artist template frontpage #}
    {# {% include 'index/mod_content/latest_content.twig' %} #}


    <!-- Homepage content -->
    <section class="row" id="orta">

        <article id="orta-sol" class="col-md-9">

        </article>
        <aside id="orta-sag" class="col-md-3">

        </aside>
    </section>
    
    {# Include bottom menu when needed #}
    {% include 'partials/bottom_menu.twig' %}
<!-- END: index/index.twig -->
{% endblock %}
