{# Slider verilerini çağıralım #}
{{ run({"mod": "index", "method": "_slider", "extra": [6]}) }}
{% set slider = ctx_get('slider') %}
{% if slider %}
<div id="mainSlider" class="carousel slide mb-4">
  <div class="carousel-inner">
    {% set slide = slider|first %}
    <div class="carousel-item active">
      {% if slide.url is not empty %}
        <!-- Kodê url yê resen wek data-original-href hat parastin -->
        <a href="javascript:void(0);" data-original-href="{{ slide.url }}" onclick="return false;" title="" {% if slide.target != 'y' %}target="_blank"{% endif %} style="cursor: default;">
      {% endif %}
        <picture>
          {% if slide.image_mobile %}
          <source media="(max-width: 767px)" srcset="{{ site.radres }}mod_slider/{{ slide.image_mobile }}">
          {% endif %}
          <img src="{{ site.radres }}mod_slider/{{ slide.image }}" class="d-block w-100" alt="" loading="lazy">
        </picture>
      {% if slide.url is not empty %}
        </a>
      {% endif %}
    </div>
  </div>
</div>
{% else %}
<div id="mainSliderFallback" class="mb-4">
  <img src="{{ site.tadres }}{{ site.app_template }}/static/img/bg.jpg" class="d-block w-100" alt="{{ site.title }}" loading="lazy">
</div>
{% endif %}