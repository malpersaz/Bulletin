{# Social Media Share Buttons Plugin #}
<div class="social-share d-print-none my-3">
    <div class="d-flex align-items-center gap-2">
        <span class="text-muted small fw-bold text-uppercase">{{ lang.index.share|default('Parve bike') }}:</span>
        
        {# Facebook #}
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ site.sadres }}article/{{ d.seo }}" 
           target="_blank" 
           class="btn btn-sm btn-outline-primary" 
           title="Facebook"
           aria-label="Share on Facebook">
            <i class="bi bi-facebook"></i>
        </a>

        {# X (Twitter) #}
        <a href="https://twitter.com/intent/tweet?text={{ d.name|url_encode }}&url={{ site.sadres }}article/{{ d.seo }}" 
           target="_blank" 
           class="btn btn-sm btn-outline-dark" 
           title="X (Twitter)"
           aria-label="Share on X">
            <i class="bi bi-twitter-x"></i>
        </a>

        {# WhatsApp #}
        <a href="https://api.whatsapp.com/send?text={{ d.name|url_encode }}%20{{ site.sadres }}article/{{ d.seo }}" 
           target="_blank" 
           class="btn btn-sm btn-outline-success" 
           title="WhatsApp"
           aria-label="Share on WhatsApp">
            <i class="bi bi-whatsapp"></i>
        </a>

        {# LinkedIn #}
        <!-- a href="https://www.linkedin.com/shareArticle?mini=true&url={{ site.sadres }}article/{{ d.seo }}&title={{ d.name|url_encode }}" 
           target="_blank" 
           class="btn btn-sm btn-outline-primary" 
           title="LinkedIn"
           aria-label="Share on LinkedIn">
            <i class="bi bi-linkedin"></i>
        </a -->

        {# Email #}
        <a href="mailto:?subject={{ d.name|url_encode }}&body={{ site.sadres }}article/{{ d.seo }}" 
           class="btn btn-sm btn-outline-secondary" 
           title="Email"
           aria-label="Share via Email">
            <i class="bi bi-envelope"></i>
        </a>
        
         {# Copy Link #}
        <button onclick="navigator.clipboard.writeText('{{ site.sadres }}article/{{ d.seo }}').then(() => alert('Lînk hat kopîkirin!'))" 
           class="btn btn-sm btn-outline-secondary" 
           title="Lînkê kopî bike"
           aria-label="Copy Link">
            <i class="bi bi-link-45deg"></i>
        </button>
    </div>
</div>
