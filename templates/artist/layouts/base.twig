<!DOCTYPE html>
<html lang="{{ site.lang }}" data-bs-theme="auto" class="h-100">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light dark">

		<script>
			// Early theme enforcement to prevent flicker
			(function() {
				const savedTheme = localStorage.getItem('theme');
				if (savedTheme) {
					document.documentElement.setAttribute('data-bs-theme', savedTheme);
				} else {
					// Fallback to cookie if exists
					const cookieTheme = document.cookie.match(/color_mode=([^;]+)/);
					if (cookieTheme) {
						document.documentElement.setAttribute('data-bs-theme', cookieTheme[1]);
					}
				}
			})();
		</script>
		{% block title %}
			<title>{{ site.title }}</title>
		{% endblock %}
		{% block description %}<meta name="description" content="{{ site.description }}">
		{% endblock %}
		{% block keywords %}<meta name="keywords" content="{{ site.keywords }}">
		{% endblock %}
		{% block canonical %}<link rel="canonical" href="{{ site.adres }}"/>
		{% endblock %}

		{% block meta_tags %}
			<!-- Standard Meta -->
			<meta name="author" content="{{ site.title }}">
			<meta name="robots" content="index, follow">
			<meta
			name="theme-color" content="#ffffff">

			<!-- Open Graph / Facebook -->
			<meta property="og:type" content="website">
			<meta property="og:url" content="{{ site.adres }}">
			<meta property="og:title" content="{{ site.title }}">
			<meta property="og:description" content="{{ site.description }}">
			<meta property="og:image" content="{{ site.radres }}mod_settings/logo.png">
			<meta property="og:site_name" content="{{ site.title }}">
			<meta
			property="og:locale" content="{{ site.lang }}_{{ site.lang|upper }}">

			<!-- Twitter -->
			<meta name="twitter:card" content="summary_large_image">
			<meta name="twitter:url" content="{{ site.adres }}">
			<meta name="twitter:title" content="{{ site.title }}">
			<meta name="twitter:description" content="{{ site.description }}">
			<meta name="twitter:image" content="{{ site.radres }}mod_settings/logo.png">
		{% endblock %}

		<base
		href="{{ site.adres }}">

		<!-- Favicons -->
		<link rel="icon" type="image/png" href="{{ site.radres }}mod_settings/favicon-96x96.png" sizes="96x96"/>
		<link rel="shortcut icon" href="{{ site.radres }}mod_settings/favicon.ico"/>
		<link rel="apple-touch-icon" sizes="180x180" href="{{ site.radres }}mod_settings/apple-touch-icon.png"/>
		<link
		rel="manifest" href="{{ site.adres }}static/mod_settings/site.webmanifest"/>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

		{% if site.lang != 'ar' and site.lang != 'ckb' %}
			<!-- Special Brand Font: Herr Von Muellerhoff -->
			<link href="https://fonts.googleapis.com/css2?family=Herr+Von+Muellerhoff&display=swap" rel="stylesheet">
			<style>
				.navbar-brand .brand-text, .footer-owner-name {
					font-family: 'Herr Von Muellerhoff', cursive !important;
					background: none !important;
					-webkit-text-fill-color: initial !important;
					line-height: 1;
					vertical-align: middle;
				}
				.navbar-brand .brand-text {
					color: var(--bs-body-color) !important;
					font-size: 2.2rem;
					letter-spacing: 0.05rem;
					white-space: nowrap;
				}
				.footer-owner-name {
					color: #ffffff !important;
					font-size: 1.5rem;
					margin-left: 5px;
				}
			</style>
		{% endif %}

		<!-- Bootstrap 5.3 CSS CDN -->
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
		<link
		rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css">

		<!-- Modern Eklenti CDN'leri -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.2.0/dist/css/glightbox.min.css">
		<link
		rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">

		<!-- Custom CSS -->
		<link rel="stylesheet" href="{{ site.tadres }}{{ site.app_template }}/static/css/custom.css?v={{ "now"|date("U") }}">

		{% block css_custom %}{% endblock %}
		{% block head %}{% endblock %}
	</head>
	<body class="d-flex flex-column h-100">

		{{ run({"mod": "index", "method": "_menu"}) }}
