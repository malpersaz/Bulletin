{% extends "management/admin-layout.twig" %}
{% block title %}{{ lang.mod_survey.edit }}{% endblock %}
{% block body %}
    {% if error is defined %}
        <div class="alert alert-danger">
            <strong>{{ lang.mod_survey.error }}</strong>  {{ mesaj }}
        </div>
    {% else %}
        <div class="portlet box green">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-edit"></i>{{ lang.mod_survey.edit }}
                </div>
            </div>
            <div class="portlet-body form">
                <!--  Mesajlar -->
                {% if oke is defined %}
                    <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
                    <div class="alert alert-success">
                        <strong>{{ lang.mod_survey.oke }}</strong> {{ mesaj }}
                    </div>
                    <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
                {% else %}
                    {% if hatalar is defined %}
                        <!--[if !IE]>Hata Mesajı Varsa<![endif]-->
                        {% for hata in hatalar %}
                            <div class="alert alert-danger">
                                <strong>{{ lang.mod_survey.hata }}</strong>  {{ hata }}
                            </div>
                        {% endfor %}
                        <!--[if !IE]>Hata Mesajı Varsa<![endif]-->
                    {% endif %}
                    <form method="POST"
                          action=""
                          id="edit"
                          enctype="multipart/form-data"
                          class="form-horizontal">
                        <div class="form-body">
                            <!-- İnputlar Başlar -->
                            <!--[if !IE]>lang Input Başlar<![endif]-->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_survey.admin.columns.lang }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge validate[required]"
                                                name="lang"
                                                id="lang">
                                            {% for item in lang_lang %}
                                                <option value="{{ item.seo }}"
                                                        {% if d.lang == item.seo %}selected="selected"{% endif %}>
                                                    {{ item.name }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!--[if !IE]>lang Input Biter<![endif]-->
                            <!--[if !IE]>acl_id Input Başlar<![endif]-->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_survey.admin.columns.acl_id }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control" name="acl_id" id="acl_id">
                                            <option value="0" {% if d.acl_id == 0 %}selected="selected"{% endif %}>{{ lang.mod_survey.choose_wish }}</option>
                                            {% for item in mod_acl_acl_id %}
                                                <option value="{{ item.id }}"
                                                        {% if d.acl_id == item.id %}selected="selected"{% endif %}>
                                                    {{ item.name }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!--[if !IE]>acl_id Input Biter<![endif]-->
                            <!--[if !IE]>soru Input Başlar<![endif]-->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_survey.admin.columns.soru }}  :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge validate[required,length[2,255]]"
                                               name="soru"
                                               value="{{ d.soru }}"
                                               type="text"
                                               id="soru">
                                    </div>
                                </div>
                            </div>
                            <!--[if !IE]>soru Input Biter<![endif]-->
                            <!--[if !IE]>Anket Seçenekleri Input Başlar<![endif]-->
                            <label>
                                {{ lang.mod_survey.admin.columns.anket_secenek }}
                                <input type="button" class="btn green" value=" + " onclick="alanekle();" />
                            </label>
                            <ol id="alan">
                                {% if s is defined %}
                                    {% for sec in s %}
                                        <li id="sil_{{ sec.id }}">
                                            <input class="form-control "
                                                   name="secenek[{{ sec.id }}]"
                                                   type="text"
                                                   id="koberz_{{ sec.id }}"
                                                   value="{{ sec.secenek }}" />
                                            <input type="button"
                                                   value="delete"
                                                   class="btn red"
                                                   onclick="sil('{{ sec.id }}');" />
                                        </li>
                                    {% endfor %}
                                {% endif %}
                            </ol>
                            <input type="hidden" name="sayac" id="sayac" value="{{ toplamsec }}">
                            <!--[if !IE]>Anket Seçenekleri Input Biter<![endif]-->
                            <!-- inputlar Biter -->
                        </div>
                        <!-- form body end -->
                        <div class="form-actions">
                            <div class="row">
                                <div class="col-md-offset-3 col-md-9">
                                    <!--[if !IE]>{# lang.mod_survey.button.edit #} Butonu<![endif]-->
                                    <button class="btn green"
                                            name="edit"
                                            value="{{ lang.mod_survey.button.edit }}">
                                        <span>{{ lang.mod_survey.button.edit }}</span>
                                    </button>
                                    <a class="btn blue" href="mod_survey/list">
                                        <span>{{ lang.mod_survey.button.vazgec }}</span>
                                    </a>
                                    <!--[if !IE]>{# lang.mod_survey.button.edit #} Butonu<![endif]-->
                                </div>
                            </div>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
{% block extra %}
    <script>
        $(document).ready(function() {
            $("#edit").validationEngine();


            function temizle(veri) {

                var temiz = veri.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, " ");
                temiz = temiz.replace(/^\s+|\s+$/g, "");

                for (i = 0; i <= 15; i ++) {
                    temiz = temiz.replace('  ', ' ');
                }
                return temiz;
            }

            // SEO YAPAR
            function make_seo(name, seo) {
                $("#" + name).change(
                        function () {
                            var deger = temizle($("#" + name).val());
                            deger = deger.replace(/\s+/g, "_");
                            deger = deger.replace('İ', 'i');

                            $("#" + seo).val(deger);
                        });
            }

            // Make keywords
            function make_keywords(name, keywords) {
                $("#" + name).change(
                        function () {
                            var deger = temizle($("#" + name).val());
                            deger = deger.replace(/\s+/g, ",");
                            deger = deger.toLowerCase();
                            deger = deger.replace('İ', 'i');

                            $("#" + keywords).val(deger);
                        });
            }

            // Make Title
            function make_title(name, title) {
                $("#" + name).change(
                        function () {
                            var deger = temizle($("#" + name).val());
                            $("#" + title).val(deger);
                        });
            }

            // Make Açıklama
            function make_aciklama(name, description) {
                $("#" + name).change(
                        function () {
                            var deger = temizle($("#" + name).val());
                            $("#" + description).val(deger);
                        });
            }

            // Make Preview
            function make_preview(name) {
                $("#" + name).change(function() {
                    $("#" + name + "_preview").html($("#" + name).val());
                });
            }


            var simdi = new Date();
            var yil = simdi.getFullYear();
            var ay = (simdi.getMonth() < 9 ? '0' : '') + (simdi.getMonth() + 1);
            var gun = (simdi.getDate() < 10 ? '0' : '') + simdi.getDate();
            var saat = (simdi.getHours() < 10 ? '0' : '') + simdi.getHours();
            var dakika = (simdi.getMinutes() < 10 ? '0' : '') + simdi.getMinutes();

            var now = yil + "-" + ay + "-" + gun + " " + saat + ":" + dakika;


        });
    </script>
    <!-- Javascript Başlar -->
    <script>
        function alanekle() {
            var s = parseInt($("#sayac").val()) + 1;


            $("#alan").append('<li id="sil_' + s + '">' +
            '<input class="form-control " name="secenek[]" type="text" id="koberz_' + s + '">' +
            '<input type="button" value="delete" onclick="sil(\'' + s + '\');" />' +
            '</li>');
            $("#sayac").val(s);
        }
        function sil(gel) {
            $('#koberz_' + gel).hide('slow').remove();
            $('#sil_' + gel).hide('slow').remove();
        }
        //-->
    </script>
    <!-- Javascript Biter -->
{% endblock %}
