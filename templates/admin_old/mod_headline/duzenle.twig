{% extends "management/admin-layout.twig" %}
{% block title %}
	{{ lang.mod_headline.edit }}
{% endblock %}
{% block body %}
	{% if error is defined %}
		<div class="alert alert-danger">
			<strong>{{ lang.mod_headline.error }}</strong>
			{{ mesaj }}
		</div>
	{% else %}
		<div class="portlet box green">
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-edit"></i>
					{{ lang.mod_headline.edit }}
				</div>
			</div>
			<div
				class="portlet-body form">
				<!--  Mesajlar -->
				{% if oke is defined %}
					<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
					<div class="alert alert-success">
						<strong>{{ lang.mod_headline.oke }}</strong>
						{{ mesaj }}
						<hr>
						<a href="{{ site.adres }}mod_headline/ekle" class="btn green">{{ lang.mod_headline.button.add }}</a>
						<a href="{{ site.adres }}mod_headline/edit/{{ d.id }}" class="btn red">{{ lang.mod_headline.button.edit }}</a>
						<a href="{{ site.adres }}mod_headline/list" class="btn blue">{{ lang.mod_headline.list }}</a>
					</div>
					<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
				{% else %}
					{% if hatalar is defined %}
						<!--[if !IE]>Hata Mesajı Varsa<![endif]-->
						{% for hata in hatalar %}
							<div class="alert alert-danger">
								<strong>{{ lang.mod_headline.hata }}</strong>
								{{ hata }}
							</div>
						{% endfor %}
						<!--[if !IE]>Hata Mesajı Varsa<![endif]-->
					{% endif %}
					<form method="POST" action="" id="edit" enctype="multipart/form-data" class="form-horizontal">
						<div class="form-body">
							<!-- İnputlar Başlar -->
							<!--[if !IE]>lang Input Başlar<![endif]-->
								<div class="form-group"> <label class="col-md-3 control-label">{{ lang.mod_headline.admin.columns.lang }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge  validate[required]" name="lang" id="lang">
											{% for item in lang_lang %}
												<option value="{{ item.seo }}" {% if d.lang == item.seo %} selected="selected" {% endif %}>
													{{ item.name }}
													{% if item.lang is defined %}({{ item.lang }})
													{% endif %}
												</option>
											{% endfor %}
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>lang Input Biter<![endif]-->
							<!--[if !IE]>name Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_headline.admin.columns.name }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required,length[2,255]]" name="name" value="{{ d.name }}" type="text" id="name">
									</div>
								</div>
							</div>
							<!--[if !IE]>name Input Biter<![endif]-->
							<!--[if !IE]>status Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_headline.admin.columns.status }}
									:</label>
								<div class="col-md-4">
									<div class="radio-list">
										<label class="radio-inline">
											{{ lang.mod_headline.admin.radio.publish_yes }}
											<input name="status" value="y" type="radio" {% if d.status == 'y' %} checked="checked" {% endif %}/>
										</label>
										<label class="radio-inline">
											{{ lang.mod_headline.admin.radio.publish_no }}
											<input name="status" value="n" type="radio" {% if d.status == 'n' %} checked="checked" {% endif %}/>
										</label>
									</div>
								</div>
							</div>
							<!--[if !IE]>status Input Biter<![endif]-->
							<!--[if !IE]>created_at Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_headline.admin.columns.created_at }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required]" name="created_at" value="{{ d.created_at }}" type="text" id="created_at">
									</div>
								</div>
							</div>
							<!--[if !IE]>created_at Input Biter<![endif]-->
							<!--[if !IE]>image İmage Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_headline.admin.columns.image }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										{% if d.image == "" %}
											<input name="image" type="file">
										{% else %}
											<p id="image-{{ d.id }}">
												<img src="static/mod_headline/thumb/{{ d.image }}">
												<a href="javascript:void(0)" onclick="image_remove_image('{{ d.id }}');">{{ lang.mod_headline.button.kaldir }}</a>
											</p>
										{% endif %}
									</div>
								</div>
							</div>
							<!--[if !IE]>image İmage Biter<![endif]-->
							<!-- İnputlar Biter -->
						</div>
						<!-- form body end -->
						<div class="form-actions">
							<div class="row">
								<div
									class="col-md-offset-3 col-md-9">
									<!--[if !IE]>{{ lang.mod_headline.button.edit }} Butonu<![endif]-->
									<button class="btn green" name="edit" value="{{ lang.mod_headline.button.edit }}">
										{{ lang.mod_headline.button.edit }}
									</button>
									<a class="btn blue" href="mod_headline/list">{{ lang.mod_headline.button.vazgec }}</a>
									<!--[if !IE]>{{ lang.mod_headline.button.edit }} Butonu<![endif]-->
								</div>
							</div>
						</div>
						<!-- form actions end -->
					</form>
				{% endif %}
			</div>
		</div>
	{% endif %}
{% endblock %}
{% block extra %}
	<script>
		$(document).ready(function () {
$("#edit").validationEngine();


function temizle(veri) {

var temiz = veri.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, " ");
temiz = temiz.replace(/^\s+|\s+$/g, "");

for (i = 0; i <= 15; i ++) {
temiz = temiz.replace('  ', ' ');
}
return temiz;
}

// SEO YAPAR
function make_seo(name, seo) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, "_");
deger = deger.replace('İ', 'i');

$("#" + seo).val(deger);
});
}

// Make keywords
function make_keywords(name, keywords) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, ",");
deger = deger.toLowerCase();
deger = deger.replace('İ', 'i');

$("#" + keywords).val(deger);
});
}

// Make Title
function make_title(name, title) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + title).val(deger);
});
}

// Make Açıklama
function make_aciklama(name, description) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + description).val(deger);
});
}
// Make Preview
function make_preview(name) {
$("#" + name).change(function () {
$("#" + name + "_preview").html($("#" + name).val());
});
}


var simdi = new Date();
var yil = simdi.getFullYear();
var ay = (simdi.getMonth() < 9 ? '0' : '') + (simdi.getMonth() + 1);
var gun = (simdi.getDate() < 10 ? '0' : '') + simdi.getDate();
var saat = (simdi.getHours() < 10 ? '0' : '') + simdi.getHours();
var dakika = (simdi.getMinutes() < 10 ? '0' : '') + simdi.getMinutes();

var now = yil + "-" + ay + "-" + gun + " " + saat + ":" + dakika;

if ($("#created_at").val() == "") {
$("#created_at").val(now);
}

AnyTime.picker("created_at", {
format: "%z-%m-%d %H:%i",
firstDOW: 1,
placement: "popup",
labelDayOfMonth: "Haftanın Günleri",
labelHour: "Saat",
labelMinute: "Dakika",
labelMonth: "Aylar",
labelTitle: "Lütfen Tarih ve Zamanı Seçin",
labelYear: "Yıl",
dayAbbreviations: [
"Pz",
"Pt",
"Sa",
"Ça",
"Pe",
"Cu",
"Ct"
],
dayNames: [
"Pazar",
"Pazartesi",
"Salı",
"Çarşamba",
"Perşembe",
"Cuma",
"Cumartesi"
],
monthAbbreviations: [
"Oca",
"Şub",
"Mar",
"Nis",
"May",
"Haz",
"Tem",
"Ağu",
"Eyl",
"Eki",
"Kas",
"Ara"
],
monthNames: [
"Ocak",
"Şubat",
"Mart",
"Nisan",
"Mayıs",
"Haziran",
"Temmuz",
"Ağustos",
"Eylül",
"Ekim",
"Kasım",
"Aralık"
]
});

});
	</script>
	<!-- Javascript Başlar -->
	<script type="text/javascript">
		function image_remove_image(id) { // Sor Bakalım Kabul Ediyormu ( Confirm)
$.prompt('{{ lang.mod_headline.remove_image }}', {
buttons: [
{
title: '{{ lang.mod_headline.button.evet }}',
value: true
}, {
title: '{{ lang.mod_headline.button.hayir }}',
value: false
}
],
submit: function (v, m, f) { // Eğer Kabul Ederse
if (v === true) {
$.ajax({
type: "POST",
url: "{{ site.adres }}mod_headline/image_remove_image",
data: {
id: id
},
success: function (msg) {
if (msg == 'Oke') {
$.achtung({className: 'achtungSuccess', message: '{{ lang.mod_headline.remove_image_oke }}', timeout: 5});
$("#image-" + id).html('<input name="image" type="file">');
} else {
$.achtung({className: 'achtungFail', message: msg, timeout: 5});
}
}
});
}
}
});
}
	</script>
	<!-- Javascript Biter -->
{% endblock %}
