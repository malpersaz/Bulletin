{% extends "management/admin-layout.twig" %}
{% block title %}{{ lang.mod_imagecategories.add }}{% endblock %}
{% block body %}
    {% if error is defined %}
        <div class="alert alert-danger">
            <strong>{{ lang.mod_imagecategories.error }}</strong> {{ mesaj }}
        </div>
    {% else %}
        <div class="portlet box green">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-edit"></i>{{ lang.mod_imagecategories.add }}
                </div>
            </div>
            <div class="portlet-body form">
                {% if oke is defined %}
                    <div class="alert alert-success">
                        <strong>{{ lang.mod_imagecategories.oke }}</strong> {{ mesaj }}
                        <hr>
                        <a href="{{ site.adres }}mod_imagecategories/ekle" class="btn green">{{ lang.mod_imagecategories.add }}</a>
                        <a href="{{ site.adres }}mod_imagecategories/list" class="btn blue">{{ lang.mod_imagecategories.list }}</a>
                    </div>
                {% else %}
                    {% if hatalar is defined %}
                        {% for hata in hatalar %}
                            <div class="alert alert-danger">
                                <strong>{{ lang.mod_imagecategories.hata }}</strong> {{ hata }}
                            </div>
                        {% endfor %}
                    {% endif %}
                    <form method="POST"
                          action=""
                          id="add"
                          enctype="multipart/form-data"
                          class="form-horizontal">
                        <div class="form-body">
                            <!-- Inputs Start -->
                            <!-- lang select -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.lang }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge validate[required]"
                                                name="lang"
                                                id="lang">
                                            {% for item in lang_lang %}
                                                <option value="{{ item.seo }}">
                                                    {{ item.name }}
                                                    {% if item.lang is defined %}({{ item.lang }}){% endif %}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!-- name Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.name }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge validate[required,length[2,255]]"
                                               name="name"
                                               value="{{ name }}"
                                               type="text"
                                               id="name">
                                    </div>
                                </div>
                            </div>
                            <!-- content Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.content }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <textarea class="form-control input-xlarge" name="content" id="content">{{ content }}</textarea>
                                    </div>
                                </div>
                            </div>
                            <!-- parent_id Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.parent_id }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge validate[required]"
                                                name="parent_id"
                                                id="parent_id">
                                            <option value="0" selected="selected">{{ lang.mod_imagecategories.choose_wish }}</option>
                                            {% macro select_nested_parent_id(parent_id, level) %}
                                                {% for entry in select_nested_parent_id_result[parent_id] %}
                                                    <option value="{{ entry.id }}">{{ '-'|repeat(level) }}{{ entry.name }}</option>
                                                    {% if select_nested_parent_id_result[entry.id] is defined and select_nested_parent_id_result[entry.id] is iterable %}
                                                        {{ _self.select_nested_parent_id(entry.id, level + 1) }}
                                                    {% endif %}
                                                {% endfor %}
                                            {% endmacro %}
                                            {{ _self.select_nested_parent_id(0, 0) }}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!-- root select -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.root }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge validate[required]"
                                                name="root"
                                                id="root">
                                            <option value="y">{{ lang.mod_imagecategories.admin.select_value.root_e }}</option>
                                            <option value="n" selected="selected">{{ lang.mod_imagecategories.admin.select_value.root_h }}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!-- seo Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.seo }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge validate[required]"
                                               name="seo"
                                               value="{{ seo }}"
                                               type="text"
                                               id="seo">
                                    </div>
                                </div>
                            </div>
                            <!-- title Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.title }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge validate[required]"
                                               name="title"
                                               value="{{ title }}"
                                               type="text"
                                               id="title">
                                    </div>
                                </div>
                            </div>
                            <!-- keywords Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.keywords }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge validate[required]"
                                               name="keywords"
                                               value="{{ keywords }}"
                                               type="text"
                                               id="keywords">
                                    </div>
                                </div>
                            </div>
                            <!-- description Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.description }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge validate[required]"
                                               name="description"
                                               value="{{ description }}"
                                               type="text"
                                               id="description">
                                    </div>
                                </div>
                            </div>
                            <!-- acl_id select -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.acl_id }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge validate[required]"
                                                name="acl_id"
                                                id="acl_id">
                                            <option value="0" selected="selected">{{ lang.mod_imagecategories.choose_wish }}</option>
                                            {% for item in mod_acl_acl_id %}
                                                <option value="{{ item.id }}">
                                                    {{ item.name }}
                                                    {% if item.lang is defined %}({{ item.lang }}){% endif %}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!-- menu Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.menu }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge validate[required]"
                                                name="menu"
                                                id="menu">
                                            <option value="0" selected="selected">{{ lang.mod_imagecategories.choose_wish }}</option>
                                            {% macro select_nested_menu(parent_id, level) %}
                                                {% for entry in select_nested_menu_result[parent_id] %}
                                                    <option value="{{ entry.id }}">
                                                        {{ '-'|repeat(level) }}{{ entry.name }}
                                                        {% if entry.lang is defined %}({{ entry.lang }}){% endif %}
                                                    </option>
                                                    {% if select_nested_menu_result[entry.id] is defined and select_nested_menu_result[entry.id] is iterable %}
                                                        {{ _self.select_nested_menu(entry.id, level + 1) }}
                                                    {% endif %}
                                                {% endfor %}
                                            {% endmacro %}
                                            {{ _self.select_nested_menu(0, 0) }}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!-- image Image -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.image }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input name="image" type="file">
                                    </div>
                                </div>
                            </div>
                            <!-- Inputs End -->
                        </div>
                        <div class="form-actions">
                            <div class="row">
                                <div class="col-md-offset-3 col-md-9">
                                    <button class="btn green"
                                            name="add"
                                            value="{{ lang.mod_imagecategories.button.add }}">
                                        {{ lang.mod_imagecategories.button.add }}
                                    </button>
                                    <a class="btn blue" href="mod_imagecategories/list">{{ lang.mod_imagecategories.button.vazgec }}</a>
                                </div>
                            </div>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
{% block extra %}
    <script>
        $(document).ready(function() {
            $("#add").validationEngine();

            function temizle(veri) {
                var temiz = veri.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, " ");
                temiz = temiz.replace(/^\s+|\s+$/g, "");

                for (i = 0; i <= 15; i++) {
                    temiz = temiz.replace('  ', ' ');
                }
                return temiz;
            }

            // SEO YAPAR
            function make_seo(name, seo) {
                $("#" + name).change(
                    function() {
                        var deger = temizle($("#" + name).val());
                        deger = deger.replace(/\s+/g, "_");
                        deger = deger.replace('İ', 'i');

                        $("#" + seo).val(deger);
                    });
            }

            // Make keywords
            function make_keywords(name, keywords) {
                $("#" + name).change(
                    function() {
                        var deger = temizle($("#" + name).val());
                        deger = deger.replace(/\s+/g, ",");
                        deger = deger.toLowerCase();
                        deger = deger.replace('İ', 'i');

                        $("#" + keywords).val(deger);
                    });
            }

            // Make Title
            function make_title(name, title) {
                $("#" + name).change(
                    function() {
                        var deger = temizle($("#" + name).val());
                        $("#" + title).val(deger);
                    });
            }

            // Make Açıklama
            function make_aciklama(name, description) {
                $("#" + name).change(
                    function() {
                        var deger = temizle($("#" + name).val());
                        $("#" + description).val(deger);
                    });
            }
            
            // Make Preview
            function make_preview(name) {
                $("#" + name).change(function() {
                    $("#" + name + "_preview").html($("#" + name).val());
                });
            }

            var simdi = new Date();
            var yil = simdi.getFullYear();
            var ay = (simdi.getMonth() < 9 ? '0' : '') + (simdi.getMonth() + 1);
            var gun = (simdi.getDate() < 10 ? '0' : '') + simdi.getDate();
            var saat = (simdi.getHours() < 10 ? '0' : '') + simdi.getHours();
            var dakika = (simdi.getMinutes() < 10 ? '0' : '') + simdi.getMinutes();

            var now = yil + "-" + ay + "-" + gun + " " + saat + ":" + dakika;

            make_seo('name', 'seo');
            make_title('name', 'title');
            make_keywords('name', 'keywords');
            make_aciklama('name', 'description');
        });
    </script>
{% endblock %}
