{% extends "management/admin-layout.twig" %}
{% block title %}{{ lang.mod_imagecategories.edit }}{% endblock %}
{% block body %}
    {% if error is defined %}
        <div class="alert alert-danger">
            <strong>{{ lang.mod_imagecategories.error }}</strong> {{ mesaj }}
        </div>
    {% else %}
        <div class="portlet box green">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-edit"></i>{{ lang.mod_imagecategories.edit }}
                </div>
            </div>
            <div class="portlet-body form">
                {% if oke is defined %}
                    <div class="alert alert-success">
                        <strong>{{ lang.mod_imagecategories.oke }}</strong>{{ mesaj }}
                        <hr>
                        <a href="{{ site.adres }}mod_imagecategories/ekle" class="btn green">{{ lang.mod_imagecategories.button.add }}</a>
                        <a href="{{ site.adres }}mod_imagecategories/edit/{{ d.id }}"
                           class="btn red">{{ lang.mod_imagecategories.button.edit }}</a>
                        <a href="{{ site.adres }}mod_imagecategories/list" class="btn blue">{{ lang.mod_imagecategories.list }}</a>
                    </div>
                {% else %}
                    {% if hatalar is defined %}
                        {% for hata in hatalar %}
                            <div class="alert alert-danger">
                                <strong>{{ lang.mod_imagecategories.hata }}</strong> {{ hata }}
                            </div>
                        {% endfor %}
                    {% endif %}
                    <form method="POST"
                          action=""
                          id="edit"
                          enctype="multipart/form-data"
                          class="form-horizontal">
                        <div class="form-body">
                            <!-- Inputs Start -->
                            <!-- lang Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.lang }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge validate[required]"
                                                name="lang"
                                                id="lang">
                                            {% for item in lang_lang %}
                                                <option value="{{ item.seo }}"
                                                        {% if d.lang == item.seo %}selected="selected"{% endif %}>
                                                    {{ item.name }}
                                                    {% if item.lang is defined %}({{ item.lang }}){% endif %}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!-- name Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.name }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge validate[required,length[2,255]]"
                                               name="name"
                                               value="{{ d.name }}"
                                               type="text"
                                               id="name">
                                    </div>
                                </div>
                            </div>
                            <!-- content Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.content }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <textarea class="form-control input-xlarge" name="content" id="content">{{ d.content }}</textarea>
                                    </div>
                                </div>
                            </div>
                            <!-- parent_id Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.parent_id }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge validate[required]"
                                                name="parent_id"
                                                id="parent_id">
                                            <option value="0" {% if d.parent_id == 0 %}selected="selected"{% endif %}>{{ lang.mod_imagecategories.choose_wish }}</option>
                                            {% macro select_nested_parent_id(parent_id, level, disable, current_id) %}
                                                {% for entry in select_nested_parent_id_result[parent_id] %}
                                                    <option value="{{ entry.id }}"
                                                            {% if entry.id == d.parent_id %}selected="selected"{% endif %}
                                                            {% if entry.id == current_id or disable == "true" %}disabled="disabled"{% endif %}>
                                                        {{ '-'|repeat(level) }}{{ entry.name }}
                                                    </option>
                                                    {% if select_nested_parent_id_result[entry.id] is defined and select_nested_parent_id_result[entry.id] is iterable %}
                                                        {% if entry.id == current_id %}
                                                            {{ _self.select_nested_parent_id(entry.id, level + 1, "true", current_id) }}
                                                        {% else %}
                                                            {% if disable == "true" %}
                                                                {{ _self.select_nested_parent_id(entry.id, level + 1, "true", current_id) }}
                                                            {% else %}
                                                                {{ _self.select_nested_parent_id(entry.id, level + 1, "false", current_id) }}
                                                            {% endif %}
                                                        {% endif %}
                                                    {% endif %}
                                                {% endfor %}
                                            {% endmacro %}
                                            {{ _self.select_nested_parent_id(0, 0, "false", d.id) }}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!-- root Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.root }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge validate[required]"
                                                name="root"
                                                id="root">
                                            <option value="y" {% if d.root == 'y' %}selected="selected"{% endif %}>
                                                {{ lang.mod_imagecategories.admin.select_value.root_e }}
                                            </option>
                                            <option value="n" {% if d.root == 'n' %}selected="selected"{% endif %}>
                                                {{ lang.mod_imagecategories.admin.select_value.root_h }}
                                            </option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!-- seo Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.seo }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge validate[required]"
                                               name="seo"
                                               value="{{ d.seo }}"
                                               type="text"
                                               id="seo">
                                    </div>
                                </div>
                            </div>
                            <!-- title Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.title }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge validate[required]"
                                               name="title"
                                               value="{{ d.title }}"
                                               type="text"
                                               id="title">
                                    </div>
                                </div>
                            </div>
                            <!-- keywords Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.keywords }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge validate[required]"
                                               name="keywords"
                                               value="{{ d.keywords }}"
                                               type="text"
                                               id="keywords">
                                    </div>
                                </div>
                            </div>
                            <!-- description Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.description }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge validate[required]"
                                               name="description"
                                               value="{{ d.description }}"
                                               type="text"
                                               id="description">
                                    </div>
                                </div>
                            </div>
                            <!-- acl_id Input -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.acl_id }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge validate[required]"
                                                name="acl_id"
                                                id="acl_id">
                                            <option value="0" {% if d.acl_id == 0 %}selected="selected"{% endif %}>
                                                {{ lang.mod_imagecategories.choose_wish }}
                                            </option>
                                            {% for item in mod_acl_acl_id %}
                                                <option value="{{ item.id }}"
                                                        {% if d.acl_id == item.id %}selected="selected"{% endif %}>
                                                    {{ item.name }}
                                                    {% if item.lang is defined %}({{ item.lang }}){% endif %}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!-- image Image -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_imagecategories.admin.columns.image }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        {% if d.image == "" %}
                                            <input name="image" type="file">
                                        {% else %}
                                            <p id="image-{{ d.id }}">
                                                <img src="static/mod_imagecategories/thumb/{{ d.image }}">
                                                <a href="javascript:void(0)" onclick="image_remove_image('{{ d.id }}');">{{ lang.mod_imagecategories.button.kaldir }}</a>
                                            </p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <!-- Inputs End -->
                        </div>
                        <div class="form-actions">
                            <div class="row">
                                <div class="col-md-offset-3 col-md-9">
                                    <button class="btn green"
                                            name="edit"
                                            value="{{ lang.mod_imagecategories.button.edit }}">
                                        {{ lang.mod_imagecategories.button.edit }}
                                    </button>
                                    <a class="btn blue" href="mod_imagecategories/list">{{ lang.mod_imagecategories.button.vazgec }}</a>
                                </div>
                            </div>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
{% block extra %}
    <script>
        $(document).ready(function() {
            $("#edit").validationEngine();

            function temizle(veri) {
                var temiz = veri.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, " ");
                temiz = temiz.replace(/^\s+|\s+$/g, "");

                for (i = 0; i <= 15; i++) {
                    temiz = temiz.replace('  ', ' ');
                }
                return temiz;
            }

            // SEO YAPAR
            function make_seo(name, seo) {
                $("#" + name).change(
                    function() {
                        var deger = temizle($("#" + name).val());
                        deger = deger.replace(/\s+/g, "_");
                        deger = deger.replace('İ', 'i');

                        $("#" + seo).val(deger);
                    });
            }

            // Make keywords
            function make_keywords(name, keywords) {
                $("#" + name).change(
                    function() {
                        var deger = temizle($("#" + name).val());
                        deger = deger.replace(/\s+/g, ",");
                        deger = deger.toLowerCase();
                        deger = deger.replace('İ', 'i');

                        $("#" + keywords).val(deger);
                    });
            }

            // Make Title
            function make_title(name, title) {
                $("#" + name).change(
                    function() {
                        var deger = temizle($("#" + name).val());
                        $("#" + title).val(deger);
                    });
            }

            // Make Açıklama
            function make_aciklama(name, description) {
                $("#" + name).change(
                    function() {
                        var deger = temizle($("#" + name).val());
                        $("#" + description).val(deger);
                    });
            }
            
            // Make Preview
            function make_preview(name) {
                $("#" + name).change(function() {
                    $("#" + name + "_preview").html($("#" + name).val());
                });
            }

            var simdi = new Date();
            var yil = simdi.getFullYear();
            var ay = (simdi.getMonth() < 9 ? '0' : '') + (simdi.getMonth() + 1);
            var gun = (simdi.getDate() < 10 ? '0' : '') + simdi.getDate();
            var saat = (simdi.getHours() < 10 ? '0' : '') + simdi.getHours();
            var dakika = (simdi.getMinutes() < 10 ? '0' : '') + simdi.getMinutes();

            var now = yil + "-" + ay + "-" + gun + " " + saat + ":" + dakika;

            make_seo('name', 'seo');
            make_title('name', 'title');
            make_keywords('name', 'keywords');
            make_aciklama('name', 'description');
        });
    </script>
    <!-- Javascript Başlar -->
    <script type="text/javascript">
        function image_remove_image(id) {
            // Sor Bakalım Kabul Ediyormu (Confirm)
            $.prompt('{{ lang.mod_imagecategories.remove_image }}', {
                buttons: [
                    {
                        title: '{{ lang.mod_imagecategories.button.evet }}',
                        value: true
                    },
                    {
                        title: '{{ lang.mod_imagecategories.button.hayir }}',
                        value: false
                    }
                ],
                submit: function(v, m, f) {
                    // Eğer Kabul Ederse
                    if (v === true) {
                        $.ajax({
                            type: "POST",
                            url: "{{ site.adres }}mod_imagecategories/image_remove_image",
                            data: { id: id },
                            success: function(msg) {
                                if (msg == 'Oke') {
                                    $.achtung({
                                        className: 'achtungSuccess',
                                        message: '{{ lang.mod_imagecategories.remove_image_oke }}',
                                        timeout: 5
                                    });
                                    $("#image-"+id).html('<input name="image" type="file">');
                                } else {
                                    $.achtung({
                                        className: 'achtungFail',
                                        message: msg,
                                        timeout: 5
                                    });
                                }
                            }
                        });
                    }
                }
            });
        }
    </script>
    <!-- Javascript Biter -->
{% endblock %}
