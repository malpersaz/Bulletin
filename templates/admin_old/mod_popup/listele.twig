{% extends "management/admin-layout.twig" %}
{% block title %}
	{{ lang.mod_popup.list }}
{% endblock %}
{% block body %}
	<!-- Begin: life time stats -->
	<div class="portlet light">
		<div class="portlet-title">
			<div class="caption">
				<i class="fa fa-gift font-green-sharp"></i>
				<span class="caption-subject font-green-sharp bold uppercase">{{ lang.mod_popup.list }}</span>
				<span class="caption-helper">Kayıt Yönetimi</span>
			</div>
			<div class="actions">
				<a href="{{ site.adres }}mod_popup/ekle" class="btn green ">
					<i class="fa fa-plus"></i>
					<span class="hidden-480">{{ lang.mod_popup.button.add }}</span>
				</a>
			</div>
		</div>
		<div class="portlet-body">
			<div class="table-container">
				<div class="table-actions-wrapper">
					<span></span>
					<select class="table-group-action-input form-control input-inline input-xsmall input-sm">
						<option value="">İşlem...</option>
						{% if session.permissions.mod_popup.gallery is defined %}
							<option value="{{ lang.mod_popup.button.gallery }}">{{ lang.mod_popup.button.gallery }}</option>
						{% endif %}
						{% if session.permissions.mod_popup.file is defined %}
							<option value="{{ lang.mod_popup.button.file }}">{{ lang.mod_popup.button.file }}</option>
						{% endif %}
						{% if session.permissions.mod_popup.sil is defined %}
							<option value="{{ lang.mod_popup.button.sil }}">{{ lang.mod_popup.button.sil }}</option>
						{% endif %}
						{% if session.permissions.mod_popup.edit is defined %}
							<option value="{{ lang.mod_popup.grid.publish.key }}">{{ lang.mod_popup.grid.publish.key }}</option>
						{% endif %}
						{% if session.permissions.mod_popup.edit is defined %}
							<option value="{{ lang.mod_popup.grid.unpublish.key }}">{{ lang.mod_popup.grid.unpublish.key }}</option>
						{% endif %}
					</select>
					<button class="btn btn-xs yellow table-group-action-submit">
						<i class="fa fa-check"></i>
						Uygula
					</button>
				</div>
				<table class="table table-striped table-bordered table-hover" id="mod_popup_datatable">
					<thead>
						<tr role="row" class="heading">
							<th width="2%">
								<input type="checkbox" class="group-checkable">
							</th>
							<th width="5%">{{ lang.mod_popup.admin.columns.id }}&nbsp;</th>
							<th width="30%">{{ lang.mod_popup.admin.columns.name }}&nbsp;</th>
							<th width="10%">{{ lang.mod_popup.admin.columns.image }}&nbsp;</th>
							<th width="5%">{{ lang.mod_popup.admin.columns.lang }}&nbsp;</th>
							<th width="20%">{{ lang.mod_popup.admin.columns.created_at }}&nbsp;</th>
							<th width="20%">{{ lang.mod_popup.admin.columns.etarih }}&nbsp;</th>
							<th width="5%">{{ lang.mod_popup.admin.columns.status }}&nbsp;</th>
							<th width="25%">İşlem</th>
						</tr>
						<tr role="row" class="filter">
							<td></td>
							<td width="5%">
								<input type="text" class="form-control form-filter input-sm" name="arama[id]">
							</td>
							<td width="30%">
								<input type="text" class="form-control form-filter input-sm" name="arama[name]">
							</td>
							<td width="10%"></td>
							<td width="5%">
								<input type="text" class="form-control form-filter input-sm" name="arama[lang]">
							</td>
							<td width="20%">
								<div class="input-group date date-picker margin-bottom-5" data-date-format="yyyy-mm-dd">
									<input type="text" class="form-control form-filter input-sm" readonly name="arama_tarih[created_at][from]" placeholder="Burdan">
									<span class="input-group-btn">
										<button class="btn btn-sm default" type="button">
											<i class="fa fa-calendar"></i>
										</button>
									</span>
								</div>
								<div class="input-group date date-picker" data-date-format="yyyy-mm-dd">
									<input type="text" class="form-control form-filter input-sm" readonly name="arama_tarih[created_at][to]" placeholder="Buraya">
									<span class="input-group-btn">
										<button class="btn btn-sm default" type="button">
											<i class="fa fa-calendar"></i>
										</button>
									</span>
								</div>
							</td>
							<td width="20%">
								<div class="input-group date date-picker margin-bottom-5" data-date-format="yyyy-mm-dd">
									<input type="text" class="form-control form-filter input-sm" readonly name="arama_tarih[etarih][from]" placeholder="Burdan">
									<span class="input-group-btn">
										<button class="btn btn-sm default" type="button">
											<i class="fa fa-calendar"></i>
										</button>
									</span>
								</div>
								<div class="input-group date date-picker" data-date-format="yyyy-mm-dd">
									<input type="text" class="form-control form-filter input-sm" readonly name="arama_tarih[etarih][to]" placeholder="Buraya">
									<span class="input-group-btn">
										<button class="btn btn-sm default" type="button">
											<i class="fa fa-calendar"></i>
										</button>
									</span>
								</div>
							</td>
							<td width="5%">
								<select name="arama_radio[status]" class="form-control form-filter input-sm">
									<option value="">Seçiniz...</option>
									<option value="y">{{ lang.mod_popup.admin.radio.publish_yes }}</option>
									<option value="n">{{ lang.mod_popup.admin.radio.publish_no }}</option>
								</select>
							</td>
							<td>
								<button class="btn yellow filter-submit margin-bottom">
									<i class="fa fa-search"></i>
									Ara
								</button>
								<button class="btn red filter-cancel">
									<i class="fa fa-times"></i>
									Sıfırla
								</button>
							</td>
						</tr>
					</thead>
					<tbody></tbody>
				</table>
			</div>
		</div>
	</div>
	<!-- End: life time stats -->
{% endblock %}
{% block extra %}
	{% include mod ~ '/script.twig' %}
	<script>
		/*   console.log(mod_popup_table_ajax);
         f=new mod_popup_table_ajax();
         f.init();*/
mod_popup_table_ajax.init()
	</script>
{% endblock %}
