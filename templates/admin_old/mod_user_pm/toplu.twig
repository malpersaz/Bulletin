{% extends "management/admin-layout.twig" %}
{% block extra %}
    <script>
        $(document).ready(function () {
            $("#bulk").validationEngine();

            $('textarea#mesaj').autoResize({
                // On resize:
                onResize: function () {
                    $(this).css({opacity: 0.8});
                },
                // After resize:
                animateCallback: function () {
                    $(this).css({opacity: 1});
                },
                // Quite slow animation:
                animateDuration: 300,
                // More extra space:
                extraSpace: 40
            });


            $("#kimlere").tokenInput(
                    "{{ site.adres }}mod_user_pm/allin",
                    {
                        method: "POST",
                        hintText: "Lütfen Aramak İstediğiniz Üyeyi Yazın.",
                        noResultsText: "Sonuç Bulunamadı",
                        searchingText: "Aranıyor...",
                        classes: {
                            tokenList: "token-input-list-facebook",
                            token: "token-input-token-facebook",
                            tokenDelete: "token-input-delete-token-facebook",
                            selectedToken: "token-input-selected-token-facebook",
                            highlightedToken: "token-input-highlighted-token-facebook",
                            dropdown: "token-input-dropdown-facebook",
                            dropdownItem: "token-input-dropdown-item-facebook",
                            dropdownItem2: "token-input-dropdown-item2-facebook",
                            selectedDropdownItem: "token-input-selected-dropdown-item-facebook",
                            inputToken: "token-input-input-token-facebook"
                        }
                    });


        });
    </script>
    <script>
        $(document).ready(function () {
            $("#bulk").validationEngine();
        });
    </script>
{% endblock %}
{% block title %}Toplu Özel Mesaj Gönder{% endblock %}
{% block body %}
    <div class="portlet box green">
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-gift"></i>{{ lang.mod_user_pm.bulk_pm_area_desc }}
            </div>
        </div>
        <div class="portlet-body form">
            {% if oke is defined %}
                <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
                <div class="alert alert-success">
                    <strong>Tamam!</strong> {{ mesaj }}
                </div>
                <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
            {% else %}
                {% if hatalar is defined %}
                    <!--[if !IE]>Hata Mesajı Varsa<![endif]-->
                    {% for hata in hatalar %}
                        <div class="alert alert-danger">
                            <strong>Hata!</strong> {{ hata }}
                        </div>
                    {% endfor %}
                    <!--[if !IE]>Hata Mesajı Varsa<![endif]-->
                {% endif %}
                <!-- BEGIN FORM-->
                <form method="POST"
                      action=""
                      id="bulk"
                      class="form-horizontal"
                      enctype="multipart/form-data">
                    <div class="form-body">
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_user_pm.usernames_label }} :</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input class="form-control input-circle-left validate[required,length[1,250]]"
                                           name="kimlere"
                                           value="{{ kimlere }}"
                                           type="text"
                                           id="kimlere">
                                    <span class="input-group-addon input-circle-right">
                                        <i class="fa fa-user"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_user_pm.subject_label }} :</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input class="form-control input-circle-left validate[required,length[1,250]]"
                                           name="konu"
                                           value="{{ konu }}"
                                           type="text"
                                           id="konu">
                                    <span class="input-group-addon input-circle-right">
                                        <i class="fa fa-user"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_user_pm.message_label }} :</label>
                            <div class="col-md-4">
                                <div class="inbox-form-group">
                                    <textarea class="form-control" name="mesaj" id="mesaj" row="3">{{ mesaj }}</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <div class="row">
                            <div class="col-md-offset-3 col-md-9">
                                <button type="submit"
                                        name="bulk"
                                        value="{{ lang.mod_user_pm.send_button }}"
                                        class="btn green">{{ lang.mod_user_pm.send_button }}</button>
                                <button type="reset" class="btn default">Vazgeç</button>
                            </div>
                        </div>
                    </div>
                </form>
                <!-- END FORM-->
            {% endif %}
        </div>
    </div>
{% endblock %}
