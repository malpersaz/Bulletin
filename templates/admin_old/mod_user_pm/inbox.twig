{% extends "management/admin-layout.twig" %}
{% block extra %}
    <script>
        function inbox_sil(id) {


            // Sor Bakalım Kabul Ediyormu ( Confirm)
            $.prompt('{{ lang.mod_user_pm.confirm_delete_msg }}', {
                buttons: [
                    {
                        title: '{{ lang.mod_user_pm.confirm_delete_yes }}',
                        value: true
                    },
                    {
                        title: '{{ lang.mod_user_pm.cancel }}',
                        value: false
                    }
                ],
                submit: function (v, m, f) {
                    // Eğer Kabul Ederse
                    if (v === true) {
                        $.ajax({
                            type: "POST",
                            url: "{{ site.adres }}mod_user_pm/inbox_sil",
                            data: {id: id},
                            success: function (msg) {
                                if (msg == 'Oke') {
                                    $.achtung({
                                        className: 'achtungSuccess',
                                        message: '{{ lang.mod_user_pm.message_deleted_success }}',
                                        timeout: 5
                                    });


                                    $("#alan_" + id).hide();


                                } else {
                                    $.achtung({
                                        className: 'achtungFail',
                                        message: msg,
                                        timeout: 5
                                    });
                                }
                            }
                        });
                    }
                }
            });


        }
    </script>
{% endblock %}
{% block title %}Mesajlaşma{% endblock %}
{% block body %}
    <div class="portlet light">
        <div class="portlet-body">
            <div class="row inbox">
                <div class="col-md-2">
                    <ul class="inbox-nav margin-bottom-10">
                        {% if session.permissions.mod_user_pm.send is defined %}
                            <li class="compose-btn">
                                <a href="mod_user_pm/send" data-title="Compose" class="btn green">
                                    <i class="fa fa-edit"></i> {{ lang.mod_user.profile_menu.new_message }} </a>
                            </li>
                        {% endif %}
                        <li class="inbox active">
                            <a class="btn" href="mod_user_pm/inbox" data-title="{{ lang.mod_user.profile_menu.inbox }}">
                                {{ lang.mod_user.profile_menu.inbox }}(
                                {% if session.okunmamis is defined %}
                                    {{ session.okunmamis }}
                                {% else %}
                                    0
                                {% endif %}
                            ) </a>
                            <b></b>
                        </li>
                        <li class="sent">
                            <a class="btn" href="mod_user_pm/sendbox" data-title="{{ lang.mod_user.profile_menu.sent_box }}">{{ lang.mod_user.profile_menu.sent_box }}</a>
                            <b></b>
                        </li>
                    </ul>
                </div>
                <div class="col-md-10">
                    <div class="inbox-header">
                        <h1 class="pull-left">{{ lang.mod_user.profile_menu.inbox }}</h1>
                    </div>
                    <div class="inbox-content">
                        <table class="table table-striped table-advance table-hover">
                            <thead>
                                <tr>
                                    <th>{{ lang.mod_user_pm.order_col }}</th>
                                    <th>{{ lang.mod_user_pm.status_col }}</th>
                                    <th>{{ lang.mod_user_pm.sender_col }}</th>
                                    <th>{{ lang.mod_user_pm.subject_col }}</th>
                                    <th>{{ lang.mod_user_pm.date_col }}</th>
                                    <th>{{ lang.mod_user_pm.action_col }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if messages is defined %}
                                    {% for mesaj in messages %}
                                        <tr id="alan_{{ mesaj.id }}"
                                            {% if mesaj.status != 'y' %}class="unread"{% endif %}
                                            data-messageid="{{ mesaj.id }}">
                                            <td class="inbox-small-cells">{{ mesaj.id }}</td>
                                            <td class="inbox-small-cells">
                                                {% if mesaj.status == 'y' %}
                                                    <span class="label bg-green">{{ lang.mod_user_pm.read_status }}</span>
                                                {% else %}
                                                    <span class="label bg-red">{{ lang.mod_user_pm.unread_status }}</span>
                                                {% endif %}
                                            </td>
                                            <td class="view-message hidden-xs">{{ mesaj.username }}</td>
                                            <td class="view-message">
                                                <a href="mod_user_pm/inbox_read/{{ mesaj.id }}"
                                                   title="{{ mesaj.subject }}"
                                                   class="product_name">{{ mesaj.subject }}</a>
                                            </td>
                                            <td class="view-message">{{ mesaj.created_at }}</td>
                                            <td class="view-message inbox-small-cells">
                                                <div class="btn-group">
                                                    <button class="btn blue dropdown-toggle"
                                                            data-toggle="dropdown"
                                                            aria-expanded="false">
                                                        İşlem<i class="fa fa-angle-down"></i>
                                                    </button>
                                                    <ul class="dropdown-menu" role="menu">
                                                        <li role="presentation">
                                                            <a role="menuitem"
                                                               tabindex="-1"
                                                               href="mod_user_pm/send/{{ mesaj.username }}/{{ mesaj.subject }}">
                                                                {{ lang.mod_user_pm.reply_action }}
                                                            </a>
                                                        </li>
                                                        <li role="presentation">
                                                            <a role="menuitem"
                                                               tabindex="-1"
                                                               href="javascript:void(0);"
                                                               onclick="inbox_sil('{{ mesaj.id }}')">
                                                                {{ lang.mod_user_pm.delete_action }}
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
