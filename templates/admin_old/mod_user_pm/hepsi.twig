{% extends "management/admin-layout.twig" %}
{% block extra %}
    <script>
        $(document).ready(function () {
            $("#all").validationEngine();

            $('textarea#mesaj').autoResize({
                // On resize:
                onResize: function () {
                    $(this).css({opacity: 0.8});
                },
                // After resize:
                animateCallback: function () {
                    $(this).css({opacity: 1});
                },
                // Quite slow animation:
                animateDuration: 300,
                // More extra space:
                extraSpace: 40
            });


        });
    </script>
{% endblock %}
{% block title %}{{ lang.mod_user_pm.bulk_all_area_desc }}{% endblock %}
{% block body %}
    <div class="portlet box green">
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-gift"></i>
            </div>
        </div>
        <div class="portlet-body form">
            {% if oke is defined %}
                <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
                <div class="alert alert-success">
                    <strong>Tamam!</strong> {{ mesaj }}
                </div>
                <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
            {% else %}
                {% if hatalar is defined %}
                    <!--[if !IE]>Hata Mesajı Varsa<![endif]-->
                    {% for hata in hatalar %}
                        <div class="alert alert-danger">
                            <strong>Hata!</strong> {{ hata }}
                        </div>
                    {% endfor %}
                    <!--[if !IE]>Hata Mesajı Varsa<![endif]-->
                {% endif %}
                <!-- BEGIN FORM-->
                <form method="POST"
                      action=""
                      id="all"
                      class="form-horizontal"
                      enctype="multipart/form-data">
                    <div class="form-body">
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_user_pm.subject_label }} :</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input class="form-control input-circle-left validate[required,length[1,250]]"
                                           name="subject"
                                           value="{{ subject|default(konu) }}"
                                           type="text"
                                           id="subject">
                                    <span class="input-group-addon input-circle-right">
                                        <i class="fa fa-user"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_user_pm.message_label }} :</label>
                            <div class="col-md-4">
                                <div class="inbox-form-group">
                                    <textarea class="form-control" name="message" id="message" row="3">{{ message|default(mesaj) }}</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <div class="row">
                            <div class="col-md-offset-3 col-md-9">
                                <button type="submit"
                                        name="all"
                                        value="{{ lang.mod_user_pm.send_button }}"
                                        class="btn green">{{ lang.mod_user_pm.send_button }}</button>
                                <button type="reset" class="btn default">Vazgeç</button>
                            </div>
                        </div>
                    </div>
                </form>
                <!-- END FORM-->
            {% endif %}
        </div>
    </div>
{% endblock %}
