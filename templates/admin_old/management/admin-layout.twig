<!-- START: @templates/admin/management/admin-layout.twig -->
{# Base template for module pages - provides blocks instead of including complete layouts #}
{% set current_layout = "layout4" %}

<!DOCTYPE html>
<!--[if IE 8]><html lang="{{ site.lang }}" class="ie8 no-js"> <![endif]-->
<!--[if IE 9]><html lang="{{ site.lang }}" class="ie9 no-js"> <![endif]-->
<!--[if !IE]><!-->
	<html
	lang="{{ site.lang }}"> <!--<![endif]-->
	<head>
		<meta charset="utf-8"/><base href="{{ site.adres }}">
		<title>
			{% block page_title %}
				{{ site.title }}
			{% endblock %}
		</title>

		{# Load CSS and JS for current layout #}
		{% include 'management/shared/css/' ~ current_layout ~ '.twig' %}
		{% include 'management/shared/js/' ~ current_layout ~ '.twig' %}
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css">



			{% if mod is defined %}
				{% include mod ~ '/css.twig' %}
			{% endif %}
			{{ cssoptimize({"debug": true, "v": 2}) |raw }}
			{{ jsoptimize({"debug": true, "v": 2}) |raw }}

		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
		<meta http-equiv="Content-type" content="text/html; charset=utf-8">
		<meta content="" name="description"/>
		<meta content="" name="author"/>
	</head>
	<body
		class="page-header-fixed page-quick-sidebar-over-content page-style-square page-footer-fixed">
		{# Include layout-specific header #}
		{% include "management/shared/html/" ~ current_layout ~ "/header.twig" %}

		<div class="page-container">
			<div class="page-sidebar-wrapper">
				<div class="page-sidebar navbar-collapse collapse">
					{% include "management/shared/html/" ~ current_layout ~ "/menu.twig" %}
				</div>
			</div>

			<div class="page-content-wrapper">
				<div class="page-content">
					<div class="row">
						<div
							class="col-md-12">
							{# This is where module content goes - NO circular reference to tpl #}
							{% block body %}{% endblock %}
						</div>
					</div>
				</div>
			</div>
		</div>

		{% block extra %}{% endblock %}
		{% include "management/shared/html/" ~ current_layout ~ "/footer.twig" %}
	</body>
</html>
<!-- END: @templates/admin/management/admin-layout.twig -->
