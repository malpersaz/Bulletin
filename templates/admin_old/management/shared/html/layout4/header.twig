<!-- START: @templates/admin/management/shared/html/layout4/header.twig -->
<div
	class="page-header navbar navbar-fixed-top">
	<!-- BEGIN HEADER INNER -->
	<div
		class="page-header-inner">
		<!-- BEGIN LOGO -->
		<div class="page-logo">
			<a href="{{ site.sadres }}">
				<img src="{{ site.radres }}mod_settings/{{ site.logo_path }}" alt="logo" class="logo-default">
			</a>
			<div class="menu-toggler sidebar-toggler">
				<i class="fa fa-bars"></i>
				<!-- DOC: Remove the above "hide" to enable the sidebar toggler button on header -->
			</div>
		</div>
		<!-- END LOGO -->
		<!-- BEGIN RESPONSIVE MENU TOGGLER -->
		<a href="javascript:;" class="menu-toggler responsive-toggler" data-toggle="collapse" data-target=".navbar-collapse">
			<i class="fa fa-bars"></i>
		</a>
		<!-- END RESPONSIVE MENU TOGGLER -->
		{% include 'management/shared/components/page-action.twig' %}
		<!-- BEGIN PAGE TOP -->
		<div class="page-top">
			<!-- BEGIN HEADER SEARCH BOX -->
			<!-- DOC: Apply "search-form-expanded" right after the "search-form" class to have half expanded search box -->
			<!-- END HEADER SEARCH BOX -->
			<!-- BEGIN TOP NAVIGATION MENU -->
				<div class="top-menu"> <ul class="nav navbar-nav pull-right">
					<li class="separator hide"></li>
					<!-- BEGIN USER LOGIN DROPDOWN -->
					<!-- DOC: Apply "dropdown-dark" class after below "dropdown-extended" to change the dropdown styte -->
					<li class="dropdown dropdown-user dropdown-dark">
						<a href="#" class="dropdown-toggle" data-toggle="dropdown" data-hover="dropdown" data-close-others="true">
							<span class="username">{{ session.full_name }}</span>
							{% if session.image is defined and session.image != '' %}
								<img alt="" class="img-circle" src="static/mod_user/{{ session.image }}">
							{% endif %}
						</a>
						<ul class="dropdown-menu dropdown-menu-default">
							{% if session.id is defined %}
								<li>
									<a href="{{ site.sadres }}mod_user/info">
										<i class="icon-user"></i>
										{{ lang.mod_user.profile_menu.edit_profile }}
									</a>
								</li>
								{% if session.permissions.mod_settings.edit is defined %}
									<li>
										<a href="{{ site.sadres }}mod_settings/edit">
											<i class="icon-lock"></i>
											{{ lang.mod_user.admin.site_settings }}</a>
									</li>
								{% endif %}
								<li>
									<a href="{{ site.sadres }}mod_user/sifre">
										<i class="icon-lock"></i>
										{{ lang.mod_user.profile_menu.change_password }}
									</a>
								</li>
								<li class="divider"></li>
								<li>
									<a href="{{ site.sadres }}mod_user_pm/inbox">
										<i class="icon-envelope-open"></i>
										{{ lang.mod_user.profile_menu.inbox }}
										<span class="badge badge-danger">
											{% if session.okunmamis is defined %}
												{{ session.okunmamis }}
											{% else %}
												0
											{% endif %}
										</span>
									</a>
								</li>
								<li>
									<a href="{{ site.sadres }}mod_user_pm/sendbox">
										<i class="icon-envelope"></i>
										{{ lang.mod_user.profile_menu.sent_box }}
									</a>
								</li>
								{% if session.permissions is defined and session.permissions.mod_user_pm is defined and session.permissions.mod_user_pm.gonder is defined %}
									<li>
										<a href="{{ site.sadres }}mod_user_pm/gonder">
											<i class="icon-envelope-letter"></i>
											{{ lang.mod_user.profile_menu.new_message }}</a>
									</li>
								{% endif %}
								{% if session.permissions is defined and session.permissions.mod_user_pm is defined and session.permissions.mod_user_pm.toplu is defined %}
									<li>
										<a href="{{ site.sadres }}mod_user_pm/toplu">
											<i class="icon-envelope-letter"></i>
											{{ lang.mod_user.profile_menu.to_multiple_users }}</a>
									</li>
								{% endif %}
								{% if session.permissions is defined and session.permissions.mod_user_pm is defined and session.permissions.mod_user_pm.gtoplu is defined %}
									<li>
										<a href="{{ site.sadres }}mod_user_pm/gtoplu">
											<i class="icon-envelope-letter"></i>
											{{ lang.mod_user.profile_menu.to_specific_group }}</a>
									</li>
								{% endif %}
								{% if session.permissions is defined and session.permissions.mod_user_pm is defined and session.permissions.mod_user_pm.hepsi is defined %}
									<li>
										<a href="{{ site.sadres }}mod_user_pm/hepsi">
											<i class="icon-envelope-letter"></i>
											{{ lang.mod_user.profile_menu.to_all_members }}</a>
									</li>
								{% endif %}
								<li class="divider"></li>
								<li>
									<a href="{{ site.sadres }}logout">
										<i class="icon-key"></i>
										{{ lang.mod_user.logout }}
									</a>
								</li>
							{% endif %}
						</ul>
					</li>
					<!-- END USER LOGIN DROPDOWN -->
				</ul>
			</div>
			<!-- END TOP NAVIGATION MENU -->
		</div><!-- END PAGE TOP --></div><!-- END HEADER INNER --></div><!-- END HEADER --><div class="clearfix"></div>
<!-- END: @templates/admin/management/shared/html/layout4/header.twig -->
