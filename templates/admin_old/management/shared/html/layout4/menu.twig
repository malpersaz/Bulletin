<!-- START: @templates/admin/management/shared/html/layout/menu.twig -->
<!-- BEGIN MEGA MENU -->
<!-- DOC: Apply "hor-menu-light" class after the "hor-menu" class below to have a horizontal menu with white background -->
<!-- DOC: Remove data-hover="dropdown" and data-close-others="true" attributes below to disable the dropdown opening on mouse hover -->
	<ul class="page-sidebar-menu " data-keep-expanded="false" data-auto-scroll="true" data-slide-speed="200"> <li>
		<a href="{{ site.sadres }}mod_user/panel">
			<i class="icon-home"></i>
			{{ lang.management.anasayfa }}</a>
	</li>
	{% if session.permissions.mod_user.list is defined %}
		<li {% if mod is defined and mod and (mod == 'mod_user' or mod == 'mod_user_group' or mod == 'mod_acl' or mod == 'mod_gallery_mod' or mod == 'mod_attachment_mod' or mod == 'mod_settings') %} class="active open" {% endif %}>
			<a href="javascript:;">
				<i class="icon-user"></i>
				<span class="title">{{ lang.management.uyelik }}</span>
				{% if mod == 'mod_user' or
                    mod == 'mod_user_group' or
                    mod == 'mod_acl' or
                    mod == 'mod_gallery_mod' or
                    mod == 'mod_attachment_mod' %}
					<span class="arrow open"></span>
				{% else %}
					<span class="arrow "></span>
				{% endif %}
			</a>
			<ul class="sub-menu">
				{% if session.permissions.mod_user.list is defined %}
					<li {% if mod is defined and mod == 'mod_user' %} class="active" {% endif %}>
						<a href="{{ site.sadres }}mod_user/list">{{ lang.management.uyeler }}</a>
					</li>
				{% endif %}
				{% if session.permissions.mod_user.setting is defined %}
					<li>
						<a href="{{ site.sadres }}mod_user/settings">{{ lang.management.membership_setting }}</a>
					</li>
				{% endif %}
				{% if session.permissions.mod_user_group.list is defined %}
					<li {% if mod is defined and mod == 'mod_user_group' %} class="active" {% endif %}>
						<a href="{{ site.sadres }}mod_user_group/list">{{ lang.management.uye_gruplari }}</a>
					</li>
				{% endif %}
				{% if session.permissions.mod_user.acl is defined %}
					<li>
						<a href="{{ site.sadres }}mod_user/acl">{{ lang.management.uye_permissions_yonetimi_acl }}</a>
					</li>
				{% endif %}
				{% if session.permissions.mod_acl.list is defined %}
					<li {% if mod is defined and mod == 'mod_acl' %} class="active" {% endif %}>
						<a href="{{ site.sadres }}mod_acl/list">
							<i class="fa fa-database"></i>
							{{ lang.management.acl }}</a>
					</li>
				{% endif %}
				{% if session.permissions.mod_gallery_mod.list is defined %}
					<li {% if mod is defined and mod == 'mod_gallery_mod' %} class="active" {% endif %}>
						<a href="{{ site.sadres }}mod_gallery_mod/list">
							<i class="fa fa-picture-o"></i>
							{{ lang.management.gallery_modulleri }}</a>
					</li>
				{% endif %}
				{% if session.permissions.mod_attachment_mod.list is defined %}
					<li {% if mod is defined and mod == 'mod_attachment_mod' %} class="active" {% endif %}>
						<a href="{{ site.sadres }}mod_attachment_mod/list">
							<i class="fa fa-file"></i>
							{{ lang.management.dosya_modulleri }}</a>
					</li>
				{% endif %}
				{% if session.permissions.mod_settings.list is defined %}
					<li {% if mod == 'mod_settings' %} class="active" {% endif %}>
						<a href="{{ site.sadres }}mod_settings/list">
							<i class="fa fa-globe"></i>
							{{ lang.management.locale_management }}</a>
					</li>
				{% endif %}
			</ul>
		</li>
	{% endif %}
	<li {% if mod is defined and mod and (mod == 'mod_category' or mod == 'mod_content' or mod == 'mod_menu' or mod == 'mod_page' or mod == 'mod_document' or mod == 'mod_survey' or mod == 'mod_service_guide') %} class="active open" {% endif %}>
		<a href="javascript:;">
			<i class="icon-rocket"></i>
			<span class="title">{{ lang.management.content_and_page }}</span>
			{% if mod == 'mod_category' or
                mod == 'mod_content' or
                mod == 'mod_menu' or
                mod == 'mod_page' or
                mod == 'mod_document' or
                mod == 'mod_survey' or
                mod == 'mod_service_guide' %}
				<span class="arrow open"></span>
			{% else %}
				<span class="arrow "></span>
			{% endif %}
		</a>
		<ul class="sub-menu">
			{% if session.permissions.mod_category.list is defined %}
				<li {% if mod is defined and mod == 'mod_category' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_category/list">
						<i class="fa fa-file-text"></i>
						{{ lang.management.content_categories }}</a>
				</li>
			{% endif %}
			{% if session.permissions.mod_content.list is defined %}
				<li {% if mod is defined and mod == 'mod_content' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_content/list">
						<i class="fa fa-file-text"></i>
						{{ lang.management.content_management }}</a>
				</li>
			{% endif %}
			{% if session.permissions.mod_menu.list is defined %}
				<li {% if mod is defined and mod == 'mod_menu' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_menu/list">
						<i class="fa fa-cube"></i>
						{{ lang.management.menu_management }}</a>
				</li>
			{% endif %}
			{% if session.permissions.mod_page.list is defined %}
				<li {% if mod is defined and mod == 'mod_page' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_page/list">
						<i class="fa fa-file-text"></i>
						{{ lang.management.page_management }}</a>
				</li>
			{% endif %}

			{% if session.permissions.mod_document.list is defined %}
				<li {% if mod is defined and mod == 'mod_document' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_document/list">
						<i class="fa fa-file"></i>
						{{ lang.management.file_management }}</a>
				</li>
			{% endif %}
			{% if session.permissions.mod_survey.list is defined %}
				<li {% if mod is defined and mod == 'mod_survey' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_survey/list">
						<i class="fa fa-language"></i>
						{{ lang.management.survey_management }}</a>
				</li>
			{% endif %}
			{% if session.permissions.mod_service_guide.list is defined %}
				<li {% if mod is defined and mod == 'mod_service_guide' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_service_guide/list">
						<i class="fa fa-bank"></i>
						{{ lang.management.service_guide }}</a>
				</li>
			{% endif %}
		</ul>
	</li>
	<li {% if mod is defined and mod and (mod == 'mod_video' or mod == 'mod_video_embed' or mod == 'mod_video_embed_category' or mod == 'mod_slider' or mod == 'mod_headline' or mod == 'mod_imagecategories') %} class="active open" {% endif %}>
		<a href="javascript:;">
			<i class="fa fa-video-camera"></i>
			<span class="title">{{ lang.management.video_and_images }}</span>
			{% if mod == 'mod_video' or
                mod == 'mod_video_embed' or
                mod == 'mod_video_embed_category' or
mod == 'mod_slider' or
                mod == 'mod_headline' or
                mod == 'mod_imagecategories' %}
				<span class="arrow open"></span>
			{% else %}
				<span class="arrow "></span>
			{% endif %}
		</a>
		<ul class="sub-menu">
			{% if session.permissions.mod_video.list is defined %}
				<li {% if mod is defined and mod == 'mod_video' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_video/list">
						<i class="fa fa-video-camera"></i>
						{{ lang.management.videos }}</a>
				</li>
			{% endif %}
			{% if session.permissions.mod_video_embed.list is defined %}
				<li {% if mod is defined and mod == 'mod_video_embed' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_video_embed/list">
						<i class="fa fa-video-camera"></i>
						{{ lang.management.remote_videos }}</a>
				</li>
			{% endif %}
			{% if session.permissions.mod_video_embed_category.list is defined %}
				<li {% if mod is defined and mod == 'mod_video_embed_category' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_video_embed_category/list">
						<i class="fa fa-building"></i>
						{{ lang.management.uzak_video_kategorisi }}</a>
				</li>
			{% endif %}
			{% if session.permissions.mod_slider.list is defined %}
				<li {% if mod is defined and mod == 'mod_slider' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_slider/list">
						<i class="fa fa-users"></i>
						{{ lang.management.manset_yonetimi }}</a>
				</li>
			{% endif %}
			{% if session.permissions.mod_headline.list is defined %}
				<li {% if mod is defined and mod == 'mod_headline' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_headline/list">
						<i class="fa fa-users"></i>
						{{ lang.management.full_manset_yonetimi }}</a>
				</li>
			{% endif %}
			{% if session.permissions.mod_imagecategories.list is defined %}
				<li {% if mod is defined and mod == 'mod_imagecategories' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_imagecategories/list">
						<i class="fa fa-photo"></i>
						{{ lang.management.resim_gallery }}</a>
				</li>
			{% endif %}
		</ul>
	</li>
	<li {% if mod is defined and mod and (mod == 'mod_announcements' or mod == 'mod_popup') %} class="active open" {% endif %}>
		<a href="javascript:;">
			<i class="fa fa-bullhorn"></i>
			<span class="title">{{ lang.management.announcement_management }}</span>
			{% if mod == 'mod_announcements' or mod == 'mod_popup' %}
				<span class="arrow open"></span>
			{% else %}
				<span class="arrow "></span>
			{% endif %}
		</a>
		<ul class="sub-menu">
			{% if session.permissions.mod_announcements.list is defined %}
				<li {% if mod is defined and mod == 'mod_announcements' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_announcements/list">
						<i class="fa fa-volume-up"></i>
						{{ lang.management.announcement_management }}</a>
				</li>
			{% endif %}
			{% if session.permissions.mod_popup.list is defined %}
				<li {% if mod is defined and mod == 'mod_popup' %} class="active" {% endif %}>
					<a href="{{ site.sadres }}mod_popup/list">
						<i class="fa fa-building"></i>
						{{ lang.management.popup_announcements }}</a>
				</li>
			{% endif %}
		</ul>
	</li>
</ul>
<!-- END MEGA MENU -->
<!-- END: @templates/admin/management/shared/html/layout/menu.twig -->
