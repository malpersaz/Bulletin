<div class="input-group">
	<div class="input-group-btn" style="width: 30%;">
		<select class="form-control" name="country_code" id="country_code">
			<option value="">{{ lang.mod_user.register.country_codes.select }}</option>
			{% for code in country_codes %}
				<option value="{{ code.code }}" {% if country_code_value == code.code %} selected {% endif %}>{{ code.country }}
					({{ code.code }})</option>
			{% endfor %}
		</select>
	</div>
	<input type="text" class="form-control validate[required,custom[phone]]" name="phone" id="phone" value="{{ phone_value }}" placeholder="5XX XXX XX XX" style="width: 70%;">
	<span class="input-group-addon input-circle-right">
		<i class="fa fa-phone"></i>
	</span>
</div>
