{% extends "management/admin-layout.twig" %}
{% block extra %}
    <script>
        $(document).ready(function () {
            $("#editForm").validationEngine();
        });


        function verifyPasswords() {
            if ($("#new_password").val() != $("#confirm_password").val()) {
                return false;
            } else {
                return true;
            }
        }


        /*	function sifrem(){
         if($("#sifre").val()!="" || $("#sifre2").val()!=""){
         if($("#sifre").val() != $("#sifre2").val() ){
         return true;
         }else{
         return false;

         }
         }
         }
         */
    </script>
{% endblock %}
{% block title %}{{ lang.mod_user.password_change }}{% endblock %}
{% block body %}
    <div class="portlet box green">
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-gift"></i>{{ lang.mod_user.password_change }}
            </div>
        </div>
        <div class="portlet-body form">
            {% if oke is defined %}
                <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
                <div class="alert alert-success">
                    <strong>Tamam!</strong> {{ mesaj }}
                </div>
                <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
            {% else %}
                {% if errors is defined %}
                    <!--[if !IE]>Error Messages<![endif]-->
                    {% for error in errors %}
                        <div class="alert alert-danger">
                            <strong>{{ lang.mod_user.error_title }}</strong> {{ error }}
                        </div>
                    {% endfor %}
                    <!--[if !IE]>Error Messages<![endif]-->
                {% endif %}
                <!-- BEGIN FORM-->
                <form method="POST" action="" id="changePasswordForm" class="form-horizontal">
                    <div class="form-body">
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_user.current_password_label }}</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input type="password"
                                           name="password"
                                           id="password"
                                           class="form-control input-circle-left validate[required,length[6,20]]"
                                           placeholder="{{ lang.mod_user.current_password_label }}">
                                    <span class="input-group-addon input-circle-right">
                                        <i class="fa fa-user"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_user.new_password }}</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input type="password"
                                           name="new_password"
                                           id="new_password"
                                           class="form-control input-circle-left validate[required,length[6,20]]"
                                           placeholder="{{ lang.mod_user.new_password }}">
                                    <span class="input-group-addon input-circle-right">
                                        <i class="fa fa-user"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_user.confirm_new_password }}</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input type="password"
                                           name="confirm_password"
                                           id="confirm_password"
                                           class="form-control input-circle-left validate[required,funcCall[verifyPasswords]length[6,20]]"
                                           placeholder="{{ lang.mod_user.confirm_new_password }}">
                                    <span class="input-group-addon input-circle-right">
                                        <i class="fa fa-user"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group last">
                            <label class="col-md-3 control-label">{{ lang.mod_user.username }}</label>
                            <div class="col-md-4">
                                <span class="form-control-static">{{ session.username }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <div class="row">
                            <div class="col-md-offset-3 col-md-9">
                                <button type="submit"
                                        name="edit"
                                        value="{{ lang.mod_user.change }}"
                                        class="btn green">{{ lang.mod_user.change }}</button>
                                <button type="reset" class="btn default">{{ lang.mod_user.button.vazgec }}</button>
                            </div>
                        </div>
                    </div>
                </form>
                <!-- END FORM-->
            {% endif %}
        </div>
    </div>
{% endblock %}
