{% extends "management/admin-layout.twig" %}
{% block extra %}
	<script>
		$(document).ready(function () {
$("#edit").validationEngine();

$.datepicker.setDefaults($.datepicker.regional['tr']);

$("#dtarih").datepicker({changeYear: true, changeMonth: true, dateFormat: 'yy-mm-dd', firstDay: 1});


if ($("#cep").val() == "") {
$("#cep").val("0 (5");
}


$('#about').kalanKarakter({
limit: 255,
mesaj: '#1',
kapsa: $('#remaining'),
uyari: function () {
alert('{{ lang.mod_user.max_chars_255 }}');
}
});


// Tarih Mask
$.mask.masks.created_at = {
mask: '9999-99-99'
}
// Yakalayıp Uygulayalım
$('input:text').setMask();
});

function s() {
if ($("#cep").val() == "0 (5") {
$("#cep").val("");
}
}


function deleteImage(id) { // Confirm dialog
$.prompt('{{ lang.mod_user.admin.confirm_remove_image }}', {
buttons: [
{
title: '{{ lang.mod_user.admin.yes }}',
value: true
}, {
title: '{{ lang.mod_user.admin.no }}',
value: false
}
],
submit: function (v, m, f) { // If accepted
if (v === true) {
$.ajax({
type: "POST",
url: "{{ site.adres }}mod_user/resimsil",
data: {
id: id
},
success: function (msg) {
if (msg == 'Oke') {
$.achtung({className: 'achtungSuccess', message: '{{ lang.mod_user.admin.image_removed_success }}', timeout: 5});
$("#image-" + id).html('<input name="image" type="file">');


} else {
$.achtung({className: 'achtungFail', message: msg, timeout: 5});
}
}
});
}
}
});
}

// /^(0) \([5][0-9][0-9]\) [1-9]([0-9]){2}[-]([0-9]){4}$/
	</script>
{% endblock %}
{% block title %}
	{{ lang.mod_user.info_change }}
{% endblock %}
{% block body %}
	<div class="portlet box green">
		<div class="portlet-title">
			<div class="caption">
				<i class="fa fa-gift"></i>
				{{ lang.mod_user.info_change }}
			</div>
		</div>
		<div class="portlet-body form">
			{% if oke is defined %}
				<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
				<div class="alert alert-success">
					<strong>Tamam!</strong>
					{{ mesaj }}
				</div>
				<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
			{% else %}
				{% if errors is defined %}
					<!--[if !IE]>Error Messages<![endif]-->
					{% for error in errors %}
						<div class="alert alert-danger">
							<strong>{{ lang.mod_user.error_label }}</strong>
							{{ error }}
						</div>
					{% endfor %}
					<!--[if !IE]>Error Messages<![endif]-->
				{% endif %}
				<!-- BEGIN FORM-->
				<form method="POST" action="" id="editForm" class="form-horizontal" enctype="multipart/form-data" onsubmit="s();">
					<div class="form-body">
						<div class="form-group">
							<label class="col-md-3 control-label">
								{{ lang.mod_user.current_password_label }}
								:
							</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left validate[required,length[6,20]]" name="password" type="password" id="password">
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-user"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">
								{{ lang.mod_user.your_name }}
								:
							</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left validate[required,length[2,50]]" name="name" value="{{ d.name }}" type="text" id="name">
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-user"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">
								{{ lang.mod_user.your_surname }}
								:
							</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left validate[required,length[2,50]]" name="last_name" value="{{ d.last_name }}" type="text" id="last_name">
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-user"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">
								{{ lang.mod_user.your_email }}
								:
							</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left validate[required,custom[email]]" name="email" value="{{ d.email }}" type="text" id="email">
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-envelope"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">
								{{ lang.mod_user.membership_date }}
								:
							</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left" value="{{ d.created_at }}" type="text" disabled/>
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-calendar"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">
								{{ lang.mod_user.update_date }}
								:
							</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left" value="{{ d.dtarih }}" type="text" disabled/>
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-calendar"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">
								{{ lang.mod_user.mobile_phone }}
								:
							</label>
							<div class="col-md-4">
								{% include 'management/mod_user/parts/phone_input.twig' with {
                                    'country_code_value': d.country_code,
                                    'phone_value': d.phone
                                } %}
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">
								{{ lang.mod_user.city }}
								:
							</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left" name="city" value="{{ d.city }}" type="text" id="city">
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-user"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">
								{{ lang.mod_user.blog_name }}
								:
							</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left" name="blog_name" value="{{ d.blog_name }}" type="text" id="blog_name">
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-pencil"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">
								{{ lang.mod_user.about_me }}
								:
							</label>
							<div class="col-md-4">
								<div class="input-group">
									<textarea class="form-control" name="about" id="about" row="3">{{ d.about }}</textarea>
									<span id="remaining" style="font-weight:bold"></span>
								</div>
							</div>
						</div>
						<div class="form-group last">
							<label class="col-md-3 control-label">
								{{ lang.mod_user.profile_picture }}
								:
							</label>
							<div class="col-md-4">
								<div class="input-group">
									{% if d.image == "" %}
										<div class="custom-file-upload">
											<label class="btn default btn-file" style="overflow: hidden; position: relative;">
												<span id="upload-text">{{ lang.mod_user.button.select_image }}</span>
												<input type="file" name="image" id="image_input" style="position: absolute; top: 0; right: 0; min-width: 100%; min-height: 100%; font-size: 100px; text-align: right; filter: alpha(opacity=0); opacity: 0; outline: none; background: white; cursor: inherit; display: block;">
											</label>
											<span id="file-name" style="margin-left: 10px;"></span>
											<a href="javascript:;" id="remove-file" class="btn btn-xs red" style="display:none; margin-left: 5px;">{{ lang.mod_user.button.kaldir }}</a>
										</div>
										<script>
											$(document).ready(function () {
$('#image_input').change(function () {
var filename = $(this).val().split('\\').pop();
if (filename) {
$('#file-name').text(filename);
$('#upload-text').text('{{ lang.mod_user.change }}'); // Change
$('#remove-file').show();
} else {
$('#file-name').text('');
$('#upload-text').text('{{ lang.mod_user.button.select_image }}');
$('#remove-file').hide();
}
});
$('#remove-file').click(function () {
$('#image_input').val(''); // Clear input
$('#file-name').text('');
$('#upload-text').text('{{ lang.mod_user.button.select_image }}');
$(this).hide();
});
});
										</script>
									{% else %}
										<div id="image-{{ d.id }}">
											<img src="static/mod_user/{{ d.image }}">
											<a href="javascript:void(0)" onclick="deleteImage('{{ d.id }}');">{{ lang.mod_user.admin.delete }}</a>
										</div>
									{% endif %}
								</div>
							</div>
						</div>
					</div>
					<div class="form-actions">
						<div class="row">
							<div class="col-md-offset-3 col-md-9">
								<button type="submit" name="edit" value="{{ lang.mod_user.change }}" class="btn green">{{ lang.mod_user.change }}</button>
								<a href="{{ site.sadres }}mod_user/panel" class="btn default">{{ lang.mod_user.button.vazgec }}</a>
							</div>
						</div>
					</div>
				</form>
				<!-- END FORM-->
			{% endif %}
		</div>
	</div>
{% endblock %}
