{% extends "management/admin-layout.twig" %}
{% block extra %}
	<script>
		$(document).ready(function () {
$("#editForm").validationEngine();
});
	</script>
{% endblock %}
{% block title %}
	{{ lang.mod_user.admin.6 }}
{% endblock %}
{% block body %}
	<div class="portlet box green">
		<div class="portlet-title">
			<div class="caption">
				<i class="fa fa-gift"></i>
				{{ lang.mod_user.admin.6 }}
			</div>
		</div>
		<div class="portlet-body form">
			{% if oke is defined %}
				<div class="alert alert-success">
					<strong>Tamam!</strong>
					{{ mesaj }}
				</div>
			{% else %}
				{% if errors is defined %}
					{% for error in errors %}
						<div class="alert alert-danger">
							<strong>{{ lang.mod_user.error_title }}</strong>
							{{ error }}
						</div>
					{% endfor %}
				{% endif %}
				<!-- BEGIN FORM-->
				<form method="POST" action="" id="editForm" class="form-horizontal" enctype="multipart/form-data">
					<div class="form-body">
						<div class="form-group">
							<label class="col-md-3 control-label">{{ lang.mod_user.username }}
								:</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left validate[required,length[3,20]]" name="username" value="{{ d.username }}" type="text" id="username">
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-user"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">{{ lang.mod_user.password }}
								:</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left" name="password" type="password" id="password">
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-user"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">{{ lang.mod_user.email }}
								:</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left validate[required,custom[email]]" name="email" value="{{ d.email }}" type="text" id="email">
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-envelope"></i>
									</span>
								</div>
							</div>
						</div>
						{% macro select(parent_id, level) %}
							{% for entry in group[parent_id] %}
								{% set parent_id = entry.group_id %}
								<option value="{{ entry.group_id }}" {% if d.group_id == entry.group_id %} selected="selected" {% endif %}>
									{{ '-'|repeat(level) }}{{ entry.name }}
								</option>
								{% if group[parent_id] is defined %}
									{{ _self.select(parent_id, level + 1) }}
								{% endif %}
							{% endfor %}
						{% endmacro %}
						<div class="form-group">
							<label class="col-md-3 control-label">{{ lang.mod_user.admin.user_group }}
								:</label>
							<div class="col-md-4">
								<div class="input-group">
									<select class="form-control input-xlarge validate[required]" name="group_id" id="group_id">{{ _self.select(0, 0) }}</select>
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-user"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">{{ lang.mod_user.your_name }}
								:</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left validate[required,length[2,50]]" name="name" value="{{ d.name }}" type="text" id="name">
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-user"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">{{ lang.mod_user.your_surname }}
								:</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left validate[required,length[2,50]]" name="last_name" value="{{ d.last_name }}" type="text" id="last_name">
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-user"></i>
									</span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-md-3 control-label">{{ lang.mod_user.mobile_phone }}
								:</label>
							<div class="col-md-4">
								{% include 'management/mod_user/parts/phone_input.twig' with {
                                    'country_code_value': d.country_code,
                                    'phone_value': d.phone
                                } %}
							</div>
						</div>
						
						<div class="form-group">
							<label class="col-md-3 control-label">{{ lang.mod_user.profile_picture }}
								:</label>
							<div class="col-md-4">
								<div class="input-group">
									<input type="file" name="image" id="image" class="form-control">
								</div>
								{% if d.image is defined and d.image != '' %}
									<div style="margin-top: 10px;">
										<img src="static/mod_user/{{ d.image }}" style="max-width: 100px; max-height: 100px;" alt="Current Avatar">
									</div>
								{% endif %}
							</div>
						</div>

						<div class="form-group">
							<label class="col-md-3 control-label">{{ lang.mod_user.membership_date }}
								:</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left" value="{{ d.created_at }}" type="text" disabled>
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-calendar"></i>
									</span>
								</div>
							</div>
						</div>

						<div class="form-group">
							<label class="col-md-3 control-label">{{ lang.mod_user.update_date }}
								:</label>
							<div class="col-md-4">
								<div class="input-group">
									<input class="form-control input-circle-left" value="{{ d.updated_at }}" type="text" disabled>
									<span class="input-group-addon input-circle-right">
										<i class="fa fa-calendar"></i>
									</span>
								</div>
							</div>
						</div>
					</div>
					<div class="form-actions">
						<div class="row">
							<div class="col-md-offset-3 col-md-9">
								<button type="submit" name="edit" value="{{ lang.mod_user.admin.edit_user }}" class="btn green">{{ lang.mod_user.admin.edit_user }}</button>
								<a href="mod_user/list" class="btn default">{{ lang.mod_user.button.vazgec }}</a>
							</div>
						</div>
					</div>
				</form>
			{% endif %}
		</div>
	</div>
{% endblock %}
