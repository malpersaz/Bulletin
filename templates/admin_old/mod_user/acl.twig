{% extends "management/admin-layout.twig" %}
{% block title %}
	{{ lang.mod_user.admin.9 }}
{% endblock %}
{% block extra %}
	<script>
		function degis(gell, m) {
var status = $(gell).attr('checked');
var val = $(gell).attr('val');
$("." + m + "-" + val + "-grup").each(function () {
if (status === 'checked') { // this.checked = true;
$(this).attr('checked', 'checked');
$(this).parent().addClass("checked");
} else { // this.checked = false;
$(this).attr("checked", false);
$(this).parent().removeClass("checked");
}
});
}
	</script>
{% endblock %}
{% block body %}
	{% if oke is defined %}
		<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
		<div class="alert alert-success">
			<strong>{{ lang.mod_user.success }}</strong>
			{{ mesaj }}
		</div>
		<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
	{% endif %}
	{% if error %}
		<!--[if !IE]>Error Message<![endif]-->
		<div class="alert alert-danger">
			<strong>{{ lang.mod_user.error }}</strong>
			{{ error }}
		</div>
		<!--[if !IE]>Error Message<![endif]-->
	{% endif %}
	<form action="" method="POST">
		{% for m in modlar %}
			{% set mod_name = m.mod_name %}
			{% set mod_id = m.mod_id %}
			<div class="portlet box green">
				<div class="portlet-title">
					<div class="caption">
						<i class="fa fa-gift"></i>
						{{ attribute(lang, m.mod_name).roll.roles | default(attribute(lang, m.mod_name).roll.name) | default(m.mod_name) }}
						<!-- DEBUG: {{ m.mod_name }} -> {{ attribute(lang, m.mod_name).roll.roles | default(attribute(lang, m.mod_name).roll.name) }} -->
					</div>
				</div>
				<div class="portlet-body">
					<div class="table-scrollable">
						<table class="table table-bordered table-hover">
							<thead>
								<tr>
									<th>{{ lang.mod_user.admin.user_group }}</th>
									{% for grup in gruplar %}
										<th>
											<input type="checkbox" onchange="javascript:degis(this,'{{ m.mod_id }}')" val="{{ grup.group_id }}"/>
											{{ lang.mod_user.groups[grup.name] | default(grup.name) }}
										</th>
									{% endfor %}
								</tr>
							</thead>
							<tbody>
								{% for roll in attribute(roller, mod_id) %}
									<tr>
										{% set roll_name = roll.roll_name %}
										<td>{{ attribute(attribute(lang, mod_name).roll, roll.roll_name) | default(roll.roll_name) }}</td>
										{% for grup in gruplar %}
											<td>
												<input type="checkbox" class="{{ m.mod_id }}-{{ grup.group_id }}-grup" name="list[{{ grup.group_id }}][{{ m.mod_id }}][{{ roll.roll_id }}]" {% for p in permler %} {% if grup.group_id == p.group_id and m.mod_id == p.mod_id and roll.roll_id == p.roll_id %} checked="checked" {% endif %} {% endfor %}>
											</td>
										{% endfor %}
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		{% endfor %}
		<div class="portlet box blue">
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-cogs"></i>
					{{ lang.mod_user.last_step }}
				</div>
			</div>
			<div class="portlet-body">
				<div class="form-actions">
					<div class="row">
						<div class="col-md-12">
							<button type="submit" name="gonder" value="{{ lang.mod_user.admin.refresh_permissions }}" class="btn green col-md-12">{{ lang.mod_user.admin.refresh_permissions }}</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</form>
{% endblock %}
