{% extends "management/admin-layout.twig" %}
{% block extra %}
    <script>
        $(document).ready(function () {
            $("#editForm").validationEngine();
        });
    </script>
{% endblock %}
{% block title %}{{ lang.mod_user.admin.membership_settings }}{% endblock %}
{% block body %}
    <div class="portlet box green">
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-gift"></i>{{ lang.mod_user.admin.membership_settings }}
            </div>
        </div>
        <div class="portlet-body form">
            {% if oke is defined %}
                <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
                <div class="alert alert-success">
                    <strong>Tamam!</strong> {{ mesaj }}
                </div>
                <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
            {% else %}
                {% if errors is defined %}
                    <!--[if !IE]>Error Messages<![endif]-->
                    {% for error in errors %}
                        <div class="alert alert-danger">
                            <strong>{{ lang.mod_user.error_title }}</strong> {{ error }}
                        </div>
                    {% endfor %}
                    <!--[if !IE]>Error Messages<![endif]-->
                {% endif %}
                <!-- BEGIN FORM-->
                <form method="POST" action="" id="editForm" class="form-horizontal">
                    <div class="form-body">
                        {% macro select(parent_id, level) %}
                            {% for entry in attribute(group, parent_id) %}
                                {% set parent_id = entry.group_id %}
                                <option value="{{ entry.group_id }}"
                                        {% if entry.group_id == d.group_id %}selected="selected"{% endif %}>
                                    {{ '-'|repeat(level) ~ entry.name }}
                                </option>
                                {% if attribute(group, parent_id) is not empty and attribute(group, parent_id) is iterable %}
                                    {{ _self.select(parent_id, level + 1) }}
                                {% endif %}
                            {% endfor %}
                        {% endmacro %}
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_user.admin.settings.new_user_group }}  :</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <select class="form-control input-xlarge validate[required]"
                                            name="group_id"
                                            id="group_id">{{ _self.select(0, 0) }}</select>
                                <span class="input-group-addon input-circle-right">
                                    <i class="fa fa-user"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-3 control-label">{{ lang.mod_user.admin.settings.membership_open }} :</label>
                        <div class="col-md-4">
                            <div class="input-group">
                                <select name="status" class="form-control">
                                    <option value="1" {% if status == '1' %}selected="selected"{% endif %}>{{ lang.mod_user.admin.settings.open }}</option>
                                    <option value="0" {% if status == '0' %}selected="selected"{% endif %}>{{ lang.mod_user.admin.settings.closed }}</option>
                                </select>
                                <span class="input-group-addon input-circle-right">
                                    <i class="fa fa-user"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-3 control-label">{{ lang.mod_user.admin.settings.membership_activation }} :</label>
                        <div class="col-md-4">
                            <div class="input-group">
                                <select name="activation" class="form-control">
                                    <option value="2" {% if activation == '2' %}selected="selected"{% endif %}>{{ lang.mod_user.admin.settings.admin_approval }}</option>
                                    <option value="1" {% if activation == '1' %}selected="selected"{% endif %}>{{ lang.mod_user.admin.settings.email_approval }}</option>
                                    <option value="0" {% if activation == '0' %}selected="selected"{% endif %}>{{ lang.mod_user.admin.settings.automatic_approval }}</option>
                                </select>
                                <span class="input-group-addon input-circle-right">
                                    <i class="fa fa-user"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-3 control-label">{{ lang.mod_user.admin.settings.allow_multiple_logins }} :</label>
                        <div class="col-md-4">
                            <div class="input-group">
                                <select name="check_user_login" class="form-control">
                                    <option value="1"
                                            {% if check_user_login == '1' %}selected="selected"{% endif %}>
                                        {{ lang.mod_user.admin.settings.yes }}
                                    </option>
                                    <option value="2"
                                            {% if check_user_login == '2' %}selected="selected"{% endif %}>
                                        {{ lang.mod_user.admin.settings.no }}
                                    </option>
                                </select>
                                <span class="input-group-addon input-circle-right">
                                    <i class="fa fa-user"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <div class="row">
                        <div class="col-md-offset-3 col-md-9">
                            <button type="submit"
                                    name="edit"
                                    value="{{ lang.mod_user.admin.update_membership_settings }}"
                                    class="btn green">{{ lang.mod_user.admin.update_membership_settings }}</button>
                            <button type="reset" class="btn default">{{ lang.mod_user.button.vazgec }}</button>
                        </div>
                    </div>
                </div>
            </form>
            <!-- END FORM-->
        {% endif %}
    </div>
</div>
{% endblock %}
