<div class="input-group">
	<span class="input-group-addon" style="padding: 0; border: none;">
		<select class="form-control" id="country_code" name="country_code" style="width: 100px; border-right: 0;">
			<option value="">{{ lang.mod_user.register.country_codes.select }}</option>
			{% for code in country_codes %}
				<option value="{{ code.code }}" {% if country_code_value == code.code %} selected {% endif %}>{{ code.country }}
					({{ code.code }})</option>
			{% endfor %}
		</select>
	</span>
	<input class="form-control input-circle-left validate[required,custom[phone]]" name="phone" value="{{ phone_value }}" type="text" id="phone" placeholder="555 123 4567">
	<span class="input-group-addon input-circle-right">
		<i class="fa fa-phone"></i>
	</span>
</div>
