$('.date-picker').datepicker({rtl: Metronic.isRTL(), autoclose: true});
},
setGrid: function (grid) {
mod_user_table_ajax.grid = grid;
},
getGrid: function () {
return mod_user_table_ajax.grid
},
reloadGrid: function () {
mod_user_table_ajax.gridAction.getGrid().getDataTable().ajax.reload();
},
