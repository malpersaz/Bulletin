<script>

	var mod_user_table_ajax = mod_user_table_ajax || {};

mod_user_table_ajax.grid = {};

mod_user_table_ajax.akm = {
{% if session.permissions.mod_user.gallery is defined %}
processGallery : function (id) {
window.location = '{{ site.adres }}mod_gallery/list/mod_user/' + id;
},{% endif %}{% if session.permissions.mod_user.file is defined %}processFile : function (id) {
window.location = '{{ site.adres }}mod_attachment/list/mod_user/' + id;
},{% endif %}{% if session.permissions.mod_user.delete is defined %}processDelete : function (id) {
bootbox.dialog({
message: "{{ lang.mod_user.remove_record }}",
title: "Confirmation",
buttons: {
success: {
label: "{{ lang.mod_user.button.evet }}",
className: "green",
callback: function () {
var deteleString = '';

if (typeof id === 'string') {
deteleString += 'sil[]=' + id;
} else {
id.forEach(function (entry) {
deteleString += '&sil[]=' + entry;
});
}
// Send Request
$.ajax({
type: "POST",
url: "{{ site.adres }}mod_user/delete",
data: deteleString,
success: function (msg) {
if (msg == 'Oke') {
oke_message(mod_user_table_ajax.gridAction.getGrid().getTableWrapper(), '{{ lang.mod_user.oke }}');
mod_user_table_ajax.gridAction.reloadGrid();
} else {
error_message(mod_user_table_ajax.gridAction.getGrid().getTableWrapper(), msg);
}
}
});
}
},
danger: {
label: "{{ lang.mod_user.button.hayir }}",
className: "red",
callback: function () {}
}
}
});
},{% endif %}{% if session.permissions.mod_user.edit is defined %}processStatus : function (id) {

bootbox.dialog({
message: "{{ lang.mod_user.grid.status.value }}",
title: "Confirmation",
buttons: {
success: {
label: "{{ lang.mod_user.button.evet }}",
className: "green",
callback: function () {
var deteleString = '';

if (typeof id === 'string') {
deteleString += 'query[]=' + id;
} else {
id.forEach(function (entry) {
deteleString += '&query[]=' + entry;
});
}
// Send Request
$.ajax({
type: "POST",
url: "{{ site.adres }}mod_user/status",
data: deteleString,
success: function (msg) {
if (msg == 'Oke') {
oke_message(mod_user_table_ajax.gridAction.getGrid().getTableWrapper(), '{{ lang.mod_user.oke }}');
mod_user_table_ajax.gridAction.reloadGrid();
} else {
error_message(mod_user_table_ajax.gridAction.getGrid().getTableWrapper(), msg);
}
}
});
}
},
danger: {
label: "{{ lang.mod_user.button.hayir }}",
className: "red",
callback: function () {}
}
}
});

},{% endif %}{% if session.permissions.mod_user.edit is defined %}processDeactivate : function (id) {

bootbox.dialog({
message: "{{ lang.mod_user.grid.deactivate.value }}",
title: "Confirmation",
buttons: {
success: {
label: "{{ lang.mod_user.button.evet }}",
className: "green",
callback: function () {
var deteleString = '';

if (typeof id === 'string') {
deteleString += 'query[]=' + id;
} else {
id.forEach(function (entry) {
deteleString += '&query[]=' + entry;
});
}
// Send Request
$.ajax({
type: "POST",
url: "{{ site.adres }}mod_user/deactivate",
data: deteleString,
success: function (msg) {
if (msg == 'Oke') {
oke_message(mod_user_table_ajax.gridAction.getGrid().getTableWrapper(), '{{ lang.mod_user.oke }}');
mod_user_table_ajax.gridAction.reloadGrid();
} else {
error_message(mod_user_table_ajax.gridAction.getGrid().getTableWrapper(), msg);
}
}
});
}
},
danger: {
label: "{{ lang.mod_user.button.hayir }}",
className: "red",
callback: function () {}
}
}
});

},{% endif %}{% if session.permissions.mod_user.edit is defined %}processEdit : function (id) {
window.location = '{{ site.adres }}mod_user/edit/' + id;
},{% endif %}akm: function () {}

};
mod_user_table_ajax.gridAction = {
