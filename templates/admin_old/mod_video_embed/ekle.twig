{% extends "management/admin-layout.twig" %}
{% block title %}
	{{ lang.mod_video_embed.add }}
{% endblock %}

{% macro select_nested_category_id_function(parent_id, level) %}
	{% for entry in attribute(select_nested_category_id_result, parent_id) %}
		{% set parent_id = entry.id %}
		{% if (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#') %}
			<optgroup label="{{ '-'|repeat(level) }}{{ entry.name }}{% if entry.lang is defined %} ({{ entry.lang }}){% endif %}">
			{% else %}
				<option value="{{ entry.id }}">
					{{ '-'|repeat(level) }}{{ entry.name }}
					{% if entry.lang is defined %}({{ entry.lang }})
					{% endif %}
				</option>
			{% endif %}
			{% if attribute(select_nested_category_id_result, parent_id) is not empty and attribute(select_nested_category_id_result, parent_id) is iterable %}
				{{ _self.select_nested_category_id_function(parent_id, level + 1) }}
			{% endif %}
			{% if (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#') %}
			</optgroup>
		{% endif %}
	{% endfor %}
{% endmacro %}

{% block body %}
	{% if error is defined %}
		<div class="alert alert-danger">
			<strong>{{ lang.mod_video_embed.error }}</strong>
			{{ mesaj }}
		</div>
	{% else %}
		<div class="portlet box green">
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-edit"></i>
					{{ lang.mod_video_embed.add }}
				</div>
			</div>
			<div
				class="portlet-body form">
				<!--  Mesajlar -->
				{% if oke is defined %}
					<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
					<div class="alert alert-success">
						<strong>{{ lang.mod_video_embed.oke }}</strong>
						{{ mesaj }}
						<hr>
						<a href="{{ site.sadres }}mod_video_embed/ekle" class="btn green">{{ lang.mod_video_embed.add }}</a>
						<a href="{{ site.sadres }}mod_video_embed/list" class="btn blue">{{ lang.mod_video_embed.list }}</a>
					</div>
					<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
				{% else %}
					{% if hatalar is defined %}
						<!--[if !IE]>Hata Mesajı Varsa<![endif]-->
						{% for hata in hatalar %}
							<div class="alert alert-danger">
								<strong>{{ lang.mod_video_embed.hata }}</strong>
								{{ hata }}
							</div>
						{% endfor %}
						<!--[if !IE]>Hata Mesajı Varsa<![endif]-->
					{% endif %}
					<form method="POST" action="" id="add" enctype="multipart/form-data" class="form-horizontal">
						<div class="form-body">
							<!-- İnputlar Başlar -->
							<!--[if !IE]>lang select Başlar<![endif]-->
								<div class="form-group"> <label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.lang }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge  validate[required]" name="lang" id="lang">
											{% for item in lang_lang %}
												<option value="{{ item.seo }}">
													{{ item.name }}
													{% if item.lang is defined %}({{ item.lang }})
													{% endif %}
												</option>
											{% endfor %}
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>lang select Biter<![endif]-->
							<!--[if !IE]>category_id select Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.category_id }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge  validate[required]" name="category_id" id="category_id">
											<option value="0" selected="selected">{{ lang.mod_video_embed.choose_wish }}</option>
											{{ _self.select_nested_category_id_function(0, 0) }}
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>category_id select Biter<![endif]-->
							<!--[if !IE]>name Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.name }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required,length[2,255]]" name="name" value="{{ name }}" type="text" id="name">
									</div>
								</div>
							</div>
							<!--[if !IE]>name Input Biter<![endif]-->
							<!--[if !IE]>original Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.original }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge " name="original" value="{{ original }}" type="text" id="original">
									</div>
								</div>
							</div>
							<!--[if !IE]>original Input Biter<![endif]-->
							<!--[if !IE]>sure Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.sure }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required,length[5,8]]" name="sure" value="{{ sure }}" type="text" id="sure">
									</div>
								</div>
							</div>
							<!--[if !IE]>sure Input Biter<![endif]-->
							<!--[if !IE]>created_at Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.created_at }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required]" name="created_at" value="{{ created_at }}" type="text" id="created_at">
									</div>
								</div>
							</div>
							<!--[if !IE]>created_at Input Biter<![endif]-->
							<!--[if !IE]>status Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.status }}
									:
								</label>
								<div class="col-md-4">
									<div class="radio-list">
										<label class="radio-inline">
											{{ lang.mod_video_embed.admin.radio.publish_yes }}
											<input name="status" value="y" type="radio" checked="checked"/>
										</label>
										<label class="radio-inline">
											{{ lang.mod_video_embed.admin.radio.publish_no }}
											<input name="status" value="n" type="radio"/>
										</label>
									</div>
								</div>
							</div>
							<!--[if !IE]>status Input Biter<![endif]-->
							<hr>
							<p id="embed_preview"></p>
							<hr>
							<!--[if !IE]>embed Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.embed }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<textarea class="form-control input-xlarge validate[required]" name="embed" id="embed">{{ embed }}</textarea>
									</div>
								</div>
							</div>
							<!--[if !IE]>embed Input Biter<![endif]-->
							<!--[if !IE]>content Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.content }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<div id="content" class="form-control">{{ content|default('')|raw }}</div>
										<input type="hidden" name="content" value="{{ content|default('') }}">
									</div>
								</div>
							</div>
							<!--[if !IE]>content Input Biter<![endif]-->
							<!--[if !IE]>title Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.title }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required]" name="title" value="{{ title }}" type="text" id="title">
									</div>
								</div>
							</div>
							<!--[if !IE]>title Input Biter<![endif]-->
							<!--[if !IE]>keywords Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.keywords }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required]" name="keywords" value="{{ keywords }}" type="text" id="keywords">
									</div>
								</div>
							</div>
							<!--[if !IE]>keywords Input Biter<![endif]-->
							<!--[if !IE]>description Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.description }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required]" name="description" value="{{ description }}" type="text" id="description">
									</div>
								</div>
							</div>
							<!--[if !IE]>description Input Biter<![endif]-->
							<!--[if !IE]>image İmage Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.image }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input name="image" type="file">
									</div>
								</div>
							</div>
							<!--[if !IE]>image İmage Biter<![endif]-->
							<!--[if !IE]>acl_id select Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video_embed.admin.columns.acl_id | raw }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge  validate[required]" name="acl_id" id="acl_id">
											<option value="0" selected="selected">{{ lang.mod_video_embed.choose_wish }}</option>
											{% for item in mod_acl_acl_id %}
												<option value="{{ item.id }}">
													{{ item.name }}
													{% if item.lang is defined %}({{ item.lang }})
													{% endif %}
												</option>
											{% endfor %}
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>acl_id select Biter<![endif]-->
							<!-- İnputlar Biter -->
						</div>
						<!-- form body end -->
						<div class="form-actions">
							<div class="row">
								<div
									class="col-md-offset-3 col-md-9">
									<!--[if !IE]>{{ lang.mod_video_embed.button.add }} Butonu<![endif]-->
									<button class="btn green" name="add" value="{{ lang.mod_video_embed.button.add }}">{{ lang.mod_video_embed.button.add }}</button>
									<a class="btn blue" href="{{ site.sadres }}mod_video_embed/list">{{ lang.mod_video_embed.button.vazgec }}</a>
									<!--[if !IE]>{{ lang.mod_video_embed.button.add }} Butonu<![endif]-->
								</div>
							</div>
						</div>
						<!-- form actions end -->
					</form>
				{% endif %}
			</div>
		</div>
	{% endif %}
{% endblock %}
{% block extra %}
	<script>
		$(document).ready(function () {
$("#add").validationEngine();

function temizle(veri) {

var temiz = veri.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, " ");
temiz = temiz.replace(/^\s+|\s+$/g, "");

for (i = 0; i <= 15; i ++) {
temiz = temiz.replace('  ', ' ');
}
return temiz;
}

// SEO YAPAR
function make_seo(name, seo) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, "_");
deger = deger.replace('İ', 'i');

$("#" + seo).val(deger);
});
}

// Make keywords
function make_keywords(name, keywords) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, ",");
deger = deger.toLowerCase();
deger = deger.replace('İ', 'i');

$("#" + keywords).val(deger);
});
}

// Make Title
function make_title(name, title) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + title).val(deger);
});
}

// Make Açıklama
function make_aciklama(name, description) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + description).val(deger);
});
}
// Make Preview
function make_preview(name) {
$("#" + name).change(function () {
$("#" + name + "_preview").html($("#" + name).val());
});
}

var simdi = new Date();
var yil = simdi.getFullYear();
var ay = (simdi.getMonth() < 9 ? '0' : '') + (simdi.getMonth() + 1);
var gun = (simdi.getDate() < 10 ? '0' : '') + simdi.getDate();
var saat = (simdi.getHours() < 10 ? '0' : '') + simdi.getHours();
var dakika = (simdi.getMinutes() < 10 ? '0' : '') + simdi.getMinutes();

var now = yil + "-" + ay + "-" + gun + " " + saat + ":" + dakika;

if ($("#created_at").val() == "") {
$("#created_at").val(now);
}

AnyTime.picker("created_at", {
format: "%z-%m-%d %H:%i",
firstDOW: 1,
placement: "popup",
labelDayOfMonth: "{{ lang.mod_video_embed.date_picker.labels.day_of_month }}",
labelHour: "{{ lang.mod_video_embed.date_picker.labels.hour }}",
labelMinute: "{{ lang.mod_video_embed.date_picker.labels.minute }}",
labelMonth: "{{ lang.mod_video_embed.date_picker.labels.month }}",
labelTitle: "{{ lang.mod_video_embed.date_picker.labels.title }}",
labelYear: "{{ lang.mod_video_embed.date_picker.labels.year }}",
dayAbbreviations: {{ lang.mod_video_embed.date_picker.days_short|json_encode|raw }},
dayNames: {{ lang.mod_video_embed.date_picker.days|json_encode|raw }},
monthAbbreviations: {{ lang.mod_video_embed.date_picker.months_short|json_encode|raw }},
monthNames: {{ lang.mod_video_embed.date_picker.months|json_encode|raw }}
});
make_preview('embed');
make_preview('embed');
make_title('name', 'title');
make_keywords('name', 'keywords');
make_aciklama('name', 'description');

});
	</script>
	<script type="text/javascript">
		$(document).ready(function () {
rich_editor('#content');
});
	</script>
	<!-- Javascript Biter -->
{% endblock %}
