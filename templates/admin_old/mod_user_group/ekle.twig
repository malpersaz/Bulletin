{% extends "management/admin-layout.twig" %}
{% block extra %}
    <script>
        $(document).ready(function () {
            $("#add").validationEngine();
        });
    </script>
{% endblock %}
{% block title %}{{ lang.mod_user_group.admin.1 }}{% endblock %}
{% block body %}
    <div class="portlet box green">
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-gift"></i>{{ lang.mod_user_group.admin.4 }}
            </div>
        </div>
        <div class="portlet-body form">
            {% if oke is defined %}
                <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
                <div class="alert alert-success">
                    <strong>Tamam!</strong> {{ mesaj }}
                </div>
                <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
            {% else %}
                {% if hatalar is defined %}
                    <!--[if !IE]>Hata Mesajı Varsa<![endif]-->
                    {% for hata in hatalar %}
                        <div class="alert alert-danger">
                            <strong>Hata!</strong> {{ hata }}
                        </div>
                    {% endfor %}
                    <!--[if !IE]>Hata Mesajı Varsa<![endif]-->
                {% endif %}
                <!-- BEGIN FORM-->
                <form method="POST" action="" id="add" class="form-horizontal">
                    <div class="form-body">
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_user_group.admin.7 }} :</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input class="form-control input-circle-left  validate[required,length[1,200]]"
                                           name="name"
                                           value="{{ name }}"
                                           type="text"
                                           id="name">
                                    <span class="input-group-addon input-circle-right">
                                        <i class="fa fa-user"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        {% macro select(parent_id = 0, level = 0, secili = 0, kendi = 0) %}
                            {% for entry in user_groupm[parent_id] %}
                                {% set parent_id = entry.group_id %}
                                <option value="{{ entry.group_id }}">{{ '-'|repeat(level) }}{{ entry.name }}</option>
                                {% if user_groupm[parent_id] is iterable %}{{ _self.select(parent_id, level + 1) }}{% endif %}
                            {% endfor %}
                        {% endmacro %}
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_user_group.admin.22 }} :</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <select class="form-control input-xlarge validate[required]"
                                            name="parent_id"
                                            id="parent_id">{{ _self.select() }}</select>
                                <span class="input-group-addon input-circle-right">
                                    <i class="fa fa-user"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <div class="row">
                        <div class="col-md-offset-3 col-md-9">
                            <button type="submit"
                                    name="add"
                                    value="{{ lang.mod_user_group.admin.8 }}"
                                    class="btn green">{{ lang.mod_user_group.admin.8 }}</button>
                            <a href="mod_user_group/list" class="btn default">{{ lang.mod_user_group.buttons.cancel }}</a>
                        </div>
                    </div>
                </div>
            </form>
            <!-- END FORM-->
        {% endif %}
    </div>
</div>
{% endblock %}
