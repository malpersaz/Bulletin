function tasi(parent_id,id){
	var sira='';
	$.post('{{ site.adres }}mod_user_group/tasi', { group_id: id, parent_id: parent_id },
			   function(data){
			     if(data=='Oke'){
			    	 $("#menudegis").slideDown('normal');
			    		$(".root li").each(function(){
			    			var rez=$(this).attr("id");	
			    				if(rez!=""){
			    					sira+="&sira[]="+rez;	
			    					}
			    			});

						$.ajax({
							   type: "POST",
							   url: "{{ site.adres }}mod_user_group/sira",
							   data: sira,
							   success: function(msg){
										if(msg=='Oke'){
											
										 	$.achtung({
												className: 'achtungSuccess',
												message: '{{lang.mod_user_group.10}}',
												timeout:5
											});

										}else{

											$.prompt(msg,{
												submit : yenile,
												buttons: { Ok:true }
											});
											
											}
							        
							   }
							 });
			    		

			     }else{
						$.prompt(data,{
							submit : yenile,
							buttons: { Ok:true }
						});
					 }
			   });
}

