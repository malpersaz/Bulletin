{% extends "management/admin-layout.twig" %}
{% block title %}
	{{ lang.mod_user_group.admin.17 }}
{% endblock %}
{% block body %}
	<div class="portlet light">
		<div class="portlet-title">
			<div class="caption">
				<i class="fa fa-gift"></i>
				{{ lang.mod_user_group.17 }}
			</div>
		</div>
		<div class="portlet-body form">
			{% if oke is defined %}
				<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
				<div class="alert alert-success">
					<strong>{{ lang.mod_user_group.general.ok }}</strong>
					{{ mesaj }}
				</div>
				<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
			{% else %}
				{% if hatalar is defined %}
					<!--[if !IE]>Hata Mesajı Varsa<![endif]-->
					{% for hata in hatalar %}
						<div class="alert alert-danger">
							<strong>{{ lang.mod_user_group.general.error }}</strong>
							{{ hata }}
						</div>
					{% endfor %}
					<!--[if !IE]>Hata Mesajı Varsa<![endif]-->
				{% endif %}
				<div class="alert alert-info">
					<strong>{{ lang.mod_user_group.general.info }}</strong>
					{{ lang.mod_user_group.18 }}
				</div>
				<div class="alert alert-info">
					<strong>{{ lang.mod_user_group.general.info }}</strong>
					{{ lang.mod_user_group.19 }}
				</div>
				<a href="{{ site.adres }}mod_user_group/ekle" class="btn green">{{ lang.mod_user_group.20 }}</a>
				<hr>
				{% macro user_group(parent_id, level) %}
					{% for entry in user_groupm[parent_id] %}
						{% set parent_id = entry.group_id %}
						<li id="{{ entry.group_id }}" class="open" name="user_groupden" name="{{ entry.name }}">
							<ins style="display:none">{{ entry.group_id }}</ins>
							<span>{{ '-'|repeat(level) ~ entry.name }}</span>
							<div class="btn-group btn-group-xs btn-group-solid">
								<button data-messageid="23" class="btn blue reply-btn">
									<i class="fa fa-arrow-circle-left"></i>
									{{ lang.mod_user_group.general.action }}
								</button>
								<button class="btn dropdown-toggle" data-toggle="dropdown">
									<i class="fa fa-angle-down"></i>
								</button>
								<ul class="dropdown-menu pull-right">
									<li>
										<a href="javascript:void(0);" onclick="sil('{{ entry.group_id }}');" data-messageid="23" class="btn red">
											<i class="fa fa-trash-o"></i>
											{{ lang.mod_user_group.11 }}
										</a>
									</li>
									<li>
										<a href="javascript:void(0);" class="btn green" onclick="duzenle('{{ entry.group_id }}')">
											<i class="fa fa-edit"></i>
											{{ lang.mod_user_group.12 }}
										</a>
									</li>
								</ul>
							</div>
							{% if user_groupm[parent_id] is defined and user_groupm[parent_id] is iterable %}
								<ul>
									{{ _self.user_group(parent_id, level + 1) }}
								</ul>
							{% endif %}
						</li>
					{% endfor %}
				{% endmacro %}
				<!-- Simple Tree -->
				<div group_id="tree">
					<ul class="simpleTree">
						<li class="root" id='0'>
							<span>{{ lang.mod_user_group.2 }}</span>
							<ul>
								{{ _self.user_group(0, 0) }}
							</ul>
						</li>
					</ul>
				</div>
				<!-- Simple Tree -->
			{% endif %}
		</div>
	</div>
{% endblock %}

{% block extra %}
	{% include 'mod_user_group/script.twig' %}
{% endblock %}
