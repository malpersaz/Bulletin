{% extends "management/admin-layout.twig" %}
{% block title %}{{ lang.mod_document.add }}{% endblock %}
{% macro select_nested_menu_function(select_nested_menu_result, parent_id, level) %}
    {% for entry in select_nested_menu_result[parent_id] %}
        {% set parent_id = entry.id %}
        <option value="{{ entry.id }}">
            {{ '-'|repeat(level) }}{{ entry.name }}
            {% if entry.lang is defined %}({{ entry.lang }}){% endif %}
        </option>
        {% if select_nested_menu_result[parent_id] is defined and select_nested_menu_result[parent_id] is iterable %}
            {{ _self.select_nested_menu_function(select_nested_menu_result, parent_id, level + 1) }}
        {% endif %}
    {% endfor %}
{% endmacro %}
{% block body %}
    {% if error is defined %}
        <div class="alert alert-danger">
            <strong>{{ lang.mod_document.error }}</strong> {{ mesaj }}
        </div>
    {% else %}
        <div class="portlet box green">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-edit"></i>{{ lang.mod_document.add }}
                </div>
            </div>
            <div class="portlet-body form">
                <!--  Mesajlar -->
                {% if oke is defined %}
                    <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
                    <div class="alert alert-success">
                        <strong>{{ lang.mod_document.oke }}</strong> {{ mesaj }}
                        <hr>
                        <a href="{{ site.adres }}mod_document/ekle" class="btn green">{{ lang.mod_document.add }}</a>
                        <a href="{{ site.adres }}mod_document/list" class="btn blue">{{ lang.mod_document.list }}</a>
                    </div>
                    <!--[if !IE]>Oke Mesajı Varsa<![endif]-->
                {% else %}
                    {% if hatalar is defined %}
                        <!--[if !IE]>Hata Mesajı Varsa<![endif]-->
                        {% for hata in hatalar %}
                            <div class="alert alert-danger">
                                <strong>{{ lang.mod_document.hata }}</strong> {{ hata }}
                            </div>
                        {% endfor %}
                        <!--[if !IE]>Hata Mesajı Varsa<![endif]-->
                    {% endif %}
                    <form method="POST"
                          action=""
                          id="add"
                          enctype="multipart/form-data"
                          class="form-horizontal">
                        <div class="form-body">
                            <!-- İnputlar Başlar -->
                            <!--[if !IE]>lang select Başlar<![endif]-->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_document.admin.columns.lang }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge  validate[required]"
                                                name="lang"
                                                id="lang">
                                            {% for item in lang_lang %}
                                                <option value="{{ item.seo }}">
                                                    {{ item.name }}
                                                    {% if item.lang is defined %}({{ item.lang }}){% endif %}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!--[if !IE]>lang select Biter<![endif]-->
                            <!--[if !IE]>name Input Başlar<![endif]-->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_document.admin.columns.name }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge  validate[required,length[2,255]]"
                                               name="name"
                                               value="{{ name }}"
                                               type="text"
                                               id="name">
                                    </div>
                                </div>
                            </div>
                            <!--[if !IE]>name Input Biter<![endif]-->
                            <!--[if !IE]>seo Input Başlar<![endif]-->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_document.admin.columns.seo }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge  validate[required]"
                                               name="seo"
                                               value="{{ seo }}"
                                               type="text"
                                               id="seo">
                                    </div>
                                </div>
                            </div>
                            <!--[if !IE]>seo Input Biter<![endif]-->
                            <!--[if !IE]>status Input Başlar<![endif]-->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_document.admin.columns.published }} :</label>
                                <div class="col-md-4">
                                    <div class="radio-list">
                                        <label class="radio-inline">
                                            {{ lang.mod_document.admin.radio.published_yes }}
                                            <input name="status" value="y" type="radio" checked="checked" />
                                        </label>
                                        <label class="radio-inline">
                                            {{ lang.mod_document.admin.radio.published_no }}
                                            <input name="status" value="n" type="radio" />
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <!--[if !IE]>status Input Biter<![endif]-->
                            <!--[if !IE]>image İmage Başlar<![endif]-->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_document.admin.columns.image }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input name="image" type="file">
                                    </div>
                                </div>
                            </div>
                            <!--[if !IE]>image İmage Biter<![endif]-->
                            <!--[if !IE]>title Input Başlar<![endif]-->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_document.admin.columns.title }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge  validate[required]"
                                               name="title"
                                               value="{{ title }}"
                                               type="text"
                                               id="title">
                                    </div>
                                </div>
                            </div>
                            <!--[if !IE]>title Input Biter<![endif]-->
                            <!--[if !IE]>keywords Input Başlar<![endif]-->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_document.admin.columns.keywords }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge  validate[required]"
                                               name="keywords"
                                               value="{{ keywords }}"
                                               type="text"
                                               id="keywords">
                                    </div>
                                </div>
                            </div>
                            <!--[if !IE]>keywords Input Biter<![endif]-->
                            <!--[if !IE]>description Input Başlar<![endif]-->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_document.admin.columns.description }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge  validate[required]"
                                               name="description"
                                               value="{{ description }}"
                                               type="text"
                                               id="description">
                                    </div>
                                </div>
                            </div>
                            <!--[if !IE]>description Input Biter<![endif]-->
                            <!--[if !IE]>menu Input Başlar<![endif]-->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_document.admin.columns.menu }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge  validate[required]"
                                                name="menu"
                                                id="menu">
                                        <option value="0" selected="selected">{{ lang.mod_document.choose_wish }}</option>
                                        {{ _self.select_nested_menu_function(select_nested_menu_result, 0, 0) }}
                                    </select>
                                </div>
                            </div>
                        </div>
                        <!--[if !IE]>menu Input Biter<![endif]-->
                        <!-- İnputlar Biter -->
                    </div>
                    <!-- form body end -->
                    <div class="form-actions">
                        <div class="row">
                            <div class="col-md-offset-3 col-md-9">
                                <!--[if !IE]>{# lang.mod_document.button.add #} Butonu<![endif]-->
                                <button class="btn green"
                                        name="add"
                                        value="{{ lang.mod_document.button.add }}">
                                    {{ lang.mod_document.button.add }}
                                </button>
                                <a class="btn blue" href="mod_document/list">{{ lang.mod_document.button.vazgec }}</a>
                                <!--[if !IE]>{# lang.mod_document.button.add #} Butonu<![endif]-->
                            </div>
                        </div>
                    </div>
                    <!-- form actions end -->
                </form>
            {% endif %}
        </div>
    </div>
{% endif %}
{% endblock %}
{% block extra %}
    <script>
    $(document).ready(function() {
        $("#add").validationEngine();

        function temizle(veri) {
            var temiz = veri.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, " ");
            temiz = temiz.replace(/^\s+|\s+$/g, "");

            for (i = 0; i <= 15; i ++) {
                temiz = temiz.replace('  ', ' ');
            }
            return temiz;
        }

        // SEO YAPAR
        function make_seo(name, seo) {
            $("#" + name).change(
                    function () {
                        var deger = temizle($("#" + name).val());
                        deger = deger.replace(/\s+/g, "_");
                        deger = deger.replace('İ', 'i');

                        $("#" + seo).val(deger);
                    });
        }

        // Make keywords
        function make_keywords(name, keywords) {
            $("#" + name).change(
                    function () {
                        var deger = temizle($("#" + name).val());
                        deger = deger.replace(/\s+/g, ",");
                        deger = deger.toLowerCase();
                        deger = deger.replace('İ', 'i');

                        $("#" + keywords).val(deger);
                    });
        }

        // Make Title
        function make_title(name, title) {
            $("#" + name).change(
                    function () {
                        var deger = temizle($("#" + name).val());
                        $("#" + title).val(deger);
                    });
        }

        // Make Description
        function make_description(name, description) {
            $("#" + name).change(
                    function () {
                        var deger = temizle($("#" + name).val());
                        $("#" + description).val(deger);
                    });
        }
        // Make Preview
        function make_preview(name) {
            $("#" + name).change(function() {
                $("#" + name + "_preview").html($("#" + name).val());
            });
        }

        var simdi = new Date();
        var yil = simdi.getFullYear();
        var ay = (simdi.getMonth() < 9 ? '0' : '') + (simdi.getMonth() + 1);
        var gun = (simdi.getDate() < 10 ? '0' : '') + simdi.getDate();
        var saat = (simdi.getHours() < 10 ? '0' : '') + simdi.getHours();
        var dakika = (simdi.getMinutes() < 10 ? '0' : '') + simdi.getMinutes();

        var now = yil + "-" + ay + "-" + gun + " " + saat + ":" + dakika;

        make_seo('name','seo');
        make_title('name','title');
        make_keywords('name','keywords');
        make_description('name','description');

    });
    </script>
    <!-- Javascript Başlar -->
    <!-- Javascript Biter -->
{% endblock %}
