<script type="text/javascript">
    function yenile() {
        window.location.reload();
    }
    var simpleTreeCollection;
    $(document).ready(function() {
        simpleTreeCollection = $('.simpleTree').simpleTree({
            autoclose: false,


            afterClick:function(node) {
            },
            afterDblClick:function(node) {
            },
            afterMove:function(destination, source, pos) {
                return tasi(destination.attr('id'), source.attr('id'));
            },
            //	afterAjax:function()
            //	{
            //alert('Loaded');
            //},
            animate:true
            ,docToFolderConvert:true
        });

    });
    function sil(id) {
        $.prompt('{{ lang.mod_page.remove_record }}',
        {
            buttons:[
                {title: '{{ lang.mod_page.button.evet }}',value:true},
                {title: '{{ lang.mod_page.button.hayir }}',value:false}
            ],
            submit: function(v, m, f) {
                if (v === true) {
                    Del(id);
                }
            }
        });
    }

    function Del(id) {

        $.post('{{ site.adres }}mod_page/dragdrop_delete', { sil: id},
                function(data) {
                    //  console.log(data);
                    if (data == 'Oke') {
                        $.achtung({
                            className: 'achtungSuccess',
                            message: '{{ lang.mod_page.oke }}',
                            timeout:5
                        });
                        yenile();
                    } else {
                        $.achtung({
                            className: 'achtungFail',
                            message: data,
                            timeout:5
                        });
                    }
                });
        return false;
    }

    function duzenle(id) {
        window.location = '{{ site.adres }}mod_page/edit/' + id;
        return false;
    }

    {% if session.permissions.mod_page.gallery is defined %}
        function gallery(id){
            window.location = '{{ site.adres }}mod_gallery/list/mod_page/' + id;
            return false;
        }
    {% endif %}

    {% if session.permissions.mod_page.file is defined %}
        function dosya(id){
            window.location = '{{ site.adres }}mod_attachment/list/mod_page/' + id;
            return false;
        }
    {% endif %}

    function tasi(parent_id, id) {

        var sira = new Array();
        $(".root li").each(function() {
            var rez = $(this).attr("id");
            if (rez != "") {
                sira.push(rez);
                //sira += "&sira[]=" + rez;
            }
        });
        $.post('{{ site.adres }}mod_page/tasi', { id:  id, parent_id: parent_id, sira:sira },
                function(data) {
                    if (data == 'Oke') {
                        $.achtung({
                            className: 'achtungSuccess',
                            message: '{{ lang.mod_page.oke }}',
                            timeout:5
                        });
                    } else {
                        $.prompt(data, {
                            submit : yenile,
                            buttons: { Ok:true }
                        });
                    }
                });

    }

</script>
