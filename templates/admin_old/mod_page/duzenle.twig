{% extends "management/admin-layout.twig" %}
{% block title %}
	{{ lang.mod_page.edit }}
{% endblock %}

{% macro select_nested_parent_id_function(parent_id, level, disable) %}
	{% for entry in attribute(select_nested_parent_id_result, parent_id) %}
		{% set parent_id = entry.id %}
		<option value="{{ entry.id }}" {% if entry.id == d.parent_id %} selected="selected" {% endif %} {% if entry.id == d.id or disable == "true" %} disabled="disabled" {% endif %}>
			{{ '-'|repeat(level) }}{{ entry.name }}
		</option>
		{# Eğer Alt Kategorisi Varsa #}
		{% if attribute(select_nested_parent_id_result, parent_id) is not empty and attribute(select_nested_parent_id_result, parent_id) is iterable %}
			{# Eğer Düzenlenen Kayıt İle Alt Kategori ID'si eşitse Disable ET Alt Kategorileri #}
			{% if parent_id == d.id %}
				{{ _self.select_nested_parent_id_function(parent_id, level + 1, "true") }}
			{% else %}
				{# Eğer Disable True İsi Disableye devam et çünkü düzenlenen kaydın 2 3 level parent_id kayıtlarıdır#}
				{% if disable == "true" %}
					{{ _self.select_nested_parent_id_function(parent_id, level + 1, "true") }}
				{% else %}
					{{ _self.select_nested_parent_id_function(parent_id, level + 1, "false") }}
				{% endif %}
			{% endif %}
		{% endif %}
	{% endfor %}
{% endmacro %}

{% macro select_nested_category_id_function(parent_id, level) %}
	{% for entry in attribute(select_nested_category_id_result, parent_id) %}
		{% set parent_id = entry.id %}
		{% if (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#') %}
			<optgroup label="{{ '-'|repeat(level) }}{{ entry.name }}{% if entry.lang is defined %} ({{ entry.lang }}){% endif %}">
			{% else %}
				<option value="{{ entry.id }}" {% if d.category_id == entry.id %} selected="selected" {% endif %}>
					{{ '-'|repeat(level) }}{{ entry.name }}
					{% if entry.lang is defined %}({{ entry.lang }})
					{% endif %}
				</option>
			{% endif %}
			{% if attribute(select_nested_category_id_result, parent_id) is not empty and attribute(select_nested_category_id_result, parent_id) is iterable %}
				{{ _self.select_nested_category_id_function(parent_id, level + 1) }}
			{% endif %}
			{% if (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#') %}
			</optgroup>
		{% endif %}
	{% endfor %}
{% endmacro %}

{% block body %}
	{% if error is defined %}
		<div class="alert alert-danger">
			<strong>{{ lang.mod_page.error }}</strong>
			{{ mesaj }}
		</div>
	{% else %}
		<div class="portlet box green">
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-edit"></i>
					{{ lang.mod_page.edit }}
				</div>
			</div>
			<div
				class="portlet-body form">
				<!--  Mesajlar -->
				{% if oke is defined %}
					<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
					<div class="alert alert-success">
						<strong>{{ lang.mod_page.oke }}</strong>
						{{ mesaj }}
						<hr>
						<a href="{{ site.adres }}mod_page/ekle" class="btn green">{{ lang.mod_page.button.add }}</a>
						<a href="{{ site.adres }}mod_page/edit/{{ d.id }}" class="btn red">{{ lang.mod_page.button.edit }}</a>
						<a href="{{ site.adres }}mod_page/list" class="btn blue">{{ lang.mod_page.list }}</a>
					</div>
					<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
				{% else %}
					{% if hatalar is defined %}
						<!--[if !IE]>Hata Mesajı Varsa<![endif]-->
						{% for hata in hatalar %}
							<div class="alert alert-danger">
								<strong>{{ lang.mod_page.hata }}</strong>
								{{ hata }}
							</div>
						{% endfor %}
						<!--[if !IE]>Hata Mesajı Varsa<![endif]-->
					{% endif %}
					<form method="POST" action="" id="edit" enctype="multipart/form-data" class="form-horizontal">
						<div class="form-body">
							<!-- İnputlar Başlar -->
							<!--[if !IE]>lang Input Başlar<![endif]-->
								<div class="form-group"> <label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.lang }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge  validate[required]" name="lang" id="lang">
											{% for item in lang_lang %}
												<option value="{{ item.seo }}" {% if d.lang == item.seo %} selected="selected" {% endif %}>
													{{ item.name }}
													{% if item.lang is defined %}({{ item.lang }})
													{% endif %}
												</option>
											{% endfor %}
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>lang Input Biter<![endif]-->
							<!--[if !IE]>name Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.name }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required,length[2,255]]" name="name" value="{{ d.name }}" type="text" id="name">
									</div>
								</div>
							</div>
							<!--[if !IE]>name Input Biter<![endif]-->
							<!--[if !IE]>parent_id Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.parent_id }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge  validate[required]" name="parent_id" id="parent_id">
											<option value="0" {% if d.parent_id == '0' %} selected="selected" {% endif %}>{{ lang.mod_page.choose_wish }}</option>
											{{ _self.select_nested_parent_id_function(0, 0, 'false') }}
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>parent_id Input Biter<![endif]-->
							<!--[if !IE]>root Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.root }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge  validate[required]" name="root" id="root">
											<option value="y" {% if d.root == 'y' %} selected="selected" {% endif %}>
												{{ lang.mod_page.admin.select_value.root_e }}
											</option>
											<option value="n" {% if d.root == 'n' %} selected="selected" {% endif %}>
												{{ lang.mod_page.admin.select_value.root_h }}
											</option>
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>root Input Biter<![endif]-->
							<!--[if !IE]>status Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.status }}
									:
								</label>
								<div class="col-md-4">
									<div class="radio-list">
										<label class="radio-inline">
											{{ lang.mod_page.admin.radio.publish_yes }}
											<input name="status" value="y" type="radio" {% if d.status == 'y' %} checked="checked" {% endif %}/>
										</label>
										<label class="radio-inline">
											{{ lang.mod_page.admin.radio.publish_no }}
											<input name="status" value="n" type="radio" {% if d.status == 'n' %} checked="checked" {% endif %}/>
										</label>
									</div>
								</div>
							</div>
							<!--[if !IE]>status Input Biter<![endif]-->
							<!--[if !IE]>deck Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.deck }}
									:
								</label>
								<div class="col-md-4">
									<div class="radio-list">
										<label class="radio-inline">
											{{ lang.mod_page.admin.radio.deck_yes }}
											<input name="deck" value="y" type="radio" {% if d.deck is defined and d.deck == 'y' %} checked="checked" {% endif %}/>
										</label>
										<label class="radio-inline">
											{{ lang.mod_page.admin.radio.deck_no }}
											<input name="deck" value="n" type="radio" {% if d.deck == 'n' %} checked="checked" {% endif %}/>
										</label>
									</div>
								</div>
							</div>
							<!--[if !IE]>deck Input Biter<![endif]-->
							<!--[if !IE]>summary Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.summary }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<textarea class="form-control input-xlarge" name="summary" id="summary">{{ d.summary }}</textarea>
									</div>
								</div>
							</div>
							<!--[if !IE]>summary Input Biter<![endif]-->
							<!--[if !IE]>content Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.content }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<div id="content" class="form-control">{{ d.content|default('')|raw }}</div>
										<input type="hidden" name="content" value="{{ d.content|default('') }}">
									</div>
								</div>
							</div>
							<!--[if !IE]>content Input Biter<![endif]-->
							<!--[if !IE]>gallery_id integer Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.gallery_id }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge " name="gallery_id" value="{{ d.gallery_id }}" type="text" id="gallery_id">
									</div>
								</div>
							</div>
							<!--[if !IE]>gallery_id integer Biter<![endif]-->
							<!--[if !IE]>file_id integer Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.file_id }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge " name="file_id" value="{{ d.file_id }}" type="text" id="file_id">
									</div>
								</div>
							</div>
							<!--[if !IE]>file_id integer Biter<![endif]-->
							<!--[if !IE]>seo Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.seo }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required]" name="seo" value="{{ d.seo }}" type="text" id="seo">
									</div>
								</div>
							</div>
							<!--[if !IE]>seo Input Biter<![endif]-->
							<!--[if !IE]>title Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.title }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required]" name="title" value="{{ d.title }}" type="text" id="title">
									</div>
								</div>
							</div>
							<!--[if !IE]>title Input Biter<![endif]-->
							<!--[if !IE]>keywords Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.keywords }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required]" name="keywords" value="{{ d.keywords }}" type="text" id="keywords">
									</div>
								</div>
							</div>
							<!--[if !IE]>keywords Input Biter<![endif]-->
							<!--[if !IE]>description Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.description }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required]" name="description" value="{{ d.description }}" type="text" id="description">
									</div>
								</div>
							</div>
							<!--[if !IE]>description Input Biter<![endif]-->
							<!--[if !IE]>image İmage Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.image }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										{% if d.image == "" %}
											<input name="image" type="file">
										{% else %}
											<p id="image-{{ d.id }}">
												<img src="static/mod_page/thumb/{{ d.image }}">
												<a href="javascript:void(0)" onclick="image_remove_image('{{ d.id }}');">{{ lang.mod_page.button.kaldir }}</a>
											</p>
										{% endif %}
									</div>
								</div>
							</div>
							<!--[if !IE]>image İmage Biter<![endif]-->
							<!--[if !IE]>acl_id Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.acl_id }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge  validate[required]" name="acl_id" id="acl_id">
											<option value="0" {% if d.acl_id == 0 %} selected="selected" {% endif %}>{{ lang.mod_page.choose_wish }}</option>
											{% for item in mod_acl_acl_id %}
												<option value="{{ item.id }}" {% if d.acl_id == item.id %} selected="selected" {% endif %}>
													{{ item.name }}
													{% if item.lang is defined %}({{ item.lang }})
													{% endif %}
												</option>
											{% endfor %}
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>acl_id Input Biter<![endif]-->
							<!--[if !IE]>category_id Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_page.admin.columns.category_id }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge  validate[required]" name="category_id" id="category_id">
											<option value="0" {% if d.category_id == 0 %} selected="selected" {% endif %}>{{ lang.mod_page.choose_wish }}</option>
											{{ _self.select_nested_category_id_function(0, 0) }}
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>category_id Input Biter<![endif]-->
							<!-- İnputlar Biter -->
						</div>
						<!-- form body end -->
						<div class="form-actions">
							<div class="row">
								<div
									class="col-md-offset-3 col-md-9">
									<!--[if !IE]>{{ lang.mod_page.button.edit }} Butonu<![endif]-->
									<button class="btn green" name="edit" value="{{ lang.mod_page.button.edit }}">
										{{ lang.mod_page.button.edit }}
									</button>
									<a class="btn blue" href="mod_page/list">{{ lang.mod_page.button.vazgec }}</a>
									<!--[if !IE]>{{ lang.mod_page.button.edit }} Butonu<![endif]-->
								</div>
							</div>
						</div>
						<!-- form actions end -->
					</form>
				{% endif %}
			</div>
		</div>
	{% endif %}
{% endblock %}
{% block extra %}
	<script>
		$(document).ready(function () {
$("#edit").validationEngine();


function temizle(veri) {

var temiz = veri.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, " ");
temiz = temiz.replace(/^\s+|\s+$/g, "");

for (i = 0; i <= 15; i ++) {
temiz = temiz.replace('  ', ' ');
}
return temiz;
}

// SEO YAPAR
function make_seo(name, seo) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, "_");
deger = deger.replace('İ', 'i');

$("#" + seo).val(deger);
});
}

// Make keywords
function make_keywords(name, keywords) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, ",");
deger = deger.toLowerCase();
deger = deger.replace('İ', 'i');

$("#" + keywords).val(deger);
});
}

// Make Title
function make_title(name, title) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + title).val(deger);
});
}

// Make Açıklama
function make_aciklama(name, description) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + description).val(deger);
});
}
// Make Preview
function make_preview(name) {
$("#" + name).change(function () {
$("#" + name + "_preview").html($("#" + name).val());
});
}


var simdi = new Date();
var yil = simdi.getFullYear();
var ay = (simdi.getMonth() < 9 ? '0' : '') + (simdi.getMonth() + 1);
var gun = (simdi.getDate() < 10 ? '0' : '') + simdi.getDate();
var saat = (simdi.getHours() < 10 ? '0' : '') + simdi.getHours();
var dakika = (simdi.getMinutes() < 10 ? '0' : '') + simdi.getMinutes();

var now = yil + "-" + ay + "-" + gun + " " + saat + ":" + dakika;

make_seo('name', 'seo');
make_title('name', 'title');
make_keywords('name', 'keywords');
make_aciklama('name', 'description');

});
	</script>
	<!-- TinyMCE -->
	<script type="text/javascript">
		$(document).ready(function () {
rich_editor('#content');
});
	</script>
	<!-- /TinyMCE -->
	<script type="text/javascript">
		function image_remove_image(id) { // Sor Bakalım Kabul Ediyormu ( Confirm)
$.prompt('{{ lang.mod_page.remove_image }}', {
buttons: [
{
title: '{{ lang.mod_page.button.evet }}',
value: true
}, {
title: '{{ lang.mod_page.button.hayir }}',
value: false
}
],
submit: function (v, m, f) { // Eğer Kabul Ederse
if (v === true) {
$.ajax({
type: "POST",
url: "{{ site.adres }}mod_page/image_remove_image",
data: {
id: id
},
success: function (msg) {
if (msg == 'Oke') {
$.achtung({className: 'achtungSuccess', message: '{{ lang.mod_page.remove_image_oke }}', timeout: 5});
$("#image-" + id).html('<input name="image" type="file">');
} else {
$.achtung({className: 'achtungFail', message: msg, timeout: 5});
}
}
});
}
}
});
}
	</script>
	<!-- Javascript Biter -->
{% endblock %}
