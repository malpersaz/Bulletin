if ($("#dtarih").val() == "") {
$("#dtarih").val(now);
}

// Auto-populate SEO fields
make_seo('name', 'seo');
make_title('name', 'title');
make_keywords('name', 'keywords');
make_aciklama('name', 'description');

// Video Token Input
{% if d is defined and d.video is defined %}
var video_populate = null;
$.ajax({
url: 'mod_news/all_video_get/           {{ d.video|base64_encode }}',
async: false,
dataType: "json",
success: function (data) {
video_populate = data;
}
});{% endif %}$("#video").tokenInput("{{ site.adres }}mod_news/all_video", {
minChars: 0,
method: "POST",
hintText: "{{ lang.mod_news.tokenizing.hintText }}",
noResultsText: "{{ lang.mod_news.tokenizing.noResultsText }}",
searchingText: "{{ lang.mod_news.tokenizing.searchingText }}",
preventDuplicates: true,{% if d is defined and d.video is defined %}prePopulate : video_populate,{% endif %}classes: {
tokenList: "token-input-list-facebook",
token: "token-input-token-facebook",
tokenDelete: "token-input-delete-token-facebook",
selectedToken: "token-input-selected-token-facebook",
highlightedToken: "token-input-highlighted-token-facebook",
dropdown: "token-input-dropdown-facebook",
dropdownItem: "token-input-dropdown-item-facebook",
dropdownItem2: "token-input-dropdown-item2-facebook",
selectedDropdownItem: "token-input-selected-dropdown-item-facebook",
inputToken: "token-input-input-token-facebook"
}
});

// Rich Editor (if needed for hidden content field, or if user adds it back)
rich_editor('#content');
});
	</script>
{% endblock %}
