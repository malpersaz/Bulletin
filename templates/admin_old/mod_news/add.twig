{% extends "management/admin-layout.twig" %}
{% block title %}
	{{ lang.mod_news.add }}
{% endblock %}

{% macro select_nested_category_id_function(parent_id, level) %}
	{% for entry in attribute(select_nested_category_id_result, parent_id) %}
		{% set parent_id = entry.id %}
		{% if (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#') %}
			<optgroup label="{{ '-'|repeat(level) ~ entry.name }}{% if entry.lang is defined %} ({{ entry.lang }}){% endif %}">
			{% else %}
				<option value="{{ entry.id }}">
					{{ '-'|repeat(level) ~ entry.name }}
					{% if entry.lang is defined %}({{ entry.lang }})
					{% endif %}
				</option>
			{% endif %}
			{% if attribute(select_nested_category_id_result, parent_id) is not empty and attribute(select_nested_category_id_result, parent_id) is iterable %}
				{{ _self.select_nested_category_id_function(parent_id, level + 1) }}
			{% endif %}
			{% if (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#') %}
			</optgroup>
		{% endif %}
	{% endfor %}
{% endmacro %}

{% macro select_nested_menu_function(parent_id, level) %}
	{% for entry in attribute(select_nested_menu_result, parent_id) %}
		{% set parent_id = entry.id %}
		<option value="{{ entry.id }}">
			{{ '-'|repeat(level) ~ entry.name }}
			{% if entry.lang is defined %}({{ entry.lang }})
			{% endif %}
		</option>
		{% if attribute(select_nested_menu_result, parent_id) is not empty and attribute(select_nested_menu_result, parent_id) is iterable %}
			{{ _self.select_nested_menu_function(parent_id, level + 1) }}
		{% endif %}
	{% endfor %}
{% endmacro %}

{% block body %}
	{% if error is defined %}
		<div class="alert alert-danger">
			<strong>{{ lang.mod_news.error }}</strong>
			{{ mesaj }}
		</div>
	{% else %}
		<div class="portlet box green">
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-edit"></i>
					{{ lang.mod_news.add }}
				</div>
			</div>
			<div
				class="portlet-body form">
				<!--  Mesajlar -->
				{% if oke is defined %}
					<div class="alert alert-success">
						<strong>{{ lang.mod_news.oke }}</strong>
						{{ mesaj }}
						<hr>
						<a href="{{ site.adres }}mod_news/add" class="btn green">{{ lang.mod_news.add }}</a>
						    <a href="{{ site.sadres }}mod_news/list">
        {{ lang.mod_news.list }}</a>
					</div>
				{% else %}
					{% if hatalar is defined %}
						{% for hata in hatalar %}
							<div class="alert alert-danger">
								<strong>{{ lang.mod_news.hata }}</strong>
								{{ hata }}
							</div>
						{% endfor %}
					{% endif %}
					<form method="POST" action="" id="add" enctype="multipart/form-data" class="form-horizontal">
						<div
							class="form-body">
							<!-- Wizard Steps -->
							<div
								id="wizard-steps">

								<!-- Step 1: Language -->
								<div class="wizard-step" id="step-1">
									<h4 class="form-section">1/8
										{{ lang.mod_news.admin.columns.lang }}</h4>
									<div class="form-group">
										<label class="col-md-3 control-label">{{ lang.mod_news.admin.columns.lang }}
											:</label>
										<div class="col-md-4">
											<select class="form-control input-xlarge validate[required]" name="lang" id="lang">
												{% for item in lang_lang %}
													<option value="{{ item.seo }}">
														{{ item.name }}
														{% if item.lang is defined %}({{ item.lang }})
														{% endif %}
													</option>
												{% endfor %}
											</select>
										</div>
									</div>
								</div>

								<!-- Step 2: Category -->
								<div class="wizard-step" id="step-2" style="display:none;">
									<h4 class="form-section">2/8
										{{ lang.mod_news.admin.columns.category_id }}</h4>
									<div class="form-group">
										<label class="col-md-3 control-label">{{ lang.mod_news.admin.columns.category_id }}
											:</label>
										<div class="col-md-4">
											<select class="form-control input-xlarge validate[required]" name="category_id" id="category_id">
												<option value="0" selected="selected">{{ lang.mod_news.choose_wish }}</option>
												{{ _self.select_nested_category_id_function(0, 0) }}
											</select>
										</div>
									</div>
								</div>

								<!-- Step 3: Title -->
								<div class="wizard-step" id="step-3" style="display:none;">
									<h4 class="form-section">3/8
										{{ lang.mod_news.admin.columns.name }}</h4>
									<div class="form-group">
										<label class="col-md-3 control-label">{{ lang.mod_news.admin.columns.name }}
											:</label>
										<div class="col-md-4">
											<input class="form-control input-xlarge validate[required,minSize[2],maxSize[40]]" name="name" value="{% if name is defined %}{{ name }}{% endif %}" type="text" id="name">
											<span class="help-block" id="name-help-block">{{ lang.mod_news.validator.title_length }}</span>
										</div>
									</div>
								</div>

								<!-- Step 4: Publish Date -->
								<div class="wizard-step" id="step-4" style="display:none;">
									<h4 class="form-section">4/8
										{{ lang.mod_news.admin.columns.created_at }}</h4>
									<div class="form-group">
										<label class="col-md-3 control-label">{{ lang.mod_news.admin.columns.created_at }}
											:</label>
										<div class="col-md-4">
											<input class="form-control input-xlarge validate[required]" name="created_at" value="{% if created_at is defined %}{{ created_at }}{% endif %}" type="text" id="created_at">
										</div>
									</div>
									<!-- Hidden Edit Date -->
									<div style="display:none;">
										<input class="form-control" name="dtarih" value="{{ dtarih }}" type="text" id="dtarih">
									</div>
								</div>


								<!-- Step 5: Introduction -->
								<div class="wizard-step" id="step-5" style="display:none;">
									<h4 class="form-section">5/8
										{{ lang.mod_news.admin.columns.summary }}</h4>
									<div class="form-group">
										<label class="col-md-3 control-label">{{ lang.mod_news.admin.columns.summary }}
											:</label>
										<div class="col-md-4">
											<textarea class="form-control input-xlarge validate[required,minSize[110],maxSize[280]]" name="summary" id="summary" rows="4" maxlength="280">{{ summary|raw }}</textarea>

											<span class="help-block">110 - 280 karakter arası</span>
											<span id="summary-counter" class="help-block" style="font-weight: bold;"></span>
										</div>
									</div>
									<input
									type="hidden" name="deck" value="n">

									<!-- Hidden SEO Fields (Auto-generated) -->
									<input type="hidden" name="seo" id="seo" value="{{ seo }}">
									<input type="hidden" name="title" id="title" value="{{ title }}">
									<input type="hidden" name="keywords" id="keywords" value="{{ keywords }}">
									<input type="hidden" name="description" id="description" value="{{ description }}">
								</div>

								<!-- Step 6: Content -->
								<div class="wizard-step" id="step-6" style="display:none;">
									<h4 class="form-section">6/8
										{{ lang.mod_news.admin.columns.content }}</h4>
									<div class="form-group">
										<label class="col-md-3 control-label">{{ lang.mod_news.admin.columns.content }}
											:</label>
										<div class="col-md-9">
											<div id="content" class="form-control" style="height: 300px;">{{ content|default('')|raw }}</div>
											<input type="hidden" name="content" value="{{ content|default('')|raw }}">
										</div>
									</div>
								</div>

								<input type="hidden" name="gallery_id" value="0">

								<input
								type="hidden" name="file_id" value="0">

								<!-- Step 7: Upload Image -->
								<div class="wizard-step" id="step-7" style="display:none;">
									<h4 class="form-section">7/8
										{{ lang.mod_news.admin.columns.image }}</h4>
									<div class="form-group">
										<label class="col-md-3 control-label">{{ lang.mod_news.admin.columns.image }}
											:</label>
										<div class="col-md-4">
											<input name="image" type="file">
										</div>
									</div>
								</div>

								<!-- Step 8: Publish Status -->
								<div class="wizard-step" id="step-8" style="display:none;">
									<h4 class="form-section">8/8
										{{ lang.mod_news.admin.columns.status }}</h4>
									<div class="form-group">
										<div class="col-md-4">
											<div class="radio-list">
												<label class="radio-inline">
													{{ lang.mod_news.admin.radio.publish_yes }}
													<input name="status" value="y" type="radio" checked="checked"/>
												</label>
												<label class="radio-inline">
													{{ lang.mod_news.admin.radio.publish_no }}
													<input name="status" value="n" type="radio"/>
												</label>
											</div>
										</div>
									</div>
								</div>

								<input type="hidden" name="acl_id" value="0">

								<input type="hidden" name="menu" value="0">

								<input type="hidden" name="video" value="{{ video }}">

							</div>

							<!-- Navigation Buttons -->
							<div class="form-actions">
								<div class="row">
									<div
										class="col-md-12">
										<!-- Left Side: Cancel -->
										<div class="pull-left">
											<a class="btn red" href="mod_news/list">{{ lang.mod_news.button.vazgec }}</a>
										</div>
										<!-- Right Side: Previous, Next -->
										<div class="pull-right">
											<button type="button" class="btn default" id="btn-prev" style="display:none;">{{ lang.mod_news.button.prev }}</button>
											<button type="button" class="btn blue" id="btn-next">{{ lang.mod_news.button.next }}</button>
											<!-- Hidden Submit Button to trigger form submission -->
											<button type="submit" class="btn green" id="btn-submit" name="add" value="{{ lang.mod_news.button.send }}" style="display:none;">{{ lang.mod_news.button.send }}</button>
										</div>
									</div>
								</div>
							</div>
						</div>
					</form>
				{% endif %}
			</div>
		</div>
	{% endif %}
{% endblock %}

{% block extra %}
	<script>
		$(document).ready(function () { // Initialize Validation Engine with support for hidden fields (Select2 hides original select)
$("#add").validationEngine({validateNonVisibleFields: true, updatePromptsPosition: true, promptPosition: "bottomLeft"});

// Trigger validation on Select2 change
$('select').on("change", function () {
$(this).validationEngine('validate');
});

// Wizard Logic
var currentStep = 1;
var totalSteps = 8;

function showStep(step) {
$(".wizard-step").hide();
$("#step-" + step).show();

if (step === 1) {
$("#btn-prev").hide();
} else {
$("#btn-prev").show();
}

if (step === totalSteps) {
$("#btn-next").hide();
$("#btn-submit").show();
} else {
$("#btn-next").show();
$("#btn-submit").hide();
}

// Explicit check for Step 3 (Title)
if (step === 3) {
// We do not disable the button here anymore.
// Validation will happen on click.
$("#btn-next").prop('disabled', false);
} else {
$("#btn-next").prop('disabled', false);
}
}

$("#btn-next").click(function () { // Validate only visible fields in the current step
var valid = true;
// Find inputs in current step
$('#step-' + currentStep).find('input, select, textarea').each(function () { // validationEngine('validate') returns TRUE if there is an error, FALSE if valid.
if ($(this).validationEngine('validate')) {
valid = false;
}
});

// Extra check for Step 3
if (currentStep === 3) {
var titleVal = $("#name").val();
// Check for empty or short title
if ($.trim(titleVal) === "" || titleVal.length < 2) {
valid = false;
// Explicitly update the help block to show the error in red
$("#name-help-block").html('<span style="color:red;">    {{ lang.mod_news.validator.title_length }}</span>');
// Force validation prompt
$("#name").validationEngine('showPrompt', '{{ lang.mod_news.validator.title_length }}', 'error');
}
// Also check if uniqueness error is displayed
if ($("#name-help-block span").css("color") === "rgb(255, 0, 0)" || $("#name-help-block span").css("color") === "red") {
valid = false;
$("#name").validationEngine('showPrompt', '{{ lang.mod_news.validator.title_exists }}', 'error');
}
}

// Extra check for Step 5 (Introduction/Deck)
if (currentStep === 5) {
var girisVal = $("#summary").val();
var girisLen = $.trim(girisVal).length;

if (girisLen < 110 || girisLen > 280) {
valid = false;
// Show error prompt
$("#summary").validationEngine('showPrompt', '{{ lang.mod_news.validator.deck_length }}', 'error');
// Ensure button stays red (bootstrap 'red' class or similar visual cue if needed,
// but preventing navigation is the key requirement)
// The user asked for the button to "remain red".
// Assuming the button might change color on valid, but here we just stop it.
}
}

if (valid) {
if (currentStep < totalSteps) {
currentStep++;
showStep(currentStep);
}
}
});

// Real-time validation for Step 5
$("#summary").on('input propertychange paste', function () {
var val = $(this).val();
var len = $.trim(val).length;
var btnNext = $("#btn-next");

if (len >= 110 && len <= 280) { // Valid
btnNext.removeClass('red').addClass('green');
$(this).validationEngine('hide');
} else { // Invalid
btnNext.removeClass('green').addClass('red');
}

// Update Counter
var left = 280 - len;
$("#summary-counter").text("Typed: " + len + " | Left: " + left);
});

// Initial counter update
var initialLen = $.trim($("#summary").val()).length;
$("#summary-counter").text("Typed: " + initialLen + " | Left: " + (
280 - initialLen
));

$("#btn-prev").click(function () {
if (currentStep > 1) {
currentStep--;
showStep(currentStep);
}
});

// Initial state
showStep(currentStep);


// Helper Functions
function temizle(veri) {
var temiz = veri.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, " ");
temiz = temiz.replace(/^\s+|\s+$/g, "");
for (i = 0; i <= 15; i ++) {
temiz = temiz.replace('  ', ' ');
}
return temiz;
}

function make_seo(name, seo) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, "_");
deger = deger.replace('İ', 'i');
$("#" + seo).val(deger);
});
}

function make_keywords(name, keywords) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, ",");
deger = deger.toLowerCase();
deger = deger.replace('İ', 'i');
$("#" + keywords).val(deger);
});
}

function make_title(name, title) {
$("#" + name).on('input propertychange paste', function () {
var deger = temizle($("#" + name).val());
$("#" + title).val(deger);

// Title Uniqueness Check
var titleVal = $(this).val();
var helpBlock = $("#name-help-block");
var nextBtn = $("#btn-next");

if (titleVal.length >= 2) {
$.ajax({
url: '{{ site.sadres }}mod_news/ajax_check_title',
type: 'POST',
data: {
title: titleVal
},
dataType: 'json',
success: function (response) {
if (response.status === 'error') {
helpBlock.html('<span style="color:red;">' + response.message + '</span>');
} else {
helpBlock.html('<span style="color:green;">' + response.message + '</span>');
}
}
});
} else {
helpBlock.html('{{ lang.mod_news.validator.title_length }}');
}
});
}

function make_aciklama(name, description) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + description).val(deger);
});
}

// Date Picker
var simdi = new Date();
var yil = simdi.getFullYear();
var ay = (simdi.getMonth() < 9 ? '0' : '') + (simdi.getMonth() + 1);
var gun = (simdi.getDate() < 10 ? '0' : '') + simdi.getDate();
var saat = (simdi.getHours() < 10 ? '0' : '') + simdi.getHours();
var dakika = (simdi.getMinutes() < 10 ? '0' : '') + simdi.getMinutes();
var now = yil + "-" + ay + "-" + gun + " " + saat + ":" + dakika;

if ($("#created_at").val() == "") {
$("#created_at").val(now);
}

AnyTime.picker("created_at", {
format: "%z-%m-%d %H:%i",
firstDOW: 1,
placement: "popup",
