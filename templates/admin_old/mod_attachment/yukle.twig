{% endblock %}
{% block title %}
	{{ lang.mod_attachment.admin.22|format(d[value]) |e }}
{% endblock %}
{% block body %}
	<div class="portlet box green">
		<div class="portlet-title">
			<div class="caption">
				<a href="javascript:history.go(-1)" class="btn red">
					<i class="fa fa-backward"></i>
					{{ lang.mod_attachment.admin.12 }}
				</a>
			</div>
		</div>
		<div class="portlet-body">
			<div class="alert alert-info">
				<strong>{{ lang.mod_attachment.admin.info }}</strong>
				{{ lang.mod_attachment.admin.3 }}
			</div>
			<div class="alert alert-info">
				<strong>{{ lang.mod_attachment.admin.message }}</strong>
				{{ lang.mod_attachment.admin.2 }}
			</div>
			<div id="uploader" class="dropzone"></div>
		</div>
	</div>
{% endblock %}
