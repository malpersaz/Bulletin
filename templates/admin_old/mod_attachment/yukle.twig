{% extends "management/admin-layout.twig" %}
{% block extra %}
	<script>
		// Method 1: Using Dropzone.options (requires camelCase ID)
Dropzone.options.uploader = {
url: "{{ site.sadres }}mod_attachment/up",
paramName: "file",
params: {
'vid': '{{ vid }}',
'isim': 'file',
'sid': '{{ session.sid }}',
'mod_name': '{{ mod_name }}'
},
success: function (file, response) {
var kobmesaj = '<em>' + file.name + '</em> (' + Math.round(file.size / 1024) + ' KB) ';
$.achtung({className: 'achtungSuccess', message: {{ lang.mod_attachment.admin.35|format("'+kobmesaj+'")|raw }}, timeout: 8});
},
error: function (file, errorMessage, xhr) {
console.error('Upload error:', errorMessage);
$.achtung({
className: 'achtungFail',
message: 'Upload failed: ' + errorMessage,
timeout: 10
});
}
};

