{% extends "management/admin-layout.twig" %}
{% block extra %}
	<script type="text/javascript">
		$(document).ready(function () { // Facebox

var currentresim;

// Resim Silici
function sil() {
$.prompt('{{ lang.mod_attachment.admin.18 }}<br />        {{ lang.mod_attachment.admin.17 }}', {
buttons: [
{
title: '{{ lang.mod_attachment.admin.19 }}',
value: true
}, {
title: '{{ lang.mod_attachment.admin.20 }}',
value: false
}
],
submit: function (v, m, f) {
if (v === true) {

$.post("mod_attachment/delete", {
"id": currentresim.data('id'),
"vid": "{{ vid }}",
"mod_name": "{{ mod_name }}"
}, function (data) {
if (data == 'Oke') {

currentresim.fadeOut('slow');

$.achtung({className: 'achtungSuccess', message: '{{ lang.mod_attachment.admin.36 }}', timeout: 5});

} else {
$.achtung({className: 'achtungFail', message: data, timeout: 5});
}
})
}
}
});
}


/*$('.image').live('dblclick',function(){

             $(this).find('a.edit').click();
             });*/

$('a.indir').live('click', function (e) {
location.href = $(this).attr('href');

return false;

});

$('.image a').live('click', function (e) {

currentresim = $(this).closest('.image');
currentresim.data('id', currentresim.attr('id').replace('image-', ''));

e.preventDefault();
});


$('.image a.delete').live('click', function () {
return sil();
});

$('.image a.edit').live('click', function () {

var container = currentresim.find('.text');

if (! currentresim.data('origText')) {
currentresim.data('origText', container.text());
} else {
return false;
}

$('<input type="text">').val(container.text()).appendTo(container.empty());

container.append('<div class="editresim">' + '<a class="saveChanges" href="#">        {{ lang.mod_attachment.admin.21 }}</a> | <a class="discardChanges" href="#">        {{ lang.mod_attachment.admin.20 }}</a>' + '</div>');

});


$('.image a.discardChanges').live('click', function () {
currentresim.find('.text').text(currentresim.data('origText')).end().removeData('origText');
});


$('.image a.saveChanges').live('click', function () {
var text = currentresim.find("input[type=text]").val();
// var orjinal = currentresim.find('.text').text().val();


$.post("mod_attachment/addegis", {
'id': currentresim.data('id'),
'name': text,
"vid": "{{ vid }}",
"mod_name": "{{ mod_name }}"
}, function (data) {
if (data == 'Oke') {
currentresim.removeData('origText').find(".text").text(text);

$.achtung({className: 'achtungSuccess', message: '{{ lang.mod_attachment.admin.39 }}', timeout: 5});

} else {
$.achtung({className: 'achtungFail', message: data, timeout: 5});

currentresim.find('.text').text(currentresim.data('origText')).end().removeData('origText');
}
});


});
});
	</script>
{% endblock %}
{% block title %}
	{{ lang.mod_attachment.admin.37|format(d[value]) |escape }}
{% endblock %}
{% block body %}
	<style>
		ul.pictures {
			margin: 0 auto;
			width: 500px;
			position: relative;
		}

		ul.pictures li {
			background-color: #F9F9F9;
			border: 1px solid #EEEEEE;
			list-style: none;
			margin: 6px;
			padding: 6px 9px;
			position: relative;
			cursor: n-resize;

			text-shadow: 1px 1px 0 white;
			-moz-border-radius: 6px;
			-webkit-border-radius: 6px;
			border-radius: 6px;
		}

		ul.pictures li:hover {
			border-color: #9be0f9; /* CSS3 glow effect: */
			-moz-box-shadow: 0 0 5px #A6E5FD;
			-webkit-box-shadow: 0 0 5px #A6E5FD;
			box-shadow: 0 0 5px #A6E5FD;
		}

		.image .text {
			color: #777777;
			font-size: 1.4em;
		}

		/* The edit and delete buttons */
		.image .actions {
			position: absolute;
			right: 7px;
			top: 6px;
		}

		.image .actions a {
			display: block;
			width: 16px;
			height: 16px;
			overflow: hidden;
			float: left;
			text-indent: -9999px;
			margin: 3px;
		}

		.image .actions a.edit,
		.image .actions a.delete,
		.image .actions a.tamboy,
		.image .actions a.indir {
			background: none;
			text-indent: 0;
			text-align: center;
			font-size: 14px;
		}

		.image input {
			border: 1px solid #CCCCCC;
			color: #666666;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 0.725em;
			padding: 3px 4px;
			width: 300px;
			background-color: #ffffd3;
		}

		.editresim {
			display: inline;
			font-size: 0.6em;
			padding-left: 9px;
		}

		.editresim a {
			font-weight: bold;
		}

		a.discardChanges {
			color: #C00 !important;
		}

		a.saveChanges {
			color: #4DB209 !important;
		}

		.ui-button,
		.ui-dialog-titlebar {
			font-size: 0.72em !important;
		}

		#dialog-confirm {
			display: none;
			font-size: 0.9em;
			padding: 1em 1em 0;
		}

		a.green-button,
		a.green-button:visited {
			color: black;
			display: block;
			font-size: 10px;
			font-weight: bold;
			height: 15px;
			padding: 6px 5px 4px;
			text-align: center;
			width: 60px;
			text-shadow: 1px 1px 1px #DDDDDD;
			background: url('data:image/png;base64,  + ... [truncated]') no-repeat scroll left top transparent;
		}

		a.green-button:hover {
			text-decoration: none;
			background-position: left bottom;
		}

		a,
		a:visited {
			color: #0196e3;
			text-decoration: none;
			outline: none;
		}

		a:hover {
			text-decoration: underline;
		}

		a img {
			border: none;
		}

		#pagination-flickr li {
			border: 0;
			margin: 0;
			padding: 0;
			font-size: 11px;
			list-style: none;
		}

		#pagination-flickr a {
			border: solid 1px #DDDDDD;
			margin-right: 2px;
		}

		#pagination-flickr .previous-off,
		#pagination-flickr .next-off {
			color: #666666;
			display: block;
			float: left;
			font-weight: bold;
			padding: 3px 4px;
		}

		#pagination-flickr .next a,
		#pagination-flickr .previous a {
			font-weight: bold;
			border: solid 1px #FFFFFF;
		}

		#pagination-flickr .active {
			color: #ff0084;
			font-weight: bold;
			display: block;
			float: left;
			padding: 4px 6px;
		}

		#pagination-flickr a:link,
		#pagination-flickr a:visited {
			color: #0063e3;
			display: block;
			float: left;
			padding: 3px 6px;
			text-decoration: none;
		}

		#pagination-flickr a:hover {
			border: solid 1px #666666;
		}
	</style>
	<div class="portlet box green">
		<div class="portlet-title">
			<div class="caption">
				<a href="{{ site.sadres }}{{ mod_name }}/list" class="btn red">
					<i class="fa fa-backward"></i>
					{{ lang.mod_attachment.admin.12 }}</a>
			</div>
		</div>
		<div
			class="portlet-body">
			<!-- Eğer Seçili Kategoride Hiç Resim Yoksa -->
			<form method="POST" action="{{ site.sadres }}mod_attachment/yukle" id="add" class="form-horizontal">
				<div
					class="form-body">
					<!--[if !IE]>Ekle Buton<![endif]-->
					<p>
						<button class="btn green" name="add" value="ekle">
							<span>{{ lang.mod_attachment.admin.38 }}</span>
						</button>
					</p>
					<input type="hidden" name="vid" value="{{ d[key] }}">
					<input type="hidden" name="name" value="{{ d[value] }}">
					<input type="hidden" name="mod_name" value="{{ mod_name }}">
				</form>
				<!-- Eğer Seçili Kategoride Hiç Resim Yoksa -->
				{% if dosyalar is defined %}
					<div class="alert alert-info">
						<strong>{{ lang.mod_attachment.admin.help }}</strong>
						{{ lang.mod_attachment.admin.24 }}
					</div>
					<ul class="pictures">
						{% for dosya in dosyalar %}
							<li id="image-{{ dosya.id }}" class="image">
								<div>
									<p>
										<div class="text">{{ dosya.filename }}</div>
									</p>
								</div>
								<div class="actions">
									<a href="#" class="edit" title="{{ lang.mod_attachment.admin.30 }}">
										<i class="bi bi-pencil"></i>
									</a>
									<a href="#" class="delete" title="{{ lang.mod_attachment.admin.31 }}">
										<i class="bi bi-trash"></i>
									</a>
									<a class="indir" href="{{ site.sadres }}tools/saveFile/{{ mod_name }}/{{ dosya.vid }}/{{ dosya.id }}" title="{{ dosya.filename }}">
										<i class="bi bi-download"></i>
									</a>
								</div>
							</li>
						{% endfor %}
					</ul>
				{% else %}
					<div class="alert alert-danger">
						<strong>{{ lang.mod_attachment.admin.warning }}</strong>
						{{ lang.mod_attachment.admin.27 }}
					</div>
				{% endif %}
			</div>
		</div>
	{% endblock %}
