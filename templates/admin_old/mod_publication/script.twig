processResimYukle: function (id) {
var input = $('#ajax_resim_input');
if (input.length === 0) {
$('body').append('<input type="file" id="ajax_resim_input" name="image" style="display:none;" accept="image/*">');
input = $('#ajax_resim_input');
}

// Unbind previous handlers
input.off('change');

input.on('change', function () {
if (this.files && this.files[0]) {
var file_data = this.files[0];
var form_data = new FormData();
form_data.append('image', file_data);
form_data.append('id', id);

Metronic.blockUI({target: mod_publication_table_ajax.gridAction.getGrid().getTableWrapper(), boxed: true, message: '{{ lang.mod_publication.ui.isleniyor }}'});

$.ajax({
url: '{{ site.sadres }}mod_publication/ajax_resim_upload',
type: 'POST',
data: form_data,
publicationType: false,
cache: false,
processData: false,
dataType: 'json',
success: function (response) {
Metronic.unblockUI(mod_publication_table_ajax.gridAction.getGrid().getTableWrapper());
if (response.status == 'success') {
oke_message(mod_publication_table_ajax.gridAction.getGrid().getTableWrapper(), '{{ lang.mod_publication.oke }}');
mod_publication_table_ajax.gridAction.reloadGrid();
} else {
error_message(mod_publication_table_ajax.gridAction.getGrid().getTableWrapper(), response.message);
}
// Reset input
input.val('');
},
error: function () {
Metronic.unblockUI(mod_publication_table_ajax.gridAction.getGrid().getTableWrapper());
error_message(mod_publication_table_ajax.gridAction.getGrid().getTableWrapper(), 'Upload failed');
input.val('');
}
});
}
});

input.click();
