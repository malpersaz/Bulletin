<!-- TOP APP BAR -->
<header class="top-app-bar top-app-bar-default">
    <button class="icon-btn" onclick="toggleDrawer()"><i class="bi bi-list" style="font-size:24px;"></i></button>
    <div class="headline">{% block headline %}İçerik Listesi{% endblock %}</div>
    <div class="avatar-small">A</div>
</header>

<!-- TOP APP BAR (CONTEXTUAL) -->
<header class="top-app-bar top-app-bar-contextual">
    <button class="icon-btn" onclick="exitSelectionMode()"><i class="bi bi-x-lg"></i></button>
    <div class="headline" id="selectionCount">0 Seçildi</div>
    <button class="icon-btn"><i class="bi bi-trash3"></i></button>
    <button class="icon-btn"><i class="bi bi-three-dots-vertical"></i></button>
</header>

<!-- SEARCH BAR -->
<div style="padding: 0 16px 8px 16px; display: flex; gap: 8px; align-items: center;">
    <div class="search-bar-container" style="flex: 1;">
        <i class="bi bi-search search-icon"></i>
        <input type="text" class="search-input" id="searchInput" placeholder="İçerik ara..." autocomplete="off">
        <button class="icon-btn-small" id="clearSearchBtn" onclick="clearSearch()" style="display: none;">
            <i class="bi bi-x-circle-fill" style="color: var(--md-sys-color-on-surface-variant);"></i>
        </button>
    </div>
    <button class="icon-btn-small" onclick="openSheet()"
        style="background: var(--md-sys-color-surface); border: 1px solid #ddd; width: 48px; height: 48px; border-radius: 12px !important;">
        <i class="bi bi-sliders2"></i>
    </button>
</div>
