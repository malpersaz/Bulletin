
<!-- NEW: Full Language Selection Sheet -->
<div class="overlay" id="lang-sheet-overlay" onclick="closeLangSheet()" style="z-index: 2000;"></div>
<div class="bottom-sheet" id="lang-sheet" style="z-index: 2001; height: 80vh;">
    <div class="sheet-handle-bar"></div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h3 style="margin: 0; font-size: 20px;">Dil Seçimi</h3>
        <button onclick="confirmLangSelection()" class="m3-btn-text" style="font-weight: 700;">Tamam</button>
    </div>

    <div class="lang-sheet-content">
        <div class="lang-search-box">
            <div class="search-bar-container" style="background: #f0f0f0; margin:0; height: 44px;">
                <i class="bi bi-search search-icon" style="font-size: 16px;"></i>
                <input type="text" class="search-input" id="langSearchInput"
                    placeholder="Dil ara (örn: İngilizce, JP)..." oninput="filterLanguages()">
            </div>
        </div>

        <div class="lang-list-container" id="langListContainer">
            <!-- Dynamic List Generated by JS -->
        </div>
    </div>
</div>

<!-- NEW: Context Menu Sheet for Card Actions -->
<div class="overlay" id="context-menu-overlay" onclick="closeContextMenu()"></div>
<div class="bottom-sheet" id="context-menu-sheet">
    <div class="sheet-handle-bar"></div>
    <div class="sheet-header-simple">
        <h3 id="contextMenuTitle"
            style="margin: 0; font-size: 18px; color: var(--md-sys-color-on-surface); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
            İçerik İşlemleri</h3>
    </div>

    <div class="nav-drawer-content" style="padding-top: 8px;">
        <div class="nav-item" onclick="handleContextAction('edit')">
            <i class="bi bi-pencil-square nav-item-icon"></i>
            <span class="nav-item-label">Düzenle</span>
        </div>
        <div class="nav-divider"></div>
        <div class="nav-item" onclick="handleContextAction('gallery')">
            <i class="bi bi-images nav-item-icon"></i>
            <span class="nav-item-label">Galeri İşlemleri</span>
            <span class="badge-small">3</span>
        </div>
        <div class="nav-item" onclick="handleContextAction('files')">
            <i class="bi bi-paperclip nav-item-icon"></i>
            <span class="nav-item-label">Dosya İşlemleri</span>
        </div>
        <div class="nav-divider"></div>
        <!-- Dynamic Status Action (filled by JS) -->
        <div class="nav-item" id="contextActionStatus" onclick="handleContextAction('status')">
            <i class="bi bi-arrow-repeat nav-item-icon"></i>
            <span class="nav-item-label">Durum Değiştir</span>
        </div>
        <div class="nav-item text-danger" onclick="handleContextAction('delete')">
            <i class="bi bi-trash3 nav-item-icon" style="color: var(--md-sys-color-error);"></i>
            <span class="nav-item-label" style="color: var(--md-sys-color-error);">Sil</span>
        </div>
    </div>
</div>

<!-- Category Sheet for Wizard (Shared) -->
<div class="overlay" id="wizard-cat-overlay" onclick="toggleWizardCategorySheet()"></div>
<div class="bottom-sheet" id="wizard-cat-sheet">
    <div class="sheet-handle-bar"></div>
    <h3 style="margin: 0 0 16px 0;">Kategori Seç</h3>
    <div class="nav-drawer-content" style="max-height: 400px; overflow-y: auto;">
        <div class="nav-item" onclick="selectWizardCategory('Gündem', 1)">
            <i class="bi bi-hash nav-item-icon"></i> <span class="nav-item-label">Gündem</span>
        </div>
        <div class="nav-item" onclick="selectWizardCategory('Dünya', 2)">
            <i class="bi bi-globe nav-item-icon"></i> <span class="nav-item-label">Dünya</span>
        </div>
        <div class="nav-item" onclick="selectWizardCategory('Spor', 3)">
            <i class="bi bi-bicycle nav-item-icon"></i> <span class="nav-item-label">Spor</span>
        </div>
        <div class="nav-item" onclick="selectWizardCategory('Teknoloji', 4)">
            <i class="bi bi-cpu nav-item-icon"></i> <span class="nav-item-label">Teknoloji</span>
        </div>
        <div class="nav-item" onclick="selectWizardCategory('Kültür Sanat', 5)">
            <i class="bi bi-palette nav-item-icon"></i> <span class="nav-item-label">Kültür Sanat</span>
        </div>
    </div>
</div>
