{% extends 'admin/modern/layout.twig' %}

{% block title %}{{ lang.mod_publication.add|default('Yayın Ekle') }}{% endblock %}

{% block publication %}
    <!-- 
        The Wizard is technically an overlay in the prototype, 
        but for a dedicated "/ekle" route, we can show it immediately 
        or use the page as a wrapper for the wizard.
        To keep "Single Page App" feel, we might want to auto-open 
        the wizard overlay on load.
    -->
    <script>
        document.addEventListener("DOMpublicationLoaded", function () {
            // Auto open wizard if we are on the 'ekle' page
            // But we need the wizard HTML to be present. 
            // It is included in layout.twig block 'wizards' -> 'wizard_publication.twig'
            
            // We need to initialize the wizard with Form behavior.
            const wizardOverlay = document.getElementById('publicationWizard');
            if(wizardOverlay) {
                wizardOverlay.classList.add('active');
                wizardOverlay.style.visibility = 'visible'; // Force show
            }
        });
    </script>
    
    <div style="padding: 24px; text-align: center; color: #666;">
        <div class="spinner-track" style="display:inline-block; margin-bottom:16px;">
            <div class="spinner-fill"></div>
        </div>
        <p>Sihirbaz yükleniyor...</p>
    </div>

{% endblock %}

{% block scripts %}
<!-- Include existing validation engine if needed, or use modern validation -->
<script>
    // Overwrite finishWizard function to submit to the real endpoint
    function finishWizard() {
        // Collect data from inputs
        const formData = new FormData();
        
        // Mapping Wizard Inputs to DB Fields
        formData.append('lang', selectedLangCode); // Need to ensure this var is set in wizard logic
        formData.append('category_id', selectedCategoryId);
        formData.append('name', document.getElementById('wizardTitleInput').value);
        formData.append('created_at', document.getElementById('wizardDateInput').value);
        formData.append('summary', document.getElementById('wizardIntroInput').value);
        formData.append('publication', document.getElementById('wizardpublicationInput').innerHTML);
        
        // Image
        const fileInput = document.getElementById('wizardImgInput');
        if(fileInput.files[0]) {
            formData.append('image', fileInput.files[0]);
        }
        
        // Publish
        formData.append('status', document.getElementById('wizardPublishSwitch').checked ? 'y' : 'n');
        
        // Static/Defaults
        formData.append('ekle', 'Gönder'); // Trigger the PHP isset check
        
        // AJAX Post
        fetch('{{ site.sadres }}mod_publication/add', {
            method: 'POST',
            body: formData
        })
        .then(response => response.text()) // Use text first to debug if it returns HTML error
        .then(data => {
            // Check success (naive check for now, can be improved based on PHP response)
            console.log(data);
             alert('Yayın başarıyla eklendi (Demo response)');
             window.location.href = '{{ site.sadres }}mod_publication/list';
        })
        .catch(err => {
            console.error(err);
            alert('Bir hata oluştu.');
        });
    }
</script>
{% endblock %}
