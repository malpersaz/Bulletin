<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{% block title %}Rojname M3 Admin{% endblock %}</title>

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- CSS Assets -->
    <link rel="stylesheet" href="templates/admin/modern/assets/css/style.css?v={{ constant('VERSION') }}">
    {% block styles %}{% endblock %}
</head>
<body>

    <!-- Simulator Wrapper for Desktop -->
    <div class="mobile-wrapper">

        <!-- SCROLLABLE CONTENT AREA -->
        <div class="app-scroll-frame">
            
            {% include 'admin/modern/partials/header.twig' %}

            <!-- MAIN CONTENT -->
            <main class="main-content" id="mainContent">
                {% block content %}{% endblock %}
            </main>

            <!-- FOOTER/PAGINATION IF NEEDED -->
            {% block footer %}{% endblock %}

        </div> <!-- END SCROLL FRAME -->

        <!-- FIXED ELEMENTS (Outside Scroll Frame) -->
        {% include 'admin/modern/partials/fab.twig' %}
        {% include 'admin/modern/partials/navbar.twig' %}
        
        <!-- SHEETS & DRAWERS -->
        {% include 'admin/modern/partials/sidebar.twig' %}
        {% include 'admin/modern/partials/filter_sheet.twig' %}

        <!-- WIZARDS & MODALS -->
        {% block wizards %}
            {% include 'admin/modern/partials/wizard_content.twig' %}
            {% include 'admin/modern/partials/wizard_video.twig' %}
        {% endblock %}
        
        <!-- OTHER OVERLAYS -->
        {% include 'admin/modern/partials/sheets_extra.twig' %}

    </div>

    <!-- JS Assets -->
    <script src="templates/admin/modern/assets/js/script.js?v={{ constant('VERSION') }}"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
