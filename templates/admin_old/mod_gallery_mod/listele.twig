{% extends "management/admin-layout.twig" %}
{% block title %}
	{{ lang.mod_gallery_mod.list }}
{% endblock %}
{% block body %}
	<!-- Begin: life time stats -->
	<div class="portlet light">
		<div class="portlet-title">
			<div class="caption">
				<i class="fa fa-gift font-green-sharp"></i>
				<span class="caption-subject font-green-sharp bold uppercase">{{ lang.mod_gallery_mod.list }}</span>
				<span class="caption-helper">Record Management</span>
			</div>
			<div class="actions">
				<a href="{{ site.adres }}mod_gallery_mod/add" class="btn green ">
					<i class="fa fa-plus"></i>
					<span class="hidden-480">{{ lang.mod_gallery_mod.button.add }}</span>
				</a>
			</div>
		</div>
		<div class="portlet-body">
			<div class="table-container">
				<div class="table-actions-wrapper">
					<span></span>
					<select class="table-group-action-input form-control input-inline input-xsmall input-sm">
						<option value="">Action...</option>
						{% if session.permissions.mod_gallery_mod.delete is defined %}
							<option value="{{ lang.mod_gallery_mod.button.delete }}">{{ lang.mod_gallery_mod.button.delete }}</option>
						{% endif %}
					</select>
					<button class="btn btn-xs yellow table-group-action-submit">
						<i class="fa fa-check"></i>
						Apply
					</button>
				</div>
				<table class="table table-striped table-bordered table-hover" id="mod_gallery_mod_datatable">
					<thead>
						<tr role="row" class="heading">
							<th width="2%">
								<input type="checkbox" class="group-checkable">
							</th>
							<th width="5%">{{ lang.mod_gallery_mod.admin.columns.id }}&nbsp;</th>
							<th width="20%">{{ lang.mod_gallery_mod.admin.columns.name }}&nbsp;</th>
							<th width="20%">{{ lang.mod_gallery_mod.admin.columns.mod_name }}&nbsp;</th>
							<th width="20%">{{ lang.mod_gallery_mod.admin.columns.mod_key }}&nbsp;</th>
							<th width="20%">{{ lang.mod_gallery_mod.admin.columns.mod_value }}&nbsp;</th>
							<th width="25%">Actions</th>
						</tr>
						<tr role="row" class="filter">
							<td></td>
							<td width="5%">
								<input type="text" class="form-control form-filter input-sm" name="arama[id]">
							</td>
							<td width="20%">
								<input type="text" class="form-control form-filter input-sm" name="arama[name]">
							</td>
							<td width="20%">
								<input type="text" class="form-control form-filter input-sm" name="arama[mod_name]">
							</td>
							<td width="20%">
								<input type="text" class="form-control form-filter input-sm" name="arama[mod_key]">
							</td>
							<td width="20%">
								<input type="text" class="form-control form-filter input-sm" name="arama[mod_value]">
							</td>
							<td>
								<button class="btn yellow filter-submit margin-bottom">
									<i class="fa fa-search"></i>
									Search
								</button>
								<button class="btn red filter-cancel">
									<i class="fa fa-times"></i>
									Reset
								</button>
							</td>
						</tr>
					</thead>
					<tbody></tbody>
				</table>
			</div>
		</div>
	</div>
	<!-- End: life time stats -->
{% endblock %}
{% block extra %}
	{% include mod ~ '/script.twig' %}
	<script>
		mod_gallery_mod_table_ajax.init();
	</script>
{% endblock %}
