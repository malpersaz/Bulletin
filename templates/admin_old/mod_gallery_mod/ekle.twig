{% extends "management/admin-layout.twig" %}
{% block title %}
	{{ lang.mod_gallery_mod.add }}
{% endblock %}
{% block body %}
	{% if error is defined %}
		<div class="alert alert-danger">
			<strong>{{ lang.mod_gallery_mod.error }}</strong>
			{{ mesaj }}
		</div>
	{% else %}
		<div class="portlet box green">
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-edit"></i>
					{{ lang.mod_gallery_mod.add }}
				</div>
			</div>
			<div
				class="portlet-body form">
				<!--  Mesajlar -->
				{% if oke is defined %}
					<div class="alert alert-success">
						<strong>{{ lang.mod_gallery_mod.oke }}</strong>
						{{ mesaj }}
						<hr>
						<a href="{{ site.adres }}mod_gallery_mod/ekle" class="btn green">{{ lang.mod_gallery_mod.add }}</a>
						<a href="{{ site.adres }}mod_gallery_mod/list" class="btn blue">{{ lang.mod_gallery_mod.list }}</a>
					</div>
				{% else %}
					{% if hatalar is defined %}
						{% for hata in hatalar %}
							<div class="alert alert-danger">
								<strong>{{ lang.mod_gallery_mod.hata }}</strong>
								{{ hata }}
							</div>
						{% endfor %}
					{% endif %}
					<form method="POST" action="" id="add" enctype="multipart/form-data" class="form-horizontal">
						<div
							class="form-body">
							<!-- İnputlar Başlar -->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_gallery_mod.admin.columns.name }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required,length[2,255]]" name="name" value="{{ name }}" type="text" id="name">
									</div>
								</div>
							</div>
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_gallery_mod.admin.columns.mod_name }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required,length[2,255]]" name="mod_name" value="{{ mod_name }}" type="text" id="mod_name">
									</div>
								</div>
							</div>
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_gallery_mod.admin.columns.mod_key }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required,length[2,255]]" name="mod_key" value="{{ mod_key }}" type="text" id="mod_key">
									</div>
								</div>
							</div>
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_gallery_mod.admin.columns.mod_value }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required,length[2,255]]" name="mod_value" value="{{ mod_value }}" type="text" id="mod_value">
									</div>
								</div>
							</div>
							<!-- İnputlar Biter -->
						</div>
						<!-- form body end -->
						<div class="form-actions">
							<div class="row">
								<div class="col-md-offset-3 col-md-9">
									<button class="btn green" name="add" value="{{ lang.mod_gallery_mod.button.add }}">
										{{ lang.mod_gallery_mod.button.add }}
									</button>
									<a class="btn blue" href="mod_gallery_mod/list">{{ lang.mod_gallery_mod.button.vazgec }}</a>
								</div>
							</div>
						</div>
						<!-- form actions end -->
					</form>
				{% endif %}
			</div>
		</div>
	{% endif %}
{% endblock %}
{% block extra %}
	<script>
		$(document).ready(function () {
$("#add").validationEngine();

function temizle(veri) {

var temiz = veri.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, " ");
temiz = temiz.replace(/^\s+|\s+$/g, "");

for (i = 0; i <= 15; i ++) {
temiz = temiz.replace('  ', ' ');
}
return temiz;
}

// SEO YAPAR
function make_seo(name, seo) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, "_");
deger = deger.replace('İ', 'i');

$("#" + seo).val(deger);
});
}

// Make keywords
function make_keywords(name, keywords) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, ",");
deger = deger.toLowerCase();
deger = deger.replace('İ', 'i');

$("#" + keywords).val(deger);
});
}

// Make Title
function make_title(name, title) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + title).val(deger);
});
}

// Make Açıklama
function make_aciklama(name, description) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + description).val(deger);
});
}
// Make Preview
function make_preview(name) {
$("#" + name).change(function () {
$("#" + name + "_preview").html($("#" + name).val());
});
}

var simdi = new Date();
var yil = simdi.getFullYear();
var ay = (simdi.getMonth() < 9 ? '0' : '') + (simdi.getMonth() + 1);
var gun = (simdi.getDate() < 10 ? '0' : '') + simdi.getDate();
var saat = (simdi.getHours() < 10 ? '0' : '') + simdi.getHours();
var dakika = (simdi.getMinutes() < 10 ? '0' : '') + simdi.getMinutes();

var now = yil + "-" + ay + "-" + gun + " " + saat + ":" + dakika;


});
	</script>
	<!-- Javascript Başlar -->
	<!-- Javascript Biter -->
{% endblock %}
