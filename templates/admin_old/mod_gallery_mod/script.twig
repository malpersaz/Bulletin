<script>

var mod_gallery_mod_table_ajax = mod_gallery_mod_table_ajax || {};

mod_gallery_mod_table_ajax.grid={};

mod_gallery_mod_table_ajax.akm = {
    {% if session.permissions.mod_gallery_mod.delete is defined %}
    processDelete: function (id) {
        bootbox.dialog({
            message: "{{ lang.mod_gallery_mod.remove_record }}",
            title: "Confirmation",
            buttons: {
                success: {
                    label: "{{ lang.mod_gallery_mod.button.evet }}",
                    className: "green",
                    callback: function() {
                        var deteleString = '';

                        if( typeof id === 'string' ) {
                            deteleString += 'delete[]=' + id;
                        }else{
                            id.forEach(function (entry) {
                                deteleString += '&delete[]=' + entry;
                            });
                        }
                        $.ajax({
                            type: "POST",
                            url: "{{ site.adres }}mod_gallery_mod/sil",
                            data: deteleString,
                            success: function (msg) {
                                if (msg == 'Oke') {
                                    oke_message(mod_gallery_mod_table_ajax.gridAction.getGrid().getTableWrapper(), '{{ lang.mod_gallery_mod.oke }}');
                                    mod_gallery_mod_table_ajax.gridAction.reloadGrid();
                                } else {
                                    error_message(mod_gallery_mod_table_ajax.gridAction.getGrid().getTableWrapper(), msg);
                                }
                            }
                        });
                    }
                },
                danger: {
                    label: "{{ lang.mod_gallery_mod.button.hayir }}",
                    className: "red",
                    callback: function() {
                    }
                }
            }
        });
    },
    {% endif %}


    

    {% if session.permissions.mod_gallery_mod.edit is defined %}
    processEdit: function (id) {
        window.location = '{{ site.adres }}mod_gallery_mod/edit/' + id;
    },
    {% endif %}

    akm:function(){

    }

};
mod_gallery_mod_table_ajax.gridAction = {
    initPickers: function () {
        $('.date-picker').datepicker({
            rtl: Metronic.isRTL(),
            autoclose: true
        });
    },
    setGrid: function (grid) {
        mod_gallery_mod_table_ajax.grid = grid;
    },
    getGrid: function () {
        return mod_gallery_mod_table_ajax.grid
    },
    reloadGrid: function () {
        mod_gallery_mod_table_ajax.gridAction.getGrid().getDataTable().ajax.reload();
    },
    handleRecords: function () {


        var grid = new Datatable();

        mod_gallery_mod_table_ajax.gridAction.setGrid(grid);

        grid.init({
            src: $("#mod_gallery_mod_datatable"),
            onSuccess: function (grid) {
            },
            onError: function (grid) {
            },
            onDataLoad: function (grid) {
            },
            loadingMessage: 'Processing...',
            dataTable: {
                "dom": "<'row'<'col-md-10 col-sm-12'pli><'col-md-2 col-sm-12'<'table-group-actions pull-right'>>r>t<'row'<'col-md-8 col-sm-12'pli>T<'col-md-4 col-sm-12'>>",

                "language": {
                    "aria": {
                        "sortAscending": ": activate to sort column ascending",
                        "sortDescending": ": activate to sort column descending"
                    },
                    "emptyTable": "No records found",
                    "info": "<span class='seperator'>|</span> Showing <b>_START_</b> - <b>_END_</b> of <b>_TOTAL_</b> records",
                    "infoEmpty": "No records available",
                    "infoFiltered": "(filtered from _MAX_ total records)",
                    "lengthMenu": "<span class='seperator'>|</span> Show _MENU_ records",
                    "search": "Search:",
                    "zeroRecords": "No matching records found",
                    "infoPostFix": "",
                    "thousands": ",",
                    "loadingRecords": "Loading...",
                    "processing": "Processing...",
                    "paginate": {
                        "first": "First",
                        "last": "Last",
                        "next": "Next",
                        "previous": "Previous"
                    },
                    "metronicGroupActions": "_TOTAL_ records selected:  ",
                    "metronicAjaxRequestGeneralError": "The request could not be completed. Please check your connection."
                },

                "bStateSave": true,

                "lengthMenu": [
                    [10, 20, 50, 100, 150, -1],
                    [10, 20, 50, 100, 150, "All"]
                ],
                "pageLength": 10,
                "ajax": {
                    "url": "{{ site.adres }}mod_gallery_mod/datatable_json"
                },
                "order": [
                    [1, "desc"]
                ],
                "tableTools": {
                    "sSwfPath": "{{ site.tadres }}/admin/management/assets/global/plugins/datatables/extensions/TableTools/swf/copy_csv_xls_pdf.swf",
                    "aButtons": [{
                        "sExtends": "pdf",
                        "sButtonText": "PDF"
                    }, {
                        "sExtends": "csv",
                        "sButtonText": "CSV"
                    }, {
                        "sExtends": "xls",
                        "sButtonText": "Excel"
                    }, {
                        "sExtends": "print",
                        "sButtonText": "Yazdır",
                        "sInfo": 'Lütfen Yazdırmak İçin "CTRL+P" tuşlarına basınız çıkmak içinde "ESC" tuşuna.',
                        "sMessage": "Developer AKMSoftware"
                    }, {
                        "sExtends": "copy",
                        "sButtonText": "Kopyala"
                    }]
                }
            }
        });

// handle group actionsubmit button click
        grid.getTableWrapper().on('click', '.table-group-action-submit', function (e) {
            e.preventDefault();
            var action = $(".table-group-action-input", grid.getTableWrapper());
            if (action.val() != "" && grid.getSelectedRowsCount() > 0) {
                {% if session.permissions.mod_gallery_mod.delete is defined %}
                if (action.val() == '{{ lang.mod_gallery_mod.button.delete }}') {
                    mod_gallery_mod_table_ajax.akm.processDelete(grid.getSelectedRows());
                }
                {% endif %}
            } else if (action.val() == "") {
                error_message(grid.getTableWrapper(), 'Please select an action');
            } else if (grid.getSelectedRowsCount() === 0) {
                error_message(grid.getTableWrapper(), '{{ lang.mod_gallery_mod.grid.7 }}');
            }
        });
    }
};


mod_gallery_mod_table_ajax.init = function () {
    mod_gallery_mod_table_ajax.gridAction.initPickers();
    mod_gallery_mod_table_ajax.gridAction.handleRecords();
};
</script>
