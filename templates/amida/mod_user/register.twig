{% extends "layouts/base.twig" %}

{% block title %}
	<title>{{ lang.mod_user.register.form_title }} - {{ site.title }}</title>
{% endblock %}

{% block canonical %}
	<link rel="canonical" href="{{ site.saddress }}register"/>
{% endblock %}

{% block head %}
	<meta name="robots" content="noindex">
{% endblock %}

{% block css_custom %}
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/register.css?v={{ site.version|default('1.1.25') }}">
{% endblock %}

{% block content %}
<div class="register-page-wrapper">
	<div class="register-card" id="registerApp"
		 data-check-username-url="{{ site.saddress }}mod_user/checkUsernameAvailability"
		 data-check-email-url="{{ site.saddress }}mod_user/check_email"
		 data-captcha-url="{{ site.saddress }}mod_user/captcha"
		 data-lang="{{ js_lang|e('html_attr') }}">

		{% if success_message %}
			{# --- Super Polished Registration Success State --- #}
			<div class="register-status-wrapper">
				<div class="register-status-icon-badge success-badge">
					<i class="bi bi-shield-check"></i>
				</div>
				<h2 class="register-status-title">{{ lang.mod_user.register.membership_registration }}</h2>
				<div class="register-status-callout callout-success">
					<div class="d-flex align-items-center justify-content-center gap-2 mb-2">
						<i class="bi bi-check-circle-fill text-success fs-5"></i>
						<strong>{{ lang.mod_user.register.registration_success }}</strong>
					</div>
					<div>{{ success_message|raw }}</div>
				</div>
				<div class="register-status-actions">
					<a href="{{ site.saddress }}" class="btn btn-outline-secondary register-status-btn">
						<i class="bi bi-house-door"></i>
						<span>{{ lang.mod_user.register.back_to_home }}</span>
					</a>
					<a href="{{ site.saddress }}login" class="btn btn-primary register-status-btn">
						<i class="bi bi-box-arrow-in-right"></i>
						<span>{{ lang.mod_user.register.login_now }}</span>
					</a>
				</div>
			</div>

		{% elseif error_message %}
			{# --- Super Polished Error State --- #}
			<div class="register-status-wrapper">
				<div class="register-status-icon-badge error-badge">
					<i class="bi bi-exclamation-triangle"></i>
				</div>
				<h2 class="register-status-title">{{ lang.mod_user.error_title }}</h2>
				<div class="register-status-callout callout-error">
					<div>{{ error_message|raw }}</div>
				</div>
				<div class="register-status-actions">
					<a href="{{ site.saddress }}register" class="btn btn-primary register-status-btn">
						<i class="bi bi-arrow-clockwise"></i>
						<span>{{ lang.mod_user.register.register_button }}</span>
					</a>
				</div>
			</div>

		{% else %}
			{# --- Registration Form Card --- #}
			<div class="register-header">
				<div class="register-header-icon">
					<i class="bi bi-person-plus"></i>
				</div>
				<h1 class="register-header-title">{{ lang.mod_user.register.form_title }}</h1>
				<p class="register-header-desc">{{ lang.mod_user.register.fill_form }}</p>
			</div>

			<div class="register-body">
				{% if errors %}
					<div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
						<i class="bi bi-exclamation-octagon-fill fs-5 mt-1 flex-shrink-0"></i>
						<div>
							<div class="fw-bold mb-1">{{ lang.mod_user.register.js.errors_title }}</div>
							<ul class="mb-0 ps-3">
								{% for err in errors %}
									<li>{{ err }}</li>
								{% endfor %}
							</ul>
						</div>
					</div>
				{% endif %}

				<form method="post" action="{{ site.saddress }}register" id="registerForm" novalidate>
					{# Name & Last Name #}
					<div class="row g-3 mb-3">
						<div class="col-sm-6">
							<label class="register-form-label" for="name">{{ lang.mod_user.register.your_name }}</label>
							<div class="input-group register-input-group">
								<span class="input-group-text"><i class="bi bi-person"></i></span>
								<input type="text" class="form-control" id="name" name="name"
									   value="{{ name|default(ctx_get('name')) }}" required minlength="2" maxlength="30"
									   placeholder="{{ lang.mod_user.register.your_name }}" autocomplete="given-name">
							</div>
							<div class="invalid-feedback"></div>
						</div>

						<div class="col-sm-6">
							<label class="register-form-label" for="last_name">{{ lang.mod_user.register.your_surname }}</label>
							<div class="input-group register-input-group">
								<span class="input-group-text"><i class="bi bi-person-badge"></i></span>
								<input type="text" class="form-control" id="last_name" name="last_name"
									   value="{{ last_name|default(ctx_get('last_name')) }}" required minlength="2" maxlength="30"
									   placeholder="{{ lang.mod_user.register.your_surname }}" autocomplete="family-name">
							</div>
							<div class="invalid-feedback"></div>
						</div>
					</div>

					{# Username #}
					<div class="mb-3">
						<label class="register-form-label" for="username">{{ lang.mod_user.register.your_username }}</label>
						<div class="input-group register-input-group">
							<span class="input-group-text"><i class="bi bi-at"></i></span>
							<input type="text" class="form-control" id="username" name="username"
								   value="{{ username|default(ctx_get('username')) }}" required minlength="2" maxlength="12"
								   placeholder="{{ lang.mod_user.register.your_username }}" autocomplete="username">
						</div>
						<div class="register-feedback-text" id="usernameFeedback"></div>
						<div class="invalid-feedback"></div>
					</div>

					{# Email #}
					<div class="mb-3">
						<label class="register-form-label" for="email">{{ lang.mod_user.register.email }}</label>
						<div class="input-group register-input-group">
							<span class="input-group-text"><i class="bi bi-envelope"></i></span>
							<input type="email" class="form-control" id="email" name="email"
								   value="{{ email|default(ctx_get('email')) }}" required minlength="6" maxlength="60"
								   placeholder="{{ lang.mod_user.register.email }}" autocomplete="email">
						</div>
						<div class="register-feedback-text" id="emailFeedback"></div>
						<div class="invalid-feedback"></div>
					</div>

					{# Password & Confirm Password #}
					<div class="row g-3 mb-3">
						<div class="col-md-6">
							<label class="register-form-label" for="password">{{ lang.mod_user.register.your_password }}</label>
							<div class="input-group register-input-group">
								<span class="input-group-text"><i class="bi bi-lock"></i></span>
								<input type="password" class="form-control" id="password" name="password"
									   required minlength="8" maxlength="64"
									   placeholder="{{ lang.mod_user.register.your_password }}" autocomplete="new-password">
								<button type="button" class="input-group-text register-toggle-password" data-target="password" aria-label="Toggle password visibility">
									<i class="bi bi-eye"></i>
								</button>
							</div>
							<div class="invalid-feedback"></div>

							{# Interactive Password Strength Box #}
							<div class="password-meter-box d-none" id="passwordStrengthBox">
								<div class="d-flex justify-content-between align-items-center mb-1">
									<span class="small fw-semibold text-muted">{{ lang.mod_user.register.strength_label }}</span>
									<span id="passwordStrengthText" class="small fw-bold"></span>
								</div>
								<div class="password-meter-progress">
									<div class="password-meter-bar" id="passwordStrengthBar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
								</div>
								<div class="password-criteria-grid">
									<div class="password-criteria-item" data-rule="length">
										<i class="bi bi-circle criteria-icon"></i>
										<span>{{ lang.mod_user.register.rule_min_length }}</span>
									</div>
									<div class="password-criteria-item" data-rule="uppercase">
										<i class="bi bi-circle criteria-icon"></i>
										<span>{{ lang.mod_user.register.rule_uppercase }}</span>
									</div>
									<div class="password-criteria-item" data-rule="lowercase">
										<i class="bi bi-circle criteria-icon"></i>
										<span>{{ lang.mod_user.register.rule_lowercase }}</span>
									</div>
									<div class="password-criteria-item" data-rule="number">
										<i class="bi bi-circle criteria-icon"></i>
										<span>{{ lang.mod_user.register.rule_number }}</span>
									</div>
									<div class="password-criteria-item" data-rule="special">
										<i class="bi bi-circle criteria-icon"></i>
										<span>{{ lang.mod_user.register.rule_special }}</span>
									</div>
								</div>
							</div>
						</div>

						<div class="col-md-6">
							<label class="register-form-label" for="password2">{{ lang.mod_user.register.confirm_password }}</label>
							<div class="input-group register-input-group">
								<span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
								<input type="password" class="form-control" id="password2" name="password2"
									   required minlength="8" maxlength="64"
									   placeholder="{{ lang.mod_user.register.confirm_password }}" autocomplete="new-password">
								<button type="button" class="input-group-text register-toggle-password" data-target="password2" aria-label="Toggle confirm password visibility">
									<i class="bi bi-eye"></i>
								</button>
							</div>
							<div class="invalid-feedback"></div>

							{# Password Match Indicator #}
							<div class="password-match-indicator d-none" id="passwordMatchIndicator">
								<i id="passwordMatchIcon" class="bi"></i>
								<span id="passwordMatchText" class="fw-semibold"></span>
							</div>
						</div>
					</div>

					{# Phone Number with Country Select #}
					<div class="mb-3">
						<label class="register-form-label" for="phone">{{ lang.mod_user.register.your_phone }}</label>
						<div class="input-group register-input-group">
							<select class="form-select register-country-select" id="country_code" name="country_code">
								<option value="">{{ lang.mod_user.register.country_codes.select }}</option>
								{% for code in country_codes %}
									<option value="{{ code.code }}" {% if country_code == code.code or (country_code is empty and code.code == '+90') %}selected{% endif %}>
										{{ code.country }} ({{ code.code }})
									</option>
								{% endfor %}
							</select>
							<span class="input-group-text"><i class="bi bi-telephone"></i></span>
							<input type="tel" class="form-control" id="phone" name="phone"
								   value="{{ phone|default(ctx_get('phone')) }}" required maxlength="15"
								   placeholder="555 123 4567" autocomplete="tel">
						</div>
						<div class="invalid-feedback"></div>
					</div>

					{# Security Captcha #}
					<div class="mb-4">
						<label class="register-form-label" for="captcha">{{ lang.mod_user.register.security_code }}</label>
						<div class="register-captcha-wrap">
							<input type="text" class="form-control register-captcha-input" id="captcha" name="captcha"
								   required minlength="5" maxlength="5"
								   placeholder="•••••" autocomplete="off">
							<div class="register-captcha-display">
								<img id="registerCaptchaImg" src="{{ site.saddress }}mod_user/captcha"
									 alt="{{ lang.mod_user.register.security_code }}" class="register-captcha-img"
									 title="{{ lang.mod_user.register.captcha_refresh }}">
								<button type="button" class="register-captcha-reload" id="reloadCaptchaBtn"
										title="{{ lang.mod_user.register.captcha_refresh }}" aria-label="{{ lang.mod_user.register.captcha_refresh }}">
									<i class="bi bi-arrow-clockwise fs-5"></i>
								</button>
							</div>
						</div>
						<div class="form-text text-muted small mt-1">{{ lang.mod_user.register.captcha_refresh }}</div>
						<div class="invalid-feedback"></div>
					</div>

					{# Submit Button #}
					<div class="d-grid mt-4">
						<input type="hidden" name="register" value="1">
						<button type="submit" id="registerSubmitBtn" class="btn btn-register-submit">
							<i class="bi bi-person-check me-2"></i>{{ lang.mod_user.register.register_button }}
						</button>
					</div>
				</form>

				{# Footer / Login Switch #}
				<div class="register-footer">
					<span>{{ lang.mod_user.register.have_account }}</span>
					<a href="{{ site.saddress }}login" class="ms-1">{{ lang.mod_user.register.login_now }}</a>
				</div>
			</div>
		{% endif %}
	</div>
</div>
{% endblock %}

{% block js_custom %}
	<script src="{{ site.taddress }}{{ site.app_template }}/static/js/register.js?v={{ site.version|default('1.1.25') }}" defer></script>
{% endblock %}
