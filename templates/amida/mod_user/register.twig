countryCodeSelect.addEventListener('change', function () {
const countryCode = this.value;
const format = phoneFormats[countryCode];

if (format) {
phoneInput.placeholder = format.placeholder;
phoneInput.maxLength = format.maxLength;

// Auto-focus phone input when country is selected
if (countryCode !== '') {
phoneInput.focus();
}
}
});

// Phone number auto-formatting
phoneInput.addEventListener('input', function (e) {
const countryCode = countryCodeSelect.value;
const format = phoneFormats[countryCode];

if (format) {
let value = e.target.value.replace(/\D/g, '');
// Remove all non-digits

// Limit to max length
if (value.length > format.maxLength) {
value = value.slice(0, format.maxLength);
}

e.target.value = value;
}
});

// Clear validation states when form is reset
document.getElementById('register').addEventListener('reset', function () {
usernameInput.classList.remove('is-valid', 'is-invalid');
emailInput.classList.remove('is-valid', 'is-invalid');
usernameFeedback.innerHTML = '';
emailFeedback.innerHTML = '';

// Reset phone fields
countryCodeSelect.value = '';
phoneInput.placeholder = '555 123 4567';
});
});

// Multilingual browser validation message override
document.addEventListener('DOMContentLoaded', function () {
const form = document.getElementById('register');
if (form) {
const inputs = form.querySelectorAll('input[required]');

inputs.forEach(input => {
input.addEventListener('invalid', function (e) {
e.preventDefault();
e.stopPropagation();

let message = '';

// Use language variables from LANG object
if (input.id === 'name') {
message = LANG.validation_required_name || 'Please enter your name';
} else if (input.id === 'last_name') {
message = LANG.validation_required_surname || 'Please enter your surname';
} else if (input.id === 'username') {
if (input.validity.valueMissing) {
message = LANG.validation_required_username || 'Please enter a username';
} else if (input.validity.tooShort) {
message = LANG.validation_username_short || 'Username must be at least 2 characters';
} else if (input.validity.tooLong) {
message = LANG.validation_username_long || 'Username must not exceed 20 characters';
}
} else if (input.id === 'email') {
if (input.validity.valueMissing) {
message = LANG.validation_required_email || 'Please enter your email address';
} else if (input.validity.typeMismatch) {
message = LANG.validation_invalid_email || 'Please enter a valid email address';
}
} else if (input.id === 'password') {
if (input.validity.valueMissing) {
message = LANG.validation_required_password || 'Please enter a password';
} else if (input.value.trim().length < 8) {
message = LANG.validation_password_short || 'Password must be at least 8 characters';
} else if (input.value.trim().length > 64) {
message = LANG.validation_password_long || 'Password must not exceed 64 characters';
} else if (!/[A-Z]/.test(input.value) || !/[a-z]/.test(input.value) || !/[0-9]/.test(input.value) || !/[^A-Za-z0-9]/.test(input.value)) {
message = LANG.password_complexity_error || 'Password must meet complexity requirements';
}
} else if (input.id === 'password2') {
const passwordField = document.getElementById('password');
if (input.validity.valueMissing) {
message = LANG.validation_confirm_password || 'Please confirm your password';
} else if (input.value.trim() !== passwordField.value.trim()) {
message = LANG.error_6 || 'Passwords do not match';
}
} else if (input.id === 'phone') {
message = LANG.validation_required_phone || 'Please enter your phone number';
} else if (input.id === 'captcha') {
message = LANG.validation_required_captcha || 'Please enter the security code';
}

// Fallback generic message if specific one not found
if (! message) {
message = LANG.validation_required || 'This field is required';
}

// Show custom validation message
input.setCustomValidity(message);
input.classList.add('is-invalid');

// Update the invalid-feedback div
const feedbackDiv = input.parentNode.querySelector('.invalid-feedback');
if (feedbackDiv) {
feedbackDiv.textContent = message;
}
});

// Clear custom validity when user starts typing
input.addEventListener('input', function () {
input.setCustomValidity('');
input.classList.remove('is-invalid');
});
});
}
});

// Custom form validation on submit
document.addEventListener('DOMContentLoaded', function () {
const form = document.getElementById('register');
if (form) {
form.addEventListener('submit', function (e) {
e.preventDefault();
e.stopPropagation();

let isValid = true;
const inputs = form.querySelectorAll('input[required]');

// Clear all previous validation states
inputs.forEach(input => {
input.classList.remove('is-invalid');
const feedbackDiv = input.parentNode.querySelector('.invalid-feedback');
if (feedbackDiv) {
feedbackDiv.textContent = '';
}
});

// Validate each required field
inputs.forEach(input => {
let message = '';
let isFieldValid = true;

if (input.id === 'name') {
if (!input.value.trim()) {
message = LANG.validation_required_name || 'Please enter your name';
isFieldValid = false;
} else if (input.value.trim().length < 2) {
message = 'Name must be at least 2 characters';
isFieldValid = false;
}
} else if (input.id === 'last_name') {
if (!input.value.trim()) {
message = LANG.validation_required_surname || 'Please enter your surname';
isFieldValid = false;
} else if (input.value.trim().length < 2) {
message = 'Surname must be at least 2 characters';
isFieldValid = false;
}
} else if (input.id === 'username') {
if (!input.value.trim()) {
message = LANG.validation_required_username || 'Please enter a username';
isFieldValid = false;
} else if (input.value.trim().length < 2) {
message = LANG.validation_username_short || 'Username must be at least 2 characters';
isFieldValid = false;
} else if (input.value.trim().length > 20) {
message = LANG.validation_username_long || 'Username must not exceed 20 characters';
isFieldValid = false;
}
} else if (input.id === 'email') {
if (!input.value.trim()) {
message = LANG.validation_required_email || 'Please enter your email address';
isFieldValid = false;
} else if (!input.value.trim().match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
message = LANG.validation_invalid_email || 'Please enter a valid email address';
isFieldValid = false;
}
} else if (input.id === 'password') {
if (!input.value.trim()) {
message = LANG.validation_required_password || 'Please enter a password';
isFieldValid = false;
} else if (input.value.trim().length < 8) {
message = LANG.validation_password_short || 'Password must be at least 8 characters';
isFieldValid = false;
} else if (input.value.trim().length > 64) {
message = LANG.validation_password_long || 'Password must not exceed 64 characters';
isFieldValid = false;
} else if (!/[A-Z]/.test(input.value) || !/[a-z]/.test(input.value) || !/[0-9]/.test(input.value) || !/[^A-Za-z0-9]/.test(input.value)) {
message = LANG.password_complexity_error || 'Password must meet complexity requirements';
isFieldValid = false;
}
} else if (input.id === 'password2') {
const passwordField = document.getElementById('password');
if (!input.value.trim()) {
message = LANG.validation_confirm_password || 'Please confirm your password';
isFieldValid = false;
} else if (input.value.trim() !== passwordField.value.trim()) {
message = LANG.error_6 || 'Passwords do not match';
isFieldValid = false;
}
} else if (input.id === 'phone') {
if (!input.value.trim()) {
message = LANG.validation_required_phone || 'Please enter your phone number';
isFieldValid = false;
}
} else if (input.id === 'captcha') {
if (!input.value.trim()) {
message = LANG.validation_required_captcha || 'Please enter the security code';
isFieldValid = false;
}
}

// If no specific message, use generic required message
if (! message && !input.value.trim()) {
message = LANG.validation_required || 'This field is required';
isFieldValid = false;
}

// Show validation error if field is invalid
if (! isFieldValid) {
input.classList.add('is-invalid');
const feedbackDiv = input.parentNode.querySelector('.invalid-feedback');
if (feedbackDiv) {
feedbackDiv.textContent = message;
}
isValid = false;
}
});

// If form is valid, submit it
if (isValid) { // Remove novalidate temporarily to allow normal form submission
form.removeAttribute('novalidate');
form.submit();
} else { // Scroll to first error
const firstInvalid = form.querySelector('.is-invalid');
if (firstInvalid) {
firstInvalid.focus();
firstInvalid.scrollIntoView({behavior: 'smooth', block: 'center'});
}
}
});
	// Toggle Password Visibility
	const toggles = document.querySelectorAll('.toggle-password');
	toggles.forEach(toggle => {
		toggle.addEventListener('click', function() {
			const targetId = this.getAttribute('data-target');
			const targetInput = document.getElementById(targetId);
			const icon = this.querySelector('i');
			if (targetInput && icon) {
				if (targetInput.type === 'password') {
					targetInput.type = 'text';
					icon.classList.remove('bi-eye');
					icon.classList.add('bi-eye-slash');
				} else {
					targetInput.type = 'password';
					icon.classList.remove('bi-eye-slash');
					icon.classList.add('bi-eye');
				}
			}
		});
	});

	// Password strength and criteria check
	const newPassword = document.getElementById('password');
	const confirmPassword = document.getElementById('password2');
	const strengthContainer = document.getElementById('strengthContainer');
	const strengthBar = document.getElementById('strengthBar');
	const strengthText = document.getElementById('strengthText');
	const matchContainer = document.getElementById('matchContainer');
	const matchIcon = document.getElementById('matchIcon');
	const matchText = document.getElementById('matchText');

	const rules = {
		length: val => val.length >= 8,
		uppercase: val => /[A-Z]/.test(val),
		lowercase: val => /[a-z]/.test(val),
		number: val => /[0-9]/.test(val),
		special: val => /[^A-Za-z0-9]/.test(val)
	};

	const criteriaLabels = {
		weak: '{{ lang.mod_user.password_strength.weak }}',
		fair: '{{ lang.mod_user.password_strength.fair }}',
		good: '{{ lang.mod_user.password_strength.good }}',
		strong: '{{ lang.mod_user.password_strength.strong }}'
	};

	if (newPassword) {
		newPassword.addEventListener('input', function() {
			const val = this.value;
			if (val.length > 0) {
				strengthContainer.classList.remove('d-none');
			} else {
				strengthContainer.classList.add('d-none');
			}

			let score = 0;
			Object.keys(rules).forEach(rule => {
				const isValid = rules[rule](val);
				const item = document.querySelector(`.criteria-item[data-rule="${rule}"]`);
				if (item) {
					const icon = item.querySelector('.criteria-icon');
					if (isValid) {
						icon.className = 'bi bi-check-circle-fill text-success criteria-icon';
						score++;
					} else {
						icon.className = 'bi bi-x-circle-fill text-danger criteria-icon';
					}
				}
			});

			// Update strength bar and text
			let pct = (score / 5) * 100;
			strengthBar.style.width = pct + '%';
			if (score <= 2) {
				strengthBar.className = 'progress-bar bg-danger';
				strengthText.textContent = criteriaLabels.weak;
				strengthText.className = 'small fw-bold text-danger';
			} else if (score <= 4) {
				strengthBar.className = 'progress-bar bg-warning';
				strengthText.textContent = criteriaLabels.fair;
				strengthText.className = 'small fw-bold text-warning';
			} else {
				strengthBar.className = 'progress-bar bg-success';
				strengthText.textContent = criteriaLabels.strong;
				strengthText.className = 'small fw-bold text-success';
			}

			checkPasswordsMatch();
		});
	}

	function checkPasswordsMatch() {
		if (!confirmPassword || !newPassword) return;
		const pass1 = newPassword.value;
		const pass2 = confirmPassword.value;

		if (pass2.length > 0) {
			matchContainer.classList.remove('d-none');
			if (pass1 === pass2) {
				matchIcon.className = 'bi bi-check-circle-fill text-success';
				matchText.textContent = '{{ lang.mod_user.password_reset.password_match }}';
				matchText.className = 'fw-semibold text-success';
			} else {
				matchIcon.className = 'bi bi-x-circle-fill text-danger';
				matchText.textContent = '{{ lang.mod_user.password_match.error }}';
				matchText.className = 'fw-semibold text-danger';
			}
		} else {
			matchContainer.classList.add('d-none');
		}
	}

	if (confirmPassword) {
		confirmPassword.addEventListener('input', checkPasswordsMatch);
	}
}
});
	</script>
{% endblock %}

{% block content %}


	{% set oke = ctx_get('oke') %}
	{% set error = ctx_get('error') %}
	{% set mesaj = ctx_get('mesaj') %}
	{% set errors = ctx_get('errors') %}
	{% set name = ctx_get('name') %}
	{% set last_name = ctx_get('last_name') %}
	{% set kullanici_adi = ctx_get('kullanici_adi') %}
	{% set email = ctx_get('email') %}
	{% set sifre = ctx_get('sifre') %}
	{% set sifre2 = ctx_get('sifre2') %}
	{% set telefon = ctx_get('telefon') %}
	{% set tc = ctx_get('tc') %}
	<!-- START: mod_user/kayit.twig -->
	<div class="row justify-content-center">
		<div class="col-md-8 col-lg-6">
			<div class="card mt-4">
				<div class="card-header">
					<h5 class="card-title mb-0">{{ lang.mod_user.register.form_title }}</h5>
				</div>
				<div class="card-body">
					{% if success_message %}
						<div class="alert alert-success" role="alert">
							✅
							{{ success_message }}
						</div>
					{% elseif error_message %}
						<div class="alert alert-danger" role="alert">
							❌
							{{ error_message }}
						</div>
					{% else %}

						{% if errors %}
							<div class="alert alert-danger" role="alert">
								<strong>{{ lang.mod_user.register.js.errors_basligi }}</strong>
								<ul class="mb-0">
									{% for error in errors %}
										<li>{{ error }}</li>
									{% endfor %}
								</ul>
							</div>
						{% endif %}

						<form method="post" action="{{ site.saddress }}register" id="register" novalidate>
							<div class="row">
								<div class="col-md-6 mb-3">
									<label class="form-label" for="name">{{ lang.mod_user.register.your_name }}</label>
									<input type="text" class="form-control" id="name" name="name" value="{{ name }}" required minlength="2" maxlength="20" placeholder="{{ lang.mod_user.register.your_name }}">
									<div class="invalid-feedback">
										Please enter a valid name (2-20 characters).
									</div>
								</div>

								<div class="col-md-6 mb-3">
									<label class="form-label" for="last_name">{{ lang.mod_user.register.your_surname }}</label>
									<input type="text" class="form-control" id="last_name" name="last_name" value="{{ last_name }}" required minlength="2" maxlength="20" placeholder="{{ lang.mod_user.register.your_surname }}">
									<div class="invalid-feedback">
										Please enter a valid surname (2-20 characters).
									</div>
								</div>
							</div>

							<div class="mb-3">
								<label class="form-label" for="username">{{ lang.mod_user.register.your_username }}</label>
								<input type="text" class="form-control" id="username" name="username" value="{{ kullanici_adi }}" required minlength="2" maxlength="20" placeholder="{{ lang.mod_user.register.your_username }}">
								<div class="invalid-feedback">
									Please enter a valid username (2-20 characters).
								</div>
							</div>

							<div class="mb-3">
								<label class="form-label" for="email">{{ lang.mod_user.register.email }}</label>
								<input type="email" class="form-control" id="email" name="email" value="{{ email }}" required minlength="7" maxlength="50" placeholder="{{ lang.mod_user.register.email }}">
								<div class="invalid-feedback">
									Please enter a valid email address.
								</div>
							</div>

							<div class="row">
								<div class="col-md-6 mb-3">
									<label class="form-label" for="password">{{ lang.mod_user.register.your_password }}</label>
									<div class="input-group">
										<span class="input-group-text bg-light border-end-0 text-muted">
											<i class="bi bi-lock"></i>
										</span>
										<input type="password" class="form-control border-start-0 border-end-0 ps-0" id="password" name="password" value="{{ sifre }}" required minlength="8" maxlength="64" placeholder="{{ lang.mod_user.register.your_password }}">
										<span class="input-group-text bg-light text-muted border-start-0 toggle-password" style="cursor: pointer;" data-target="password">
											<i class="bi bi-eye"></i>
										</span>
									</div>
									<div class="invalid-feedback">
										{{ lang.mod_user.error_fatal.5 }}
									</div>

									<!-- Password Strength Indicator -->
									<div class="mt-2 d-none" id="strengthContainer">
										<div class="d-flex justify-content-between align-items-center mb-1">
											<span class="small fw-semibold text-secondary">{{ lang.mod_user.password_reset.strength_label }}</span>
											<span class="small fw-bold" id="strengthText"></span>
										</div>
										<div class="progress shadow-sm" style="height: 6px; border-radius: 3px;">
											<div class="progress-bar" id="strengthBar" role="progressbar" style="width: 0%; transition: width 0.3s ease, background-color 0.3s ease;"></div>
										</div>
									</div>

									<!-- Password Criteria Checklist -->
									<div class="mt-2 p-2 bg-light rounded shadow-sm border" id="criteriaContainer">
										<div class="row row-cols-1 g-1">
											<div class="col small d-flex align-items-center gap-2 criteria-item" data-rule="length">
												<i class="bi bi-x-circle-fill text-danger criteria-icon" style="transition: transform 0.2s ease; font-size: 0.85rem;"></i>
												<span class="text-secondary" style="font-size: 0.8rem;">{{ lang.mod_user.password_reset.rule_min_length }}</span>
											</div>
											<div class="col small d-flex align-items-center gap-2 criteria-item" data-rule="uppercase">
												<i class="bi bi-x-circle-fill text-danger criteria-icon" style="transition: transform 0.2s ease; font-size: 0.85rem;"></i>
												<span class="text-secondary" style="font-size: 0.8rem;">{{ lang.mod_user.password_reset.rule_uppercase }}</span>
											</div>
											<div class="col small d-flex align-items-center gap-2 criteria-item" data-rule="lowercase">
												<i class="bi bi-x-circle-fill text-danger criteria-icon" style="transition: transform 0.2s ease; font-size: 0.85rem;"></i>
												<span class="text-secondary" style="font-size: 0.8rem;">{{ lang.mod_user.password_reset.rule_lowercase }}</span>
											</div>
											<div class="col small d-flex align-items-center gap-2 criteria-item" data-rule="number">
												<i class="bi bi-x-circle-fill text-danger criteria-icon" style="transition: transform 0.2s ease; font-size: 0.85rem;"></i>
												<span class="text-secondary" style="font-size: 0.8rem;">{{ lang.mod_user.password_reset.rule_number }}</span>
											</div>
											<div class="col small d-flex align-items-center gap-2 criteria-item" data-rule="special">
												<i class="bi bi-x-circle-fill text-danger criteria-icon" style="transition: transform 0.2s ease; font-size: 0.85rem;"></i>
												<span class="text-secondary" style="font-size: 0.8rem;">{{ lang.mod_user.password_reset.rule_special }}</span>
											</div>
										</div>
									</div>
								</div>

								<div class="col-md-6 mb-3">
									<label class="form-label" for="password2">{{ lang.mod_user.register.confirm_password }}</label>
									<div class="input-group">
										<span class="input-group-text bg-light border-end-0 text-muted">
											<i class="bi bi-lock-fill"></i>
										</span>
										<input type="password" class="form-control border-start-0 border-end-0 ps-0" id="password2" name="password2" value="{{ sifre2 }}" required minlength="8" maxlength="64" placeholder="{{ lang.mod_user.register.confirm_password }}">
										<span class="input-group-text bg-light text-muted border-start-0 toggle-password" style="cursor: pointer;" data-target="password2">
											<i class="bi bi-eye"></i>
										</span>
									</div>
									<div class="invalid-feedback">
										{{ lang.mod_user.error_fatal.6 }}
									</div>

									<!-- Password Matching Status -->
									<div class="mt-2 d-none" id="matchContainer">
										<div class="d-flex align-items-center gap-2 small p-2 rounded bg-light border">
											<i class="bi bi-x-circle-fill text-danger" id="matchIcon"></i>
											<span class="fw-semibold text-secondary" id="matchText"></span>
										</div>
									</div>
								</div>
							</div>

							<div class="mb-3">
								<label class="form-label" for="phone">{{ lang.mod_user.register.your_phone }}</label>
								<div class="input-group">
									<select class="form-select" id="country_code" name="country_code" style="max-width: 120px;">
										<option value="">{{ lang.mod_user.register.country_codes.select }}</option>
										{% for code in country_codes %}
											<option value="{{ code.code }}" {% if country_code == code.code %} selected {% endif %}>{{ code.country }}
												({{ code.code }})</option>
										{% endfor %}
									</select>
									<input type="tel" class="form-control" id="phone" name="phone" value="{{ phone }}" required maxlength="15" placeholder="555 123 4567">
									<div class="invalid-feedback">
										{{ lang.mod_user.error_fatal.3 }}
									</div>
								</div>
								<small class="text-muted">{{ lang.mod_user.register.country_codes.phone }}
									number with country code.</small>
							</div>

							<div class="mb-4">
								<label class="form-label" for="captcha">{{ lang.mod_user.register.security_code }}</label>
								<div class="input-group">
									<input type="text" class="form-control" id="captcha" name="captcha" value="" required minlength="5" maxlength="5" placeholder="{{ lang.mod_user.register.security_code|lower }}" style="max-width: 150px;">
									<img src="{{ site.saddress }}mod_user/captcha" alt="{{ lang.mod_user.register.security_code }}" style="height: 38px; cursor: pointer;" onclick="this.src='{{ site.saddress }}mod_user/captcha?'+Math.random()">
								</div>
								<small class="text-muted">{{ lang.mod_user.register.captcha_refresh }}</small>
							</div>

							<div class="d-grid">
								<input type="hidden" name="register" value="1">
								<input type="submit" value="{{ lang.mod_user.register.register_button }}" class="btn btn-primary btn-lg" style="z-index: 9999; position: relative;">
							</div>
						</form>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
	<!-- END: mod_user/kayit.twig -->
{% endblock %}
