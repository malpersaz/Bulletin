{% extends "layouts/base.twig" %}

{% block css_custom %}
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/detail-foundation.css?v={{ site.version|default('1.0') }}">
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/legal-info.css?v={{ site.version|default('1.0') }}">
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/cookie-policy.css?v={{ site.version|default('1.0') }}">
{% endblock %}

{% set page_meta_title = lang.index.cookie_policy %}
{% set page_meta_description = lang.index.cookie_policy_subtitle is defined and lang.index.cookie_policy_subtitle is not empty ? lang.index.cookie_policy_subtitle : site.description %}

{% block canonical %}
	<link rel="canonical" href="{{ site.saddress }}cookie-policy"/>
{% endblock %}

{% block title %}
	<title>{{ page_meta_title }} - {{ site.name }}</title>
{% endblock %}

{% block description %}
	<meta name="description" content="{{ page_meta_description }}">
{% endblock %}

{% block meta_tags %}
	<meta property="og:type" content="website">
	<meta property="og:url" content="{{ site.saddress }}cookie-policy">
	<meta property="og:title" content="{{ page_meta_title }}">
	<meta property="og:description" content="{{ page_meta_description|striptags|slice(0, 200) }}">
	<meta property="og:site_name" content="{{ site.name }}">
	{% set og_locale = site.lang %}
	{% if site.lang == 'en' %}{% set og_locale = 'en_US' %}
	{% elseif site.lang == 'tr' %}{% set og_locale = 'tr_TR' %}
	{% elseif site.lang == 'de' %}{% set og_locale = 'de_DE' %}
	{% elseif site.lang == 'fr' %}{% set og_locale = 'fr_FR' %}
	{% elseif site.lang == 'sv' %}{% set og_locale = 'sv_SE' %}
	{% elseif site.lang == 'ru' %}{% set og_locale = 'ru_RU' %}
	{% elseif site.lang == 'ar' %}{% set og_locale = 'ar_AR' %}
	{% elseif site.lang == 'ku' %}{% set og_locale = 'ku' %}
	{% elseif site.lang == 'ckb' %}{% set og_locale = 'ckb' %}
	{% elseif site.lang == 'zza' %}{% set og_locale = 'zza' %}
	{% endif %}
	<meta property="og:locale" content="{{ og_locale }}">

	<meta name="twitter:card" content="summary">
	<meta name="twitter:url" content="{{ site.saddress }}cookie-policy">
	<meta name="twitter:title" content="{{ page_meta_title }}">
	<meta name="twitter:description" content="{{ page_meta_description|striptags|slice(0, 200) }}">
{% endblock %}

{% block schema %}
	<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "WebPage",
		  "name": {{ page_meta_title|json_encode|raw }},
		  "description": {{ page_meta_description|striptags|slice(0, 200)|json_encode|raw }},
		  "url": {{ (site.saddress ~ 'cookie-policy')|json_encode|raw }},
		  "isPartOf": {
		    "@type": "WebSite",
		    "name": {{ site.name|json_encode|raw }},
		    "url": {{ site.address|json_encode|raw }}
		  },
		  "breadcrumb": {
		    "@type": "BreadcrumbList",
		    "itemListElement": [
		      {
		        "@type": "ListItem",
		        "position": 1,
		        "name": {{ lang.index.home|json_encode|raw }},
		        "item": {{ site.saddress|json_encode|raw }}
		      },
		      {
		        "@type": "ListItem",
		        "position": 2,
		        "name": {{ page_meta_title|json_encode|raw }},
		        "item": {{ (site.saddress ~ 'cookie-policy')|json_encode|raw }}
		      }
		    ]
		  }
		}
	</script>
{% endblock %}

{% block content %}
<div class="legal-dossier-shell cookie-policy-shell" id="mod_cookie_policy">
	<div class="legal-breadcrumb-bar">
		<nav aria-label="{{ lang.index.home }}">
			<ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
				<li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<a itemprop="item" href="{{ site.saddress }}">
						<span itemprop="name">{{ lang.index.home }}</span>
					</a>
					<meta itemprop="position" content="1"/>
				</li>
				<li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<span itemprop="name">{{ page_meta_title }}</span>
					<meta itemprop="position" content="2"/>
				</li>
			</ol>
		</nav>
	</div>

	<div class="legal-dossier-grid">
		<aside class="legal-dossier-sidebar">
			{% include "partials/_legal_nav.twig" %}
		</aside>

		<article class="legal-document-sheet cookie-card-main">
			<header class="legal-doc-header">
				<h1 class="legal-doc-title">{{ page_meta_title }}</h1>
				<p class="legal-doc-lead">{{ lang.index.cookie_policy_subtitle }}</p>
				{% if site.cookie_policy_content is defined and site.cookie_policy_content is not empty %}
					<div class="cookie-custom-notice-box">
						<div class="cookie-custom-notice-text">{{ site.cookie_policy_content|nl2br }}</div>
					</div>
				{% endif %}
			</header>

			<!-- Preferences Center Box -->
			<section class="cookie-preferences-container" aria-labelledby="pref-center-heading">
				<div class="cookie-pref-header">
					<h2 id="pref-center-heading" class="h4 fw-bold mb-1 text-body d-flex align-items-center gap-2">
						<i class="bi bi-sliders text-primary" aria-hidden="true"></i>
						<span>{{ lang.index.cookie_preferences_title }}</span>
					</h2>
					<p class="small text-muted mb-0">{{ lang.index.cookie_preferences_desc }}</p>
				</div>

				<div class="cookie-pref-actions-top">
					<button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" id="btn-cookie-accept-all-top">
						<i class="bi bi-check2-all me-1" aria-hidden="true"></i>{{ lang.index.cookie_accept_all }}
					</button>
					<button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" id="btn-cookie-reject-opt-top">
						<i class="bi bi-x-circle me-1" aria-hidden="true"></i>{{ lang.index.cookie_reject_optional }}
					</button>
				</div>

				<!-- Category 1: Strictly Necessary -->
				<div class="cookie-cat-card">
					<div class="cookie-cat-header">
						<div class="cookie-cat-header-top">
							<h3 class="cookie-cat-title">{{ lang.index.cookie_category_necessary }}</h3>
							<div class="cookie-switch-wrapper">
								<span class="cookie-badge-locked">
									<i class="bi bi-lock-fill" aria-hidden="true"></i>
									<span>{{ lang.index.cookie_always_active }}</span>
								</span>
							</div>
						</div>
						<p class="cookie-cat-desc">{{ lang.index.cookie_category_necessary_desc }}</p>
					</div>

					<div class="table-responsive cookie-table-responsive">
						<table class="table cookie-table">
							<thead>
								<tr>
									<th>{{ lang.index.cookie_name }}</th>
									<th>{{ lang.index.cookie_provider }}</th>
									<th>{{ lang.index.cookie_purpose }}</th>
									<th>{{ lang.index.cookie_duration }}</th>
								</tr>
							</thead>
							<tbody>
								{% if cookies_by_category.necessary is defined and cookies_by_category.necessary is not empty %}
									{% for cookie_item in cookies_by_category.necessary %}
										<tr>
											<td data-label="{{ lang.index.cookie_name }}"><span class="cookie-code-tag">{{ cookie_item.cookie_name }}</span></td>
											<td data-label="{{ lang.index.cookie_provider }}">{{ cookie_item.provider }}</td>
											<td data-label="{{ lang.index.cookie_purpose }}">{{ cookie_item.purpose }}</td>
											<td data-label="{{ lang.index.cookie_duration }}">{{ cookie_item.duration }}</td>
										</tr>
									{% endfor %}
								{% else %}
									<tr>
										<td data-label="{{ lang.index.cookie_name }}"><span class="cookie-code-tag">PHPSESSID</span></td>
										<td data-label="{{ lang.index.cookie_provider }}">{{ site.name }} ({{ lang.index.cookie_first_party }})</td>
										<td data-label="{{ lang.index.cookie_purpose }}">{{ lang.index.cookie_sample_session_purpose }}</td>
										<td data-label="{{ lang.index.cookie_duration }}">{{ lang.index.cookie_session }}</td>
									</tr>
									<tr>
										<td data-label="{{ lang.index.cookie_name }}"><span class="cookie-code-tag">csrf_token</span></td>
										<td data-label="{{ lang.index.cookie_provider }}">{{ site.name }} ({{ lang.index.cookie_first_party }})</td>
										<td data-label="{{ lang.index.cookie_purpose }}">{{ lang.index.cookie_sample_csrf_purpose }}</td>
										<td data-label="{{ lang.index.cookie_duration }}">{{ lang.index.cookie_session }}</td>
									</tr>
									<tr>
										<td data-label="{{ lang.index.cookie_name }}"><span class="cookie-code-tag">cookie_consent</span></td>
										<td data-label="{{ lang.index.cookie_provider }}">{{ site.name }} ({{ lang.index.cookie_first_party }})</td>
										<td data-label="{{ lang.index.cookie_purpose }}">{{ lang.index.cookie_sample_consent_purpose }}</td>
										<td data-label="{{ lang.index.cookie_duration }}">{{ lang.index.cookie_6_months }}</td>
									</tr>
								{% endif %}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Category 2: Functional & Preferences -->
				<div class="cookie-cat-card">
					<div class="cookie-cat-header">
						<div class="cookie-cat-header-top">
							<h3 class="cookie-cat-title">{{ lang.index.cookie_category_functional }}</h3>
							<div class="cookie-switch-wrapper">
								<label class="cookie-switch" for="cookie-toggle-functional">
									<input type="checkbox" id="cookie-toggle-functional" checked aria-label="{{ lang.index.cookie_category_functional }}">
									<span class="cookie-slider"></span>
								</label>
							</div>
						</div>
						<p class="cookie-cat-desc">{{ lang.index.cookie_category_functional_desc }}</p>
					</div>

					<div class="table-responsive cookie-table-responsive">
						<table class="table cookie-table">
							<thead>
								<tr>
									<th>{{ lang.index.cookie_name }}</th>
									<th>{{ lang.index.cookie_provider }}</th>
									<th>{{ lang.index.cookie_purpose }}</th>
									<th>{{ lang.index.cookie_duration }}</th>
								</tr>
							</thead>
							<tbody>
								{% if cookies_by_category.functional is defined and cookies_by_category.functional is not empty %}
									{% for cookie_item in cookies_by_category.functional %}
										<tr>
											<td data-label="{{ lang.index.cookie_name }}"><span class="cookie-code-tag">{{ cookie_item.cookie_name }}</span></td>
											<td data-label="{{ lang.index.cookie_provider }}">{{ cookie_item.provider }}</td>
											<td data-label="{{ lang.index.cookie_purpose }}">{{ cookie_item.purpose }}</td>
											<td data-label="{{ lang.index.cookie_duration }}">{{ cookie_item.duration }}</td>
										</tr>
									{% endfor %}
								{% else %}
									<tr>
										<td data-label="{{ lang.index.cookie_name }}"><span class="cookie-code-tag">theme</span></td>
										<td data-label="{{ lang.index.cookie_provider }}">{{ site.name }} ({{ lang.index.cookie_first_party }})</td>
										<td data-label="{{ lang.index.cookie_purpose }}">{{ lang.index.cookie_sample_theme_purpose }}</td>
										<td data-label="{{ lang.index.cookie_duration }}">{{ lang.index.cookie_1_year }}</td>
									</tr>
									<tr>
										<td data-label="{{ lang.index.cookie_name }}"><span class="cookie-code-tag">lang</span></td>
										<td data-label="{{ lang.index.cookie_provider }}">{{ site.name }} ({{ lang.index.cookie_first_party }})</td>
										<td data-label="{{ lang.index.cookie_purpose }}">{{ lang.index.cookie_sample_lang_purpose }}</td>
										<td data-label="{{ lang.index.cookie_duration }}">{{ lang.index.cookie_1_year }}</td>
									</tr>
								{% endif %}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Category 3: Analytics & Performance -->
				<div class="cookie-cat-card">
					<div class="cookie-cat-header">
						<div class="cookie-cat-header-top">
							<h3 class="cookie-cat-title">{{ lang.index.cookie_category_analytics }}</h3>
							<div class="cookie-switch-wrapper">
								<label class="cookie-switch" for="cookie-toggle-analytics">
									<input type="checkbox" id="cookie-toggle-analytics" aria-label="{{ lang.index.cookie_category_analytics }}">
									<span class="cookie-slider"></span>
								</label>
							</div>
						</div>
						<p class="cookie-cat-desc">{{ lang.index.cookie_category_analytics_desc }}</p>
					</div>

					<div class="table-responsive cookie-table-responsive">
						<table class="table cookie-table">
							<thead>
								<tr>
									<th>{{ lang.index.cookie_name }}</th>
									<th>{{ lang.index.cookie_provider }}</th>
									<th>{{ lang.index.cookie_purpose }}</th>
									<th>{{ lang.index.cookie_duration }}</th>
								</tr>
							</thead>
							<tbody>
								{% if cookies_by_category.analytics is defined and cookies_by_category.analytics is not empty %}
									{% for cookie_item in cookies_by_category.analytics %}
										<tr>
											<td data-label="{{ lang.index.cookie_name }}"><span class="cookie-code-tag">{{ cookie_item.cookie_name }}</span></td>
											<td data-label="{{ lang.index.cookie_provider }}">{{ cookie_item.provider }}</td>
											<td data-label="{{ lang.index.cookie_purpose }}">{{ cookie_item.purpose }}</td>
											<td data-label="{{ lang.index.cookie_duration }}">{{ cookie_item.duration }}</td>
										</tr>
									{% endfor %}
								{% else %}
									<tr>
										<td data-label="{{ lang.index.cookie_name }}"><span class="cookie-code-tag">_ga, _gid</span></td>
										<td data-label="{{ lang.index.cookie_provider }}">{{ lang.index.cookie_sample_analytics_provider }}</td>
										<td data-label="{{ lang.index.cookie_purpose }}">{{ lang.index.cookie_sample_analytics_purpose }}</td>
										<td data-label="{{ lang.index.cookie_duration }}">{{ lang.index.cookie_1_year }}</td>
									</tr>
								{% endif %}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Category 4: Marketing & Outreach -->
				<div class="cookie-cat-card">
					<div class="cookie-cat-header">
						<div class="cookie-cat-header-top">
							<h3 class="cookie-cat-title">{{ lang.index.cookie_category_marketing }}</h3>
							<div class="cookie-switch-wrapper">
								<label class="cookie-switch" for="cookie-toggle-marketing">
									<input type="checkbox" id="cookie-toggle-marketing" aria-label="{{ lang.index.cookie_category_marketing }}">
									<span class="cookie-slider"></span>
								</label>
							</div>
						</div>
						<p class="cookie-cat-desc">{{ lang.index.cookie_category_marketing_desc }}</p>
					</div>

					<div class="table-responsive cookie-table-responsive">
						<table class="table cookie-table">
							<thead>
								<tr>
									<th>{{ lang.index.cookie_name }}</th>
									<th>{{ lang.index.cookie_provider }}</th>
									<th>{{ lang.index.cookie_purpose }}</th>
									<th>{{ lang.index.cookie_duration }}</th>
								</tr>
							</thead>
							<tbody>
								{% if cookies_by_category.marketing is defined and cookies_by_category.marketing is not empty %}
									{% for cookie_item in cookies_by_category.marketing %}
										<tr>
											<td data-label="{{ lang.index.cookie_name }}"><span class="cookie-code-tag">{{ cookie_item.cookie_name }}</span></td>
											<td data-label="{{ lang.index.cookie_provider }}">{{ cookie_item.provider }}</td>
											<td data-label="{{ lang.index.cookie_purpose }}">{{ cookie_item.purpose }}</td>
											<td data-label="{{ lang.index.cookie_duration }}">{{ cookie_item.duration }}</td>
										</tr>
									{% endfor %}
								{% else %}
									<tr>
										<td data-label="{{ lang.index.cookie_name }}"><span class="cookie-code-tag">_camp_id</span></td>
										<td data-label="{{ lang.index.cookie_provider }}">{{ lang.index.cookie_sample_marketing_provider }}</td>
										<td data-label="{{ lang.index.cookie_purpose }}">{{ lang.index.cookie_sample_marketing_purpose }}</td>
										<td data-label="{{ lang.index.cookie_duration }}">{{ lang.index.cookie_6_months }}</td>
									</tr>
								{% endif %}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Save Preferences Bar -->
				<div class="cookie-save-bar">
					<div class="d-flex gap-2 flex-wrap">
						<button type="button" class="btn btn-outline-secondary rounded-pill px-4" id="btn-cookie-reject-opt">
							{{ lang.index.cookie_reject_optional }}
						</button>
						<button type="button" class="btn btn-outline-primary rounded-pill px-4" id="btn-cookie-accept-all">
							{{ lang.index.cookie_accept_all }}
						</button>
					</div>
					<button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" id="btn-save-cookie-pref">
						<i class="bi bi-check2-circle me-1" aria-hidden="true"></i>{{ lang.index.cookie_save_preferences }}
					</button>
				</div>
			</section>

			<!-- Educational Content -->
			<section class="mt-5 pt-3 border-top">
				<div class="row gy-4">
					<div class="col-md-6">
						<h3 class="h5 fw-bold text-body mb-2 d-flex align-items-center gap-2">
							<i class="bi bi-question-circle text-primary" aria-hidden="true"></i>
							<span>{{ lang.index.cookie_what_are_cookies }}</span>
						</h3>
						<p class="text-muted small leading-relaxed">{{ lang.index.cookie_what_are_cookies_desc }}</p>
					</div>
					<div class="col-md-6">
						<h3 class="h5 fw-bold text-body mb-2 d-flex align-items-center gap-2">
							<i class="bi bi-browser-chrome text-primary" aria-hidden="true"></i>
							<span>{{ lang.index.cookie_how_to_manage }}</span>
						</h3>
						<p class="text-muted small leading-relaxed">{{ lang.index.cookie_how_to_manage_desc }}</p>
					</div>
				</div>
			</section>
		</article>
	</div>
</div>

<!-- Floating Save Toast Notification -->
<div id="cookie-save-toast" class="cookie-toast" role="status" aria-live="polite">
	<i class="bi bi-check-circle-fill text-success fs-5" aria-hidden="true"></i>
	<span class="cookie-toast-text">{{ lang.index.cookie_preferences_saved }}</span>
</div>
{% endblock %}

{% block js_custom %}
	<script src="{{ site.taddress }}{{ site.app_template }}/static/js/cookie-policy.js?v={{ site.version|default('1.0') }}"></script>
{% endblock %}
