{% extends "layouts/base.twig" %}

{% block css_custom %}
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/detail-foundation.css?v={{ site.version|default('1.0') }}">
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/legal-info.css?v={{ site.version|default('1.0') }}">
{% endblock %}

{% set page_meta_title = lang.index.legal_info %}
{% set page_meta_description = lang.index.legal_notice_desc is defined and lang.index.legal_notice_desc is not empty ? lang.index.legal_notice_desc : site.description %}
{% set site_fallback_icon = (site.site_icon is defined and site.site_icon is not empty) ? site.site_icon : ((site.manifest_512 is defined and site.manifest_512 is not empty) ? site.manifest_512 : ((site.logo_symbol is defined and site.logo_symbol is not empty) ? site.logo_symbol : ((site.favicon_96 is defined and site.favicon_96 is not empty) ? site.favicon_96 : 'logo_square.png'))) %}
{% set page_logo_asset = site.iaddress ~ 'mod_settings/' ~ site_fallback_icon %}

{% block canonical %}
	<link rel="canonical" href="{{ site.saddress }}legal"/>
{% endblock %}

{% block title %}
	<title>{{ page_meta_title }} - {{ site.name }}</title>
{% endblock %}

{% block description %}
	<meta name="description" content="{{ page_meta_description }}">
{% endblock %}

{% block meta_tags %}
	<meta property="og:type" content="website">
	<meta property="og:url" content="{{ site.saddress }}legal">
	<meta property="og:title" content="{{ page_meta_title }}">
	<meta property="og:description" content="{{ page_meta_description|striptags|slice(0, 200) }}">
	<meta property="og:site_name" content="{{ site.name }}">
	{% set og_locale = site.lang %}
	{% if site.lang == 'en' %}{% set og_locale = 'en_US' %}
	{% elseif site.lang == 'tr' %}{% set og_locale = 'tr_TR' %}
	{% elseif site.lang == 'de' %}{% set og_locale = 'de_DE' %}
	{% elseif site.lang == 'fr' %}{% set og_locale = 'fr_FR' %}
	{% elseif site.lang == 'sv' %}{% set og_locale = 'sv_SE' %}
	{% elseif site.lang == 'ru' %}{% set og_locale = 'ru_RU' %}
	{% elseif site.lang == 'ar' %}{% set og_locale = 'ar_AR' %}
	{% elseif site.lang == 'ku' %}{% set og_locale = 'ku' %}
	{% elseif site.lang == 'ckb' %}{% set og_locale = 'ckb' %}
	{% elseif site.lang == 'zza' %}{% set og_locale = 'zza' %}
	{% endif %}
	<meta property="og:locale" content="{{ og_locale }}">

	<meta name="twitter:card" content="summary">
	<meta name="twitter:url" content="{{ site.saddress }}legal">
	<meta name="twitter:title" content="{{ page_meta_title }}">
	<meta name="twitter:description" content="{{ page_meta_description|striptags|slice(0, 200) }}">
{% endblock %}

{% block schema %}
	<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@graph": [
		    {
		      "@type": "AboutPage",
		      "@id": {{ (site.saddress ~ 'legal#webpage')|json_encode|raw }},
		      "url": {{ (site.saddress ~ 'legal')|json_encode|raw }},
		      "name": {{ page_meta_title|json_encode|raw }},
		      "description": {{ page_meta_description|striptags|slice(0, 200)|json_encode|raw }},
		      "isPartOf": {
		        "@type": "WebSite",
		        "@id": {{ (site.saddress ~ '#website')|json_encode|raw }},
		        "name": {{ site.name|json_encode|raw }},
		        "url": {{ site.address|json_encode|raw }}
		      },
		      "breadcrumb": {
		        "@type": "BreadcrumbList",
		        "itemListElement": [
		          {
		            "@type": "ListItem",
		            "position": 1,
		            "name": {{ lang.index.home|json_encode|raw }},
		            "item": {{ site.saddress|json_encode|raw }}
		          },
		          {
		            "@type": "ListItem",
		            "position": 2,
		            "name": {{ page_meta_title|json_encode|raw }},
		            "item": {{ (site.saddress ~ 'legal')|json_encode|raw }}
		          }
		        ]
		      }
		    },
		    {
		      "@type": "NewsMediaOrganization",
		      "@id": {{ (site.saddress ~ '#organization')|json_encode|raw }},
		      "name": {{ site.name|json_encode|raw }},
		      {% if site.legal_company_name is defined and site.legal_company_name is not empty %}"legalName": {{ site.legal_company_name|json_encode|raw }},{% endif %}
		      {% if site.vat_number is defined and site.vat_number is not empty %}"vatID": {{ site.vat_number|json_encode|raw }},{% endif %}
		      {% if site.tax_number is defined and site.tax_number is not empty %}"taxID": {{ site.tax_number|json_encode|raw }},{% endif %}
		      {% if site.central_registration_number is defined and site.central_registration_number is not empty %}"leiCode": {{ site.central_registration_number|json_encode|raw }},{% endif %}
		      {% if site.registered_email is defined and site.registered_email is not empty %}"email": {{ site.registered_email|json_encode|raw }},{% endif %}
		      {% if site.legal_contact_phone is defined and site.legal_contact_phone is not empty %}"telephone": {{ site.legal_contact_phone|json_encode|raw }},{% endif %}
		      "publishingPrinciples": {{ (site.saddress ~ 'editorial-policy')|json_encode|raw }},
		      "correctionsPolicy": {{ (site.saddress ~ 'editorial-policy#corrections')|json_encode|raw }},
		      "actionableFeedbackPolicy": {{ (site.saddress ~ 'editorial-policy')|json_encode|raw }},
		      "ethicsPolicy": {{ (site.saddress ~ 'compliance')|json_encode|raw }},
		      "diversityPolicy": {{ (site.saddress ~ 'compliance')|json_encode|raw }},
		      "masthead": {{ (site.saddress ~ 'legal')|json_encode|raw }},
		      "url": {{ site.address|json_encode|raw }},
		      "logo": {{ page_logo_asset|json_encode|raw }}
		    }
		  ]
		}
	</script>
{% endblock %}

{% block content %}
<div class="legal-dossier-shell" id="mod_legal">
	<div class="legal-breadcrumb-bar">
		<nav aria-label="{{ lang.index.home }}">
			<ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
				<li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<a itemprop="item" href="{{ site.saddress }}">
						<span itemprop="name">{{ lang.index.home }}</span>
					</a>
					<meta itemprop="position" content="1"/>
				</li>
				<li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<span itemprop="name">{{ page_meta_title }}</span>
					<meta itemprop="position" content="2"/>
				</li>
			</ol>
		</nav>
	</div>

	<div class="legal-dossier-grid">
		<aside class="legal-dossier-sidebar">
			{% include "partials/_legal_nav.twig" %}
		</aside>

		<article class="legal-document-sheet">
			<header class="legal-doc-header">
				<h1 class="legal-doc-title">{{ page_meta_title }}</h1>
				<p class="legal-doc-lead">{{ page_meta_description }}</p>
			</header>

			<div id="amed_content" class="legal-doc-body">
				{% include 'partials/_legal_info.twig' with {'hide_intro_desc': true} %}
			</div>
		</article>
	</div>
</div>
{% endblock %}

{% block js_custom %}
	<script src="{{ site.taddress }}{{ site.app_template }}/static/js/legal-info.js?v={{ site.version|default('1.0') }}"></script>
{% endblock %}
