{% extends "layouts/base.twig" %}

{% block css_custom %}
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/detail-foundation.css?v={{ site.version }}">
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/legal-info.css?v={{ site.version }}">
{% endblock %}

{% set page_meta_title = lang.index.terms_of_service %}
{% set page_meta_description = lang.index.terms_of_service_subtitle is defined and lang.index.terms_of_service_subtitle is not empty ? lang.index.terms_of_service_subtitle : site.description %}

{% block canonical %}
	<link rel="canonical" href="{{ site.saddress }}terms-of-service"/>
{% endblock %}

{% block title %}
	<title>{{ page_meta_title }} - {{ site.name }}</title>
{% endblock %}

{% block description %}
	<meta name="description" content="{{ page_meta_description }}">
{% endblock %}

{% block meta_tags %}
	<meta property="og:type" content="website">
	<meta property="og:url" content="{{ site.saddress }}terms-of-service">
	<meta property="og:title" content="{{ page_meta_title }}">
	<meta property="og:description" content="{{ page_meta_description|striptags|slice(0, 200) }}">
	<meta property="og:site_name" content="{{ site.name }}">
	{% set og_locale = site.lang %}
	{% if site.lang == 'en' %}{% set og_locale = 'en_US' %}
	{% elseif site.lang == 'tr' %}{% set og_locale = 'tr_TR' %}
	{% elseif site.lang == 'de' %}{% set og_locale = 'de_DE' %}
	{% elseif site.lang == 'fr' %}{% set og_locale = 'fr_FR' %}
	{% elseif site.lang == 'sv' %}{% set og_locale = 'sv_SE' %}
	{% elseif site.lang == 'ru' %}{% set og_locale = 'ru_RU' %}
	{% elseif site.lang == 'ar' %}{% set og_locale = 'ar_AR' %}
	{% elseif site.lang == 'ku' %}{% set og_locale = 'ku' %}
	{% elseif site.lang == 'ckb' %}{% set og_locale = 'ckb' %}
	{% elseif site.lang == 'zza' %}{% set og_locale = 'zza' %}
	{% endif %}
	<meta property="og:locale" content="{{ og_locale }}">

	<meta name="twitter:card" content="summary">
	<meta name="twitter:url" content="{{ site.saddress }}terms-of-service">
	<meta name="twitter:title" content="{{ page_meta_title }}">
	<meta name="twitter:description" content="{{ page_meta_description|striptags|slice(0, 200) }}">
{% endblock %}

{% block schema %}
	<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "WebPage",
		  "name": {{ page_meta_title|json_encode|raw }},
		  "description": {{ page_meta_description|striptags|slice(0, 200)|json_encode|raw }},
		  "url": {{ (site.saddress ~ 'terms-of-service')|json_encode|raw }},
		  "isPartOf": {
		    "@type": "WebSite",
		    "name": {{ site.name|json_encode|raw }},
		    "url": {{ site.address|json_encode|raw }}
		  },
		  "breadcrumb": {
		    "@type": "BreadcrumbList",
		    "itemListElement": [
		      {
			"@type": "ListItem",
			"position": 1,
			"name": {{ lang.index.home|json_encode|raw }},
			"item": {{ site.saddress|json_encode|raw }}
		      },
		      {
			"@type": "ListItem",
			"position": 2,
			"name": {{ page_meta_title|json_encode|raw }},
			"item": {{ (site.saddress ~ 'terms-of-service')|json_encode|raw }}
		      }
		    ]
		  }
		}
	</script>
{% endblock %}

{% block content %}
<div class="legal-dossier-shell" id="mod_terms_of_service">
	<div class="legal-breadcrumb-bar">
		<nav aria-label="{{ lang.index.home }}">
			<ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
				<li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<a itemprop="item" href="{{ site.saddress }}">
						<span itemprop="name">{{ lang.index.home }}</span>
					</a>
					<meta itemprop="position" content="1"/>
				</li>
				<li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<span itemprop="name">{{ page_meta_title }}</span>
					<meta itemprop="position" content="2"/>
				</li>
			</ol>
		</nav>
	</div>

	<div class="legal-dossier-grid">
		<aside class="legal-dossier-sidebar">
			{% include "partials/_legal_nav.twig" %}
		</aside>

		<article class="legal-document-sheet">
			<header class="legal-doc-header">
				<h1 class="legal-doc-title">{{ page_meta_title }}</h1>
				<p class="legal-doc-lead">{{ page_meta_description }}</p>
			</header>

			<div class="policy-card-stack">
				<!-- 1. Scope & Acceptance -->
				<section class="policy-section-card" aria-labelledby="sec-terms-scope">
					<div class="policy-section-header">
						<div class="policy-section-icon" aria-hidden="true">
							<i class="bi bi-check2-circle"></i>
						</div>
						<h2 id="sec-terms-scope" class="policy-section-title">{{ lang.index.terms_scope_title }}</h2>
					</div>
					<div class="policy-section-body">
						<p>{{ lang.index.terms_scope_desc }}</p>
					</div>
				</section>

				<!-- 2. Copyright & Syndication -->
				<section class="policy-section-card" aria-labelledby="sec-terms-copyright">
					<div class="policy-section-header">
						<div class="policy-section-icon" aria-hidden="true">
							<i class="bi bi-c-circle"></i>
						</div>
						<h2 id="sec-terms-copyright" class="policy-section-title">{{ lang.index.terms_copyright_title }}</h2>
					</div>
					<div class="policy-section-body">
						<p>{{ lang.index.terms_copyright_desc }}</p>
					</div>
				</section>

				<!-- 3. Reader Comments & Community -->
				<section class="policy-section-card" aria-labelledby="sec-terms-community">
					<div class="policy-section-header">
						<div class="policy-section-icon" aria-hidden="true">
							<i class="bi bi-chat-square-quote"></i>
						</div>
						<h2 id="sec-terms-community" class="policy-section-title">{{ lang.index.terms_community_title }}</h2>
					</div>
					<div class="policy-section-body">
						<p>{{ lang.index.terms_community_desc }}</p>
					</div>
				</section>

				<!-- 4. AI Scraping & Machine Notice -->
				<section class="policy-section-card" aria-labelledby="sec-terms-ai">
					<div class="policy-section-header">
						<div class="policy-section-icon" aria-hidden="true">
							<i class="bi bi-cpu"></i>
						</div>
						<h2 id="sec-terms-ai" class="policy-section-title">{{ lang.index.terms_ai_scraping_title }}</h2>
					</div>
					<div class="policy-section-body">
						<p>{{ lang.index.terms_ai_scraping_desc }}</p>
					</div>
				</section>

				<!-- 5. Liability & Jurisdiction -->
				<section class="policy-section-card" aria-labelledby="sec-terms-liability">
					<div class="policy-section-header">
						<div class="policy-section-icon" aria-hidden="true">
							<i class="bi bi-bank"></i>
						</div>
						<h2 id="sec-terms-liability" class="policy-section-title">{{ lang.index.terms_liability_title }}</h2>
					</div>
					<div class="policy-section-body">
						<p>{{ lang.index.terms_liability_desc }}</p>
						{% if site.compliance_jurisdiction is defined and site.compliance_jurisdiction is not empty %}
							<ul class="policy-clause-list">
								<li class="policy-clause-item">
									<div class="policy-clause-content">
										<strong>{{ lang.index.compliance_jurisdiction }}:</strong> {{ site.compliance_jurisdiction }}
									</div>
								</li>
							</ul>
						{% endif %}
					</div>
				</section>
			</div>

			<!-- Bottom Institutional Contact Bar -->
			<footer class="policy-footer-card">
				<div class="policy-footer-info">
					<div class="policy-footer-icon" aria-hidden="true">
						<i class="bi bi-file-earmark-check"></i>
					</div>
					<div>
						<h3 class="policy-footer-title">{{ lang.index.contact_us }}</h3>
						<p class="policy-footer-text">{{ lang.index.legal_contact_title }}</p>
					</div>
				</div>
				<div class="policy-footer-action">
					<a href="{{ site.saddress }}contact" class="btn btn-primary rounded-pill px-4">
						<i class="bi bi-send me-1" aria-hidden="true"></i>{{ lang.index.contact }}
					</a>
				</div>
			</footer>
		</article>
	</div>
</div>
{% endblock %}
