{% from "macros/menu.twig" import renderMenu %}
{% set is_logged_in = session.id is defined and session.id is not empty %}
{% set session_username = session.username is defined and session.username is not empty
	? session.username
	: (session.name is defined and session.name is not empty
		? session.name
		: (session.full_name is defined and session.full_name is not empty ? session.full_name : 'User')) %}
{% set session_display_name = session.full_name is defined and session.full_name is not empty
	? session.full_name
	: (session.name is defined and session.name is not empty ? session.name : session_username) %}
{% set session_logout_sid = session.sid is defined and session.sid is not empty ? session.sid : null %}

<nav class="navbar navbar-expand-lg sticky-top" aria-label="{{ lang.index.navigation }}" id="amidaMainHeader">
	<div class="container">
		<!-- Brand/Logo -->
		<!-- Brand/Logo (Vector SVG Masthead) -->
		{% set header_svg_logo = 'static/mod_settings/amida_kurd_logo.svg' %}
		<a class="navbar-brand d-flex align-items-center" href="{{ site.saddress }}" title="{{ site.title }}" aria-label="{{ site.title }}">
			<img src="{{ site.address }}{{ header_svg_logo }}" alt="{{ site.title }}" width="175" height="40" class="stacked-logo-svg d-inline-block">
		</a>

		<!-- Mobile toggle button -->
		<button class="navbar-toggler border-0 p-2" type="button" data-bs-toggle="collapse" data-bs-target="#amidaMobileMenu" aria-controls="amidaMobileMenu" aria-expanded="false" aria-label="{{ lang.index.toggle_menu }}">
			<span class="navbar-toggler-icon"></span>
		</button>

		<!-- Collapsible content -->
		<div class="collapse navbar-collapse" id="amidaMobileMenu">
			<!-- Mobile drawer header -->
			<div class="mobile-menu-header d-flex align-items-center justify-content-between p-3 border-bottom d-lg-none">
				<div class="d-flex align-items-center gap-2">
					{% if header_show_logo and header_logo_image %}
						<img src="{{ site.iaddress }}mod_settings/{{ header_logo_image }}" alt="{{ site.title }}" width="32" height="32" class="logo-image {% if header_is_square %}logo-square{% else %}logo-rect{% endif %}">
					{% endif %}
					<span class="brand-text brand-text-gothic fs-4">{{ site.title }}</span>
				</div>
				<button type="button" class="btn-close mobile-menu-close" data-bs-toggle="collapse" data-bs-target="#amidaMobileMenu" aria-controls="amidaMobileMenu" aria-label="{{ lang.index.modal.close }}"></button>
			</div>

			<!-- Main Navigation -->
			<ul class="navbar-nav me-auto mb-2 mb-lg-0">
				{% if menu is defined and menu is not empty %}
					{{ renderMenu(menu, 0, 0, 0) }}
				{% endif %}
			</ul>

			<!-- Search Form -->
			<form class="search-form d-flex me-lg-3" role="search" method="get" action="{{ site.saddress }}index/search/">
				<div class="search-wrapper w-100 position-relative">
					<button class="search-btn" type="submit" aria-label="{{ lang.index.search.search }}" title="{{ lang.index.search.search }}">
						<i class="bi bi-search" aria-hidden="true"></i>
					</button>
					<label for="topMenuSearchInput" class="visually-hidden">{{ lang.index.search.placeholder }}</label>
					<input type="search" id="topMenuSearchInput" name="query" class="form-control search-input" placeholder="{{ lang.index.search.placeholder }}" aria-label="{{ lang.index.search.placeholder }}" autocomplete="off">
				</div>
			</form>

			<!-- User Section -->
			<div class="user-section d-flex align-items-center gap-2">
				<!-- Desktop Language Selector -->
				<div class="language-selector d-none d-lg-block">
					<div class="dropdown">
						<button class="btn btn-header-action dropdown-toggle" type="button" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="{{ lang.index.language }}">
							<i class="bi bi-globe2 me-1" aria-hidden="true"></i>
							<span class="lang-text">{{ site.lang|upper }}</span>
						</button>

						<ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="languageDropdown">
							<li>
								<h6 class="dropdown-header">
									<i class="bi bi-translate me-2" aria-hidden="true"></i>{{ lang.index.language }}
								</h6>
							</li>
							{% if site.available_languages is defined %}
								{% for l in site.available_languages %}
									<li>
										<a class="dropdown-item d-flex align-items-center justify-content-between {% if site.lang == l.code %}active{% endif %}" href="{{ site.address }}{{ l.code }}">
											<span>{{ l.name }}</span>
											{% if site.lang == l.code %}
												<i class="bi bi-check2 text-success ms-2" aria-hidden="true"></i>
											{% endif %}
										</a>
									</li>
								{% endfor %}
							{% endif %}
						</ul>
					</div>
				</div>

				<!-- Desktop Dark Mode Toggle -->
				<button class="btn btn-header-action btn-icon d-none d-lg-inline-flex" id="darkModeToggle" type="button" aria-label="{{ lang.index.dark_mode }}" title="{{ lang.index.dark_mode }}">
					<i class="bi bi-moon-stars" aria-hidden="true"></i>
				</button>

				{% if is_logged_in %}
					<!-- Logged in user -->
					<div class="dropdown">
						<button class="btn user-profile-btn d-flex align-items-center" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
							<div class="user-avatar-container">
								{% if session.image is defined and session.image is not empty and session.image != 'avatar.png' %}
									<img src="{{ site.address }}static/mod_user/{{ session.image }}" alt="{{ session_display_name }}" class="user-avatar rounded-circle" width="32" height="32">
								{% else %}
									<div class="user-avatar user-avatar-placeholder rounded-circle bg-primary text-white">
										{{ session_display_name|slice(0, 1)|upper }}
									</div>
								{% endif %}
								<div class="avatar-status-indicator online"></div>
							</div>
							<span class="user-name d-none d-md-inline ms-1 me-1">
								{{ session_display_name }}
							</span>
							<i class="bi bi-chevron-down user-dropdown-arrow" aria-hidden="true"></i>
						</button>

						<ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown">
							<li class="dropdown-header">
								<div class="d-flex align-items-center">
									{% if session.image is defined and session.image is not empty and session.image != 'avatar.png' %}
										<img src="{{ site.address }}static/mod_user/{{ session.image }}" alt="{{ session_username }}" class="user-avatar-sm rounded-circle me-2" width="28" height="28">
									{% else %}
										<div class="user-avatar-sm user-avatar-sm-placeholder rounded-circle me-2 bg-primary text-white">
											{{ session_display_name|slice(0, 1)|upper }}
										</div>
									{% endif %}
									<div class="user-info-text text-truncate">
										{% if session.full_name is defined and session.full_name is not empty %}
											<div class="fw-bold text-truncate">{{ session.full_name }}</div>
											<small class="text-muted">@{{ session_username }}</small>
										{% else %}
											<div class="fw-bold text-truncate">{{ session_username }}</div>
										{% endif %}
									</div>
								</div>
							</li>
							<li><hr class="dropdown-divider"></li>
							<li>
								<a class="dropdown-item d-flex align-items-center justify-content-between" href="{{ site.saddress }}mod_user_pm/inbox">
									<div>
										<i class="bi bi-envelope me-2 text-primary" aria-hidden="true"></i>
										<span>{{ lang.index.messages }}</span>
									</div>
									{% set unread_count = session.unread_messages is defined and session.unread_messages > 0 ? session.unread_messages : (session.okunmamis is defined and session.okunmamis > 0 ? session.okunmamis : 0) %}
									{% if unread_count > 0 %}
										<span class="badge bg-danger rounded-pill">{{ unread_count }}</span>
									{% endif %}
								</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ site.saddress }}mod_user/panel">
									<i class="bi bi-person-circle me-2 text-primary" aria-hidden="true"></i>
									{{ lang.index.my_account }}
								</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ site.saddress }}mod_news/add">
									<i class="bi bi-newspaper me-2 text-primary" aria-hidden="true"></i>
									{{ lang.index.add_news }}
								</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ site.saddress }}mod_publication/add">
									<i class="bi bi-journal-richtext me-2 text-primary" aria-hidden="true"></i>
									{{ lang.index.add_publication }}
								</a>
							</li>
							<li><hr class="dropdown-divider"></li>

							<li>
								<a class="dropdown-item text-danger" href="{{ site.saddress }}logout{% if session_logout_sid %}/{{ session_logout_sid }}{% endif %}">
									<i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>
									{{ lang.index.logout }}
								</a>
							</li>
						</ul>
					</div>
				{% else %}
					<!-- Guest user -->
					<div class="auth-buttons d-flex align-items-center gap-2">
						<button class="btn btn-header-login" data-bs-toggle="modal" data-bs-target="#loginModal">
							<i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>
							<span>{{ lang.index.login }}</span>
						</button>
						<a href="{{ site.saddress }}register" class="btn btn-header-register">
							<i class="bi bi-person-plus me-1" aria-hidden="true"></i>
							<span>{{ lang.index.register }}</span>
						</a>
					</div>
				{% endif %}

				<!-- Mobile Controls Row (Language & Dark Mode) -->
				<div class="mobile-controls-row d-lg-none w-100 mt-3 pt-3 border-top">
					<div class="d-flex align-items-center gap-2">
						<!-- Language Selector (Flex Grow) -->
						<div class="language-selector flex-grow-1">
							<div class="dropdown">
								<button class="btn btn-header-action w-100 d-flex align-items-center justify-content-between p-2 dropdown-toggle" type="button" id="languageDropdownMobile" data-bs-toggle="dropdown" aria-expanded="false" title="{{ lang.index.language }}">
									<div class="d-flex align-items-center">
										<i class="bi bi-globe2 me-2 text-muted" aria-hidden="true"></i>
										<span class="fw-semibold">{{ site.lang|upper }}</span>
									</div>
									<i class="bi bi-chevron-down small text-muted" aria-hidden="true"></i>
								</button>

								<ul class="dropdown-menu shadow-sm" aria-labelledby="languageDropdownMobile">
									<li>
										<h6 class="dropdown-header">
											<i class="bi bi-translate me-2" aria-hidden="true"></i>{{ lang.index.language }}
										</h6>
									</li>
									{% if site.available_languages is defined %}
										{% for l in site.available_languages %}
											<li>
												<a class="dropdown-item d-flex align-items-center justify-content-between {% if site.lang == l.code %}active{% endif %}" href="{{ site.address }}{{ l.code }}">
													<span>{{ l.name }}</span>
													{% if site.lang == l.code %}
														<i class="bi bi-check2 text-success" aria-hidden="true"></i>
													{% endif %}
												</a>
											</li>
										{% endfor %}
									{% endif %}
								</ul>
							</div>
						</div>

						<!-- Dark Mode Toggle (Fixed Width) -->
						<div class="mobile-dark-mode">
							<button class="btn btn-header-action btn-icon mobile-dark-mode-btn" id="darkModeToggleMobile" type="button" aria-label="{{ lang.index.dark_mode }}">
								<i class="bi bi-moon-stars" aria-hidden="true"></i>
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</nav>

<!-- Mobile Menu Overlay -->
<div class="mobile-overlay"></div>

<!-- Login Modal -->
{% if not is_logged_in %}
	<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true"
		data-url-check-user="{{ site.saddress }}mod_user/checkUserExistence"
		data-i18n-signing-in="{{ lang.index.modal.signing_in|e('html_attr') }}"
		data-i18n-login-success="{{ lang.index.modal.login_success|e('html_attr') }}"
		data-i18n-login-failed="{{ lang.index.modal.login_failed|e('html_attr') }}"
		data-i18n-connection-error="{{ lang.index.modal.connection_error|e('html_attr') }}"
		data-i18n-network-error="{{ lang.index.modal.network_error|e('html_attr') }}"
		data-i18n-timeout-error="{{ lang.index.modal.timeout_error|e('html_attr') }}"
		data-i18n-server-error="{{ lang.index.modal.server_error|e('html_attr') }}"
		data-i18n-please-fill-all="{{ lang.index.modal.please_fill_all|e('html_attr') }}"
		data-i18n-redirecting="{{ lang.index.modal.redirecting|e('html_attr') }}"
		data-i18n-alternative-options="{{ lang.index.modal.alternative_options|e('html_attr') }}"
		data-i18n-show-password="{{ lang.index.modal.show_password|e('html_attr') }}"
		data-i18n-hide-password="{{ lang.index.modal.hide_password|e('html_attr') }}"
		data-i18n-user-not-found="{{ lang.index.modal.user_not_found|e('html_attr') }}"
		data-i18n-username-required="{{ lang.index.modal.username_required|e('html_attr') }}">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header border-0">
					<h5 class="modal-title" id="loginModalLabel">
						<i class="bi bi-box-arrow-in-right me-2"></i>
						{{ lang.index.login }}
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ lang.index.modal.close }}"></button>
				</div>
				<div class="modal-body">
					<form action="{{ site.saddress }}login" method="post" id="loginForm">
						<!-- Step 1: Username -->
						<div id="loginStep1" class="login-step">
							<div class="mb-3">
								<label for="loginUsername" class="form-label">{{ lang.index.modal.username_label }}</label>
								<div class="input-group">
									<span class="input-group-text"><i class="bi bi-person"></i></span>
									<input type="text" class="form-control" id="loginUsername" name="username" required autocomplete="username">
								</div>
							</div>
							<button type="button" class="btn btn-primary w-100" id="btnNextStep">
								{{ lang.index.modal.next }}
								<i class="bi bi-arrow-right ms-2"></i>
							</button>
						</div>

						<!-- Step 2: Password (Hidden by default) -->
						<div id="loginStep2" class="login-step d-none">
							<div class="d-flex align-items-center mb-2">
								<button type="button" class="btn btn-link p-0 text-decoration-none me-2" id="btnBackToStep1" aria-label="{{ lang.index.modal.back }}">
									<i class="bi bi-arrow-left" aria-hidden="true"></i>
								</button>
								<span id="displayUsername" class="fw-bold text-primary"></span>
							</div>

							<div class="mb-3">
								<label for="loginPassword" class="form-label">{{ lang.index.modal.password_label }}</label>
								<div class="input-group">
									<span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
									<input type="password" class="form-control" id="loginPassword" name="password" required autocomplete="current-password">
									<button class="btn btn-outline-secondary" type="button" id="togglePassword" aria-label="{{ lang.index.modal.show_password }}">
										<i class="bi bi-eye" id="togglePasswordIcon" aria-hidden="true"></i>
									</button>
								</div>
							</div>
							<div class="d-flex justify-content-between align-items-center mb-3">
								<div class="form-check">
									<input class="form-check-input" type="checkbox" id="rememberMe" name="remember">
									<label class="form-check-label" for="rememberMe">
										{{ lang.index.modal.remember_me }}
									</label>
								</div>
								<a href="{{ site.saddress }}forgot-password" class="text-decoration-none">
									{{ lang.index.modal.forgot_password }}
								</a>
							</div>
							<button type="submit" class="btn btn-primary w-100" name="login">
								<i class="bi bi-box-arrow-in-right me-2"></i>
								{{ lang.index.login }}
							</button>
						</div>
					</form>
					<div class="text-center mt-3">
						<span class="text-muted">{{ lang.index.modal.no_account_question }}</span>
						<a href="{{ site.saddress }}register" class="text-decoration-none">{{ lang.index.modal.register_link_text }}</a>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endif %}

<!-- CSS -->
<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/top-menu.css?v={{ site.version|default('1.1.25') }}">
{% if not is_logged_in %}
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/login-modal.css?v={{ site.version|default('1.1.25') }}">
{% endif %}

<!-- JavaScript -->
<script src="{{ site.taddress }}{{ site.app_template }}/static/js/top-menu.js?v={{ site.version|default('1.1.25') }}"></script>
{% if not is_logged_in %}
	<script src="{{ site.taddress }}{{ site.app_template }}/static/js/login-modal.js?v={{ site.version|default('1.1.25') }}"></script>
{% endif %}
