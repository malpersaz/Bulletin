{% set hero_slider = hero_slider_items|default(ctx_get('hero_slider')) %}
{% set first_hero_img = (hero_slider|filter(s => s.image_url is defined and s.image_url is not empty))|first %}

{% if hero_slider and hero_slider|length > 0 %}
<section id="heroNewsSlider" class="hero-news-slider hero-slider-shell" aria-label="{{ lang.index.hero_slider.title }}">
    <div class="swiper hero-news-swiper">
        <div class="swiper-wrapper">
            {% for item in hero_slider %}
            <div class="swiper-slide hero-slide{% if loop.first %} swiper-slide-active{% endif %}" data-slide-index="{{ loop.index0 }}">
                <a class="hero-slide__hitbox" href="{{ item.detail_url }}" aria-label="{{ item.name }}"></a>

                <div class="hero-slide__image">
                    {# Fail-safe base background: dark branded placeholder is always present underneath #}
                    <div class="hero-slide__placeholder" aria-hidden="true">
                        <div class="hero-slide__placeholder-pattern"></div>
                        {% set hero_fallback_icon = (site.site_icon is defined and site.site_icon is not empty) ? site.site_icon : ((site.manifest_512 is defined and site.manifest_512 is not empty) ? site.manifest_512 : ((site.logo_symbol is defined and site.logo_symbol is not empty) ? site.logo_symbol : ((site.favicon_96 is defined and site.favicon_96 is not empty) ? site.favicon_96 : 'logo_square.png'))) %}
                        <img src="{{ site.iaddress }}mod_settings/thumb/{{ hero_fallback_icon }}" class="hero-slide__placeholder-symbol" width="48" height="48" alt="" loading="lazy">
                    </div>

                    {% if item.video_url is defined and item.video_url is not empty %}
                        <video autoplay loop muted playsinline {% if item.image_url %}poster="{{ item.image_url }}"{% endif %} class="hero-bg-video" aria-hidden="true">
                            <source src="{{ item.video_url }}" type="video/mp4">
                        </video>
                    {% elseif item.embed_slider_url is defined and item.embed_slider_url is not empty and ('youtube' in item.embed_slider_url or 'vimeo' in item.embed_slider_url or 'dailymotion' in item.embed_slider_url) %}
                        <iframe src="{{ item.embed_slider_url }}" title="{{ item.name|escape('html_attr') }}" class="hero-bg-embed" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" aria-hidden="true"></iframe>
                    {% elseif item.embed_url is defined and item.embed_url is not empty and ('youtube' in item.embed_url or 'vimeo' in item.embed_url or 'dailymotion' in item.embed_url) %}
                        <iframe src="{{ item.embed_url }}{{ '?' in item.embed_url ? '&' : '?' }}autoplay=1&mute=1&controls=0&loop=1&background=1" title="{{ item.name|escape('html_attr') }}" class="hero-bg-embed" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" aria-hidden="true"></iframe>
                    {% elseif item.image_url is not empty %}
                        {% set is_lcp_img = loop.first %}
                        <picture class="hero-slide__picture">
                            {% if item.thumb_url is defined and item.thumb_url is not empty %}
                                <source media="(max-width: 768px)" srcset="{{ item.thumb_url }}" sizes="100vw">
                            {% endif %}
                            <img src="{{ item.image_url }}"
                                 alt="{{ item.name }}"
                                 width="1280"
                                 height="720"
                                 sizes="(max-width: 991px) 100vw, 800px"
                                 class="hero-slide__cover-img"
                                 loading="{{ is_lcp_img ? 'eager' : 'lazy' }}"
                                 fetchpriority="{{ is_lcp_img ? 'high' : 'auto' }}"
                                 decoding="async">
                        </picture>
                    {% endif %}
                </div>

                <div class="hero-slide__overlay"></div>

                <div class="hero-slide__floating-top">
                    {% if item.category_name is not empty and item.category_url is not empty %}
                        <a href="{{ item.category_url }}" class="hero-slide__category">
                            {{ item.category_name }}
                        </a>
                    {% endif %}

                    {% if item.published_ago is not empty %}
                        <span class="hero-slide__timestamp">
                            <i class="bi bi-clock"></i>
                            {{ item.published_ago }}
                        </span>
                    {% endif %}
                </div>

                <div class="hero-slide__content">
                    <div class="hero-slide__body">
                        <div class="hero-slide__meta">
                            <div class="hero-slide__author">
                                <span class="hero-slide__avatar">
                                    {% if item.author_image_url is not empty %}
                                        <img src="{{ item.author_image_url }}" alt="{{ item.author_name }}" width="36" height="36" loading="lazy">
                                    {% endif %}
                                    <span class="hero-slide__avatar-initials{% if item.author_image_url is empty %} is-visible{% endif %}">{{ item.author_initials }}</span>
                                </span>
                                <span class="hero-slide__author-copy">
                                    <span class="hero-slide__author-name">{{ item.author_name }}</span>
                                </span>
                            </div>
                        </div>

                        <h2 class="hero-slide__title">
                            <a href="{{ item.detail_url }}">{{ item.name }}</a>
                        </h2>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        <div class="hero-news-swiper-pagination"></div>
    </div>

    <div class="hero-slider__controls hero-slider__controls--fixed" aria-label="{{ lang.index.hero_slider.title }}">
        <button type="button" class="hero-news-swiper-button-prev" aria-label="{{ lang.index.hero_slider.previous_slide }}">
            <i class="bi bi-chevron-left"></i>
        </button>
        <button type="button" class="hero-news-swiper-button-next" aria-label="{{ lang.index.hero_slider.next_slide }}">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</section>
{% endif %}
