{% extends "layouts/base.twig" %}

{% block content %}

{% set d = ctx_get('d') %}
{% set archive_categories = ctx_get('archive_categories') %}
{% set category_id = ctx_get('category_id') %}
{% set arsiv_yil = ctx_get('arsiv_yil') %}
{% set yil = ctx_get('yil') %}
{% set ay = ctx_get('ay') %}
{% set bulunamadi = ctx_get('bulunamadi') %}
{% set contents = ctx_get('contents') %}
<div class="row" id="mod_content_list">
    <div class="card">
        <div class="card-header">
            <ol class="breadcrumb panel-title">
                <li>
                    <a href="{{ site.saddress }}">{{ lang.index.homepage }}</a>
                </li>
                <li class="active">{{ lang.index.mod_content.6 }}</li>
            </ol>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <form class="form-horizontal" method="post" action="">
                                <fieldset>
                                    <!-- Form Name -->
                                    <legend>{{ d.name }}</legend>
                                    <div class="form-group">
                                        <label class="col-md-4 control-label" for="category_id">{{ lang.index.mod_content.12 }}</label>
                                        <div class="col-md-8">
                                            <select id="category_id" name="category_id" class="form-control">
                                                <option value="*"{% if category_id == '*' %} selected="selected"{% endif %}>*</option>
                                                {% for kat in archive_categories %}
                                                    <option value="{{ kat.id }}"
                                                            {% if category_id == kat.id %}selected="selected"{% endif %}>
                                                        {{ kat.name }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-md-4 control-label" for="yil">{{ lang.index.mod_content.13 }}</label>
                                        <div class="col-md-8">
                                            <select id="yil" name="yil" class="form-control">
                                                <option value="*"{% if yil == '*' %} selected="selected"{% endif %}>*</option>
                                                {% for year in range(arsiv_yil.min_yil, arsiv_yil.max_yil) %}
                                                    <option value="{{ year }}"{% if yil == year %} selected="selected"{% endif %}>{{ year }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-md-4 control-label" for="ay">{{ lang.index.mod_content.14 }}</label>
                                        <div class="col-md-8">
                                            <select id="ay" name="ay" class="form-control">
                                                <option value="*"{% if ay == '*' %} selected="selected"{% endif %}>*</option>
                                                {% for ayKey, ayValue in lang.index.mod_content.aylar %}
                                                    <option value="{{ ayKey + 1 }}"
                                                            {% if ay == (ayKey + 1) %}selected="selected"{% endif %}>
                                                        {{ ayValue }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-md-4 control-label" for="ara">İşlem</label>
                                        <div class="col-md-8">
                                            <button id="ara" name="ara" class="btn btn-success">{{ lang.index.mod_content.15 }}</button>
                                        </div>
                                    </div>
                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <hr>
                    {% if bulunamadi is not empty %}<h5 class="alert alert-info">{{ lang.index.mod_content.10 }}</h5>{% endif %}
                    {% if contents is not empty %}
                        <h4 class="alert alert-success">{{ lang.index.mod_content.11 }}</h4>
                        {% for content in contents %}
                            <p>
                                {{ content.created_at|date("Y-m-d") }} - <a data-bs-toggle="tooltip"
    href="{{ site.saddress }}article/{{ content.seo }}"
    title="{% if content.summary != '' %}{{ content.summary }}{% else %}{{ content.name }}{% endif %}">{{ content.name }}</a>
                            </p>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
