{% extends "layouts/base.twig" %}

{% block head_preload %}
    {{ parent() }}
    {{ run({"mod": "index", "method": "_hero_slider", "extra": [10]}) }}
    {% set first_hero_img = (ctx_get('hero_slider')|filter(s => s.image_url is defined and s.image_url is not empty))|first %}
    {% if first_hero_img and first_hero_img.image_url is not empty %}
        {% if first_hero_img.thumb_url is defined and first_hero_img.thumb_url is not empty %}
            <link rel="preload" as="image" href="{{ first_hero_img.thumb_url }}" media="(max-width: 768px)" fetchpriority="high">
            <link rel="preload" as="image" href="{{ first_hero_img.image_url }}" media="(min-width: 769px)" fetchpriority="high">
        {% else %}
            <link rel="preload" as="image" href="{{ first_hero_img.image_url }}" fetchpriority="high">
        {% endif %}
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/hero-news-slider.min.css?v={{ site.version }}">
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/latest-authors.css?v={{ site.version }}">
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/latest-news.css?v={{ site.version }}">
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/sports-news.css?v={{ site.version }}">
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/world-news.css?v={{ site.version }}">
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/latest-videos.css?v={{ site.version }}">
{% endblock %}

{% block js_custom %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
    <script src="{{ site.taddress }}{{ site.app_template }}/static/js/hero-news-slider.js?v={{ site.version }}" defer></script>
{% endblock %}

{% block content %}
<!-- START: index/index.twig -->
    {% set homepage_hero_slider = ctx_get('hero_slider') %}
    {% if homepage_hero_slider is empty %}
        {{ run({"mod": "index", "method": "_hero_slider", "extra": [10]}) }}
        {% set homepage_hero_slider = ctx_get('hero_slider') %}
    {% endif %}

    <section class="row mt-3 homepage-hero-row" id="homepageHeroRow">
        <article id="homepageHeroMain" class="col-12 col-lg-8 homepage-hero-main">
            {# Block L1 — Hero News Slider (800 x 450 px, 16:9) #}
            {% if homepage_hero_slider and homepage_hero_slider|length > 0 %}
                {% include 'index/hero_slider.twig' with { hero_slider_items: homepage_hero_slider } %}
            {% endif %}

            {# Block L2 — Horizontal Authors Strip (3 Columns) #}
            {% include 'index/mod_publication/latest_authors.twig' with { limit: 3 } %}

            {# Block L3 — Latest News Grid (6 Cards in 3x2 Grid) #}
            {% include 'index/mod_news/latest_news.twig' %}

            {# Block L4 — Sports News Section (2 Horizontal Cards in 2x1 Grid) #}
            {% include 'index/mod_news/sports_news.twig' %}

            {# Block L5 — Video Gallery (3 Cards in 3x1 Grid) #}
            {% include 'index/mod_video_embed/latest_videos.twig' with { limit: 3 } %}
        </article>

        <aside id="homepageHeroSidebar" class="col-12 col-lg-4 homepage-hero-sidebar">
            {# Block R1 — World & Middle East (Dünya & Ortadoğu) #}
            {% include 'index/mod_news/world_news.twig' %}

            {# Pinned Homepage Categories Sidebar #}
            {{ run({"mod": "index", "method": "_homepage_news_categories", "extra": [1, "image,name,seo,summary,created_at,video,gallery_id,file_id"]}) }}
            {% set homepage_categories = ctx_get('homepage_news_categories') %}
            
            {% if homepage_categories and homepage_categories|length > 0 %}
                {% for category in homepage_categories %}
                    {% if category.news|length > 0 and category.seo not in ['Dünya', 'Ortadoğu', 'Cîhan', 'Rojhilata_Navîn', 'World', 'Middle_East'] %}
                        <div class="category-homepage-section">
                            <h2 class="nyt-news-heading">
                                <a href="{{ site.saddress }}newses/{{ category.seo }}" class="text-decoration-none nyt-news-heading-link">{{ category.name|raw }}</a>
                            </h2>
                            {% include 'index/mod_news/category_news_row.twig' with { news_items: category.news, category_name: category.name, category_seo: category.seo, is_column: true } %}
                        </div>
                    {% endif %}
                {% endfor %}
            {% endif %}
        </aside>
    </section>
    
    {# Include the bottom menu when needed. #}
    {% include 'partials/bottom_menu.twig' %}
<!-- END: index/index.twig -->
{% endblock %}
