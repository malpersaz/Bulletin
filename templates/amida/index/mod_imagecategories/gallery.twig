{% macro image_category(categories, parent_id, ss) %}
{% for cat in categories[parent_id] %}
    {% set parent_id = cat.id %}
    {% if cat.lang == site.lang %}
        {% set ss = 1 %}
        {% if cat.root == 'y' %}
            <!--
                {{ cat.name }}
                -->
        {% else %}
            {% if keto == cat.id %}
                <p class="list-group-item active">
                    <a href="{{ site.saddress }}rkat/{{ cat.seo }}">{{ cat.name }}</a>
                </p>
            {% else %}
                {% if cat.seo == '#' %}
                    <!--
                        <b class="list-group-item">{{ cat.name }}</b>
                        -->
                {% else %}
                    <p class="list-group-item">
                        <a href="{{ site.saddress }}rkat/{{ cat.seo }}">{{ cat.name }}</a>
                    </p>
                {% endif %}
            {% endif %}
        {% endif %}
    {% endif %}
    {% if categories[parent_id] is not empty %}
        {% if ss == '1' %}{% endif %}
        {{ _self.image_category(categories, parent_id) }}
        {% if ss == '1' %}{% endif %}
    {% endif %}
    {% if cat.lang == site.lang %}{% endif %}
{% endfor %}
{% endmacro %}

{% extends "layouts/base.twig" %}

{% set d = ctx_get('d') %}
{% set rkat = ctx_get('rkat') %}
{% set keto = ctx_get('keto') %}
{% set gallery = ctx_get('gallery') ?: ctx_get('res') %}

{% block title %}
	<title>
		{% if d.name is not empty %}
			{{ d.name }} - {{ lang.index.mod_pictures.title|default('Gallery') }} - {{ site.title }}
		{% else %}
			{{ lang.index.mod_pictures.title|default('Gallery') }} - {{ site.title }}
		{% endif %}
	</title>
{% endblock %}

{% block canonical %}
	<link rel="canonical" href="{{ site.saddress }}gallery{% if d.seo is not empty %}/{{ d.seo }}{% endif %}"/>
{% endblock %}

{% block description %}
	<meta name="description" content="{{ d.name is not empty ? (d.name ~ ' - ' ~ (lang.index.mod_pictures.title|default('Gallery')) ~ ' - ' ~ site.description) : ((lang.index.mod_pictures.title|default('Gallery')) ~ ' - ' ~ site.description) }}">
{% endblock %}

{% block keywords %}
	<meta name="keywords" content="{{ site.keywords }}">
{% endblock %}

{% block schema %}
	<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "ImageGallery",
		  "name": {{ (d.name is not empty ? d.name : (lang.index.mod_pictures.title|default('Gallery')))|json_encode|raw }},
		  "description": {{ (d.name is not empty ? (d.name ~ ' - ' ~ site.description) : ((lang.index.mod_pictures.title|default('Gallery')) ~ ' - ' ~ site.description))|striptags|slice(0, 200)|json_encode|raw }},
		  "url": {{ (site.saddress ~ 'gallery' ~ (d.seo is not empty ? '/' ~ d.seo : ''))|json_encode|raw }},
		  "isPartOf": {
		    "@type": "WebSite",
		    "name": {{ site.title|json_encode|raw }},
		    "url": {{ site.address|json_encode|raw }}
		  },
		  "breadcrumb": {
		    "@type": "BreadcrumbList",
		    "itemListElement": [
		      {
		        "@type": "ListItem",
		        "position": 1,
		        "name": {{ lang.index.home|json_encode|raw }},
		        "item": {{ site.saddress|json_encode|raw }}
		      },
		      {
		        "@type": "ListItem",
		        "position": 2,
		        "name": {{ (lang.index.mod_pictures.title|default('Gallery'))|json_encode|raw }},
		        "item": {{ (site.saddress ~ 'gallery')|json_encode|raw }}
		      }{% if d.name is not empty %},
		      {
		        "@type": "ListItem",
		        "position": 3,
		        "name": {{ d.name|json_encode|raw }}
		      }{% endif %}
		    ]
		  }
		}
	</script>
{% endblock %}

{% block content %}
<div class="row" id="mod_imagecategories">
    <div class="card">
        <div class="card-header">
            <ol class="breadcrumb panel-title">
                <li>
                    <a href="{{ site.saddress }}">{{ lang.index.home|default('Home') }}</a>
                </li>
                {% if d.name is not empty %}
                    <li>
                    </li>
                    <li class="active">{{ d.name }}</li>
                {% else %}
                {% endif %}
            </ol>
        </div>
        <div class="card-body">
            <div class="col-md-4">
                <div id="gallery_category" class="list-group">{{ _self.image_category(rkat, 0) }}</div>
            </div>
            <div class="col-md-8">
                {% include 'partials/share_toolbar.twig' with {
                    'share_url_path': 'gallery',
                    'mod_name': 'mod_imagecategories',
                    'item_id': d.id,
                    'has_gallery': gallery is defined and gallery is not empty
                } %}
                {% if d.name is not empty %}
                    {% if gallery is not empty %}
                        <div id="gallery_image">
                            <ul>
                                {% for image in gallery %}
                                    <li class="col-md-4">
                                        <div class="thumbnail">
                                            <a href="{{ site.iaddress }}mod_gallery/mod_imagecategories/original/{{ image.url }}"
                                               title="{{ image.name }}"
                                               data-bs-toggle="lightbox"
                                               data-gallery="multiimages"
                                               data-title="{{ image.name }}"
                                               data-parent="#gallery_image">
                                                <img src="{{ site.iaddress }}mod_gallery/mod_imagecategories/thumb/{{ image.url }}"
                                                     alt="{{ image.name }}">
                                            </a>
                                        </div>
                                    </li>
                                    {% endfor %}
                            </ul>
                        </div>
                    {% else %}
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
