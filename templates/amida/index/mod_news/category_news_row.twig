{% if news_items is not empty %}
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/latest-news.css?v={{ "now"|date("U") }}">

    <section class="nyt-news-section">
        <div class="row g-4">
            {% for news in news_items %}
                <article class="col-12 nyt-article">
                    {% if news.image is not empty %}
                        <div class="nyt-article-img-wrapper">
                            <a href="{{ site.saddress }}news/{{ news.seo }}" title="{{ news.name }}">
                                <img src="{{ site.iaddress }}mod_news/{{ news.image }}"
                                     class="nyt-article-img"
                                     alt="{{ news.name }}"
                                     loading="lazy">
                            </a>
                        </div>
                    {% endif %}
                    <h3 class="nyt-article-title">
                        <a href="{{ site.saddress }}news/{{ news.seo }}">{{ news.name }}</a>
                    </h3>
                    
                    {# Reading Time Calculation #}
                    {% set words = news.summary|striptags|split(' ')|length %}
                    {% set reading_minutes = (words / 200)|round(0, 'ceil') %}
                    {% if reading_minutes < 1 %}{% set reading_minutes = 1 %}{% endif %}
                    
                    <div class="nyt-article-meta d-flex align-items-center gap-3">
                        <span class="nyt-article-date">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            <time datetime="{{ news.created_at }}">{{ news.created_at|date('d.m.Y') }}</time>
                        </span>
                        <span class="nyt-article-reading-time">
                            <i class="bi bi-book" aria-hidden="true"></i>
                            {{ reading_minutes }} deqe
                        </span>
                        {% if news.published_ago is defined and news.published_ago is not empty %}
                            <span class="nyt-article-timeago">
                                <i class="bi bi-clock-history" aria-hidden="true"></i>
                                {{ news.published_ago }}
                            </span>
                        {% endif %}
                    </div>
                    <div class="nyt-article-summary">
                        {% if news.summary != '' %}
                            {{ news.summary|raw|striptags|length > 140 ? news.summary|raw|striptags|slice(0, 137) ~ '...' : news.summary|raw|striptags }}
                        {% else %}
                            {{ news.name }}
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>
{% endif %}
