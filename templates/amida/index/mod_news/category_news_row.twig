{% if news_items is not empty %}
    <section class="nyt-news-section">
        <div class="row g-4">
            {% for news in news_items %}
                <article class="col-12 nyt-article" itemscope itemtype="https://schema.org/NewsArticle">
                    <div class="nyt-article-media">
                        {% if news.image is not empty %}
                            <div class="nyt-article-img-wrapper">
                                <a href="{{ site.saddress }}news/{{ news.seo }}" title="{{ news.name }}" itemprop="url">
                                    <picture>
                                        <source srcset="{{ site.iaddress }}mod_news/thumb/{{ news.image }}" media="(max-width: 768px)" sizes="(max-width: 768px) calc(100vw - 32px), 380px">
                                        <img src="{{ site.iaddress }}mod_news/thumb/{{ news.image }}"
                                             class="nyt-article-img"
                                             alt="{{ news.name }}"
                                             width="640"
                                             height="360"
                                             sizes="(max-width: 768px) calc(100vw - 32px), 380px"
                                             loading="lazy"
                                             decoding="async"
                                             itemprop="image">
                                    </picture>
                                </a>
                                {% if news.has_video or news.has_gallery %}
                                    <div class="latest-news-type-badges">
                                        {% if news.has_video %}
                                            <span class="latest-news-type-badge latest-news-type-badge-video" title="{{ lang.index.mod_video_embed.1 }}" aria-label="{{ lang.index.mod_video_embed.1 }}">
                                                <i class="bi bi-camera-video-fill" aria-hidden="true"></i>
                                            </span>
                                        {% endif %}
                                        {% if news.has_gallery %}
                                            <span class="latest-news-type-badge latest-news-type-badge-gallery" title="{{ lang.index.search.gallery }}" aria-label="{{ lang.index.search.gallery }}">
                                                <i class="bi bi-images" aria-hidden="true"></i>
                                            </span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="nyt-article-placeholder">
                                <a href="{{ site.saddress }}news/{{ news.seo }}" title="{{ news.name }}" itemprop="url" class="nyt-article-placeholder-link">
                                    <i class="bi bi-newspaper" aria-hidden="true"></i>
                                </a>
                            </div>
                        {% endif %}
                    </div>

                    <h3 class="nyt-article-title" itemprop="headline">
                        <a href="{{ site.saddress }}news/{{ news.seo }}" itemprop="url">{{ news.name|raw }}</a>
                    </h3>
                    
                    {# Reading Time Calculation #}
                    {% set clean_summary = (news.summary != '' ? news.summary : news.name)|striptags %}
                    {% set words = clean_summary|split(' ')|length %}
                    {% set reading_minutes = (words / 180)|round(0, 'ceil') %}
                    {% if reading_minutes < 1 %}{% set reading_minutes = 1 %}{% endif %}
                    
                    <div class="nyt-article-meta">
                        <span class="nyt-article-meta-item nyt-article-date">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            <time datetime="{{ news.created_at }}" itemprop="datePublished">{{ news.created_at|date('d.m.Y') }}</time>
                        </span>
                        <span class="nyt-article-meta-sep" aria-hidden="true">·</span>
                        <span class="nyt-article-meta-item nyt-article-reading-time">
                            <i class="bi bi-book" aria-hidden="true"></i>
                            <span>{{ reading_minutes }} {{ lang.index.minute }}</span>
                        </span>
                        {% if news.published_ago is defined and news.published_ago is not empty %}
                            <span class="nyt-article-meta-sep" aria-hidden="true">·</span>
                            <span class="nyt-article-meta-item nyt-article-timeago">
                                <i class="bi bi-clock-history" aria-hidden="true"></i>
                                <span>{{ news.published_ago }}</span>
                            </span>
                        {% endif %}
                    </div>
                    <p class="nyt-article-summary" itemprop="description">
                        {{ clean_summary|length > 160 ? clean_summary|slice(0, 157) ~ '...' : clean_summary }}
                    </p>
                </article>
            {% endfor %}
        </div>
    </section>
{% endif %}
