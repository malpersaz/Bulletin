{{ run({"mod": "index", "method": "_latest_news", "extra": ["6", "id,image,name,seo,keywords,summary,created_at"]}) }}
{% set latest_news = ctx_get('latest_news') %}

<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/latest-news.css?v={{ "now"|date("U") }}">

{% if latest_news is not empty %}
    <section class="latest-news-section" aria-labelledby="latest-news-heading">
        <header class="latest-news-header">
            <div class="latest-news-heading-wrap">
                <h2 id="latest-news-heading" class="latest-news-title">
                    <a href="{{ site.saddress }}newses" class="latest-news-title-link">
                        <i class="bi bi-newspaper" aria-hidden="true"></i>
                        <span>{{ lang.index.latest_news.1 ?? 'Nûçe' }}</span>
                    </a>
                </h2>
            </div>
            <a href="{{ site.saddress }}newses" class="latest-news-view-all">
                <span>{{ lang.index.latest_news.2 ?? 'Hemûyan Bibîne' }}</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </header>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for news in latest_news %}
                <article class="col">
                    <div class="latest-news-card">
                        <a href="{{ site.saddress }}news/{{ news.seo }}"
                           class="latest-news-media"
                           title="{{ news.name }}">
                            {% if news.image is not empty %}
                                <img src="{{ site.iaddress }}mod_news/{{ news.image }}"
                                     class="latest-news-img"
                                     alt="{{ news.name }}"
                                     loading="lazy">
                            {% else %}
                                <div class="latest-news-placeholder">
                                    <i class="bi bi-newspaper latest-news-placeholder-icon" aria-hidden="true"></i>
                                </div>
                            {% endif %}

                            {% if news.published_ago is defined and news.published_ago is not empty %}
                                <span class="latest-news-timeago">
                                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                                    <span>{{ news.published_ago }}</span>
                                </span>
                            {% endif %}
                        </a>

                        <div class="latest-news-body">
                            <div class="latest-news-meta">
                                {% if news.created_at is defined and news.created_at is not empty %}
                                    <span class="latest-news-meta-item">
                                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                                        <time datetime="{{ news.created_at }}">{{ news.created_at|date('d.m.Y') }}</time>
                                    </span>
                                {% endif %}

                                {% set words = news.summary|striptags|split(' ')|length %}
                                {% set reading_minutes = (words / 200)|round(0, 'ceil') %}
                                {% if reading_minutes < 1 %}{% set reading_minutes = 1 %}{% endif %}
                                <span class="latest-news-meta-item">
                                    <i class="bi bi-book" aria-hidden="true"></i>
                                    <span>{{ reading_minutes }} deqe</span>
                                </span>
                            </div>

                            <h3 class="latest-news-article-title">
                                <a href="{{ site.saddress }}news/{{ news.seo }}">
                                    {{ news.name }}
                                </a>
                            </h3>

                            {% set clean_summary = (news.summary != '' ? news.summary : news.name)|striptags %}
                            <p class="latest-news-summary">
                                {{ clean_summary|length > 180 ? clean_summary|slice(0, 177) ~ '...' : clean_summary }}
                            </p>

                            <div class="latest-news-footer">
                                <a href="{{ site.saddress }}news/{{ news.seo }}"
                                   class="latest-news-read-link"
                                   aria-label="{{ news.name }}">
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>

        <footer class="latest-news-mobile-footer text-center d-md-none">
            <a href="{{ site.saddress }}newses" class="btn latest-news-mobile-btn w-100">
                <span>{{ lang.index.latest_news.2 ?? 'Hemûyan Bibîne' }}</span>
                <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
            </a>
        </footer>
    </section>
{% else %}
    <section class="latest-news-section" aria-labelledby="latest-news-heading">
        <header class="latest-news-header">
            <div class="latest-news-heading-wrap">
                <h2 id="latest-news-heading" class="latest-news-title">
                    <span class="latest-news-title-link">
                        <i class="bi bi-newspaper" aria-hidden="true"></i>
                        <span>{{ lang.index.latest_news.1 ?? 'Nûçe' }}</span>
                    </span>
                </h2>
            </div>
        </header>
        <div class="latest-news-empty">
            <i class="bi bi-newspaper latest-news-empty-icon" aria-hidden="true"></i>
            <p class="latest-news-empty-text">
                {{ lang.index.latest_news.3 ?? 'Hêj tu nûçeya weşandî tune.' }}
            </p>
        </div>
    </section>
{% endif %}
