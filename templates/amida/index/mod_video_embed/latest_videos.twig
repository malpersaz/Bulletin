{% set video_count = limit|default(3) %}
{{ run({"mod": "index", "method": "_latest_videos", "extra": [video_count, "id,image,name,content,keywords,duration,created_at"]}) }}
{% set latest_videos = ctx_get('latest_videos') %}

<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/latest-videos.css?v={{ site.version|default('1.1.25') }}">

{% if latest_videos is not empty %}
    <section class="latest-videos-section" aria-labelledby="latest-videos-heading">
        <header class="latest-videos-header">
            <div class="latest-videos-heading-wrap">
                <h2 id="latest-videos-heading" class="latest-videos-title">
                    <a href="{{ site.saddress }}videos" class="latest-videos-title-link">
                        <span class="latest-videos-badge" aria-hidden="true">
                            <i class="bi bi-play-fill"></i>
                        </span>
                        <span>{{ lang.index.mod_video_embed.latest_videos.title ?? (lang.index.mod_video_embed.latest_videos.1 ?? 'Vîdyo') }}</span>
                    </a>
                </h2>
            </div>
            <a href="{{ site.saddress }}videos" class="latest-videos-view-all">
                <span>{{ lang.index.mod_video_embed.latest_videos.all_items ?? (lang.index.mod_video_embed.latest_videos.2 ?? 'Hemû Vîdyo') }}</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </header>

        <div class="latest-videos-grid">
            {% for video in latest_videos %}
                <article class="latest-video-card">
                    <a href="{{ site.saddress }}video/{{ video.id }}-{{ video.name|legacy_seo }}"
                       class="latest-video-card-link"
                       title="{{ video.name }}">
                        <div class="latest-video-media">
                            {% if video.image is not empty %}
                                <img src="{{ site.iaddress }}mod_video_embed/thumb/{{ video.image }}"
                                     class="latest-video-img"
                                     alt="{{ video.name }}"
                                     width="480"
                                     height="270"
                                     loading="lazy"
                                     decoding="async">
                            {% else %}
                                <div class="latest-video-placeholder">
                                    <i class="bi bi-play-circle-fill latest-video-placeholder-icon" aria-hidden="true"></i>
                                </div>
                            {% endif %}

                            <div class="latest-video-overlay-gradient"></div>

                            <span class="latest-video-play-overlay" aria-hidden="true">
                                <i class="bi bi-play-fill"></i>
                            </span>

                            {% if video.duration is defined and video.duration is not empty %}
                                <span class="latest-video-duration">
                                    <i class="bi bi-clock-fill" aria-hidden="true"></i>
                                    <span>{{ video.duration }}</span>
                                </span>
                            {% endif %}
                        </div>

                        <div class="latest-video-body">
                            {% if video.created_at is defined and video.created_at is not empty %}
                                <div class="latest-video-meta">
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    <time datetime="{{ video.created_at }}">{{ video.created_at|date('d.m.Y') }}</time>
                                </div>
                            {% endif %}

                            <h3 class="latest-video-card-title">
                                {{ video.name }}
                            </h3>
                        </div>
                    </a>
                </article>
            {% endfor %}
        </div>
    </section>
{% else %}
    <section class="latest-videos-section" aria-labelledby="latest-videos-heading">
        <header class="latest-videos-header">
            <div class="latest-videos-heading-wrap">
                <h2 id="latest-videos-heading" class="latest-videos-title">
                    <span class="latest-videos-title-link">
                        <span class="latest-videos-badge" aria-hidden="true">
                            <i class="bi bi-play-fill"></i>
                        </span>
                        <span>{{ lang.index.mod_video_embed.latest_videos.title ?? (lang.index.mod_video_embed.latest_videos.1 ?? 'Vîdyo') }}</span>
                    </span>
                </h2>
            </div>
        </header>
        <div class="latest-video-empty">
            <i class="bi bi-camera-video-off latest-video-empty-icon" aria-hidden="true"></i>
            <p class="latest-video-empty-text">
                {{ lang.index.mod_video_embed.latest_videos.no_items_found ?? (lang.index.mod_video_embed.4 ?? 'Vîdyo nehat dîtin') }}
            </p>
        </div>
    </section>
{% endif %}
