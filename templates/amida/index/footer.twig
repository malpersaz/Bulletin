<footer class="site-footer mt-auto py-5">
	<div class="container">
		<div class="row gy-4">
			<!-- Site Information -->
			<div class="col-md-5 col-lg-4">
				{% set footer_svg_logo = 'static/mod_settings/logo.svg' %}
				<a class="footer-brand d-inline-flex align-items-center mb-3" href="{{ site.saddress }}" title="{{ site.title }}" aria-label="{{ site.title }}">
					<img src="{{ site.address }}{{ footer_svg_logo }}" alt="{{ site.title }}" width="175" height="42" class="footer-logo-svg d-inline-block">
				</a>
				<p class="mb-0 opacity-75">{{ site.description }}</p>
                <div class="mt-4 d-flex flex-wrap gap-3 feeds-area">
                    <a href="{{ site.address }}{{ site.lang }}/rss.xml" class="text-decoration-none transition-link d-flex align-items-center gap-2 small opacity-75" target="_blank" rel="noopener noreferrer" title="{{ lang.index.rss_feed }}" aria-label="{{ lang.index.rss_feed }}">
                        <i class="bi bi-rss-fill text-warning"></i> RSS
                    </a>
                    <a href="{{ site.address }}sitemap.xml" class="text-decoration-none transition-link d-flex align-items-center gap-2 small opacity-75" target="_blank" rel="noopener noreferrer" title="{{ lang.index.sitemap }}" aria-label="{{ lang.index.sitemap }}">
                        <i class="bi bi-diagram-3-fill text-info"></i> {{ lang.index.sitemap }}
                    </a>
                    <a href="{{ site.saddress }}llms.txt" class="text-decoration-none transition-link d-flex align-items-center gap-2 small opacity-75" target="_blank" rel="noopener noreferrer" title="{{ lang.index.llms_index }}" aria-label="{{ lang.index.llms_index }}">
                        <i class="bi bi-cpu text-primary"></i> llms.txt
                    </a>
                </div>
			</div>
            
            <div class="col-md-1 col-lg-2 d-none d-md-block">
                <!-- Spacer -->
            </div>

			<!-- Contact & Social Information -->
			<div class="col-md-6 col-lg-6">
                <div class="card contact-card border-0 shadow-sm overflow-hidden rounded-3 h-100">
                    <div class="card-body p-4">
                        <!-- Section: Contact Us -->
                        <div class="mb-4">
                            <h3 class="h5 fw-bold mb-3 d-flex align-items-center">
                                <i class="bi bi-headset me-2 text-primary"></i>
                                {{ lang.index.contact_us }}
                            </h3>
                            <ul class="list-unstyled mb-0 ps-1">
                                <!-- Phone Number -->
                                {% if site.phone is defined and site.phone is not empty and site.phone != '' %}
                                    <li class="mb-3 d-flex align-items-center">
                                        <div class="footer-icon-box me-3 shadow-sm rounded-circle">
                                            <i class="bi bi-phone text-primary"></i>
                                        </div>
                                        <a href="tel:{{ site.phone }}" class="fs-6 fw-medium text-decoration-none transition-link">
                                            {{ site.phone }}
                                        </a>
                                    </li>
                                {% endif %}

                                <!-- WhatsApp Contact -->
                                {% if site.whatsapp is not empty %}
                                    <li class="mb-3 d-flex align-items-center">
                                        <div class="footer-icon-box me-3 shadow-sm rounded-circle">
                                            <i class="bi bi-whatsapp text-success"></i>
                                        </div>
                                        <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" class="text-decoration-none transition-link">
                                            WhatsApp: {{ site.whatsapp }}
                                        </a>
                                    </li>
                                {% endif %}

                                <!-- Email Contact -->
                                {% if site.mail is not empty %}
                                    <li class="mb-3 d-flex align-items-center">
                                        <div class="footer-icon-box me-3 shadow-sm rounded-circle">
                                            <i class="bi bi-envelope text-info"></i>
                                        </div>
                                        <a href="mailto:{{ site.mail }}" class="text-decoration-none transition-link">
                                            {{ site.mail }}
                                        </a>
                                    </li>
                                {% endif %}

                                <!-- Office Address -->
                                {% if site.office_address is not empty %}
                                    <li class="mb-3 d-flex align-items-start">
                                        <div class="footer-icon-box me-3 shadow-sm rounded-circle mt-1">
                                            <i class="bi bi-building text-warning"></i>
                                        </div>
                                        <span class="opacity-75">{{ site.office_address|raw }}</span>
                                    </li>
                                {% endif %}

                                <!-- Business Address -->
                                {% if site.work_address is not empty %}
                                    <li class="mb-0 d-flex align-items-start">
                                        <div class="footer-icon-box me-3 shadow-sm rounded-circle mt-1">
                                            <i class="bi bi-geo-alt-fill text-danger"></i>
                                        </div>
                                        <span class="opacity-75">{{ site.work_address|raw }}</span>
                                    </li>
                                {% endif %}
                            </ul>
                        </div>

                        <!-- Section: Follow Us -->
                        {% if site.social_links is not empty %}
                            <div class="pt-4 border-top">
                                <h3 class="h5 fw-bold mb-3 d-flex align-items-center">
                                    <i class="bi bi-share me-2 text-primary"></i>
                                    {{ lang.index.follow_us }}
                                </h3>
                                <div class="d-flex gap-2 ps-1">
                                    {% for link in site.social_links %}
                                        {% if link.url|trim is not empty %}
                                            <a href="{{ link.url }}" class="btn btn-light btn-sm rounded-circle social-icon-btn shadow-sm" target="_blank" title="{{ link.platform|capitalize }}">
                                                <i class="{{ link.icon_class }}"></i>
                                            </a>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
			</div>
		</div>

		<!-- Google Maps Section -->
		{% if site.map_embed_code is not empty %}
			<div class="row mt-4">
				<div class="col-12">
                    <div class="card map-card border-0 shadow-sm overflow-hidden rounded-3">
                        <div class="card-body p-4">
                            <h3 class="h5 fw-bold mb-3 d-flex align-items-center">
                                <i class="bi bi-map-fill me-2 text-primary"></i>
                                {{ lang.index.find_us }}
                            </h3>
                            <div class="map-container map-embed-wrapper rounded border shadow-sm">
                                {{ site.map_embed_code|raw }}
                            </div>
                        </div>
                    </div>
				</div>
			</div>
		{% endif %}

		<!-- Legal & Policy Links -->
		<div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 gap-md-3 pt-4 mt-4 border-top footer-policies-area small opacity-75">
			<a href="{{ site.saddress }}legal" class="text-decoration-none transition-link">
				{{ lang.index.legal_nav_masthead }}
			</a>
			<span class="opacity-25 d-none d-sm-inline">&bull;</span>
			<a href="{{ site.saddress }}editorial-policy" class="text-decoration-none transition-link">
				{{ lang.index.legal_nav_editorial }}
			</a>
			<span class="opacity-25 d-none d-sm-inline">&bull;</span>
			<a href="{{ site.saddress }}privacy-policy" class="text-decoration-none transition-link">
				{{ lang.index.legal_nav_privacy }}
			</a>
			<span class="opacity-25 d-none d-sm-inline">&bull;</span>
			<a href="{{ site.saddress }}cookie-policy" class="text-decoration-none transition-link">
				{{ lang.index.legal_nav_cookies }}
			</a>
			<span class="opacity-25 d-none d-sm-inline">&bull;</span>
			<a href="{{ site.saddress }}terms-of-service" class="text-decoration-none transition-link">
				{{ lang.index.legal_nav_terms }}
			</a>
			<span class="opacity-25 d-none d-sm-inline">&bull;</span>
			<a href="{{ site.saddress }}accessibility" class="text-decoration-none transition-link">
				{{ lang.index.legal_nav_accessibility }}
			</a>
			<span class="opacity-25 d-none d-sm-inline">&bull;</span>
			<a href="{{ site.saddress }}security-policy" class="text-decoration-none transition-link">
				{{ lang.index.legal_nav_security }}
			</a>
			<span class="opacity-25 d-none d-sm-inline">&bull;</span>
			<a href="{{ site.saddress }}compliance" class="text-decoration-none transition-link">
				{{ lang.index.legal_nav_compliance }}
			</a>
			<span class="opacity-25 d-none d-sm-inline">&bull;</span>
			<a href="{{ site.saddress }}contact" class="text-decoration-none transition-link">
				{{ lang.index.contact_us }}
			</a>
		</div>

		<!-- Copyright -->
		<div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-4 mt-5 border-top copyright-section small">
			<p class="mb-2 mb-md-0">
                &copy; {{ site.established_year }} - {{ "now"|date("Y") }} 
                <strong>{{ site.owner_name }}</strong>. 
                {{ lang.index.copyright }}
            </p>
			<div class="text-md-end text-secondary">
                {% if site.build is defined and site.build %}
                    <span class="me-2 footer-version-text">{{ site.build }}</span>
                {% endif %}
                {% if site.version is defined and site.version %}
                    <span class="ms-1 footer-version-text">v{{ site.version }}</span>
                {% endif %}
			</div>
		</div>
	</div>
</footer>

