{% extends "layouts/base.twig" %}

{% block title %}
	<title>{{ title|default('Error') }} - {{ site.name }}</title>
{% endblock %}

{% block meta_tags %}
	<meta name="robots" content="noindex, follow">
{% endblock %}

{% block css_custom %}
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/error.css?v={{ "now"|date("U") }}">
{% endblock %}

{% block content %}
<!-- START: index/error.twig -->
<div class="row justify-content-center align-items-center my-5 py-4">
    <div class="col-md-8 text-center">
        <div class="error-container p-5 rounded-4 shadow-sm border border-light-subtle bg-body-tertiary">
            <div class="error-icon-wrapper mb-4">
                <i class="bi bi-exclamation-octagon text-danger display-1 animate-pulse"></i>
            </div>
            
            <h1 class="display-5 fw-bold text-body-emphasis mb-3">{{ title }}</h1>
            
            <p class="lead text-secondary mb-4 fs-5">
                {{ message|default(mesaj)|raw }}
            </p>
            
            <hr class="my-4 mx-auto w-25 border-secondary-subtle">
            
            <div class="d-flex justify-content-center gap-3 mt-4">
                <a href="{{ site.saddress }}" class="btn btn-primary btn-lg px-4 rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-house-door-fill"></i>
                    {{ lang.index.home }}
                </a>
                <button type="button" data-action="back" class="btn btn-outline-secondary btn-lg px-4 rounded-pill d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i>
                    {{ lang.index.modal.back|default('Back') }}
                </button>
            </div>
        </div>
    </div>
</div>
<!-- END: index/error.twig -->
{% endblock %}
