{% extends "layouts/base.twig" %}

{% set authors = ctx_get('authors') %}
{% set pagination = ctx_get('pagination') %}
{% set page = ctx_get('page') %}
{% set authors_url = site.saddress ~ 'authors' ~ ((page is not empty and page > 1) ? '/' ~ page : '') %}
{% set authors_description = '' %}
{% if d is defined and d.description is defined and d.description is not empty %}
    {% set authors_description = d.description|striptags|trim %}
{% endif %}
{% if authors_description == '' %}
    {% set authors_description = site.description %}
{% endif %}
{% set authors_share_image = site.iaddress ~ 'mod_settings/logo.png' %}
{% if authors is not empty %}
    {% for author in authors %}
        {% if authors_share_image == site.iaddress ~ 'mod_settings/logo.png' and author.user_image is defined and author.user_image is not empty %}
            {% set authors_share_image = site.iaddress ~ 'mod_user/' ~ author.user_image %}
        {% endif %}
        {% if authors_share_image == site.iaddress ~ 'mod_settings/logo.png' and author.image is defined and author.image is not empty %}
            {% set authors_share_image = site.iaddress ~ 'mod_publication/' ~ author.image %}
        {% endif %}
    {% endfor %}
{% endif %}

{% block canonical %}
    <link rel="canonical" href="{{ site.saddress }}authors{% if page is not empty and page > 1 %}/{{ page }}{% endif %}" />
{% endblock %}

{% block title %}
    <title>{{ lang.index.mod_publication.authors }} - {{ site.title }}</title>
{% endblock %}

{% block meta_tags %}
    <meta name="author" content="{{ site.title }}">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#ffffff">

    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ authors_url }}">
    <meta property="og:title" content="{{ lang.index.mod_publication.authors }} - {{ site.title }}">
    <meta property="og:description" content="{{ authors_description }}">
    <meta property="og:image" content="{{ authors_share_image }}">
    <meta property="og:image:secure_url" content="{{ authors_share_image }}">
    <meta property="og:site_name" content="{{ site.title }}">
    {% set og_locale = site.lang ~ '_SE' %}
    {% if site.lang == 'en' %}{% set og_locale = 'en_US' %}
    {% elseif site.lang == 'tr' %}{% set og_locale = 'tr_TR' %}
    {% elseif site.lang == 'de' %}{% set og_locale = 'de_DE' %}
    {% endif %}
    <meta property="og:locale" content="{{ og_locale }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ authors_url }}">
    <meta name="twitter:title" content="{{ lang.index.mod_publication.authors }} - {{ site.title }}">
    <meta name="twitter:description" content="{{ authors_description }}">
    <meta name="twitter:image" content="{{ authors_share_image }}">
{% endblock %}

{% block css_custom %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/authors.css?v={{ "now"|date("U") }}">
{% endblock %}


{% block content %}
<section id="publication-authors-page">
    <div class="container authors-shell">
        <div class="authors-header">
            <ol class="authors-breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
                <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a itemprop="item" href="{{ site.saddress }}"><span itemprop="name">{{ lang.index.home }}</span></a>
                    <meta itemprop="position" content="1" />
                </li>
                <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <span itemprop="name">{{ lang.index.mod_publication.authors }}</span>
                    <meta itemprop="position" content="2" />
                </li>
            </ol>

        </div>

        {% if authors is not empty %}
            <div class="authors-grid">
                {% for author in authors %}
                    {% set author_name = (author.u_name ~ ' ' ~ author.u_last_name)|trim %}
                    {% set author_initials = (author.u_name|slice(0, 1) ~ author.u_last_name|slice(0, 1))|upper %}
                    <article class="author-card" itemscope itemtype="https://schema.org/Person">
                        <div class="author-head">
                            <div class="author-avatar">
                                {% if author.user_image is defined and author.user_image is not empty %}
                                    <img src="{{ site.iaddress }}mod_user/thumb/{{ author.user_image }}" alt="{{ author_name }}" loading="lazy">
                                {% else %}
                                    <span>{{ author_initials }}</span>
                                {% endif %}
                            </div>
                            <div class="author-ident">
                                <h2 class="author-name" itemprop="name">
                                    <a href="{{ site.saddress }}author/{{ author.username }}">{{ author_name }}</a>
                                </h2>
                                <div class="author-handle">@{{ author.username }}</div>
                            </div>
                        </div>

                        <div class="author-featured">
                            {% if author.image is not empty %}
                                <img src="{{ site.iaddress }}mod_publication/{{ author.image }}" alt="{{ author.name }}" loading="lazy">
                            {% else %}
                                <img src="{{ site.iaddress }}mod_settings/logo.png" alt="{{ author.name }}" loading="lazy" class="object-fit-contain p-4">
                            {% endif %}

                            <div class="author-publication">
                                <span class="author-publication-label">
                                    <i class="bi bi-journal-richtext"></i>
                                    {{ lang.index.mod_publication.authors_latest_label }}
                                </span>
                                <h3 class="author-publication-title">
                                    <a href="{{ site.saddress }}publication/{{ author.seo }}">{{ author.name }}</a>
                                </h3>
                            </div>
                        </div>

                        <span class="author-date">
                            <i class="bi bi-clock-history"></i>
                            {{ author.created_at|date('d.m.Y H:i') }}
                        </span>
                    </article>
                {% endfor %}
            </div>

            {% if pagination is not empty %}
                <div class="pagination-wrap">
                    <nav aria-label="{{ lang.index.mod_publication.authors }}">
                        <ul class="pagination justify-content-center">
                            {% for s in pagination %}
                                {% if s == '...' %}
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                {% elseif s == page %}
                                    <li class="page-item active" aria-current="page">
                                        <span class="page-link">{{ s }}</span>
                                    </li>
                                {% elseif s == 1 %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ site.saddress }}authors">{{ s }}</a>
                                    </li>
                                {% else %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ site.saddress }}authors/{{ s }}">{{ s }}</a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </nav>
                </div>
            {% endif %}
        {% else %}
            <div class="authors-empty">
                <h2>{{ lang.index.mod_publication.authors }}</h2>
                <p>{{ lang.index.mod_publication.authors_empty_desc }}</p>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
