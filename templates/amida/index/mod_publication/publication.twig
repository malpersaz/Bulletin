{% extends "layouts/base.twig" %}
{% import "macros/faq.twig" as faq %}

{% block css_custom %}
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/detail-foundation.css?v={{ "now"|date("U") }}">
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/publication.css?v={{ "now"|date("U") }}">
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/gallery.css?v={{ "now"|date("U") }}">
{% endblock %}

{% set d = ctx_get('detail') ?: ctx_get('d') %}
{% set gallery = ctx_get('gallery') ?: ctx_get('res') %}
{% set files = ctx_get('files') ?: ctx_get('file') %}
{% set video = ctx_get('video') %}
{% set faqs = ctx_get('faqs') ?: ctx_get('faq') %}
{% set faq_lang = ctx_get('faq_lang') %}

{% set publication_logo_asset = site.logo_path is defined and site.logo_path is not empty ? site.iaddress ~ 'mod_settings/' ~ site.logo_path : (site.iaddress ~ 'mod_settings/logo.png') %}
{% if d.image is defined and d.image is not empty %}
    {% set publication_share_image = site.iaddress ~ 'mod_publication/' ~ d.image %}
{% elseif d.user_image is defined and d.user_image is not empty %}
    {% set publication_share_image = site.iaddress ~ 'mod_user/' ~ d.user_image %}
{% else %}
    {% set publication_share_image = publication_logo_asset %}
{% endif %}
{% set publication_share_ext = publication_share_image|split('?')|first|split('.')|last|lower %}
{% set publication_share_mime = publication_share_ext == 'png' ? 'image/png' : (publication_share_ext == 'webp' ? 'image/webp' : (publication_share_ext == 'gif' ? 'image/gif' : 'image/jpeg')) %}

{% block canonical %}
    <link rel="canonical" href="{{ site.saddress }}publication/{{ d.seo }}"/>
{% endblock %}

{% block title %}
    <title>{{ d.title|default(d.name) }} - {{ site.title }}</title>
{% endblock %}

{% block description %}
    <meta name="description" content="{{ d.description }}">
{% endblock %}

{% block keywords %}
    <meta name="keywords" content="{{ d.keywords }}">
{% endblock %}

{% block meta_tags %}
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ site.saddress }}publication/{{ d.seo }}">
    <meta property="og:title" content="{{ d.title|default(d.name) }}">
    <meta property="og:description" content="{{ d.description|striptags|slice(0, 200) }}">
    {% if publication_share_image is not empty %}
        <meta property="og:image" content="{{ publication_share_image }}">
        <meta property="og:image:secure_url" content="{{ publication_share_image }}">
        <meta property="og:image:type" content="{{ publication_share_mime }}">
        {% if d.image is defined and d.image is not empty %}
            <meta property="og:image:width" content="1200">
            <meta property="og:image:height" content="630">
        {% endif %}
        <link rel="image_src" href="{{ publication_share_image }}">
    {% endif %}
    <meta property="og:site_name" content="{{ site.title }}">
    {% set og_locale = site.lang %}
    {% if site.lang == 'en' %}{% set og_locale = 'en_US' %}
    {% elseif site.lang == 'tr' %}{% set og_locale = 'tr_TR' %}
    {% elseif site.lang == 'de' %}{% set og_locale = 'de_DE' %}
    {% elseif site.lang == 'ku' %}{% set og_locale = 'ku' %}
    {% elseif site.lang == 'ckb' %}{% set og_locale = 'ckb' %}
    {% elseif site.lang == 'zza' %}{% set og_locale = 'zza' %}
    {% endif %}
    <meta property="og:locale" content="{{ og_locale }}">
    <meta property="article:published_time" content="{{ d.created_at|date('c') }}">
    <meta property="article:modified_time" content="{{ d.updated_at|default(d.created_at)|date('c') }}">
    {% if d.category_name is defined and d.category_name is not empty %}
        <meta property="article:section" content="{{ d.category_name }}">
    {% endif %}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ site.saddress }}publication/{{ d.seo }}">
    <meta name="twitter:title" content="{{ d.title|default(d.name) }}">
    <meta name="twitter:description" content="{{ d.description|striptags|slice(0, 200) }}">
    {% if publication_share_image is not empty %}
        <meta name="twitter:image" content="{{ publication_share_image }}">
    {% endif %}
{% endblock %}

{% block schema %}
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Article",
          "headline": {{ d.name|json_encode|raw }},
          "image": {{ publication_share_image|json_encode|raw }},
          "author": {
            "@type": "Person",
            "name": {{ (d.u_name|default('') ~ ' ' ~ d.u_last_name|default(''))|trim|json_encode|raw }}{% if d.user_image is defined and d.user_image is not empty %},
            "image": {{ (site.iaddress ~ 'mod_user/' ~ d.user_image)|json_encode|raw }}{% endif %}
          },
          "publisher": {
            "@type": "Organization",
            "name": {{ site.title|json_encode|raw }},
            "logo": {
              "@type": "ImageObject",
              "url": {{ publication_logo_asset|default(site.iaddress ~ 'mod_settings/logo.png')|json_encode|raw }}
            }
          },
          "datePublished": "{{ d.created_at ? d.created_at|date('Y-m-d') : "now"|date('Y-m-d') }}",
          "dateModified": "{{ (d.updated_at ?: d.created_at)|date('Y-m-d') }}",
          "description": {{ (d.summary ?: (d.description ?: site.description))|striptags|slice(0, 200)|json_encode|raw }}
        }
    </script>
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": {{ lang.index.home|json_encode|raw }},
              "item": {{ site.saddress|json_encode|raw }}
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ lang.index.mod_publication.all_publications|json_encode|raw }},
              "item": {{ (site.saddress ~ 'publications')|json_encode|raw }}
            }{% if d.category_name is defined and d.category_name is not empty %},
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ d.category_name|json_encode|raw }},
              "item": {{ (site.saddress ~ 'publications/' ~ d.category_seo)|json_encode|raw }}
            }{% endif %},
            {
              "@type": "ListItem",
              "position": {{ (d.category_name is defined and d.category_name is not empty) ? 4 : 3 }},
              "name": {{ d.name|json_encode|raw }}
            }
          ]
        }
    </script>
    {{ faq.schema(faqs) }}
{% endblock %}

{% block content %}
    <div class="row justify-content-center detail-shell detail-shell-publication" id="mod_publication_detail">
        <div class="col-lg-8">
            <article class="detail-card">
                <div class="detail-breadcrumb-wrap">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0" itemscope itemtype="https://schema.org/BreadcrumbList">
                            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <a itemprop="item" href="{{ site.saddress }}">
                                    <span itemprop="name">{{ lang.index.home }}</span>
                                </a>
                                <meta itemprop="position" content="1"/>
                            </li>
                            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <a itemprop="item" href="{{ site.saddress }}publications">
                                    <span itemprop="name">{{ lang.index.mod_publication.all_publications }}</span>
                                </a>
                                <meta itemprop="position" content="2"/>
                            </li>
                            {% if d.category_name is defined and d.category_name is not empty %}
                                <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                    <a itemprop="item" href="{{ site.saddress }}publications/{{ d.category_seo }}">
                                        <span itemprop="name">{{ d.category_name }}</span>
                                    </a>
                                    <meta itemprop="position" content="3"/>
                                </li>
                            {% endif %}
                            <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <span itemprop="name">{{ d.name }}</span>
                                <meta itemprop="position" content="{% if d.category_name is defined and d.category_name is not empty %}4{% else %}3{% endif %}"/>
                            </li>
                        </ol>
                    </nav>
                </div>

                <div class="detail-content position-relative">
                    {% include 'partials/share.twig' with {
                        'share_wrap_class': 'share-sticky-sidebar d-none d-lg-block',
                        'share_url_path': 'publication'
                    } %}
                    <div class="detail-eyebrow-row">
                        {% if d.category_name is defined and d.category_name is not empty %}
                            <a href="{{ site.saddress }}publications/{{ d.category_seo }}" class="detail-chip">
                                {{ d.category_name }}
                            </a>
                        {% endif %}
                        {% set readingTime = (d.content|striptags|length / 1100)|round(0, 'ceil') %}
                        <span class="detail-chip detail-chip-muted">
                            <i class="bi bi-clock"></i>{{ readingTime }} {{ lang.index.min_read }}
                        </span>
                    </div>

                    <h1 class="detail-title">{{ d.name }}</h1>

                    <div class="detail-meta-bar">
                        <div class="d-flex align-items-center gap-3">
                            {% if d.username is defined and d.username is not empty %}
                                <a href="{{ site.saddress }}author/{{ d.username }}" class="text-decoration-none">
                            {% endif %}
                            {% if d.user_image is defined and d.user_image is not empty %}
                                <img src="{{ site.iaddress }}mod_user/thumb/{{ d.user_image }}"
                                     alt="{{ d.u_name }} {{ d.u_last_name }}"
                                     class="rounded-circle shadow-sm object-fit-cover"
                                     width="56"
                                     height="56">
                            {% else %}
                                <div class="rounded-circle d-flex align-items-center justify-content-center bg-dark text-white shadow-sm w-56 h-56 fw-bold">
                                    {{ (d.u_name|default('')|slice(0, 1) ~ d.u_last_name|default('')|slice(0, 1))|upper }}
                                </div>
                            {% endif %}
                            {% if d.username is defined and d.username is not empty %}
                                </a>
                            {% endif %}
                            <div class="detail-meta-copy">
                                {% if d.username is defined and d.username is not empty %}
                                    <div class="fw-semibold text-dark">
                                        <a href="{{ site.saddress }}author/{{ d.username }}" class="text-decoration-none text-dark">
                                            {{ d.u_name }} {{ d.u_last_name }}
                                        </a>
                                    </div>
                                {% else %}
                                    <div class="fw-semibold text-dark">{{ d.u_name }} {{ d.u_last_name }}</div>
                                {% endif %}
                                <div>
                                    <i class="bi bi-calendar3 me-1"></i>
                                    <time datetime="{{ d.created_at|date('Y-m-d') }}">{{ d.created_at|date('d.m.Y') }}</time>
                                    {% if d.updated_at is not empty and d.updated_at != d.created_at %}
                                        <span class="ms-2">
                                            <i class="bi bi-pencil-square me-1"></i>{{ d.updated_at|date('d.m.Y') }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="detail-tools">
                            <a href="{{ site.saddress }}tools/saveText/mod_publication/{{ d.id }}" rel="nofollow noindex" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" title="{{ lang.index.mod_gallery.save_txt }}">
                                <i class="bi bi-file-text"></i>
                            </a>
                            {% if files %}
                                {% for file_item in files %}
                                    <a href="{{ site.saddress }}tools/saveFile/mod_publication/{{ d.id }}/{{ file_item.id }}" rel="nofollow noindex" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" title="{{ lang.index.mod_attachment.file }}: {{ file_item.original_name }}">
                                        <i class="bi bi-download"></i>
                                    </a>
                                {% endfor %}
                            {% endif %}
                            <button type="button" data-action="print" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" title="{{ lang.index.mod_gallery.print }}" aria-label="{{ lang.index.mod_gallery.print }}">
                                <i class="bi bi-printer"></i>
                            </button>
                        </div>
                    </div>

                    {% include 'partials/share.twig' with {
                        'share_wrap_class': 'd-block d-lg-none mb-4',
                        'share_container_class': 'justify-content-center',
                        'share_url_path': 'publication'
                    } %}

                    {% if d.deck is defined and d.deck == 'y' and d.summary is not empty %}
                        <div class="detail-lead">
                            <p class="mb-0">
                                {{ d.summary }}
                            </p>
                        </div>
                    {% elseif d.summary is not empty %}
                        <div class="detail-lead">
                            <p class="mb-0">
                                {{ d.summary }}
                            </p>
                        </div>
                    {% endif %}

                    {% if d.image is not empty %}
                        <div class="detail-hero">
                            <a href="{{ site.iaddress }}mod_publication/{{ d.image }}" data-bs-toggle="lightbox" data-gallery="publication-main-image">
                                <img src="{{ site.iaddress }}mod_publication/{{ d.image }}"
                                     fetchpriority="high"
                                     class="detail-hero-image"
                                     alt="{{ d.name }}"
                                     title="{{ d.name }}">
                            </a>
                        </div>
                    {% else %}
                        <div class="detail-hero detail-hero-placeholder">
                            {% if publication_logo_asset is not empty %}
                                <img src="{{ publication_logo_asset }}" class="detail-placeholder-symbol opacity-75 max-h-48 object-fit-contain" alt="{{ site.name }}" title="{{ d.name }}">
                            {% endif %}
                        </div>
                    {% endif %}

                    <div itemprop="articleBody" class="detail-body content-body">
                        {{ d.content|raw }}
                    </div>

                    {% include 'partials/share_toolbar.twig' with {
                        'share_url_path': 'publication',
                        'mod_name': 'mod_publication',
                        'item_id': d.id,
                        'has_gallery': gallery is defined and gallery is not empty
                    } %}

                    {% if video is not empty %}
                        <section id="mod_video" class="detail-section" aria-labelledby="video-title">
                            <h2 id="video-title" class="detail-section-heading h4"><i class="bi bi-play-btn"></i>{{ lang.index.mod_video_embed.title }}</h2>
                            <div class="row">
                                {% for v in video %}
                                    <div class="col-12 mb-4">
                                        {% if v.embed is defined and v.embed is not empty %}
                                            <div class="ratio ratio-16x9 bg-dark rounded overflow-hidden shadow-sm">
                                                {{ v.embed|replace({'iframe': 'iframe loading="lazy" title="' ~ v.name ~ '"'})|raw }}
                                            </div>
                                        {% else %}
                                            <a href="{{ site.saddress }}tools/videoFlv/mod_publication/{{ d.id }}/{{ v.id }}/show.mp4" class="video-card-wrapper" data-bs-toggle="lightbox" data-gallery="videos" data-title="{{ v.name }}">
                                                <div class="video-poster ratio ratio-16x9 rounded overflow-hidden shadow-sm position-relative btn-gradient-primary d-flex align-items-center justify-content-center">
                                                    <i class="bi bi-play-circle-fill play-icon"></i>
                                                </div>
                                            </a>
                                        {% endif %}
                                        <p class="fw-bold mt-3 text-center">{{ v.name }}</p>
                                    </div>
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}

                    {% if gallery is not empty %}
                        <section class="detail-section" id="mod_gallery" aria-labelledby="gallery-title">
                            <h2 id="gallery-title" class="detail-section-heading h4"><i class="bi bi-images"></i>{{ lang.index.mod_pictures.title }}</h2>
                            <div class="row g-3 detail-gallery-grid" data-masonry='{"percentPosition": true }' data-bs-images-loaded="true">
                                {% for image in gallery %}
                                    <div class="col-6 col-md-4 mb-3">
                                        <div class="detail-gallery-card">
                                            <a href="{{ site.iaddress }}mod_gallery/mod_publication/original/{{ image.url }}" data-bs-toggle="lightbox" data-gallery="multiimages" data-title="{{ image.name }}">
                                                <img src="{{ site.iaddress }}mod_gallery/mod_publication/thumb/{{ image.url }}" class="card-img-top" alt="{{ image.name }}">
                                            </a>
                                            {% if image.name %}
                                                <div class="card-body p-2 text-center">
                                                    <p class="card-text small text-muted text-truncate">{{ image.name }}</p>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}

                    {% if files is not empty %}
                        <section class="detail-section" aria-labelledby="files-title">
                            <div class="rounded-4 border bg-body-tertiary p-4 p-md-4 shadow-sm">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                                    <div>
                                        <h2 id="files-title" class="detail-section-heading h4 mb-1"><i class="bi bi-cloud-download"></i>{{ lang.index.mod_attachment.title }}</h2>
                                        <p class="mb-0 text-muted small">{{ files|length }} {{ lang.index.download }}</p>
                                    </div>
                                    <span class="badge rounded-pill text-bg-light border px-3 py-2">{{ files|length }}</span>
                                </div>

                                <div class="detail-file-list">
                                {% for file_item in files %}
                                    {% set extension = file_item.original_name|split('.')|last|lower %}
                                    {% set file_icon = 'bi-file-earmark-arrow-down' %}
                                    {% set badge_color = 'bg-secondary' %}

                                    {% if extension == 'pdf' %}{% set file_icon = 'bi-file-earmark-pdf' %}{% set badge_color = 'bg-danger' %}
                                    {% elseif extension == 'zip' or extension == 'rar' %}{% set file_icon = 'bi-file-earmark-zip' %}{% set badge_color = 'bg-warning text-dark' %}
                                    {% elseif extension == 'doc' or extension == 'docx' or extension == 'odt' %}{% set file_icon = 'bi-file-earmark-word' %}{% set badge_color = 'bg-primary' %}
                                    {% elseif extension == 'xls' or extension == 'xlsx' %}{% set file_icon = 'bi-file-earmark-excel' %}{% set badge_color = 'bg-success' %}
                                    {% elseif extension == 'ppt' or extension == 'pptx' %}{% set file_icon = 'bi-file-earmark-ppt' %}{% set badge_color = 'bg-info text-dark' %}
                                    {% elseif extension == 'jpg' or extension == 'jpeg' or extension == 'png' or extension == 'gif' %}{% set file_icon = 'bi-file-earmark-image' %}{% set badge_color = 'bg-info' %}
                                    {% elseif extension == 'epub' %}{% set file_icon = 'bi-book' %}{% set badge_color = 'bg-success' %}
                                    {% endif %}

                                    <a href="{{ site.saddress }}tools/saveFile/mod_publication/{{ d.id }}/{{ file_item.id }}" rel="nofollow noindex" class="detail-file-link">
                                        <div class="detail-file-meta">
                                            <div class="detail-file-icon">
                                                <i class="bi {{ file_icon }}"></i>
                                            </div>
                                            <div>
                                                <h6 class="detail-file-title">{{ file_item.original_name }}</h6>
                                                <span class="badge {{ badge_color }} text-uppercase small">{{ extension }}</span>
                                            </div>
                                        </div>
                                        <div class="ms-3">
                                            <span class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                                                <i class="bi bi-download me-1"></i>{{ lang.index.download }}
                                            </span>
                                        </div>
                                    </a>
                                {% endfor %}
                                </div>
                            </div>
                        </section>
                    {% endif %}

                    {{ faq.render(faqs, faq_lang.mod_faq.title) }}
                </div>
            </article>
        </div>
    </div>
{% endblock %}
