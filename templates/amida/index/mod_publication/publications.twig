{% extends "layouts/base.twig" %}

{% set categories = ctx_get('categories') %}
{% set categoryname = ctx_get('categoryname') %}
{% set category_seo = ctx_get('category_seo') %}
{% set publications = ctx_get('publications') %}
{% set pagination = ctx_get('pagination') %}
{% set page = ctx_get('page') %}

{% block canonical %}
    <link rel="canonical" href="{{ site.saddress }}publications{% if category_seo is not empty and category_seo != 'all' %}/{{ category_seo }}{% endif %}" />
{% endblock %}

{% block title %}
    <title>
        {% if category_seo is not empty and category_seo != 'all' %}
            {{ categoryname }} - {{ lang.index.mod_publication.all_publications }} - {{ site.title }}
        {% else %}
            {{ lang.index.mod_publication.all_publications }} - {{ site.title }}
        {% endif %}
    </title>
{% endblock %}

{% block css_custom %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/publications.css?v={{ "now"|date("U") }}">
{% endblock %}


{% block content %}
<div class="row mt-4" id="mod_publication_list">
    <div class="col-lg-3 col-md-4">
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h5 class="card-title mb-0">
                    <i class="bi bi-journal-text me-2"></i>{{ lang.index.mod_publication.all_publications }}
                </h5>
            </div>
            <div class="list-group list-group-flush">
                <a href="{{ site.saddress }}publications"
                   class="list-group-item list-group-item-action{% if category_seo == 'all' or category_seo is empty %} active{% endif %}">
                    <i class="bi bi-grid me-2"></i>{{ lang.index.mod_publication.all_publications }}
                </a>
                {% for category in categories %}
                    {% if category.publication_count > 0 %}
                    <a href="{{ site.saddress }}publications/{{ category.seo }}"
                       class="list-group-item list-group-item-action{% if category_seo == category.seo %} active{% endif %}">
                        <i class="bi bi-bookmark me-2"></i>{{ category.name }}
                        <span class="badge bg-secondary rounded-pill float-end">{{ category.publication_count }}</span>
                    </a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="col-lg-9 col-md-8">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-4" itemscope itemtype="https://schema.org/BreadcrumbList">
                <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a itemprop="item" href="{{ site.saddress }}"><span itemprop="name">{{ lang.index.home }}</span></a>
                    <meta itemprop="position" content="1" />
                </li>
                {% if category_seo is not empty and category_seo != 'all' %}
                    <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        <a itemprop="item" href="{{ site.saddress }}publications"><span itemprop="name">{{ lang.index.mod_publication.all_publications }}</span></a>
                        <meta itemprop="position" content="2" />
                    </li>
                    <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        <span itemprop="name">{{ categoryname }}</span>
                        <meta itemprop="position" content="3" />
                    </li>
                {% else %}
                    <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        <span itemprop="name">{{ lang.index.mod_publication.all_publications }}</span>
                        <meta itemprop="position" content="2" />
                    </li>
                {% endif %}
            </ol>
        </nav>

        {% if publications is not empty %}
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                {% for publication in publications %}
                    {% set publication_title = publication.title is defined and publication.title is not empty ? publication.title : publication.name %}
                    {% if publication.summary is not empty %}
                        {% set publication_excerpt = publication.summary|striptags %}
                    {% elseif publication.description is not empty %}
                        {% set publication_excerpt = publication.description|striptags %}
                    {% else %}
                        {% set publication_excerpt = publication_title|striptags %}
                    {% endif %}
                    <div class="col">
                        <article class="card h-100 border-0 shadow-sm overflow-hidden">
                            <a href="{{ site.saddress }}publication/{{ publication.seo }}" title="{{ publication_title }}" class="text-decoration-none">
                                <div class="publication-media">
                                    {% if publication.image is not empty %}
                                        <img src="{{ site.iaddress }}mod_publication/{{ publication.image }}"
                                             class="card-img-top object-fit-cover"
                                             alt="{{ publication_title }}"
                                             loading="lazy">
                                    {% else %}
                                        <img src="{{ site.iaddress }}mod_settings/logo.png"
                                             class="card-img-top p-4 bg-light object-fit-contain"
                                             alt="{{ publication_title }}"
                                             loading="lazy">
                                    {% endif %}
                                    <div class="publication-author-badge">
                                        <div class="publication-author-avatar">
                                            {% if publication.user_image is defined and publication.user_image is not empty %}
                                                <img src="{{ site.iaddress }}mod_user/thumb/{{ publication.user_image }}" alt="{{ publication.u_name }} {{ publication.u_last_name }}">
                                            {% else %}
                                                {{ (publication.u_name|default('')|slice(0, 1) ~ publication.u_last_name|default('')|slice(0, 1))|upper }}
                                            {% endif %}
                                        </div>
                                        <div class="publication-author-meta">
                                            <span class="publication-author-name">{{ publication.u_name }} {{ publication.u_last_name }}</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <small class="text-muted">
                                        <i class="bi bi-calendar3 me-1"></i>{{ publication.created_at|date('d.m.Y') }}
                                    </small>
                                    {% if publication.category_name is defined and publication.category_name is not empty %}
                                        <span class="badge text-bg-light border">{{ publication.category_name }}</span>
                                    {% endif %}
                                </div>
                                <h2 class="h5 card-title mb-2">
                                    <a href="{{ site.saddress }}publication/{{ publication.seo }}"
                                       title="{{ publication_title }}"
                                       class="text-decoration-none text-dark publication-card-title d-inline-block">
                                        {{ publication_title }}
                                    </a>
                                </h2>
                                <p class="card-text text-muted flex-grow-1 publication-summary">
                                    {{ publication_excerpt|slice(0, 150) }}{% if publication_excerpt|length > 150 %}...{% endif %}
                                </p>
                                <div class="mt-3 d-flex justify-content-between align-items-center">
                                    <span></span>
                                    <a href="{{ site.saddress }}publication/{{ publication.seo }}" class="btn btn-sm btn-outline-dark">
                                        <i class="bi bi-eye me-1"></i>{{ lang.index.read_more }}
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            </div>

            {% if pagination is not empty %}
                <nav aria-label="{{ lang.index.mod_publication.all_publications }}" class="mt-4">
                    <ul class="pagination justify-content-center">
                        {% for p in pagination %}
                            {% if p == '...' %}
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            {% elseif p == page %}
                                <li class="page-item active" aria-current="page">
                                    <span class="page-link">{{ p }}</span>
                                </li>
                            {% else %}
                                <li class="page-item">
                                    <a class="page-link"
                                       href="{{ site.saddress }}publications{% if category_seo is not empty and category_seo != 'all' %}/{{ category_seo }}{% endif %}/{% if p != 1 %}{{ p }}{% endif %}">
                                        {{ p }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        {% else %}
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-journal-x display-5 text-muted mb-3"></i>
                    <h4 class="text-muted">{{ lang.index.mod_publication.no_content_found }}</h4>
                    <p class="text-muted mb-0">{{ lang.index.mod_publication.no_content_available }}</p>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
