{% extends "layouts/base.twig" %}

{% set categories = ctx_get('categories') %}
{% set categoryname = ctx_get('categoryname') %}
{% set category_seo = ctx_get('category_seo') %}
{% set publications = ctx_get('publications') %}
{% set pagination = ctx_get('pagination') %}
{% set page = ctx_get('page') %}

{% set is_filtered_category = category_seo is not empty and category_seo != 'all' %}
{% set current_page_title = is_filtered_category ? categoryname : (lang.index.mod_publication.all_publications ?? 'Hemû Weşan') %}
{% set page_meta_description = is_filtered_category ? (categoryname ~ ' - ' ~ (lang.index.mod_publication.all_publications ?? 'Hemû Weşan')) : (lang.index.mod_publication.all_publications ?? 'Hemû Weşan') %}
{% set share_image_asset = site.logo_path is defined and site.logo_path is not empty ? (site.iaddress ~ 'mod_settings/' ~ site.logo_path) : (site.iaddress ~ 'mod_settings/logo.png') %}

{% block canonical %}
    <link rel="canonical" href="{{ site.saddress }}publications{% if is_filtered_category %}/{{ category_seo }}{% endif %}{% if page is defined and page > 1 %}/{{ page }}{% endif %}">
{% endblock %}

{% block title %}
    <title>{{ current_page_title }} - {{ site.title }}</title>
{% endblock %}

{% block description %}
    <meta name="description" content="{{ page_meta_description }} - {{ site.title }}">
{% endblock %}

{% block meta_tags %}
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.saddress }}publications{% if is_filtered_category %}/{{ category_seo }}{% endif %}">
    <meta property="og:title" content="{{ current_page_title }} - {{ site.title }}">
    <meta property="og:description" content="{{ page_meta_description }} - {{ site.title }}">
    <meta property="og:image" content="{{ share_image_asset }}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ current_page_title }} - {{ site.title }}">
    <meta name="twitter:description" content="{{ page_meta_description }} - {{ site.title }}">
    <meta name="twitter:image" content="{{ share_image_asset }}">
{% endblock %}

{% block css_custom %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/publications.css?v={{ "now"|date("U") }}">
{% endblock %}

{% block content %}
<main class="publications-page" itemscope itemtype="https://schema.org/CollectionPage">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a itemprop="item" href="{{ site.saddress }}"><span itemprop="name">{{ lang.index.home ?? 'Destpêk' }}</span></a>
                <meta itemprop="position" content="1">
            </li>
            {% if is_filtered_category %}
                <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a itemprop="item" href="{{ site.saddress }}publications"><span itemprop="name">{{ lang.index.mod_publication.all_publications ?? 'Hemû Weşan' }}</span></a>
                    <meta itemprop="position" content="2">
                </li>
                <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <span itemprop="name">{{ categoryname }}</span>
                    <meta itemprop="position" content="3">
                </li>
            {% else %}
                <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <span itemprop="name">{{ lang.index.mod_publication.all_publications ?? 'Hemû Weşan' }}</span>
                    <meta itemprop="position" content="2">
                </li>
            {% endif %}
        </ol>
    </nav>

    <header class="publications-header">
        <div class="publications-header-lead">
            <h1 class="publications-page-title" itemprop="name">
                <i class="bi bi-journal-richtext" aria-hidden="true"></i>
                <span>{{ current_page_title }}</span>
            </h1>
            {% if is_filtered_category %}
                <p class="publications-subtitle">{{ lang.index.mod_publication.all_publications ?? 'Hemû Weşan' }}</p>
            {% endif %}
        </div>
        {% if publications is not empty %}
            <span class="publications-count-badge">
                <i class="bi bi-journal-text" aria-hidden="true"></i>
                <span>{{ publications|length }}{% if pagination is not empty %}+{% endif %}</span>
            </span>
        {% endif %}
    </header>

    <div class="row g-4" id="mod_publication_list">
        <aside class="col-lg-3 col-md-4 publications-sidebar-col" aria-label="{{ lang.index.mod_publication.category ?? 'Kategorî' }}">
            <nav class="publication-filter-card" aria-label="{{ lang.index.mod_publication.category ?? 'Kategorî' }}">
                <div class="publication-filter-header">
                    <h2 class="publication-filter-title">
                        <i class="bi bi-bookmarks" aria-hidden="true"></i>
                        <span>{{ lang.index.mod_publication.category ?? 'Kategorî' }}</span>
                    </h2>
                </div>
                <div class="publication-filter-list">
                    <a href="{{ site.saddress }}publications"
                       class="publication-filter-item{% if not is_filtered_category %} active{% endif %}">
                        <span class="publication-filter-name">
                            <i class="bi bi-grid-fill" aria-hidden="true"></i>
                            <span>{{ lang.index.mod_publication.all_publications ?? 'Hemû Weşan' }}</span>
                        </span>
                    </a>
                    {% for category in categories %}
                        {% if category.publication_count > 0 %}
                            <a href="{{ site.saddress }}publications/{{ category.seo }}"
                               class="publication-filter-item{% if category_seo == category.seo %} active{% endif %}">
                                <span class="publication-filter-name">
                                    <i class="bi bi-bookmark" aria-hidden="true"></i>
                                    <span>{{ category.name }}</span>
                                </span>
                                <span class="publication-filter-badge">{{ category.publication_count }}</span>
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            </nav>
        </aside>

        <section class="col-lg-9 col-md-8 publications-main-col">
            {% if publications is not empty %}
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 publications-grid">
                    {% for publication in publications %}
                        {% set publication_title = publication.title is defined and publication.title is not empty ? publication.title : publication.name %}
                        {% if publication.summary is not empty %}
                            {% set publication_excerpt = publication.summary|striptags %}
                        {% elseif publication.description is not empty %}
                            {% set publication_excerpt = publication.description|striptags %}
                        {% else %}
                            {% set publication_excerpt = publication_title|striptags %}
                        {% endif %}
                        {% set words = publication_excerpt|split(' ')|length %}
                        {% set reading_minutes = (words / 160)|round(0, 'ceil') %}
                        {% if reading_minutes < 1 %}{% set reading_minutes = 1 %}{% endif %}

                        <div class="col publications-grid-col">
                            <article class="publication-card" itemscope itemtype="https://schema.org/CreativeWork">
                                <a href="{{ site.saddress }}publication/{{ publication.seo }}"
                                   class="publication-media"
                                   title="{{ publication_title }}"
                                   itemprop="url">
                                    {% if publication.image is not empty %}
                                        <img src="{{ site.iaddress }}mod_publication/{{ publication.image }}"
                                             class="publication-img"
                                             alt="{{ publication_title }}"
                                             width="640"
                                             height="360"
                                             loading="lazy"
                                             decoding="async"
                                             itemprop="image">
                                    {% else %}
                                        <div class="publication-placeholder">
                                            <i class="bi bi-journal-text publication-placeholder-icon" aria-hidden="true"></i>
                                        </div>
                                    {% endif %}

                                    {% if publication.u_name is defined and publication.u_name is not empty %}
                                        <div class="publication-author-badge" itemprop="author" itemscope itemtype="https://schema.org/Person">
                                            <div class="publication-author-avatar">
                                                {% if publication.user_image is defined and publication.user_image is not empty %}
                                                    <img src="{{ site.iaddress }}mod_user/thumb/{{ publication.user_image }}"
                                                         alt="{{ publication.u_name }} {{ publication.u_last_name }}"
                                                         width="40"
                                                         height="40"
                                                         loading="lazy"
                                                         decoding="async">
                                                {% else %}
                                                    <span class="publication-author-initials">
                                                        {{ (publication.u_name|default('')|slice(0, 1) ~ publication.u_last_name|default('')|slice(0, 1))|upper }}
                                                    </span>
                                                {% endif %}
                                            </div>
                                            <div class="publication-author-meta">
                                                <span class="publication-author-name" itemprop="name">{{ publication.u_name }} {{ publication.u_last_name }}</span>
                                            </div>
                                        </div>
                                    {% endif %}
                                </a>

                                <div class="publication-body">
                                    <div class="publication-meta">
                                        {% if publication.created_at is defined and publication.created_at is not empty %}
                                            <span class="publication-meta-item">
                                                <i class="bi bi-calendar3" aria-hidden="true"></i>
                                                <time datetime="{{ publication.created_at }}" itemprop="datePublished">{{ publication.created_at|date('d.m.Y') }}</time>
                                            </span>
                                        {% endif %}

                                        {% if publication.category_name is defined and publication.category_name is not empty %}
                                            <span class="publication-category-pill" itemprop="genre">
                                                <i class="bi bi-bookmark-fill" aria-hidden="true"></i>
                                                <span>{{ publication.category_name }}</span>
                                            </span>
                                        {% endif %}
                                    </div>

                                    <h2 class="publication-card-title" itemprop="headline">
                                        <a href="{{ site.saddress }}publication/{{ publication.seo }}" itemprop="url">
                                            {{ publication_title }}
                                        </a>
                                    </h2>

                                    <p class="publication-summary" itemprop="description">
                                        {{ publication_excerpt|length > 150 ? publication_excerpt|slice(0, 147) ~ '...' : publication_excerpt }}
                                    </p>

                                    <div class="publication-footer">
                                        <span class="publication-read-time">
                                            <i class="bi bi-book" aria-hidden="true"></i>
                                            <span>{{ reading_minutes }} {{ lang.index.minute ?? 'deqe' }}</span>
                                        </span>
                                        <a href="{{ site.saddress }}publication/{{ publication.seo }}"
                                           class="publication-read-more"
                                           aria-label="{{ publication_title }}">
                                            <span class="publication-read-text">{{ lang.index.read_more ?? 'Bixwîne' }}</span>
                                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    {% endfor %}
                </div>

                {% if pagination is not empty %}
                    <nav class="publications-pagination-nav" aria-label="{{ lang.index.mod_publication.all_publications ?? 'Hemû Weşan' }}">
                        <ul class="publications-pagination-list">
                            {% for p in pagination %}
                                {% if p == '...' %}
                                    <li class="publications-page-item disabled" aria-disabled="true">
                                        <span class="publications-page-link">&hellip;</span>
                                    </li>
                                {% elseif p == page %}
                                    <li class="publications-page-item active" aria-current="page">
                                        <span class="publications-page-link">{{ p }}</span>
                                    </li>
                                {% else %}
                                    <li class="publications-page-item">
                                        <a class="publications-page-link"
                                           href="{{ site.saddress }}publications{% if is_filtered_category %}/{{ category_seo }}{% endif %}{% if p != 1 %}/{{ p }}{% endif %}">
                                            {{ p }}
                                        </a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </nav>
                {% endif %}
            {% else %}
                <div class="publication-empty-card">
                    <div class="publication-empty-icon-wrap">
                        <i class="bi bi-journal-x" aria-hidden="true"></i>
                    </div>
                    <h2 class="publication-empty-title">{{ lang.index.mod_publication.no_content_found ?? 'Di vê kategoriyê de weşan nehatin dîtin!' }}</h2>
                    <p class="publication-empty-text">{{ lang.index.mod_publication.no_content_available ?? 'Di vê kategoriyê de weşanek tune.' }}</p>
                    {% if is_filtered_category %}
                        <a href="{{ site.saddress }}publications" class="publication-empty-action">
                            <i class="bi bi-arrow-left" aria-hidden="true"></i>
                            <span>{{ lang.index.mod_publication.all_publications ?? 'Hemû Weşan' }}</span>
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </section>
    </div>
</main>
{% endblock %}
