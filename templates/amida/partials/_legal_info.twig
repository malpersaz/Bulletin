{% set has_company_info = (site.legal_company_name is defined and site.legal_company_name is not empty)
    or (site.legal_trading_name is defined and site.legal_trading_name is not empty)
    or (site.company_registration_number is defined and site.company_registration_number is not empty)
    or (site.trade_registry_number is defined and site.trade_registry_number is not empty)
    or (site.central_registration_number is defined and site.central_registration_number is not empty)
    or (site.chamber_of_commerce is defined and site.chamber_of_commerce is not empty)
    or (site.country is defined and site.country is not empty)
    or (site.corporate_address is defined and site.corporate_address is not empty) %}

{% set has_tax_info = (site.tax_office is defined and site.tax_office is not empty)
    or (site.tax_number is defined and site.tax_number is not empty)
    or (site.vat_number is defined and site.vat_number is not empty) %}

{% set has_contact_info = (site.authorized_person is defined and site.authorized_person is not empty)
    or (site.registered_email is defined and site.registered_email is not empty)
    or (site.legal_contact_phone is defined and site.legal_contact_phone is not empty)
    or (site.contact_address is defined and site.contact_address is not empty) %}

{% set has_publishing_info = (site.managing_director is defined and site.managing_director is not empty)
    or (site.editor_in_chief is defined and site.editor_in_chief is not empty)
    or (site.press_code_license is defined and site.press_code_license is not empty)
    or (site.dpo_email is defined and site.dpo_email is not empty)
    or (site.hosting_provider is defined and site.hosting_provider is not empty)
    or (site.compliance_jurisdiction is defined and site.compliance_jurisdiction is not empty) %}

{% set has_warranty_info = (site.default_warranty_duration is defined and site.default_warranty_duration is not empty)
    or (site.warranty_type is defined and site.warranty_type is not empty)
    or (site.return_policy_days is defined and site.return_policy_days is not empty)
    or (site.warranty_description is defined and site.warranty_description is not empty) %}

{% set has_any_legal_info = has_company_info or has_publishing_info or has_tax_info or has_contact_info or has_warranty_info %}

{% if not has_any_legal_info %}
    <div class="legal-empty-card" role="region" aria-label="{{ lang.index.legal_info }}">
        <div class="legal-empty-icon">
            <i class="bi bi-shield-slash" aria-hidden="true"></i>
        </div>
        <h2 class="legal-empty-title">{{ lang.index.legal_info }}</h2>
        <p class="legal-empty-desc">
            {{ lang.index.legal_info_pending }}
        </p>
    </div>
{% else %}
    <div class="legal-info-wrapper" role="region" aria-label="{{ lang.index.legal_info }}">
        <!-- Official Trust & Actions Header Box -->
        <header class="legal-header-box">
            <div class="legal-header-top">
                <div class="legal-verified-badge" aria-label="{{ lang.index.verified_company }}">
                    <span class="legal-verified-pulse" aria-hidden="true"></span>
                    <span>{{ lang.index.verified_company }}</span>
                </div>
                <div class="legal-actions-bar">
                    <button type="button" class="legal-action-btn legal-print-btn" title="{{ lang.index.print_record }}" aria-label="{{ lang.index.print_record }}">
                        <i class="bi bi-printer" aria-hidden="true"></i>
                        <span>{{ lang.index.print_record }}</span>
                    </button>
                    <button type="button" class="legal-action-btn legal-share-btn" data-copied-label="{{ lang.index.copied }}" title="{{ lang.index.copy_link }}" aria-label="{{ lang.index.copy_link }}">
                        <i class="bi bi-share" aria-hidden="true"></i>
                        <span>{{ lang.index.copy_link }}</span>
                    </button>
                </div>
            </div>
            <p class="legal-header-desc">
                {{ lang.index.legal_notice_desc }}
            </p>
        </header>

        <!-- Bento Grid Cards -->
        <div class="legal-bento-grid">
            <!-- 1. Publishing Credentials & Editorial Governance (Kunya) -->
            {% if has_publishing_info %}
                <section class="legal-card span-2" aria-labelledby="card-publishing-title">
                    <div class="legal-card-header">
                        <div class="legal-card-icon" aria-hidden="true">
                            <i class="bi bi-journal-bookmark"></i>
                        </div>
                        <div>
                            <span class="legal-card-kicker">{{ lang.index.statutory_compliance }}</span>
                            <h2 id="card-publishing-title" class="legal-card-title">{{ lang.index.publishing_credentials_title }}</h2>
                        </div>
                    </div>
                    <ul class="legal-field-list">
                        {% if site.managing_director is defined and site.managing_director is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.managing_director }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value fw-semibold">{{ site.managing_director }}</span>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.editor_in_chief is defined and site.editor_in_chief is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.editor_in_chief }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value fw-semibold">{{ site.editor_in_chief }}</span>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.press_code_license is defined and site.press_code_license is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.press_code_license }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value font-monospace">{{ site.press_code_license }}</span>
                                    <button type="button" class="legal-copy-btn" data-copy-text="{{ site.press_code_license }}" data-copied-label="{{ lang.index.copied }}" title="{{ lang.index.quick_copy }}" aria-label="{{ lang.index.copy_value }} {{ lang.index.press_code_license }}">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.dpo_email is defined and site.dpo_email is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.dpo_email }}</span>
                                <div class="legal-field-value-wrap">
                                    <a href="mailto:{{ site.dpo_email }}" class="legal-field-value font-monospace">{{ site.dpo_email }}</a>
                                    <button type="button" class="legal-copy-btn" data-copy-text="{{ site.dpo_email }}" data-copied-label="{{ lang.index.copied }}" title="{{ lang.index.quick_copy }}" aria-label="{{ lang.index.copy_value }} {{ lang.index.dpo_email }}">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.hosting_provider is defined and site.hosting_provider is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.hosting_provider }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value">{{ site.hosting_provider }}</span>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.compliance_jurisdiction is defined and site.compliance_jurisdiction is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.compliance_jurisdiction }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value">{{ site.compliance_jurisdiction }}</span>
                                </div>
                            </li>
                        {% endif %}
                    </ul>
                </section>
            {% endif %}

            <!-- 2. Company & Registry Card -->
            {% if has_company_info %}
                <section class="legal-card" aria-labelledby="card-company-title">
                    <div class="legal-card-header">
                        <div class="legal-card-icon" aria-hidden="true">
                            <i class="bi bi-building"></i>
                        </div>
                        <div>
                            <span class="legal-card-kicker">{{ lang.index.statutory_compliance }}</span>
                            <h2 id="card-company-title" class="legal-card-title">{{ lang.index.company_registry_title }}</h2>
                        </div>
                    </div>
                    <ul class="legal-field-list">
                        {% if site.legal_company_name is defined and site.legal_company_name is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.legal_company_name }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value legal-company-highlight">{{ site.legal_company_name }}</span>
                                    <button type="button" class="legal-copy-btn" data-copy-text="{{ site.legal_company_name }}" data-copied-label="{{ lang.index.copied }}" title="{{ lang.index.quick_copy }}" aria-label="{{ lang.index.copy_value }} {{ lang.index.legal_company_name }}">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.legal_trading_name is defined and site.legal_trading_name is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.legal_trading_name }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value">{{ site.legal_trading_name }}</span>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.company_registration_number is defined and site.company_registration_number is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.company_registration_number }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value font-monospace">{{ site.company_registration_number }}</span>
                                    <button type="button" class="legal-copy-btn" data-copy-text="{{ site.company_registration_number }}" data-copied-label="{{ lang.index.copied }}" title="{{ lang.index.quick_copy }}" aria-label="{{ lang.index.copy_value }} {{ lang.index.company_registration_number }}">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.trade_registry_number is defined and site.trade_registry_number is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.trade_registry_number }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value font-monospace">{{ site.trade_registry_number }}</span>
                                    <button type="button" class="legal-copy-btn" data-copy-text="{{ site.trade_registry_number }}" data-copied-label="{{ lang.index.copied }}" title="{{ lang.index.quick_copy }}" aria-label="{{ lang.index.copy_value }} {{ lang.index.trade_registry_number }}">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.central_registration_number is defined and site.central_registration_number is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.central_registration_number }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value font-monospace">{{ site.central_registration_number }}</span>
                                    <button type="button" class="legal-copy-btn" data-copy-text="{{ site.central_registration_number }}" data-copied-label="{{ lang.index.copied }}" title="{{ lang.index.quick_copy }}" aria-label="{{ lang.index.copy_value }} {{ lang.index.central_registration_number }}">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.chamber_of_commerce is defined and site.chamber_of_commerce is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.chamber_of_commerce }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value">{{ site.chamber_of_commerce }}</span>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.corporate_address is defined and site.corporate_address is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.corporate_address }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value">{{ site.corporate_address }}</span>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.country is defined and site.country is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.country }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value">{{ site.country }}</span>
                                </div>
                            </li>
                        {% endif %}
                    </ul>
                </section>
            {% endif %}

            <!-- 3. Tax & Fiscal Identification Card -->
            {% if has_tax_info %}
                <section class="legal-card" aria-labelledby="card-tax-title">
                    <div class="legal-card-header">
                        <div class="legal-card-icon" aria-hidden="true">
                            <i class="bi bi-receipt-cutoff"></i>
                        </div>
                        <div>
                            <span class="legal-card-kicker">{{ lang.index.statutory_compliance }}</span>
                            <h2 id="card-tax-title" class="legal-card-title">{{ lang.index.tax_fiscal_title }}</h2>
                        </div>
                    </div>
                    <ul class="legal-field-list">
                        {% if site.tax_office is defined and site.tax_office is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.tax_office }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value">{{ site.tax_office }}</span>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.tax_number is defined and site.tax_number is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.tax_number }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value font-monospace">{{ site.tax_number }}</span>
                                    <button type="button" class="legal-copy-btn" data-copy-text="{{ site.tax_number }}" data-copied-label="{{ lang.index.copied }}" title="{{ lang.index.quick_copy }}" aria-label="{{ lang.index.copy_value }} {{ lang.index.tax_number }}">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.vat_number is defined and site.vat_number is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.vat_number }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value font-monospace">{{ site.vat_number }}</span>
                                    <button type="button" class="legal-copy-btn" data-copy-text="{{ site.vat_number }}" data-copied-label="{{ lang.index.copied }}" title="{{ lang.index.quick_copy }}" aria-label="{{ lang.index.copy_value }} {{ lang.index.vat_number }}">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </li>
                        {% endif %}
                    </ul>
                </section>
            {% endif %}

            <!-- 4. Legal Contact & Statutory Representation Card -->
            {% if has_contact_info %}
                <section class="legal-card" aria-labelledby="card-contact-title">
                    <div class="legal-card-header">
                        <div class="legal-card-icon" aria-hidden="true">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <span class="legal-card-kicker">{{ lang.index.statutory_compliance }}</span>
                            <h2 id="card-contact-title" class="legal-card-title">{{ lang.index.legal_contact_title }}</h2>
                        </div>
                    </div>
                    <ul class="legal-field-list">
                        {% if site.authorized_person is defined and site.authorized_person is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.authorized_person }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value">{{ site.authorized_person }}</span>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.registered_email is defined and site.registered_email is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.registered_email }}</span>
                                <div class="legal-field-value-wrap">
                                    <a href="mailto:{{ site.registered_email }}" class="legal-field-value font-monospace">{{ site.registered_email }}</a>
                                    <button type="button" class="legal-copy-btn" data-copy-text="{{ site.registered_email }}" data-copied-label="{{ lang.index.copied }}" title="{{ lang.index.quick_copy }}" aria-label="{{ lang.index.copy_value }} {{ lang.index.registered_email }}">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.legal_contact_phone is defined and site.legal_contact_phone is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.legal_contact_phone }}</span>
                                <div class="legal-field-value-wrap">
                                    <a href="tel:{{ site.legal_contact_phone }}" class="legal-field-value">{{ site.legal_contact_phone }}</a>
                                    <button type="button" class="legal-copy-btn" data-copy-text="{{ site.legal_contact_phone }}" data-copied-label="{{ lang.index.copied }}" title="{{ lang.index.quick_copy }}" aria-label="{{ lang.index.copy_value }} {{ lang.index.legal_contact_phone }}">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </li>
                        {% endif %}

                        {% if site.contact_address is defined and site.contact_address is not empty %}
                            <li class="legal-field-row">
                                <span class="legal-field-label">{{ lang.index.registered_address }}</span>
                                <div class="legal-field-value-wrap">
                                    <span class="legal-field-value">{{ site.contact_address }}</span>
                                </div>
                            </li>
                        {% endif %}
                    </ul>
                </section>
            {% endif %}

            <!-- 5. Consumer & Warranty Policies Card (If Applicable) -->
            {% if has_warranty_info %}
                <section class="legal-card span-2" aria-labelledby="card-warranty-title">
                    <div class="legal-card-header">
                        <div class="legal-card-icon" aria-hidden="true">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <span class="legal-card-kicker">{{ lang.index.statutory_compliance }}</span>
                            <h2 id="card-warranty-title" class="legal-card-title">{{ lang.index.warranty_policies_title }}</h2>
                        </div>
                    </div>

                    <div class="legal-policy-badges">
                        {% if site.default_warranty_duration is defined and site.default_warranty_duration is not empty %}
                            <div class="legal-policy-pill">
                                <div class="legal-policy-pill-icon" aria-hidden="true">
                                    <i class="bi bi-hourglass-split"></i>
                                </div>
                                <div class="legal-policy-pill-text">
                                    <span class="legal-policy-pill-title">{{ lang.index.default_warranty_duration }}</span>
                                    <span class="legal-policy-pill-val">{{ site.default_warranty_duration }} {{ lang.index.months }}</span>
                                </div>
                            </div>
                        {% endif %}

                        {% if site.warranty_type is defined and site.warranty_type is not empty %}
                            <div class="legal-policy-pill">
                                <div class="legal-policy-pill-icon" aria-hidden="true">
                                    <i class="bi bi-patch-check"></i>
                                </div>
                                <div class="legal-policy-pill-text">
                                    <span class="legal-policy-pill-title">{{ lang.index.warranty_type }}</span>
                                    <span class="legal-policy-pill-val">{{ site.warranty_type }}</span>
                                </div>
                            </div>
                        {% endif %}

                        {% if site.return_policy_days is defined and site.return_policy_days is not empty %}
                            <div class="legal-policy-pill">
                                <div class="legal-policy-pill-icon" aria-hidden="true">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </div>
                                <div class="legal-policy-pill-text">
                                    <span class="legal-policy-pill-title">{{ lang.index.return_policy_days }}</span>
                                    <span class="legal-policy-pill-val">{{ site.return_policy_days }} {{ lang.index.days }}</span>
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    {% if site.warranty_description is defined and site.warranty_description is not empty %}
                        <div class="legal-policy-desc">
                            {{ site.warranty_description|nl2br }}
                        </div>
                    {% endif %}
                </section>
            {% endif %}
        </div>
    </div>
{% endif %}
