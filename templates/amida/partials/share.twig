<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/share.css?v={{ site.version|default('1.1.25') }}">

<div class="social-share d-print-none {{ share_wrap_class|default('my-3') }}">
    <div class="share-container d-flex align-items-center gap-2 {{ share_container_class|default('') }}">
        {% if show_share_text|default(true) %}
        <span class="share-text text-muted fw-bold text-uppercase d-none d-sm-inline-block mr-1 meta-text-xs">{{ lang.index.share }}:</span>
        {% endif %}
        
        <button type="button" class="social-share-btn btn-native-share" title="{{ lang.index.share }}" aria-label="{{ lang.index.share }}" data-share-title="{{ d.name|default(d.title|default(site.name))|escape('html_attr') }}" data-share-url="{{ site.saddress }}{{ share_url_path|default('article') }}/{{ d.seo }}">
            <i class="bi bi-share"></i>
        </button>

        <div class="share-buttons-list d-flex gap-2 flex-wrap {{ share_inner_class|default('') }}">
            {# Facebook #}
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ (site.saddress ~ (share_url_path|default('article')) ~ '/' ~ d.seo)|url_encode }}" target="_blank" rel="noopener noreferrer" class="social-share-btn btn-facebook" aria-label="Facebook" data-bs-toggle="tooltip" data-bs-placement="top" title="Facebook"><i class="bi bi-facebook"></i></a>
            
            {# X (Twitter) #}
            <a href="https://twitter.com/intent/tweet?text={{ (d.name|default(d.title|default(site.name)))|url_encode }}&url={{ (site.saddress ~ (share_url_path|default('article')) ~ '/' ~ d.seo)|url_encode }}" target="_blank" rel="noopener noreferrer" class="social-share-btn btn-twitter" aria-label="X (Twitter)" data-bs-toggle="tooltip" data-bs-placement="top" title="X (Twitter)"><i class="bi bi-twitter-x"></i></a>
            
            {# WhatsApp #}
            <a href="https://api.whatsapp.com/send?text={{ (d.name|default(d.title|default(site.name)))|url_encode }}%0A{{ (site.saddress ~ (share_url_path|default('article')) ~ '/' ~ d.seo)|url_encode }}" target="_blank" rel="noopener noreferrer" class="social-share-btn btn-whatsapp" aria-label="WhatsApp" data-bs-toggle="tooltip" data-bs-placement="top" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>

            {# TikTok share #}
            <button
                type="button"
                class="social-share-btn btn-tiktok border-0"
                aria-label="TikTok"
                data-bs-toggle="tooltip"
                data-bs-placement="top"
                title="TikTok"
                data-share-network="tiktok"
                data-share-title="{{ (d.name|default(d.title|default(site.name)))|escape('html_attr') }}"
                data-share-url="{{ site.saddress }}{{ share_url_path|default('article') }}/{{ d.seo }}"
                data-copied-text="{{ lang.index.link_copied }}"
            >
                <i class="bi bi-tiktok"></i>
            </button>
            
            {# LinkedIn #}
            <a href="https://www.linkedin.com/shareArticle?mini=true&url={{ (site.saddress ~ (share_url_path|default('article')) ~ '/' ~ d.seo)|url_encode }}&title={{ (d.name|default(d.title|default(site.name)))|url_encode }}" target="_blank" rel="noopener noreferrer" class="social-share-btn btn-linkedin" aria-label="LinkedIn" data-bs-toggle="tooltip" data-bs-placement="top" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
            
            {# Email #}
            <a href="mailto:?subject={{ (d.name|default(d.title|default(site.name)))|url_encode }}&body={{ (site.saddress ~ (share_url_path|default('article')) ~ '/' ~ d.seo)|url_encode }}" class="social-share-btn btn-email" aria-label="Email" data-bs-toggle="tooltip" data-bs-placement="top" title="Email"><i class="bi bi-envelope"></i></a>
            
            {# Copy Link #}
            <button type="button" class="social-share-btn btn-copy border-0" aria-label="{{ lang.index.copy_link }}" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ lang.index.copy_link }}" data-copy-url="{{ site.saddress }}{{ share_url_path|default('article') }}/{{ d.seo }}" data-copied-text="{{ lang.index.link_copied }}" data-original-text="{{ lang.index.copy_link }}">
                <i class="bi bi-link-45deg fs-5"></i>
            </button>
        </div>
    </div>
</div>

<script src="{{ site.taddress }}{{ site.app_template }}/static/js/share.js?v={{ site.version|default('1.1.25') }}"></script>
