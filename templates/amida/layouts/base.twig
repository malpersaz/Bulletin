<!DOCTYPE html>
<html lang="{{ site.lang }}" data-bs-theme="auto" class="h-100">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light dark">



		{% block title %}
			<title>{{ site.title }}</title>
		{% endblock %}
		{% block description %}<meta name="description" content="{{ site.description }}">
		{% endblock %}
		{% block keywords %}<meta name="keywords" content="{{ site.keywords }}">
		{% endblock %}
		{% block canonical %}<link rel="canonical" href="{{ site.saddress|default(site.address) }}"/>
		{% endblock %}
		{% block head_preload %}{% endblock %}

		{% block meta_tags %}
			<!-- Standard Meta -->
			<meta name="author" content="{{ site.title }}">
			<meta name="robots" content="index, follow">
			<meta
			name="theme-color" content="#ffffff">

			<!-- Open Graph / Facebook -->
			<meta property="og:type" content="website">
			<meta property="og:url" content="{{ site.address }}">
			<meta property="og:title" content="{{ site.title }}">
			<meta property="og:description" content="{{ site.description }}">
			{% set meta_logo = (site.logo_path is defined and site.logo_path is not empty) ? site.logo_path : 'logo.png' %}
			<meta property="og:image" content="{{ site.iaddress }}mod_settings/{{ meta_logo }}">
			<meta property="og:site_name" content="{{ site.title }}">
			{% set og_locale = site.lang ~ '_SE' %}
			{% if site.lang == 'en' %}{% set og_locale = 'en_US' %}
			{% elseif site.lang == 'tr' %}{% set og_locale = 'tr_TR' %}
			{% elseif site.lang == 'de' %}{% set og_locale = 'de_DE' %}
			{% endif %}
			<meta property="og:locale" content="{{ og_locale }}">

			<!-- Twitter -->
			<meta name="twitter:card" content="summary_large_image">
			<meta name="twitter:url" content="{{ site.address }}">
			<meta name="twitter:title" content="{{ site.title }}">
			<meta name="twitter:description" content="{{ site.description }}">
			<meta name="twitter:image" content="{{ site.iaddress }}mod_settings/{{ meta_logo }}">
		{% endblock %}

		<base
		href="{{ site.address }}">

		{% set settings_asset_base = site.iaddress ~ 'mod_settings/' %}
		{% set logo_asset = site.logo_path is defined and site.logo_path is not empty ? settings_asset_base ~ site.logo_path : '' %}
		{% set favicon_asset = site.favicon_path is defined and site.favicon_path is not empty ? settings_asset_base ~ site.favicon_path : '' %}
		{% set favicon_96_asset = site.favicon_96 is defined and site.favicon_96 is not empty ? settings_asset_base ~ site.favicon_96 : '' %}
		{% set apple_touch_asset = site.apple_touch_icon is defined and site.apple_touch_icon is not empty ? settings_asset_base ~ site.apple_touch_icon : '' %}
		{% set manifest_asset = site.site_webmanifest is defined and site.site_webmanifest is not empty ? settings_asset_base ~ site.site_webmanifest : '' %}

		<!-- Favicons -->
		{% if favicon_96_asset is not empty %}
			<link rel="icon" type="image/png" href="{{ favicon_96_asset }}" sizes="96x96"/>
		{% endif %}
		{% if favicon_asset is not empty %}
			<link rel="icon" type="image/x-icon" href="{{ favicon_asset }}" sizes="32x32">
			<link rel="shortcut icon" href="{{ favicon_asset }}">
		{% endif %}
		{% if apple_touch_asset is not empty %}
			<link rel="apple-touch-icon" sizes="180x180" href="{{ apple_touch_asset }}"/>
		{% endif %}
		{% if manifest_asset is not empty %}
			<link rel="manifest" href="{{ site.address }}site.webmanifest"/>
		{% endif %}

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link
		href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@100..900&family=Roboto:wght@300;400;500;700&family=UnifrakturCook:wght@700&family=UnifrakturMaguntia&display=swap" rel="stylesheet">

		<!-- Bootstrap 5.3 CSS CDN -->
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
		<link
		rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css">

		<!-- Modern Plugin Styles -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.2.0/dist/css/glightbox.min.css">
		<link rel="stylesheet" href="{{ site.taddress }}base_static/css/lightbox-engine.css?v={{ site.version|default('1.0') }}">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">

		<!-- Custom CSS -->
		<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/custom.css?v={{ "now"|date("U") }}">
		<!-- Stacked Top Menu CSS -->
		<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/stacked-top-menu.css?v={{ "now"|date("U") }}">
		<!-- Footer CSS -->
		<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/footer.css?v={{ "now"|date("U") }}">
		{% block stylesheets %}{% endblock %}

		{% if site.google_analytics_id is defined and site.google_analytics_id is not empty %}
			<!-- Google tag (gtag.js) -->
			<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.google_analytics_id }}"></script>
			<script>
			  window.dataLayer = window.dataLayer || [];
			  function gtag(){dataLayer.push(arguments);}
			  gtag('js', new Date());
			  gtag('config', '{{ site.google_analytics_id }}', {
				'send_page_view': true,
				'anonymize_ip': false,
				'cookie_flags': 'SameSite=None;Secure'
			  });
			</script>
		{% endif %}

		{% block css_custom %}{% endblock %}
		{% block head %}{% endblock %}
	</head>
	<body class="d-flex flex-column h-100">

		{{ run({"mod": "index", "method": "_menu"}) }}
		{% set menu = ctx_get('menu') %}

		{% include 'index/mod_menu/stacked_top_menu.twig' %}

		<main class="flex-shrink-0 flex-grow-1">
			<div class="container">
				{# Flash Mesajları Gösterimi - TEMPORARILY DISABLED #}
				{# {% if session.flash_message is not empty %}
																                <div class="alert alert-{{ session.flash_message.type }} alert-dismissible fade show" role="alert">
																                    {{ session.flash_message.text }}
																                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
																                </div>
																            {% endif %} #}

				<!-- DEBUG: Flash message disabled -->{% block content %}
			{% endblock %}
		</div>
		</main>{% include "index/footer.twig" %}

		<!-- Bootstrap 5.3 JS Bundle CDN (Popper.js dahil) --><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"> </script>

		<!-- Modern Eklenti CDN'leri -->
		<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/glightbox@3.2.0/dist/js/glightbox.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/tr.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

		<!-- Masonry & ImagesLoaded CDN -->
		<script src="https://cdn.jsdelivr.net/npm/masonry-layout@4.2.2/dist/masonry.pkgd.min.js" integrity="sha384-GNFwBvfVxBkLMJpYMOABq3c+d3KnQxudP/mGPkzpZSTYykLBNsZEnG2D9G/X/+7D" crossorigin="anonymous" async></script>
		<script src="https://unpkg.com/imagesloaded@5/imagesloaded.pkgd.min.js"></script>

		<!-- jQuery -->
		<script src="{{ site.taddress }}base_static/js/jquery.js"></script>
		<script src="{{ site.taddress }}base_static/js/jquery.cookie.js"></script>

		<!-- Lightbox Engine -->
		<script src="{{ site.taddress }}base_static/js/lightbox-engine.js?v={{ site.version|default('1.0') }}" defer></script>

		<!-- Month Popover Engine -->
		<script src="{{ site.taddress }}{{ site.app_template }}/static/js/month-popover.js?v={{ site.version|default('1.0') }}" defer></script>
		{% block js_custom %}
		{% endblock %}

		{# Context JavaScript #}
			{% if ctx_get('javascript') is not empty %}
				<script>
{% for script in ctx_get('javascript') %}
{{ script|raw }}
{% endfor %}
		</script>
		{% endif %}

		{# jQuery Document Ready Scripts #}

			{% if ctx_get('jquery_document') is not empty %}

				<script>

$(document).ready(function () {

{% for script in ctx_get('jquery_document') %}

{{ script|raw }}

{% endfor %}

});
		</script>

		{% endif %}


	{% include 'partials/_cookie_consent.twig' %}

</body></html>
