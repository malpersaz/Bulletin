{# Menu Fonksiyonu - Tüm template'ler tarafından kullanılabilir #}
{% macro renderMenu(menu, arg_parent_id, ss, level = 0) %}
    {% if menu[arg_parent_id] is defined %}
        {% for m in menu[arg_parent_id] %}
            {% if m.id != arg_parent_id and level < 20 %}
            {% set parent_id = m.id %}
            {% if m.file != '' %}
                {# Blok system removed - file include disabled: {{ m.file }} #}
            {% else %}

                
                
            {#  Eğer url ## ise root menu demek #}
            {% if m.url == '##' %}
                {{ _self.renderMenu(menu, parent_id, ss, level + 1) }}
            {% endif %}



                {% if m.lang == site.lang and m.status == 'y' %}
                    {% set ss = 1 %}
                    <li class="nav-item{% if menu[parent_id] is defined and menu[parent_id] is iterable %} dropdown{% endif %}">
                        <a class="nav-link{% if menu[parent_id] is defined and menu[parent_id] is iterable %} dropdown-toggle{% endif %}"
                           {% set cleanUrl = m.url %}
                           {% if cleanUrl starts with site.lang ~ '/' %}
                               {% set cleanUrl = cleanUrl|slice(site.lang|length + 1) %}
                           {% endif %}

                           {% if m.url == '' or m.url == '#' %}
                               href="javascript:void(0);"
                           {% elseif m.url starts with 'http' or m.url starts with '//' %}
                               href="{{ m.url }}"{% if m.target == 'y' %} target="_blank"{% endif %}
                           {% else %}
                               href="{{ site.sadres }}{{ cleanUrl }}"{% if m.target == 'y' %} target="_blank"{% endif %}
                           {% endif %}
                           {% if menu[parent_id] is defined and menu[parent_id] is iterable %}
                               data-bs-toggle="dropdown" role="button"
                           {% endif %}
                           title="{{ m.name }}">
                            {% if m.icon is defined and m.icon != '' %}<i class="{{ m.icon }} me-1"></i>{% endif %}
                            {% if m.html is defined and m.html != '' %}
                                {{ m.html|raw }}
                            {% else %}
                                {{ m.name }}
                            {% endif %}
                        </a>

                        {% if menu[parent_id] is defined and menu[parent_id] is iterable %}
                            {% if ss == '1' %}
                                <ul class="dropdown-menu">{% endif %}
                            {{ _self.renderMenu(menu, parent_id, ss, level + 1) }}
                            {% if ss == '1' %}</ul>{% endif %}
                        {% endif %}
                    </li>
                {% endif %}
            {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}