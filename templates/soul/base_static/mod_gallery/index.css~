.mod_gallery {
    float: left;
    position: relative;
    margin-bottom: 15px;
    margin-left: 55px;
    margin-top: 30px;
    
}



.mod_gallery ul{
    list-style: none;
}

.mod_gallery li {
    padding-left: 12px;
    padding-right: 12px;
    width: 150px;
}
.mod_gallery li img{
    max-height: 100px;
    max-width: 150px;
}

.mod_gallery .carousel-control {
    border: 0 none;
    cursor: pointer;
    display: inline-block;
    height: 30px;
    line-height: 999px;
    overflow: hidden;
    text-indent: -9999px;
    vertical-align: middle;
    width: 30px;
}

.mod_gallery .carousel-next {
    background: url('img/blue_next.png') no-repeat scroll 0 0 transparent;
    position: absolute;
    right: -45px;
    top: 30px;
}

.mod_gallery .disabled, #container .carousel .disabled:hover {
    cursor: default;
    filter: alpha(opacity = 10);
    -moz-opacity: 0.1;
    opacity: 0.1;
}

.mod_gallery .carousel-previous {
    position: absolute;
    left: -45px;
    top: 30px;
    background: url('img/blue_prev.png') no-repeat scroll 0 0 transparent;
}