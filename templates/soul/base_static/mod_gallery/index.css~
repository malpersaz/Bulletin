.dl {
    position: relative;
    float: left;
}

.dll {
    position: absolute;
    background: url('img/dl.png') no-repeat scroll left center;
    color: red;
    display: none;
    font-size: 9px;
    font-weight: bold;
    height: 16px;
    padding-left: 18px;
    left: 12px;
    top: 0px;
    filter: alpha(opacity = 90);
    -moz-opacity: 0.9;
    opacity: 0.9;
}

.tdll {
    position: absolute;
    background: url('img/tdll.png') no-repeat scroll left center;
    color: red;
    display: none;
    font-size: 9px;
    font-weight: bold;
    height: 16px;
    padding-left: 18px;
    right: 12px;
    top: 0px;
    filter: alpha(opacity = 90);
