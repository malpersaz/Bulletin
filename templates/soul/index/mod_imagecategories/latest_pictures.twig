{{ run({"mod": "index", "method": "_latest_pictures", "extra": ["6", "url,name,category_id,kat_ad,kat_seo,keywords"]}) }}
{% set latest_pictures = ctx_get('latest_pictures') %}
{% if latest_pictures is not empty %}
    <div class="index_resimler">
        <div class="index_pictures_ust">
            <h3>{{ lang.index.latest_pictures }}</h3>
        </div>
        <div class="index_pictures_kutu">
            <ul class="clearfix">
                {% for image in latest_pictures %}
                    <li>
                        <a href="{{ site.sadres }}rkat/{{ image.category_seo }}"
                           title="{% if image.name == '#' %}{{ image.category_ad }}{% else %}{{ image.name }}{% endif %}">
                            <img src="{{ site.radres }}mod_gallery/{{ image.category_id }}/thumb/{{ image.url }}"
                                 parent_id="{{ image.name }},{{ image.keywords }}">
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endif %}
