{% extends "layouts/base.twig" %}

{% block body_class %}soul-home{% endblock %}
{% block content_container_class %}soul-home-stage{% endblock %}

{% block js_custom %}
<script>
$(document).ready(function () {
    var mainSlider = $('#mainSlider');
    if (mainSlider.length) {
        mainSlider.carousel({
            interval: 6000,
            wrap: true,
            pause: false,
            touch: true
        });
    }
});
</script>
{% endblock %}

{% block content %}
    {% include 'index/mod_slider/slider.twig' %}
{% endblock %}
