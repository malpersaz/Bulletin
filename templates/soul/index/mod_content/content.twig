{% extends "layouts/base.twig" %}

{% block css_custom %}
    <link rel="stylesheet" href="{{ site.tadres }}{{ site.app_template }}/static/css/content.css?v={{ "now"|date("U") }}">
{% endblock %}

{% set d = ctx_get('d') %}
{% set kategoriler = ctx_get('categories') %}
{% set res = ctx_get('res') %}
{% set altsayfalar = ctx_get('altsayfalar') %}
{% set contents = ctx_get('contents') %}
{% set video = ctx_get('video') %}
{% set dosya = ctx_get('file') %}

{% block canonical %}
    <link rel="canonical" href="{{ site.sadres }}article/{{ d.seo }}" />
{% endblock %}

{% block title %}
    <title>{{ d.title }} - {{ site.title }}</title>
{% endblock %}

{% block description %}
    <meta name="description" content="{{ d.description }}">
{% endblock %}

{% block keywords %}
    <meta name="keywords" content="{{ d.keywords }}">
{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ d.name }}",
  "image": "{% if d.image is not empty %}{{ site.radres }}mod_content/thumb/{{ d.image }}{% else %}{{ site.radres }}mod_settings/logo.png{% endif %}",
  "author": {
    "@type": "Organization",
    "name": "{{ site.title }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.title }}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.tadres }}{{ site.app_template }}/static/img/apple-touch-icon.png"
    }
  },
  "datePublished": "{{ d.created_at|date('Y-m-d') }}",
  "description": "{{ d.description }}"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
    "@type": "ListItem",
    "position": 1,
    "name": "{{ lang.index.home }}",
    "item": "{{ site.sadres }}"
  },{
    "@type": "ListItem",
    "position": 2,
    "name": "{{ lang.index.mod_content[2] }}",
    "item": "{{ site.sadres }}category"
  },{
    "@type": "ListItem",
    "position": 3,
    "name": "{{ d.categoryname }}",
    "item": "{{ site.sadres }}category/{{ d.category_seo }}"
  },{
    "@type": "ListItem",
    "position": 4,
    "name": "{{ d.name }}"
  }]
}
</script>
{% endblock %}

{% block content %}
<div class="row mt-4" id="mod_content">

    <!-- Ana İçerik -->
    <div class="col-lg-8 offset-lg-2">
        <article class="card">
            <div class="card-header bg-body-secondary">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0" itemscope itemtype="https://schema.org/BreadcrumbList">
                        <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                            <a itemprop="item" href="{{ site.sadres }}"><span itemprop="name">{{ lang.index.home }}</span></a>
                            <meta itemprop="position" content="1" />
                        </li>
                        <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                            <a itemprop="item" href="{{ site.sadres }}category"><span itemprop="name">{{ lang.index.mod_content[2] }}</span></a>
                            <meta itemprop="position" content="2" />
                        </li>
                        <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                            <a itemprop="item" href="{{ site.sadres }}category/{{ d.category_seo }}"><span itemprop="name">{{ d.categoryname }}</span></a>
                            <meta itemprop="position" content="3" />
                        </li>
                        <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                            <span itemprop="name">{{ d.name }}</span>
                            <meta itemprop="position" content="4" />
                        </li>
                    </ol>
                </nav>
            </div>
            <div class="card-body">
                <a href="{{ site.sadres }}category/{{ d.category_seo }}" class="badge bg-primary text-white text-decoration-none mb-2">{{ d.categoryname }}</a>
                <h1 class="card-title fs-2 fw-bold mb-3">{{ d.name }}</h1>

                <div class="d-flex justify-content-between align-items-center mb-3 border-top border-bottom py-2">
                    <p class="text-muted small mb-0">
                        Yayınlanma Tarihi: <time datetime="{{ d.created_at|date('Y-m-d') }}">{{ d.created_at|date('d.m.Y') }}</time>
                    </p>
                    <div class="btn-group" role="group" aria-label="İçerik Araçları">
                        <a href="{{ site.sadres }}tools/saveHtml/mod_content/{{ d.id }}" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="HTML olarak indir"><i class="bi bi-file-earmark-arrow-down"></i></a>
                        <a href="{{ site.sadres }}tools/saveText/mod_content/{{ d.id }}" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Metin olarak indir"><i class="bi bi-file-text"></i></a>
                        {% if res is not empty %}
                            <a href="{{ site.sadres }}tools/saveAll/mod_content/{{ d.id }}" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Tüm resimleri indir"><i class="bi bi-images"></i></a>
                        {% endif %}
                        <a href="javascript:void(0)" onclick="window.print();" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Yazdır"><i class="bi bi-printer"></i></a>
                    </div>
                </div>

                <div class="clearfix">
                    <div class="float-start me-4 mb-3" style="max-width: 50%;">
                        {# Main Image #}
                        {% if d.image is not empty %}
                            <a href="{{ site.radres }}mod_content/{{ d.image }}" data-bs-toggle="lightbox" data-gallery="content-main-image">
                                <img src="{{ site.radres }}mod_content/thumb/{{ d.image }}" class="img-fluid rounded mb-3" alt="{{ d.name }}" title="{{ d.name }}">
                            </a>
                        {% else %}
                            <img src="{{ site.radres }}mod_settings/logo.png" class="img-fluid rounded mb-3" alt="{{ d.name }}" title="{{ d.name }}" style="max-height: 250px; object-fit: contain;">
                        {% endif %}

                        {# Videos - Moved Here #}
                        {% if video is not empty %}
                        <section id="mod_video_embedeo" aria-labelledby="video-title">
                            <div class="row">
                                {% for v in video %}
                                    {% if v.embed is defined and v.embed is not empty %}
                                        <div class="col-12 mb-3">
                                            <div class="ratio ratio-16x9">
                                                {{ v.embed|raw }}
                                            </div>
                                            <p class="fw-bold mt-2 small">{{ v.name }}</p>
                                        </div>
                                    {% else %}
                                        <div class="col-12 mb-3">
                                            <a href="{{ site.sadres }}tools/videoFlv/mod_content/{{ d.id }}/{{ v.id }}/show.mp4"
                                               class="video-card-wrapper"
                                               data-bs-toggle="lightbox"
                                               data-gallery="videos"
                                               data-title="{{ v.name }}">
                                                <div class="video-poster" style="background-image: url('{{ site.adres }}tools/videoResim/mod_content/{{ d.id }}/{{ v.id }}/show.jpg');">
                                                    <i class="bi bi-play-circle-fill play-icon"></i>
                                                </div>
                                                <p class="fw-bold mt-2 small">{{ v.name }}</p>
                                            </a>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </section>
                        {% endif %}
                    </div>

                    {# Main Text - This will wrap around the floating div #}
                    {% if d.spot is defined and d.spot == 'y' and d.summary is not empty %}
                        <p class="lead mb-3">{{ d.summary }}</p>
                    {% endif %}
                    <div class="content-body">
                        {{ d.content|raw }}
                    </div>
                </div>

                <!-- Resim Galerisi (Masonry) -->
                {% if res is not empty %}
                <section class="mt-5" id="mod_gallery" aria-labelledby="gallery-title">
                    <h2 id="gallery-title" class="h4 mb-3">{{ lang.index.mod_pictures[1] }}</h2>
                    <div class="row" data-masonry='{"percentPosition": true }' data-bs-images-loaded="true">
                        {% for r in res %}
                            <div class="col-sm-6 col-lg-4 mb-4">
                                <a href="{{ site.radres }}mod_gallery/mod_content/original/{{ r.url }}"
                                   data-bs-toggle="lightbox"
                                   data-gallery="multiimages"
                                   data-title="{{ r.name }}"
                                   aria-label="Resmi büyüt: {{ r.name }}">
                                    <img src="{{ site.radres }}mod_gallery/mod_content/thumb/{{ r.url }}" class="img-fluid rounded" alt="{{ r.name }}">
                                </a>
                                {% if r.name %}
                                <p class="text-center small mt-2">{{ r.name }}</p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </section>
                {% endif %}

                <!-- Dosyalar -->
                {% if dosya is not empty %}
                <section class="mt-5" aria-labelledby="files-title">
                    <h2 id="files-title" class="h4 mb-3"><i class="bi bi-download me-2"></i>{{ lang.index.mod_file[1] }}</h2>
                    <div class="list-group">
                        {% for do in dosya %}
                            {% set extension = do.name|split('.')|last|lower %}
                            {% set file_icon = 'bi-file-earmark-arrow-down' %} {# Default icon #}
                            {% if extension == 'pdf' %}
                                {% set file_icon = 'bi-file-earmark-pdf' %}
                            {% elseif extension == 'zip' or extension == 'rar' %}
                                {% set file_icon = 'bi-file-earmark-zip' %}
                            {% elseif extension == 'doc' or extension == 'docx' or extension == 'odt' %}
                                {% set file_icon = 'bi-file-earmark-word' %}
                            {% elseif extension == 'xls' or extension == 'xlsx' %}
                                {% set file_icon = 'bi-file-earmark-excel' %}
                            {% elseif extension == 'ppt' or extension == 'pptx' %}
                                {% set file_icon = 'bi-file-earmark-ppt' %}
                            {% elseif extension == 'jpg' or extension == 'jpeg' or extension == 'png' or extension == 'gif' %}
                                {% set file_icon = 'bi-file-earmark-image' %}
                            {% elseif extension == 'epub' %}
                                {% set file_icon = 'bi-book' %}
                            {% endif %}
                            <a href="{{ site.adres }}tools/saveFile/mod_content/{{ d.id }}/{{ do.id }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi {{ file_icon }} me-2"></i>
                                    <span>{{ do.name }}</span>
                                </div>
                                <span class="badge bg-primary rounded-pill">{{ lang.index.download }}</span>
                            </a>
                        {% endfor %}
                    </ul>
                </section>
                {% endif %}

            </div>
        </article>

        {# Related Content Section #}
        {% if contents is not empty %}
        <section class="mt-5" aria-labelledby="related-articles-title">
            <h2 id="related-articles-title" class="h4 mb-3"><i class="bi bi-journal-text me-2"></i>{{ lang.index.mod_content[2] }}</h2>
            <div class="row">
                {% for content in contents %}
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <a href="{{ site.sadres }}article/{{ content.seo }}" title="{{ content.name }}">
                                {% if content.image is not empty %}
                                    <img src="{{ site.radres }}mod_content/thumb/{{ content.image }}" class="card-img-top" alt="{{ content.name }}">
                                {% else %}
                                    <img src="{{ site.radres }}mod_settings/logo.png" class="card-img-top p-3 bg-light" alt="{{ content.name }}" style="object-fit: contain;">
                                {% endif %}
                            </a>
                            <div class="card-body">
                                <h5 class="card-title">
                                    <a href="{{ site.sadres }}article/{{ content.seo }}" title="{{ content.name }}">{{ content.name }}</a>
                                </h5>
                                <p class="card-text text-muted small">{{ content.summary|striptags|slice(0, 100) }}...</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        {# Subpages Section #}
        {% if altsayfalar is not empty %}
        <section class="card mt-5" aria-labelledby="subpages-title">
            <div class="card-header">
                <h2 id="subpages-title" class="h5"><i class="bi bi-hdd-stack me-2"></i>{{ lang.index.mod_content[3] }}</h2>
            </div>
            <div class="list-group list-group-flush">
                {% for sayfa in altsayfalar %}
                    <a href="{{ site.sadres }}s/{{ sayfa.seo }}" class="list-group-item list-group-item-action" title="{{ sayfa.summary|striptags|slice(0, 100) }}">
                        {{ sayfa.name }}
                    </a>
                {% endfor %}
            </div>
        </section>
        {% endif %}

    </div>

</div>
{% endblock %}

{% block js_custom %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    // GLightbox
    const lightbox = GLightbox({
        selector: '[data-bs-toggle="lightbox"]'
    });
});
</script>
{% endblock %}