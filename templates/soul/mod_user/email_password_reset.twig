{% extends "layout.twig" %}

{% block content %}
{{ ctx_get('name') }}
{{ ctx_get('last_name') }}
{{ ctx_get('code') }}
{{ ctx_get('ip') }}

{{ lang.email.hello }} <b>{{ name }} {{ last_name }}</b>
<br />
{{ site.adres }} {{ lang.email.password_reset_request }}
<br />
{{ lang.email.please_click }} <a href="{{ site.adres }}reset-password/{{ code }}">{{ lang.email.click_here }}</a> {{ lang.email.click_action }}
<br />
{{ lang.email.reset_link_fallback }}
<br />
"{{ site.adres }}reset-password/{{ code }}"
<br />
<b>{{ lang.email.note }}</b> {{ lang.email.reset_info }}
<br />
{{ lang.email.ip_address }} <b>{{ ip }}</b>
{% endblock %}
