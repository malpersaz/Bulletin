{% extends "layouts/base.twig" %}

{% block content %}
{% set oke = ctx_get('oke') %}
{% set mesaj = ctx_get('mesaj') %}
{% set hatalar = ctx_get('hatalar') %}
{% set code = ctx_get('code') %}
{% set captcha_image = ctx_get('captcha_image') %}
<div class="sayfa">
    <div class="sayfa_ust">
        <h2>{{ lang.mod_user.activation.title }}</h2>
    </div>
    <div class="sayfa_icerik">
        {% if oke is defined %}
            <p class="mesaj oke">{{ mesaj }}</p>
        {% else %}
            <p class="mesaj bilgi">{{ lang.mod_user.activation.lost_code }}</p>
            <br />
            <p class="mesaj hakkinda">{{ lang.mod_user.activation.write_code }}</p>
            {% if hatalar is defined %}
                {% for hata in hatalar %}
                    <p class="mesaj hata">
                        <strong>{{ hata }}</strong>
                    </p>
                {% endfor %}
            {% endif %}
            <form method="post" action="" id="activation">
                <!-- İnputlar Kısım Başlar-->
                <div class="inputlar">
                    <p>
                        <label for="code">{{ lang.mod_user.activation.activation_code }}:</label>
                        <input class="validate[required,length[20,20]]"
                               type="text"
                               name="code"
                               id="code"
                               value="{{ code }}" />
                    </p>
                    <br>
                    <p>
                        <label for="captcha">{{ lang.mod_user.activation.security_code }}:</label>
                        <input class="validate[required]"
                               type="text"
                               name="captcha"
                               id="captcha"
                               parent_id="captcha" />
                    </p>
                    <br>
                    <p>
                        <label for="activation">
                            <img src="{{ captcha_image }}">
                        </label>
                        <input name="activation"
                               type="submit"
                               value="{{ lang.mod_user.activation.activate_button }}">
                    </p>
                </div>
                <!-- İnputlar Kısmı Biter -->
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}
