<!DOCTYPE html>
<html lang="{{ site.lang }}" data-bs-theme="light" class="h-100">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light dark">

		<script>
			(function () {
				const savedTheme = localStorage.getItem('theme');
				if (savedTheme) {
					document.documentElement.setAttribute('data-bs-theme', savedTheme);
					return;
				}

				const cookieTheme = document.cookie.match(/color_mode=([^;]+)/);
				if (cookieTheme) {
					document.documentElement.setAttribute('data-bs-theme', cookieTheme[1]);
				}
			})();
		</script>

		{% block title %}
			<title>{{ site.title }}</title>
		{% endblock %}
		{% block description %}<meta name="description" content="{{ site.description }}">
		{% endblock %}
		{% block keywords %}<meta name="keywords" content="{{ site.keywords }}">
		{% endblock %}
		{% block canonical %}<link rel="canonical" href="{{ site.adres }}"/>
		{% endblock %}

		{% block meta_tags %}
			<meta name="author" content="{{ site.title }}">
			<meta name="robots" content="index, follow">
			<meta name="theme-color" content="#0f1014">

			<meta property="og:type" content="website">
			<meta property="og:url" content="{{ site.adres }}">
			<meta property="og:title" content="{{ site.title }}">
			<meta property="og:description" content="{{ site.description }}">
			<meta property="og:image" content="{{ site.radres }}mod_settings/logo.png">
			<meta property="og:site_name" content="{{ site.title }}">
			<meta property="og:locale" content="{{ site.lang }}_{{ site.lang|upper }}">

			<meta name="twitter:card" content="summary_large_image">
			<meta name="twitter:url" content="{{ site.adres }}">
			<meta name="twitter:title" content="{{ site.title }}">
			<meta name="twitter:description" content="{{ site.description }}">
			<meta name="twitter:image" content="{{ site.radres }}mod_settings/logo.png">
		{% endblock %}

		<base href="{{ site.adres }}">

		<link rel="icon" type="image/png" href="{{ site.radres }}mod_settings/favicon-96x96.png" sizes="96x96"/>
		<link rel="shortcut icon" href="{{ site.radres }}mod_settings/favicon.ico"/>
		<link rel="apple-touch-icon" sizes="180x180" href="{{ site.radres }}mod_settings/apple-touch-icon.png"/>
		<link rel="manifest" href="{{ site.adres }}static/mod_settings/site.webmanifest"/>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Cormorant+Garamond:wght@500;600;700&display=swap" rel="stylesheet">

		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.2.0/dist/css/glightbox.min.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">

		<link rel="stylesheet" href="{{ site.tadres }}{{ site.app_template }}/static/css/custom.css?v={{ "now"|date("U") }}">
		<link rel="stylesheet" href="{{ site.tadres }}{{ site.app_template }}/static/css/soul-shell.css?v={{ "now"|date("U") }}">

		{% block css_custom %}{% endblock %}
		{% block head %}{% endblock %}
	</head>
	<body class="d-flex flex-column h-100 {% block body_class %}{% endblock %}">
		{{ run({"mod": "index", "method": "_menu"}) }}
		{% set menu = ctx_get('menu') %}

		{% include 'index/mod_menu/soul_top_menu.twig' %}

		<main class="flex-shrink-0 flex-grow-1 {% block main_class %}{% endblock %}">
			<div class="{% block content_container_class %}container soul-page-shell{% endblock %}">
				{% block content %}{% endblock %}
			</div>
		</main>

		{% include "index/footer.twig" %}

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
		<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/glightbox@3.2.0/dist/js/glightbox.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/tr.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
		<script src="https://cdn.jsdelivr.net/npm/masonry-layout@4.2.2/dist/masonry.pkgd.min.js" integrity="sha384-GNFwBvfVxBkLMJpYMOABq3c+d3KnQxudP/mGPkzpZSTYykLBNsZEnG2D9G/X/+7D" crossorigin="anonymous" async></script>
		<script src="https://unpkg.com/imagesloaded@5/imagesloaded.pkgd.min.js"></script>
		<script src="{{ site.tadres }}base_static/js/jquery.js"></script>
		<script src="{{ site.tadres }}base_static/js/jquery.cookie.js"></script>

		{% block js_custom %}{% endblock %}

		{% if ctx_get('javascript') is not empty %}
			<script>
{% for script in ctx_get('javascript') %}
{{ script|raw }}
{% endfor %}
			</script>
		{% endif %}

		{% if ctx_get('jquery_document') is not empty %}
			<script>
$(document).ready(function () {
{% for script in ctx_get('jquery_document') %}
{{ script|raw }}
{% endfor %}
});
			</script>
		{% endif %}

		{% include 'partials/_cookie_consent.twig' %}
	</body>
</html>
