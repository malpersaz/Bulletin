{% from "macros/menu.twig" import renderMenu %}
{% set is_logged_in = session.id is defined and session.id is not empty %}
{% set session_username = session.username is defined and session.username is not empty
	? session.username
	: (session.name is defined and session.name is not empty
		? session.name
		: (session.full_name is defined and session.full_name is not empty ? session.full_name : 'User')) %}
{% set session_display_name = session.full_name is defined and session.full_name is not empty
	? session.full_name
	: (session.name is defined and session.name is not empty ? session.name : session_username) %}
{% set session_logout_sid = session.sid is defined and session.sid is not empty ? session.sid : null %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Pirata+One&family=UnifrakturMaguntia&family=Literata:ital,opsz,wght@0,7..72,200..900;1,7..72,200..900&display=swap" rel="stylesheet">

<nav class="navbar navbar-expand-lg sticky-top shadow-sm" role="navigation" aria-label="Ana navigasyon" id="defaultMainHeader">
	<div
		class="container">
		<!-- Brand/Logo -->
		<a class="navbar-brand d-flex align-items-center {% if site.show_logo|default('y') == 'y' and site.logo_path is defined and site.logo_path is not empty %}has-image-logo{% endif %}" href="{{ site.sadres }}" title="{{ site.title }}" aria-label="{{ site.title }} ana sayfa">
			{% if site.show_logo|default('y') == 'y' and site.logo_path is defined and site.logo_path is not empty %}
				<img src="{{ site.radres }}mod_settings/{{ site.logo_path }}" alt="{{ site.title }}" class="me-2 d-inline-block align-text-top logo-image" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; background-color: #ffffff;">
			{% else %}
				{% if site.show_logo|default('y') == 'y' %}
					<span class="brand-mark me-2 d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle" style="width: 40px; height: 40px; font-family: 'Pirata One', system-ui; font-weight: bold; font-size: 1.2rem;">{{ site.title|slice(0, 1) }}</span>
				{% endif %}
                <span class="brand-text brand-text-gothic">{{ site.title }}</span>
			{% endif %}
		</a>

		<!-- Mobile toggle button -->
		<button class="navbar-toggler border-0 p-2" type="button" data-bs-toggle="collapse" data-bs-target="#defaultMobileMenu" aria-controls="defaultMobileMenu" aria-expanded="false" aria-label="{{ lang.index.toggle_menu }}">
			<span class="navbar-toggler-icon"></span>
		</button>

		<!-- Collapsible content -->
		<div
			class="collapse navbar-collapse" id="defaultMobileMenu">
			<!-- Main Navigation -->
			<ul class="navbar-nav me-auto mb-2 mb-lg-0">
				{% if menu is defined and menu is not empty %}
					{{ renderMenu(menu, 0, 0, 0) }}
				{% endif %}
			</ul>

			<!-- Search Form -->
			<form class="search-form d-flex me-3" role="search" method="get" action="{{ site.sadres }}index/search/">
				<div class="search-wrapper w-100 position-relative">
					<button class="search-btn" type="submit" aria-label="{{ lang.index.search.search }}" title="{{ lang.index.search.search }}">
						<i class="bi bi-search"></i>
					</button>
					<input type="search" name="kelime" class="form-control search-input" placeholder="{{ lang.index.search.search }}..." aria-label="{{ lang.index.search.search }}" autocomplete="off">
				</div>
			</form>

			<!-- User Section -->
			<div class="user-section d-flex align-items-center">
				<!-- Desktop: Language & Dark Mode -->
				<!-- Desktop Language Selector (Hidden on Mobile) -->
					<div class="language-selector d-none d-lg-block">
						<div class="dropdown">
							<button class="btn btn-link text-muted p-1 border-0 bg-transparent dropdown-toggle" type="button" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="{{ lang.index.language }}" style="text-decoration: none !important;">
								<span class="current-lang-badge">{{ site.lang|upper }}</span>
							</button>

							<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
								<li>
									<h6 class="dropdown-header">{{ lang.index.language }}</h6>
								</li>
								{% if site.available_languages is defined %}
									{% for l in site.available_languages %}
										<li>
											<a class="dropdown-item {% if site.lang == l.code %}active{% endif %}" href="{{ site.adres }}{{ l.code }}">
												{{ l.name }}
												{% if site.lang == l.code %}
													<i class="bi bi-check2 float-end text-success"></i>
												{% endif %}
											</a>
										</li>
									{% endfor %}
								{% endif %}
							</ul>
						</div>
					</div>




				<!-- Desktop Dark Mode Toggle -->
				<button class="btn btn-link text-muted me-2 p-1 border-0 bg-transparent d-none d-lg-flex" id="darkModeToggle" type="button" aria-label="{{ lang.index.dark_mode }}" title="{{ lang.index.dark_mode }}">
					<i class="bi bi-moon-stars fs-5"></i>
				</button>

				{% if is_logged_in %}
					<!-- Logged in user -->
					<div class="dropdown">
						<button class="btn btn-link user-profile-btn p-0 border-0 bg-transparent" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" role="button">
							<div class="user-avatar-container">
								{% if session.image is defined and session.image is not empty and session.image != 'avatar.png' %}
									<img src="{{ site.adres }}static/mod_user/{{ session.image }}" alt="{{ session_username }}" class="user-avatar rounded-circle" width="32" height="32" style="object-fit: cover;">
								{% else %}
									<div class="user-avatar rounded-circle d-flex align-items-center justify-content-center bg-primary text-white" style="width: 32px; height: 32px; font-weight: 600; font-size: 16px;">
										{{ session_display_name|slice(0, 1)|upper }}
									</div>
								{% endif %}
								<div class="avatar-status-indicator online"></div>
							</div>
							<span class="user-name d-none d-md-inline">
								{{ session_display_name }}
							</span>
							<svg width="18" height="18" viewbox="0 0 24 24" fill="none" style="opacity: 0.7; margin-left: 2px;">
								<path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" fill="currentColor"/>
							</svg>
						</button>

						<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
							<li class="dropdown-header">
								<div class="d-flex align-items-center">
									{% if session.image is defined and session.image is not empty and session.image != 'avatar.png' %}
										<img src="{{ site.adres }}static/mod_user/{{ session.image }}" alt="{{ session_username }}" class="rounded-circle me-2" width="24" height="24" style="object-fit: cover;">
									{% else %}
										<div class="rounded-circle me-2 d-flex align-items-center justify-content-center bg-primary text-white" style="width: 24px; height: 24px; font-weight: 600; font-size: 12px;">
											{{ session_display_name|slice(0, 1)|upper }}
										</div>
									{% endif %}
									<div>
										{% if session.full_name is defined and session.full_name is not empty %}
											<div class="fw-bold">{{ session.full_name }}</div>
											<small class="text-muted">@{{ session_username }}</small>
										{% else %}
											<div class="fw-bold">{{ session_username }}</div>
										{% endif %}
									</div>
								</div>
							</li>
							<li><hr class="dropdown-divider"></li>
							<li>
								<a class="dropdown-item" href="{{ site.sadres }}mod_user_pm/inbox">
									<i class="bi bi-envelope me-2"></i>
									{{ lang.index.messages }}
									{% if session.okunmamis is defined and session.okunmamis > 0 %}
										<span class="badge bg-danger ms-auto">{{ session.okunmamis }}</span>
									{% endif %}
								</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ site.sadres }}mod_user/panel/{{ session.id }}">
									<i class="bi bi-person-circle me-2"></i>
									{{ lang.index.my_account }}
								</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ site.sadres }}mod_news/add">
									<i class="bi bi-newspaper me-2"></i>
									{{ lang.index.add_news }}
								</a>
							</li>
							<li>
								<a class="dropdown-item" href="{{ site.sadres }}mod_publication/add">
									<i class="bi bi-journal-richtext me-2"></i>
									{{ lang.index.add_publication }}
								</a>
							</li>
							<li><hr class="dropdown-divider"></li>

							<li>
								<a class="dropdown-item text-danger" href="{{ site.sadres }}logout{% if session_logout_sid %}/{{ session_logout_sid }}{% endif %}">
									<i class="bi bi-box-arrow-right me-2"></i>
									{{ lang.index.logout }}
								</a>
							</li>
						</ul>
					</div>
				{% else %}
					<!-- Guest user -->
					<div class="auth-buttons">
						<button class="btn btn-outline-primary btn-sm me-2" data-bs-toggle="modal" data-bs-target="#loginModal">
							<i class="bi bi-box-arrow-in-right me-1"></i>
							<span class="d-none d-sm-inline">{{ lang.index.login }}</span>
						</button>
						<a href="{{ site.sadres }}register" class="btn btn-primary btn-sm">
							<i class="bi bi-person-plus me-1"></i>
							<span class="d-none d-sm-inline">{{ lang.index.register }}</span>
						</a>
					</div>
				{% endif %}

				
				<!-- Mobile Controls Row (Language & Dark Mode) -->
				<div class="mobile-controls-row d-lg-none w-100 mt-3 pt-3 border-top">
					<div class="d-flex align-items-start gap-2">
						<!-- Language Selector (Flex Grow) -->
						<div class="language-selector flex-grow-1">
							<div class="dropdown">
								<button class="btn btn-light w-100 d-flex align-items-center justify-content-between p-3 border rounded-3 dropdown-toggle" type="button" id="languageDropdownMobile" data-bs-toggle="dropdown" aria-expanded="false" title="{{ lang.index.language }}">
									<div class="d-flex align-items-center">
										<i class="bi bi-translate me-2 text-muted"></i>
										<span class="fw-bold">{{ site.lang|upper }}</span>
									</div>
									<i class="bi bi-chevron-down small text-muted"></i>
								</button>

								<ul class="dropdown-menu shadow-lg border-0" aria-labelledby="languageDropdownMobile">
									<li>
										<h6 class="dropdown-header bg-light">{{ lang.index.language }}</h6>
									</li>
									{% if site.available_languages is defined %}
										{% for l in site.available_languages %}
											<li><a class="dropdown-item {% if site.lang == l.code %}active{% endif %}" href="{{ site.adres }}{{ l.code }}">{{ l.name }} {% if site.lang == l.code %}<i class="bi bi-check2 float-end"></i>{% endif %}</a></li>
										{% endfor %}
									{% endif %}
								</ul>
							</div>
						</div>

						<!-- Dark Mode Toggle (Fixed Width) -->
						<div class="mobile-dark-mode">
							<button class="btn btn-light border rounded-3 p-3 d-flex align-items-center justify-content-center" id="darkModeToggleMobile" type="button" aria-label="{{ lang.index.dark_mode }}" style="width: 54px; height: 58px;">
								<i class="bi bi-moon-stars fs-5"></i>
							</button>
						</div>
					</div>
				</div>
			</div>
	</div>

</nav>

<!-- Mobile Menu Overlay -->
<div class="mobile-overlay"></div>

<!-- Login Modal -->
{% if not is_logged_in %}
	<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header border-0">
					<h5 class="modal-title" id="loginModalLabel">
						<i class="bi bi-box-arrow-in-right me-2"></i>
						{{ lang.index.login }}
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ lang.index.modal.close }}"></button>
				</div>
				<div class="modal-body">
					<form action="{{ site.sadres }}login" method="post" id="loginForm">
						<!-- Step 1: Username -->
						<div id="loginStep1" class="login-step">
							<div class="mb-3">
								<label for="loginUsername" class="form-label">{{ lang.index.modal.username_label }}</label>
								<div class="input-group">
									<span class="input-group-text"><i class="bi bi-person"></i></span>
									<input type="text" class="form-control" id="loginUsername" name="username" required autocomplete="username">
								</div>
							</div>
							<button type="button" class="btn btn-primary w-100" id="btnNextStep">
								{{ lang.index.modal.next }}
								<i class="bi bi-arrow-right ms-2"></i>
							</button>
						</div>

						<!-- Step 2: Password (Hidden by default) -->
						<div id="loginStep2" class="login-step d-none">
							<div class="d-flex align-items-center mb-2">
								<button type="button" class="btn btn-link p-0 text-decoration-none me-2" id="btnBackToStep1">
									<i class="bi bi-arrow-left"></i>
								</button>
								<span id="displayUsername" class="fw-bold text-primary"></span>
							</div>

							<div class="mb-3">
								<label for="loginPassword" class="form-label">{{ lang.index.modal.password_label }}</label>
								<div class="input-group">
									<span class="input-group-text"><i class="bi bi-lock"></i></span>
									<input type="password" class="form-control" id="loginPassword" name="password" required autocomplete="current-password">
									<button class="btn btn-outline-secondary" type="button" id="togglePassword">
										<i class="bi bi-eye" id="togglePasswordIcon"></i>
									</button>
								</div>
							</div>
							<div class="d-flex justify-content-between align-items-center mb-3">
								<div class="form-check">
									<input class="form-check-input" type="checkbox" id="rememberMe" name="remember">
									<label class="form-check-label" for="rememberMe">
										{{ lang.index.modal.remember_me }}
									</label>
								</div>
								<a href="{{ site.sadres }}forgot-password" class="text-decoration-none">
									{{ lang.index.modal.forgot_password }}
								</a>
							</div>
							<button type="submit" class="btn btn-primary w-100" name="login">
								<i class="bi bi-box-arrow-in-right me-2"></i>
								{{ lang.index.login }}
							</button>
						</div>
					</form>
					<div class="text-center mt-3">
						<span class="text-muted">{{ lang.index.modal.no_account_question }}
						</span>
						<a href="{{ site.sadres }}register" class="text-decoration-none">{{ lang.index.modal.register_link_text }}</a>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endif %}

<!-- CSS -->
<link rel="stylesheet" href="{{ site.tadres }}{{ site.app_template }}/static/css/top-menu.css?v={{ "now"|date("U") }}">
<link rel="stylesheet" href="{{ site.tadres }}{{ site.app_template }}/static/css/login-modal.css?v={{ "now"|date("U") }}">

<!-- JavaScript -->
<script src="{{ site.tadres }}{{ site.app_template }}/static/js/top-menu.js?v={{ "now"|date("U") }}"></script>

<!-- Login Modal Language Variables -->
<script>
	window.loginModalMessages = {
		signingIn: '{{ lang.index.modal.signing_in }}',
		loginSuccess: '{{ lang.index.modal.login_success }}',
		loginFailed: '{{ lang.index.modal.login_failed }}',
		connectionError: '{{ lang.index.modal.connection_error }}',
		networkError: '{{ lang.index.modal.network_error }}',
		timeoutError: '{{ lang.index.modal.timeout_error }}',
		serverError: '{{ lang.index.modal.server_error }}',
		pleaseFillAll: '{{ lang.index.modal.please_fill_all }}',
		redirecting: '{{ lang.index.modal.redirecting }}',
		alternativeOptions: '{{ lang.index.modal.alternative_options }}',
		showPassword: '{{ lang.index.modal.show_password }}',
		hidePassword: '{{ lang.index.modal.hide_password }}',
		checkUserUrl: '{{ site.sadres }}mod_user/checkUserExistence'
	};
</script>

<script src="{{ site.tadres }}{{ site.app_template }}/static/js/login-modal.js?v=5"></script>
