{% extends "layouts/base.twig" %}

{% block title %}
    <title>{{ title }}</title>
{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center align-items-center" style="min-height: 50vh;">
        <div class="col-12 col-md-8 col-lg-6 text-center">
            <div class="error-card p-5 rounded-4 shadow-sm border border-danger-subtle bg-body-tertiary">
                <div class="error-icon-wrapper mb-4">
                    <span class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle p-4" style="width: 80px; height: 80px;">
                        <i class="bi bi-exclamation-triangle fs-1"></i>
                    </span>
                </div>
                <h1 class="display-6 fw-bold text-danger mb-3">{{ title }}</h1>
                <p class="lead text-muted mb-4">{{ mesaj|raw }}</p>
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a href="{{ site.saddress }}" class="btn btn-primary btn-lg px-4 gap-3 rounded-pill shadow-sm">
                        <i class="bi bi-house-door-fill me-2"></i>{{ lang.index.home }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
