{% extends "layouts/base.twig" %}

{% block css_custom %}
	<link rel="stylesheet" href="{{ site.tadres }}{{ site.app_template }}/static/css/news.css?v={{ "now"|date("U") }}">
	<link rel="stylesheet" href="{{ site.tadres }}{{ site.app_template }}/static/css/gallery.css?v={{ "now"|date("U") }}">
{% endblock %}

{% set d = ctx_get('d') %}
{% set kategoriler = ctx_get('categories') %}
{% set res = ctx_get('res') %}
{% set altsayfalar = ctx_get('altsayfalar') %}
{% set newses = ctx_get('newses') %}
{% set video = ctx_get('video') %}
{% set dosya = ctx_get('file') %}

{% block canonical %}
	<link rel="canonical" href="{{ site.sadres }}news/{{ d.seo }}"/>
{% endblock %}

{% block title %}
	<title>{{ d.title }} - {{ site.title }}</title>
{% endblock %}

{% block description %}
	<meta name="description" content="{{ d.description }}">
{% endblock %}

{% block keywords %}
	<meta name="keywords" content="{{ d.keywords }}">
{% endblock %}

{% block meta_tags %}
	<!-- Open Graph / Facebook -->
	<meta property="og:type" content="article">
	<meta property="og:url" content="{{ site.sadres }}news/{{ d.seo }}">
	<meta property="og:title" content="{{ d.title|default(d.name) }}">
	<meta property="og:description" content="{{ d.description|striptags|slice(0, 200) }}">
	{% if d.image is not empty %}
		<meta property="og:image" content="{{ site.radres }}mod_news/{{ d.image }}">
		<meta property="og:image:secure_url" content="{{ site.radres }}mod_news/{{ d.image }}">
		<meta property="og:image:type" content="image/jpeg">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
	{% else %}
		<meta property="og:image" content="{{ site.radres }}mod_settings/logo.png">
	{% endif %}
	<meta property="og:site_name" content="{{ site.title }}">
    {% set og_locale = site.lang ~ '_SE' %}
    {% if site.lang == 'en' %}{% set og_locale = 'en_US' %}
    {% elseif site.lang == 'tr' %}{% set og_locale = 'tr_TR' %}
    {% elseif site.lang == 'de' %}{% set og_locale = 'de_DE' %}
    {% endif %}
	<meta property="og:locale" content="{{ og_locale }}">
	<meta property="article:published_time" content="{{ d.created_at|date('c') }}">
	<meta property="article:modified_time" content="{{ d.updated_at|date('c') }}">
	<meta property="article:section" content="{{ d.categoryname }}">

	<!-- Twitter -->
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:url" content="{{ site.sadres }}news/{{ d.seo }}">
	<meta name="twitter:title" content="{{ d.title|default(d.name) }}">
	<meta name="twitter:description" content="{{ d.description|striptags|slice(0, 200) }}">
	{% if d.image is not empty %}
		<meta name="twitter:image" content="{{ site.radres }}mod_news/{{ d.image }}">
	{% else %}
		<meta name="twitter:image" content="{{ site.radres }}mod_settings/logo.png">
	{% endif %}
{% endblock %}

{% block schema %}
	<script type="application/ld+json">
		{
				  "@context": "https://schema.org",
				  "@type": "Article",
				  "headline": "{{ d.name }}",
				  "image": "{% if d.image is not empty %}{{ site.radres }}mod_news/thumb/{{ d.image }}{% else %}{{ site.radres }}mod_settings/logo.png{% endif %}",
				  "author": {
				    "@type": "Organization",
				    "name": "{{ site.title }}"
				  },
				  "publisher": {
				    "@type": "Organization",
				    "name": "{{ site.title }}",
				    "logo": {
				      "@type": "ImageObject",
				      "url": "{{ site.tadres }}{{ site.app_template }}/static/img/apple-touch-icon.png"
				    }
				  },
				  "datePublished": "{{ d.created_at|date('Y-m-d') }}",
				  "dateModified": "{{ d.updated_at|date('Y-m-d') }}",
				  "description": "{{ d.description }}"
				}
	</script>
    {% if video is not empty %}
        {% for v in video %}
        <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "VideoObject",
              "name": "{{ v.name }}",
              "description": "{{ d.name }} - {{ v.name }}",
              "thumbnailUrl": "{{ site.adres }}tools/videoResim/mod_news/{{ d.id }}/{{ v.id }}/show.jpg",
              "uploadDate": "{{ d.created_at|date('Y-m-d') }}",
              "contentUrl": "{{ site.sadres }}tools/videoFlv/mod_news/{{ d.id }}/{{ v.id }}/show.mp4"
            }
        </script>
        {% endfor %}
    {% endif %}
	<script type="application/ld+json">
		{
				  "@context": "https://schema.org",
				  "@type": "BreadcrumbList",
				  "itemListElement": [{
				    "@type": "ListItem",
				    "position": 1,
				    "name": "{{ lang.index.home }}",
				    "item": "{{ site.sadres }}"
				  },{
				    "@type": "ListItem",
				    "position": 2,
				    "name": "{{ lang.index.mod_news[2] }}",
				    "item": "{{ site.sadres }}newses"
				  },{
				    "@type": "ListItem",
				    "position": 3,
				    "name": "{{ d.categoryname }}",
				    "item": "{{ site.sadres }}newses/{{ d.category_seo }}"
				  },{
				    "@type": "ListItem",
				    "position": 4,
				    "name": "{{ d.name }}"
				  }]
				}
	</script>
{% endblock %}

{% block content %}
	<div class="row mt-4" id="mod_news">

		<!-- Main Content -->
		<div class="col-lg-8 offset-lg-2">
			<article class="card shadow-sm border-0">
				<div class="card-header bg-body-secondary border-0">
					<nav aria-label="breadcrumb">
						<ol class="breadcrumb mb-0" itemscope itemtype="https://schema.org/BreadcrumbList">
							<li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
								<a itemprop="item" href="{{ site.sadres }}">
									<span itemprop="name">{{ lang.index.home }}</span>
								</a>
								<meta itemprop="position" content="1"/>
							</li>
							<li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
								<a itemprop="item" href="{{ site.sadres }}newses">
									<span itemprop="name">{{ lang.index.mod_news[2] }}</span>
								</a>
								<meta itemprop="position" content="2"/>
							</li>
							<li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
								<a itemprop="item" href="{{ site.sadres }}newses/{{ d.category_seo }}">
									<span itemprop="name">{{ d.categoryname }}</span>
								</a>
								<meta itemprop="position" content="3"/>
							</li>
							<li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
								<span itemprop="name">{{ d.name }}</span>
								<meta itemprop="position" content="4"/>
							</li>
						</ol>
					</nav>
				</div>
				<div class="card-body p-4 p-md-5 position-relative">
                    {# Sticky Share for Desktop #}
                    {% include 'partials/share.twig' with {
                        'share_wrap_class': 'share-sticky-sidebar d-none d-lg-block'
                    } %}
					<div class="d-flex align-items-center gap-2 mb-3">
                        <a href="{{ site.sadres }}newses/{{ d.category_seo }}" class="badge bg-primary text-white text-decoration-none">{{ d.categoryname }}</a>
                        {% set readingTime = (d.content|striptags|length / 1000)|round(0, 'ceil') %}
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border"><i class="bi bi-clock me-1"></i>{{ readingTime }} {{ lang.index.min_read }}</span>
                    </div>
					<h1 class="card-title display-5 fw-bold mb-4">{{ d.name }}</h1>

					<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 border-top border-bottom py-3">
                        <div class="d-flex align-items-center gap-3">
                            {% if d.u_name is defined and d.u_name is not empty %}
                                {% if d.username is defined and d.username is not empty %}
                                    <a href="{{ site.sadres }}author/{{ d.username }}" class="text-decoration-none">
                                {% endif %}
                                {% if d.user_image is defined and d.user_image is not empty %}
                                    <img src="{{ site.radres }}mod_user/thumb/{{ d.user_image }}"
                                         alt="{{ d.u_name }} {{ d.u_last_name }}"
                                         class="rounded-circle shadow-sm"
                                         width="56"
                                         height="56"
                                         style="object-fit: cover;">
                                {% else %}
                                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-dark text-white shadow-sm"
                                         style="width: 56px; height: 56px; font-weight: 700;">
                                         {{ (d.u_name|default('')|slice(0, 1) ~ d.u_last_name|default('')|slice(0, 1))|upper }}
                                    </div>
                                {% endif %}
                                {% if d.username is defined and d.username is not empty %}
                                    </a>
                                {% endif %}
                            {% endif %}
                            
                            <div class="small text-muted">
                                {% if d.u_name is defined and d.u_name is not empty %}
                                    {% if d.username is defined and d.username is not empty %}
                                        <div class="fw-semibold text-dark">
                                            <a href="{{ site.sadres }}author/{{ d.username }}" class="text-decoration-none text-dark">
                                                {{ d.u_name }} {{ d.u_last_name }}
                                            </a>
                                        </div>
                                    {% else %}
                                        <div class="fw-semibold text-dark">{{ d.u_name }} {{ d.u_last_name }}</div>
                                    {% endif %}
                                {% endif %}
                                
                                <div class="{% if d.u_name is defined and d.u_name is not empty %}mt-1{% endif %}">
                                    <i class="bi bi-calendar3 me-1"></i> {{ lang.index.publish_date }}:
                                    <time datetime="{{ d.created_at|date('Y-m-d') }}">{{ d.created_at|date('d.m.Y') }}</time>
                                    
                                    {% if d.updated_at != d.created_at %}
                                        <span class="d-block d-md-inline ms-md-3 mt-1 mt-md-0">
                                            <i class="bi bi-pencil-square me-1"></i> {{ lang.index.updated_date }}:
                                            <time datetime="{{ d.updated_at|date('Y-m-d') }}">{{ d.updated_at|date('d.m.Y') }}</time>
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
						<div class="btn-group" role="group" aria-label="News Tools">
							<a href="{{ site.sadres }}tools/saveHtml/mod_news/{{ d.id }}" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" title="{{ lang.index.mod_gallery[1] }}">
								<i class="bi bi-file-earmark-arrow-down"></i>
							</a>
							<a href="{{ site.sadres }}tools/saveText/mod_news/{{ d.id }}" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" title="{{ lang.index.mod_gallery[2] }}">
								<i class="bi bi-file-text"></i>
							</a>
							{% if res is not empty %}
								<a href="{{ site.sadres }}tools/saveAll/mod_news/{{ d.id }}" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" title="{{ lang.index.mod_gallery[3] }}">
									<i class="bi bi-images"></i>
								</a>
							{% endif %}
							<a href="javascript:void(0)" onclick="window.print();" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" title="{{ lang.index.mod_gallery[4] }}">
								<i class="bi bi-printer"></i>
							</a>
						</div>
					</div>

                    {# Mobile Share Block (inline) placed under the title/date #}
                    {% include 'partials/share.twig' with {
                        'share_wrap_class': 'd-block d-lg-none mb-4',
                        'share_container_class': 'justify-content-center'
                    } %}

					<div class="clearfix">
                        {# Deck / Lead Text #}
						{% if d.deck is defined and d.deck == 'y' and d.summary is not empty %}
							<div class="lead-text mb-5">
							    <p class="fs-4 fw-normal text-dark-emphasis border-start border-4 border-primary ps-4 py-1" style="line-height: 1.6;">
							        {{ d.summary }}
                                </p>
                            </div>
						{% endif %}

						{# Main Image #}
						{% if d.image is not empty %}
							<div class="mb-5">
								<a href="{{ site.radres }}mod_news/{{ d.image }}" data-bs-toggle="lightbox" data-gallery="news-main-image">
									<img src="{{ site.radres }}mod_news/{{ d.image }}" fetchpriority="high" class="img-fluid rounded mb-3 w-100 shadow-sm" alt="{{ d.name }}" title="{{ d.name }}" style="aspect-ratio: 16/9; object-fit: cover;">
								</a>
							</div>
						{% else %}
							<div class="mb-5 text-center bg-light rounded p-4">
								<img src="{{ site.radres }}mod_settings/logo.png" class="img-fluid" alt="{{ d.name }}" title="{{ d.name }}" style="max-height: 300px; object-fit: contain;">
							</div>
						{% endif %}

						{# Main Content Text #}
						<div class="news-body fs-5 text-dark" style="line-height: 1.8;">
							{{ d.content|raw }}
						</div>

                        {# Bottom Share block #}
                        {% include 'partials/share.twig' with {
                            'share_wrap_class': 'share-inline d-flex justify-content-center'
                        } %}

                        {# Videos Section #}
                        {% if video is not empty %}
                            <section id="mod_video" class="mt-5 pt-5 border-top" aria-labelledby="video-title">
                                <h2 id="video-title" class="h4 mb-4 fw-bold"><i class="bi bi-play-btn me-2 text-primary"></i>{{ lang.index.mod_video_embed[1] }}</h2>
                                <div class="row">
                                    {% for v in video %}
                                        <div class="col-12 mb-4">
                                            {% if v.embed is defined and v.embed is not empty %}
                                                <div class="ratio ratio-16x9 bg-dark rounded overflow-hidden shadow-sm">
                                                    {{ v.embed|replace({'iframe': 'iframe loading="lazy" title="' ~ v.name ~ '"'})|raw }}
                                                </div>
                                            {% else %}
                                                <a href="{{ site.sadres }}tools/videoFlv/mod_news/{{ d.id }}/{{ v.id }}/show.mp4" class="video-card-wrapper" data-bs-toggle="lightbox" data-gallery="videos" data-title="{{ v.name }}">
                                                    <div class="video-poster rounded shadow-sm" style="background-image: url('{{ site.adres }}tools/videoResim/mod_news/{{ d.id }}/{{ v.id }}/show.jpg'); aspect-ratio: 16/9;">
                                                        <i class="bi bi-play-circle-fill play-icon"></i>
                                                    </div>
                                                </a>
                                            {% endif %}
                                            <p class="fw-bold mt-3 text-center">{{ v.name }}</p>
                                        </div>
                                    {% endfor %}
                                </div>
                            </section>
                        {% endif %}

                        {# Image Gallery Section #}
                        {% if res is not empty %}
                            <section class="mt-5 pt-5 border-top" id="mod_gallery" aria-labelledby="gallery-title">
                                <h2 id="gallery-title" class="h4 mb-4 fw-bold"><i class="bi bi-images me-2 text-primary"></i>{{ lang.index.mod_pictures[1] }}</h2>
                                <div class="row g-3" data-masonry='{"percentPosition": true }' data-bs-images-loaded="true">
                                    {% for r in res %}
                                        <div class="col-6 col-md-4 mb-3">
                                            <div class="card h-100 border-0 shadow-sm overflow-hidden">
                                                <a href="{{ site.radres }}mod_gallery/mod_news/original/{{ r.url }}" data-bs-toggle="lightbox" data-gallery="multiimages" data-title="{{ r.name }}" aria-label="{{ lang.index.enlarge_image }}: {{ r.name }}">
                                                    <img src="{{ site.radres }}mod_gallery/mod_news/thumb/{{ r.url }}" class="card-img-top" alt="{{ r.name }}" style="aspect-ratio: 1/1; object-fit: cover;">
                                                </a>
                                                {% if r.name %}
                                                    <div class="card-body p-2 text-center">
                                                        <p class="card-text small text-muted text-truncate">{{ r.name }}</p>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </section>
                        {% endif %}

                        {# Attachments Section #}
                        {% if dosya is not empty %}
                            <section class="mt-5 pt-5 border-top" aria-labelledby="files-title">
                                <h2 id="files-title" class="h4 mb-4 fw-bold"><i class="bi bi-cloud-download me-2 text-primary"></i>{{ lang.index.mod_attachment[1] }}</h2>
                                <div class="list-group shadow-sm rounded-3 overflow-hidden">
                                    {% for do in dosya %}
                                        {% set extension = do.original_name|split('.')|last|lower %}
                                        {% set file_icon = 'bi-file-earmark-arrow-down' %}
                                        {% set badge_color = 'bg-secondary' %}
                                        
                                        {% if extension == 'pdf' %}{% set file_icon = 'bi-file-earmark-pdf' %}{% set badge_color = 'bg-danger' %}
                                        {% elseif extension == 'zip' or extension == 'rar' %}{% set file_icon = 'bi-file-earmark-zip' %}{% set badge_color = 'bg-warning text-dark' %}
                                        {% elseif extension == 'doc' or extension == 'docx' or extension == 'odt' %}{% set file_icon = 'bi-file-earmark-word' %}{% set badge_color = 'bg-primary' %}
                                        {% elseif extension == 'xls' or extension == 'xlsx' %}{% set file_icon = 'bi-file-earmark-excel' %}{% set badge_color = 'bg-success' %}
                                        {% elseif extension == 'ppt' or extension == 'pptx' %}{% set file_icon = 'bi-file-earmark-ppt' %}{% set badge_color = 'bg-info text-dark' %}
                                        {% elseif extension == 'jpg' or extension == 'jpeg' or extension == 'png' or extension == 'gif' %}{% set file_icon = 'bi-file-earmark-image' %}{% set badge_color = 'bg-info' %}
                                        {% elseif extension == 'epub' %}{% set file_icon = 'bi-book' %}{% set badge_color = 'bg-success' %}
                                        {% endif %}
                                        
                                        <a href="{{ site.adres }}tools/saveFile/mod_news/{{ d.id }}/{{ do.id }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 border-start-0 border-end-0">
                                            <div class="d-flex align-items-center">
                                                <div class="file-icon-wrapper me-3 fs-2 text-secondary">
                                                    <i class="bi {{ file_icon }}"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold">{{ do.original_name }}</h6>
                                                    <span class="badge {{ badge_color }} text-uppercase small">{{ extension }}</span>
                                                </div>
                                            </div>
                                            <div class="ms-3">
                                                <span class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                                                    <i class="bi bi-download me-1"></i> {{ lang.index.download }}
                                                </span>
                                            </div>
                                        </a>
                                    {% endfor %}
                                </div>
                            </section>
                        {% endif %}
					</div>
				</div>
			</article>

			{# Related News Section #}
			{% if newses is not empty %}
				<section class="mt-5" aria-labelledby="related-articles-title">
					<h2 id="related-articles-title" class="h4 mb-4 fw-bold">{{ lang.index.mod_news[2] }}</h2>
					<div class="row g-4">
						{% for news in newses %}
							<div class="col-md-4">
								<div class="card h-100 border-0 shadow-sm hover-lift transition">
									<a href="{{ site.sadres }}news/{{ news.seo }}" class="overflow-hidden rounded-top">
										{% if news.image is not empty %}
											<img src="{{ site.radres }}mod_news/thumb/{{ news.image }}" class="card-img-top transition-all" alt="{{ news.name }}" style="aspect-ratio: 16/10; object-fit: cover;">
										{% else %}
											<img src="{{ site.radres }}mod_settings/logo.png" class="card-img-top p-4 bg-light" alt="{{ news.name }}" style="aspect-ratio: 16/10; object-fit: contain;">
										{% endif %}
									</a>
									<div class="card-body p-3">
										<h6 class="card-title fw-bold mb-2">
											<a href="{{ site.sadres }}news/{{ news.seo }}" class="text-dark text-decoration-none">{{ news.name }}</a>
										</h6>
										<p class="card-text text-muted small mb-0">{{ news.summary|striptags|slice(0, 80) }}...</p>
									</div>
								</div>
							</div>
						{% endfor %}
					</div>
				</section>
			{% endif %}

			{# Subpages Section #}
			{% if altsayfalar is not empty %}
				<section class="card mt-5 border-0 shadow-sm" aria-labelledby="subpages-title">
					<div class="card-header bg-white border-bottom-0 pt-4 px-4">
						<h5 id="subpages-title" class="fw-bold mb-0">
							<i class="bi bi-layers me-2 text-primary"></i> {{ lang.index.mod_news[3] }}
						</h5>
					</div>
					<div class="list-group list-group-flush p-3">
						{% for sayfa in altsayfalar %}
							<a href="{{ site.sadres }}page/{{ sayfa.seo }}" class="list-group-item list-group-item-action border-0 rounded-2 mb-1" title="{{ sayfa.summary|striptags|slice(0, 100) }}">
								{{ sayfa.name }}
							</a>
						{% endfor %}
					</div>
				</section>
			{% endif %}
		</div>
	</div>
{% endblock %}

{% block js_custom %}
	<script>
		document.addEventListener('DOMContentLoaded', function () { 
            // GLightbox Initialize
            const lightbox = GLightbox({selector: '[data-bs-toggle="lightbox"]'});

            // Masonry Layout Fix with imagesLoaded
            var grid = document.querySelector('.row[data-masonry]');
            if (grid) {
                imagesLoaded(grid, function () {
                    var msnry = new Masonry(grid, {
                        percentPosition: true,
                        itemSelector: '.col-6'
                    });
                    msnry.layout();
                });
            }

            // Bootstrap Tooltip Initialize
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })
        });
	</script>
{% endblock %}
