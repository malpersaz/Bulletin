{{ run({"mod": "index", "method": "_latest_news", "extra": ["5", "image,name,seo,keywords,summary"]}) }}
{% set latest_news = ctx_get('latest_news') %}
{% if latest_news is not empty %}
    <section class="container my-4" aria-labelledby="latest-news-heading">
        <header>
            <h2 id="latest-news-heading" class="mb-4">{{ lang.index.mod_news.latest_news.1 }}</h2>
        </header>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for news in latest_news %}
                <article class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-img-wrapper">
                            <a href="{{ site.sadres }}news/{{ news.seo }}" title="{{ news.name }}" aria-label="{{ news.name }}">
                                {% if news.image is not empty %}
                                    <img src="{{ site.radres }}mod_news/{{ news.image }}"
                                         class="card-img-top"
                                         parent_id="{{ news.name }}"
                                         loading="lazy">
                                {% else %}
                                    <img src="{{ site.radres }}mod_settings/logo.png"
                                         class="card-img-top p-4 bg-light"
                                         parent_id="{{ news.name }}"
                                         loading="lazy"
                                         style="object-fit: contain;">
                                {% endif %}
                            </a>
                        </div>
                        <div class="card-body">
                            <h3 class="card-title h5">
                                <a href="{{ site.sadres }}news/{{ news.seo }}"
                                   class="text-decoration-none text-dark"
                                   title="{{ news.name }}"
                                   aria-label="{{ news.name }}">{{ news.name }}</a>
                            </h3>
                            <p class="card-text">
                                {% if news.summary != '' %}
                                    {{ news.summary|raw|striptags|length > 150 ? news.summary|raw|striptags|slice(0, 150) ~ '...' : news.summary|raw|striptags }}
                                {% else %}
                                    {{ news.name }}
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
        <footer class="text-center mt-4">
            <a href="{{ site.sadres }}newses"
               class="btn btn-primary"
               aria-label="{{ lang.index.mod_news.latest_news.2 }}">{{ lang.index.mod_news.latest_news.2 }}</a>
        </footer>
    </section>
{% else %}
    <section class="container my-4" aria-labelledby="latest-news-heading">
        <header>
            <h2 id="latest-news-heading" class="mb-4">{{ lang.index.mod_news.latest_news.1 }}</h2>
        </header>
        <div class="alert alert-info mb-0">{{ lang.index.mod_news.latest_news.3 }}</div>
    </section>
{% endif %}
