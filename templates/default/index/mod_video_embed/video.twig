{% extends "layouts/base.twig" %}

{% block content %}


{% set d = ctx_get('d') %}
{% set kategoriler = ctx_get('categories') %}

<div class="row mt-4" id="mod_video_embed_detail">

    <!-- Sol Sütun: Kategoriler -->
    <aside class="col-lg-3 order-lg-1 mb-4">
        <div class="card position-sticky" style="top: 2rem;" aria-labelledby="video-categories-title">
            <div class="card-header">
                <h2 id="video-categories-title" class="h5"><i class="bi bi-camera-video me-2"></i>{{ lang.index.mod_video_embed.1 }}</h2>
            </div>
            <div class="list-group list-group-flush">
                <a href="{{ site.sadres }}videos" class="list-group-item list-group-item-action">Tüm Videolar</a>
                {% for kat in kategoriler %}
                    <a href="{{ site.sadres }}videos/{{ kat.seo }}" class="list-group-item list-group-item-action{% if d.category_seo == kat.seo %} active{% endif %}">
                        {{ kat.name }}
                    </a>
                {% endfor %}
            </div>
        </div>
    </aside>

    <!-- Sağ Sütun: Video İçeriği -->
    <div class="col-lg-9 order-lg-2">
        <article class="card">
            <div class="card-header bg-light">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="{{ site.sadres }}">{{ lang.index.home }}</a></li>
                        <li class="breadcrumb-item"><a href="{{ site.sadres }}videos">{{ lang.index.mod_video_embed.1 }}</a></li>
                        <li class="breadcrumb-item"><a href="{{ site.sadres }}videos/{{ d.category_seo }}">{{ d.categoryname }}</a></li>
                        <li class="breadcrumb-item active" aria-current="page">{{ d.name }}</li>
                    </ol>
                </nav>
            </div>
            <div class="card-body">
                <h1 class="card-title fs-2 fw-bold mb-3">{{ d.name }}</h1>

                {% if d.deck is defined and d.deck == 'y' %}
                    <p class="lead mb-4">{{ d.summary }}</p>
                {% endif %}

                {# Responsive Video Embed #}
                <div class="ratio ratio-16x9 mb-4">
                    {{ d.embed|raw }}
                </div>

                {# Video Description #}
                {% if d.content is not empty %}
                    <div class="content-body mb-4">
                        {{ d.content|raw }}
                    </div>
                {% endif %}

                <hr>
                <p class="text-muted small">
                    Yayınlanma Tarihi: <time datetime="{{ d.created_at|date('Y-m-d') }}">{{ d.created_at|date('d.m.Y') }}</time> / Kategori: <a href="{{ site.sadres }}videos/{{ d.category_seo }}" title="{{ d.categoryname }}">{{ d.categoryname }}</a>
                </p>
            </div>
        </article>
    </div>
</div>
{% endblock %}
