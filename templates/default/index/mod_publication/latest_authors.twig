{{ run({"mod": "index", "method": "_latest_authors", "extra": [4]}) }}
{% set latest_authors = ctx_get('latest_authors') %}

{% if latest_authors %}
<section id="latest-publication-authors" class="py-4">
    <style>
        #latest-publication-authors {
            --authors-ink: #111827;
            --authors-muted: #64748b;
            --authors-line: rgba(17, 24, 39, 0.08);
            --authors-surface: #ffffff;
            padding: 3.5rem 0;
            border-top: 4px solid var(--authors-ink); /* Strong signature border */
        }

        #latest-publication-authors .latest-authors-card {
            background: var(--authors-surface);
            box-shadow: none;
        }

        #latest-publication-authors .latest-authors-head {
            margin-bottom: 2.5rem;
            padding-top: 0.5rem;
        }

        #latest-publication-authors .latest-authors-title {
            margin: 0;
            color: var(--authors-ink);
            font-family: var(--bs-font-sans-serif);
            font-size: 0.85rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            opacity: 0.8;
        }

        #latest-publication-authors .latest-authors-list {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        #latest-publication-authors .latest-authors-item {
            display: flex;
            justify-content: space-between;
            align-items: center; /* Precision vertical alignment */
            gap: 2rem;
            padding: 1.25rem 0;
            border-bottom: 1px solid var(--authors-line);
            text-decoration: none;
            color: var(--authors-ink);
            transition: opacity 0.3s ease;
        }

        #latest-publication-authors .latest-authors-item:last-child {
            border-bottom: 0;
        }

        #latest-publication-authors .latest-authors-item:hover {
            opacity: 0.7;
        }

        #latest-publication-authors .latest-authors-copy {
            display: flex;
            flex-direction: column;
            gap: 0.35rem; /* Precise spacing between name and headline */
            flex: 1;
            min-width: 0;
        }

        #latest-publication-authors .latest-authors-name {
            color: var(--authors-muted);
            font-family: var(--bs-font-sans-serif);
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            line-height: 1;
        }

        #latest-publication-authors .latest-authors-publication {
            color: var(--authors-ink);
            font-family: 'Literata', serif;
            font-size: 1.15rem; /* High-readability headline size */
            font-weight: 800;
            line-height: 1.25; /* Prevents typographic orphans like "YE" */
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            word-wrap: break-word;
        }

        #latest-publication-authors .latest-authors-avatar {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
            flex-shrink: 0;
            order: 2; /* Avatar to the right */
        }

        #latest-publication-authors .latest-authors-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        @media (min-width: 992px) {
            #latest-publication-authors .latest-authors-list {
                grid-template-columns: repeat(4, 1fr); /* 4 items per row as requested */
                column-gap: 4.5rem;
            }
            
            #latest-publication-authors .latest-authors-item {
                border-bottom: 0;
                padding: 0;
            }
        }

        html[data-bs-theme="dark"] #latest-publication-authors {
            --authors-ink: #f8fafc;
            --authors-muted: #94a3b8;
            --authors-line: rgba(255, 255, 255, 0.1);
            --authors-surface: #0f172a;
        }

    <div class="latest-authors-card">
        <div class="latest-authors-head">
            <h2 class="latest-authors-title">{{ lang.index.mod_publication.authors }}</h2>
        </div>

        <div class="latest-authors-list">
            {% for author in latest_authors %}
                {% set latest_author_name = (author.u_name ~ ' ' ~ author.u_last_name)|trim %}
                {% set latest_author_initials = (author.u_name|slice(0, 1) ~ author.u_last_name|slice(0, 1))|upper %}
                {% set latest_publication_title = author.title is defined and author.title is not empty ? author.title : author.name %}
                <a class="latest-authors-item" href="{{ site.sadres }}publication/{{ author.seo }}">
                    <span class="latest-authors-avatar">
                        {% if author.user_image is defined and author.user_image is not empty %}
                            <img src="{{ site.radres }}mod_user/thumb/{{ author.user_image }}" alt="{{ latest_author_name }}" loading="lazy">
                        {% else %}
                            <span>{{ latest_author_initials }}</span>
                        {% endif %}
                    </span>
                    <span class="latest-authors-copy">
                        <span class="latest-authors-name">{{ latest_author_name }}</span>
                        <span class="latest-authors-publication">{{ latest_publication_title }}</span>
                    </span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
