{% extends "layouts/base.twig" %}

{% set d = ctx_get('d') %}
{% set res = ctx_get('res') %}
{% set dosya = ctx_get('file') %}

{% block canonical %}
    <link rel="canonical" href="{{ site.sadres }}publication/{{ d.seo }}"/>
{% endblock %}

{% block title %}
    <title>{{ d.title|default(d.name) }} - {{ site.title }}</title>
{% endblock %}

{% block description %}
    <meta name="description" content="{{ d.description }}">
{% endblock %}

{% block keywords %}
    <meta name="keywords" content="{{ d.keywords }}">
{% endblock %}

{% block content %}
<div class="page-title">
    <div class="container">
        <ol itemscope itemtype="http://schema.org/BreadcrumbList">
            <li itemscope itemtype="http://schema.org/ListItem" itemprop="itemListElement">
                <a itemprop="item" href="{{ site.sadres }}publications/all">
                    <h1 itemprop="name">{{ lang.index.mod_publication.2 }}</h1>
                </a>
            </li>
            <li itemscope itemtype="http://schema.org/ListItem" itemprop="itemListElement">
                <a itemprop="item" href="{{ site.sadres }}publications/{{ d.category_seo }}">
                    <h2 itemprop="name">
                        {% if d.category_name is defined and d.category_name is not empty %}
                            <a itemprop="item" href="{{ site.sadres }}publications/{{ d.category_seo }}">{{ d.category_name }}</a>
                        {% else %}
                            <a itemprop="item" href="{{ site.sadres }}publication-archive">{{ lang.index.mod_publication.6 }}</a>
                        {% endif %}
                    </h2>
                </a>
            </li>
            {% if d.username is defined %}
                <li itemscope itemtype="http://schema.org/ListItem" itemprop="itemListElement">
                    <a itemprop="item" href="{{ site.sadres }}blog/{{ d.username }}">{{ d.u_name }} {{ d.u_last_name }}</a>
                </li>
            {% endif %}
            <li itemscope itemtype="http://schema.org/ListItem" itemprop="itemListElement">
                <span itemprop="name">{{ d.name }}</span>
            </li>
        </ol>
    </div>
</div>
<div class="page-inner">
    <div class="container clearfix">
        <div class="page-content">
            <div data-order="1" data-id="{{ d.seo }}" data-title="{{ d.name }}" data-url="{{ d.seo }}">
                <div class="imgc image">
                    {% if d.image is not empty %}
                        <img src="{{ site.radres }}mod_publication/{{ d.image }}" alt="{{ d.name }},{{ d.keywords }}" />
                    {% else %}
                        <img src="{{ site.tadres }}templates/{{ site.app_template }}/static/img/logo.png" alt="{{ d.name }},{{ d.keywords }}" />
                    {% endif %}
                </div>
                <aside class="article-side clearfix">
                    <div class="content-date" itemprop="datePublished" content="{{ d.created_at|date('Y-m-d\\TH:iP') }}">
                        <span class="p1">{{ d.created_at|date('H:i') }}</span>
                        <span class="p2">{{ d.created_at|date('d.m.Y') }}</span>
                    </div>
                    <div class="content-tools bookmark-block" data-type="1">
                        <a class="icon-folder" href="{{ site.adres }}tools/saveText/mod_publication/{{ d.id }}" title="{{ lang.index.mod_gallery.2 }}"></a>
                        {% if dosya %}
                            {% for do in dosya %}
                                <a class="icon-doc" href="{{ site.adres }}tools/saveFile/mod_publication/{{ d.id }}/{{ do.id }}" title="{{ lang.index.mod_attachment.1 }}: {{ do.name }}"></a>
                            {% endfor %}
                        {% endif %}
                        <a class="icon-print" rel="nofollow" href="javascript:void(0)" onclick="window.print();" title="Print"></a>
                    </div>

                    {% if d.username is defined %}
                        <div class="content-source">
                            <a href="{{ site.sadres }}blog/{{ d.username }}">
                                <span class="c">{{ d.u_name }} {{ d.u_last_name }}</span>
                                {% if d.user_image is defined and d.user_image is not empty %}
                                    <img src="{{ site.radres }}mod_user/thumb/{{ d.user_image }}" align="absmiddle" alt="{{ d.u_name }} {{ d.u_last_name }}" width="110" />
                                {% endif %}
                            </a>
                            <span class="c"></span>
                        </div>
                    {% endif %}
                </aside>
                <article class="news-detail clearfix">
                    <div class="content-heading">
                        <h1 class="content-title" itemprop="name">{{ d.name }}</h1>
                        <h2 class="content-description" itemprop="description">
                            <summary>
                                {% if d.summary is not empty %}
                                    {{ d.summary }}
                                {% endif %}
                            </summary>
                        </h2>
                        <div class="text-size">
                            <span onclick="changeFontSize('.text-content', 'u');" title="Increase text size">A+</span>
                            <span onclick="changeFontSize('.text-content', 'd');" title="Decrease text size">A-</span>
                        </div>
                    </div>
                    <div class="advert">
                        <div class="holder">
                            <div class="nav-mini pull-left">
                                {% if dosya %}
                                    {{ lang.index.mod_attachment.2 }}
                                    {% for do in dosya %}
                                        <a href="{{ site.adres }}tools/saveFile/mod_publication/{{ d.id }}/{{ do.id }}" style="width:100%; background:none; border:none; color:darkblue;">
                                            <img src="{{ site.tadres }}templates/{{ site.app_template }}/static/img/document.png" alt="{{ do.name }}">
                                            {{ do.name }}
                                        </a>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div itemprop="articleBody" class="text-content">
                        <p>{{ d.content|raw }}<br /></p>
                        {% if res %}
                            <div class="gallery-list">
                                {% for r in res %}
                                    <div data-order="1">
                                        <figure>
                                            <div class="i">
                                                <img src="{{ site.radres }}mod_gallery/mod_publication/thumb/{{ r.url }}" title="{{ r.name }}" itemprop="image">
                                                <span class="c">
                                                    <span>1</span>
                                                    <span>{{ loop.length }}</span>
                                                </span>
                                            </div>
                                            <figcaption class="clearfix">
                                                <span class="s">
                                                    <span class="sh fb"><i class="icon-facebook"></i></span>
                                                    <span class="sh twit"><i class="icon-twitter"></i></span>
                                                    <span class="sh gplus"><i class="icon-gplus"></i></span>
                                                    <span class="sh pin"><i class="icon-pinterest"></i></span>
                                                    <span class="resize"><i class="icon-resize-full"></i></span>
                                                    <span class="send"><i class="icon-mail-alt"></i></span>
                                                </span>
                                                <span class="text-content">
                                                    <p>{{ r.name }}</p>
                                                    <p> </p>
                                                </span>
                                            </figcaption>
                                        </figure>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div class="news-label">
                        <i class="icon-tag"></i>
                        <span>Keywords :</span>
                        <a href="{{ d.seo }}" title="{{ d.name }}" rel="tag">{{ d.keywords }}</a>
                    </div>
                </article>
            </div>
        </div>
        <aside class="base-side clearfix"></aside>
    </div>
</div>
{% endblock %}
