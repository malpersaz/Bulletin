{% extends "layouts/base.twig" %}

{% set author = ctx_get('author') %}
{% set publications = ctx_get('publications') %}
{% set pagination = ctx_get('pagination') %}
{% set page = ctx_get('page') %}
{% set username = ctx_get('username') %}
{% set author_name = (author.u_name ~ ' ' ~ author.u_last_name)|trim %}
{% set author_initials = (author.u_name|slice(0, 1) ~ author.u_last_name|slice(0, 1))|upper %}

{% block canonical %}
    <link rel="canonical" href="{{ site.sadres }}author/{{ username }}{% if page is not empty and page > 1 %}/{{ page }}{% endif %}" />
{% endblock %}

{% block title %}
    <title>{{ author_name }} - {{ site.title }}</title>
{% endblock %}

{% block css_custom %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ site.tadres }}{{ site.app_template }}/static/css/author.css?v={{ "now"|date("U") }}">
{% endblock %}


{% block content %}
<section id="publication-author-page">
    <div class="container author-shell">
        <ol class="author-breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a itemprop="item" href="{{ site.sadres }}"><span itemprop="name">{{ lang.index.home }}</span></a>
                <meta itemprop="position" content="1" />
            </li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a itemprop="item" href="{{ site.sadres }}authors"><span itemprop="name">{{ lang.index.mod_publication.authors }}</span></a>
                <meta itemprop="position" content="2" />
            </li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <span itemprop="name">{{ author_name }}</span>
                <meta itemprop="position" content="3" />
            </li>
        </ol>

        <div class="author-layout">
            <main class="author-main">
                <section class="author-identity western-modern" itemscope itemtype="https://schema.org/Person">
                    <div class="author-identity-inner">
                        <div class="author-avatar">
                            {% if author.user_image is defined and author.user_image is not empty %}
                                <img src="{{ site.radres }}mod_user/{{ author.user_image }}" alt="{{ author_name }}" loading="lazy">
                            {% else %}
                                <span>{{ author_initials }}</span>
                            {% endif %}
                        </div>
                        <div class="author-copy">
                            <h1 class="author-title" itemprop="name">{{ author_name }}</h1>
                            {% if author.about is defined and author.about is not empty %}
                            <div class="author-bio">
                                {{ author.about|raw }}
                            </div>
                            {% endif %}
                            <div class="author-meta">
                                <span class="author-role">{{ lang.index.mod_publication.author }}</span>
                                <span class="meta-divider">·</span>
                                <span class="author-handle">
                                    <i class="bi bi-at"></i>{{ username }}
                                </span>
                                {% if username is not empty %}
                                    <span class="meta-divider">·</span>
                                    <a class="author-social-link author-pm" href="{{ site.sadres }}mod_user_pm/send/{{ username }}">
                                        <i class="bi bi-envelope"></i><span>{{ lang.index.mod_user_pm.send_message }}</span>
                                    </a>
                                {% endif %}
                                {% if author.twitter is defined and author.twitter is not empty %}
                                    <span class="meta-divider">·</span>
                                    <a class="author-social-link author-twitter" href="{{ author.twitter }}" target="_blank" rel="noopener">
                                        <i class="bi bi-twitter-x"></i><span>X / X</span>
                                    </a>
                                {% endif %}
                                {% if author.facebook is defined and author.facebook is not empty %}
                                    <span class="meta-divider">·</span>
                                    <a class="author-social-link author-facebook" href="{{ author.facebook }}" target="_blank" rel="noopener">
                                        <i class="bi bi-facebook"></i><span>Facebook</span>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </section>

                {% if publications %}
                    <div class="author-stream">
                        {% for publication in publications %}
                            {% set publication_title = publication.title is defined and publication.title is not empty ? publication.title : publication.name %}
                            <article class="publication-row">
                                <div class="publication-topline">
                                    <span class="publication-date">
                                        <i class="bi bi-clock-history"></i>{{ publication.created_at|date('d.m.Y H:i') }}
                                    </span>
                                    {% if publication.category_seo is defined and publication.category_name is defined and publication.category_name is not empty %}
                                        <a class="publication-category" href="{{ site.sadres }}publications/{{ publication.category_seo }}">{{ publication.category_name }}</a>
                                    {% endif %}
                                </div>
                                <h2 class="publication-title">
                                    <a href="{{ site.sadres }}publication/{{ publication.seo }}">{{ publication_title }}</a>
                                </h2>
                            </article>
                        {% endfor %}
                    </div>

                    {% if pagination %}
                        <div class="pagination-wrap">
                            <nav aria-label="{{ author_name }}">
                                <ul class="pagination justify-content-center">
                                    {% for s in pagination %}
                                        {% if s == '...' %}
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        {% elseif s == page %}
                                            <li class="page-item active" aria-current="page">
                                                <span class="page-link">{{ s }}</span>
                                            </li>
                                        {% elseif s == 1 %}
                                            <li class="page-item">
                                                <a class="page-link" href="{{ site.sadres }}author/{{ username }}">{{ s }}</a>
                                            </li>
                                        {% else %}
                                            <li class="page-item">
                                                <a class="page-link" href="{{ site.sadres }}author/{{ username }}/{{ s }}">{{ s }}</a>
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            </nav>
                        </div>
                    {% endif %}
                {% endif %}
            </main>

            <aside class="author-sidebar">
                {{ include("index/mod_publication/other_authors.twig") }}
            </aside>
        </div>
    </div>
</section>
{% endblock %}
