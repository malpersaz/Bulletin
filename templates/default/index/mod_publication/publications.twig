{% extends "layouts/base.twig" %}

{% set categoryname = ctx_get('categoryname') %}
{% set category_seo = ctx_get('category_seo') %}
{% set publications = ctx_get('publications') %}
{% set sayfalama = ctx_get('sayfalama') %}
{% set sayfa = ctx_get('sayfa') %}

{% block content %}
<div class="page-title">
    <div class="container">
        <ol>
            <li>
                {% if categoryname is not empty %}
                    <a href="{{ site.sadres }}publications/{{ category_seo }}"><h1>{{ lang.index.mod_publication.1|format(categoryname) }}</h1></a>
                {% else %}
                    <a href="{{ site.sadres }}publication-archive"><h1>{{ lang.index.mod_publication.6 }}</h1></a>
                {% endif %}
            </li>
        </ol>
    </div>
</div>
<div class="page-inner">
    <div class="container clearfix">
        <div class="page-content">
            <div class="box-news">
                {% if publications %}
                    <div class="row">
                        {% for k, publication in publications %}
                            {% if k is odd %}
                                <div class="col-xs-12 col-ms-6 col-md-4">
                                    <a class="c" href="{{ site.sadres }}publication/{{ publication.seo }}">
                                        {% if publication.image is not empty %}
                                            <img class="img-responsive" src="{{ site.radres }}mod_publication/{{ publication.image }}" alt="{{ publication.name }}" />
                                        {% else %}
                                            <img class="img-responsive" src="{{ site.radres }}mod_settings/logo.png" alt="{{ publication.name }}" />
                                        {% endif %}
                                        <span class="t">{{ publication.name }}</span>
                                        <span class="sc">{{ publication.u_name }} {{ publication.u_last_name }}, {{ publication.category_name }}</span>
                                    </a>
                                </div>
                            {% else %}
                                <div class="col-xs-12 col-ms-6 col-md-4">
                                    <a class="f" href="{{ site.sadres }}publication/{{ publication.seo }}">
                                        {% if publication.image is not empty %}
                                            <img class="img-fit" src="{{ site.radres }}mod_publication/{{ publication.image }}" alt="{{ publication.name }}" />
                                        {% else %}
                                            <img class="img-fit" src="{{ site.radres }}mod_settings/logo.png" alt="{{ publication.name }}" />
                                        {% endif %}
                                        <span class="t">{{ publication.name }} {{ publication.u_name }} {{ publication.u_last_name }}, {{ publication.category_name }}</span>
                                    </a>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% else %}
                    {{ lang.index.mod_publication.4 }}
                {% endif %}
            </div>
            <div class="clear"></div>
            {% if sayfalama %}
                <div class="paging_3">
                    <div class="holder">
                        {% for s in sayfalama %}
                            {% if s == '...' %}
                                <span class="seperator">&nbsp;...</span>
                            {% elseif s == sayfa %}
                                <a class="number" href="{{ site.sadres }}publications/{{ category_seo }}/{{ s }}" rel="page">{{ s }}</a>
                            {% else %}
                                <span class="seperator">&nbsp;</span>
                                <a class="number" href="{{ site.sadres }}publications/{{ category_seo }}/{{ s }}" rel="page">{{ s }}</a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
