{% extends "layouts/base.twig" %}

{% set kategoriler = ctx_get('categories') %}
{% set categoryname = ctx_get('categoryname') %}
{% set category_seo = ctx_get('category_seo') %}
{% set publications = ctx_get('publications') %}
{% set sayfalama = ctx_get('sayfalama') %}
{% set sayfa = ctx_get('sayfa') %}

{% block canonical %}
    <link rel="canonical" href="{{ site.sadres }}publications{% if category_seo is not empty and category_seo != 'all' %}/{{ category_seo }}{% endif %}" />
{% endblock %}

{% block title %}
    <title>
        {% if category_seo is not empty and category_seo != 'all' %}
            {{ categoryname }} - {{ lang.index.mod_publication.2 }} - {{ site.title }}
        {% else %}
            {{ lang.index.mod_publication.2 }} - {{ site.title }}
        {% endif %}
    </title>
{% endblock %}

{% block css_custom %}
    {{ parent() }}
    <style>
        #mod_publication_list .list-group-item {
            border: 0;
            border-top: 1px solid rgba(15, 23, 42, 0.06);
            padding: 0.95rem 1.25rem;
            transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
        }

        #mod_publication_list .list-group-item:first-child {
            border-top: 0;
        }

        #mod_publication_list .list-group-item:hover {
            background: rgba(15, 23, 42, 0.04);
            transform: translateX(2px);
        }

        #mod_publication_list .list-group-item.active {
            background: linear-gradient(135deg, #0f172a, #1e293b);
            border-color: transparent;
            color: #fff;
        }

        #mod_publication_list .list-group-item.active .badge {
            background: rgba(255, 255, 255, 0.16) !important;
            color: #fff;
        }

        #mod_publication_list .card article,
        #mod_publication_list article.card {
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            border-radius: 1rem;
        }

        #mod_publication_list article.card:hover {
            transform: translateY(-6px);
            box-shadow: 0 1.25rem 2.5rem rgba(15, 23, 42, 0.12) !important;
        }

        #mod_publication_list .card-img-top {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.05), rgba(14, 116, 144, 0.10));
        }

        #mod_publication_list .publication-card-title {
            line-height: 1.35;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 3.8rem;
        }

        #mod_publication_list .publication-summary {
            display: -webkit-box;
            -webkit-line-clamp: 4;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.65;
        }

        #mod_publication_list .publication-author {
            font-weight: 500;
            letter-spacing: 0.01em;
        }

        #mod_publication_list .page-link {
            border-radius: 0.75rem;
            margin: 0 0.2rem;
            border-color: rgba(15, 23, 42, 0.08);
            color: #0f172a;
        }

        #mod_publication_list .page-item.active .page-link {
            background: #0f172a;
            border-color: #0f172a;
        }
    </style>
{% endblock %}

{% block content %}
<div class="row mt-4" id="mod_publication_list">
    <div class="col-lg-3 col-md-4">
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h5 class="card-title mb-0">
                    <i class="bi bi-journal-text me-2"></i>{{ lang.index.mod_publication.2 }}
                </h5>
            </div>
            <div class="list-group list-group-flush">
                <a href="{{ site.sadres }}publications"
                   class="list-group-item list-group-item-action{% if category_seo == 'all' or category_seo is empty %} active{% endif %}">
                    <i class="bi bi-grid me-2"></i>{{ lang.index.mod_publication.2 }}
                </a>
                {% for kat in kategoriler %}
                    {% if kat.publication_count > 0 %}
                    <a href="{{ site.sadres }}publications/{{ kat.seo }}"
                       class="list-group-item list-group-item-action{% if category_seo == kat.seo %} active{% endif %}">
                        <i class="bi bi-bookmark me-2"></i>{{ kat.name }}
                        <span class="badge bg-secondary rounded-pill float-end">{{ kat.publication_count }}</span>
                    </a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="col-lg-9 col-md-8">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-4" itemscope itemtype="https://schema.org/BreadcrumbList">
                <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a itemprop="item" href="{{ site.sadres }}"><span itemprop="name">{{ lang.index.home }}</span></a>
                    <meta itemprop="position" content="1" />
                </li>
                {% if category_seo is not empty and category_seo != 'all' %}
                    <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        <a itemprop="item" href="{{ site.sadres }}publications"><span itemprop="name">{{ lang.index.mod_publication.2 }}</span></a>
                        <meta itemprop="position" content="2" />
                    </li>
                    <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        <span itemprop="name">{{ categoryname }}</span>
                        <meta itemprop="position" content="3" />
                    </li>
                {% else %}
                    <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                        <span itemprop="name">{{ lang.index.mod_publication.2 }}</span>
                        <meta itemprop="position" content="2" />
                    </li>
                {% endif %}
            </ol>
        </nav>

        {% if publications is not empty %}
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                {% for publication in publications %}
                    <div class="col">
                        <article class="card h-100 border-0 shadow-sm overflow-hidden">
                            <a href="{{ site.sadres }}publication/{{ publication.seo }}" title="{{ publication.name }}" class="text-decoration-none">
                                {% if publication.image is not empty %}
                                    <img src="{{ site.radres }}mod_publication/{{ publication.image }}"
                                         class="card-img-top"
                                         style="height: 240px; object-fit: cover;"
                                         alt="{{ publication.name }}"
                                         loading="lazy">
                                {% else %}
                                    <img src="{{ site.radres }}mod_settings/logo.png"
                                         class="card-img-top p-4 bg-light"
                                         style="height: 240px; object-fit: contain;"
                                         alt="{{ publication.name }}"
                                         loading="lazy">
                                {% endif %}
                            </a>
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <small class="text-muted">
                                        <i class="bi bi-calendar3 me-1"></i>{{ publication.created_at|date('d.m.Y') }}
                                    </small>
                                    {% if publication.category_name is defined and publication.category_name is not empty %}
                                        <span class="badge text-bg-light border">{{ publication.category_name }}</span>
                                    {% endif %}
                                </div>
                                <h2 class="h5 card-title mb-2">
                                    <a href="{{ site.sadres }}publication/{{ publication.seo }}"
                                       title="{{ publication.name }}"
                                       class="text-decoration-none text-dark publication-card-title d-inline-block">
                                        {{ publication.name }}
                                    </a>
                                </h2>
                                <p class="text-muted small mb-3 publication-author">
                                    {{ publication.u_name }} {{ publication.u_last_name }}
                                </p>
                                <p class="card-text text-muted flex-grow-1 publication-summary">
                                    {% if publication.summary is not empty %}
                                        {{ publication.summary|striptags|slice(0, 150) }}{% if publication.summary|striptags|length > 150 %}...{% endif %}
                                    {% else %}
                                        {{ publication.description|default(publication.name)|striptags|slice(0, 150) }}{% if publication.description|default(publication.name)|striptags|length > 150 %}...{% endif %}
                                    {% endif %}
                                </p>
                                <div class="mt-3 d-flex justify-content-between align-items-center">
                                    <span class="small text-muted">
                                        <i class="bi bi-arrow-up-right me-1"></i>{{ publication.seo }}
                                    </span>
                                    <a href="{{ site.sadres }}publication/{{ publication.seo }}" class="btn btn-sm btn-outline-dark">
                                        <i class="bi bi-eye me-1"></i>Oku
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            </div>

            {% if sayfalama is not empty %}
                <nav aria-label="{{ lang.index.mod_publication.17|default('Pagination') }}" class="mt-4">
                    <ul class="pagination justify-content-center">
                        {% for s in sayfalama %}
                            {% if s == '...' %}
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            {% elseif s == sayfa %}
                                <li class="page-item active" aria-current="page">
                                    <span class="page-link">{{ s }}</span>
                                </li>
                            {% else %}
                                <li class="page-item">
                                    <a class="page-link"
                                       href="{{ site.sadres }}publications{% if category_seo is not empty and category_seo != 'all' %}/{{ category_seo }}{% endif %}/{% if s != 1 %}{{ s }}{% endif %}">
                                        {{ s }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        {% else %}
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-journal-x display-5 text-muted mb-3"></i>
                    <h4 class="text-muted">{{ lang.index.mod_publication.4 }}</h4>
                    <p class="text-muted mb-0">{{ lang.index.mod_publication.18 }}</p>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
