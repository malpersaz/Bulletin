{% extends "layouts/base.twig" %}

{% block content %}
{% set d = ctx_get('d') %}
{% set announcements = ctx_get('announcements') %}
{% set yil = ctx_get('yil') %}
{% set ay = ctx_get('ay') %}
{% set arsiv_yil = ctx_get('arsiv_yil') %}
{% set bulunamadi = ctx_get('bulunamadi') %}
<div class="row" id="mod_announcements_list">
    <div class="card">
        <div class="card-header">
            <ol class="breadcrumb panel-title">
                <li>
                    <a href="{{ site.sadres }}">{{ lang.index.homepage }}</a>
                </li>
                <li class="active">{{ lang.index.mod_announcements.1 }}</li>
            </ol>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <form class="form-horizontal" method="post" action="">
                                <fieldset>
                                    <!-- Form Name -->
                                    <legend>{{ d.name }}</legend>
                                    <div class="form-group">
                                        <label class="col-md-4 control-label" for="yil">{{ lang.index.mod_announcements.2 }}</label>
                                        <div class="col-md-8">
                                            <select id="yil" name="yil" class="form-control">
                                                <option value="*"{% if yil == '*' %} selected="selected"{% endif %}>*</option>
                                                {% for i in arsiv_yil.min_yil..arsiv_yil.max_yil %}
                                                    <option value="{{ i }}"{% if yil == i %} selected="selected"{% endif %}>{{ i }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-md-4 control-label" for="ay">{{ lang.index.mod_announcements.3 }}</label>
                                        <div class="col-md-8">
                                            <select id="ay" name="ay" class="form-control">
                                                <option value="*"{% if ay == '*' %} selected="selected"{% endif %}>*</option>
                                                {% for i in 0..lang.index.mod_announcements.aylar|length - 1 %}
                                                    <option value="{{ i + 1 }}"
                                                            {% if ay == i + 1 %}selected="selected"{% endif %}>
                                                        {{ lang.index.mod_announcements.aylar[i] }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-md-4 control-label" for="ara">İşlem</label>
                                        <div class="col-md-8">
                                            <button id="ara" name="ara" class="btn btn-success">
                                                <i class="fa fa-location-arrow"></i> {{ lang.index.mod_announcements.4 }}
                                            </button>
                                        </div>
                                    </div>
                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <hr>
                    {% if bulunamadi is not empty %}<h5 class="alert alert-info">{{ lang.index.mod_announcements.7 }}</h5>{% endif %}
                    {% if announcements %}
                        <h4 class="alert alert-success">{{ lang.index.mod_announcements.8 }}</h4>
                        {% for announcement in announcements %}
                            <p>
                                {{ announcement.created_at|date("Y-m-d") }} - <a data-bs-toggle="tooltip"
    href="{{ site.sadres }}announcement/{{ announcement.id }}-{{ announcement.name|sefurl }}"
    title="{% if announcement.summary != '' %}{{ announcement.summary }}{% else %}{{ announcement.name }}{% endif %}">{{ announcement.name }}</a>
                            </p>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
