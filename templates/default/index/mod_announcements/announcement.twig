{% extends "layouts/base.twig" %}

{% block content %}
{% set d = ctx_get('d') %}
{% set res = ctx_get('res') %}
{% set dosya = ctx_get('file') %}
<div class="row" id="mod_announcements">
    <div class="card">
        <div class="card-header">
            <ol class="breadcrumb panel-title">
                <li>
                    <a href="{{ site.saddress }}">{{ lang.index.home }}</a>
                </li>
                <li>
                    <a href="{{ site.saddress }}announcements"
                       title="{{ lang.index.mod_announcements.1 }}">{{ lang.index.mod_announcements.1 }}</a>
                </li>
                <li class="active">{{ d.name }}</li>
            </ol>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="row">
                        <div class="col-md-6 col-md-6 col-12">{{ include("index/paylas.twig") }}</div>
                        <div class="col-md-6 col-md-6 col-12">
                            <div class="akm_tools">
                                <a href="{{ site.saddress }}tools/saveHtml/mod_announcements/{{ d.id }}"
                                   class="saveHtml"
                                   data-bs-toggle="tooltip"
                                   data-placement="top"
                                   title="{{ lang.index.mod_gallery.1 }}"></a>
                                <a href="{{ site.saddress }}tools/saveText/mod_announcements/{{ d.id }}"
                                   class="saveText"
                                   data-bs-toggle="tooltip"
                                   data-placement="top"
                                   title="{{ lang.index.mod_gallery.2 }}"></a>
                                {% if res is not empty %}
                                    <a href="{{ site.saddress }}tools/saveAll/mod_announcements/{{ d.id }}/{{ res.id }}"
                                       class="saveAll"
                                       data-bs-toggle="tooltip"
                                       data-placement="top"
                                       title="{{ lang.index.mod_gallery.3 }}"></a>
                                {% endif %}
                                <a href="javascript:void(0)"
                                   onclick="$('#akm_icerik').printThis({ pageTitle: '{{ d.name }}' });"
                                   class="print tooltipster"
                                   title="{{ lang.index.mod_gallery.4 }}"
                                   data-bs-toggle="tooltip"
                                   data-placement="top"></a>
                            </div>
                        </div>
                    </div>
                    <div id="akm_icerik">
                        <div class="page-header">
                            <h1>{{ d.name }}</h1>
                        </div>
                        {% if d.deck is defined and d.deck == 'y' %}
                            <blockquote>
                                {{ d.summary }}
                            </blockquote>
                        {% endif %}
                        {% if d.image != '' %}
                            <div class="thumbnail">
                                <img src="{{ site.iaddress }}mod_announcements/{{ d.image }}"
                                     parent_id="{{ d.name }},{{ d.keywords }}">
                            </div>
                        {% endif %}
                        {{ d.content }}
                    </div>
                    <hr>
                    <p class="bilgi">{{ lang.index.mod_announcements.10|format(d.created_at|date("d.m.Y") ) }}</p>
                    <hr>
                    <div class="row">
                        {% if res is not empty %}
                            <div class="col-md-12 col-md-12 col-12" id="mod_gallery">
                                <div class="card">
                                    <div class="card-header">
                                        <h3 class="panel-title">Resimler</h3>
                                    </div>
                                    <div class="card-body">
                                        {% set mod_gallery = "e" %}
                                        <div class="owl-carousel">
                                            {% for r in res %}
                                                <div class="item">
                                                    <a href="{{ site.iaddress }}mod_gallery/mod_announcements/original/{{ r.url }}"
                                                       data-bs-toggle="lightbox"
                                                       data-gallery="multiimages"
                                                       data-title="{{ r.name }}"
                                                       data-parent="#mod_gallery">
                                                        <img src="{{ site.iaddress }}mod_gallery/mod_announcements/thumb/{{ r.url }}"
                                                             parent_id="{{ r.name }}">
                                                    </a>
                                                    <a href="{{ site.address }}tools/gallery_image_save/mod_announcements/{{ d.id }}/{{ r.id }}"
                                                       class="dll"
                                                       title="{{ lang.index.mod_gallery.5 }}"></a>
                                                    <a href="{{ site.iaddress }}mod_gallery/mod_announcements/original/{{ r.url }}"
                                                       class="tdll"
                                                       data-bs-toggle="lightbox"
                                                       data-gallery="multiimages"
                                                       data-title="{{ r.name }}"
                                                       data-parent="#mod_gallery"
                                                       title="{{ lang.index.mod_gallery.6 }}"></a>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if dosya is not empty %}
                            <div class="list-group col-md-6 col-md-6 col-12">
                                <p class="list-group-item active">
                                    <span class="glyphicon glyphicon-download" aria-hidden="true"></span> {{ lang.index.mod_announcements.9 }}
                                </p>
                                {% for do in dosya %}
                                    <a href="{{ site.address }}tools/saveFile/mod_announcements/{{ d.id }}/{{ do.id }}"
                                       class="list-group-item">{{ do.original_name }}</a>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
