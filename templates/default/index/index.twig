{% extends "layouts/base.twig" %}


{% block js_custom %}
<script type="text/javascript">
$(document).ready(function() {
    // Bootstrap 5 ve jQuery çakışmasını aşmak için jQuery ile manuel başlatma
    var mainSlider = $('#mainSlider');
    if (mainSlider.length) {
        mainSlider.carousel({
            interval: 5000,
            wrap: true
        });
    }
});
</script>
{% endblock %}



{% block content %}
<!-- START: index/index.twig -->


    {# Include slider when needed #}
    {% include 'index/mod_slider/slider.twig' %}
    
    {% include 'index/mod_news/latest_news.twig' %}


    <!-- Homepage content -->
    <section class="row" id="orta">

        <article id="orta-sol" class="col-md-9">

        </article>
        <aside id="orta-sag" class="col-md-3">

        </aside>
    </section>
    
    {# Include bottom menu when needed #}
    {% include 'partials/bottom_menu.twig' %}
<!-- END: index/index.twig -->
{% endblock %}
