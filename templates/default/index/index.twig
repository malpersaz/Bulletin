{% extends "layouts/base.twig" %}


{% block js_custom %}
<script type="text/javascript">
$(document).ready(function() {
    // Bootstrap 5 ve jQuery çakışmasını aşmak için jQuery ile manuel başlatma
    var mainSlider = $('#mainSlider');
    if (mainSlider.length) {
        mainSlider.carousel({
            interval: 5000,
            wrap: true
        });
    }
});
</script>
{% endblock %}



{% block content %}
<!-- START: index/index.twig -->
    {{ run({"mod": "index", "method": "_hero_slider", "extra": [6]}) }}
    {% set homepage_hero_slider = ctx_get('hero_slider') %}

    {% if homepage_hero_slider and homepage_hero_slider|length > 0 %}
    <section class="row mt-3" id="orta" style="margin-top: 20px !important;">
        <article id="orta-sol" class="col-md-9">
            <style>
                @media (min-width: 992px) {
                    #orta-sol #heroNewsSlider {
                        margin-left: -14px;
                        width: calc(100% + 14px);
                    }
                }
            </style>
            {% include 'index/hero_slider.twig' with { hero_slider_items: homepage_hero_slider } %}
            {% include 'index/mod_video_embed/hero_followup.twig' %}
        </article>
        <aside id="orta-sag" class="col-md-3">
            {% include 'index/mod_publication/latest_authors.twig' %}
        </aside>
    </section>
    {% endif %}

    <section class="row">
        <article class="col-12">
            {# Fetch and display news for each category pinned to the homepage #}
            {{ run({"mod": "index", "method": "_homepage_news_categories", "extra": [1, "image,name,seo,summary,created_at"]}) }}
            {% set homepage_categories = ctx_get('homepage_news_categories') %}
            
            {% if homepage_categories and homepage_categories|length > 0 %}
                <div class="row g-0"> {# Using g-0 for seamless background transitions #}
                    {% for category in homepage_categories %}
                        {% if category.news|length > 0 %}
                            
                            <div class="col-md-4 category-column">
                                <div class="category-homepage-section h-100 p-4">
                                    <h2 class="nyt-news-heading">
                                        <a href="{{ site.sadres }}newses/{{ category.seo }}" class="text-decoration-none text-dark">{{ category.name }}</a>
                                    </h2>
                                    {% include 'index/mod_news/category_news_row.twig' with { news_items: category.news, category_name: category.name, category_seo: category.seo, is_column: true } %}
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% else %}
                {# Fallback to general latest news if no categories are pinned #}
                {% include 'index/mod_news/latest_news.twig' %}
            {% endif %}
        </article>
    </section>
    
    {# Include bottom menu when needed #}
    {% include 'partials/bottom_menu.twig' %}
<!-- END: index/index.twig -->
{% endblock %}
