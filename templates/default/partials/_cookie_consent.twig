        <p class="cookie-consent-text mb-3 mb-md-0">{{ lang.cookie_consent.message|default('Web sitemiz, deneyiminizi iyileştirmek ve hizmetlerimizi sunmak için çerezleri kullanır. Sitemizi kullanarak çerez politikamızı kabul etmiş olursunuz.') }}</p>
        <div class="cookie-consent-actions">
