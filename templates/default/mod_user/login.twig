{% extends "layouts/base.twig" %}


{% block title %}
<title>{{ lang.index.modal.login }} - {{ site.title }}</title>
{% endblock %}

{% block canonical %}
    <link rel="canonical" href="{{ site.sadres }}login" />
{% endblock %}

{% block head %}
    <meta name="robots" content="noindex">
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const loginForm = document.getElementById('login-form');
            const loginButton = document.getElementById('manual-submit-button');
            const alertContainer = document.getElementById('login-alerts');

            if (loginButton) {
                loginButton.addEventListener('click', function(e) {
                    e.preventDefault();
                    submitFormAjax();
                });
            }

            if (loginForm) {
                loginForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    submitFormAjax();
                });

                const usernameInput = document.getElementById('username');
                const passwordInput = document.getElementById('password');

                function handleEnterKey(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        submitFormAjax();
                    }
                }

                if (usernameInput) {
                    usernameInput.addEventListener('keypress', handleEnterKey);
                }
                if (passwordInput) {
                    passwordInput.addEventListener('keypress', handleEnterKey);
                }
            }

            function showAlert(message, type) {
                if (alertContainer) {
                    alertContainer.innerHTML = `<div class="alert alert-${type}" role="alert">${message}</div>`;
                }
            }

            function submitFormAjax() {
                const form = document.getElementById('login-form');
                if (!form) return;

                const username = document.getElementById('username').value;
                const password = document.getElementById('password').value;
                const button = document.getElementById('manual-submit-button');
                const originalText = button.textContent;

                // Loading state
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>...';

                const formData = new FormData();
                formData.append('username', username);
                formData.append('password', password);
                formData.append('login', 'login');
                formData.append('ajax_request', 'true');

                fetch('{{ site.sadres }}login', {
                    method: 'POST',
                    body: formData,
                    credentials: 'same-origin',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                })
                .then(response => {
                    const contentType = response.headers.get('content-type');
                    if (contentType && contentType.includes('application/json')) {
                        return response.json();
                    }
                    throw new Error('server_response_error');
                })
                .then(data => {
                    if (data.success) {
                        showAlert(data.message, 'success');
                        setTimeout(() => {
                            window.location.href = data.redirect || '{{ site.sadres }}';
                        }, 500);
                    } else {
                        let errorHtml = '<ul class="mb-0">';
                        if (data.errors && data.errors.length > 0) {
                            data.errors.forEach(err => {
                                errorHtml += `<li>${err}</li>`;
                            });
                        } else {
                            errorHtml += `<li>${data.message}</li>`;
                        }
                        errorHtml += '</ul>';
                        showAlert(errorHtml, 'danger');
                        button.disabled = false;
                        button.textContent = originalText;
                    }
                })
                .catch(error => {
                    console.error('Login request failed:', error);
                    showAlert('{{ lang.mod_user.ajax.connection_error|default("Têkilî bi serverê re serneket") }}', 'danger');
                    button.disabled = false;
                    button.textContent = originalText;
                });
            }
        });
    </script>
{% endblock %}

{% block content %}
{% set error = ctx_get('error') %}
{% set mesaj = ctx_get('mesaj') %}
{% set errors = ctx_get('errors') %}
{% set username = ctx_get('username') %}
{% set password = ctx_get('password') %}
{% set forgot_password_label = lang.mod_user.forgot_password is iterable ? (site.lang == 'en' ? 'Forgot Password' : (site.lang == 'ku' ? 'Min sifre ji bir kir' : 'Şifremi Unuttum')) : lang.mod_user.forgot_password %}
{% set account_activation_label = lang.mod_user.account_activation is iterable ? (site.lang == 'en' ? 'Account Activation' : (site.lang == 'ku' ? 'Calakirina profilê' : 'Hesap Aktifleştirme')) : lang.mod_user.account_activation %}
{% set register_label = lang.mod_user.register is iterable ? (site.lang == 'en' ? 'Register' : (site.lang == 'ku' ? 'Bibe Endam' : 'Kayıt Ol')) : lang.mod_user.register %}


<!-- START: mod_user/login.twig -->
<div class="row justify-content-center" id="mod_user">
    <div class="col-md-6 col-lg-4">
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-box-arrow-in-right me-2"></i>{{ lang.index.modal.login }}
                </h5>
            </div>
            <div class="card-body">
                {% if ctx_get('oke') is not empty %}
                    <div class="alert alert-success" role="alert">
                        {{ mesaj }}
                    </div>
                {% elseif error %}
                    <div class="alert alert-danger" role="alert">
                        {{ mesaj }}
                    </div>
                {% else %}
                    {% if errors is not empty %}
                        {% set is_activation_error = false %}
                        {% for error in errors %}
                            {% if 'Kaydınız bulundu, fakat mailinize gelen aktivasyonu gerçekleştirmemişsiniz' in error %}
                                {% set is_activation_error = true %}
                            {% endif %}
                        {% endfor %}

                        <div class="alert {% if is_activation_error %}alert-info{% else %}alert-danger{% endif %}" role="alert">
                            <ul class="mb-0">
                                {% for error in errors %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    <div id="login-alerts"></div>

                    <form method="post" action="{{ site.sadres }}login" id="login-form">
                            <div class="mb-3">
                                <label class="form-label" for="username">{{ lang.mod_user.username }}</label>
                                <input type="text"
                                       name="username"
                                       id="username"
                                       class="form-control"
                                       value="{{ username }}"
                                       placeholder="{{ lang.mod_user.username }}"
                                       required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="password">{{ lang.mod_user.password }}</label>
                                <input type="password"
                                       name="password"
                                       id="password"
                                       class="form-control"
                                       value="{{ password }}"
                                       placeholder="{{ lang.mod_user.password }}"
                                       required>
                            </div>

                            <div class="d-grid">
                                <button type="button" name="login" id="manual-submit-button" class="btn btn-primary">
                                    {{ lang.mod_user.login }}
                                </button>
                            </div>
                        </form>

                    <hr>
                    <div class="text-center">
                        <a href="forgot-password" class="btn btn-link p-0">{{ forgot_password_label }}</a>
                        <span class="mx-2">|</span>
                        <a href="activation" class="btn btn-link p-0">{{ account_activation_label }}</a>
                        <span class="mx-2">|</span>
                        <a href="register" class="btn btn-link p-0">{{ register_label }}</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
<!-- END: mod_user/login.twig -->
{% endblock %}
