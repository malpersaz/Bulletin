{% extends "layouts/base.twig" %}

{% block content %}
{% set oke = ctx_get('oke') %}
{% set mesaj = ctx_get('mesaj') %}
{% set errors = ctx_get('errors') %}
{% set email = ctx_get('email') %}
{% set captcha_image = ctx_get('captcha_image') %}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- Forgot Password Card -->
            <div class="card shadow-lg border-0 rounded-3 mt-5 mb-4">
                <!-- Card Header -->
                <!-- Card Header -->
                <div class="card-header bg-gradient-primary text-white text-center py-3 rounded-top-3">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-key-fill fs-4"></i>
                        <h2 class="card-title mb-0 fw-bold fs-5">{{ lang.mod_user.forgot_password.forgot_password_title }}</h2>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4 p-md-5">
                    {% if oke is defined and oke == true %}
                        <!-- Success Message -->
                        <div class="alert alert-success d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle-fill me-3"></i>
                            <div>
                                <strong>{{ lang.mod_user.success }}</strong>
                                <div class="small mt-1">{{ mesaj }}</div>
                            </div>
                        </div>

                        <!-- Redirect Info -->
                        <div class="text-center mt-4">
                            <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
                            <span class="text-muted">{{ lang.mod_user.forgot_password.redirecting }}</span>
                        </div>
                    {% else %}
                        <!-- Error Messages -->
                        {% if errors is defined %}
                            {% for error in errors %}
                                <div class="alert alert-danger d-flex align-items-center" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-3"></i>
                                    <div>
                                        <strong>{{ lang.mod_user.error_fatal }}</strong>
                                        <div class="small mt-1">{{ error }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}

                        <!-- Forgot Password Form -->
                        <form method="post" action="" id="forgotPasswordForm" class="needs-validation" novalidate>
                            <!-- Email Field -->
                            <div class="form-group mb-4">
                                <label for="email" class="form-label fw-semibold">
                                    <i class="bi bi-envelope-fill me-2 text-primary"></i>
                                    {{ lang.mod_user.forgot_password.email }}
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-envelope text-muted"></i>
                                    </span>
                                    <input class="form-control border-start-0"
                                           type="text"
                                           name="email"
                                           id="email"
                                           value="{{ email }}"
                                           placeholder="{{ lang.mod_user.forgot_password.email_placeholder }}"
                                           required>
                                    <div class="invalid-feedback">
                                        {{ lang.mod_user.forgot_password.error.email_required }}
                                    </div>
                                </div>
                                <div class="form-text text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    {{ lang.mod_user.forgot_password.info_1 }}
                                </div>
                            </div>

                            <!-- CAPTCHA Field -->
                            <div class="form-group mb-4">
                                <label for="captcha" class="form-label fw-semibold">
                                    <i class="bi bi-shield-fill me-2 text-primary"></i>
                                    {{ lang.mod_user.forgot_password.security_code }}
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-lock text-muted"></i>
                                    </span>
                                    <input class="form-control border-start-0 border-end-0"
                                           type="text"
                                           name="captcha"
                                           id="captcha"
                                           placeholder="{{ lang.mod_user.forgot_password.captcha_placeholder }}"
                                           style="min-width: 80px;"
                                           required>
                                    <span class="input-group-text bg-white p-1 border-start-0 d-flex align-items-center justify-content-center" style="cursor: pointer;" id="refreshCaptcha" title="{{ lang.mod_user.forgot_password.captcha_refresh }}">
                                         <img src="{{ captcha_image }}" id="captchaImage" alt="CAPTCHA" style="height: 30px; width: 120px; object-fit: contain; user-select: none; border-radius: 4px;">
                                         <i class="bi bi-arrow-repeat text-muted ms-2 fs-5 captcha-icon-hover" style="transition: transform 0.3s ease;"></i>
                                    </span>
                                    <div class="invalid-feedback">
                                        {{ lang.mod_user.forgot_password.error.captcha_required }}
                                    </div>
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <div class="d-grid gap-2">
                                <button type="submit"
                                        name="forgot_password"
                                        class="btn btn-primary btn-lg fw-semibold py-3">
                                    <i class="bi bi-send-fill me-2"></i>
                                    {{ lang.mod_user.forgot_password.send_button }}
                                </button>
                            </div>

                            <!-- Back to Login -->
                            <div class="text-center mt-4">
                                <a href="javascript:history.back()" class="text-decoration-none">
                                    <i class="bi bi-arrow-left me-2"></i>
                                    {{ lang.mod_user.forgot_password.back_to_login }}
                                </a>
                            </div>
                        </form>
                    {% endif %}
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light text-center py-3 rounded-bottom-3">
                    <div class="small text-muted">
                        <i class="bi bi-lock-fill me-1"></i>
                        {{ lang.mod_user.forgot_password.security_note }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Custom Styles -->
<style>
.card-header.bg-gradient-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
}

#refreshCaptcha {
    transition: background-color 0.2s ease;
}
#refreshCaptcha:hover {
    background-color: #f8f9fa !important;
}
#refreshCaptcha:hover .captcha-icon-hover {
    transform: rotate(180deg);
}
#refreshCaptcha:active .captcha-icon-hover {
    transform: rotate(180deg) scale(0.85);
}
#refreshCaptcha img {
    transition: transform 0.2s ease;
}
#refreshCaptcha:active img {
    transform: scale(0.95);
}

.form-control:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
}

.btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border: none;
    transition: all 0.3s ease;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
}

.alert {
    border: none;
    border-radius: 10px;
    animation: slideIn 0.3s ease;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.spinner-border {
    width: 1rem;
    height: 1rem;
}
</style>

<!-- JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Form validation
    const form = document.getElementById('forgotPasswordForm');
    if (form) {
        form.addEventListener('submit', function(event) {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        });
    }

    // CAPTCHA refresh on click
    const refreshBtn = document.getElementById('refreshCaptcha');
    const captchaImg = document.getElementById('captchaImage');
    if (refreshBtn && captchaImg) {
        refreshBtn.addEventListener('click', function(e) {
            e.preventDefault();
            captchaImg.src = '{{ site.saddress }}mod_user/captcha?' + Math.random();
        });
    }

    // Email validation with availability check
    const emailInput = document.getElementById('email');
    if (emailInput) {
        const emailFeedback = document.createElement('div');
        emailFeedback.className = 'form-text mt-1';
        emailFeedback.style.fontSize = '0.875rem';
        emailFeedback.style.marginTop = '0.25rem';

        // Insert feedback div after email input group
        const inputGroup = emailInput.closest('.input-group');
        if (inputGroup && inputGroup.parentNode) {
            inputGroup.parentNode.insertBefore(emailFeedback, inputGroup.nextSibling);
        }

        let debounceTimer;

        emailInput.addEventListener('input', function() {
            const email = this.value.trim();

            // Clear previous timer
            clearTimeout(debounceTimer);

            if (email.length === 0) {
                emailFeedback.innerHTML = '';
                this.classList.remove('is-valid', 'is-invalid');
                return;
            }

            // Basic email format validation
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                emailFeedback.innerHTML = `<small class="text-danger">{{ lang.mod_user.forgot_password.js.invalid_email|escape('js') }}</small>`;
                this.classList.remove('is-valid');
                this.classList.add('is-invalid');
                return;
            }

            // Email format is valid, check availability
            emailFeedback.innerHTML = `<small class="text-muted">{{ lang.mod_user.forgot_password.js.checking|escape('js') }}</small>`;
            this.classList.remove('is-invalid');

            // Debounce the request (wait 500ms after user stops typing)
            debounceTimer = setTimeout(() => {
                checkEmailAvailability(email);
            }, 500);
        });

        function checkEmailAvailability(email) {
            // Determine credentials mode based on cookie availability
            let credentialsMode = 'same-origin';
            try {
                if (!navigator.cookieEnabled) {
                    credentialsMode = 'omit';
                }
            } catch (e) {
                console.warn('Cookie access check failed:', e);
                credentialsMode = 'omit';
            }

            fetch('{{ site.saddress }}mod_user/check_email', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                credentials: credentialsMode,
                body: 'validateValue=' + encodeURIComponent(email) + '&validateId=email&validateError=' + encodeURIComponent('{{ lang.mod_user.forgot_password.error.email_not_registered|escape('js') }}')
            })
            .then(response => response.json())
            .then(data => {
                console.log('Email check response:', data);
                if (data.jsonValidateReturn && data.jsonValidateReturn[2] === "false") {
                    // Email is NOT unique (already registered) - this is GOOD for forgot password
                    emailInput.classList.remove('is-invalid');
                    emailInput.classList.add('is-valid');
                    emailFeedback.innerHTML = `<small class="text-success">{{ lang.mod_user.forgot_password.js.email_found|escape('js') }}</small>`;
                } else {
                    // Email is unique (not registered) - this is BAD for forgot password
                    emailInput.classList.remove('is-valid');
                    emailInput.classList.add('is-invalid');
                    emailFeedback.innerHTML = `<small class="text-danger">{{ lang.mod_user.forgot_password.js.email_not_found|escape('js') }}</small>`;
                }
            })
            .catch(error => {
                console.error('Email check error:', error);
                emailFeedback.innerHTML = `<small class="text-warning">{{ lang.mod_user.forgot_password.js.check_failed|escape('js') }}</small>`;
            });
        }
    }

    // Auto-redirect on success
    const successAlert = document.querySelector('.alert-success');
    if (successAlert) {
        setTimeout(function() {
            window.location.href = '{{ site.saddress }}login';
        }, 3000);
    }
});
</script>
{% endblock %}
