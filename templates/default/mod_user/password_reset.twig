{% extends "layouts/base.twig" %}

{% block content %}
{% set oke = ctx_get('oke') %}
{% set mesaj = ctx_get('mesaj') %}
{% set errors = ctx_get('errors') %}
{% set code = ctx_get('code') %}
{% set captcha_image = ctx_get('captcha_image') %}

<div class="container px-0 px-sm-3">
    <div class="row justify-content-center mx-0">
        <div class="col-md-6 col-lg-5 px-0 px-sm-3">
            <!-- Password Reset Card -->
            <div class="card app-card shadow-lg border-0 rounded-3 mt-0 mt-sm-5 mb-4">
                <!-- Card Header -->
                <div class="card-header bg-gradient-primary text-white text-center py-3 rounded-top-3 border-0">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-shield-lock-fill fs-4"></i>
                        <h2 class="card-title mb-0 fw-bold fs-5">{{ lang.mod_user.password_reset.title }}</h2>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4 p-md-5">
                    {% if oke is defined and oke == true %}
                        <!-- Success Message -->
                        <div class="alert alert-success d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle-fill me-3"></i>
                            <div>
                                <strong>{{ lang.mod_user.success }}</strong>
                                <div class="small mt-1">{{ mesaj }}</div>
                            </div>
                        </div>

                        <!-- Redirect Info -->
                        <div class="text-center mt-4">
                            <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
                            <span class="text-muted">{{ lang.mod_user.forgot_password.redirecting }}</span>
                        </div>
                    {% else %}
                        <!-- Info Note -->
                        <p class="text-muted small mb-4 text-center text-sm-start">
                            {{ lang.mod_user.password_reset.info }}
                        </p>

                        <!-- Error Messages -->
                        {% if errors is defined %}
                            {% for error in errors %}
                                <div class="alert alert-danger d-flex align-items-center" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-3"></i>
                                    <div>
                                        <strong>{{ lang.mod_user.error_fatal }}</strong>
                                        <div class="small mt-1">{{ error }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}

                        <!-- Password Reset Form -->
                        <form method="post" action="" id="passwordResetForm" class="needs-validation" novalidate>
                            <!-- Hidden Reset Code -->
                            <input type="hidden" name="code" value="{{ code }}">

                            <!-- New Password Input -->
                            <div class="mb-4">
                                <label for="new_password" class="form-label fw-semibold small text-secondary">
                                    {{ lang.mod_user.password_reset.new_password }}
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input type="password" 
                                           name="new_password" 
                                           id="new_password" 
                                           class="form-control border-start-0 ps-0" 
                                           placeholder="{{ lang.mod_user.password_reset.new_password_placeholder }}" 
                                           required 
                                           minlength="6" 
                                           maxlength="20">
                                </div>
                            </div>

                            <!-- Confirm New Password Input -->
                            <div class="mb-4">
                                <label for="confirm_password" class="form-label fw-semibold small text-secondary">
                                    {{ lang.mod_user.password_reset.confirm_new_password }}
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>
                                    <input type="password" 
                                           name="confirm_password" 
                                           id="confirm_password" 
                                           class="form-control border-start-0 ps-0" 
                                           placeholder="{{ lang.mod_user.password_reset.confirm_password_placeholder }}" 
                                           required 
                                           minlength="6" 
                                           maxlength="20">
                                </div>
                            </div>

                            <!-- CAPTCHA Section -->
                            <div class="mb-4">
                                <label for="captcha" class="form-label fw-semibold small text-secondary">
                                    {{ lang.mod_user.password_reset.security_code }}
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-lock text-muted"></i>
                                    </span>
                                    <input type="text" 
                                           name="captcha" 
                                           id="captcha" 
                                           class="form-control border-start-0 border-end-0 ps-0" 
                                           placeholder="{{ lang.mod_user.password_reset.captcha_placeholder }}" 
                                           style="min-width: 80px;"
                                           required 
                                           autocomplete="off">
                                    <span class="input-group-text bg-white p-1 border-start-0 d-flex align-items-center justify-content-center" style="cursor: pointer;" id="refreshCaptcha" title="{{ lang.mod_user.forgot_password.captcha_refresh }}">
                                         <img src="{{ captcha_image }}" id="captchaImage" alt="CAPTCHA" style="height: 30px; width: 120px; object-fit: contain; user-select: none; border-radius: 4px;">
                                         <i class="bi bi-arrow-repeat text-muted ms-2 fs-5 captcha-icon-hover" style="transition: transform 0.3s ease;"></i>
                                    </span>
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold text-uppercase mt-2">
                                {{ lang.mod_user.password_reset.change_button }}
                            </button>
                        </form>
                    {% endif %}
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light text-center py-3 border-0 rounded-bottom-3">
                    <a href="{{ site.saddress }}login" class="text-decoration-none small fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> {{ lang.mod_user.forgot_password.back_to_login }}
                    </a>
                </div>
            </div>

            <!-- Additional Security Note -->
            <div class="text-center mb-5 px-3">
                <p class="text-muted small">
                    <i class="bi bi-shield-lock me-1"></i> {{ lang.mod_user.forgot_password.security_note }}
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Styles to ensure consistency and layout look -->
<style>
.bg-gradient-primary {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
}

.form-control:focus {
    box-shadow: none;
    border-color: #ced4da;
}

.input-group:focus-within .input-group-text,
.input-group:focus-within .form-control {
    border-color: #818cf8;
}

.spinner-border {
    width: 1rem;
    height: 1rem;
}

.captcha-icon-hover:hover {
    color: #4f46e5 !important;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
.spin-animation {
    animation: spin 0.6s ease-in-out;
}

@media (max-width: 575.98px) {
    .app-card {
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }
    .app-card .card-header {
        border-radius: 0 !important;
    }
    .app-card .card-footer {
        border-radius: 0 !important;
        background-color: transparent !important;
    }
}
</style>

<!-- JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Form validation
    const form = document.getElementById('passwordResetForm');
    if (form) {
        form.addEventListener('submit', function(event) {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        });
    }

    // CAPTCHA refresh on click with micro-animation
    const refreshBtn = document.getElementById('refreshCaptcha');
    const captchaImg = document.getElementById('captchaImage');
    if (refreshBtn && captchaImg) {
        refreshBtn.addEventListener('click', function(e) {
            e.preventDefault();
            captchaImg.src = '{{ site.saddress }}mod_user/captcha?' + Math.random();
            const icon = refreshBtn.querySelector('.bi-arrow-repeat');
            if (icon) {
                icon.classList.add('spin-animation');
                icon.addEventListener('animationend', function() {
                    icon.classList.remove('spin-animation');
                }, { once: true });
            }
        });
    }

    // Auto-redirect on success
    const successAlert = document.querySelector('.alert-success');
    if (successAlert) {
        setTimeout(function() {
            window.location.href = '{{ site.saddress }}login';
        }, 3000);
    }
});
</script>
{% endblock %}
