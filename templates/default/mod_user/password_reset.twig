{% extends "layouts/base.twig" %}

{% block content %}
{% set oke = ctx_get('oke') %}
{% set mesaj = ctx_get('mesaj') %}
{% set errors = ctx_get('errors') %}
{% set code = ctx_get('code') %}
{% set captcha_image = ctx_get('captcha_image') %}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- Password Reset Card -->
            <div class="card shadow-lg border-0 rounded-3 mt-5 mb-4">
                <!-- Card Header -->
                <div class="card-header bg-gradient-primary text-white text-center py-3 rounded-top-3">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-shield-lock-fill fs-4"></i>
                        <h2 class="card-title mb-0 fw-bold fs-5">{{ lang.mod_user.password_reset.title }}</h2>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4 p-md-5">
                    {% if oke is defined and oke == true %}
                        <!-- Success Message -->
                        <div class="alert alert-success d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle-fill me-3"></i>
                            <div>
                                <strong>{{ lang.mod_user.success }}</strong>
                                <div class="small mt-1">{{ mesaj }}</div>
                            </div>
                        </div>

                        <!-- Redirect Info -->
                        <div class="text-center mt-4">
                            <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
                            <span class="text-muted">{{ lang.mod_user.forgot_password.redirecting }}</span>
                        </div>
                    {% else %}
                        <!-- Info Note -->
                        <p class="text-muted small mb-4">
                            {{ lang.mod_user.password_reset.info }}
                        </p>

                        <!-- Error Messages -->
                        {% if errors is defined %}
                            {% for error in errors %}
                                <div class="alert alert-danger d-flex align-items-center" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-3"></i>
                                    <div>
                                        <strong>{{ lang.mod_user.error_fatal }}</strong>
                                        <div class="small mt-1">{{ error }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}

                        <!-- Password Reset Form -->
                        <form method="post" action="" id="passwordResetForm" class="needs-validation" novalidate>
                            <!-- Hidden Reset Code -->
                            <input type="hidden" name="code" value="{{ code }}">

                            <!-- New Password Input -->
                            <div class="mb-4">
                                <label for="new_password" class="form-label fw-semibold small text-secondary">
                                    {{ lang.mod_user.password_reset.new_password }}
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input type="password" 
                                           name="new_password" 
                                           id="new_password" 
                                           class="form-control border-start-0 ps-0" 
                                           placeholder="{{ lang.mod_user.password_reset.new_password_placeholder }}" 
                                           required 
                                           minlength="6" 
                                           maxlength="20">
                                </div>
                            </div>

                            <!-- Confirm New Password Input -->
                            <div class="mb-4">
                                <label for="confirm_password" class="form-label fw-semibold small text-secondary">
                                    {{ lang.mod_user.password_reset.confirm_new_password }}
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>
                                    <input type="password" 
                                           name="confirm_password" 
                                           id="confirm_password" 
                                           class="form-control border-start-0 ps-0" 
                                           placeholder="{{ lang.mod_user.password_reset.confirm_password_placeholder }}" 
                                           required 
                                           minlength="6" 
                                           maxlength="20">
                                </div>
                            </div>

                            <!-- CAPTCHA Section -->
                            <div class="mb-4">
                                <label for="captcha" class="form-label fw-semibold small text-secondary">
                                    {{ lang.mod_user.password_reset.security_code }}
                                </label>
                                <div class="row g-2 align-items-center">
                                    <!-- CAPTCHA Image -->
                                    <div class="col-6">
                                        <div class="border rounded-2 p-1 bg-light text-center d-flex align-items-center justify-content-center" style="height: 48px;">
                                            <img id="captchaImage" src="{{ captcha_image }}" alt="Security Code" class="img-fluid rounded-1" style="max-height: 40px;">
                                        </div>
                                    </div>
                                    <!-- Refresh Button -->
                                    <div class="col-6">
                                        <button type="button" id="refreshCaptcha" class="btn btn-outline-secondary btn-sm w-100 py-2 d-flex align-items-center justify-content-center gap-1" style="height: 48px;" title="{{ lang.mod_user.forgot_password.captcha_refresh }}">
                                            <i class="bi bi-arrow-clockwise"></i>
                                            <span class="small">{{ lang.mod_user.forgot_password.captcha_refresh }}</span>
                                        </button>
                                    </div>
                                </div>
                                <!-- CAPTCHA Input -->
                                <div class="input-group mt-3">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-shield-check"></i>
                                    </span>
                                    <input type="text" 
                                           name="captcha" 
                                           id="captcha" 
                                           class="form-control border-start-0 ps-0" 
                                           placeholder="{{ lang.mod_user.password_reset.captcha_placeholder }}" 
                                           required 
                                           autocomplete="off">
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold text-uppercase mt-2">
                                {{ lang.mod_user.password_reset.change_button }}
                            </button>
                        </form>
                    {% endif %}
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light text-center py-3 border-0 rounded-bottom-3">
                    <a href="{{ site.saddress }}login" class="text-decoration-none small fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> {{ lang.mod_user.forgot_password.back_to_login }}
                    </a>
                </div>
            </div>

            <!-- Additional Security Note -->
            <div class="text-center mb-5">
                <p class="text-muted small">
                    <i class="bi bi-shield-lock me-1"></i> {{ lang.mod_user.forgot_password.security_note }}
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Styles to ensure consistency and layout look -->
<style>
.bg-gradient-primary {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
}

.form-control:focus {
    box-shadow: none;
    border-color: #ced4da;
}

.input-group:focus-within .input-group-text,
.input-group:focus-within .form-control {
    border-color: #818cf8;
}

.spinner-border {
    width: 1rem;
    height: 1rem;
}
</style>

<!-- JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Form validation
    const form = document.getElementById('passwordResetForm');
    if (form) {
        form.addEventListener('submit', function(event) {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        });
    }

    // CAPTCHA refresh on click
    const refreshBtn = document.getElementById('refreshCaptcha');
    const captchaImg = document.getElementById('captchaImage');
    if (refreshBtn && captchaImg) {
        refreshBtn.addEventListener('click', function(e) {
            e.preventDefault();
            captchaImg.src = '{{ site.saddress }}mod_user/captcha?' + Math.random();
        });
    }

    // Auto-redirect on success
    const successAlert = document.querySelector('.alert-success');
    if (successAlert) {
        setTimeout(function() {
            window.location.href = '{{ site.saddress }}login';
        }, 3000);
    }
});
</script>
{% endblock %}
