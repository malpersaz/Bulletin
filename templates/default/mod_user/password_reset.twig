{% extends "layouts/base.twig" %}

{% block content %}
{% set oke = ctx_get('oke') %}
{% set mesaj = ctx_get('mesaj') %}
{% set errors = ctx_get('errors') %}
{% set code = ctx_get('code') %}
{% set captcha_image = ctx_get('captcha_image') %}

<div class="container px-0 px-sm-3">
    <div class="row justify-content-center mx-0">
        <div class="col-md-6 col-lg-5 px-0 px-sm-3">
            <!-- Password Reset Card -->
            <div class="card app-card shadow-lg border-0 rounded-3 mt-0 mt-sm-5 mb-4">
                <!-- Card Header -->
                <div class="card-header bg-gradient-primary text-white text-center py-3 rounded-top-3 border-0">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-shield-lock-fill fs-4"></i>
                        <h2 class="card-title mb-0 fw-bold fs-5">{{ lang.mod_user.password_reset.title }}</h2>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4 p-md-5">
                    {% if oke is defined and oke == true %}
                        <!-- Success Message -->
                        <div class="alert alert-success d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle-fill me-3"></i>
                            <div>
                                <strong>{{ lang.mod_user.success }}</strong>
                                <div class="small mt-1">{{ mesaj }}</div>
                            </div>
                        </div>

                        <!-- Redirect Info -->
                        <div class="text-center mt-4">
                            <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
                            <span class="text-muted">{{ lang.mod_user.forgot_password.redirecting }}</span>
                        </div>
                    {% else %}
                        <!-- Info Note -->
                        <p class="text-muted small mb-4 text-center text-sm-start">
                            {{ lang.mod_user.password_reset.info }}
                        </p>

                        <!-- Error Messages -->
                        {% if errors is defined %}
                            {% for error in errors %}
                                <div class="alert alert-danger d-flex align-items-center" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-3"></i>
                                    <div>
                                        <strong>{{ lang.mod_user.error_fatal }}</strong>
                                        <div class="small mt-1">{{ error }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}

                        <!-- Password Reset Form -->
                        <form method="post" action="" id="passwordResetForm" class="needs-validation" novalidate>
                            <!-- Hidden Reset Code -->
                            <input type="hidden" name="code" value="{{ code }}">

                            <!-- New Password Input -->
                            <div class="mb-4">
                                <label for="new_password" class="form-label fw-semibold small text-secondary">
                                    {{ lang.mod_user.password_reset.new_password }}
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input type="password" 
                                           name="new_password" 
                                           id="new_password" 
                                           class="form-control border-start-0 border-end-0 ps-0" 
                                           placeholder="{{ lang.mod_user.password_reset.new_password_placeholder }}" 
                                           required 
                                           minlength="8" 
                                           maxlength="64">
                                    <span class="input-group-text bg-light text-muted border-start-0 toggle-password" style="cursor: pointer;" data-target="new_password">
                                        <i class="bi bi-eye"></i>
                                    </span>
                                </div>
                            </div>

                            <!-- Password Strength Indicator -->
                            <div class="mb-3 d-none" id="strengthContainer">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small fw-semibold text-secondary">{{ lang.mod_user.password_reset.strength_label }}</span>
                                    <span class="small fw-bold" id="strengthText"></span>
                                </div>
                                <div class="progress shadow-sm" style="height: 6px; border-radius: 3px;">
                                    <div class="progress-bar" id="strengthBar" role="progressbar" style="width: 0%; transition: width 0.3s ease, background-color 0.3s ease;"></div>
                                </div>
                            </div>

                            <!-- Password Criteria Checklist -->
                            <div class="mb-4 p-3 bg-light rounded-3 shadow-sm border" id="criteriaContainer">
                                <div class="row row-cols-1 row-cols-sm-2 g-2">
                                    <div class="col small d-flex align-items-center gap-2 criteria-item" data-rule="length">
                                        <i class="bi bi-x-circle-fill text-danger criteria-icon" style="transition: transform 0.2s ease;"></i>
                                        <span class="text-secondary">{{ lang.mod_user.password_reset.rule_min_length }}</span>
                                    </div>
                                    <div class="col small d-flex align-items-center gap-2 criteria-item" data-rule="uppercase">
                                        <i class="bi bi-x-circle-fill text-danger criteria-icon" style="transition: transform 0.2s ease;"></i>
                                        <span class="text-secondary">{{ lang.mod_user.password_reset.rule_uppercase }}</span>
                                    </div>
                                    <div class="col small d-flex align-items-center gap-2 criteria-item" data-rule="lowercase">
                                        <i class="bi bi-x-circle-fill text-danger criteria-icon" style="transition: transform 0.2s ease;"></i>
                                        <span class="text-secondary">{{ lang.mod_user.password_reset.rule_lowercase }}</span>
                                    </div>
                                    <div class="col small d-flex align-items-center gap-2 criteria-item" data-rule="number">
                                        <i class="bi bi-x-circle-fill text-danger criteria-icon" style="transition: transform 0.2s ease;"></i>
                                        <span class="text-secondary">{{ lang.mod_user.password_reset.rule_number }}</span>
                                    </div>
                                    <div class="col small d-flex align-items-center gap-2 criteria-item" data-rule="special">
                                        <i class="bi bi-x-circle-fill text-danger criteria-icon" style="transition: transform 0.2s ease;"></i>
                                        <span class="text-secondary">{{ lang.mod_user.password_reset.rule_special }}</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Confirm New Password Input -->
                            <div class="mb-4">
                                <label for="confirm_password" class="form-label fw-semibold small text-secondary">
                                    {{ lang.mod_user.password_reset.confirm_new_password }}
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>
                                    <input type="password" 
                                           name="confirm_password" 
                                           id="confirm_password" 
                                           class="form-control border-start-0 border-end-0 ps-0" 
                                           placeholder="{{ lang.mod_user.password_reset.confirm_password_placeholder }}" 
                                           required 
                                           minlength="8" 
                                           maxlength="64">
                                    <span class="input-group-text bg-light text-muted border-start-0 toggle-password" style="cursor: pointer;" data-target="confirm_password">
                                        <i class="bi bi-eye"></i>
                                    </span>
                                </div>
                            </div>

                            <!-- Password Matching Status -->
                            <div class="mb-4 d-none" id="matchContainer">
                                <div class="d-flex align-items-center gap-2 small p-2 rounded bg-light border">
                                    <i class="bi bi-x-circle-fill text-danger" id="matchIcon"></i>
                                    <span class="fw-semibold text-secondary" id="matchText"></span>
                                </div>
                            </div>

                            <!-- CAPTCHA Section -->
                            <div class="mb-4">
                                <label for="captcha" class="form-label fw-semibold small text-secondary">
                                    {{ lang.mod_user.password_reset.security_code }}
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-shield-check text-muted"></i>
                                    </span>
                                    <input type="text" 
                                           name="captcha" 
                                           id="captcha" 
                                           class="form-control border-start-0 border-end-0 ps-0" 
                                           placeholder="{{ lang.mod_user.password_reset.captcha_placeholder }}" 
                                           style="min-width: 80px;"
                                           required 
                                           autocomplete="off">
                                    <span class="input-group-text bg-white p-1 border-start-0 d-flex align-items-center justify-content-center" style="cursor: pointer;" id="refreshCaptcha" title="{{ lang.mod_user.forgot_password.captcha_refresh }}">
                                         <img src="{{ captcha_image }}" id="captchaImage" alt="CAPTCHA" style="height: 30px; width: 120px; object-fit: contain; user-select: none; border-radius: 4px;">
                                         <i class="bi bi-arrow-repeat text-muted ms-2 fs-5 captcha-icon-hover" style="transition: transform 0.3s ease;"></i>
                                    </span>
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold text-uppercase mt-2 shadow-sm" style="border-radius: 8px; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                                {{ lang.mod_user.password_reset.change_button }}
                            </button>
                        </form>
                    {% endif %}
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light text-center py-3 border-0 rounded-bottom-3">
                    <a href="{{ site.saddress }}login" class="text-decoration-none small fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> {{ lang.mod_user.forgot_password.back_to_login }}
                    </a>
                </div>
            </div>

            <!-- Additional Security Note -->
            <div class="text-center mb-5 px-3">
                <p class="text-muted small">
                    <i class="bi bi-shield-lock me-1"></i> {{ lang.mod_user.forgot_password.security_note }}
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Styles to ensure consistency and layout look -->
<style>
.bg-gradient-primary {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
}

.form-control:focus {
    box-shadow: none;
    border-color: #ced4da;
}

.input-group:focus-within .input-group-text,
.input-group:focus-within .form-control {
    border-color: #818cf8;
}

.spinner-border {
    width: 1rem;
    height: 1rem;
}

.captcha-icon-hover:hover {
    color: #4f46e5 !important;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
.spin-animation {
    animation: spin 0.6s ease-in-out;
}

@media (max-width: 575.98px) {
    .app-card {
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }
    .app-card .card-header {
        border-radius: 0 !important;
    }
    .app-card .card-footer {
        border-radius: 0 !important;
        background-color: transparent !important;
    }
}
</style>

<!-- JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Form validation
    const form = document.getElementById('passwordResetForm');
    if (form) {
        form.addEventListener('submit', function(event) {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        });
    }

    // Toggle Password Visibility
    const toggles = document.querySelectorAll('.toggle-password');
    toggles.forEach(toggle => {
        toggle.addEventListener('click', function() {
            const targetId = this.getAttribute('data-target');
            const targetInput = document.getElementById(targetId);
            const icon = this.querySelector('i');
            if (targetInput && icon) {
                if (targetInput.type === 'password') {
                    targetInput.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    targetInput.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            }
        });
    });

    // Password strength and criteria check
    const newPassword = document.getElementById('new_password');
    const confirmPassword = document.getElementById('confirm_password');
    const strengthContainer = document.getElementById('strengthContainer');
    const strengthBar = document.getElementById('strengthBar');
    const strengthText = document.getElementById('strengthText');
    const matchContainer = document.getElementById('matchContainer');
    const matchIcon = document.getElementById('matchIcon');
    const matchText = document.getElementById('matchText');

    const rules = {
        length: val => val.length >= 8,
        uppercase: val => /[A-Z]/.test(val),
        lowercase: val => /[a-z]/.test(val),
        number: val => /[0-9]/.test(val),
        special: val => /[^A-Za-z0-9]/.test(val)
    };

    const criteriaLabels = {
        weak: '{{ lang.mod_user.password_strength.weak }}',
        fair: '{{ lang.mod_user.password_strength.fair }}',
        good: '{{ lang.mod_user.password_strength.good }}',
        strong: '{{ lang.mod_user.password_strength.strong }}'
    };

    if (newPassword) {
        newPassword.addEventListener('input', function() {
            const val = this.value;
            if (val.length > 0) {
                strengthContainer.classList.remove('d-none');
            } else {
                strengthContainer.classList.add('d-none');
            }

            let score = 0;
            Object.keys(rules).forEach(rule => {
                const isValid = rules[rule](val);
                const item = document.querySelector(`.criteria-item[data-rule="${rule}"]`);
                if (item) {
                    const icon = item.querySelector('.criteria-icon');
                    if (isValid) {
                        icon.className = 'bi bi-check-circle-fill text-success criteria-icon';
                        score++;
                    } else {
                        icon.className = 'bi bi-x-circle-fill text-danger criteria-icon';
                    }
                }
            });

            // Update strength bar and text
            let pct = (score / 5) * 100;
            strengthBar.style.width = pct + '%';
            if (score <= 2) {
                strengthBar.className = 'progress-bar bg-danger';
                strengthText.textContent = criteriaLabels.weak;
                strengthText.className = 'small fw-bold text-danger';
            } else if (score <= 4) {
                strengthBar.className = 'progress-bar bg-warning';
                strengthText.textContent = criteriaLabels.fair;
                strengthText.className = 'small fw-bold text-warning';
            } else {
                strengthBar.className = 'progress-bar bg-success';
                strengthText.textContent = criteriaLabels.strong;
                strengthText.className = 'small fw-bold text-success';
            }

            checkPasswordsMatch();
        });
    }

    function checkPasswordsMatch() {
        if (!confirmPassword || !newPassword) return;
        const pass1 = newPassword.value;
        const pass2 = confirmPassword.value;

        if (pass2.length > 0) {
            matchContainer.classList.remove('d-none');
            if (pass1 === pass2) {
                matchIcon.className = 'bi bi-check-circle-fill text-success';
                matchText.textContent = '{{ lang.mod_user.password_reset.password_match }}';
                matchText.className = 'fw-semibold text-success';
            } else {
                matchIcon.className = 'bi bi-x-circle-fill text-danger';
                matchText.textContent = '{{ lang.mod_user.password_match.error }}';
                matchText.className = 'fw-semibold text-danger';
            }
        } else {
            matchContainer.classList.add('d-none');
        }
    }

    if (confirmPassword) {
        confirmPassword.addEventListener('input', checkPasswordsMatch);
    }

    // CAPTCHA refresh on click with micro-animation
    const refreshBtn = document.getElementById('refreshCaptcha');
    const captchaImg = document.getElementById('captchaImage');
    if (refreshBtn && captchaImg) {
        refreshBtn.addEventListener('click', function(e) {
            e.preventDefault();
            captchaImg.src = '{{ site.saddress }}mod_user/captcha?' + Math.random();
            const icon = refreshBtn.querySelector('.bi-arrow-repeat');
            if (icon) {
                icon.classList.add('spin-animation');
                icon.addEventListener('animationend', function() {
                    icon.classList.remove('spin-animation');
                }, { once: true });
            }
        });
    }

    // Auto-redirect on success
    const successAlert = document.querySelector('.alert-success');
    if (successAlert) {
        setTimeout(function() {
            window.location.href = '{{ site.saddress }}login';
        }, 3000);
    }
});
</script>
{% endblock %}
