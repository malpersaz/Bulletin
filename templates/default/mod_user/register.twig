{% extends "layouts/base.twig" %}

{% block title %}
	<title>{{ lang.mod_user.register.form_title }}
		-
		{{ site.title }}</title>
{% endblock %}

{% block canonical %}
	<link rel="canonical" href="{{ site.sadres }}register"/>
{% endblock %}

{% block head %}
	<meta name="robots" content="noindex">
	<script>
		const LANG = {{ js_lang|raw }};

document.addEventListener('DOMContentLoaded', function () { // Check if form was just submitted successfully
if (window.location.search.includes('success=1')) { // Only create client-side alert if server-side alert is NOT present
if (!document.querySelector('.alert-success')) {
const alertDiv = document.createElement('div');
alertDiv.className = 'alert alert-success alert-dismissible fade show';
alertDiv.setAttribute('role', 'alert');
alertDiv.innerHTML = `
                    ${
LANG.register_basarili
}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;

// Insert at the top of card body
const cardBody = document.querySelector('.card-body');
if (cardBody) {
cardBody.insertBefore(alertDiv, cardBody.firstChild);
}
}

// Hide the form if it exists
const registerForm = document.getElementById('register');
if (registerForm) {
registerForm.style.display = 'none';
}

// Remove URL parameter
const url = window.location.pathname;
window.history.replaceState({}, document.title, url);
}

// Real-time username validation
const usernameInput = document.getElementById('username');
const usernameFeedback = document.createElement('div');
usernameFeedback.className = 'form-text mt-1';
usernameFeedback.style.fontSize = '0.875rem';
usernameFeedback.style.marginTop = '0.25rem';

// Insert feedback div after username input
usernameInput.parentNode.insertBefore(usernameFeedback, usernameInput.nextSibling);

let debounceTimer;

usernameInput.addEventListener('input', function () {
const username = this.value.trim();

// Clear previous timer
clearTimeout(debounceTimer);

// Show loading state
if (username.length >= 2) {
usernameFeedback.innerHTML = `<small class="text-muted">${
LANG.kontrol_ediliyor
}</small>`;
} else {
usernameFeedback.innerHTML = '';
}

// Debounce the request (wait 500ms after user stops typing)
debounceTimer = setTimeout(() => {
if (username.length >= 2) {
checkUsernameAvailability(username);
} else {
usernameFeedback.innerHTML = '';
}
}, 500);
});

function checkUsernameAvailability(username) { // Determine credentials mode based on cookie availability
let credentialsMode = 'same-origin';
try {
if (!navigator.cookieEnabled) {
credentialsMode = 'omit';
}
} catch (e) {
console.warn('Cookie access check failed:', e);
credentialsMode = 'omit';
}

fetch('{{ site.sadres }}mod_user/checkUsernameAvailability', {
method: 'POST',
headers: {
'Content-Type': 'application/x-www-form-urlencoded'
},
credentials: credentialsMode,
body: 'username=' + encodeURIComponent(username)
}).then(response => response.json()).then(data => {
if (data.available) {
usernameInput.classList.remove('is-invalid');
usernameInput.classList.add('is-valid');
usernameFeedback.innerHTML = `<small class="text-success">${
LANG.username_kullanilabilir
}</small>`;
} else {
usernameInput.classList.remove('is-valid');
usernameInput.classList.add('is-invalid');
usernameFeedback.innerHTML = `<small class="text-danger">${
LANG.username_mevcut
}</small>`;
}
}).catch(error => {
console.error('Username check error:', error);
usernameFeedback.innerHTML = `<small class="text-warning">${
LANG.kontrol_yapilamadi
}</small>`;
});
}

// Email validation
const emailInput = document.getElementById('email');
const emailFeedback = document.createElement('div');
emailFeedback.className = 'form-text mt-1';
emailFeedback.style.fontSize = '0.875rem';
emailFeedback.style.marginTop = '0.25rem';

emailInput.parentNode.insertBefore(emailFeedback, emailInput.nextSibling);

emailInput.addEventListener('input', function () {
const email = this.value.trim();

if (email.length > 0 && email.includes('@')) {
clearTimeout(debounceTimer);

emailFeedback.innerHTML = `<small class="text-muted">${
LANG.kontrol_ediliyor
}</small>`;

debounceTimer = setTimeout(() => {
checkEmailAvailability(email);
}, 500);
} else {
emailFeedback.innerHTML = '';
emailInput.classList.remove('is-valid', 'is-invalid');
}
});

function checkEmailAvailability(email) { // Determine credentials mode based on cookie availability
let credentialsMode = 'same-origin';
try {
if (!navigator.cookieEnabled) {
credentialsMode = 'omit';
}
} catch (e) {
console.warn('Cookie access check failed:', e);
credentialsMode = 'omit';
}

fetch('{{ site.sadres }}mod_user/emailcheck', {
method: 'POST',
headers: {
'Content-Type': 'application/x-www-form-urlencoded'
},
credentials: credentialsMode,
body: 'validateValue=' + encodeURIComponent(email) + '&validateId=email&validateError=' + encodeURIComponent(LANG.email_mevcut)
}).then(response => response.json()).then(data => {
console.log('Email check response:', data);
if (data.jsonValidateReturn && data.jsonValidateReturn[2] === "true") {
emailInput.classList.remove('is-invalid');
emailInput.classList.add('is-valid');
emailFeedback.innerHTML = `<small class="text-success">${
LANG.email_kullanilabilir
}</small>`;
} else {
emailInput.classList.remove('is-valid');
emailInput.classList.add('is-invalid');
emailFeedback.innerHTML = `<small class="text-danger">${
LANG.email_mevcut
}</small>`;
}
}).catch(error => {
console.error('Email check error:', error);
emailFeedback.innerHTML = `<small class="text-warning">${
LANG.kontrol_yapilamadi
}</small>`;
});
}

// Phone number formatting based on country
const countryCodeSelect = document.getElementById('country_code');
const phoneInput = document.getElementById('phone');

// Country phone formats
const phoneFormats = {
'+90': {
pattern: /^\d{10}$/,
placeholder: '555 123 4567',
format: 'xxx xxx xx xx',
maxLength: 10
},
'+1': {
pattern: /^\d{10}$/,
placeholder: '555 123 4567',
format: 'xxx xxx xxxx',
maxLength: 10
},
'+44': {
pattern: /^\d{10}$/,
placeholder: '20 7946 0958',
format: 'xx xxxx xxxx',
maxLength: 10
},
'+49': {
pattern: /^\d{10,11}$/,
placeholder: '30 12345678',
format: 'xxx xxxxxxxx',
maxLength: 11
},
'+33': {
pattern: /^\d{9}$/,
placeholder: '6 12 34 56 78',
format: 'x xx xx xx xx',
maxLength: 9
},
'+34': {
pattern: /^\d{9}$/,
placeholder: '612 345 678',
format: 'xxx xxx xxx',
maxLength: 9
},
'+39': {
pattern: /^\d{10}$/,
placeholder: '333 1234567',
format: 'xxx xxxxxxx',
maxLength: 10
},
'+31': {
pattern: /^\d{9}$/,
placeholder: '6 12345678',
format: 'x xxxxxxxx',
maxLength: 9
},
'+41': {
pattern: /^\d{9}$/,
placeholder: '79 123 45 67',
format: 'xx xxx xx xx',
maxLength: 9
},
'+43': {
pattern: /^\d{10}$/,
placeholder: '699 1234567',
format: 'xxx xxxxxxx',
maxLength: 10
},
'+46': {
pattern: /^\d{9}$/,
placeholder: '70 123 45 67',
format: 'xx xxx xx xx',
maxLength: 9
},
'+47': {
pattern: /^\d{8}$/,
placeholder: '123 45678',
format: 'xxx xxxxx',
maxLength: 8
},
'+358': {
pattern: /^\d{9,10}$/,
placeholder: '50 123 4567',
format: 'xx xxx xxxx',
maxLength: 10
},
'+45': {
pattern: /^\d{8}$/,
placeholder: '12 34 56 78',
format: 'xx xx xx xx',
maxLength: 8
},
'+351': {
pattern: /^\d{9}$/,
placeholder: '912 345 678',
format: 'xxx xxx xxx',
maxLength: 9
},
'+30': {
pattern: /^\d{10}$/,
placeholder: '210 123 4567',
format: 'xxx xxx xxxx',
maxLength: 10
}
};

countryCodeSelect.addEventListener('change', function () {
const countryCode = this.value;
const format = phoneFormats[countryCode];

if (format) {
phoneInput.placeholder = format.placeholder;
phoneInput.maxLength = format.maxLength;

// Auto-focus phone input when country is selected
if (countryCode !== '') {
phoneInput.focus();
}
}
});

// Phone number auto-formatting
phoneInput.addEventListener('input', function (e) {
const countryCode = countryCodeSelect.value;
const format = phoneFormats[countryCode];

if (format) {
let value = e.target.value.replace(/\D/g, '');
// Remove all non-digits

// Limit to max length
if (value.length > format.maxLength) {
value = value.slice(0, format.maxLength);
}

e.target.value = value;
}
});

// Clear validation states when form is reset
document.getElementById('register').addEventListener('reset', function () {
usernameInput.classList.remove('is-valid', 'is-invalid');
emailInput.classList.remove('is-valid', 'is-invalid');
usernameFeedback.innerHTML = '';
emailFeedback.innerHTML = '';

// Reset phone fields
countryCodeSelect.value = '';
phoneInput.placeholder = '555 123 4567';
});
});

// Multilingual browser validation message override
document.addEventListener('DOMContentLoaded', function () {
const form = document.getElementById('register');
if (form) {
const inputs = form.querySelectorAll('input[required]');

inputs.forEach(input => {
input.addEventListener('invalid', function (e) {
e.preventDefault();
e.stopPropagation();

let message = '';

// Use language variables from LANG object
if (input.id === 'name') {
message = LANG.validation_required_name || 'Please enter your name';
} else if (input.id === 'last_name') {
message = LANG.validation_required_surname || 'Please enter your surname';
} else if (input.id === 'username') {
if (input.validity.valueMissing) {
message = LANG.validation_required_username || 'Please enter a username';
} else if (input.validity.tooShort) {
message = LANG.validation_username_short || LANG.username_kisa || 'Username must be at least 2 characters';
} else if (input.validity.tooLong) {
message = LANG.validation_username_long || 'Username must not exceed 20 characters';
}
} else if (input.id === 'email') {
if (input.validity.valueMissing) {
message = LANG.validation_required_email || 'Please enter your email address';
} else if (input.validity.typeMismatch) {
message = LANG.validation_invalid_email || 'Please enter a valid email address';
}
} else if (input.id === 'password') {
if (input.validity.valueMissing) {
message = LANG.validation_required_password || 'Please enter a password';
} else if (input.validity.tooShort) {
message = LANG.validation_password_short || 'Password must be at least 6 characters';
} else if (input.validity.tooLong) {
message = LANG.validation_password_long || 'Password must not exceed 20 characters';
}
} else if (input.id === 'password2') {
message = LANG.validation_confirm_password || 'Please confirm your password';
} else if (input.id === 'phone') {
message = LANG.validation_required_phone || 'Please enter your phone number';
} else if (input.id === 'captcha') {
message = LANG.validation_required_captcha || 'Please enter the security code';
}

// Fallback generic message if specific one not found
if (! message) {
message = LANG.validation_required || 'This field is required';
}

// Show custom validation message
input.setCustomValidity(message);
input.classList.add('is-invalid');

// Update the invalid-feedback div
const feedbackDiv = input.parentNode.querySelector('.invalid-feedback');
if (feedbackDiv) {
feedbackDiv.textContent = message;
}
});

// Clear custom validity when user starts typing
input.addEventListener('input', function () {
input.setCustomValidity('');
input.classList.remove('is-invalid');
});
});
}
});

// Custom form validation on submit
document.addEventListener('DOMContentLoaded', function () {
const form = document.getElementById('register');
if (form) {
form.addEventListener('submit', function (e) {
e.preventDefault();
e.stopPropagation();

let isValid = true;
const inputs = form.querySelectorAll('input[required]');

// Clear all previous validation states
inputs.forEach(input => {
input.classList.remove('is-invalid');
const feedbackDiv = input.parentNode.querySelector('.invalid-feedback');
if (feedbackDiv) {
feedbackDiv.textContent = '';
}
});

// Validate each required field
inputs.forEach(input => {
let message = '';
let isFieldValid = true;

if (input.id === 'name') {
if (!input.value.trim()) {
message = LANG.validation_required_name || 'Please enter your name';
isFieldValid = false;
} else if (input.value.trim().length < 2) {
message = 'Name must be at least 2 characters';
isFieldValid = false;
}
} else if (input.id === 'last_name') {
if (!input.value.trim()) {
message = LANG.validation_required_surname || 'Please enter your surname';
isFieldValid = false;
} else if (input.value.trim().length < 2) {
message = 'Surname must be at least 2 characters';
isFieldValid = false;
}
} else if (input.id === 'username') {
if (!input.value.trim()) {
message = LANG.validation_required_username || 'Please enter a username';
isFieldValid = false;
} else if (input.value.trim().length < 2) {
message = LANG.validation_username_short || 'Username must be at least 2 characters';
isFieldValid = false;
} else if (input.value.trim().length > 20) {
message = LANG.validation_username_long || 'Username must not exceed 20 characters';
isFieldValid = false;
}
} else if (input.id === 'email') {
if (!input.value.trim()) {
message = LANG.validation_required_email || 'Please enter your email address';
isFieldValid = false;
} else if (!input.value.trim().match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
message = LANG.validation_invalid_email || 'Please enter a valid email address';
isFieldValid = false;
}
} else if (input.id === 'password') {
if (!input.value.trim()) {
message = LANG.validation_required_password || 'Please enter a password';
isFieldValid = false;
} else if (input.value.trim().length < 6) {
message = LANG.validation_password_short || 'Password must be at least 6 characters';
isFieldValid = false;
} else if (input.value.trim().length > 20) {
message = LANG.validation_password_long || 'Password must not exceed 20 characters';
isFieldValid = false;
}
} else if (input.id === 'password2') {
const passwordField = document.getElementById('password');
if (!input.value.trim()) {
message = LANG.validation_confirm_password || 'Please confirm your password';
isFieldValid = false;
} else if (input.value.trim() !== passwordField.value.trim()) {
message = LANG.error_6 || 'Passwords do not match';
isFieldValid = false;
}
} else if (input.id === 'phone') {
if (!input.value.trim()) {
message = LANG.validation_required_phone || 'Please enter your phone number';
isFieldValid = false;
}
} else if (input.id === 'captcha') {
if (!input.value.trim()) {
message = LANG.validation_required_captcha || 'Please enter the security code';
isFieldValid = false;
}
}

// If no specific message, use generic required message
if (! message && !input.value.trim()) {
message = LANG.validation_required || 'This field is required';
isFieldValid = false;
}

// Show validation error if field is invalid
if (! isFieldValid) {
input.classList.add('is-invalid');
const feedbackDiv = input.parentNode.querySelector('.invalid-feedback');
if (feedbackDiv) {
feedbackDiv.textContent = message;
}
isValid = false;
}
});

// If form is valid, submit it
if (isValid) { // Remove novalidate temporarily to allow normal form submission
form.removeAttribute('novalidate');
form.submit();
} else { // Scroll to first error
const firstInvalid = form.querySelector('.is-invalid');
if (firstInvalid) {
firstInvalid.focus();
firstInvalid.scrollIntoView({behavior: 'smooth', block: 'center'});
}
}
});
}
});
	</script>
{% endblock %}

{% block content %}


	{% set oke = ctx_get('oke') %}
	{% set error = ctx_get('error') %}
	{% set mesaj = ctx_get('mesaj') %}
	{% set errors = ctx_get('errors') %}
	{% set name = ctx_get('name') %}
	{% set last_name = ctx_get('last_name') %}
	{% set kullanici_adi = ctx_get('kullanici_adi') %}
	{% set email = ctx_get('email') %}
	{% set sifre = ctx_get('sifre') %}
	{% set sifre2 = ctx_get('sifre2') %}
	{% set telefon = ctx_get('telefon') %}
	{% set tc = ctx_get('tc') %}
	<!-- START: mod_user/kayit.twig -->
	<div class="row justify-content-center">
		<div class="col-md-8 col-lg-6">
			<div class="card mt-4">
				<div class="card-header">
					<h5 class="card-title mb-0">{{ lang.mod_user.register.form_title }}</h5>
				</div>
				<div class="card-body">
					{% if success_message %}
						<div class="alert alert-success" role="alert">
							✅
							{{ success_message }}
						</div>
					{% elseif error_message %}
						<div class="alert alert-danger" role="alert">
							❌
							{{ error_message }}
						</div>
					{% else %}

						{% if errors %}
							<div class="alert alert-danger" role="alert">
								<strong>{{ lang.mod_user.register.js.errors_basligi }}</strong>
								<ul class="mb-0">
									{% for error in errors %}
										<li>{{ error }}</li>
									{% endfor %}
								</ul>
							</div>
						{% endif %}

						<form method="post" action="{{ site.sadres }}register" id="register" novalidate>
							<div class="row">
								<div class="col-md-6 mb-3">
									<label class="form-label" for="name">{{ lang.mod_user.register.your_name }}</label>
									<input type="text" class="form-control" id="name" name="name" value="{{ name }}" required minlength="2" maxlength="20" placeholder="{{ lang.mod_user.register.your_name }}">
									<div class="invalid-feedback">
										Please enter a valid name (2-20 characters).
									</div>
								</div>

								<div class="col-md-6 mb-3">
									<label class="form-label" for="last_name">{{ lang.mod_user.register.your_surname }}</label>
									<input type="text" class="form-control" id="last_name" name="last_name" value="{{ last_name }}" required minlength="2" maxlength="20" placeholder="{{ lang.mod_user.register.your_surname }}">
									<div class="invalid-feedback">
										Please enter a valid surname (2-20 characters).
									</div>
								</div>
							</div>

							<div class="mb-3">
								<label class="form-label" for="username">{{ lang.mod_user.register.your_username }}</label>
								<input type="text" class="form-control" id="username" name="username" value="{{ kullanici_adi }}" required minlength="2" maxlength="20" placeholder="{{ lang.mod_user.register.your_username }}">
								<div class="invalid-feedback">
									Please enter a valid username (2-20 characters).
								</div>
							</div>

							<div class="mb-3">
								<label class="form-label" for="email">{{ lang.mod_user.register.email }}</label>
								<input type="email" class="form-control" id="email" name="email" value="{{ email }}" required minlength="7" maxlength="50" placeholder="{{ lang.mod_user.register.email }}">
								<div class="invalid-feedback">
									Please enter a valid email address.
								</div>
							</div>

							<div class="row">
								<div class="col-md-6 mb-3">
									<label class="form-label" for="password">{{ lang.mod_user.register.your_password }}</label>
									<input type="password" class="form-control" id="password" name="password" value="{{ sifre }}" required minlength="6" maxlength="20" placeholder="{{ lang.mod_user.register.your_password }}">
									<div class="invalid-feedback">
										{{ lang.mod_user.error_fatal.5 }}
									</div>
								</div>

								<div class="col-md-6 mb-3">
									<label class="form-label" for="password2">{{ lang.mod_user.register.confirm_password }}</label>
									<input type="password" class="form-control" id="password2" name="password2" value="{{ sifre2 }}" required minlength="6" maxlength="20" placeholder="{{ lang.mod_user.register.confirm_password }}">
									<div class="invalid-feedback">
										{{ lang.mod_user.error_fatal.6 }}
									</div>
								</div>
							</div>

							<div class="mb-3">
								<label class="form-label" for="phone">{{ lang.mod_user.register.your_phone }}</label>
								<div class="input-group">
									<select class="form-select" id="country_code" name="country_code" style="max-width: 120px;">
										<option value="">{{ lang.mod_user.register.country_codes.select }}</option>
										{% for code in country_codes %}
											<option value="{{ code.code }}" {% if country_code == code.code %} selected {% endif %}>{{ code.country }}
												({{ code.code }})</option>
										{% endfor %}
									</select>
									<input type="tel" class="form-control" id="phone" name="phone" value="{{ phone }}" required maxlength="15" placeholder="555 123 4567">
									<div class="invalid-feedback">
										{{ lang.mod_user.error_fatal.3 }}
									</div>
								</div>
								<small class="text-muted">{{ lang.mod_user.register.country_codes.phone }}
									number with country code.</small>
							</div>

							<div class="mb-4">
								<label class="form-label" for="captcha">{{ lang.mod_user.register.security_code }}</label>
								<div class="input-group">
									<input type="text" class="form-control" id="captcha" name="captcha" value="" required minlength="5" maxlength="5" placeholder="{{ lang.mod_user.register.security_code|lower }}" style="max-width: 150px;">
									<img src="{{ site.sadres }}mod_user/captcha" alt="{{ lang.mod_user.register.security_code }}" style="height: 38px; cursor: pointer;" onclick="this.src='{{ site.sadres }}mod_user/captcha?'+Math.random()">
								</div>
								<small class="text-muted">{{ lang.mod_user.register.captcha_refresh }}</small>
							</div>

							<div class="d-grid">
								<input type="hidden" name="register" value="1">
								<input type="submit" value="{{ lang.mod_user.register.register_button }}" class="btn btn-primary btn-lg" style="z-index: 9999; position: relative;">
							</div>
						</form>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
	<!-- END: mod_user/kayit.twig -->
{% endblock %}
