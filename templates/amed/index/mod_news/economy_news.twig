{{ run({"mod": "index", "method": "_economy_news", "extra": [3]}) }}
{% set economy_news = ctx_get('economy_news') %}
{% set economy_url = ctx_get('economy_category_url')|default(site.saddress ~ 'newses') %}
{% set economy_category_name = ctx_get('economy_category_name') %}
{% set economy_lang = lang.index.mod_news.economy_news %}

{% if economy_news is not empty %}
<section class="economy-news-section" aria-labelledby="economy-news-heading">
    <header class="economy-news-header">
        <div class="economy-news-header-brand">
            <span class="economy-brand-indicator" aria-hidden="true">
                <i class="bi bi-graph-up-arrow"></i>
            </span>
            <h2 id="economy-news-heading" class="economy-news-title">
                <a href="{{ economy_url }}" class="economy-news-title-link">
                    {{ economy_lang.title }}
                </a>
            </h2>
            <span class="economy-news-kicker" aria-hidden="true">{{ economy_lang.kicker }}</span>
        </div>
        <a href="{{ economy_url }}" class="economy-news-more-link" title="{{ economy_lang.all_items }}" aria-label="{{ economy_lang.title }} - {{ economy_lang.all_items }}">
            <span class="economy-more-label">{{ economy_lang.all_items }}</span>
            <i class="bi bi-arrow-right economy-more-icon" aria-hidden="true"></i>
        </a>
    </header>

    <div class="economy-news-body">
        {% for item in economy_news %}
            {% set item_url = site.saddress ~ 'news/' ~ item.seo %}
            {% if loop.first %}
                <article class="economy-card-lead">
                    <div class="economy-lead-media-wrapper">
                        <a href="{{ item_url }}" class="economy-lead-media-link" title="{{ item.name }}">
                            {% if item.image is not empty %}
                                <img src="{{ site.address }}r/w-380/h-214/c-1/f/mod_news/thumb/{{ item.image }}"
                                     srcset="{{ site.address }}r/w-380/h-214/c-1/f/mod_news/thumb/{{ item.image }} 380w, {{ site.address }}r/w-480/h-270/c-1/f/mod_news/thumb/{{ item.image }} 480w"
                                     sizes="(max-width: 767px) 360px, 380px"
                                     class="economy-lead-img"
                                     alt="{{ item.name }}"
                                     width="380"
                                     height="214"
                                     loading="lazy"
                                     fetchpriority="low"
                                     decoding="async">
                            {% else %}
                                <div class="economy-lead-placeholder">
                                    <i class="bi bi-cash-stack economy-placeholder-icon" aria-hidden="true"></i>
                                </div>
                            {% endif %}
                            <span class="economy-lead-badge">{{ economy_lang.featured }}</span>
                        </a>
                    </div>
                    <div class="economy-lead-content">
                        <div class="economy-lead-meta">
                            {% if item.is_last_24h %}
                                <span class="economy-meta-item">
                                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                                    <time datetime="{{ item.created_at|default('') }}">{{ item.published_ago }}</time>
                                </span>
                                <span class="economy-meta-sep" aria-hidden="true">·</span>
                            {% elseif item.formatted_datetime is defined and item.formatted_datetime is not empty %}
                                <span class="economy-meta-item">
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    <time datetime="{{ item.created_at }}">{{ item.formatted_datetime }}</time>
                                </span>
                                <span class="economy-meta-sep" aria-hidden="true">·</span>
                            {% elseif item.created_at is defined and item.created_at is not empty %}
                                <span class="economy-meta-item">
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    <time datetime="{{ item.created_at }}">{{ item.created_at|date('d.m.Y') }}</time>
                                </span>
                                <span class="economy-meta-sep" aria-hidden="true">·</span>
                            {% endif %}

                            {% set clean_summary = (item.summary != '' ? item.summary : item.name)|striptags %}
                            {% set words = clean_summary|split(' ')|length %}
                            {% set reading_minutes = (words / 180)|round(0, 'ceil') %}
                            {% if reading_minutes < 1 %}{% set reading_minutes = 1 %}{% endif %}
                            <span class="economy-meta-item">
                                <i class="bi bi-book" aria-hidden="true"></i>
                                <span>{{ reading_minutes }} {{ lang.index.minute }}</span>
                            </span>
                        </div>
                        <h3 class="economy-lead-title">
                            <a href="{{ item_url }}" class="economy-lead-title-link">{{ item.name|raw }}</a>
                        </h3>
                        {% if item.summary_short is defined and item.summary_short is not empty %}
                            <p class="economy-lead-summary">
                                <a href="{{ item_url }}" class="economy-lead-summary-link">{{ item.summary_short }}</a>
                            </p>
                        {% endif %}
                    </div>
                </article>
            {% else %}
                {% if loop.index == 2 %}
                    <div class="economy-sub-list">
                {% endif %}
                <article class="economy-card-sub">
                    <a href="{{ item_url }}" class="economy-sub-thumb" title="{{ item.name }}">
                        {% if item.image is not empty %}
                            <img src="{{ site.address }}r/w-108/h-61/c-1/f/mod_news/thumb/{{ item.image }}"
                                 srcset="{{ site.address }}r/w-108/h-61/c-1/f/mod_news/thumb/{{ item.image }} 1x, {{ site.address }}r/w-216/h-122/c-1/f/mod_news/thumb/{{ item.image }} 2x"
                                 class="economy-sub-img"
                                 alt="{{ item.name }}"
                                 width="108"
                                 height="61"
                                 loading="lazy"
                                 fetchpriority="low"
                                 decoding="async">
                        {% else %}
                            <div class="economy-sub-placeholder">
                                <i class="bi bi-bar-chart-line economy-placeholder-icon" aria-hidden="true"></i>
                            </div>
                        {% endif %}
                    </a>
                    <div class="economy-sub-content">
                        <div class="economy-sub-meta">
                            <span class="economy-sub-index" aria-hidden="true">0{{ loop.index }}</span>
                            <span class="economy-meta-sep" aria-hidden="true">·</span>
                            {% if item.is_last_24h %}
                                <span class="economy-sub-time">
                                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                                    <time datetime="{{ item.created_at|default('') }}">{{ item.published_ago }}</time>
                                </span>
                            {% elseif item.formatted_datetime is defined and item.formatted_datetime is not empty %}
                                <span class="economy-sub-time">
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    <time datetime="{{ item.created_at }}">{{ item.formatted_datetime }}</time>
                                </span>
                            {% elseif item.created_at is defined and item.created_at is not empty %}
                                <span class="economy-sub-time">
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    <time datetime="{{ item.created_at }}">{{ item.created_at|date('d.m.Y') }}</time>
                                </span>
                            {% endif %}
                        </div>
                        <h3 class="economy-sub-title">
                            <a href="{{ item_url }}" class="economy-sub-title-link">{{ item.name|raw }}</a>
                        </h3>
                    </div>
                </article>
                {% if loop.last %}
                    </div>
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
</section>
{% endif %}
