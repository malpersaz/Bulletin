{# US Elections Live Tracker Widget (Amida Theme) #}
{% if us_elections is not defined or us_elections.senate is not defined %}
    {{ run({"mod": "index", "method": "_us_elections"}) }}
    {% set us_elections = ctx_get('us_elections') %}
{% endif %}

{% set us_data = us_elections|default({
    'title': 'ABD ARA SEÇİMLERİ',
    'senate': {
        'title': 'Senato',
        'democrats': 35,
        'republicans': 31,
        'target': '50',
        'target_label': '',
        'total': 100,
        'counted_label': '1/35 sandalye sayıldı',
        'not_up_label': 'Seçime dahil değil'
    },
    'house': {
        'title': 'Temsilciler Meclisi',
        'democrats': 6,
        'republicans': 2,
        'target': '218',
        'target_label': 'kazanmak için',
        'total': 435,
        'counted_label': '8/435 sandalye sayıldı'
    },
    'live_label': 'CANLI güncellemeler',
    'live_url': site.saddress ~ 'us-elections',
    'info_label': 'Bu seçim nasıl çalışır?',
    'info_text': 'Amerikalılar, Temsilciler Meclisi ve Senato\'dan oluşan Kongre üyelerini seçiyor. Temsilciler Meclisi\'ndeki 435 sandalyenin tamamı için seçim yapılırken; senatörlerin altı yıllık dönemlerle görev yapması nedeniyle 100 sandalyeli Senato\'da yalnızca 35 sandalye için yarışılıyor. Bu canlı takip ekranı hem şu anda oylanan yarışları hem de bu yıl seçime dahil olmayan 65 sandalyeyi (34 Demokrat, 31 Cumhuriyetçi) göstermektedir.'
}) %}

{% set sen_dem_w = us_data.senate.democrats|default(35) %}
{% set sen_rep_w = us_data.senate.republicans|default(31) %}
{% set sen_rep_x = 100 - sen_rep_w %}
{% set sen_tip_x = (sen_dem_w > 2) ? (sen_dem_w - 2) : 0 %}

{% set hse_dem_val = us_data.house.democrats|default(6) %}
{% set hse_rep_val = us_data.house.republicans|default(2) %}
{% set hse_dem_w = (hse_dem_val > 5) ? hse_dem_val : 5 %}
{% set hse_rep_w = (hse_rep_val > 5) ? hse_rep_val : 5 %}
{% set hse_rep_x = 435 - hse_rep_w %}

<section class="us-elections-widget" aria-label="{{ us_data.title }}">
    <!-- 1. Header with Isometric Logo -->
    <header class="us-elections-header">
        <div class="us-elections-title-wrap">
            <h2 class="us-elections-title">{{ us_data.title }}</h2>
            <svg class="us-elections-badge-icon" width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <!-- Cyan/Blue Isometric Cube -->
                <path d="M9 4L15 7.5L9 11L3 7.5L9 4Z" fill="#38bdf8"/>
                <path d="M3 7.5L9 11V18L3 14.5V7.5Z" fill="#0284c7"/>
                <path d="M15 7.5L9 11V18L15 14.5V7.5Z" fill="#0369a1"/>
                <!-- Red Isometric Cube -->
                <path d="M19 10L25 13.5L19 17L13 13.5L19 10Z" fill="#f87171"/>
                <path d="M13 13.5L19 17V24L13 20.5V13.5Z" fill="#dc2626"/>
                <path d="M25 13.5L19 17V24L25 20.5V13.5Z" fill="#b91c1c"/>
            </svg>
        </div>
    </header>

    <!-- 2. Dual Chamber Panels (Senate + House) -->
    <div class="us-elections-chambers">
        <!-- Chamber 1: Senate -->
        <article class="us-elections-chamber">
            <h3 class="us-elections-chamber-title">{{ us_data.senate.title }}</h3>
            
            <div class="us-elections-scores">
                <span class="us-elections-count us-elections-count-dem" dir="ltr">{{ us_data.senate.democrats }}</span>
                <div class="us-elections-target">
                    <span class="us-elections-target-num" dir="ltr">{{ us_data.senate.target }}</span>
                    {% if us_data.senate.target_label is not empty %}
                        <span class="us-elections-target-label">{{ us_data.senate.target_label }}</span>
                    {% endif %}
                    <span class="us-elections-target-notch" aria-hidden="true"></span>
                </div>
                <span class="us-elections-count us-elections-count-rep" dir="ltr">{{ us_data.senate.republicans }}</span>
            </div>

            <!-- Dynamic SVG Progress Bar (Senate: 100 Seats) -->
            <svg class="us-elections-track-svg" viewBox="0 0 100 8" preserveAspectRatio="none" role="progressbar" aria-label="{{ us_data.senate.title }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ us_data.senate.democrats }}">
                <rect class="us-elections-svg-bg" x="0" y="0" width="100" height="8" rx="4"></rect>
                <rect class="us-elections-svg-dem" x="0" y="0" width="{{ sen_dem_w }}" height="8" rx="4"></rect>
                <rect class="us-elections-svg-tip" x="{{ sen_tip_x }}" y="0" width="2" height="8"></rect>
                <rect class="us-elections-svg-rep" x="{{ sen_rep_x }}" y="0" width="{{ sen_rep_w }}" height="8" rx="4"></rect>
                <line class="us-elections-svg-needle" x1="50" y1="0" x2="50" y2="8"></line>
            </svg>

            <div class="us-elections-parties">
                <span class="us-elections-party-dem">Demokratlar</span>
                <span class="us-elections-party-rep">Cumhuriyetçiler</span>
            </div>

            <div class="us-elections-meta">
                <span class="us-elections-legend">
                    <span class="us-elections-legend-box" aria-hidden="true"></span>
                    <span>{{ us_data.senate.not_up_label }}</span>
                </span>
                <span class="us-elections-status">
                    <i class="bi bi-clock-history us-elections-status-icon" aria-hidden="true"></i>
                    <span>{{ us_data.senate.counted_label }}</span>
                </span>
            </div>
        </article>

        <!-- Chamber 2: House of Representatives -->
        <article class="us-elections-chamber">
            <h3 class="us-elections-chamber-title">{{ us_data.house.title }}</h3>

            <div class="us-elections-scores">
                <span class="us-elections-count us-elections-count-dem" dir="ltr">{{ us_data.house.democrats }}</span>
                <div class="us-elections-target">
                    <span class="us-elections-target-num" dir="ltr">{{ us_data.house.target }}</span>
                    {% if us_data.house.target_label is not empty %}
                        <span class="us-elections-target-label">{{ us_data.house.target_label }}</span>
                    {% endif %}
                    <span class="us-elections-target-notch" aria-hidden="true"></span>
                </div>
                <span class="us-elections-count us-elections-count-rep" dir="ltr">{{ us_data.house.republicans }}</span>
            </div>

            <!-- Dynamic SVG Progress Bar (House: 435 Seats) -->
            <svg class="us-elections-track-svg" viewBox="0 0 435 8" preserveAspectRatio="none" role="progressbar" aria-label="{{ us_data.house.title }}" aria-valuemin="0" aria-valuemax="435" aria-valuenow="{{ us_data.house.democrats }}">
                <rect class="us-elections-svg-bg" x="0" y="0" width="435" height="8" rx="4"></rect>
                <rect class="us-elections-svg-dem" x="0" y="0" width="{{ hse_dem_w }}" height="8" rx="4"></rect>
                <rect class="us-elections-svg-rep" x="{{ hse_rep_x }}" y="0" width="{{ hse_rep_w }}" height="8" rx="4"></rect>
                <line class="us-elections-svg-needle" x1="217.5" y1="0" x2="217.5" y2="8"></line>
            </svg>

            <div class="us-elections-parties">
                <span class="us-elections-party-dem">Demokratlar</span>
                <span class="us-elections-party-rep">Cumhuriyetçiler</span>
            </div>

            <div class="us-elections-meta">
                <span class="us-elections-status">
                    <i class="bi bi-clock-history us-elections-status-icon" aria-hidden="true"></i>
                    <span>{{ us_data.house.counted_label }}</span>
                </span>
            </div>
        </article>
    </div>

    <!-- 3. Bottom Footer with Live Updates & Expandable Info -->
    <footer class="us-elections-footer">
        <a href="{{ site.saddress }}us-elections" class="us-elections-live-btn" aria-label="{{ us_data.live_label }}">
            <span class="us-elections-live-ring" aria-hidden="true">
                <span class="us-elections-live-dot"></span>
                <span class="us-elections-live-ripple"></span>
            </span>
            <span>{{ us_data.live_label }}</span>
            <i class="bi bi-chevron-right us-elections-live-chevron" aria-hidden="true"></i>
        </a>

        <details class="us-elections-info-details">
            <summary class="us-elections-info-summary">
                <span>{{ us_data.info_label }}</span>
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </summary>
            <div class="us-elections-info-box">
                <p class="us-elections-info-text">{{ us_data.info_text }}</p>
            </div>
        </details>
    </footer>
</section>
