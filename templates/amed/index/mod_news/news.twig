{% extends "layouts/base.twig" %}
{% import "macros/faq.twig" as faq %}

{% block css_custom %}
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/detail-foundation.css?v={{ site.version }}">
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/news.css?v={{ site.version }}-20261113e">
	<link rel="stylesheet" href="{{ site.taddress }}base_static/css/lightbox-engine.css?v={{ site.version }}">
	{% if ctx_get('gallery') is not empty %}
		<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/gallery.css?v={{ site.version }}-20261113g">
	{% endif %}
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/video-embed.css?v={{ site.version }}-20261113v3">
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/social-post.css?v={{ site.version }}">
{% endblock %}

{% block detail_plugins %}
	<script src="{{ site.taddress }}base_static/js/lightbox-engine.js?v={{ site.version }}" defer></script>
	{% if ctx_get('gallery') is not empty %}
		<script src="{{ site.taddress }}{{ site.app_template }}/static/js/news-gallery.js?v={{ site.version }}-20261113g" defer></script>
	{% endif %}
{% endblock %}

{% set d = ctx_get('detail') ?: ctx_get('d') %}
{% set categories = ctx_get('categories') %}
{% set gallery = ctx_get('gallery') %}
{% set subpages = ctx_get('subpages') ?: ctx_get('sub_pages') %}
{% set newses = ctx_get('newses') %}
{% set video = ctx_get('video') %}
{% set files = ctx_get('files') ?: ctx_get('file') %}
{% set faqs = ctx_get('faqs') ?: ctx_get('faq') %}
{% set faq_lang = ctx_get('faq_lang') %}
{% set news_24h = ctx_get('news_24h') %}
{% set news_24h_count = ctx_get('news_24h_count') ?? (news_24h ? news_24h|length : 0) %}
{% set news_24h_is_backfill = ctx_get('news_24h_is_backfill') %}
{% set has_news_category = d.categoryname is defined and d.categoryname|trim is not empty and d.category_seo is defined and d.category_seo|trim is not empty %}
{% set news_all_label = lang.index.mod_news.all_news %}
{% set author_full_name = (d.u_name is defined and d.u_name is not empty) ? (d.u_name ~ ' ' ~ (d.u_last_name ?? ''))|trim : site.title %}
{% set author_initials = (d.u_name is defined and d.u_name is not empty) ? ((d.u_name|default('')|slice(0, 1) ~ d.u_last_name|default('')|slice(0, 1))|upper) : (site.title|default('R')|slice(0, 2)|upper) %}

{% set canonical_news_url = site.saddress ~ 'news/' ~ d.seo %}
{% set news_meta_desc = (d.description ?: (d.summary ?: site.description))|striptags|trim|slice(0, 200) %}
{% set news_logo_asset = site.logo_path is defined and site.logo_path is not empty ? site.iaddress ~ 'mod_settings/' ~ site.logo_path : (site.iaddress ~ 'mod_settings/logo.png') %}
{% set fallback_news_image = d.image is not empty ? (site.iaddress ~ 'mod_news/' ~ d.image) : news_logo_asset %}
{% set fallback_news_ext = fallback_news_image|split('?')|first|split('.')|last|lower %}
{% set fallback_news_mime = fallback_news_ext == 'png' ? 'image/png' : (fallback_news_ext == 'webp' ? 'image/webp' : (fallback_news_ext == 'gif' ? 'image/gif' : 'image/jpeg')) %}
{% set news_share_image = d.og_image_url is defined and d.og_image_url is not empty ? d.og_image_url : fallback_news_image %}
{% set news_share_mime = d.og_image_mime is defined and d.og_image_mime is not empty ? d.og_image_mime : fallback_news_mime %}
{% set news_share_width = d.og_image_width is defined and d.og_image_width ? d.og_image_width : (d.image is not empty ? 1280 : 300) %}
{% set news_share_height = d.og_image_height is defined and d.og_image_height ? d.og_image_height : (d.image is not empty ? 720 : 300) %}

{% block canonical %}
	<link rel="canonical" href="{{ canonical_news_url }}"/>
{% endblock %}
{% block hreflang %}
	<link rel="alternate" hreflang="{{ site.lang }}" href="{{ canonical_news_url }}"/>
	<link rel="alternate" hreflang="x-default" href="{{ canonical_news_url }}"/>
{% endblock %}

{% block title %}
	<title>{{ d.title|default(d.name) }} - {{ site.title }}</title>
{% endblock %}

{% block description %}
	<meta name="description" content="{{ news_meta_desc }}">
{% endblock %}

{% block keywords %}
	<meta name="keywords" content="{{ d.keywords }}">
{% endblock %}

{% block meta_tags %}
	{% set article_created_ts = d.created_at ? d.created_at|date('U') : "now"|date('U') %}
	{% set article_updated_ts = d.updated_at ? d.updated_at|date('U') : article_created_ts %}
	{% if article_updated_ts < article_created_ts %}{% set article_updated_ts = article_created_ts %}{% endif %}
	<!-- Standard Robots & Search Directives -->
	<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

	<!-- Open Graph / Facebook -->
	<meta property="og:type" content="article">
	<meta property="og:url" content="{{ canonical_news_url }}">
	<meta property="og:title" content="{{ d.title|default(d.name) }}">
	<meta property="og:description" content="{{ news_meta_desc }}">
	{% if news_share_image is not empty %}
		<meta property="og:image" content="{{ news_share_image }}">
		{% if news_share_image starts with 'https://' %}
			<meta property="og:image:secure_url" content="{{ news_share_image }}">
		{% endif %}
		<meta property="og:image:type" content="{{ news_share_mime }}">
		<meta property="og:image:width" content="{{ news_share_width }}">
		<meta property="og:image:height" content="{{ news_share_height }}">
		<meta property="og:image:alt" content="{{ (d.image_alt|default(d.name))|escape('html_attr') }}">
		<link rel="image_src" href="{{ news_share_image }}">
	{% endif %}
	<meta property="og:site_name" content="{{ site.title }}">
    {% set og_locale = site.lang %}
    {% if site.lang == 'en' %}{% set og_locale = 'en_US' %}
    {% elseif site.lang == 'tr' %}{% set og_locale = 'tr_TR' %}
    {% elseif site.lang == 'de' %}{% set og_locale = 'de_DE' %}
    {% elseif site.lang == 'ku' %}{% set og_locale = 'ku' %}
    {% elseif site.lang == 'ckb' %}{% set og_locale = 'ckb' %}
    {% elseif site.lang == 'zza' %}{% set og_locale = 'zza' %}
    {% endif %}
	<meta property="og:locale" content="{{ og_locale }}">
	<meta property="article:published_time" content="{{ article_created_ts|date('c') }}">
	<meta property="article:modified_time" content="{{ article_updated_ts|date('c') }}">
	{% if has_news_category %}
		<meta property="article:section" content="{{ d.categoryname }}">
	{% endif %}

	<!-- Twitter -->
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:url" content="{{ canonical_news_url }}">
	<meta name="twitter:title" content="{{ d.title|default(d.name) }}">
	<meta name="twitter:description" content="{{ news_meta_desc }}">
	{% if news_share_image is not empty %}
		<meta name="twitter:image" content="{{ news_share_image }}">
		<meta name="twitter:image:alt" content="{{ (d.image_alt|default(d.name))|escape('html_attr') }}">
	{% endif %}
{% endblock %}

{% block schema %}
	{% set article_img_url = d.image is not empty ? (site.iaddress ~ 'mod_news/' ~ d.image) : news_logo_asset %}
	{% set article_created_ts = d.created_at ? d.created_at|date('U') : "now"|date('U') %}
	{% set article_updated_ts = d.updated_at ? d.updated_at|date('U') : article_created_ts %}
	{% if article_updated_ts < article_created_ts %}{% set article_updated_ts = article_created_ts %}{% endif %}
	{% set pub_same_as = [] %}
	{% if site.social_links is defined and site.social_links is not empty %}
		{% for sl in site.social_links %}
			{% if sl.url|trim is not empty and sl.url starts with 'http' %}
				{% set pub_same_as = pub_same_as|merge([sl.url|trim]) %}
			{% endif %}
		{% endfor %}
	{% endif %}
	{% set img_creator_name = d.image_schema_creator_name|default(site.title) %}
	{% set img_copyright_notice = d.image_schema_copyright_notice|default('© ' ~ article_created_ts|date('Y') ~ ' ' ~ (site.owner_name|default(site.title))) %}
	{% set img_license_url = d.image_schema_license_url|default(site.saddress ~ (site.lang == 'tr' ? 'page/Kullanım_Koşulları' : 'legal')) %}
	{% set img_acquire_url = d.image_schema_acquire_license_url|default(site.saddress ~ 'legal') %}
	{% if d.image is not empty %}
		{% set img_url_16x9 = d.image_16x9|default(site.iaddress ~ 'mod_news/' ~ d.image) %}
		{% set img_url_4x3 = d.image_4x3|default(site.iaddress ~ 'mod_news/4x3/' ~ d.image) %}
		{% set img_url_1x1 = d.image_1x1|default(site.iaddress ~ 'mod_news/1x1/' ~ d.image) %}
	{% endif %}
	<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "NewsArticle",
		  "@id": {{ (canonical_news_url ~ '#article')|json_ld|raw }},
		  "isPartOf": {
		    "@type": "WebSite",
		    "@id": {{ (site.saddress ~ '#website')|json_ld|raw }},
		    "name": {{ site.title|json_ld|raw }},
		    "url": {{ site.saddress|json_ld|raw }}
		  },
		  "mainEntityOfPage": {
		    "@type": "WebPage",
		    "@id": {{ canonical_news_url|json_ld|raw }}
		  },
		  "url": {{ canonical_news_url|json_ld|raw }},
		  "headline": {{ d.name|json_ld|raw }},
		  {% if d.summary is defined and d.summary|striptags|trim is not empty %}"alternativeHeadline": {{ d.summary|striptags|trim|json_ld|raw }},{% endif %}
		  "speakable": {
		    "@type": "SpeakableSpecification",
		    "cssSelector": [
		      ".news-detail-title",
		      ".news-detail-lead",
		      ".news-body > p:first-of-type"
		    ]
		  },
		  "copyrightHolder": {
		    "@type": "NewsMediaOrganization",
		    "@id": {{ (site.saddress ~ '#organization')|json_ld|raw }}
		  },
		  "copyrightYear": {{ article_created_ts|date('Y') }},
		  "inLanguage": "{{ site.lang }}",
		  "isAccessibleForFree": true,
		  {% if has_news_category %}"articleSection": {{ d.categoryname|json_ld|raw }},{% endif %}
		  {% if d.word_count is defined and d.word_count > 0 %}"wordCount": {{ d.word_count }},{% endif %}
		  "articleBody": {{ d.content|striptags|trim|json_ld|raw }},
		  "image": [
		    {% if d.image is not empty %}
		    {
		      "@type": "ImageObject",
		      "url": {{ img_url_16x9|json_ld|raw }},
		      "contentUrl": {{ img_url_16x9|json_ld|raw }},
		      "width": 1280,
		      "height": 720,
		      "caption": {{ (d.image_alt|default(d.name))|json_ld|raw }},
		      {% if d.image_credit is defined and d.image_credit is not empty %}"creditText": {{ d.image_credit|json_ld|raw }},{% else %}"creditText": {{ (d.image_schema_credit_text|default(site.title))|json_ld|raw }},{% endif %}
		      "creator": {
		        "@type": "Organization",
		        "name": {{ img_creator_name|json_ld|raw }}
		      },
		      "copyrightNotice": {{ img_copyright_notice|json_ld|raw }},
		      "license": {{ img_license_url|json_ld|raw }},
		      "acquireLicensePage": {{ img_acquire_url|json_ld|raw }}
		    },
		    {
		      "@type": "ImageObject",
		      "url": {{ img_url_4x3|json_ld|raw }},
		      "contentUrl": {{ img_url_4x3|json_ld|raw }},
		      "width": 1200,
		      "height": 900,
		      "caption": {{ (d.image_alt|default(d.name))|json_ld|raw }},
		      {% if d.image_credit is defined and d.image_credit is not empty %}"creditText": {{ d.image_credit|json_ld|raw }},{% else %}"creditText": {{ (d.image_schema_credit_text|default(site.title))|json_ld|raw }},{% endif %}
		      "creator": {
		        "@type": "Organization",
		        "name": {{ img_creator_name|json_ld|raw }}
		      },
		      "copyrightNotice": {{ img_copyright_notice|json_ld|raw }},
		      "license": {{ img_license_url|json_ld|raw }},
		      "acquireLicensePage": {{ img_acquire_url|json_ld|raw }}
		    },
		    {
		      "@type": "ImageObject",
		      "url": {{ img_url_1x1|json_ld|raw }},
		      "contentUrl": {{ img_url_1x1|json_ld|raw }},
		      "width": 1200,
		      "height": 1200,
		      "caption": {{ (d.image_alt|default(d.name))|json_ld|raw }},
		      {% if d.image_credit is defined and d.image_credit is not empty %}"creditText": {{ d.image_credit|json_ld|raw }},{% else %}"creditText": {{ (d.image_schema_credit_text|default(site.title))|json_ld|raw }},{% endif %}
		      "creator": {
		        "@type": "Organization",
		        "name": {{ img_creator_name|json_ld|raw }}
		      },
		      "copyrightNotice": {{ img_copyright_notice|json_ld|raw }},
		      "license": {{ img_license_url|json_ld|raw }},
		      "acquireLicensePage": {{ img_acquire_url|json_ld|raw }}
		    }
		    {% else %}
		    {
		      "@type": "ImageObject",
		      "url": {{ news_logo_asset|json_ld|raw }},
		      "width": 300,
		      "height": 300
		    }
		    {% endif %}
		  ],
		  "author": {% if d.author_is_org %}
		  {
		    "@type": "NewsMediaOrganization",
		    "@id": {{ (site.saddress ~ '#organization')|json_ld|raw }},
		    "name": {{ site.title|json_ld|raw }},
		    {% if site.legal_company_name is defined and site.legal_company_name is not empty %}"legalName": {{ site.legal_company_name|json_ld|raw }},{% endif %}
		    "url": {{ site.saddress|json_ld|raw }}
		  }
		  {% else %}
		  {
		    "@type": "Person",
		    "name": {{ author_full_name|json_ld|raw }}
		    {% if d.author_job_title is defined and d.author_job_title is not empty %}, "jobTitle": {{ d.author_job_title|json_ld|raw }}{% endif %}
		    {% if d.author_avatar_url is defined and d.author_avatar_url is not empty %}, "image": {{ d.author_avatar_url|json_ld|raw }}{% endif %}
		    {% if d.username is defined and d.username is not empty %}, "url": {{ (site.saddress ~ 'author/' ~ d.username)|json_ld|raw }}{% endif %}
		    {% if d.author_same_as is defined and d.author_same_as is not empty %}, "sameAs": {{ d.author_same_as|json_ld|raw }}{% endif %},
		    "worksFor": {
		      "@type": "NewsMediaOrganization",
		      "@id": {{ (site.saddress ~ '#organization')|json_ld|raw }},
		      "name": {{ site.title|json_ld|raw }},
		      "url": {{ site.saddress|json_ld|raw }}
		    }
		  }
		  {% endif %},
		  "publisher": {
		    "@type": "NewsMediaOrganization",
		    "@id": {{ (site.saddress ~ '#organization')|json_ld|raw }},
		    "name": {{ site.title|json_ld|raw }},
		    "alternateName": ["Amed Bulten", "amedbulten.com", "Amed Bülteni"],
		    {% if site.legal_company_name is defined and site.legal_company_name is not empty %}"legalName": {{ site.legal_company_name|json_ld|raw }},{% endif %}
		    "url": {{ site.saddress|json_ld|raw }},
		    "logo": {
		      "@type": "ImageObject",
		      "url": {{ news_logo_asset|json_ld|raw }},
		      "width": 300,
		      "height": 300
		    },
		    "masthead": {{ (site.saddress ~ 'legal')|json_ld|raw }},
		    "publishingPrinciples": {{ (site.saddress ~ 'page/Yayın_İlkeleri')|json_ld|raw }},
		    "correctionsPolicy": {{ (site.saddress ~ 'page/Düzeltme_ve_Tekzip_Politikası')|json_ld|raw }},
		    "ethicsPolicy": {{ (site.saddress ~ 'page/Basın_Etiği_ve_Uyum')|json_ld|raw }},
		    "factCheckingPolicy": {{ (site.saddress ~ 'page/Doğrulama_ve_Teyit_Politikası')|json_ld|raw }},
		    "ownershipFundingInfo": {{ (site.saddress ~ 'page/Mülkiyet_ve_Finansman_Yapısı')|json_ld|raw }},
		    "actionableFeedbackPolicy": {{ (site.saddress ~ 'page/Hakkımızda')|json_ld|raw }}{% if pub_same_as is not empty %},
		    "sameAs": {{ pub_same_as|json_ld|raw }}{% endif %}
		  },
		  "datePublished": "{{ article_created_ts|date('c') }}",
		  "dateModified": "{{ article_updated_ts|date('c') }}",
		  "description": {{ (d.summary ?: (d.description ?: site.description))|striptags|slice(0, 200)|json_ld|raw }}
		}
	</script>
    {% if video is not empty %}
        {% for v in video %}
        {% set v_thumb = v.hero_poster_url|default(v.poster_url|default(v.image is defined and v.image is not empty ? (site.iaddress ~ 'mod_video_embed/' ~ v.image) : (site.address ~ 'tools/videoResim/mod_news/' ~ d.id ~ '/' ~ v.id ~ '/show.jpg'))) %}
        <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "VideoObject",
              "name": {{ v.name|json_ld|raw }},
              "description": {{ (d.name ~ ' - ' ~ v.name)|json_ld|raw }},
              "thumbnailUrl": {{ v_thumb|json_ld|raw }},
              "uploadDate": "{{ d.created_at ? d.created_at|date('c') : "now"|date('c') }}"{% if v.embed_src is defined and v.embed_src is not empty %},
              "embedUrl": {{ v.embed_src|json_ld|raw }}{% else %},
              "contentUrl": {{ (site.saddress ~ 'tools/videoFlv/mod_news/' ~ d.id ~ '/' ~ v.id ~ '/show.mp4')|json_ld|raw }}{% endif %}{% if v.schema_duration is defined and v.schema_duration is not empty %},
              "duration": {{ v.schema_duration|json_ld|raw }}{% endif %}
            }
        </script>
        {% endfor %}
    {% endif %}
	<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "BreadcrumbList",
		  "itemListElement": [
		    {
		      "@type": "ListItem",
		      "position": 1,
		      "name": {{ lang.index.home|json_ld|raw }},
		      "item": {{ site.saddress|json_ld|raw }}
		    },
		    {
		      "@type": "ListItem",
		      "position": 2,
		      "name": {{ news_all_label|json_ld|raw }},
		      "item": {{ (site.saddress ~ 'newses')|json_ld|raw }}
		    }{% if has_news_category %},
		    {
		      "@type": "ListItem",
		      "position": 3,
		      "name": {{ d.categoryname|json_ld|raw }},
		      "item": {{ (site.saddress ~ 'newses/' ~ d.category_seo)|json_ld|raw }}
		    }{% endif %},
		    {
		      "@type": "ListItem",
		      "position": {{ has_news_category ? 4 : 3 }},
		      "name": {{ d.name|json_ld|raw }},
		      "item": {{ canonical_news_url|json_ld|raw }}
		    }
		  ]
		}
	</script>
	{{ faq.schema(faqs) }}
{% endblock %}

{% block content %}
	<div class="row g-4 {% if news_24h is empty %}justify-content-center{% endif %} detail-shell detail-shell-news" id="mod_news">

		<div class="col-lg-8">
			<article class="detail-card news-detail-card">
				<div class="detail-breadcrumb-wrap">
					<nav aria-label="breadcrumb">
						<ol class="breadcrumb mb-0">
							<li class="breadcrumb-item">
								<a href="{{ site.saddress }}">{{ lang.index.home }}</a>
							</li>
							<li class="breadcrumb-item">
								<a href="{{ site.saddress }}newses">{{ news_all_label }}</a>
							</li>
							{% if has_news_category %}
								<li class="breadcrumb-item">
									<a href="{{ site.saddress }}newses/{{ d.category_seo }}">{{ d.categoryname }}</a>
								</li>
							{% endif %}
							<li class="breadcrumb-item active" aria-current="page">
								<span>{{ d.name }}</span>
							</li>
						</ol>
					</nav>
				</div>
				<div class="detail-content position-relative">
					{% set readingTime = (d.content|striptags|length / 1000)|round(0, 'ceil') %}
					{% if readingTime < 1 %}{% set readingTime = 1 %}{% endif %}
					<div class="detail-story-intro">
						<div class="detail-story-meta">
							{% if has_news_category %}
								<a class="detail-story-kicker text-decoration-none" href="{{ site.saddress }}newses/{{ d.category_seo }}">{{ d.categoryname }}</a>
							{% endif %}
							<span class="detail-story-reading">
								<i class="bi bi-clock-history"></i>
								<span>{{ readingTime }} {{ lang.index.min_read }}</span>
							</span>
						</div>
						<h1 class="detail-title news-detail-title">{{ d.name }}</h1>
					</div>

					<div>
						{% if d.deck is defined and d.deck == 'y' and d.summary is not empty %}
							<div class="detail-lead news-detail-lead">
								<p class="mb-0">
									{{ d.summary }}
								</p>
							</div>
						{% endif %}

						{% set has_main_image = d.image is defined and d.image is not empty and d.image != '#' %}
						{% set hero_video = null %}
						{% set remaining_videos = video|default([]) %}
						{% if video is not empty %}
							{% set first_vid = video|first %}
							{% set first_vid_is_embed = first_vid.embed is defined and first_vid.embed is not empty %}
							{% set first_vid_is_x = (first_vid.is_x is defined and first_vid.is_x) or (first_vid.provider|default('') == 'x') %}
							{% set first_vid_is_non_16x9 = (first_vid.is_vertical is defined and first_vid.is_vertical) or (first_vid.aspect_ratio|default('16:9') != '16:9') %}
							{% if not first_vid_is_embed or (not first_vid_is_x and not first_vid_is_non_16x9) %}
								{% set hero_video = first_vid %}
								{% set remaining_videos = video|slice(1) %}
							{% endif %}
						{% endif %}

						{% if hero_video is not null %}
							<div id="mod_video" class="detail-hero detail-hero--video">
								{% if hero_video.embed is defined and hero_video.embed is not empty %}
									{% include 'partials/_video_embed_player.twig' with {'video': hero_video, 'is_hero': true} %}
								{% else %}
									<figure class="video-embed-figure video-embed-figure--hero">
										<a href="{{ site.saddress }}tools/videoFlv/mod_news/{{ d.id }}/{{ hero_video.id }}/show.mp4" class="video-card-wrapper" data-bs-toggle="lightbox" data-gallery="videos" data-title="{{ hero_video.name }}">
											<div class="video-poster ratio ratio-16x9 overflow-hidden position-relative">
												<img src="{{ site.address }}tools/videoResim/mod_news/{{ d.id }}/{{ hero_video.id }}/show.jpg" alt="{{ hero_video.name }}" width="1280" height="720" fetchpriority="high" class="w-100 h-100 object-fit-cover">
												<i class="bi bi-play-circle-fill play-icon"></i>
											</div>
										</a>
										{% if hero_video.name is defined and hero_video.name is not empty %}
											<figcaption class="video-embed-caption video-embed-caption--hero">{{ hero_video.name }}</figcaption>
										{% endif %}
									</figure>
								{% endif %}
							</div>
						{% elseif has_main_image %}
							<figure class="detail-hero">
								<a href="{{ site.iaddress }}mod_news/{{ d.image }}" class="glightbox" data-bs-toggle="lightbox" data-gallery="news-main-image" aria-label="{{ (d.image_alt|default(d.name))|escape('html_attr') }}">
									<img src="{{ site.iaddress }}mod_news/{{ d.image }}" width="1280" height="720" fetchpriority="high" class="detail-hero-image" alt="{{ d.image_alt|default(d.name) }}" title="{{ d.name }}">
								</a>
								{% if d.image_credit is defined and d.image_credit is not empty %}
									<figcaption class="news-hero-caption">{{ d.image_credit }}</figcaption>
								{% endif %}
							</figure>
						{% endif %}

						<div class="detail-meta-bar news-byline-bar">
							<div class="news-byline-author">
								{% if d.username is defined and d.username is not empty %}
									<a href="{{ site.saddress }}author/{{ d.username }}" class="news-byline-avatar-link" aria-label="{{ author_full_name }}">
								{% else %}
									<div class="news-byline-avatar-link">
								{% endif %}
								{% if d.user_image is defined and d.user_image is not empty %}
									<img src="{{ site.iaddress }}mod_user/thumb/{{ d.user_image }}"
									     alt="{{ author_full_name }}"
									     class="news-byline-avatar"
									     width="44"
									     height="44">
								{% else %}
									<div class="news-byline-avatar news-byline-avatar-initials" aria-hidden="true">
										{{ author_initials }}
									</div>
								{% endif %}
								{% if d.username is defined and d.username is not empty %}
									</a>
								{% else %}
									</div>
								{% endif %}

								<div class="detail-meta-copy news-byline-copy">
									<div class="news-byline-name-row">
										{% if d.username is defined and d.username is not empty %}
											<a href="{{ site.saddress }}author/{{ d.username }}" class="news-byline-name">
												{{ author_full_name }}
											</a>
										{% else %}
											<span class="news-byline-name">{{ author_full_name }}</span>
										{% endif %}
									</div>
									<div class="news-byline-dates">
										<span class="news-byline-date-item">
											<span class="news-byline-date-label">{{ lang.index.publish_date }}:</span>
											<time datetime="{{ d.created_at|date('c') }}">{{ d.formatted_datetime is defined and d.formatted_datetime is not empty ? d.formatted_datetime : d.created_at|date('d.m.Y') }}</time>
										</span>
										{% if d.updated_at is not empty and (d.updated_at|date('U')) > (d.created_at|date('U')) %}
											{% set update_age_seconds = ('now'|date('U')) - (d.updated_at|date('U')) %}
											{% set is_recent_update = d.is_updated_last_24h is defined ? d.is_updated_last_24h : (update_age_seconds >= -300 and update_age_seconds < 86400) %}
											<span class="news-byline-date-item{{ is_recent_update ? ' news-byline-date-item--breaking' : '' }}">
												{% if is_recent_update %}<span class="news-byline-live-dot" aria-hidden="true"></span>{% endif %}
												<span class="news-byline-date-label">{{ lang.index.updated_date }}:</span>
												<time datetime="{{ d.updated_at|date('c') }}">{{ d.formatted_updated_datetime is defined and d.formatted_updated_datetime is not empty ? d.formatted_updated_datetime : d.updated_at|date('d.m.Y') }}</time>
											</span>
										{% endif %}
									</div>
								</div>
							</div>

							<div class="detail-tools news-byline-tools" role="toolbar" aria-label="{{ lang.index.share }}">
								<a href="{{ site.saddress }}tools/saveText/mod_news/{{ d.id }}" rel="nofollow noindex" class="news-tool-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ lang.index.mod_gallery.save_txt }}" aria-label="{{ lang.index.mod_gallery.save_txt }}">
									<i class="bi bi-file-text" aria-hidden="true"></i>
								</a>
								{% if files %}
									{% for file_item in files %}
										{% set file_display_name = file_item.filename is defined and file_item.filename is not empty ? file_item.filename : file_item.original_name %}
										<a href="{{ site.saddress }}tools/saveFile/mod_news/{{ d.id }}/{{ file_item.id }}" rel="nofollow noindex" class="news-tool-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ lang.index.mod_attachment.file }}: {{ file_display_name }}" aria-label="{{ lang.index.mod_attachment.file }}: {{ file_display_name }}">
											<i class="bi bi-download" aria-hidden="true"></i>
										</a>
									{% endfor %}
								{% endif %}
								<button type="button" data-action="print" class="news-tool-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ lang.index.mod_gallery.print }}" aria-label="{{ lang.index.mod_gallery.print }}">
									<i class="bi bi-printer" aria-hidden="true"></i>
								</button>
								<span class="news-byline-tools-divider" aria-hidden="true"></span>
								{% include 'partials/share.twig' with {
									'share_wrap_class': 'detail-share-inline',
									'share_container_class': 'justify-content-end',
									'share_url_path': 'news',
									'show_share_text': false
								} %}
							</div>
						</div>

						{% set inline_primary_media_html %}
							{% if hero_video is not null and has_main_image %}
								<figure class="news-inline-image">
									<a href="{{ site.iaddress }}mod_news/{{ d.image }}" class="glightbox" data-bs-toggle="lightbox" data-gallery="news-main-image" aria-label="{{ (d.image_alt|default(d.name))|escape('html_attr') }}">
										<img src="{{ site.iaddress }}mod_news/{{ d.image }}" width="1280" height="720" loading="lazy" decoding="async" class="news-inline-image-el" alt="{{ d.image_alt|default(d.name) }}" title="{{ d.name }}">
									</a>
									{% if d.image_credit is defined and d.image_credit is not empty %}
										<figcaption class="news-hero-caption">{{ d.image_credit }}</figcaption>
									{% endif %}
								</figure>
							{% elseif hero_video is null and remaining_videos is not empty %}
								<div id="mod_video" class="news-inline-video">
									{% for v in remaining_videos %}
										{% if v.embed is defined and v.embed is not empty %}
											{% include 'partials/_video_embed_player.twig' with {'video': v} %}
										{% else %}
											<figure class="video-embed-figure">
												<a href="{{ site.saddress }}tools/videoFlv/mod_news/{{ d.id }}/{{ v.id }}/show.mp4" class="video-card-wrapper" data-bs-toggle="lightbox" data-gallery="videos" data-title="{{ v.name }}">
													<div class="video-poster ratio ratio-16x9 rounded overflow-hidden shadow-sm position-relative">
														<img src="{{ site.address }}tools/videoResim/mod_news/{{ d.id }}/{{ v.id }}/show.jpg" alt="{{ v.name }}" class="w-100 h-100 object-fit-cover">
														<i class="bi bi-play-circle-fill play-icon"></i>
													</div>
												</a>
												{% if v.name is defined and v.name is not empty %}
													<figcaption class="video-embed-caption">{{ v.name }}</figcaption>
												{% endif %}
											</figure>
										{% endif %}
									{% endfor %}
								</div>
							{% endif %}
						{% endset %}

						{% set inline_secondary_videos_html %}
							{% if hero_video is not null and remaining_videos is not empty %}
								<div class="news-inline-video">
									{% for v in remaining_videos %}
										{% if v.embed is defined and v.embed is not empty %}
											{% include 'partials/_video_embed_player.twig' with {'video': v} %}
										{% else %}
											<figure class="video-embed-figure">
												<a href="{{ site.saddress }}tools/videoFlv/mod_news/{{ d.id }}/{{ v.id }}/show.mp4" class="video-card-wrapper" data-bs-toggle="lightbox" data-gallery="videos" data-title="{{ v.name }}">
													<div class="video-poster ratio ratio-16x9 rounded overflow-hidden shadow-sm position-relative">
														<img src="{{ site.address }}tools/videoResim/mod_news/{{ d.id }}/{{ v.id }}/show.jpg" alt="{{ v.name }}" class="w-100 h-100 object-fit-cover">
														<i class="bi bi-play-circle-fill play-icon"></i>
													</div>
												</a>
												{% if v.name is defined and v.name is not empty %}
													<figcaption class="video-embed-caption">{{ v.name }}</figcaption>
												{% endif %}
											</figure>
										{% endif %}
									{% endfor %}
								</div>
							{% endif %}
						{% endset %}

						{% set has_primary_inline = inline_primary_media_html|trim is not empty %}
						{% set has_secondary_inline = inline_secondary_videos_html|trim is not empty %}
						{% set prose_html = d.rendered_content is defined ? d.rendered_content : d.content %}
						<div class="detail-body news-body">
							{% if (has_primary_inline or has_secondary_inline) and '</p>' in prose_html %}
								{% set body_parts = prose_html|split('</p>') %}
								{% set primary_inserted = not has_primary_inline %}
								{% set secondary_inserted = not has_secondary_inline %}
								{% set bq_depth = 0 %}
								{% for part in body_parts %}
									{% set open_bq = (part|lower|split('<blockquote')|length) - 1 %}
									{% set close_bq = (part|lower|split('</blockquote>')|length) - 1 %}
									{% set bq_depth = bq_depth + open_bq - close_bq %}
									{{ part|raw }}{% if not loop.last %}</p>{% endif %}
									{% if not loop.last and bq_depth <= 0 %}
										{% if loop.index >= 2 and not primary_inserted %}
											{{ inline_primary_media_html|raw }}
											{% set primary_inserted = true %}
										{% elseif loop.index >= 4 and primary_inserted and not secondary_inserted %}
											{{ inline_secondary_videos_html|raw }}
											{% set secondary_inserted = true %}
										{% endif %}
									{% endif %}
								{% endfor %}
								{% if not primary_inserted %}
									{{ inline_primary_media_html|raw }}
								{% endif %}
								{% if not secondary_inserted %}
									{{ inline_secondary_videos_html|raw }}
								{% endif %}
							{% else %}
								{{ prose_html|raw }}
								{{ inline_primary_media_html|raw }}
								{{ inline_secondary_videos_html|raw }}
							{% endif %}

							{% if gallery is not empty %}
								{% set first_image = gallery|first %}
								{% set first_img_mod = first_image.mod_name ?: 'mod_news' %}
								<section class="detail-section" id="mod_gallery" aria-labelledby="gallery-title">
									<h2 id="gallery-title" class="detail-section-heading h4"><i class="bi bi-images me-2"></i>{{ lang.index.mod_news.gallery_title }}</h2>
									<div class="news-gallery" aria-label="{{ lang.index.mod_news.gallery_title }}">
										<div class="gallery-stage">
											<button type="button" class="gallery-nav gallery-prev" aria-label="{{ lang.index.mod_news.gallery_prev }}">
												<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
											</button>

											<figure class="gallery-figure">
												<img id="news-gallery-main-img" src="{{ site.iaddress }}mod_gallery/{{ first_img_mod }}/original/{{ first_image.url }}" alt="{{ first_image.name|default(d.name)|escape('html_attr') }}" width="1200" height="675" class="gallery-main-img">
												<button type="button" class="gallery-zoom-btn" aria-label="{{ lang.index.enlarge_image }}">
													<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
												</button>
											</figure>

											<button type="button" class="gallery-nav gallery-next" aria-label="{{ lang.index.mod_news.gallery_next }}">
												<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
											</button>

											<div class="gallery-counter" id="news-gallery-counter">1 / {{ gallery|length }}</div>
										</div>

										<div class="gallery-caption-bar" id="news-gallery-caption-bar" {% if first_image.name is empty %}hidden{% endif %}>
											<p id="news-gallery-caption" class="gallery-caption-text">{{ first_image.name }}</p>
										</div>

										<div class="gallery-thumbs" role="tablist" aria-label="{{ lang.index.mod_news.gallery_title }}">
											{% for image in gallery %}
												{% set img_mod = image.mod_name ?: 'mod_news' %}
												<button type="button" class="thumb-item {% if loop.first %}is-active{% endif %}" data-index="{{ loop.index0 }}" data-src="{{ site.iaddress }}mod_gallery/{{ img_mod }}/original/{{ image.url }}" data-caption="{{ image.name|escape('html_attr') }}" role="tab" aria-selected="{% if loop.first %}true{% else %}false{% endif %}">
													<img src="{{ site.iaddress }}mod_gallery/{{ img_mod }}/thumb/{{ image.url }}" alt="{{ image.name|default(d.name)|escape('html_attr') }}" loading="lazy">
												</button>
											{% endfor %}
										</div>
									</div>
								</section>

								<div id="news-gallery-lightbox" class="news-gallery-lightbox" hidden aria-modal="true" role="dialog" aria-label="{{ lang.index.mod_news.gallery_title }}">
									<button type="button" class="lightbox-close" aria-label="{{ lang.index.mod_news.gallery_close }}">&times;</button>
									<button type="button" class="lightbox-nav lightbox-prev" aria-label="{{ lang.index.mod_news.gallery_prev }}">&#10094;</button>
									<div class="lightbox-content">
										<img id="news-lightbox-img" src="" alt="">
										<p id="news-lightbox-caption" class="lightbox-caption"></p>
									</div>
									<button type="button" class="lightbox-nav lightbox-next" aria-label="{{ lang.index.mod_news.gallery_next }}">&#10095;</button>
								</div>
							{% endif %}
						</div>

						{% include 'partials/share_toolbar.twig' with {
							'share_url_path': 'news',
							'mod_name': 'mod_news',
							'item_id': d.id,
							'has_gallery': gallery is defined and gallery is not empty
						} %}

						{% if files is not empty %}
							<section class="detail-section" id="news-attachments" aria-labelledby="files-title">
								<div class="rounded-4 border bg-body-tertiary p-4 p-md-4 shadow-sm">
									<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
										<div>
											<h2 id="files-title" class="detail-section-heading h4 mb-1"><i class="bi bi-cloud-download"></i>{{ lang.index.mod_attachment.title }}</h2>
											<p class="mb-0 text-muted small">{{ files|length }} {{ lang.index.download }}</p>
										</div>
										<span class="badge rounded-pill text-bg-light border px-3 py-2">{{ files|length }}</span>
									</div>

									<div class="detail-file-list">
										{% for file_item in files %}
											{% set file_display_name = file_item.filename is defined and file_item.filename is not empty ? file_item.filename : file_item.original_name %}
											{% set extension = file_item.original_name|split('.')|last|lower %}
											{% set file_icon = 'bi-file-earmark-arrow-down' %}
											{% set badge_color = 'bg-secondary' %}

											{% if extension == 'pdf' %}{% set file_icon = 'bi-file-earmark-pdf' %}{% set badge_color = 'bg-danger' %}
											{% elseif extension == 'zip' or extension == 'rar' %}{% set file_icon = 'bi-file-earmark-zip' %}{% set badge_color = 'bg-warning text-dark' %}
											{% elseif extension == 'doc' or extension == 'docx' or extension == 'odt' %}{% set file_icon = 'bi-file-earmark-word' %}{% set badge_color = 'bg-primary' %}
											{% elseif extension == 'xls' or extension == 'xlsx' %}{% set file_icon = 'bi-file-earmark-excel' %}{% set badge_color = 'bg-success' %}
											{% elseif extension == 'ppt' or extension == 'pptx' %}{% set file_icon = 'bi-file-earmark-ppt' %}{% set badge_color = 'bg-info text-dark' %}
											{% elseif extension == 'jpg' or extension == 'jpeg' or extension == 'png' or extension == 'gif' %}{% set file_icon = 'bi-file-earmark-image' %}{% set badge_color = 'bg-info' %}
											{% elseif extension == 'epub' %}{% set file_icon = 'bi-book' %}{% set badge_color = 'bg-success' %}
											{% endif %}

											<a href="{{ site.saddress }}tools/saveFile/mod_news/{{ d.id }}/{{ file_item.id }}" rel="nofollow noindex" class="detail-file-link">
												<div class="detail-file-meta">
													<div class="detail-file-icon">
														<i class="bi {{ file_icon }}"></i>
													</div>
													<div>
														<h6 class="detail-file-title">{{ file_display_name }}</h6>
														<span class="badge {{ badge_color }} text-uppercase small">{{ extension }}</span>
													</div>
												</div>
												<div class="ms-3">
													<span class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
														<i class="bi bi-download me-1"></i>{{ lang.index.download }}
													</span>
												</div>
											</a>
										{% endfor %}
									</div>
								</div>
							</section>
						{% endif %}

						{{ faq.render(faqs, faq_lang.mod_faq.title|default('FAQ')) }}
					</div>
				</div>
			</article>

			{% if newses is not empty %}
				<section class="detail-section" aria-labelledby="related-articles-title">
					<h2 id="related-articles-title" class="detail-section-heading h4">{{ lang.index.mod_news.related_news }}</h2>
					<div class="detail-related-grid">
						{% for news in newses %}
							<div>
								<div class="detail-related-card">
									<a href="{{ site.saddress }}news/{{ news.seo }}" class="detail-related-media" aria-label="{{ news.name|striptags }}">
										{% if news.image is not empty %}
											<img src="{{ site.iaddress }}mod_news/thumb/{{ news.image }}" class="detail-related-img" alt="{{ news.name|striptags }}" width="480" height="270" loading="lazy" decoding="async">
										{% else %}
											<div class="detail-related-placeholder">
												<img src="{{ site.iaddress }}mod_settings/logo.png" alt="{{ news.name|striptags }}" width="120" height="120" loading="lazy" decoding="async">
											</div>
										{% endif %}
									</a>
									<div class="detail-related-copy">
										<h3 class="detail-related-title">
											<a href="{{ site.saddress }}news/{{ news.seo }}">{{ news.name }}</a>
										</h3>
										{% if news.created_at is defined and news.created_at is not empty %}
											<div class="detail-related-time text-muted small mb-1">
												{% if news.is_last_24h %}
													<i class="bi bi-clock-history me-1"></i>{{ news.published_ago }}
												{% elseif news.formatted_datetime is defined and news.formatted_datetime is not empty %}
													<i class="bi bi-calendar3 me-1"></i>{{ news.formatted_datetime }}
												{% else %}
													<i class="bi bi-calendar3 me-1"></i>{{ news.created_at|date('d.m.Y') }}
												{% endif %}
											</div>
										{% endif %}
										<p class="detail-related-summary mb-0">{{ news.summary|striptags|trim }}</p>
									</div>
								</div>
							</div>
						{% endfor %}
					</div>
				</section>
			{% endif %}

			{% if subpages is not empty %}
				<section class="detail-list-card mt-5" aria-labelledby="subpages-title">
					<div class="card-header">
						<h5 id="subpages-title" class="fw-bold mb-0">
							<i class="bi bi-layers me-2 text-primary"></i> {{ lang.index.mod_page.description }}
						</h5>
					</div>
					<div class="list-group list-group-flush p-3">
						{% for item in subpages %}
							<a href="{{ site.saddress }}page/{{ item.seo }}" class="list-group-item list-group-item-action border-0 rounded-2 mb-1" title="{{ item.summary|striptags|slice(0, 100) }}">
								{{ item.name }}
							</a>
						{% endfor %}
					</div>
				</section>
			{% endif %}
		</div>

		{% if news_24h is not empty %}
			<aside class="col-lg-4 news-sidebar-col">
				<div class="news-24h-card">
					<header class="news-24h-header">
						<div class="news-24h-title-wrap">
							{% if not news_24h_is_backfill %}
								<span class="news-24h-pulse-dot" aria-hidden="true"></span>
							{% endif %}
							<h3 class="news-24h-title">
								<i class="bi {{ news_24h_is_backfill ? 'bi-newspaper' : 'bi-clock-history' }}" aria-hidden="true"></i>
								<span>{{ news_24h_is_backfill ? lang.index.mod_news.latest_news.title : lang.index.mod_news.latest_news.last_24_hours }}</span>
							</h3>
						</div>
						<span class="news-24h-badge">{{ news_24h_count }}</span>
					</header>

					<div class="news-24h-list">
						{% for item in news_24h %}
							<article class="news-24h-item">
								<a href="{{ site.saddress }}news/{{ item.seo }}"
								   class="news-24h-media"
								   title="{{ item.name|striptags }}">
									{% if item.image is not empty %}
										<img src="{{ site.iaddress }}mod_news/thumb/{{ item.image }}"
											 class="news-24h-img"
											 alt="{{ item.name|striptags }}"
											 width="180"
											 height="120"
											 loading="lazy"
											 decoding="async">
									{% else %}
										<div class="news-24h-placeholder">
											<i class="bi bi-newspaper" aria-hidden="true"></i>
										</div>
									{% endif %}
								</a>

								<div class="news-24h-content">
									<h4 class="news-24h-headline">
										<a href="{{ site.saddress }}news/{{ item.seo }}" title="{{ item.name|striptags }}">
											{{ item.name|striptags }}
										</a>
									</h4>

									{% if item.created_at is defined and item.created_at is not empty %}
										<div class="news-24h-meta text-muted small">
											{% if item.is_last_24h %}
												<i class="bi bi-clock-history me-1" aria-hidden="true"></i>{{ item.published_ago }}
											{% elseif item.formatted_datetime is defined and item.formatted_datetime is not empty %}
												<i class="bi bi-calendar3 me-1" aria-hidden="true"></i>{{ item.formatted_datetime }}
											{% else %}
												<i class="bi bi-calendar3 me-1" aria-hidden="true"></i>{{ item.created_at|date('d.m.Y H:i') }}
											{% endif %}
										</div>
									{% endif %}
								</div>
							</article>
						{% endfor %}
					</div>
				</div>
			</aside>
		{% endif %}
	</div>
{% endblock %}

{% block js_custom %}
	<script src="{{ site.taddress }}{{ site.app_template }}/static/js/video-embed.js?v={{ site.version }}-20261113v2" defer></script>
{% endblock %}
