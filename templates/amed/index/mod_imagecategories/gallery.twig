{% macro image_category(categories, parent_id, ss) %}
{% for cat in categories[parent_id] %}
    {% set parent_id = cat.id %}
    {% if cat.lang == site.lang %}
        {% set ss = 1 %}
        {% if cat.root == 'y' %}
            <!--
                {{ cat.name }}
                -->
        {% else %}
            {% if keto == cat.id %}
                <p class="list-group-item active">
                    <a href="{{ site.saddress }}rkat/{{ cat.seo }}">{{ cat.name }}</a>
                </p>
            {% else %}
                {% if cat.seo == '#' %}
                    <!--
                        <b class="list-group-item">{{ cat.name }}</b>
                        -->
                {% else %}
                    <p class="list-group-item">
                        <a href="{{ site.saddress }}rkat/{{ cat.seo }}">{{ cat.name }}</a>
                    </p>
                {% endif %}
            {% endif %}
        {% endif %}
    {% endif %}
    {% if categories[parent_id] is not empty %}
        {% if ss == '1' %}{% endif %}
        {{ _self.image_category(categories, parent_id) }}
        {% if ss == '1' %}{% endif %}
    {% endif %}
    {% if cat.lang == site.lang %}{% endif %}
{% endfor %}
{% endmacro %}

{% extends "layouts/base.twig" %}

{% block detail_plugins %}
	{% include 'partials/_detail_scripts.twig' %}
{% endblock %}

{% set d = ctx_get('d') %}
{% set rkat = ctx_get('rkat') %}
{% set keto = ctx_get('keto') %}
{% set gallery = ctx_get('gallery') ?: ctx_get('res') %}

{% block title %}
	<title>
		{% if d.name is not empty %}
			{{ d.name }} - {{ lang.index.mod_pictures.title }} - {{ site.title }}
		{% else %}
			{{ lang.index.mod_pictures.title }} - {{ site.title }}
		{% endif %}
	</title>
{% endblock %}

{% block canonical %}
	<link rel="canonical" href="{{ site.saddress }}gallery{% if d.seo is not empty %}/{{ d.seo }}{% endif %}"/>
{% endblock %}
{% block hreflang %}
	<link rel="alternate" hreflang="{{ site.lang }}" href="{{ site.saddress }}gallery{% if d.seo is not empty %}/{{ d.seo }}{% endif %}"/>
	<link rel="alternate" hreflang="x-default" href="{{ site.saddress }}gallery{% if d.seo is not empty %}/{{ d.seo }}{% endif %}"/>
{% endblock %}

{% block description %}
	<meta name="description" content="{{ d.name is not empty ? (d.name ~ ' - ' ~ lang.index.mod_pictures.title ~ ' - ' ~ site.description) : (lang.index.mod_pictures.title ~ ' - ' ~ site.description) }}">
{% endblock %}

{% block keywords %}
	<meta name="keywords" content="{{ site.keywords }}">
{% endblock %}

{% block meta_tags %}
	{% set gallery_page_title = d.name is not empty ? (d.name ~ ' - ' ~ lang.index.mod_pictures.title) : lang.index.mod_pictures.title %}
	{% set gallery_page_desc = d.name is not empty ? (d.name ~ ' - ' ~ site.description) : (lang.index.mod_pictures.title ~ ' - ' ~ site.description) %}
	{% set gallery_canonical_url = site.saddress ~ 'gallery' ~ (d.seo is not empty ? '/' ~ d.seo : '') %}
	{% set gallery_logo_asset = site.logo_path is defined and site.logo_path is not empty ? site.iaddress ~ 'mod_settings/' ~ site.logo_path : (site.iaddress ~ 'mod_settings/logo.png') %}
	{% set gallery_share_img = (gallery is defined and gallery is not empty and gallery|first.url is defined) ? site.iaddress ~ 'mod_gallery/mod_imagecategories/original/' ~ (gallery|first.url) : gallery_logo_asset %}
	<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
	<meta property="og:type" content="website">
	<meta property="og:url" content="{{ gallery_canonical_url }}">
	<meta property="og:title" content="{{ gallery_page_title }} - {{ site.title }}">
	<meta property="og:description" content="{{ gallery_page_desc|striptags|slice(0, 200) }}">
	<meta property="og:image" content="{{ gallery_share_img }}">
	<meta property="og:site_name" content="{{ site.title }}">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="{{ gallery_page_title }} - {{ site.title }}">
	<meta name="twitter:description" content="{{ gallery_page_desc|striptags|slice(0, 200) }}">
	<meta name="twitter:image" content="{{ gallery_share_img }}">
{% endblock %}

{% block schema %}
	{% set current_gallery_url = site.saddress ~ 'gallery' ~ (d.seo is not empty ? '/' ~ d.seo : '') %}
	<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "ImageGallery",
		  "name": {{ (d.name is not empty ? d.name : lang.index.mod_pictures.title)|json_ld|raw }},
		  "description": {{ (d.name is not empty ? (d.name ~ ' - ' ~ site.description) : (lang.index.mod_pictures.title ~ ' - ' ~ site.description))|striptags|slice(0, 200)|json_ld|raw }},
		  "url": {{ current_gallery_url|json_ld|raw }},
		  "isPartOf": {
		    "@type": "WebSite",
		    "name": {{ site.title|json_ld|raw }},
		    "url": {{ site.address|json_ld|raw }}
		  },
		  "breadcrumb": {
		    "@type": "BreadcrumbList",
		    "itemListElement": [
		      {
		        "@type": "ListItem",
		        "position": 1,
		        "name": {{ lang.index.home|json_ld|raw }},
		        "item": {{ site.saddress|json_ld|raw }}
		      },
		      {
		        "@type": "ListItem",
		        "position": 2,
		        "name": {{ lang.index.mod_pictures.title|json_ld|raw }},
		        "item": {{ (site.saddress ~ 'gallery')|json_ld|raw }}
		      }{% if d.name is not empty %},
		      {
		        "@type": "ListItem",
		        "position": 3,
		        "name": {{ d.name|json_ld|raw }},
		        "item": {{ current_gallery_url|json_ld|raw }}
		      }{% endif %}
		    ]
		  }
		}
	</script>
{% endblock %}

{% block content %}
<div class="row" id="mod_imagecategories">
    <div class="card">
        <div class="card-header">
            <ol class="breadcrumb panel-title">
                <li>
                    <a href="{{ site.saddress }}">{{ lang.index.home }}</a>
                </li>
                {% if d.name is not empty %}
                    <li>
                    </li>
                    <li class="active">{{ d.name }}</li>
                {% else %}
                {% endif %}
            </ol>
        </div>
        <div class="card-body">
            <div class="col-md-4">
                <div id="gallery_category" class="list-group">{{ _self.image_category(rkat, 0) }}</div>
            </div>
            <div class="col-md-8">
                {% include 'partials/share_toolbar.twig' with {
                    'share_url_path': 'gallery',
                    'mod_name': 'mod_imagecategories',
                    'item_id': d.id,
                    'has_gallery': gallery is defined and gallery is not empty
                } %}
                {% if d.name is not empty %}
                    {% if gallery is not empty %}
                        <div id="gallery_image">
                            <ul>
                                {% for image in gallery %}
                                    <li class="col-md-4">
                                        <div class="thumbnail">
                                            <a href="{{ site.iaddress }}mod_gallery/mod_imagecategories/original/{{ image.url }}"
                                               class="glightbox"
                                               title="{{ image.name|escape('html_attr') }}"
                                               data-bs-toggle="lightbox"
                                               data-gallery="multiimages"
                                               data-title="{{ image.name|escape('html_attr') }}"
                                               data-parent="#gallery_image">
                                                <img src="{{ site.iaddress }}mod_gallery/mod_imagecategories/thumb/{{ image.url }}"
                                                     alt="{{ image.name|escape('html_attr') }}" loading="lazy">
                                            </a>
                                        </div>
                                    </li>
                                    {% endfor %}
                            </ul>
                        </div>
                    {% else %}
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
