{% extends "layouts/base.twig" %}

{% set category_seo = ctx_get('category_seo') %}
{% set categoryname = ctx_get('categoryname') %}
{% set categories = ctx_get('categories') %}
{% set videos = ctx_get('videos') %}
{% set pagination = ctx_get('pagination')|default(ctx_get('sayfalama')) %}
{% set current_page = ctx_get('page')|default(ctx_get('sayfa'))|default(1) %}

{% set is_filtered = category_seo is not empty and category_seo != 'all' %}
{% set current_page_title = is_filtered ? categoryname : lang.index.mod_video_embed.1 %}
{% set page_canonical = site.saddress ~ 'videos' ~ (is_filtered ? '/' ~ category_seo : '') ~ (current_page is defined and current_page > 1 ? '/' ~ current_page : '') %}
{% set video_logo_asset = site.logo_path is defined and site.logo_path is not empty ? site.iaddress ~ 'mod_settings/' ~ site.logo_path : (site.iaddress ~ 'mod_settings/logo.png') %}

{% block canonical %}
    <link rel="canonical" href="{{ page_canonical }}">
{% endblock %}
{% block hreflang %}
    <link rel="alternate" hreflang="{{ site.lang }}" href="{{ page_canonical }}"/>
    <link rel="alternate" hreflang="x-default" href="{{ page_canonical }}"/>
{% endblock %}

{% block title %}
    <title>{{ current_page_title }} - {{ site.title }}</title>
{% endblock %}

{% block description %}
    <meta name="description" content="{{ current_page_title }} - {{ site.description }}">
{% endblock %}

{% block meta_tags %}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page_canonical }}">
    <meta property="og:title" content="{{ current_page_title }} - {{ site.title }}">
    <meta property="og:description" content="{{ current_page_title }} - {{ site.description }}">
    <meta property="og:image" content="{{ video_logo_asset }}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ current_page_title }} - {{ site.title }}">
    <meta name="twitter:description" content="{{ current_page_title }} - {{ site.description }}">
    <meta name="twitter:image" content="{{ video_logo_asset }}">
{% endblock %}

{% block schema %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ lang.index.home|json_ld|raw }},
          "item": {{ site.saddress|json_ld|raw }}
        }{% if is_filtered %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ lang.index.mod_video_embed.1|json_ld|raw }},
          "item": {{ (site.saddress ~ 'videos')|json_ld|raw }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ categoryname|json_ld|raw }},
          "item": {{ page_canonical|json_ld|raw }}
        }
        {% else %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ lang.index.mod_video_embed.1|json_ld|raw }},
          "item": {{ page_canonical|json_ld|raw }}
        }
        {% endif %}
      ]
    }
    </script>
{% endblock %}

{% block css_custom %}
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/content.css?v={{ site.version }}">
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/video-embed.css?v={{ site.version }}">
{% endblock %}

{% block content %}
<div class="row mt-4" id="mod_video_embed_list">

    <!-- Left Column: Categories -->
    <aside class="col-lg-3 order-lg-1 mb-4">
        <div class="card sticky-top" aria-labelledby="video-categories-title">
            <div class="card-header">
                <h2 id="video-categories-title" class="h5"><i class="bi bi-camera-video me-2"></i>{{ lang.index.mod_video_embed.1 }}</h2>
            </div>
            <div class="list-group list-group-flush">
                <a href="{{ site.saddress }}videos" class="list-group-item list-group-item-action{% if category_seo is empty or category_seo == 'all' %} active{% endif %}">
                    {{ lang.index.mod_video_embed.latest_videos.all_items|default(lang.index.mod_video_embed.1) }}
                </a>
                {% for kat in categories %}
                    <a href="{{ site.saddress }}videos/{{ kat.seo }}" class="list-group-item list-group-item-action{% if category_seo == kat.seo %} active{% endif %}">
                        {{ kat.name }}
                    </a>
                {% endfor %}
            </div>
        </div>
    </aside>

    <!-- Right Column: Videos -->
    <div class="col-lg-9 order-lg-2">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ site.saddress }}">{{ lang.index.home }}</a></li>
                {% if category_seo is not empty and category_seo != 'all' %}
                    <li class="breadcrumb-item"><a href="{{ site.saddress }}videos">{{ lang.index.mod_video_embed.1 }}</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{ categoryname }}</li>
                {% else %}
                    <li class="breadcrumb-item active" aria-current="page">{{ lang.index.mod_video_embed.1 }}</li>
                {% endif %}
            </ol>
        </nav>

        {% if videos is not empty %}
            <div class="row">
                {% for video in videos %}
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card video-card h-100">
                            <a href="{{ video.embed_src|default(video.youtube_url) }}" 
                               class="video-poster-link"
                               data-bs-toggle="lightbox"
                               data-gallery="videos"
                               data-title="{{ video.name }}">
                                <div class="video-poster">
                                    <img src="{{ video.poster_url|default(site.iaddress ~ 'mod_video_embed/thumb/' ~ video.image) }}" alt="{{ video.name }}" class="w-100 h-100 object-fit-cover" width="480" height="270" loading="lazy" decoding="async">
                                    <i class="bi bi-play-circle-fill play-icon"></i>
                                </div>
                            </a>
                            <div class="card-body">
                                <p class="card-text fw-bold">
                                    <a href="{{ site.saddress }}video/{{ video.id }}-{{ video.name|legacy_seo }}" title="{{ video.name }}">
                                        {{ video.name }}
                                    </a>
                                </p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            {% if pagination is not empty %}
                <nav aria-label="{{ lang.index.mod_video_embed.8 }}" class="mt-4">
                    <ul class="pagination justify-content-center">
                        {% for s in pagination %}
                            {% if s == '...' %}
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            {% elseif s == current_page %}
                                <li class="page-item active" aria-current="page"><span class="page-link">{{ s }}</span></li>
                            {% else %}
                                <li class="page-item"><a class="page-link" href="{{ site.saddress }}videos/{{ category_seo|default('all') }}/{{ s }}">{{ s }}</a></li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        {% else %}
            <div class="alert alert-warning" role="alert">{{ lang.index.mod_video_embed.4 }}</div>
        {% endif %}
    </div>
</div>
{% endblock %}
