{% extends "layouts/base.twig" %}

{% set d = ctx_get('d') %}
{% set categories = ctx_get('categories') %}
{% set video_url = site.saddress ~ 'video/' ~ d.id ~ '-' ~ (d.name|legacy_seo) %}
{% set video_meta_desc = (d.summary ?: (d.content ?: (d.description ?: (d.name ?: site.description))))|striptags|trim|slice(0, 200) %}
{% set video_logo_asset = site.logo_path is defined and site.logo_path is not empty ? site.iaddress ~ 'mod_settings/' ~ site.logo_path : (site.iaddress ~ 'mod_settings/logo.png') %}
{% set video_image = (d.image is defined and d.image is not empty) ? (d.is_local|default(false) ? site.iaddress ~ 'mod_video/image/' ~ d.image : site.iaddress ~ 'mod_video_embed/' ~ d.image) : video_logo_asset %}
{% set fallback_video_share_image = d.poster_url is defined and d.poster_url is not empty ? d.poster_url : video_image %}
{% set fallback_video_ext = fallback_video_share_image|split('?')|first|split('.')|last|lower %}
{% set fallback_video_mime = fallback_video_ext == 'png' ? 'image/png' : (fallback_video_ext == 'webp' ? 'image/webp' : (fallback_video_ext == 'gif' ? 'image/gif' : 'image/jpeg')) %}
{% set video_share_image = d.og_image_url is defined and d.og_image_url is not empty ? d.og_image_url : fallback_video_share_image %}
{% set video_share_mime = d.og_image_mime is defined and d.og_image_mime is not empty ? d.og_image_mime : fallback_video_mime %}
{% set video_share_width = d.og_image_width is defined and d.og_image_width ? d.og_image_width : null %}
{% set video_share_height = d.og_image_height is defined and d.og_image_height ? d.og_image_height : null %}

{% block canonical %}
    <link rel="canonical" href="{{ video_url }}">
{% endblock %}
{% block hreflang %}
    <link rel="alternate" hreflang="{{ site.lang }}" href="{{ video_url }}"/>
    <link rel="alternate" hreflang="x-default" href="{{ video_url }}"/>
{% endblock %}

{% block css_custom %}
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/content.css?v={{ site.version }}">
    <link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/video-embed.css?v={{ site.version }}-20261113v3">
{% endblock %}

{% block title %}
    <title>{{ d.name }} - {{ lang.index.mod_video_embed.1 }} - {{ site.title }}</title>
{% endblock %}

{% block description %}
    <meta name="description" content="{{ video_meta_desc }}">
{% endblock %}

{% block meta_tags %}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta property="og:type" content="video.other">
    <meta property="og:url" content="{{ video_url }}">
    <meta property="og:title" content="{{ d.name }} - {{ site.title }}">
    <meta property="og:description" content="{{ video_meta_desc }}">
    {% if video_share_image is not empty %}
        <meta property="og:image" content="{{ video_share_image }}">
        {% if video_share_image starts with 'https://' %}
            <meta property="og:image:secure_url" content="{{ video_share_image }}">
        {% endif %}
        <meta property="og:image:type" content="{{ video_share_mime }}">
        {% if video_share_width and video_share_height %}
            <meta property="og:image:width" content="{{ video_share_width }}">
            <meta property="og:image:height" content="{{ video_share_height }}">
        {% endif %}
    {% endif %}
    <meta property="og:site_name" content="{{ site.title }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ video_url }}">
    <meta name="twitter:title" content="{{ d.name }} - {{ site.title }}">
    <meta name="twitter:description" content="{{ video_meta_desc }}">
    {% if video_share_image is not empty %}
        <meta name="twitter:image" content="{{ video_share_image }}">
    {% endif %}
{% endblock %}

{% block schema %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ lang.index.home|json_ld|raw }},
          "item": {{ site.saddress|json_ld|raw }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ lang.index.mod_video_embed.1|json_ld|raw }},
          "item": {{ (site.saddress ~ 'videos')|json_ld|raw }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ d.categoryname|json_ld|raw }},
          "item": {{ (site.saddress ~ 'videos/' ~ d.category_seo)|json_ld|raw }}
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": {{ d.name|json_ld|raw }},
          "item": {{ video_url|json_ld|raw }}
        }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "name": {{ d.name|json_ld|raw }},
      "description": {{ (d.summary ?: (d.description ?: (d.content ?: d.name)))|striptags|slice(0, 300)|json_ld|raw }},
      "thumbnailUrl": [{{ video_share_image|json_ld|raw }}],
      "uploadDate": {{ (d.created_at ? d.created_at|date('c') : 'now'|date('c'))|json_ld|raw }},
      {% if d.schema_duration is defined and d.schema_duration is not empty %}
      "duration": {{ d.schema_duration|json_ld|raw }},
      {% endif %}
      "embedUrl": {{ (d.embed_src ?: video_url)|json_ld|raw }}
    }
    </script>
{% endblock %}

{% block content %}
<div class="row mt-4" id="mod_video_embed_detail">

    <!-- Left Column: Categories -->
    <aside class="col-lg-3 order-lg-1 mb-4">
        <div class="card position-sticky sticky-top" aria-labelledby="video-categories-title">
            <div class="card-header">
                <h2 id="video-categories-title" class="h5"><i class="bi bi-camera-video me-2"></i>{{ lang.index.mod_video_embed.1 }}</h2>
            </div>
            <div class="list-group list-group-flush">
                <a href="{{ site.saddress }}videos" class="list-group-item list-group-item-action">
                    {{ lang.index.mod_video_embed.latest_videos.all_items }}
                </a>
                {% for kat in categories %}
                    <a href="{{ site.saddress }}videos/{{ kat.seo }}" class="list-group-item list-group-item-action{% if d.category_seo == kat.seo %} active{% endif %}">
                        {{ kat.name }}
                    </a>
                {% endfor %}
            </div>
        </div>
    </aside>

    <!-- Right Column: Video Content -->
    <div class="col-lg-9 order-lg-2">
        <article class="card">
            <div class="card-header bg-light">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="{{ site.saddress }}">{{ lang.index.home }}</a></li>
                        <li class="breadcrumb-item"><a href="{{ site.saddress }}videos">{{ lang.index.mod_video_embed.1 }}</a></li>
                        <li class="breadcrumb-item"><a href="{{ site.saddress }}videos/{{ d.category_seo }}">{{ d.categoryname }}</a></li>
                        <li class="breadcrumb-item active" aria-current="page">{{ d.name }}</li>
                    </ol>
                </nav>
            </div>
            <div class="card-body">
                <h1 class="card-title fs-2 fw-bold mb-3">{{ d.name }}</h1>

                {% if d.deck is defined and d.deck == 'y' %}
                    <p class="lead mb-4">{{ d.summary }}</p>
                {% endif %}

                {# Video Embed Player or Local Video Player #}
                {% if d.is_local is defined and d.is_local %}
                    <div class="ratio ratio-16x9 mb-4">
                        {{ d.embed|raw }}
                    </div>
                {% else %}
                    {% include 'partials/_video_embed_player.twig' with {'video': d} %}
                {% endif %}

                {# Video Description #}
                {% if d.content is not empty %}
                    <div class="content-body mb-4">
                        {{ d.content|raw }}
                    </div>
                {% endif %}

                <hr>
                <p class="text-muted small">
                    {{ sprintf(lang.index.mod_video_embed.7, d.created_at|date('d.m.Y'), site.saddress ~ 'videos/' ~ d.category_seo, d.categoryname, d.categoryname)|raw }}
                </p>
            </div>
        </article>
    </div>
</div>
{% endblock %}

{% block js_custom %}
    <script src="{{ site.taddress }}{{ site.app_template }}/static/js/video-embed.js?v={{ site.version }}-20261113v2" defer></script>
{% endblock %}
