{% extends "layouts/base.twig" %}

{% block css_custom %}
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/detail-foundation.css?v={{ site.version }}">
	<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/legal-info.css?v={{ site.version }}">
{% endblock %}

{% set page_meta_title = lang.index.privacy_policy %}
{% set page_meta_description = lang.index.privacy_policy_subtitle is defined and lang.index.privacy_policy_subtitle is not empty ? lang.index.privacy_policy_subtitle : site.description %}

{% block canonical %}
	<link rel="canonical" href="{{ site.saddress }}privacy-policy"/>
{% endblock %}

{% block title %}
	<title>{{ page_meta_title }} - {{ site.name }}</title>
{% endblock %}

{% block description %}
	<meta name="description" content="{{ page_meta_description }}">
{% endblock %}

{% block meta_tags %}
	<meta property="og:type" content="website">
	<meta property="og:url" content="{{ site.saddress }}privacy-policy">
	<meta property="og:title" content="{{ page_meta_title }}">
	<meta property="og:description" content="{{ page_meta_description|striptags|slice(0, 200) }}">
	<meta property="og:site_name" content="{{ site.name }}">
	{% set og_locale = site.lang %}
	{% if site.lang == 'en' %}{% set og_locale = 'en_US' %}
	{% elseif site.lang == 'tr' %}{% set og_locale = 'tr_TR' %}
	{% elseif site.lang == 'de' %}{% set og_locale = 'de_DE' %}
	{% elseif site.lang == 'fr' %}{% set og_locale = 'fr_FR' %}
	{% elseif site.lang == 'sv' %}{% set og_locale = 'sv_SE' %}
	{% elseif site.lang == 'ru' %}{% set og_locale = 'ru_RU' %}
	{% elseif site.lang == 'ar' %}{% set og_locale = 'ar_AR' %}
	{% elseif site.lang == 'ku' %}{% set og_locale = 'ku' %}
	{% elseif site.lang == 'ckb' %}{% set og_locale = 'ckb' %}
	{% elseif site.lang == 'zza' %}{% set og_locale = 'zza' %}
	{% endif %}
	<meta property="og:locale" content="{{ og_locale }}">

	<meta name="twitter:card" content="summary">
	<meta name="twitter:url" content="{{ site.saddress }}privacy-policy">
	<meta name="twitter:title" content="{{ page_meta_title }}">
	<meta name="twitter:description" content="{{ page_meta_description|striptags|slice(0, 200) }}">
{% endblock %}

{% block schema %}
	<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "WebPage",
		  "name": {{ page_meta_title|json_encode|raw }},
		  "description": {{ page_meta_description|striptags|slice(0, 200)|json_encode|raw }},
		  "url": {{ (site.saddress ~ 'privacy-policy')|json_encode|raw }},
		  "isPartOf": {
		    "@type": "WebSite",
		    "name": {{ site.name|json_encode|raw }},
		    "url": {{ site.address|json_encode|raw }}
		  },
		  "breadcrumb": {
		    "@type": "BreadcrumbList",
		    "itemListElement": [
		      {
			"@type": "ListItem",
			"position": 1,
			"name": {{ lang.index.home|json_encode|raw }},
			"item": {{ site.saddress|json_encode|raw }}
		      },
		      {
			"@type": "ListItem",
			"position": 2,
			"name": {{ page_meta_title|json_encode|raw }},
			"item": {{ (site.saddress ~ 'privacy-policy')|json_encode|raw }}
		      }
		    ]
		  }
		}
	</script>
{% endblock %}

{% block content %}
<div class="legal-dossier-shell" id="mod_privacy_policy">
	<div class="legal-breadcrumb-bar">
		<nav aria-label="{{ lang.index.home }}">
			<ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
				<li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<a itemprop="item" href="{{ site.saddress }}">
						<span itemprop="name">{{ lang.index.home }}</span>
					</a>
					<meta itemprop="position" content="1"/>
				</li>
				<li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<span itemprop="name">{{ page_meta_title }}</span>
					<meta itemprop="position" content="2"/>
				</li>
			</ol>
		</nav>
	</div>

	<div class="legal-dossier-grid">
		<aside class="legal-dossier-sidebar">
			{% include "partials/_legal_nav.twig" %}
		</aside>

		<article class="legal-document-sheet">
			<header class="legal-doc-header">
				<h1 class="legal-doc-title">{{ page_meta_title }}</h1>
				<p class="legal-doc-lead">{{ page_meta_description }}</p>
			</header>

			<div class="policy-card-stack">
				<!-- 1. Data Controller Identity -->
				<section class="policy-section-card" aria-labelledby="sec-privacy-controller">
					<div class="policy-section-header">
						<div class="policy-section-icon" aria-hidden="true">
							<i class="bi bi-building"></i>
						</div>
						<h2 id="sec-privacy-controller" class="policy-section-title">{{ lang.index.privacy_data_controller_title }}</h2>
					</div>
					<div class="policy-section-body">
						<p>{{ lang.index.privacy_data_controller_desc }}</p>
						<ul class="policy-clause-list">
							<li class="policy-clause-item">
								<div class="policy-clause-content">
									<strong>{{ lang.index.legal_company_name }}:</strong> {{ site.legal_company_name is defined and site.legal_company_name is not empty ? site.legal_company_name : site.name }}
								</div>
							</li>
							{% if site.corporate_address is defined and site.corporate_address is not empty %}
								<li class="policy-clause-item">
									<div class="policy-clause-content">
										<strong>{{ lang.index.corporate_address }}:</strong> {{ site.corporate_address }}
									</div>
								</li>
							{% elseif site.office_address is defined and site.office_address is not empty %}
								<li class="policy-clause-item">
									<div class="policy-clause-content">
										<strong>{{ lang.index.corporate_address }}:</strong> {{ site.office_address|striptags }}
									</div>
								</li>
							{% endif %}
							{% if site.company_registration_number is defined and site.company_registration_number is not empty %}
								<li class="policy-clause-item">
									<div class="policy-clause-content">
										<strong>{{ lang.index.company_registration_number }}:</strong> {{ site.company_registration_number }}
									</div>
								</li>
							{% endif %}
							{% if site.tax_number is defined and site.tax_number is not empty %}
								<li class="policy-clause-item">
									<div class="policy-clause-content">
										<strong>{{ lang.index.tax_number }}:</strong> {{ site.tax_number }}
									</div>
								</li>
							{% endif %}
							{% if site.registered_email is defined and site.registered_email is not empty %}
								<li class="policy-clause-item">
									<div class="policy-clause-content">
										<strong>{{ lang.index.registered_email }}:</strong> <a href="mailto:{{ site.registered_email }}">{{ site.registered_email }}</a>
									</div>
								</li>
							{% endif %}
						</ul>
					</div>
				</section>

				<!-- 2. Categories of Processed Data -->
				<section class="policy-section-card" aria-labelledby="sec-privacy-collected">
					<div class="policy-section-header">
						<div class="policy-section-icon" aria-hidden="true">
							<i class="bi bi-folder-check"></i>
						</div>
						<h2 id="sec-privacy-collected" class="policy-section-title">{{ lang.index.privacy_data_collected_title }}</h2>
					</div>
					<div class="policy-section-body">
						<p>{{ lang.index.privacy_data_collected_desc }}</p>
					</div>
				</section>

				<!-- 3. Legal Bases & Purposes -->
				<section class="policy-section-card" aria-labelledby="sec-privacy-legal-basis">
					<div class="policy-section-header">
						<div class="policy-section-icon" aria-hidden="true">
							<i class="bi bi-journal-text"></i>
						</div>
						<h2 id="sec-privacy-legal-basis" class="policy-section-title">{{ lang.index.privacy_legal_basis_title }}</h2>
					</div>
					<div class="policy-section-body">
						<p>{{ lang.index.privacy_legal_basis_desc }}</p>
					</div>
				</section>

				<!-- 4. Data Retention & Infrastructure -->
				<section class="policy-section-card" aria-labelledby="sec-privacy-retention">
					<div class="policy-section-header">
						<div class="policy-section-icon" aria-hidden="true">
							<i class="bi bi-hdd-network"></i>
						</div>
						<h2 id="sec-privacy-retention" class="policy-section-title">{{ lang.index.privacy_retention_title }}</h2>
					</div>
					<div class="policy-section-body">
						<p>{{ lang.index.privacy_retention_desc }}</p>
						{% if site.hosting_provider is defined and site.hosting_provider is not empty %}
							<ul class="policy-clause-list">
								<li class="policy-clause-item">
									<div class="policy-clause-content">
										<strong>{{ lang.index.hosting_provider }}:</strong> {{ site.hosting_provider }}
									</div>
								</li>
							</ul>
						{% endif %}
					</div>
				</section>

				<!-- 5. Data Subject Rights -->
				<section class="policy-section-card" aria-labelledby="sec-privacy-rights">
					<div class="policy-section-header">
						<div class="policy-section-icon" aria-hidden="true">
							<i class="bi bi-person-check"></i>
						</div>
						<h2 id="sec-privacy-rights" class="policy-section-title">{{ lang.index.privacy_subject_rights_title }}</h2>
					</div>
					<div class="policy-section-body">
						<p>{{ lang.index.privacy_subject_rights_desc }}</p>
					</div>
				</section>

				<!-- 6. DPO & Contact -->
				<section class="policy-section-card" aria-labelledby="sec-privacy-dpo">
					<div class="policy-section-header">
						<div class="policy-section-icon" aria-hidden="true">
							<i class="bi bi-envelope-at"></i>
						</div>
						<h2 id="sec-privacy-dpo" class="policy-section-title">{{ lang.index.privacy_dpo_contact_title }}</h2>
					</div>
					<div class="policy-section-body">
						<p>{{ lang.index.privacy_dpo_contact_desc }}</p>
						{% if (site.dpo_email is defined and site.dpo_email is not empty) or (site.registered_email is defined and site.registered_email is not empty) or (site.mail is defined and site.mail is not empty) %}
							<ul class="policy-clause-list">
								{% if site.dpo_email is defined and site.dpo_email is not empty %}
									<li class="policy-clause-item">
										<div class="policy-clause-content">
											<strong>{{ lang.index.dpo_email }}:</strong>
											<a href="mailto:{{ site.dpo_email }}">{{ site.dpo_email }}</a>
										</div>
									</li>
								{% endif %}
								{% if site.registered_email is defined and site.registered_email is not empty %}
									<li class="policy-clause-item">
										<div class="policy-clause-content">
											<strong>{{ lang.index.registered_email }}:</strong>
											<a href="mailto:{{ site.registered_email }}">{{ site.registered_email }}</a>
										</div>
									</li>
								{% elseif site.mail is defined and site.mail is not empty %}
									<li class="policy-clause-item">
										<div class="policy-clause-content">
											<strong>{{ lang.index.email }}:</strong>
											<a href="mailto:{{ site.mail }}">{{ site.mail }}</a>
										</div>
									</li>
								{% endif %}
							</ul>
						{% endif %}
					</div>
				</section>
			</div>

			<!-- Bottom Institutional Contact Bar -->
			<footer class="policy-footer-card">
				<div class="policy-footer-info">
					<div class="policy-footer-icon" aria-hidden="true">
						<i class="bi bi-shield-lock"></i>
					</div>
					<div>
						<h3 class="policy-footer-title">{{ lang.index.contact_us }}</h3>
						<p class="policy-footer-text">{{ lang.index.privacy_dpo_contact_title }}</p>
					</div>
				</div>
				<div class="policy-footer-action">
					<a href="{{ site.saddress }}contact" class="btn btn-primary rounded-pill px-4">
						<i class="bi bi-send me-1" aria-hidden="true"></i>{{ lang.index.contact }}
					</a>
				</div>
			</footer>
		</article>
	</div>
</div>
{% endblock %}
