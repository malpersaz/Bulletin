{% from "macros/menu.twig" import renderMenu %}

<!-- START: partials/bottom_menu.twig -->

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#amidaBottomMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="amidaBottomMenu">
            {% set footer_menu = ctx_get('menu_footer') %}
            {% set active_footer_menu = footer_menu is defined and footer_menu is not empty ? footer_menu : menu %}
            {% set active_footer_root = (footer_menu is defined and footer_menu is not empty) ? ctx_get('menu_footer_root_id') : 6 %}
            {% if active_footer_menu is defined and active_footer_menu is not empty %}
                <ul class="navbar-nav me-auto">
                    {{ renderMenu(active_footer_menu, active_footer_root|default(0), 0) }}
                </ul>
            {% endif %}
        </div>
    </div>
</nav>

<!-- END: partials/bottom_menu.twig -->