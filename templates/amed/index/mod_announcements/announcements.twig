{% extends "layouts/base.twig" %}

{% set d = ctx_get('d') %}
{% set announcements = ctx_get('announcements') %}
{% set yil = ctx_get('yil') %}
{% set ay = ctx_get('ay') %}
{% set arsiv_yil = ctx_get('arsiv_yil') %}
{% set bulunamadi = ctx_get('bulunamadi') %}
{% set announcements_url = site.saddress ~ 'announcements' %}
{% set announcement_logo_asset = site.logo_path is defined and site.logo_path is not empty ? site.iaddress ~ 'mod_settings/' ~ site.logo_path : (site.iaddress ~ 'mod_settings/logo.png') %}

{% block canonical %}
    <link rel="canonical" href="{{ announcements_url }}">
{% endblock %}
{% block hreflang %}
    <link rel="alternate" hreflang="{{ site.lang }}" href="{{ announcements_url }}"/>
    <link rel="alternate" hreflang="x-default" href="{{ announcements_url }}"/>
{% endblock %}

{% block title %}
    <title>{{ lang.index.mod_announcements.1 }} - {{ site.title }}</title>
{% endblock %}

{% block description %}
    <meta name="description" content="{{ lang.index.mod_announcements.1 }} - {{ site.description }}">
{% endblock %}

{% block meta_tags %}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ announcements_url }}">
    <meta property="og:title" content="{{ lang.index.mod_announcements.1 }} - {{ site.title }}">
    <meta property="og:description" content="{{ lang.index.mod_announcements.1 }} - {{ site.description }}">
    <meta property="og:image" content="{{ announcement_logo_asset }}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ lang.index.mod_announcements.1 }} - {{ site.title }}">
    <meta name="twitter:description" content="{{ lang.index.mod_announcements.1 }} - {{ site.description }}">
    <meta name="twitter:image" content="{{ announcement_logo_asset }}">
{% endblock %}

{% block schema %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ lang.index.home|json_ld|raw }},
          "item": {{ site.saddress|json_ld|raw }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ lang.index.mod_announcements.1|json_ld|raw }},
          "item": {{ announcements_url|json_ld|raw }}
        }
      ]
    }
    </script>
{% endblock %}

{% block content %}
<div class="row" id="mod_announcements_list">
    <div class="card">
        <div class="card-header">
            <ol class="breadcrumb panel-title">
                <li>
                    <a href="{{ site.saddress }}">{{ lang.index.home }}</a>
                </li>
                <li class="active">{{ lang.index.mod_announcements.1 }}</li>
            </ol>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <form class="form-horizontal" method="post" action="{{ site.saddress }}announcements">
                                <fieldset>
                                    <!-- Form Name -->
                                    <legend>{{ d.name }}</legend>
                                    <div class="form-group">
                                        <label class="col-md-4 control-label" for="yil">{{ lang.index.mod_announcements.2 }}</label>
                                        <div class="col-md-8">
                                            <select id="yil" name="yil" class="form-control">
                                                <option value="*"{% if yil == '*' %} selected="selected"{% endif %}>*</option>
                                                {% for i in arsiv_yil.min_yil..arsiv_yil.max_yil %}
                                                    <option value="{{ i }}"{% if yil == i %} selected="selected"{% endif %}>{{ i }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-md-4 control-label" for="ay">{{ lang.index.mod_announcements.3 }}</label>
                                        <div class="col-md-8">
                                            <select id="ay" name="ay" class="form-control">
                                                <option value="*"{% if ay == '*' %} selected="selected"{% endif %}>*</option>
                                                {% for i in 0..lang.index.mod_announcements.aylar|length - 1 %}
                                                    <option value="{{ i + 1 }}"
                                                            {% if ay == i + 1 %}selected="selected"{% endif %}>
                                                        {{ lang.index.mod_announcements.aylar[i] }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-md-4 control-label" for="ara">{{ lang.index.mod_announcements.4 }}</label>
                                        <div class="col-md-8">
                                            <button id="ara" name="ara" class="btn btn-success">
                                                <i class="fa fa-location-arrow"></i> {{ lang.index.mod_announcements.4 }}
                                            </button>
                                        </div>
                                    </div>
                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <hr>
                    {% if bulunamadi is not empty %}<h5 class="alert alert-info">{{ lang.index.mod_announcements.7 }}</h5>{% endif %}
                    {% if announcements %}
                        <h4 class="alert alert-success">{{ lang.index.mod_announcements.8 }}</h4>
                        {% for announcement in announcements %}
                            <p>
                                {{ announcement.created_at|date("Y-m-d") }} - <a data-bs-toggle="tooltip"
    href="{{ site.saddress }}announcement/{{ announcement.id }}-{{ announcement.name|legacy_seo }}"
    title="{% if announcement.summary != '' %}{{ announcement.summary }}{% else %}{{ announcement.name }}{% endif %}">{{ announcement.name }}</a>
                            </p>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
