{# Block L2: Horizontal Authors & Latest Publications Strip (3 Columns) - docs/plan/homepage-layout-wireframe.html #}
{% set author_limit = limit|default(3) %}
{{ run({"mod": "index", "method": "_latest_authors", "extra": [author_limit]}) }}
{% set latest_authors = ctx_get('latest_authors') %}

{% if latest_authors is not empty %}
    <section id="latest-publication-authors" class="latest-authors-section" aria-labelledby="latest-authors-heading">
        <div class="latest-authors-card">
            <header class="latest-authors-head">
                <h2 id="latest-authors-heading" class="latest-authors-title">
                    <a href="{{ site.saddress }}authors" class="latest-authors-title-link">
                        <span>{{ lang.index.mod_publication.all_authors }}</span>
                    </a>
                </h2>
                <a href="{{ site.saddress }}publications" class="latest-authors-view-all" aria-label="{{ lang.index.mod_publication.all_authors }} - {{ lang.index.mod_publication.articles }}">
                    <span>{{ lang.index.mod_publication.articles }}</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
            </header>

            <div class="latest-authors-list">
                {% for author in latest_authors %}
                    {% set latest_author_name = (author.u_name ~ ' ' ~ author.u_last_name)|trim %}
                    {% set latest_author_initials = (author.u_name|slice(0, 1) ~ author.u_last_name|slice(0, 1))|upper %}
                    {% set latest_publication_title = (author.title is defined and author.title is not empty ? author.title : author.name)|trim %}
                    <article class="latest-authors-item">
                        <a class="latest-authors-avatar" href="{{ site.saddress }}author/{{ author.username }}" aria-label="{{ latest_author_name }}">
                            {% if author.user_image is defined and author.user_image is not empty %}
                                <img src="{{ site.address }}r/w-52/h-52/c-1/f/mod_user/thumb/{{ author.user_image }}"
                                     srcset="{{ site.address }}r/w-52/h-52/c-1/f/mod_user/thumb/{{ author.user_image }} 1x, {{ site.address }}r/w-104/h-104/c-1/f/mod_user/thumb/{{ author.user_image }} 2x"
                                     alt=""
                                     width="52"
                                     height="52"
                                     loading="lazy"
                                     decoding="async">
                            {% else %}
                                <span>{{ latest_author_initials }}</span>
                            {% endif %}
                        </a>
                        <div class="latest-authors-copy">
                            <a class="latest-authors-name" href="{{ site.saddress }}author/{{ author.username }}">{{ latest_author_name }}</a>
                            <a class="latest-authors-publication" href="{{ site.saddress }}publication/{{ author.seo }}">{{ latest_publication_title }}</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>
{% endif %}
