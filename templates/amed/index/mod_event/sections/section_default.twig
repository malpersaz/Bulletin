{# ==========================================================================
   Category Section: Default / General Events
   templates/amed/index/mod_event/sections/section_default.twig
   Strict Code Separation: Zero Inline CSS, Zero Inline JS
   ========================================================================== #}
{% set card_col_class = (is_single_view is defined and is_single_view) ? 'col-12 col-lg-6' : 'col-12' %}
<section class="event-category-section h-100 d-flex flex-column" id="cat-{{ section.seo }}" aria-labelledby="heading-{{ section.seo }}">
    <div class="event-section-header mb-3 pb-2 border-bottom">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
            <h2 class="event-section-title h5 fw-bold mb-0" id="heading-{{ section.seo }}">
                <a href="{{ site.saddress }}events/{{ section.seo }}" class="text-decoration-none text-reset">
                    <i class="bi bi-calendar2-event me-2 text-primary" aria-hidden="true"></i>{{ section.name }}
                </a>
                {% if section.event_count > 0 %}
                    <span class="badge rounded-pill bg-light text-secondary border ms-1">{{ section.event_count }}</span>
                {% endif %}
            </h2>
            {% if is_single_view is not defined or not is_single_view %}
                {% if section.event_count > 0 %}
                    <a href="{{ site.saddress }}events/{{ section.seo }}" class="btn btn-outline-primary btn-sm flex-shrink-0">
                        {{ lang.index.mod_event.view_all_events }} <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                    </a>
                {% endif %}
            {% endif %}
        </div>
        {% if section.description is defined and section.description is not empty %}
            <p class="event-section-desc text-muted mb-0 small text-truncate">{{ section.description }}</p>
        {% endif %}
    </div>

    {% if section.events is defined and section.events is not empty %}
        <div class="row g-3 events-grid flex-grow-1">
            {% for ev in section.events %}
                {% set ev_poster = ev.image is not empty ? (site.iaddress ~ 'mod_event/thumb/' ~ ev.image) : '' %}
                {% set ev_url = site.saddress ~ 'event/' ~ ev.seo %}
                <div class="{{ card_col_class }}">
                    <article class="event-card h-100 rounded-3 shadow-sm overflow-hidden d-flex flex-row border">
                        {% if ev_poster is not empty %}
                            <div class="event-card-media position-relative flex-shrink-0">
                                <a href="{{ ev_url }}" class="event-card-link" title="{{ ev.name }}">
                                    <img src="{{ ev_poster }}" alt="{{ ev.name }}" class="event-card-img" loading="lazy" width="200" height="260">
                                </a>
                                <div class="event-card-badge position-absolute top-0 start-0 m-2 rounded text-center p-1">
                                    <span class="d-block fw-bold fs-6 lh-1">{{ ev.start_day }}</span>
                                    <span class="d-block small text-uppercase lh-1 mt-1">{{ ev.start_month_localized }}</span>
                                </div>
                                {% if ev.is_today %}
                                    <span class="badge bg-danger text-white pulse-badge position-absolute bottom-0 start-0 m-2">
                                        {{ lang.index.mod_event.today }}
                                    </span>
                                {% elseif ev.is_tomorrow %}
                                    <span class="badge bg-warning text-dark position-absolute bottom-0 start-0 m-2">
                                        {{ lang.index.mod_event.tomorrow }}
                                    </span>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="event-card-placeholder-wrap position-relative flex-shrink-0 d-flex flex-column align-items-center justify-content-center text-center p-3">
                                <div class="event-card-badge-inline mb-2">
                                    <span class="display-6 fw-bold text-primary lh-1 d-block">{{ ev.start_day }}</span>
                                    <span class="small text-uppercase text-muted fw-bold d-block mt-1">{{ ev.start_month_localized }}</span>
                                </div>
                                {% if ev.is_today %}
                                    <span class="badge bg-danger text-white pulse-badge mt-2">
                                        {{ lang.index.mod_event.today }}
                                    </span>
                                {% elseif ev.is_tomorrow %}
                                    <span class="badge bg-warning text-dark mt-2">
                                        {{ lang.index.mod_event.tomorrow }}
                                    </span>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="event-card-body p-3 d-flex flex-column flex-grow-1 justify-content-between">
                            <div>
                                {% if ev.subject is defined and ev.subject is not empty %}
                                    <span class="event-card-topic small text-primary fw-semibold mb-1 d-inline-block">{{ ev.subject }}</span>
                                {% endif %}
                                <h3 class="event-card-title h6 mb-2">
                                    <a href="{{ ev_url }}" class="text-decoration-none text-reset">{{ ev.name }}</a>
                                </h3>
                                {% if ev.summary is defined and ev.summary is not empty %}
                                    <p class="event-card-summary text-muted small mb-3">{{ ev.summary|length > 130 ? (ev.summary|slice(0, 130) ~ '...') : ev.summary }}</p>
                                {% endif %}
                            </div>
                            <div class="event-card-meta pt-2 border-top small text-muted">
                                <div class="meta-row d-flex flex-wrap align-items-center gap-3 mb-1">
                                    {% if ev.start_date_only is defined and ev.start_date_only is not empty %}
                                        <span><i class="bi bi-calendar3 me-1 text-primary" aria-hidden="true"></i>{{ ev.start_date_only }}</span>
                                    {% endif %}
                                    {% if ev.start_time is defined and ev.start_time is not empty %}
                                        <span><i class="bi bi-clock me-1 text-primary" aria-hidden="true"></i>{{ ev.start_time }}</span>
                                    {% endif %}
                                </div>
                                {% if ev.location is defined and ev.location is not empty %}
                                    <div class="meta-row text-truncate">
                                        <i class="bi bi-geo-alt me-1 text-danger" aria-hidden="true"></i>{{ ev.location }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="event-section-empty-notice rounded-3 py-3 px-3 d-flex align-items-center gap-2 flex-grow-1" role="status">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>{{ lang.index.mod_event.no_category_events_recorded }}</span>
        </div>
    {% endif %}
</section>
