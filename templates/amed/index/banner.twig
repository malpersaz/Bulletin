<div class="row banner">
    <div class="col-md-3">
        <div class="logo-{{ site.lang }}">
            <h1>
                <a href="{{ site.saddress }}" title="{{ lang.index.title }}">
                    <img src="{{ site.iaddress }}{{ site.logo_path }}" alt="{{ lang.index.title }}" />
                </a>
            </h1>
        </div>
        <ul class="socialmedia">
            <li class="twitter">
                <a title="Twitter" href="index.html">Twitter</a>
            </li>
            <li class="facebook">
                <a title="Facebook" href="index.html">Facebook</a>
            </li>
            <li class="google">
                <a title="Google+" href="index.html">Google</a>
            </li>
        </ul>
    </div>
    <div style="width:250; ">
        <div id="sb-search" class="sb-search">
            <form onsubmit="return fsearchbox_submit(this);"
                  method="get"
                  action="{{ site.saddress }}index/search/">
                <input class="sb-search-input"
                       id="query"
                       maxlength="50"
                       placeholder="{{ lang.index.search.searched_word }}"
                       value=""
                       type="text"
                       name="query">
                <input class="sb-search-submit" type="submit" value="">
                <span class="sb-icon-search"></span>
            </form>
        </div>
    </div>
</div>
