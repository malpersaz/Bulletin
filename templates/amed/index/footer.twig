{% macro footer_menu_items(menu, parent_id) %}
	{% import _self as navigation %}
	{% if menu[parent_id] is defined %}
		{% for item in menu[parent_id] %}
			{% if item.id != parent_id and item.lang == site.lang and item.status == 'y' %}
				{% if item.file is defined and item.file != '' %}
				{% elseif item.url == '##' %}
					{{ navigation.footer_menu_items(menu, item.id) }}
				{% else %}
					{% if item.url is empty or item.url == '#' %}
						{% set clean_footer_url = '#' %}
					{% else %}
						{% set clean_footer_url = (item.url starts with 'http://' or item.url starts with 'https://' or item.url starts with '//' or item.url starts with 'mailto:' or item.url starts with 'tel:') ? item.url : (item.url starts with '/' ? item.url : (item.url starts with (site.lang ~ '/') ? site.address ~ item.url : site.saddress ~ item.url)) %}
					{% endif %}
					<li class="mb-2">
						<a href="{{ clean_footer_url }}"{% if item.target == 'y' %} target="_blank" rel="noopener noreferrer"{% endif %} class="text-decoration-none transition-link d-inline-flex align-items-center gap-2">
							{% if item.icon is defined and item.icon != '' %}<i class="{{ item.icon }}" aria-hidden="true"></i>{% endif %}
							<span>{{ item.name }}</span>
						</a>
						{% if menu[item.id] is defined and menu[item.id] is iterable %}
							<ul class="list-unstyled ms-3 mt-2">
								{{ navigation.footer_menu_items(menu, item.id) }}
							</ul>
						{% endif %}
					</li>
				{% endif %}
			{% endif %}
		{% endfor %}
	{% endif %}
{% endmacro %}

{% import _self as footer_navigation %}
{% set footer_menu = ctx_get('menu_footer') %}
{% set footer_menu_root_id = ctx_get('menu_footer_root_id') %}
{% set footer_menu_markup %}
	{% if footer_menu is not empty and footer_menu_root_id is not empty %}
		{{ footer_navigation.footer_menu_items(footer_menu, footer_menu_root_id) }}
	{% endif %}
{% endset %}
{% set has_footer_menu = footer_menu_markup|trim is not empty %}
<footer class="site-footer mt-auto py-5">
	<div class="container">
		<div class="row gy-4">
			<!-- Site Information -->
			<div class="{% if has_footer_menu %}col-md-4 col-lg-4{% else %}col-md-5 col-lg-4{% endif %}">
				{# === Footer Logo Options - 6 modes (Synced with Header) ===========
				   square           -> Only Icon (site_icon), hide site title
				   rectangle        -> Only Horizontal logo (logo_path), hide site title
				   square_name      -> Icon + site title
				   rectangle_name   -> Horizontal logo + site title
				   square_rectangle -> Icon + Horizontal logo (site_icon + logo_path)
				   name_only        -> Site title only, hide logo
				   ================================================================== #}
				{% set logo_type = site.logo_type is defined and site.logo_type is not empty ? site.logo_type : 'rectangle' %}
				{% set show_logo_area = (site.show_logo is not defined or site.show_logo == 'y') and logo_type != 'name_only' %}
				{% set is_square_mode = (logo_type == 'square' or logo_type == 'square_name') %}
				{% set is_dual_mode = (logo_type == 'square_rectangle') %}
				{% set show_site_title = (logo_type == 'square_name' or logo_type == 'rectangle_name' or logo_type == 'name_only') %}

				{% if is_square_mode %}
					{% set active_logo_file = (site.site_icon is defined and site.site_icon is not empty) ? site.site_icon : ((site.favicon_96 is defined and site.favicon_96 is not empty) ? site.favicon_96 : ((site.favicon_path is defined and site.favicon_path is not empty) ? site.favicon_path : null)) %}
				{% elseif is_dual_mode %}
					{% set active_square_file = (site.site_icon is defined and site.site_icon is not empty) ? site.site_icon : ((site.favicon_96 is defined and site.favicon_96 is not empty) ? site.favicon_96 : ((site.favicon_path is defined and site.favicon_path is not empty) ? site.favicon_path : null)) %}
					{% set active_rect_file = (site.logo_path is defined and site.logo_path is not empty) ? site.logo_path : null %}
					{% set active_logo_file = active_square_file is not empty ? active_square_file : active_rect_file %}
				{% else %}
					{% set active_logo_file = (site.logo_path is defined and site.logo_path is not empty) ? site.logo_path : null %}
				{% endif %}

				{% set use_animated = site.use_animated_logo is defined and site.use_animated_logo == 'y' and site.animated_logo_path is defined and site.animated_logo_path is not empty %}
				{% set anim_ext = site.animated_logo_type|default('webm') %}
				{% set anim_mode = site.animated_logo_mode|default('loop') %}
				{% set anim_blend = site.animated_logo_blend|default('multiply') %}
				{% set blend_class = anim_blend == 'multiply' ? 'logo-blend-multiply' : (anim_blend == 'screen' ? 'logo-blend-screen' : '') %}

				{% set has_logo_image = show_logo_area and active_logo_file is not null %}
				{% set has_logo_mark = show_logo_area %}
				{% set raw_site_name = site.site_name|default('')|trim %}
				{% set raw_site_title = site.title|default('')|trim %}
				{% set display_site_name = (raw_site_name is not empty and (raw_site_title is empty or raw_site_name|length <= raw_site_title|length))
					? raw_site_name
					: (raw_site_title is not empty ? raw_site_title : site.name|default('')) %}

				<a class="footer-brand modern-brand logo-mode-{{ logo_type }}{% if not show_logo_area %} brand-title-only{% endif %} d-inline-flex align-items-center mb-3" href="{{ site.saddress }}" title="{{ display_site_name }}" aria-label="{{ display_site_name }}">
					{% if show_logo_area and use_animated %}
						<span class="modern-brand-mark logo-animated-mark logo-transparent {{ blend_class }}">
							{% if anim_ext == 'webm' or anim_ext == 'mp4' %}
								<video
									src="{{ site.iaddress }}mod_settings/{{ site.animated_logo_path }}"
									autoplay
									{% if anim_mode == 'loop' %}loop{% endif %}
									muted
									playsinline
									class="logo-animated-video {{ blend_class }}">
									{% if has_logo_image %}
										<img src="{{ site.iaddress }}mod_settings/thumb/{{ active_logo_file }}" alt="{{ display_site_name }}" class="logo-image {{ blend_class }}">
									{% endif %}
								</video>
							{% elseif anim_ext == 'json' %}
								<lottie-player
									src="{{ site.iaddress }}mod_settings/{{ site.animated_logo_path }}"
									background="transparent"
									speed="1"
									class="logo-animated-lottie {{ blend_class }}"
									{% if anim_mode == 'loop' %}loop{% endif %}
									autoplay>
								</lottie-player>
							{% else %}
								<img
									src="{{ site.iaddress }}mod_settings/{{ site.animated_logo_path }}"
									alt="{{ display_site_name }}"
									class="logo-animated-img {{ blend_class }}">
							{% endif %}
						</span>
					{% elseif is_dual_mode and show_logo_area %}
						{% if active_square_file is not empty %}
							<span class="modern-brand-mark">
								<img
									src="{{ site.address }}r/w-42/h-42/f/mod_settings/thumb/{{ active_square_file }}"
									srcset="{{ site.address }}r/w-42/h-42/f/mod_settings/thumb/{{ active_square_file }} 1x, {{ site.address }}r/w-84/h-84/f/mod_settings/thumb/{{ active_square_file }} 2x"
									alt="{{ display_site_name }}"
									class="logo-image logo-square"
									width="42" height="42"
									loading="lazy" fetchpriority="low" decoding="async">
							</span>
						{% endif %}
						{% if active_rect_file is not empty %}
							<span class="modern-brand-rect-wrap">
								<img
									src="{{ site.address }}r/w-120/h-40/f/mod_settings/thumb/{{ active_rect_file }}"
									srcset="{{ site.address }}r/w-120/h-40/f/mod_settings/thumb/{{ active_rect_file }} 1x, {{ site.address }}r/w-240/h-80/f/mod_settings/thumb/{{ active_rect_file }} 2x"
									alt="{{ display_site_name }}"
									class="logo-image logo-rect"
									width="120" height="40"
									loading="lazy" fetchpriority="low" decoding="async">
							</span>
						{% else %}
							<span class="modern-brand-copy">
								<span class="modern-brand-title">{{ display_site_name }}</span>
							</span>
						{% endif %}
					{% elseif show_logo_area and has_logo_image %}
						<span class="modern-brand-mark">
							<img
								src="{{ site.address }}r/{% if is_square_mode %}w-42/h-42{% else %}w-120/h-40{% endif %}/f/mod_settings/thumb/{{ active_logo_file }}"
								srcset="{{ site.address }}r/{% if is_square_mode %}w-42/h-42{% else %}w-120/h-40{% endif %}/f/mod_settings/thumb/{{ active_logo_file }} 1x, {{ site.address }}r/{% if is_square_mode %}w-84/h-84{% else %}w-240/h-80{% endif %}/f/mod_settings/thumb/{{ active_logo_file }} 2x"
								alt="{{ display_site_name }}"
								class="logo-image {% if is_square_mode %}logo-square{% else %}logo-rect{% endif %}"
								{% if is_square_mode %}width="42" height="42"{% else %}width="120" height="40"{% endif %}
								loading="lazy" fetchpriority="low" decoding="async">
						</span>
					{% elseif show_logo_area %}
						<span class="modern-brand-mark">
							<span class="brand-monogram">{{ display_site_name|slice(0, 1) }}</span>
						</span>
					{% endif %}

					{% if show_site_title or (not has_logo_mark and not is_dual_mode) %}
						<span class="modern-brand-copy">
							<span class="modern-brand-title">{{ display_site_name }}</span>
						</span>
					{% endif %}
				</a>
				<p class="mb-0 opacity-75">{{ site.description }}</p>
                <div class="mt-4 d-flex flex-wrap gap-3 feeds-area">
                    <a href="{{ site.address }}{{ site.lang }}/rss.xml" class="text-decoration-none transition-link d-flex align-items-center gap-2 small opacity-75" target="_blank" rel="noopener noreferrer" title="{{ lang.index.rss_feed }}">
                        <i class="bi bi-rss-fill text-warning"></i> RSS
                    </a>
                    <a href="{{ site.address }}sitemap.xml" class="text-decoration-none transition-link d-flex align-items-center gap-2 small opacity-75" target="_blank" rel="noopener noreferrer" title="{{ lang.index.sitemap }}">
                        <i class="bi bi-diagram-3-fill text-info"></i> {{ lang.index.sitemap }}
                    </a>
                    <a href="{{ site.saddress }}llms.txt" class="text-decoration-none transition-link d-flex align-items-center gap-2 small opacity-75" target="_blank" rel="noopener noreferrer" title="{{ lang.index.llms_index }}">
                        <i class="bi bi-cpu text-primary"></i> llms.txt
                    </a>
                </div>
			</div>
            
			{% if has_footer_menu %}
				<div class="col-md-3 col-lg-3">
					<div class="card contact-card border-0 shadow-sm overflow-hidden rounded-3 h-100">
						<div class="card-body p-4">
							<h3 class="h5 fw-bold mb-3 d-flex align-items-center">
								<i class="bi bi-list-ul me-2 text-primary" aria-hidden="true"></i>
								<span>{{ lang.index.menu.footer_links }}</span>
							</h3>
							<nav aria-label="{{ lang.index.menu.footer_links }}">
								<ul class="list-unstyled mb-0 ps-1">
									{{ footer_menu_markup|raw }}
								</ul>
							</nav>
						</div>
					</div>
				</div>
			{% else %}
				<div class="col-md-1 col-lg-2 d-none d-md-block">
					<!-- Spacer -->
				</div>
			{% endif %}

			<!-- Contact & Social Information -->
			<div class="{% if has_footer_menu %}col-md-5 col-lg-5{% else %}col-md-6 col-lg-6{% endif %}">
                <div class="card contact-card border-0 shadow-sm overflow-hidden rounded-3 h-100">
                    <div class="card-body p-4">
                        <!-- Section: Contact Us -->
                        <div class="mb-4">
                            <h3 class="h5 fw-bold mb-3 d-flex align-items-center">
                                <i class="bi bi-headset me-2 text-primary"></i>
                                {{ lang.index.contact_us }}
                            </h3>
                            <ul class="list-unstyled mb-0 ps-1">
                                <!-- Phone Number -->
                                {% if site.phone is defined and site.phone is not empty and site.phone != '' %}
                                    <li class="mb-3 d-flex align-items-center">
                                        <div class="footer-icon-box me-3 shadow-sm rounded-circle">
                                            <i class="bi bi-phone text-primary"></i>
                                        </div>
                                        <a href="tel:{{ site.phone }}" class="fs-6 fw-medium text-decoration-none transition-link">
                                            {{ site.phone }}
                                        </a>
                                    </li>
                                {% endif %}

                                <!-- WhatsApp Contact -->
                                {% if site.whatsapp is not empty %}
                                    <li class="mb-3 d-flex align-items-center">
                                        <div class="footer-icon-box me-3 shadow-sm rounded-circle">
                                            <i class="bi bi-whatsapp text-success"></i>
                                        </div>
                                        <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" class="text-decoration-none transition-link">
                                            WhatsApp: {{ site.whatsapp }}
                                        </a>
                                    </li>
                                {% endif %}

                                <!-- Email Contact -->
                                {% if site.mail is not empty %}
                                    <li class="mb-3 d-flex align-items-center">
                                        <div class="footer-icon-box me-3 shadow-sm rounded-circle">
                                            <i class="bi bi-envelope text-info"></i>
                                        </div>
                                        <a href="mailto:{{ site.mail }}" class="text-decoration-none transition-link">
                                            {{ site.mail }}
                                        </a>
                                    </li>
                                {% endif %}

                                <!-- Office Address -->
                                {% if site.office_address is not empty %}
                                    <li class="mb-3 d-flex align-items-start">
                                        <div class="footer-icon-box me-3 shadow-sm rounded-circle mt-1">
                                            <i class="bi bi-building text-warning"></i>
                                        </div>
                                        <span class="opacity-75">{{ site.office_address|raw }}</span>
                                    </li>
                                {% endif %}

                                <!-- Business Address -->
                                {% if site.work_address is not empty %}
                                    <li class="mb-0 d-flex align-items-start">
                                        <div class="footer-icon-box me-3 shadow-sm rounded-circle mt-1">
                                            <i class="bi bi-geo-alt-fill text-danger"></i>
                                        </div>
                                        <span class="opacity-75">{{ site.work_address|raw }}</span>
                                    </li>
                                {% endif %}
                            </ul>
                        </div>

                        <!-- Section: Follow Us -->
                        {% if site.social_links is not empty %}
                            <div class="pt-4 border-top">
                                <h3 class="h5 fw-bold mb-3 d-flex align-items-center">
                                    <i class="bi bi-share me-2 text-primary"></i>
                                    {{ lang.index.follow_us }}
                                </h3>
                                <div class="d-flex gap-2 ps-1">
                                    {% for link in site.social_links %}
                                        {% if link.url|trim is not empty %}
                                            <a href="{{ link.url }}" class="btn btn-light btn-sm rounded-circle social-icon-btn shadow-sm" target="_blank" title="{{ link.platform|capitalize }}">
                                                <i class="{{ link.icon_class }}"></i>
                                            </a>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
			</div>
		</div>

		<!-- Google Maps Section -->
		{% if site.map_embed_code is not empty %}
			<div class="row mt-4">
				<div class="col-12">
                    <div class="card map-card border-0 shadow-sm overflow-hidden rounded-3">
                        <div class="card-body p-4">
                            <h3 class="h5 fw-bold mb-3 d-flex align-items-center">
                                <i class="bi bi-map-fill me-2 text-primary"></i>
                                {{ lang.index.find_us }}
                            </h3>
                            <div class="map-container map-embed-wrapper rounded border shadow-sm">
                                {{ site.map_embed_code|raw }}
                            </div>
                        </div>
                    </div>
				</div>
			</div>
		{% endif %}

		<!-- Legal & Policy Links -->
		<div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 gap-md-3 pt-4 mt-4 border-top footer-policies-area small opacity-75">
			<a href="{{ site.saddress }}legal" class="text-decoration-none transition-link">
				{{ lang.index.legal_info }}
			</a>
			{% if site.lang == 'tr' %}
				<span class="opacity-25 d-none d-sm-inline">&bull;</span>
				<a href="{{ site.saddress }}page/Yayın_İlkeleri" class="text-decoration-none transition-link">
					Yayın İlkeleri
				</a>
				<span class="opacity-25 d-none d-sm-inline">&bull;</span>
				<a href="{{ site.saddress }}page/Basın_Etiği_ve_Uyum" class="text-decoration-none transition-link">
					Basın Etiği
				</a>
				<span class="opacity-25 d-none d-sm-inline">&bull;</span>
				<a href="{{ site.saddress }}page/Doğrulama_ve_Teyit_Politikası" class="text-decoration-none transition-link">
					Doğrulama ve Teyit
				</a>
				<span class="opacity-25 d-none d-sm-inline">&bull;</span>
				<a href="{{ site.saddress }}page/Düzeltme_ve_Tekzip_Politikası" class="text-decoration-none transition-link">
					Düzeltme ve Tekzip
				</a>
				<span class="opacity-25 d-none d-sm-inline">&bull;</span>
				<a href="{{ site.saddress }}page/Mülkiyet_ve_Finansman_Yapısı" class="text-decoration-none transition-link">
					Mülkiyet ve Finansman
				</a>
			{% endif %}
			<span class="opacity-25 d-none d-sm-inline">&bull;</span>
			<a href="{{ site.saddress }}cookie-policy" class="text-decoration-none transition-link" rel="nofollow">
				{{ lang.index.cookie_policy }}
			</a>
		</div>

		<!-- Copyright -->
		<div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-4 mt-5 border-top copyright-section small">
			<p class="mb-2 mb-md-0">
                &copy; {{ site.established_year }} - {{ "now"|date("Y") }} 
                <strong>{{ site.owner_name }}</strong>. 
                {{ lang.index.copyright }}
            </p>
			<div class="text-md-end text-secondary">
                {% if site.build is defined and site.build %}
                    <span class="me-2 footer-version-text">{{ site.build }}</span>
                {% endif %}
                {% if site.version is defined and site.version %}
                    <span class="ms-1 footer-version-text">v{{ site.version }}</span>
                {% endif %}
			</div>
		</div>
	</div>
</footer>

