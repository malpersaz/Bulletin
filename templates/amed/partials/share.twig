<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/share.css?v={{ site.version }}-20261113b">

{% set target_url = share_url is defined and share_url ? share_url : (d.seo is defined and d.seo ? site.saddress ~ (share_url_path|default('article')) ~ '/' ~ d.seo : site.saddress) %}
{% set target_title = share_title is defined and share_title ? share_title : (d.name|default(d.title|default(site.name))) %}

<div class="social-share d-print-none {{ share_wrap_class|default('my-3') }}">
    <div class="share-container share-popover-wrapper {{ share_container_class|default('') }}">
        <button
            type="button"
            class="social-share-btn share-trigger-btn"
            aria-label="{{ lang.index.share }}"
            aria-expanded="false"
            aria-haspopup="true"
            title="{{ lang.index.share }}"
        >
            <i class="bi bi-share" aria-hidden="true"></i>
        </button>

        <div class="share-popover-menu" role="region" aria-label="{{ lang.index.share }}" hidden>
            {% include 'partials/_share_items.twig' with {
                'target_url': target_url,
                'target_title': target_title,
                'list_class': 'share-popover-icons'
            } %}
        </div>
    </div>
</div>

<script src="{{ site.taddress }}{{ site.app_template }}/static/js/share.js?v={{ site.version }}-20261113b"></script>
