{#
    Canonical Social Media Share Items List
    Params:
      - target_url: string
      - target_title: string
      - list_class: string (optional, default: 'd-flex gap-2 flex-wrap')
#}
<div class="share-buttons-list {{ list_class|default('d-flex gap-2 flex-wrap') }}">
    {# Facebook #}
    <a href="https://www.facebook.com/sharer/sharer.php?u={{ target_url|url_encode }}" target="_blank" rel="noopener noreferrer" class="social-share-btn btn-facebook" aria-label="Facebook" data-bs-toggle="tooltip" data-bs-placement="top" title="Facebook">
        <i class="bi bi-facebook" aria-hidden="true"></i>
    </a>

    {# X (Twitter) #}
    <a href="https://twitter.com/intent/tweet?text={{ target_title|url_encode }}&url={{ target_url }}" target="_blank" rel="noopener noreferrer" class="social-share-btn btn-twitter" aria-label="X (Twitter)" data-bs-toggle="tooltip" data-bs-placement="top" title="X (Twitter)">
        <i class="bi bi-twitter-x" aria-hidden="true"></i>
    </a>

    {# WhatsApp #}
    <a href="https://api.whatsapp.com/send?text={{ target_title|url_encode }}%0A{{ target_url }}" target="_blank" rel="noopener noreferrer" class="social-share-btn btn-whatsapp" aria-label="WhatsApp" data-bs-toggle="tooltip" data-bs-placement="top" title="WhatsApp">
        <i class="bi bi-whatsapp" aria-hidden="true"></i>
    </a>

    {# TikTok #}
    <button type="button" class="social-share-btn btn-tiktok border-0" aria-label="TikTok" data-bs-toggle="tooltip" data-bs-placement="top" title="TikTok" data-share-network="tiktok" data-share-title="{{ target_title|escape('html_attr') }}" data-share-url="{{ target_url }}" data-copied-text="{{ lang.index.link_copied }}">
        <i class="bi bi-tiktok" aria-hidden="true"></i>
    </button>

    {# LinkedIn #}
    <a href="https://www.linkedin.com/shareArticle?mini=true&url={{ target_url }}&title={{ target_title|url_encode }}" target="_blank" rel="noopener noreferrer" class="social-share-btn btn-linkedin" aria-label="LinkedIn" data-bs-toggle="tooltip" data-bs-placement="top" title="LinkedIn">
        <i class="bi bi-linkedin" aria-hidden="true"></i>
    </a>

    {# Email #}
    <a href="mailto:?subject={{ target_title|url_encode }}&body={{ target_url }}" class="social-share-btn btn-email" aria-label="Email" data-bs-toggle="tooltip" data-bs-placement="top" title="Email">
        <i class="bi bi-envelope" aria-hidden="true"></i>
    </a>

    {# Copy Link #}
    <button type="button" class="social-share-btn btn-copy border-0" aria-label="{{ lang.index.copy_link }}" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ lang.index.copy_link }}" data-copy-url="{{ target_url }}" data-copied-text="{{ lang.index.link_copied }}" data-original-text="{{ lang.index.copy_link }}">
        <i class="bi bi-link-45deg fs-5" aria-hidden="true"></i>
    </button>
</div>
