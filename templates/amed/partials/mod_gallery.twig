    {# Gallery carousel - Updated to Swiper #}
    {% if mod_gallery is defined and mod_gallery == 'y' %}
        <script>
        // Modern Swiper Carousel implementation
        if (document.querySelector('#mod_gallery .swiper')) {
            new Swiper('#mod_gallery .swiper', {
                loop: true,
                autoplay: {
                    delay: 3000,
                    disableOnInteraction: false,
                },
                slidesPerView: 4,
                spaceBetween: 20,
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
                navigation: {
                    nextEl: '.swiper-button-next',
                    prevEl: '.swiper-button-prev',
                },
                breakpoints: {
                    1199: { slidesPerView: 4 },
                    979: { slidesPerView: 3 },
                    768: { slidesPerView: 2 },
                    576: { slidesPerView: 1 }
                }
            });
        }
        </script>
    {% endif %}