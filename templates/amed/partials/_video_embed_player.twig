{#
  _video_embed_player.twig
  Shared Multi-Provider Facade Video Player
  Supports X (Twitter), YouTube, Vimeo, and HTML5 video.
  Complies strictly with AGENTS.md Rule 1 (Zero Inline CSS/JS) and RTL BDI.
#}
{% set vid = video|default(v|default(d)) %}
{% set is_hero_player = is_hero is defined and is_hero %}
{% if vid is defined and vid is not empty %}
    {% set is_yt = (vid.is_youtube is defined and vid.is_youtube)
        or (vid.provider is defined and vid.provider == 'youtube')
        or ('youtube' in (vid.embed_src|default('')|lower))
        or ('youtube' in (vid.embed|default('')|lower))
        or ('youtu.be' in (vid.original|default('')|lower)) %}
    {% set is_x_vid = (vid.is_x is defined and vid.is_x)
        or (vid.provider is defined and vid.provider == 'x')
        or ('platform.twitter.com' in (vid.embed_src|default('')|lower)) %}
    {% set is_fb = (vid.is_facebook is defined and vid.is_facebook)
        or (vid.provider is defined and vid.provider == 'facebook')
        or ('facebook.com' in (vid.embed_src|default('')|lower))
        or ('fb.watch' in (vid.original|default('')|lower)) %}
    {% set aspect_cls = 'video-embed-stage--16x9' %}
    {% if vid.aspect_ratio is defined and vid.aspect_ratio == '4:3' %}
        {% set aspect_cls = 'video-embed-stage--4x3' %}
    {% elseif vid.aspect_ratio is defined and vid.aspect_ratio == '1:1' %}
        {% set aspect_cls = 'video-embed-stage--1x1' %}
    {% elseif (vid.aspect_ratio is defined and vid.aspect_ratio == '9:16') or (vid.is_vertical is defined and vid.is_vertical) %}
        {% set aspect_cls = 'video-embed-stage--vertical' %}
    {% endif %}

    {% if is_hero_player %}
        {% if vid.hero_poster_url is defined and vid.hero_poster_url is not empty %}
            {% set poster = vid.hero_poster_url %}
        {% elseif vid.poster_url is defined and vid.poster_url is not empty %}
            {% set poster = vid.poster_url %}
        {% elseif vid.image is defined and vid.image is not empty %}
            {% set poster = site.iaddress ~ 'mod_video_embed/' ~ vid.image %}
        {% else %}
            {% set poster = '' %}
        {% endif %}
    {% else %}
        {% set poster = vid.poster_url|default(vid.image is defined and vid.image is not empty ? (site.iaddress ~ 'mod_video_embed/thumb/' ~ vid.image) : '') %}
    {% endif %}

    {% set figure_cls = is_hero_player ? 'video-embed-figure video-embed-figure--hero' : 'video-embed-figure mb-4' %}
    {% set caption_cls = is_hero_player ? 'video-embed-caption video-embed-caption--hero d-flex flex-wrap justify-content-between align-items-center gap-2' : 'video-embed-caption mt-2 d-flex flex-wrap justify-content-between align-items-center gap-2' %}
    {% set provider_name = vid.provider|default(is_x_vid ? 'x' : (is_fb ? 'facebook' : 'youtube')) %}
    {% set load_label = is_x_vid ? lang.index.mod_video_embed.load_x_video : (is_fb ? lang.index.mod_video_embed.load_facebook_video : lang.index.mod_video_embed.load_video) %}
    {% set source_href = vid.canonical_url|default(vid.original|default('')) %}

    <figure class="{{ figure_cls }}" data-video-figure>
        <div class="video-embed-stage {{ aspect_cls }}{% if is_x_vid %} video-embed-stage--x{% elseif is_fb %} video-embed-stage--facebook{% endif %}"
             data-video-embed-facade
             data-provider="{{ provider_name }}"
             data-aspect-ratio="{{ vid.aspect_ratio|default('16:9') }}"
             data-embed-src="{{ vid.embed_src|default('')|e('html_attr') }}"
             data-title="{{ vid.name|default('')|e('html_attr') }}">
            <div class="video-embed-facade" role="button" tabindex="0" aria-label="{{ load_label }}: {{ vid.name|default('')|e('html_attr') }}">
                {% if poster is not empty %}
                    {% if is_hero_player %}
                        <img src="{{ poster }}"
                             alt="{{ vid.name|default('')|e('html_attr') }}"
                             class="video-embed-poster"
                             fetchpriority="high"
                             width="1280"
                             height="720">
                    {% else %}
                        <img src="{{ poster }}"
                             alt="{{ vid.name|default('')|e('html_attr') }}"
                             class="video-embed-poster"
                             loading="lazy"
                             decoding="async"
                             width="640"
                             height="360">
                    {% endif %}
                {% else %}
                    <div class="video-embed-poster-placeholder">
                        <i class="bi bi-camera-reels" aria-hidden="true"></i>
                    </div>
                {% endif %}
                <div class="video-embed-overlay" aria-hidden="true"></div>
                <div class="video-embed-badges">
                    {% if is_x_vid %}
                        <span class="video-embed-badge badge-x">
                            <i class="bi bi-twitter-x" aria-hidden="true"></i>
                            {% if vid.author_handle is defined and vid.author_handle is not empty %}
                                <bdi dir="ltr" class="ms-1">@{{ vid.author_handle }}</bdi>
                            {% else %}
                                <span class="visually-hidden">X</span>
                            {% endif %}
                        </span>
                    {% elseif is_fb %}
                        <span class="video-embed-badge badge-facebook">
                            <i class="bi bi-facebook me-1" aria-hidden="true"></i><span>Facebook</span>
                        </span>
                    {% elseif is_yt %}
                        <span class="video-embed-badge badge-youtube">
                            <i class="bi bi-youtube me-1" aria-hidden="true"></i><span>YouTube</span>
                        </span>
                    {% endif %}
                    {% if vid.duration is defined and vid.duration is not empty and vid.duration != '00:00' %}
                        <span class="video-embed-badge badge-duration">
                            <i class="bi bi-clock-fill me-1" aria-hidden="true"></i><span>{{ vid.duration }}</span>
                        </span>
                    {% endif %}
                </div>
                <button type="button" class="video-embed-play-btn" aria-hidden="true" tabindex="-1">
                    <i class="bi bi-play-fill"></i>
                </button>
            </div>
            <noscript>
                {% if vid.embed_html is defined and vid.embed_html is not empty %}
                    {{ vid.embed_html|raw }}
                {% elseif vid.embed is defined and vid.embed is not empty %}
                    {{ vid.embed|raw }}
                {% else %}
                    <a href="{{ source_href ?: '#' }}" class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer">
                        {{ lang.index.mod_video_embed.view_original_source }}
                    </a>
                {% endif %}
            </noscript>
        </div>
        {% if not is_yt %}
            <figcaption class="{{ caption_cls }}">
                <span class="video-embed-attribution">
                    <span class="text-muted">{{ lang.index.mod_video_embed.source_attribution }}:</span>
                    {% if source_href is not empty %}
                        <a href="{{ source_href }}" target="_blank" rel="noopener noreferrer" class="fw-semibold">
                            <bdi dir="ltr">{% if vid.author_handle is defined and vid.author_handle is not empty %}@{{ vid.author_handle }}{% elseif is_x_vid %}X (Twitter){% elseif is_fb %}Facebook{% else %}{{ vid.name }}{% endif %}</bdi>
                        </a>
                    {% else %}
                        <span class="fw-semibold">{{ is_x_vid ? 'X (Twitter)' : (is_fb ? 'Facebook' : site.title) }}</span>
                    {% endif %}
                </span>
                <small class="video-embed-notice text-muted">
                    {{ is_x_vid ? lang.index.mod_video_embed.external_media_notice_x : (is_fb ? lang.index.mod_video_embed.external_media_notice_facebook : lang.index.mod_video_embed.external_media_notice_youtube) }}
                </small>
            </figcaption>
        {% endif %}
    </figure>
{% endif %}
