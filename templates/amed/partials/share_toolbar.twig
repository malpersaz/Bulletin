{#
    Social Share & Action Toolbar Component
    Params:
      - share_url_path: string (e.g. 'announcement', 'news', 'publication', 'page')
      - share_url: string (optional explicit URL)
      - share_title: string (optional explicit title)
      - mod_name: string (e.g. 'mod_announcements', 'mod_news', 'mod_publication', 'mod_page', 'mod_imagecategories')
      - item_id: int/string (record ID)
      - show_tools: bool (default true if mod_name and item_id provided)
      - show_share: bool (default true)
      - has_gallery: bool (whether to show download all images)
      - share_wrap_class: string (optional wrapper class)
#}
{% set target_url = share_url|default(d.seo ? (site.saddress ~ (share_url_path|default('article')) ~ '/' ~ d.seo) : (site.canonical_url|default(site.saddress))) %}
{% set target_title = share_title|default(d.name|default(d.title|default(site.name))) %}
{% set target_mod = mod_name|default('') %}
{% set target_id = item_id|default(d.id|default(null)) %}
{% set can_show_tools = show_tools|default(true) and target_mod is not empty and target_id is not empty %}
{% set can_show_share = show_share|default(true) %}

<link rel="stylesheet" href="{{ site.taddress }}{{ site.app_template }}/static/css/share.css?v={{ site.version }}-20261113b">

<div class="share-toolbar-wrapper d-print-none {{ share_wrap_class|default('') }}">
    {% if can_show_share %}
    <div class="share-toolbar-heading">
        <span class="share-toolbar-title">
            <i class="bi bi-share me-1"></i>{{ lang.index.share }}
        </span>
    </div>
    {% endif %}

    <div class="share-toolbar">
        {% if can_show_share %}
        <div class="share-toolbar-section">
            <button type="button" class="social-share-btn btn-native-share" title="{{ lang.index.share }}" aria-label="{{ lang.index.share }}" data-share-title="{{ target_title|escape('html_attr') }}" data-share-url="{{ target_url }}">
                <i class="bi bi-share"></i>
            </button>

            {% include 'partials/_share_items.twig' with {
                'target_url': target_url,
                'target_title': target_title,
                'list_class': 'd-flex gap-2 flex-wrap'
            } %}
        </div>
        {% endif %}

        {% if can_show_tools %}
        <div class="share-toolbar-section share-toolbar-tools">
            <a href="{{ site.saddress }}tools/saveHtml/{{ target_mod }}/{{ target_id }}" class="tool-action-btn btn-tool-html" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ lang.index.mod_gallery.save_html }}" aria-label="{{ lang.index.mod_gallery.save_html }}">
                <i class="bi bi-file-earmark-arrow-down"></i>
            </a>
            <a href="{{ site.saddress }}tools/saveText/{{ target_mod }}/{{ target_id }}" class="tool-action-btn btn-tool-text" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ lang.index.mod_gallery.save_txt }}" aria-label="{{ lang.index.mod_gallery.save_txt }}">
                <i class="bi bi-file-text"></i>
            </a>
            {% if has_gallery|default(false) %}
            <a href="{{ site.saddress }}tools/saveAll/{{ target_mod }}/{{ target_id }}" class="tool-action-btn btn-tool-zip" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ lang.index.mod_gallery.save_images }}" aria-label="{{ lang.index.mod_gallery.save_images }}">
                <i class="bi bi-images"></i>
            </a>
            {% endif %}
            <button type="button" data-action="print" class="tool-action-btn btn-tool-print border-0" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ lang.index.mod_gallery.print }}" aria-label="{{ lang.index.mod_gallery.print }}">
                <i class="bi bi-printer"></i>
            </button>
        </div>
        {% endif %}
    </div>
</div>

<script src="{{ site.taddress }}{{ site.app_template }}/static/js/share.js?v={{ site.version }}-20261113b"></script>
