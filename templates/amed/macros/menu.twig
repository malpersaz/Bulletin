{# Menu Function - Usable across all templates #}
{% macro renderMenu(menu, arg_parent_id, ss, level = 0) %}
    {% if menu[arg_parent_id] is defined %}
        {% for m in menu[arg_parent_id] %}
            {% if m.id != arg_parent_id and level < 20 %}
            {% set parent_id = m.id %}
            {% if m.file != '' %}
                {# Block system removed - file include disabled: {{ m.file }} #}
            {% else %}
            {# If url is ##, it indicates root container menu #}
            {% if m.url == '##' %}
                {{ _self.renderMenu(menu, parent_id, ss) }}
            {% elseif m.lang == site.lang and m.status == 'y' %}
                    {% set ss = 1 %}
                    <li class="nav-item{% if menu[parent_id] is defined and menu[parent_id] is iterable %} dropdown{% endif %}">
                        <a class="nav-link{% if menu[parent_id] is defined and menu[parent_id] is iterable %} dropdown-toggle{% endif %}"
                           {% if m.url == '' or m.url == '#' %}
                               href="javascript:void(0);"
                           {% else %}
                               {% set clean_menu_url = (m.url starts with 'http://' or m.url starts with 'https://' or m.url starts with '//') ? m.url : (m.url starts with '/' ? m.url : site.address ~ m.url) %}
                               href="{{ clean_menu_url }}"{% if m.target == 'y' %} target="_blank"{% endif %}
                           {% endif %}
                           {% if menu[parent_id] is defined and menu[parent_id] is iterable %}
                               data-bs-toggle="dropdown" role="button"
                           {% endif %}>
                            {% if m.icon is defined and m.icon != '' %}<i class="{{ m.icon }} me-1"></i>{% endif %}
                            {{ m.name }}
                        </a>

                        {% if menu[parent_id] is defined and menu[parent_id] is iterable %}
                            {% if ss == '1' %}
                                <ul class="dropdown-menu">{% endif %}
                            {{ _self.renderMenu(menu, parent_id, ss, level + 1) }}
                            {% if ss == '1' %}</ul>{% endif %}
                        {% endif %}
                    </li>
            {% endif %}
            {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}