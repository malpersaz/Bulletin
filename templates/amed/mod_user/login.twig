{% extends "layouts/base.twig" %}


{% block title %}
<title>{{ lang.index.modal.login }} - {{ site.title }}</title>
{% endblock %}

{% block canonical %}
    <link rel="canonical" href="{{ site.saddress }}login" />
{% endblock %}
{% block hreflang %}
    <link rel="alternate" hreflang="{{ site.lang }}" href="{{ site.saddress }}login"/>
    <link rel="alternate" hreflang="x-default" href="{{ site.saddress }}login"/>
{% endblock %}

{% block head %}
    <meta name="robots" content="noindex, nofollow, noarchive">
{% endblock %}

{% block js_custom %}
    <script src="{{ site.taddress }}{{ site.app_template }}/static/js/login.js?v={{ site.version }}" defer></script>
{% endblock %}

{% block content %}
{% set error = ctx_get('error') %}
{% set mesaj = ctx_get('mesaj') %}
{% set errors = ctx_get('errors') %}
{% set username = ctx_get('username') %}
{% set password = ctx_get('password') %}
{% set forgot_password_label = lang.mod_user.forgot_password is iterable ? lang.mod_user.forgot_password.forgot_password_title : lang.mod_user.forgot_password %}
{% set account_activation_label = lang.mod_user.account_activation %}
{% set register_label = lang.mod_user.register is iterable ? lang.mod_user.register.register_button : lang.mod_user.register %}


<!-- START: mod_user/login.twig -->
<div class="row justify-content-center" id="mod_user">
    <div class="col-md-6 col-lg-4">
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-box-arrow-in-right me-2"></i>{{ lang.index.modal.login }}
                </h5>
            </div>
            <div class="card-body">
                {% if ctx_get('oke') is not empty %}
                    <div class="alert alert-success" role="alert">
                        {{ mesaj }}
                    </div>
                {% elseif error %}
                    <div class="alert alert-danger" role="alert">
                        {{ mesaj }}
                    </div>
                {% else %}
                    {% if errors is not empty %}
                        <div class="alert alert-danger" role="alert">
                            <ul class="mb-0">
                                {% for error in errors %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    <div id="login-alerts"></div>

                    <form method="post" action="{{ site.saddress }}login" id="login-form" data-login-url="{{ site.saddress }}login" data-redirect-url="{{ site.saddress }}" data-connection-error="{{ lang.mod_user.ajax.connection_error }}">
                            <div class="mb-3">
                                <label class="form-label" for="username">{{ lang.mod_user.username }}</label>
                                <input type="text"
                                       name="username"
                                       id="username"
                                       class="form-control"
                                       value="{{ username }}"
                                       placeholder="{{ lang.mod_user.username }}"
                                       required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="password">{{ lang.mod_user.password }}</label>
                                <input type="password"
                                       name="password"
                                       id="password"
                                       class="form-control"
                                       value="{{ password }}"
                                       placeholder="{{ lang.mod_user.password }}"
                                       required>
                            </div>

                            <div class="d-grid">
                                <button type="button" name="login" id="manual-submit-button" class="btn btn-primary">
                                    {{ lang.mod_user.login }}
                                </button>
                            </div>
                        </form>

                    <hr>
                    <div class="text-center">
                        <a href="{{ site.saddress }}forgot-password" class="btn btn-link p-0">{{ forgot_password_label }}</a>
                        <span class="mx-2">|</span>
                        <a href="{{ site.saddress }}activation" class="btn btn-link p-0">{{ account_activation_label }}</a>
                        <span class="mx-2">|</span>
                        <a href="{{ site.saddress }}register" class="btn btn-link p-0">{{ register_label }}</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
<!-- END: mod_user/login.twig -->
{% endblock %}
