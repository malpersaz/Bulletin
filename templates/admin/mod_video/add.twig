{% extends "management/admin-layout.twig" %}
{% block extra %}
	<script>
		function donustur() {
var video = $('#d_video').val();

var cevriliyor = $.achtung({
className: 'achtungWait',
message: '{{ lang.mod_video.converting }}',
icon: 'wait-icon',
timeout: 0,
disableClose: true
});

$.ajax({
type: "POST",
url: "{{ site.sadres }}mod_video/cevir",
data: {
video: video
},
success: function (msg) {
msg = jQuery.parseJSON(msg);

if (msg.hata) {
$.achtung({className: 'achtungFail', message: msg.mesaj, timeout: 10});
cevriliyor.achtung('close');
return false;

}


if (msg.oke) {
$.achtung({className: 'achtungSuccess', message: msg.mesaj, timeout: 10});
cevriliyor.achtung('close');

$('#donustur').hide('fast');
$('#addme').show('fast');
$('#vdata').show('fast');

$('#flv').val(msg.video_dosya);
$('#image').val(msg.image_dosya);
$('#sure').val(msg.video_sure);
$('#video_original').val(msg.video_original);

var r = '{{ site.sadres }}cache/video_tmp/' + msg.image_dosya;
var f = '{{ site.sadres }}cache/video_tmp/' + msg.video_dosya;

$('#vresim').attr('src', r);
// var html = '<embed src="{{ site.adres }}base_static/swf/player.swf?file=' + f + '&image=' + r + '" quality="high" bgcolor="#000000" width="512" height="320" name="mymovie" align="middle" allowFullScreen="true" allowScriptAccess="sameDomain" type="application/x-shockwave-flash" pluginspage="http://www.adobe.com/go/getflashplayer" />';
var html = '<video id="video2" class="video-js vjs-default-skin vjs-big-play-centered" controls preload="auto" width="320" height="240" poster="' + r + '" data-setup=\'{"example_option":true}\'><source src="' + f + '" type="video/mp4" /></video>';
$('#vflv').html(html);
$('#vsure').html(msg.video_sure);
// console.log("Resim :"+r);
// console.log("FLV :"+f);
// console.log("Embed:"+html);


return true;
}


}
});
}
	</script>
	<script>
		$(document).ready(function () {
$("#add").validationEngine();

function temizle(veri) {

var temiz = veri.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, " ");
temiz = temiz.replace(/^\s+|\s+$/g, "");

for (i = 0; i <= 15; i ++) {
temiz = temiz.replace('  ', ' ');
}
return temiz;
}

// SEO YAPAR
function make_seo(name, seo) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, "_");
deger = deger.replace('İ', 'i');

$("#" + seo).val(deger);
});
}

// Make keywords
function make_keywords(name, keywords) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, ",");
deger = deger.toLowerCase();
deger = deger.replace('İ', 'i');

$("#" + keywords).val(deger);
});
}

// Make Title
function make_title(name, title) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + title).val(deger);
});
}

// Make Açıklama
function make_aciklama(name, description) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + description).val(deger);
});
}

// Make Preview
function make_preview(name) {
$("#" + name).change(function () {
$("#" + name + "_preview").html($("#" + name).val());
});
}

var simdi = new Date();
var yil = simdi.getFullYear();
var ay = (simdi.getMonth() < 9 ? '0' : '') + (simdi.getMonth() + 1);
var gun = (simdi.getDate() < 10 ? '0' : '') + simdi.getDate();
var saat = (simdi.getHours() < 10 ? '0' : '') + simdi.getHours();
var dakika = (simdi.getMinutes() < 10 ? '0' : '') + simdi.getMinutes();

var now = yil + "-" + ay + "-" + gun + " " + saat + ":" + dakika;

if ($("#created_at").val() == "") {
$("#created_at").val(now);
}

AnyTime.picker("created_at", {
format: "%z-%m-%d %H:%i",
firstDOW: 1,
placement: "popup",
labelDayOfMonth: "{{ lang.mod_video.date_picker.labels.day_of_month }}",
labelHour: "{{ lang.mod_video.date_picker.labels.hour }}",
labelMinute: "{{ lang.mod_video.date_picker.labels.minute }}",
labelMonth: "{{ lang.mod_video.date_picker.labels.month }}",
labelTitle: "{{ lang.mod_video.date_picker.labels.title }}",
labelYear: "{{ lang.mod_video.date_picker.labels.year }}",
dayAbbreviations: {{ lang.mod_video.date_picker.days_short | json_encode | raw }},
dayNames: {{ lang.mod_video.date_picker.days | json_encode | raw }},
monthAbbreviations: {{ lang.mod_video.date_picker.months_short | json_encode | raw }},
monthNames: {{ lang.mod_video.date_picker.months | json_encode | raw }}
});


$('#video').uploadify({
'uploader': 'base_static/js/uploadify/uploadify.swf',
'script': '{{ site.sadres }}mod_video/up',
'cancelImg': 'base_static/js/uploadify/cancel.png',
'fileExt': '*.mov;*.mpeg;*.mpg;*.wmv;*.mp4;*.avi;*.flv;*.MOV;*.MPEG;*.MPG;*.WMV;*.MP4;*.AVI;*.FLV',
'fileDesc': '{{ lang.mod_video.uploadify.file_desc }}',
'onSelect': function (event, ID, fileObj) {
$('#yukle').show('fast');
},
'scriptData': {
'sid': '{{ session.sid }}'
},
'onCancel': function (event, ID, fileObj, data) {
$('#yukle').hide('fast');
},
'onComplete': function (a, b, c, d, e) { /*	console.log("a"+a+"\n");
                     console.log("b"+b+"\n");
                     console.log("c"+c+"\n");
                     console.log("d"+d+"\n");
                     console.log("e"+e+"\n");*/

try {
var d = jQuery.parseJSON(d);
} catch (e) {
alert("{{ lang.mod_video.uploadify.server_error }}" + d);
return false;
}


if (d.hata) {
$.achtung({className: 'achtungFail', message: d.mesaj, timeout: 10});
$('#yukle').hide('fast');
return false;
}
if (d.oke) {

$.achtung({className: 'achtungSuccess', message: d.mesaj, timeout: 5});

$('#alan').hide('fast');

$('#yukle').hide('fast');

$('#d_video').val(d.file);

$('#donustur').show('fast');
return false;
}


}
});
});
	</script>
{% endblock %}
{% block title %}
	{{ lang.mod_video.add }}
{% endblock %}
{% block body %}
	{% if error is defined %}
		<div class="alert alert-danger">
			<strong>{{ lang.mod_video.error }}</strong>
			{{ mesaj }}
		</div>
	{% else %}
		<div class="portlet box green">
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-edit"></i>
					{{ lang.mod_video.add }}
				</div>
			</div>
			<div
				class="portlet-body form">
				<!--  Mesajlar -->
				{% if oke is defined %}
					<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
					<div class="alert alert-success">
						<strong>{{ lang.mod_video.oke }}</strong>
						{{ mesaj }}
					</div>
					<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
				{% else %}
					{% if hatalar is defined %}
						<!--[if !IE]>Hata Mesajı Varsa<![endif]-->
						{% for hata in hatalar %}
							<div class="alert alert-danger">
								<strong>{{ lang.mod_video.hata }}</strong>
								{{ hata }}
							</div>
						{% endfor %}
						<!--[if !IE]>Hata Mesajı Varsa<![endif]-->
					{% endif %}
					<form method="POST" action="" id="add" enctype="multipart/form-data" class="form-horizontal">
						<div class="form-body">
							<!-- İnputlar Başlar -->
							<!--[if !IE]>lang Input Başlar<![endif]-->
								<div class="form-group"> <label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.lang }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge validate[required]" name="lang" id="lang">
											{% for item in lang_lang %}
												<option value="{{ item.seo }}">{{ item.name }}</option>
											{% endfor %}
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>lang Input Biter<![endif]-->
							<!--[if !IE]>acl_id Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.acl_id | raw }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge validate[required]" name="acl_id" id="acl_id">
											<option value="0" selected="selected">{{ lang.mod_video.choose_wish }}</option>
											{% for item in mod_acl_acl_id %}
												<option value="{{ item.id }}">{{ item.name }}</option>
											{% endfor %}
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>acl_id Input Biter<![endif]-->
							<!--[if !IE]>name Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.name }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge validate[required,length[2,255]]" name="name" value="{{ name }}" type="text" id="name">
									</div>
								</div>
							</div>
							<!--[if !IE]>name Input Biter<![endif]-->
							<!--[if !IE]>created_at Timestamp Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.created_at }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge validate[required]" name="created_at" value="{{ created_at }}" type="text" id="created_at">
									</div>
								</div>
							</div>
							<!--[if !IE]>created_at Timestamp Input Biter<![endif]-->
							<!--[if !IE]>status Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.status }}
									:</label>
								<div class="col-md-4">
									<div class="radio-list">
										<label class="radio-inline">
											{{ lang.mod_video.admin.radio.publish_yes }}
											<input name="status" value="y" type="radio" checked="checked"/>
										</label>
										<label class="radio-inline">
											{{ lang.mod_video.admin.radio.publish_no }}
											<input name="status" value="n" type="radio"/>
										</label>
									</div>
								</div>
							</div>
							<!--[if !IE]>status Input Biter<![endif]-->
							<!--[if !IE]>add_uzak Radio Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_video.add_uzak }}
									:</label>
								<div class="col-md-4">
									<div class="radio-list">
										<label class="radio-inline">
											{{ lang.mod_video.admin.radio.publish_yes }}
											<input name="add_uzak" value="y" class="radio" type="radio" checked="checked"/>
										</label>
										{{ lang.mod_video.admin.radio.publish_no }}
										<label class="radio-inline">
											<input name="add_uzak" value="n" class="radio" type="radio"/>
										</label>
									</div>
								</div>
							</div>
							<!--[if !IE]>add_uzak Radio Input Başlar<![endif]-->
							<!--[if !IE]>unremove_original Radio Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_video.unremove_original }}
									:</label>
								<div class="col-md-4">
									<div class="radio-list">
										<label class="radio-inline">
											<label class="radio-inline">
												{{ lang.mod_video.admin.radio.publish_yes }}
												<input name="unremove_original" value="y" class="radio" type="radio" checked="checked"/>
											</label>
											<label class="radio-inline">
												{{ lang.mod_video.admin.radio.publish_no }}
												<input name="unremove_original" value="n" class="radio" type="radio"/>
											</label>
										</div>
									</div>
								</div>
								<!--[if !IE]>unremove_original Radio Input Başlar<![endif]-->
								<!--[if !IE]>description TextArea Input Başlar<![endif]-->
								<div class="form-group">
									<label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.description }}
										:</label>
									<div class="col-md-4">
										<div class="input-group">
											<textarea class="form-control  input-xlarge validate[required]" name="description" id="description">{{ description }}</textarea>
										</div>
									</div>
								</div>
								<!--[if !IE]>description TextArea Input Biter<![endif]-->
								<!--[if !IE]>Video Input<![endif]-->
								<p id="alan">
									<input id="video" name="video" type="file"/>
								</p>
								<!--[if !IE]>Video Input<![endif]-->
								<!--[if !IE]>Video Upload<![endif]-->
								<p style="display:none;" id="yukle">
									<a class="btn green" onclick="javascript:$('#video').uploadifyUpload();">
										<span>{{ lang.mod_video.button.yukle }}</span>
									</a>
								</p>
								<!--[if !IE]>Video Upload<![endif]-->
								<!--[if !IE]>Dönüştür Upload<![endif]-->
								<p style="display:none;" id="donustur">
									<input type="hidden" name="d_video" id="d_video">
									<a class="btn green" onclick="javascript:donustur();">
										<span>{{ lang.mod_video.button.donustur }}</span>
									</a>
								</p>
								<!--[if !IE]>Dönüştür Upload<![endif]-->
								<p>
									<input type="hidden" name="flv" value="" id="flv">
									<input type="hidden" name="image" value="" id="image">
									<input type="hidden" name="sure" value="" id="sure">
									<input type="hidden" name="video_original" value="" id="video_original">
								</p>
								<!--[if !IE]>Ekle Butonu<![endif]-->
								<p style="display:none;" id="vdata">
									{{ lang.mod_video.admin.columns.duration }}:
									<br>
									<span id="vsure"></span>
									<br>
									{{ lang.mod_video.admin.columns.image }}::
									<br>
									<img src="" id="vresim" width="160" height="120">
									<br>
									{{ lang.mod_video.admin.columns.onizleme }}:
									<br>
									<span id="vflv"></span>
								</p>
								<!-- inputlar Biter -->
							</div>
							<!-- form body end -->
							<div class="form-actions">
								<div class="row">
									<div
										class="col-md-offset-3 col-md-9">
										<!--[if !IE]>{{lang.mod_video.button.add}} Butonu<![endif]-->
										<hr>
										<p id="ekleme">
											<button class="btn green" name="add" value="{{ lang.mod_video.button.add }}">
												<span>{{ lang.mod_video.button.add }}</span>
											</button>
											<a class="btn blue" href="mod_video/list">
												<span>{{ lang.mod_video.button.vazgec }}</span>
											</a>
										</p>
										<!--[if !IE]>{{ lang.mod_video.button.add }}  Butonu<![endif]-->
									</div>
								</div>
							</div>
						</form>
					{% endif %}
				</div>
			</div>
		{% endif %}
	{% endblock %}
