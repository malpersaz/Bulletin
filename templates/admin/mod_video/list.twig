{% set module_lang_key = 'mod_video' %}
{% set hide_navbar = true %}
{% set hide_fab = true %}
{% extends 'admin/layout.twig' %}
{% block title %}{{ lang.mod_video.list }}{% endblock %}

{% block headline %}{{ lang.mod_video.list }}{% endblock %}

{% block styles %}
<style>
    .standard-toolbar #toolbarPublish.active {
        color: #0b57d0 !important;
        background: rgba(11, 87, 208, 0.12);
    }
    .standard-toolbar #toolbarPublish.active.is-published {
        color: #2e7d32 !important;
        background: rgba(46, 125, 50, 0.12);
    }
</style>
{% endblock %}

{% block content %}

<!-- PULL TO REFRESH SPINNER -->
<div id="ptr-spinner" class="ptr-spinner">
    <div class="spinner-track">
        <div class="spinner-fill"></div>
    </div>
</div>

<!-- DYNAMIC CONTENT (Cards) -->
<div id="content-list-container" class="content-list">
    <!-- Cards will be injected here via JS -->
</div>

<!-- EMPTY STATE -->
<div id="empty-state" class="empty-state-container" style="display: none;">
    <div class="empty-icon-box">
        <i class="bi bi-camera-video"></i>
    </div>
    <h2 style="font-weight: 800;">{{ lang.mod_video.empty_state }}</h2>
</div>

<!-- INFINITE SCROLL LOADER -->
<div id="infinite-loader" class="infinite-loader" style="display: none;">
    <div class="spinner-track">
        <div class="spinner-fill"></div>
    </div>
    <span>{{ lang.mod_video.grid['3'] }}</span>
</div>

<!-- HIDDEN FILTERS -->
<form id="filterForm" style="display: none;">
    <input type="hidden" name="start" id="filterStart" value="0">
    <input type="hidden" name="length" id="filterLength" value="10">
    <input type="hidden" name="draw" id="filterDraw" value="1">
    <input type="hidden" name="arama[name]" id="filterSearch" value="">
    <input type="hidden" name="arama[lang]" id="filterLang" value="">
    <input type="hidden" name="order[0][column]" id="filterSortColumn" value="1">
    <input type="hidden" name="order[0][dir]" id="filterSortDir" value="desc">
</form>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button id="toolbarEdit" class="toolbar-item" onclick="editSelected()" style="opacity:0.3; pointer-events:none;">
            <i class="bi bi-pencil-fill"></i>
            <span>{{ lang.mod_video.button.edit }}</span>
        </button>
        
        <button id="toolbarImage" class="toolbar-item" onclick="imageSelected()" style="opacity:0.3; pointer-events:none;">
            <i class="bi bi-image"></i>
            <span>{{ lang.mod_video.admin.columns.image }}</span>
        </button>

        <button id="toolbarPublish" class="toolbar-item" onclick="publishToggleSelected()" style="opacity:0.3; pointer-events:none;">
            <i id="toolbarPublishIcon" class="bi bi-eye-fill"></i>
            <span id="toolbarPublishText">{{ lang.mod_video.grid.publish.key }}</span>
        </button>

        <button id="toolbarDelete" class="toolbar-item" onclick="deleteSelected()" style="opacity:0.3; pointer-events:none;">
            <i class="bi bi-trash3-fill"></i>
            <span>{{ lang.mod_video.button.delete }}</span>
        </button>
    </div>

    <!-- Main FAB Button -->
    <button class="main-fab" id="mainFab" onclick="location.href='{{ site.saddress }}mod_video/add'" aria-label="{{ lang.mod_video.add|default('Videoyê Lêzêde Bike') }}">
        <i class="bi bi-plus-lg"></i>
    </button>
{% endblock %}

{% block scripts %}
<script>
    const MODULE_URL = SITE_URL + "mod_video/";
    const DATA_URL = SITE_URL + "mod_video/datatable_json";
    
    const VIDEO_LANG = {
        active: "{{ lang.mod_video.status.published|e('js') }}",
        draft: "{{ lang.mod_video.status.draft|e('js') }}",
        publish: "{{ lang.mod_video.grid.publish.key|e('js') }}",
        unpublish: "{{ lang.mod_video.grid.unpublish.key|e('js') }}",
        confirm_delete: "{{ lang.mod_video.remove_record|e('js') }}",
        confirm_publish: "{{ lang.mod_video.grid.publish.value|e('js') }}",
        confirm_unpublish: "{{ lang.mod_video.grid.unpublish.value|e('js') }}",
        error_general: "{{ lang.mod_video.hata|e('js') }}",
        confirm_yes: "{{ lang.mod_video.button.evet|e('js') }}",
        confirm_no: "{{ lang.mod_video.button.hayir|e('js') }}",
        loading: "{{ lang.mod_video.grid['3']|e('js') }}",
        information: "{{ lang.mod_video.information|e('js') }}",
        image_update_confirm: "{{ lang.mod_video.remove_image|e('js') }}", // Will use as prompt
        button: {
            cancel: "{{ lang.mod_video.button.vazgec|e('js') }}"
        },
        sheet: {
            ok: "{{ lang.mod_video.oke|e('js') }}"
        },
        grid: {
            load_more: "{{ lang.mod_video.grid['0']|e('js') }}"
        }
    };
</script>
<script src="/templates/admin/assets/js/mod_video.js?v=1.0"></script>
<!-- toolbarVideo toolbarSlider toolbarHomepage -->
{% endblock %}
