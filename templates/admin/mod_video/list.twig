{% set module_lang_key = 'mod_video' %}
{% set hide_navbar = true %}
{% set hide_fab = true %}
{% extends 'admin/layout.twig' %}
{% block title %}{{ lang.mod_video.list }}{% endblock %}

{% block headline %}{{ lang.mod_video.list }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/mod_video.css?v={{ site.version }}">
{% endblock %}

{% block content %}

<!-- PULL TO REFRESH SPINNER -->
<div id="ptr-spinner" class="ptr-spinner">
    <div class="spinner-track">
        <div class="spinner-fill"></div>
    </div>
</div>

<!-- DYNAMIC CONTENT (Cards) -->
<div id="content-list-container" class="content-list">
    <!-- Cards will be injected here via JS -->
</div>

<!-- EMPTY STATE -->
<div id="empty-state" class="empty-state-container is-hidden">
    <div class="empty-icon-box">
        <i class="bi bi-camera-video"></i>
    </div>
    <h2 class="video-empty-title">{{ lang.mod_video.empty_state }}</h2>
</div>

<!-- INFINITE SCROLL LOADER -->
<div id="infinite-loader" class="infinite-loader is-hidden">
    <div class="spinner-track">
        <div class="spinner-fill"></div>
    </div>
    <span>{{ lang.mod_video.grid.loading }}</span>
</div>

<!-- HIDDEN FILTERS -->
<form id="filterForm" class="is-hidden">
    <input type="hidden" name="start" id="filterStart" value="0">
    <input type="hidden" name="length" id="filterLength" value="10">
    <input type="hidden" name="draw" id="filterDraw" value="1">
    <input type="hidden" name="search[name]" id="filterSearch" value="">
    <input type="hidden" name="search[lang]" id="filterLang" value="">
    <input type="hidden" name="order[0][column]" id="filterSortColumn" value="1">
    <input type="hidden" name="order[0][dir]" id="filterSortDir" value="desc">
</form>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button id="toolbarSlider" type="button" class="toolbar-item is-disabled" title="{{ lang.mod_video.hero_slider_add }}">
            <i class="bi bi-stars"></i>
            <span>{{ lang.mod_video.hero_slider_badge }}</span>
        </button>

        <button id="toolbarEdit" type="button" class="toolbar-item is-disabled">
            <i class="bi bi-pencil-fill"></i>
            <span>{{ lang.mod_video.button.edit }}</span>
        </button>

        <button id="toolbarImage" type="button" class="toolbar-item is-disabled">
            <i class="bi bi-image"></i>
            <span>{{ lang.mod_video.admin.columns.image }}</span>
        </button>

        <button id="toolbarPublish" type="button" class="toolbar-item is-disabled">
            <i id="toolbarPublishIcon" class="bi bi-eye-fill"></i>
            <span id="toolbarPublishText">{{ lang.mod_video.grid.publish.key }}</span>
        </button>

        <button id="toolbarDelete" type="button" class="toolbar-item is-disabled">
            <i class="bi bi-trash3-fill"></i>
            <span>{{ lang.mod_video.button.delete }}</span>
        </button>
    </div>

    <!-- Main FAB Button -->
    <button type="button" class="main-fab" id="mainFab" data-add-url="{{ site.saddress }}mod_video/add" aria-label="{{ lang.mod_video.add }}">
        <i class="bi bi-plus-lg"></i>
    </button>
{% endblock %}

{% block scripts %}
<script>
    const MODULE_URL = SITE_URL + "mod_video/";
    const DATA_URL = SITE_URL + "mod_video/datatable_json";
    
    const VIDEO_LANG = {
        active: "{{ lang.mod_video.status.published|e('js') }}",
        draft: "{{ lang.mod_video.status.draft|e('js') }}",
        publish: "{{ lang.mod_video.grid.publish.key|e('js') }}",
        unpublish: "{{ lang.mod_video.grid.unpublish.key|e('js') }}",
        confirm_delete: "{{ lang.mod_video.remove_record|e('js') }}",
        confirm_publish: "{{ lang.mod_video.grid.publish.value|e('js') }}",
        confirm_unpublish: "{{ lang.mod_video.grid.unpublish.value|e('js') }}",
        confirm_yes: "{{ lang.mod_video.button.yes|e('js') }}",
        confirm_no: "{{ lang.mod_video.button.no|e('js') }}",
        publishing: "{{ lang.mod_video.grid.publishing|e('js') }}",
        unpublishing: "{{ lang.mod_video.grid.unpublishing|e('js') }}",
        delete_confirm_title: "{{ lang.mod_video.grid.delete_confirm_title|e('js') }}",
        delete_confirm_text: "{{ lang.mod_video.grid.delete_confirm_text|e('js') }}",
        cancel: "{{ lang.mod_video.button.cancel|e('js') }}",
        error_general: "{{ lang.mod_video.error|e('js') }}",
        loading: "{{ lang.mod_video.grid.loading|e('js') }}",
        information: "{{ lang.mod_video.information|e('js') }}",
        image_update_confirm: "{{ lang.mod_video.remove_image|e('js') }}", // Will use as prompt
        sheet: {
            ok: "{{ lang.mod_video.success|e('js') }}"
        },
        grid: {
            load_more: "{{ lang.mod_video.grid.showing_results|e('js') }}"
        }
    };
</script>
<script src="/templates/admin/assets/js/mod_video.js?v=1.0"></script>
<!-- toolbarVideo toolbarSlider toolbarHomepage -->
{% endblock %}
