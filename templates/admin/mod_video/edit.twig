{% extends "management/admin-layout.twig" %}
{% block extra %}
	<script>
		$(document).ready(function () {
$("#edit").validationEngine();


function temizle(veri) {

var temiz = veri.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, " ");
temiz = temiz.replace(/^\s+|\s+$/g, "");

for (i = 0; i <= 15; i ++) {
temiz = temiz.replace('  ', ' ');
}
return temiz;
}

// SEO YAPAR
function make_seo(name, seo) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, "_");
deger = deger.replace('İ', 'i');

$("#" + seo).val(deger);
});
}

// Make keywords
function make_keywords(name, keywords) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
deger = deger.replace(/\s+/g, ",");
deger = deger.toLowerCase();
deger = deger.replace('İ', 'i');

$("#" + keywords).val(deger);
});
}

// Make Title
function make_title(name, title) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + title).val(deger);
});
}

// Make Açıklama
function make_aciklama(name, description) {
$("#" + name).change(function () {
var deger = temizle($("#" + name).val());
$("#" + description).val(deger);
});
}

// Make Preview
function make_preview(name) {
$("#" + name).change(function () {
$("#" + name + "_preview").html($("#" + name).val());
});
}


var simdi = new Date();
var yil = simdi.getFullYear();
var ay = (simdi.getMonth() < 9 ? '0' : '') + (simdi.getMonth() + 1);
var gun = (simdi.getDate() < 10 ? '0' : '') + simdi.getDate();
var saat = (simdi.getHours() < 10 ? '0' : '') + simdi.getHours();
var dakika = (simdi.getMinutes() < 10 ? '0' : '') + simdi.getMinutes();

var now = yil + "-" + ay + "-" + gun + " " + saat + ":" + dakika;

if ($("#created_at").val() == "") {
$("#created_at").val(now);
}

AnyTime.picker("created_at", {
format: "%z-%m-%d %H:%i",
firstDOW: 1,
placement: "popup",
labelDayOfMonth: "{{ lang.mod_video.date_picker.labels.day_of_month }}",
labelHour: "{{ lang.mod_video.date_picker.labels.hour }}",
labelMinute: "{{ lang.mod_video.date_picker.labels.minute }}",
labelMonth: "{{ lang.mod_video.date_picker.labels.month }}",
labelTitle: "{{ lang.mod_video.date_picker.labels.title }}",
labelYear: "{{ lang.mod_video.date_picker.labels.year }}",
dayAbbreviations: {{ lang.mod_video.date_picker.days_short | json_encode | raw }},
dayNames: {{ lang.mod_video.date_picker.days | json_encode | raw }},
monthAbbreviations: {{ lang.mod_video.date_picker.months_short | json_encode | raw }},
monthNames: {{ lang.mod_video.date_picker.months | json_encode | raw }}
});

});
	</script>
	<!-- Javascript Başlar -->
	<script type="text/javascript">
		function image_remove_image(id) { // Sor Bakalım Kabul Ediyormu ( Confirm)
$.prompt('{{ lang.mod_video.remove_image }}', {
buttons: [
{
title: '{{ lang.mod_video.button.evet }}',
value: true
}, {
title: '{{ lang.mod_video.button.hayir }}',
value: false
}
],
submit: function (v, m, f) { // Eğer Kabul Ederse
if (v === true) {
$.ajax({
type: "POST",
url: "{{ site.sadres }}mod_video/image_remove_image",
data: {
id: id
},
success: function (msg) {
if (msg == 'Oke') {
$.achtung({className: 'achtungSuccess', message: '{{ lang.mod_video.remove_image_oke }}', timeout: 5});
$("#image-" + id).html('<input name="image" type="file">');
} else {
$.achtung({className: 'achtungFail', message: msg, timeout: 5});
}
}
});
}
}
});
}
	</script>
	<!-- Javascript Biter -->
{% endblock %}
{% block title %}
	{{ lang.mod_video.edit }}
{% endblock %}
{% block body %}
	{% if error is defined %}
		<div class="alert alert-danger">
			<strong>{{ lang.mod_video.error }}</strong>
			{{ mesaj }}
		</div>
	{% else %}
		<div class="portlet box green">
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-edit"></i>
					{{ lang.mod_video.edit }}
				</div>
			</div>
			<div
				class="portlet-body form">
				<!--  Mesajlar -->
				{% if oke is defined %}
					<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
					<div class="alert alert-success">
						<strong>{{ lang.mod_video.oke }}</strong>
						{{ mesaj }}
					</div>
					<!--[if !IE]>Oke Mesajı Varsa<![endif]-->
				{% else %}
					{% if hatalar is defined %}
						<!--[if !IE]>Hata Mesajı Varsa<![endif]-->
						{% for hata in hatalar %}
							<div class="alert alert-danger">
								<strong>{{ lang.mod_video.hata }}</strong>
								{{ hata }}
							</div>
						{% endfor %}
						<!--[if !IE]>Hata Mesajı Varsa<![endif]-->
					{% endif %}
					<form method="POST" action="" id="edit" enctype="multipart/form-data" class="form-horizontal">
						<div class="form-body">
							<!-- İnputlar Başlar -->
							<!--[if !IE]>lang Input Başlar<![endif]-->
								<div class="form-group"> <label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.lang }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge validate[required]" name="lang" id="lang">
											{% for item in lang_lang %}
												<option value="{{ item.seo }}" {% if d.lang == item.seo %} selected="selected" {% endif %}>
													{{ item.name }}
												</option>
											{% endfor %}
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>lang Input Biter<![endif]-->
							<!--[if !IE]>name Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.name }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge validate[required,length[2,255]]" name="name" value="{{ d.name }}" type="text" id="name">
									</div>
								</div>
							</div>
							<!--[if !IE]>name Input Biter<![endif]-->
							<!--[if !IE]>sure Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.duration }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge validate[required,length[5,8]]" name="sure" value="{{ d.duration }}" type="text" id="sure">
									</div>
								</div>
							</div>
							<!--[if !IE]>sure Input Biter<![endif]-->
							<!--[if !IE]>created_at Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.created_at }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge validate[required]" name="created_at" value="{{ d.created_at }}" type="text" id="created_at">
									</div>
								</div>
							</div>
							<!--[if !IE]>created_at Input Biter<![endif]-->
							<!--[if !IE]>status Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.status }}
									:</label>
								<div class="col-md-4">
									<div class="radio-list">
										<label class="radio-inline">
											{{ lang.mod_video.admin.radio.publish_yes }}
											<input name="status" value="y" type="radio" {% if d.status == 'y' %} checked="checked" {% endif %}/>
										</label>
										<label class="radio-inline">
											{{ lang.mod_video.admin.radio.publish_no }}
											<input name="status" value="n" type="radio" {% if d.status == 'n' %} checked="checked" {% endif %}/>
										</label>
									</div>
								</div>
							</div>
							<!--[if !IE]>status Input Biter<![endif]-->
							<!--[if !IE]>description Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">
									{{ lang.mod_video.admin.columns.description }}
									:
								</label>
								<div class="col-md-4">
									<div class="input-group">
										<input class="form-control input-xlarge  validate[required]" name="description" value="{{ d.description }}" type="text" id="description">
									</div>
								</div>
							</div>
							<!--[if !IE]>description Input Biter<![endif]-->
							<!--[if !IE]>image}} İmage Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.image }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										{% if d.image == "" %}
											<input name="image" type="file">
										{% else %}
											<p id="image-{{ d.id }}">
												<img src="static/mod_video/image/{{ d.image }}">
												<a href="javascript:void(0)" onclick="image_remove_image('{{ d.id }}');">{{ lang.mod_video.button.kaldir }}</a>
											</p>
										{% endif %}
									</div>
								</div>
							</div>
							<!--[if !IE]>image}} İmage Input Biter<![endif]-->
							<!--[if !IE]>acl_id Input Başlar<![endif]-->
							<div class="form-group">
								<label class="col-md-3 control-label">{{ lang.mod_video.admin.columns.acl_id | raw }}
									:</label>
								<div class="col-md-4">
									<div class="input-group">
										<select class="form-control input-xlarge validate[required]" name="acl_id" id="acl_id">
											<option value="0" {% if d.acl_id == 0 %} selected="selected" {% endif %}>{{ lang.mod_video.choose_wish }}</option>
											{% for item in mod_acl_acl_id %}
												<option value="{{ item.id }}" {% if d.acl_id == item.id %} selected="selected" {% endif %}>
													{{ item.name }}
												</option>
											{% endfor %}
										</select>
									</div>
								</div>
							</div>
							<!--[if !IE]>acl_id Input Biter<![endif]-->
							<!-- inputlar Biter -->
						</div>
						<!-- form body end -->
						<hr>
						<video id="video-{{ d.id }}" class="video-js vjs-default-skin vjs-big-play-centered" controls preload="auto" width="100%" height="264" poster="{{ site.radres }}mod_video/image/{{ d.image }}" data-setup='{"example_option":true}'>
							<source src="{{ site.radres }}mod_video/flv/{{ d.flv }}" type='video/mp4'/>
							<p class="vjs-no-js">
								{{ lang.mod_video.js_enable }}
							</p>
						</video>
						<hr>
						<div class="form-actions">
							<div class="row">
								<div
									class="col-md-offset-3 col-md-9">
									<!--[if !IE]>{{ lang.mod_video.button.edit }} Butonu<![endif]-->
									<button class="btn green" name="edit" value="{{ lang.mod_video.button.edit }}">
										<span>{{ lang.mod_video.button.edit }}</span>
									</button>
									<a class="btn blue" href="mod_video/list">
										<span>{{ lang.mod_video.button.vazgec }}</span>
									</a>
									<!--[if !IE]>{{ lang.mod_video.button.edit }}  Butonu<![endif]-->
								</div>
							</div>
						</div>
					</form>
				{% endif %}
			</div>
		</div>
	{% endif %}
{% endblock %}
