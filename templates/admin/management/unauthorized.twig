<!DOCTYPE html>
<html lang="{{ site.lang|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ lang.mod_user.error.permission_error }} - {{ site.title }}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/unauthorized.css?v={{ site.version }}">
</head>
<body class="unauthorized-page">

    <main class="unauthorized-card">
        <div class="unauthorized-icon" aria-hidden="true">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h1 class="unauthorized-title">{{ lang.mod_user.error.permission_error }}</h1>
        <p class="unauthorized-message">{{ error_message }}</p>

        <div class="unauthorized-actions">
            <a href="{{ site.saddress }}mod_user/panel" class="unauthorized-btn">
                {{ lang.management.dashboard }}
            </a>
            <a href="{{ site.saddress }}" class="unauthorized-btn unauthorized-btn-tonal">
                {{ lang.management.back_to_home }}
            </a>
        </div>
    </main>

</body>
</html>
