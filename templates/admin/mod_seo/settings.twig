{% set hide_navbar = true %}
{% set hide_fab = true %}
{% extends "admin/layout.twig" %}

{% block title %}{{ lang.mod_seo.settings }}{% endblock %}
{% block headline %}{{ lang.mod_seo.settings }}{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="/templates/admin/assets/css/mod_seo.css?v=1.2">
{% endblock %}

{% block content %}
<div class="seo-settings-page">
    <form action="{{ site.saddress }}mod_seo/settings" method="post" enctype="multipart/form-data" id="seoSettingsForm" class="seo-settings-form">
        
        <!-- API Credentials Status Card -->
        {% if has_credentials %}
            <div class="m3-card seo-credentials-card-ok">
                <i class="bi bi-check-circle-fill seo-ok-icon"></i>
                <div>
                    <h4 class="seo-badge-label">{{ lang.mod_seo.admin.labels.credentials_status }}</h4>
                    <span class="seo-error-desc">{{ lang.mod_seo.admin.labels.credentials_ok }}</span>
                </div>
            </div>
        {% else %}
            <div class="m3-card seo-credentials-card-missing">
                <i class="bi bi-exclamation-circle-fill seo-error-icon"></i>
                <div>
                    <h4 class="seo-badge-label">{{ lang.mod_seo.admin.labels.credentials_status }}</h4>
                    <span class="seo-error-desc">{{ lang.mod_seo.admin.labels.settings_credentials_missing }}</span>
                </div>
            </div>
        {% endif %}

        <!-- Form fields inside an MD3 card -->
        <div class="m3-card seo-form-card">
            <!-- Property URL Input -->
            <div class="seo-form-group">
                <label for="property_url" class="seo-form-label">
                    {{ lang.mod_seo.admin.labels.property_url }}
                </label>
                <input type="text" id="property_url" name="property_url" value="{{ property_url }}" class="m3-input" required placeholder="{{ lang.mod_seo.admin.labels.property_url_placeholder }}">
            </div>

            <!-- JSON Upload Input -->
            <div class="seo-form-group">
                <label for="json_file" class="seo-form-label">
                    {{ lang.mod_seo.admin.labels.json_file }}
                </label>
                <input type="file" id="json_file" name="json_file" accept=".json" class="m3-input">
            </div>
        </div>
        
        <!-- Bottom Action Bar (sticky) -->
        <div class="m3-final-bar">
            <button type="button" class="m3-btn-half m3-btn-half-neutral" data-url="{{ site.saddress }}mod_seo">
                <i class="bi bi-x-lg"></i>
                <span>{{ lang.mod_seo.button.back }}</span>
            </button>
            <button type="submit" name="save" value="1" class="m3-btn-half m3-btn-half-primary">
                <i class="bi bi-floppy-fill"></i>
                <span>{{ lang.mod_seo.button.save }}</span>
            </button>
        </div>

    </form>
</div>
{% endblock %}

{% block scripts %}
    <script src="/templates/admin/assets/js/mod_seo.js?v=1.2"></script>
{% endblock %}
