{% set hide_navbar = true %}
{% set hide_fab = true %}
{% set show_search = true %}
{% set show_search_filter_button = false %}
{% set search_placeholder = lang.mod_seo.admin.columns.name %}
{% extends "admin/layout.twig" %}

{% block title %}{{ lang.mod_seo.list }}{% endblock %}
{% block headline %}{{ lang.mod_seo.list }}{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="/templates/admin/assets/css/mod_seo.css?v=1.2">
{% endblock %}

{% block content %}
{% if not has_credentials %}
    <!-- Onboarding State: Credentials Missing -->
    <div class="seo-onboarding-card">
        <div class="seo-onboarding-header">
            <i class="bi bi-shield-exclamation seo-onboarding-icon"></i>
            <div>
                <div class="seo-onboarding-title">{{ lang.mod_seo.admin.labels.onboarding_title }}</div>
                <div class="seo-onboarding-text">{{ lang.mod_seo.admin.labels.onboarding_desc }}</div>
            </div>
        </div>
        <button type="button" data-url="{{ site.saddress }}mod_seo/settings" class="seo-onboarding-btn">
            <i class="bi bi-gear-fill"></i>
            <span>{{ lang.mod_seo.button.setup_api }}</span>
        </button>
    </div>
{% elseif error_message %}
    <!-- API Query Notice -->
    <div class="m3-card seo-error-card">
        <i class="bi bi-exclamation-octagon-fill seo-error-icon"></i>
        <div>
            <div class="seo-error-title">{{ lang.mod_seo.messages.error }}</div>
            <div class="seo-error-desc">{{ error_message }}</div>
        </div>
    </div>
{% endif %}

{% if has_credentials and site_urls is not empty %}
    <!-- Mini Dashboard Summary Card -->
    <div class="m3-card seo-dashboard-card">
        <div class="seo-property-title">
            {{ property_url }}
        </div>
        <div class="seo-dashboard-grid">
            <div class="seo-stat-box">
                <div class="seo-stat-value">{{ total_clicks }}</div>
                <div class="seo-stat-label">{{ lang.mod_seo.admin.columns.clicks }}</div>
            </div>
            <div class="seo-stat-box">
                <div class="seo-stat-value">{{ total_impressions }}</div>
                <div class="seo-stat-label">{{ lang.mod_seo.admin.columns.impressions }}</div>
            </div>
            <div class="seo-stat-box">
                <div class="seo-stat-value">{{ avg_ctr }}%</div>
                <div class="seo-stat-label">{{ lang.mod_seo.admin.columns.ctr }}</div>
            </div>
            <div class="seo-stat-box">
                <div class="seo-stat-value">{{ avg_pos }}</div>
                <div class="seo-stat-label">{{ lang.mod_seo.admin.columns.position }}</div>
            </div>
        </div>
    </div>
{% endif %}

<!-- Url Listings -->
<div class="content-list" id="seoUrlsList">
    {% for item in site_urls %}
        <div class="m3-card seo-url-card" data-name="{{ item.name|lower }}" data-path="{{ item.path|lower }}">
            <div class="seo-card-header">
                <div class="seo-card-title">{{ item.name }}</div>
                
                {% set badge_class = 'seo-badge-page' %}
                {% if item.type == 'Content' %}
                    {% set badge_class = 'seo-badge-content' %}
                {% elseif item.type == 'Publication' %}
                    {% set badge_class = 'seo-badge-publication' %}
                {% endif %}
                
                <span class="seo-card-badge {{ badge_class }}">
                    {{ item.type }}
                </span>
            </div>
            
            <div class="seo-card-url">
                <a href="{{ item.full_url }}" target="_blank" rel="noopener">
                    {{ item.path }} <i class="bi bi-box-arrow-up-right"></i>
                </a>
            </div>
            
            <div class="seo-metrics-divider"></div>
            
            <div class="seo-metrics-grid">
                <div>
                    <div class="seo-metric-value">{{ item.clicks }}</div>
                    <div class="seo-metric-label">{{ lang.mod_seo.admin.columns.clicks }}</div>
                </div>
                <div>
                    <div class="seo-metric-value">{{ item.impressions }}</div>
                    <div class="seo-metric-label">{{ lang.mod_seo.admin.columns.impressions }}</div>
                </div>
                <div>
                    <div class="seo-metric-value">{{ item.ctr }}{% if item.ctr != '—' %}%{% endif %}</div>
                    <div class="seo-metric-label">{{ lang.mod_seo.admin.columns.ctr }}</div>
                </div>
                <div>
                    <div class="seo-metric-value">{{ item.position }}</div>
                    <div class="seo-metric-label">{{ lang.mod_seo.admin.columns.position }}</div>
                </div>
            </div>
        </div>
    {% else %}
        {% if not error_message %}
            <div class="empty-state-container">
                <div class="empty-icon-box">
                     <i class="bi bi-search"></i>
                </div>
                <h2>{{ lang.management.no_records_found }}</h2>
            </div>
        {% endif %}
    {% endfor %}
</div>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button type="button" class="toolbar-item" data-url="{{ site.saddress }}mod_user/panel">
            <i class="bi bi-house-door-fill"></i>
            <span>{{ lang.management.home }}</span>
        </button>
        
        <button type="button" class="toolbar-item" data-url="{{ site.saddress }}mod_seo/settings">
            <i class="bi bi-gear-fill"></i>
            <span>{{ lang.mod_seo.settings }}</span>
        </button>

        <button type="button" class="toolbar-item" id="btnRefresh">
            <i class="bi bi-arrow-clockwise"></i>
            <span>{{ lang.mod_seo.button.refresh }}</span>
        </button>

        <button type="button" class="toolbar-item" data-url="{{ site.saddress }}mod_user/panel">
            <i class="bi bi-arrow-left"></i>
            <span>{{ lang.mod_seo.button.back }}</span>
        </button>
    </div>
{% endblock %}

{% block scripts %}
    <script src="/templates/admin/assets/js/mod_seo.js?v=1.2"></script>
{% endblock %}
