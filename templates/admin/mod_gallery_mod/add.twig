{% set show_navbar = false %}
{% set show_fab = false %}
{% set show_search = false %}
{% set show_sidebar = true %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set show_extra_sheets = false %}
{% set hide_contextual_bar = true %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_gallery_mod.add }}{% endblock %}
{% block headline %}{{ lang.mod_gallery_mod.add }}{% endblock %}

{% block styles %}
<style>
    .gallery-mod-form-shell {
        padding: 16px;
        padding-bottom: 120px;
        display: grid;
        gap: 16px;
        background:
            radial-gradient(circle at top left, rgba(187, 93, 24, 0.12), transparent 24%),
            radial-gradient(circle at bottom right, rgba(24, 99, 86, 0.14), transparent 28%),
            linear-gradient(180deg, #fff7ef 0%, #eef8f5 100%);
    }
    .gallery-mod-form-card,
    .gallery-mod-intro,
    .form-status {
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(0, 0, 0, 0.06);
        box-shadow: 0 12px 30px rgba(22, 30, 52, 0.06);
    }
    .gallery-mod-intro,
    .gallery-mod-form-card {
        padding: 20px;
    }
    .gallery-mod-intro h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 800;
    }
    .gallery-mod-intro p {
        margin: 8px 0 0;
        line-height: 1.6;
        color: var(--md-sys-color-on-surface-variant);
        font-size: 13px;
    }
    .gallery-mod-form-card {
        display: grid;
        gap: 16px;
    }
    .form-status {
        padding: 14px 16px;
        font-size: 14px;
        line-height: 1.5;
    }
    .form-status.error {
        background: #fce8e6;
        color: #b3261e;
    }
    .form-status.success {
        background: #e6f4ea;
        color: #1e4620;
    }
    .m3-input-wrapper {
        position: relative;
    }
    .m3-input-lg {
        width: 100%;
        padding: 16px;
        border-radius: 16px;
        border: 1px solid var(--md-sys-color-outline);
        background: transparent;
        color: var(--md-sys-color-on-surface);
        box-sizing: border-box;
        outline: none;
    }
    .m3-input-lg:focus {
        border-width: 2px;
        border-color: var(--md-sys-color-primary);
        padding: 15px;
    }
    .m3-floating-label {
        position: absolute;
        top: 16px;
        left: 16px;
        background: rgba(255, 255, 255, 0.95);
        padding: 0 6px;
        color: var(--md-sys-color-on-surface-variant);
        pointer-events: none;
        transition: all 0.2s ease;
    }
    .m3-input-lg:focus + .m3-floating-label,
    .m3-input-lg:not(:placeholder-shown) + .m3-floating-label {
        top: -9px;
        left: 12px;
        font-size: 12px;
        color: var(--md-sys-color-primary);
    }
</style>
{% endblock %}

{% block content %}
<div class="gallery-mod-form-shell">
    <section class="gallery-mod-intro">
        <h2>{{ lang.mod_gallery_mod.add }}</h2>
        <p>{{ lang.mod_gallery_mod.information }}</p>
    </section>

    {% if oke is defined %}
        <div class="form-status success">{{ mesaj }}</div>
    {% endif %}
    {% if error is defined %}
        <div class="form-status error">{{ mesaj }}</div>
    {% endif %}
    {% if hata is defined or hatalar is defined %}
        <div class="form-status error">
            {% if hatalar is defined %}
                {% for message in hatalar %}
                    <div>{{ message }}</div>
                {% endfor %}
            {% endif %}
        </div>
    {% endif %}

    <form method="POST" action="" id="addGalleryModForm" class="gallery-mod-form-card">
        <div class="m3-input-wrapper">
            <input class="m3-input-lg" name="name" value="{{ name }}" type="text" id="name" placeholder=" ">
            <label class="m3-floating-label">{{ lang.mod_gallery_mod.admin.columns.name }}</label>
        </div>

        <div class="m3-input-wrapper">
            <input class="m3-input-lg" name="mod_name" value="{{ mod_name }}" type="text" id="mod_name" placeholder=" ">
            <label class="m3-floating-label">{{ lang.mod_gallery_mod.admin.columns.mod_name }}</label>
        </div>

        <div class="m3-input-wrapper">
            <input class="m3-input-lg" name="mod_key" value="{{ mod_key }}" type="text" id="mod_key" placeholder=" ">
            <label class="m3-floating-label">{{ lang.mod_gallery_mod.admin.columns.mod_key }}</label>
        </div>

        <div class="m3-input-wrapper">
            <input class="m3-input-lg" name="mod_value" value="{{ mod_value }}" type="text" id="mod_value" placeholder=" ">
            <label class="m3-floating-label">{{ lang.mod_gallery_mod.admin.columns.mod_value }}</label>
        </div>
    </form>
</div>
{% endblock %}

{% block fixed_bottom %}
{% if oke is not defined %}
    {% include 'admin/partials/fixed_bottom_form_bar.twig' with {
        cancel_url: cancel_url|default(site.saddress ~ 'mod_gallery_mod/list'),
        cancel_label: lang.mod_gallery_mod.button.vazgec,
        form_id: 'addGalleryModForm',
        submit_label: lang.mod_gallery_mod.button.add,
        reset_label: lang.mod_gallery_mod.button.yenile
    } %}
{% endif %}
{% endblock %}
