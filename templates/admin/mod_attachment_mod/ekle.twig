{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}{{ lang.mod_attachment_mod.add|default('Add File Module') }}{% endblock %}
{% block headline %}{{ lang.mod_attachment_mod.add|default('Add File Module') }}{% endblock %}

{% block content %}
<style>
    .attachment-mod-form-shell { padding: 16px; padding-bottom: 120px; display: grid; gap: 16px; }
    .attachment-mod-form-card { background: var(--md-sys-color-surface); border-radius: 20px; padding: 20px; box-shadow: var(--md-sys-elevation-1); display: grid; gap: 16px; }
    .form-status { border-radius: 16px; padding: 14px 16px; font-size: 14px; line-height: 1.5; }
    .form-status.error { background: #fce8e6; color: #b3261e; }
    .form-status.success { background: #e6f4ea; color: #1e4620; }
    .m3-input-wrapper { position: relative; }
    .m3-input-lg { width: 100%; padding: 16px; border-radius: 16px; border: 1px solid var(--md-sys-color-outline); background: transparent; color: var(--md-sys-color-on-surface); box-sizing: border-box; outline: none; }
    .m3-input-lg:focus { border-width: 2px; border-color: var(--md-sys-color-primary); padding: 15px; }
    .m3-floating-label { position: absolute; top: 16px; left: 16px; background: var(--md-sys-color-surface); padding: 0 6px; color: var(--md-sys-color-on-surface-variant); pointer-events: none; transition: all 0.2s ease; }
    .m3-input-lg:focus + .m3-floating-label, .m3-input-lg:not(:placeholder-shown) + .m3-floating-label { top: -9px; left: 12px; font-size: 12px; color: var(--md-sys-color-primary); }
    .attachment-mod-bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1000; display: flex; gap: 12px; padding: 14px 16px 18px; background: color-mix(in srgb, var(--md-sys-color-surface) 90%, transparent); backdrop-filter: blur(12px); border-top: 1px solid var(--md-sys-color-outline-variant, rgba(0,0,0,0.08)); }
    .attachment-mod-bottom-bar a, .attachment-mod-bottom-bar button { flex: 1; min-height: 52px; border-radius: 999px; border: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; font-weight: 700; cursor: pointer; }
    .attachment-mod-bottom-bar .cancel-btn { background: var(--md-sys-color-surface); color: var(--md-sys-color-on-surface); border: 1px solid var(--md-sys-color-outline) !important; }
    .attachment-mod-bottom-bar .save-btn { background: var(--md-sys-color-primary); color: var(--md-sys-color-on-primary); }
</style>

<div class="attachment-mod-form-shell">
    {% if oke is defined %}
        <div class="form-status success">{{ mesaj }}</div>
    {% endif %}
    {% if error is defined %}
        <div class="form-status error">{{ mesaj }}</div>
    {% endif %}
    {% if hatalar is defined %}
        <div class="form-status error">
            {% for message in hatalar %}
                <div>{{ message }}</div>
            {% endfor %}
        </div>
    {% endif %}

    <form method="POST" action="" id="addAttachmentModForm" class="attachment-mod-form-card">
        <div class="m3-input-wrapper">
            <input class="m3-input-lg" name="name" value="{{ name|default('') }}" type="text" id="name" placeholder=" ">
            <label class="m3-floating-label">{{ lang.mod_attachment_mod.admin.columns.name|default(lang.mod_attachment_mod.admin.columns.ad)|default('File Module Name') }}</label>
        </div>

        <div class="m3-input-wrapper">
            <input class="m3-input-lg" name="mod_name" value="{{ mod_name|default('') }}" type="text" id="mod_name" placeholder=" ">
            <label class="m3-floating-label">{{ lang.mod_attachment_mod.admin.columns.mod_name|default('Module Name') }}</label>
        </div>

        <div class="m3-input-wrapper">
            <input class="m3-input-lg" name="mod_key" value="{{ mod_key|default('') }}" type="text" id="mod_key" placeholder=" ">
            <label class="m3-floating-label">{{ lang.mod_attachment_mod.admin.columns.mod_key|default('Module Key') }}</label>
        </div>

        <div class="m3-input-wrapper">
            <input class="m3-input-lg" name="mod_value" value="{{ mod_value|default('') }}" type="text" id="mod_value" placeholder=" ">
            <label class="m3-floating-label">{{ lang.mod_attachment_mod.admin.columns.mod_value|default('Module Value') }}</label>
        </div>
    </form>
</div>
{% endblock %}

{% block fixed_bottom %}
{% if oke is not defined %}
    <div class="attachment-mod-bottom-bar">
        <a href="{{ site.sadres }}mod_attachment_mod/list" class="cancel-btn">
            <i class="bi bi-arrow-left"></i>
            <span>{{ lang.mod_attachment_mod.button.vazgec|default(lang.mod_attachment_mod.button.cancel)|default('Cancel') }}</span>
        </a>
        <button type="submit" form="addAttachmentModForm" name="add" value="1" class="save-btn">
            <i class="bi bi-check2-circle"></i>
            <span>{{ lang.mod_attachment_mod.button.add|default('Add') }}</span>
        </button>
    </div>
{% endif %}
{% endblock %}
