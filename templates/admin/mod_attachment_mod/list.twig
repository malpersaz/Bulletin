{% set show_navbar = false %}
{% set show_fab = false %}
{% set show_search = true %}
{% set show_search_filter_button = false %}
{% set show_sidebar = false %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set show_extra_sheets = false %}
{% set hide_contextual_bar = true %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_attachment_mod.list }}{% endblock %}
{% block headline %}{{ lang.mod_attachment_mod.list }}{% endblock %}

{% block styles %}
<style>
    .attachment-mod-shell {
        padding: 12px 16px 16px;
        display: grid;
        gap: 14px;
        padding-bottom: 120px;
        background:
            radial-gradient(circle at top left, rgba(182, 64, 19, 0.10), transparent 24%),
            radial-gradient(circle at bottom right, rgba(18, 90, 142, 0.10), transparent 26%),
            linear-gradient(180deg, #fbf4ed 0%, #eef5fb 100%);
    }
    .attachment-mod-list {
        display: grid;
        gap: 12px;
    }
    .attachment-mod-card,
    .attachment-mod-empty {
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.94);
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 12px 30px rgba(22, 30, 52, 0.06);
    }
    .attachment-mod-card {
        display: grid;
        gap: 14px;
        padding: 16px;
        cursor: pointer;
        transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }
    .attachment-mod-card.selected {
        border-color: #b64013;
        box-shadow: 0 18px 36px rgba(182, 64, 19, 0.15);
        transform: translateY(-1px);
    }
    .attachment-mod-top {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 12px;
        align-items: center;
    }
    .attachment-mod-icon {
        width: 50px;
        height: 50px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ffe0cf, #d9ebff);
        color: #7f3217;
        font-size: 21px;
    }
    .attachment-mod-title {
        margin: 0;
        font-size: 15px;
        font-weight: 800;
        line-height: 1.4;
        word-break: break-word;
    }
    .attachment-mod-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 4px;
        color: var(--md-sys-color-on-surface-variant);
        font-size: 12px;
    }
    .attachment-mod-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 24px;
        padding: 0 10px;
        border-radius: 999px;
        background: #fff1e9;
        color: #8b3e1f;
        font-weight: 700;
    }
    .attachment-mod-grid {
        display: grid;
        gap: 8px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .attachment-mod-field {
        border-radius: 16px;
        padding: 12px;
        background: rgba(0, 0, 0, 0.03);
    }
    .attachment-mod-field label {
        display: block;
        margin-bottom: 6px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--md-sys-color-on-surface-variant);
    }
    .attachment-mod-field div {
        word-break: break-word;
        font-size: 14px;
        font-weight: 600;
    }
    .attachment-mod-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        padding: 56px 28px;
        text-align: center;
    }
    .attachment-mod-empty p {
        margin: 0;
        color: var(--md-sys-color-on-surface-variant);
    }
    @media (max-width: 767px) {
        .attachment-mod-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="attachment-mod-shell">
    <div id="attachmentModList" class="attachment-mod-list"></div>
    <section id="attachmentModEmpty" class="attachment-mod-empty" style="display:none;">
        <div class="empty-icon-box"><i class="bi bi-link-45deg"></i></div>
        <h3>{{ lang.mod_attachment_mod.grid[4] }}</h3>
        <p>{{ lang.mod_attachment_mod.admin.empty_description }}</p>
    </section>
</div>
{% endblock %}

{% block fixed_bottom %}
<div class="standard-toolbar">
    <button id="toolbarEdit" class="toolbar-item" onclick="editSelected()" style="opacity:0.3; pointer-events:none;">
        <i class="bi bi-pencil-fill"></i>
        <span>{{ lang.mod_attachment_mod.button.edit }}</span>
    </button>

    <div class="toolbar-fab" onclick="location.href='{{ site.sadres }}mod_attachment_mod/add'">
        <i class="bi bi-plus-lg"></i>
    </div>

    <button id="toolbarAttachment" class="toolbar-item" onclick="openFilesSelected()" style="opacity:0.3; pointer-events:none;">
        <i class="bi bi-paperclip"></i>
        <span>{{ lang.mod_attachment_mod.button.file }}</span>
    </button>

    <button id="toolbarDelete" class="toolbar-item" onclick="deleteSelected()" style="opacity:0.3; pointer-events:none;">
        <i class="bi bi-trash3-fill"></i>
        <span>{{ lang.mod_attachment_mod.button.delete }}</span>
    </button>
</div>
{% endblock %}

{% block scripts %}
<script>
    let attachmentModSelectedId = null;
    let attachmentModRecords = [];

    function renderAttachmentModCard(row) {
        const id = row[1];
        const name = row[2];
        const modName = row[3];
        const modKey = row[4];
        const modValue = row[5];
        const searchText = [id, name, modName, modKey, modValue].join(' ').toLowerCase();

        return `
            <article class="attachment-mod-card" id="attachment-mod-${id}" data-id="${id}" data-search="${searchText}" onclick="selectAttachmentMod('${id}')">
                <div class="attachment-mod-top">
                    <div class="attachment-mod-icon"><i class="bi bi-diagram-3"></i></div>
                    <div>
                        <h3 class="attachment-mod-title">${name}</h3>
                        <div class="attachment-mod-meta">
                            <span class="attachment-mod-badge">#${id}</span>
                            <span>${modName}</span>
                        </div>
                    </div>
                </div>
                <div class="attachment-mod-grid">
                    <div class="attachment-mod-field">
                        <label>{{ lang.mod_attachment_mod.admin.columns.mod_name|e('js') }}</label>
                        <div>${modName}</div>
                    </div>
                    <div class="attachment-mod-field">
                        <label>{{ lang.mod_attachment_mod.admin.columns.mod_key|e('js') }}</label>
                        <div>${modKey}</div>
                    </div>
                    <div class="attachment-mod-field">
                        <label>{{ lang.mod_attachment_mod.admin.columns.mod_value|e('js') }}</label>
                        <div>${modValue}</div>
                    </div>
                    <div class="attachment-mod-field">
                        <label>{{ lang.mod_attachment_mod.admin.columns.ad|e('js') }}</label>
                        <div>${name}</div>
                    </div>
                </div>
            </article>
        `;
    }

    function updateAttachmentModToolbar(active) {
        ['toolbarEdit', 'toolbarAttachment', 'toolbarDelete'].forEach((id) => {
            const button = document.getElementById(id);
            if (!button) {
                return;
            }
            button.style.pointerEvents = active ? 'auto' : 'none';
            button.style.opacity = active ? '1' : '0.3';
            button.classList.toggle('active', active);
        });
    }

    async function loadAttachmentModRecords() {
        const list = document.getElementById('attachmentModList');
        const empty = document.getElementById('attachmentModEmpty');
        if (!list || !empty) {
            return;
        }

        const body = new URLSearchParams();
        body.set('start', '0');
        body.set('length', '100');
        body.set('draw', '1');

        try {
            const response = await fetch('{{ site.sadres }}mod_attachment_mod/datatable_json', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            });

            const payload = await response.json();
            attachmentModRecords = payload.data || [];
            attachmentModSelectedId = null;
            updateAttachmentModToolbar(false);

            if (!attachmentModRecords.length) {
                list.innerHTML = '';
                empty.style.display = 'flex';
                return;
            }

            empty.style.display = 'none';
            list.innerHTML = attachmentModRecords.map(renderAttachmentModCard).join('');
            filterAttachmentModCards(document.getElementById('searchInput')?.value || '');
        } catch (error) {
            showSnackbar(String(error.message || error), 'error');
        }
    }

    function selectAttachmentMod(id) {
        document.querySelectorAll('.attachment-mod-card.selected').forEach((element) => {
            element.classList.remove('selected');
        });

        if (attachmentModSelectedId === id) {
            attachmentModSelectedId = null;
            updateAttachmentModToolbar(false);
            return;
        }

        attachmentModSelectedId = id;
        document.getElementById('attachment-mod-' + id)?.classList.add('selected');
        updateAttachmentModToolbar(true);
    }

    function editSelected() {
        if (!attachmentModSelectedId) {
            return;
        }
        location.href = '{{ site.sadres }}mod_attachment_mod/edit/' + attachmentModSelectedId;
    }

    function openFilesSelected() {
        if (!attachmentModSelectedId) {
            return;
        }
        location.href = '{{ site.sadres }}mod_attachment/list/mod_attachment_mod/' + attachmentModSelectedId;
    }

    function deleteSelected() {
        if (!attachmentModSelectedId) {
            return;
        }

        Swal.fire({
            icon: 'warning',
            text: '{{ lang.mod_attachment_mod.remove_record|e('js') }}',
            showCancelButton: true,
            confirmButtonText: '{{ lang.mod_attachment_mod.button.evet|e('js') }}',
            cancelButtonText: '{{ lang.mod_attachment_mod.button.hayir|e('js') }}'
        }).then((result) => {
            if (!result.isConfirmed) {
                return;
            }

            const body = new URLSearchParams();
            body.append('delete[]', attachmentModSelectedId);

            fetch('{{ site.sadres }}mod_attachment_mod/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            })
                .then((response) => response.text())
                .then((text) => {
                    if (text.trim() !== 'Oke') {
                        throw new Error(text);
                    }

                    showSnackbar('{{ lang.mod_attachment_mod.message.oke.delete|e('js') }}', 'success');
                    loadAttachmentModRecords();
                })
                .catch((error) => showSnackbar(String(error.message || error), 'error'));
        });
    }

    function clearSearch() {
        const input = document.getElementById('searchInput');
        if (input) {
            input.value = '';
        }
        filterAttachmentModCards('');
    }

    function filterAttachmentModCards(value) {
        const term = String(value || '').toLowerCase().trim();
        const cards = document.querySelectorAll('.attachment-mod-card');
        let visible = 0;

        cards.forEach((card) => {
            const matched = !term || (card.dataset.search || '').includes(term);
            card.style.display = matched ? 'grid' : 'none';
            if (matched) {
                visible += 1;
            }
        });

        const empty = document.getElementById('attachmentModEmpty');
        if (empty) {
            empty.style.display = visible === 0 ? 'flex' : 'none';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadAttachmentModRecords();

        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            let timer;
            searchInput.addEventListener('input', function () {
                clearTimeout(timer);
                const value = this.value;
                timer = setTimeout(function () {
                    if (attachmentModRecords.length) {
                        filterAttachmentModCards(value);
                    } else {
                        loadAttachmentModRecords();
                    }
                }, 180);
            });
        }
    });
</script>
{% endblock %}
