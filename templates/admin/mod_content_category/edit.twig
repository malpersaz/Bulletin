{% set hide_navbar = true %}
{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}
	{{ lang.mod_content_category.edit }}
{% endblock %}

{% block headline %}
	{{ lang.mod_content_category.edit }}
{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="/templates/admin/assets/css/mod_content_category.css">
{% endblock %}

{% macro select_nested_parent_id_function(select_nested_parent_id_result, parent_id, selected_id, self_id, level = 0) %}
    {% if select_nested_parent_id_result[parent_id] is defined %}
        {% for entry in select_nested_parent_id_result[parent_id] %}
            {% set sub_loop = entry.id %}
            {% if entry.id != self_id %}
                <option value="{{ entry.id }}" {% if selected_id == entry.id %} selected="selected" {% endif %}>
                    {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.name }} ({% if entry.lang is defined %}{{ entry.lang|upper }}{% endif %})
                </option>
                {% if select_nested_parent_id_result[sub_loop] is defined and select_nested_parent_id_result[sub_loop] is iterable and sub_loop != parent_id and level < 20 %}
                    {{ _self.select_nested_parent_id_function(select_nested_parent_id_result, sub_loop, selected_id, self_id, level + 1) }}
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% block content %}
	<form id="editForm" method="POST" action="" enctype="multipart/form-data">
		<div class="edit-container">
            {% if error is defined and message is defined %}
                <div class="edit-card error-text-left">
                    <div class="error-margin-bottom">
                        <i class="bi bi-exclamation-triangle-fill error-icon"></i>
                        <b>{{ message }}</b>
                    </div>
                </div>
            {% endif %}

            {% if errors is defined and errors|length > 0 %}
                <div class="edit-card error-text-left">
                    {% for err in errors %}
                        <div class="error-margin-bottom">
                            <i class="bi bi-exclamation-triangle-fill error-icon"></i>
                            <b>{{ err }}</b>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

			{# Card 1: Basics #}
			<div class="edit-card">
				<div class="form-row">
					<div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="lang" id="lang" required>
                            {% for item in lang_lang %}
                                <option value="{{ item.seo }}" {% if d.lang == item.seo %} selected {% endif %}>{{ item.name }} ({{ item.seo|upper }})</option>
                            {% endfor %}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_content_category.admin.columns.language }}</label>
                    </div>
				</div>

				<div class="form-row">
					<div class="m3-input-wrapper">
						<input type="text" class="m3-input-lg" name="name" id="name" placeholder=" " autocomplete="off" value="{{ d.name }}" required>
						<label class="m3-floating-label">{{ lang.mod_content_category.admin.columns.name }}</label>
					</div>
				</div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="parent_id" id="parent_id">
                            <option value="0" {% if d.parent_id == '0' %} selected {% endif %}>{{ lang.mod_content_category.form.parent_category|default('Parent Category') }} (Root)</option>
                            {{ _self.select_nested_parent_id_function(select_nested_parent_id_result, 0, d.parent_id, d.id) }}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_content_category.admin.columns.parent_id }}</label>
                    </div>
                </div>
			</div>

			{# Card 2: Media & Settings #}
			<div class="edit-card">

                <div class="form-row">
                    <label class="filter-group-label">{{ lang.mod_content_category.admin.columns.root }}</label>
                    <input type="hidden" name="root" value="{{ d.root }}" id="rootInput">
                    <div class="selection-grid">
                        <div class="selection-card {% if d.root == 'y' %} active {% endif %}" data-root-val="y">
                            <i class="bi bi-folder-check"></i>
                            <div class="selection-label">{{ lang.mod_content_category.admin.select_values.root_yes }}</div>
                        </div>
                        <div class="selection-card {% if d.root == 'n' %} active {% endif %}" data-root-val="n">
                            <i class="bi bi-folder"></i>
                            <div class="selection-label">{{ lang.mod_content_category.admin.select_values.root_no }}</div>
                        </div>
                    </div>
                </div>

				<div class="form-row">
					<label class="filter-group-label">{{ lang.mod_content_category.admin.columns.image }}</label>
					<div id="image-container-edit">
                        <label for="editImgInput" class="image-upload-area">
                            {% if d.image %}
                                <img id="editImgPreview" src="{{ site.iaddress }}mod_content_category/thumb/{{ d.image }}" class="img-preview" alt="">
                            {% else %}
                                <i class="bi bi-cloud-arrow-up-fill"></i>
                                <p>{{ lang.mod_content_category.admin.columns.image_select }}</p>
                                <img id="editImgPreview" class="img-preview" alt="">
                            {% endif %}
                        </label>
                        <input type="file" name="image" id="editImgInput" class="image-input-hidden">
                    </div>
				</div>

				<div class="form-row">
					<label class="filter-group-label">{{ lang.mod_content_category.admin.columns.acl_id|raw }}</label>
                    <div class="acl-row">
                        <select class="m3-input-lg acl-select" name="acl_id" id="acl_id">
                            <option value="0" {% if d.acl_id == 0 %}selected{% endif %}>-- {{ lang.mod_content_category.choose_wish }} --</option>
                            {% for item in mod_acl_acl_id %}
                                <option value="{{ item.id }}" {% if d.acl_id == item.id %}selected{% endif %}>{{ item.name }}</option>
                            {% endfor %}
                        </select>
                        <a href="{{ site.saddress }}mod_acl/list" class="btn btn-sm btn-light acl-link" title="{{ lang.mod_content_category.admin.tooltips.acl_settings }}">
                            <i class="bi bi-gear"></i>
                        </a>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="menu" id="menu">
                            <option value="0" {% if d.menu == 0 %}selected{% endif %}>{{ lang.mod_content_category.choose_wish }}</option>
                            {{ _self.select_nested_parent_id_function(select_nested_menu_result, 0, d.menu, 0) }}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_content_category.admin.columns.menu }}</label>
                    </div>
                </div>

				<div class="advanced-toggle">
					<span>{{ lang.mod_content_category.form.seo_settings|default('SEO Settings') }}</span>
					<i class="bi bi-chevron-down" id="advancedIcon"></i>
				</div>

                <div class="advanced-content" id="advancedContent">
                    <div class="form-row">
                        <div class="m3-input-wrapper">
                            <input type="text" class="m3-input-lg" name="seo" id="seo" value="{{ d.seo }}" placeholder=" ">
                            <label class="m3-floating-label">{{ lang.mod_content_category.admin.columns.seo }}</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="m3-input-wrapper">
                            <input type="text" class="m3-input-lg" name="title" id="title" value="{{ d.title }}" placeholder=" ">
                            <label class="m3-floating-label">{{ lang.mod_content_category.admin.columns.title }}</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="m3-input-wrapper">
                            <input type="text" class="m3-input-lg" name="keywords" id="keywords" value="{{ d.keywords }}" placeholder=" ">
                            <label class="m3-floating-label">{{ lang.mod_content_category.admin.columns.keywords }}</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="m3-input-wrapper">
                            <input type="text" class="m3-input-lg" name="description" id="description" value="{{ d.description }}" placeholder=" ">
                            <label class="m3-floating-label">{{ lang.mod_content_category.admin.columns.description }}</label>
                        </div>
                    </div>
                </div>
			</div>

		</div>
	</form>
{% endblock %}

{% block fixed_bottom %}
	<div class="standard-toolbar">
		<a href="{{ site.saddress }}mod_content_category/list" class="m3-btn-half m3-btn-half-neutral">
			<i class="bi bi-x-lg"></i>
			<span>{{ lang.mod_content_category.button.cancel }}</span>
		</a>
		<button type="submit" form="editForm" name="edit" value="1" class="m3-btn-half m3-btn-half-primary">
			<i class="bi bi-check-lg"></i>
			<span>{{ lang.mod_content_category.button.edit }}</span>
		</button>
	</div>
{% endblock %}

{% block scripts %}
    <script src="/templates/admin/assets/js/mod_content_category.js"></script>
{% endblock %}
