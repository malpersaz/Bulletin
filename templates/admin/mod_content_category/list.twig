{% set hide_navbar = true %}
{% set hide_fab = true %}
{% extends "admin/layout.twig" %}

{% block title %}{{ lang.mod_content_category.list }}{% endblock %}
{% block headline %}{{ lang.mod_content_category.list }}{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="/templates/admin/assets/css/mod_content_category.css">
{% endblock %}

{% macro render_tree(items, parent_id, level) %}
    {% for entry in items %}
        {% set is_child = false %}
        {% if parent_id == 0 %}
            {% if entry.parent_id is empty or entry.parent_id == 0 or entry.parent_id == '0' %} {% set is_child = true %} {% endif %}
        {% else %}
            {% if entry.parent_id == parent_id %} {% set is_child = true %} {% endif %}
        {% endif %}

        {% if is_child %}
            <div class="category-node" data-id="{{ entry.id }}" data-parent="{{ entry.parent_id }}" data-name="{{ entry.name|lower }}">
                <div class="m3-list-card">
                    <div class="drag-handle"><i class="bi bi-grip-vertical"></i></div>
                    
                    <button class="toggle-btn" type="button">
                        <i class="bi bi-chevron-down"></i>
                    </button>

                    <div class="card-thumb">
                        {% if entry.image %}
                            <img src="{{ site.saddress }}static/mod_content_category/thumb/{{ entry.image }}" alt="{{ entry.name }}">
                        {% else %}
                            <i class="bi bi-folder2-fill"></i>
                        {% endif %}
                    </div>

                    <div class="card-info">
                        <div class="card-title">{{ entry.name }}</div>
                        <div class="card-meta">
                            {% if entry.lang %} <span class="meta-badge">{{ entry.lang|upper }}</span> {% endif %}
                            <span class="meta-id">#{{ entry.id }}</span>
                        </div>
                    </div>
                </div>
                
                {% if entry.id != parent_id and level < 20 %}
                <div class="list-children">
                    {{ _self.render_tree(items, entry.id, level + 1) }}
                </div>
                {% endif %}
            </div>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% block content %}
    <div class="content-list" id="categoryRootList">
        
        <!-- Reorder Toggle Bar -->
        <div class="reorder-controller">
            <button id="reorderToggleBtn" class="btn-m3-tonal" type="button">
                <i class="bi bi-lock-fill" id="reorderIcon"></i>
                <span id="reorderText">{{ lang.mod_content_category.actions.unlock_reorder|default('Unlock Reorder') }}</span>
            </button>
        </div>

        {% if all_categories is defined and all_categories|length > 0 %}
             {{ _self.render_tree(all_categories, 0, 0) }}
        {% else %}
            <div class="empty-state-container">
                <div class="empty-icon-box">
                    <i class="bi bi-folder2-open"></i>
                </div>
                <h2 class="empty-state-title">{{ lang.mod_content_category.empty.no_categories|default('No categories found') }}</h2>
                <a href="{{ site.saddress }}mod_content_category/add" class="toolbar-fab toolbar-fab-static">
                    <i class="bi bi-plus-lg"></i>
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button id="toolbarEdit" class="toolbar-item disabled" type="button">
            <i class="bi bi-pencil-fill"></i>
            <span>{{ lang.mod_content_category.button.edit }}</span>
        </button>
        
        <a href="{{ site.saddress }}mod_content_category/add" class="toolbar-fab">
            <i class="bi bi-plus-lg"></i>
        </a>

        <button id="toolbarDelete" class="toolbar-item disabled" type="button">
            <i class="bi bi-trash3-fill"></i>
            <span>{{ lang.mod_content_category.button.delete }}</span>
        </button>
    </div>
{% endblock %}

{% block scripts %}
    <script src="/templates/admin/assets/js/mod_content_category.js"></script>
{% endblock %}
