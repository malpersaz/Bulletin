{% set module_lang_key = 'mod_video_embed' %}
{% set hide_fab = true %}
{% set hide_search = true %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set show_extra_sheets = false %}
{% extends 'admin/layout.twig' %}
{% block title %}{{ lang.mod_video_embed.named }}{% endblock %}
{% block headline %}{{ lang.mod_video_embed.named }}{% endblock %}

{% macro select_nested_category_id_function(parent_id, level) %}
    {% for entry in attribute(select_nested_category_id_result, parent_id) %}
        {% set parent_id = entry.id %}
        {% if (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#') %}
            <optgroup label="{{ '-'|repeat(level) }}{{ entry.name }}{% if entry.lang is defined %} ({{ entry.lang }}){% endif %}">
        {% else %}
            <option
                value="{{ entry.id }}"
                {% if entry.lang is defined %}data-lang="{{ entry.lang|upper }}"{% endif %}
                data-trigger-label="{{ entry.name|e('html_attr') }}"
            >
                {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.name }}
                {% if entry.lang is defined %}({{ entry.lang }}){% endif %}
            </option>
        {% endif %}
        {% if attribute(select_nested_category_id_result, parent_id) is not empty and attribute(select_nested_category_id_result, parent_id) is iterable %}
            {{ _self.select_nested_category_id_function(parent_id, level + 1) }}
        {% endif %}
        {% if (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#') %}
            </optgroup>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% block content %}
<div class="form-container">
    {% if error is defined %}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                Swal.fire({
                    icon: 'warning',
                    html: '<b><i class="bi bi-exclamation-triangle-fill"></i> {{ mesaj }}</b>',
                    confirmButtonText: '{{ lang.mod_video_embed.button.tamam }}',
                    confirmButtonColor: '#ba1a1a'
                });
            });
        </script>
    {% endif %}
    {% if oke is defined %}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                Swal.fire({
                    icon: 'success',
                    html: '<b><i class="bi bi-check-circle-fill"></i> {{ mesaj }}</b>',
                    showCancelButton: true,
                    confirmButtonText: '{{ lang.mod_video_embed.list }}',
                    cancelButtonText: '{{ lang.mod_video_embed.button.add }}',
                    confirmButtonColor: '#2e7d32',
                    cancelButtonColor: '#6750a4'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        window.location.href = '{{ site.sadres }}mod_video_embed/list';
                    } else {
                        window.location.href = '{{ site.sadres }}mod_video_embed/add';
                    }
                });
            });
        </script>
    {% endif %}
    {% if hatalar is defined %}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                let errorHtml = '<div style="text-align: left;">';
                {% for hata in hatalar %}
                    errorHtml += '<div style="margin-bottom: 8px;"><i class="bi bi-exclamation-triangle-fill" style="color: #ba1a1a;"></i> <b>{{ hata }}</b></div>';
                {% endfor %}
                errorHtml += '</div>';
                Swal.fire({
                    icon: 'warning',
                    html: errorHtml,
                    confirmButtonText: '{{ lang.mod_video_embed.button.tamam }}',
                    confirmButtonColor: '#ba1a1a'
                });
            });
        </script>
    {% endif %}

    <form method="POST" action="" id="videoAddForm" enctype="multipart/form-data">

        <div class="m3-card">
            <div class="form-group">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.embed }}</label>
                <textarea name="embed" id="embedInput" rows="3" class="form-input" style="resize:vertical; font-family: 'Fira Code', 'Cascadia Code', monospace; font-size: 13px;" required>{{ embed|default('') }}</textarea>
            </div>
            <div class="form-group" style="display: flex; gap: 12px; align-items: center; margin-top: -8px;">
                <button type="button" id="autofillButton" class="toolbar-item active" style="width: auto; padding-inline: 16px;">
                    <i class="bi bi-magic"></i>
                    <span>{{ lang.mod_video_embed.autofill.button }}</span>
                </button>
                <span id="autofillStatus" style="font-size: 13px; opacity: 0.72;">{{ lang.mod_video_embed.autofill.hint }}</span>
            </div>
            <div id="embedPreview" class="embed-preview">
                <div class="embed-placeholder">
                    <i class="bi bi-play-circle" style="font-size: 56px; opacity: 0.6;"></i>
                    <span style="font-size: 13px; opacity: 0.5; margin-top: 8px;">{{ lang.mod_video_embed.admin.columns.onizleme }}</span>
                </div>
            </div>
        </div>

        <div class="m3-card">
            <div class="form-group">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.name }}</label>
                <input type="text" name="name" id="nameInput" value="{{ name|default('') }}" class="form-input" required>
            </div>

            <div class="form-group">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.original }}</label>
                <input type="text" name="original" value="{{ original|default('') }}" class="form-input" placeholder="{{ lang.mod_video_embed.placeholder.original }}">
            </div>

            <div class="form-group">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.sure }}</label>
                <input type="text" name="sure" value="{{ sure|default('') }}" class="form-input" placeholder="{{ lang.mod_video_embed.placeholder.sure }}" required>
            </div>
            <div class="form-group">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.tarih }}</label>
                <input type="datetime-local" name="created_at" id="tarihInput" value="{{ created_at|default('')|replace({' ': 'T'}) }}" class="form-input" required>
            </div>
        </div>

        <div class="m3-card">
            <div class="form-group" style="display:flex; gap: 16px;">
                <div style="flex: 1;">
                    <label class="form-label">{{ lang.mod_video_embed.admin.columns.language }}</label>
                    <div class="select-wrapper">
                        <select name="lang" id="langSelect" class="form-select" required>
                            {% for item in lang_lang %}
                                <option value="{{ item.seo }}" {% if lang_value is defined and lang_value == item.seo %} selected {% endif %}>{{ item.name }} ({{ item.seo|upper }})</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div style="flex: 1;">
                    <label class="form-label">{{ lang.mod_video_embed.admin.columns.status }}</label>
                    <div class="select-wrapper">
                        <select name="status" class="form-select">
                            <option value="y" {% if status is not defined or status == 'y' %} selected {% endif %}>{{ lang.mod_video_embed.admin.radio.publish_yes }}</option>
                            <option value="n" {% if status is defined and status == 'n' %} selected {% endif %}>{{ lang.mod_video_embed.admin.radio.publish_no }}</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.category_id }}</label>
                <div class="select-wrapper">
                    <select
                        name="category_id"
                        id="categorySelect"
                        class="form-select select-picker-native"
                        data-picker-sheet="category"
                        data-picker-title="{{ lang.mod_video_embed.admin.columns.category_id }}"
                        data-picker-placeholder="{{ lang.mod_video_embed.choose_wish }}"
                        data-picker-lang-source="langSelect"
                    >
                        <option value="0">{{ lang.mod_video_embed.choose_wish }}</option>
                        {{ _self.select_nested_category_id_function(0, 0) }}
                    </select>
                    <div class="m3-fake-select select-picker-trigger" data-picker-trigger-for="categorySelect">
                        <span class="select-picker-label">{{ lang.mod_video_embed.choose_wish }}</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.acl_id }}</label>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div class="select-wrapper" style="flex: 1;">
                        <select name="acl_id" id="aclSelect" class="form-select">
                            <option value="0">{{ lang.mod_video_embed.choose_wish }}</option>
                            {% for item in mod_acl_acl_id %}
                                <option value="{{ item.id }}" {% if acl_id is defined and acl_id == item.id %} selected {% endif %}>{{ item.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <a href="{{ site.sadres }}mod_acl/list" class="acl-settings-btn" title="{{ lang.management.acl }}">
                        <i class="bi bi-gear" style="font-size: 20px;"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="m3-card">
            <div class="form-group">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.content }}</label>
                <textarea name="content" id="videoContent" rows="5" class="form-input" style="min-height: 120px;">{{ content|default('') }}</textarea>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.image }}</label>
                <label for="resimInput" class="image-upload-area" id="imageUploadArea">
                    <i class="bi bi-cloud-arrow-up-fill upload-icon"></i>
                    <p class="upload-text">{{ lang.mod_video_embed.wizard.label.upload_text }}</p>
                </label>
                <input type="file" name="image" id="resimInput" accept="image/*" style="display: none;" onchange="previewEditImage(this)">
                <input type="hidden" name="autofill_image" id="autofillImageInput" value="{{ autofill_image|default('') }}">
            </div>
        </div>

        <div class="m3-card">
            <div class="card-title">
                <i class="bi bi-search"></i> {{ lang.mod_video_embed.seo_title }}
            </div>
            <div class="form-group">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.seo_preview }}</label>
                <input type="text" id="seoPreviewInput" class="form-input" value="" readonly>
                <small style="display:block; margin-top:8px; opacity:0.68;">{{ lang.mod_video_embed.admin.help.seo_preview }}</small>
            </div>
            <div class="form-group">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.title }}</label>
                <input type="text" name="title" id="titleInput" value="{{ title|default('') }}" class="form-input" required>
            </div>
            <div class="form-group">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.keywords }}</label>
                <input type="text" name="keywords" id="keywordsInput" value="{{ keywords|default('') }}" class="form-input" required>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.aciklama }}</label>
                <input type="text" name="description" id="aciklamaInput" value="{{ description|default('') }}" class="form-input" required>
            </div>
        </div>

    </form>
</div>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button class="toolbar-item active" onclick="window.location.href='{{ site.sadres }}mod_video_embed/list'">
            <i class="bi bi-x-lg"></i>
            <span>{{ lang.mod_video_embed.button.cancel }}</span>
        </button>

        <div class="toolbar-fab" onclick="document.getElementById('videoAddForm').submit()">
            <i class="bi bi-check-lg"></i>
        </div>

        <button class="toolbar-item active" onclick="document.getElementById('videoAddForm').submit()">
            <i class="bi bi-floppy-fill"></i>
            <span>{{ lang.mod_video_embed.button.save }}</span>
        </button>
    </div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const STORAGE_KEY = 'videoEmbedAddForm_v2';
    const form = document.getElementById('videoAddForm');
    const siteBase = '{{ site.sadres }}';
    const embedInput = document.getElementById('embedInput');
    const embedPreview = document.getElementById('embedPreview');
    const originalInput = form?.querySelector('[name="original"]');
    const nameInput = document.getElementById('nameInput');
    const titleInput = document.getElementById('titleInput');
    const keywordsInput = document.getElementById('keywordsInput');
    const descriptionInput = document.getElementById('aciklamaInput');
    const contentInput = document.getElementById('videoContent');
    const durationInput = form?.querySelector('[name="sure"]');
    const dateInput = document.getElementById('tarihInput');
    const autofillButton = document.getElementById('autofillButton');
    const autofillStatus = document.getElementById('autofillStatus');
    const autofillImageInput = document.getElementById('autofillImageInput');
    let autofillTimer = null;
    let lastAutofillSignature = '';
    let autofillInFlight = false;

    function cleanMetaText(value) {
        let cleaned = (value || '').toString();
        cleaned = cleaned.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, ' ');
        cleaned = cleaned.trim();

        for (let i = 0; i <= 15; i += 1) {
            cleaned = cleaned.replace(/  /g, ' ');
        }

        return cleaned;
    }

    function saveFormData() {
        if (!form) return;
        const data = {};
        const fields = form.querySelectorAll('input[name], select[name], textarea[name]');
        fields.forEach(function(el) {
            if (el.type === 'file' || el.type === 'hidden') return;
            data[el.name] = el.value;
        });
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    }

    function restoreFormData() {
        if (!form) return;
        const saved = localStorage.getItem(STORAGE_KEY);
        if (!saved) return;
        try {
            const data = JSON.parse(saved);
            Object.keys(data).forEach(function(name) {
                const el = form.querySelector('[name="' + name + '"]');
                if (!el || el.type === 'file' || el.type === 'hidden') return;
                el.value = data[name];
            });
            document.getElementById('langSelect')?.dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('categorySelect')?.dispatchEvent(new Event('change', { bubbles: true }));
        } catch (error) {}
    }

    {% if oke is defined %}
        localStorage.removeItem(STORAGE_KEY);
    {% endif %}

    {% if oke is not defined %}
        restoreFormData();
    {% endif %}

    if (form) {
        form.addEventListener('input', saveFormData);
        form.addEventListener('change', saveFormData);
    }

    function updateEmbedPreview() {
        if (!embedInput || !embedPreview) return;
        if (embedInput.value.trim()) {
            embedPreview.innerHTML = embedInput.value;
            embedPreview.classList.add('has-content');
        } else {
            embedPreview.innerHTML = '<div class="embed-placeholder"><i class="bi bi-play-circle" style="font-size: 56px; opacity: 0.6;"></i><span style="font-size: 13px; opacity: 0.5; margin-top: 8px;">{{ lang.mod_video_embed.admin.columns.onizleme }}</span></div>';
            embedPreview.classList.remove('has-content');
        }
    }

    function setAutofillStatus(message, isError = false) {
        if (!autofillStatus) return;
        autofillStatus.textContent = message;
        autofillStatus.style.color = isError ? '#ba1a1a' : '';
    }

    function makeKeywordFallback(value) {
        return cleanMetaText(value)
            .replace(/\s+/g, ',')
            .toLowerCase()
            .replace(/İ/g, 'i');
    }

    function setFieldValue(input, value) {
        if (!input || !value) return;
        if (input.value && input.dataset.autofilled !== 'true') return;
        input.value = value;
        input.dataset.autofilled = 'true';
    }

    function setTextAreaValue(input, value) {
        if (!input || !value) return;
        if (input.value && input.dataset.autofilled !== 'true') return;
        input.value = value;
        input.dataset.autofilled = 'true';
    }

    function renderStoredImage(url) {
        const area = document.getElementById('imageUploadArea');
        if (!area || !url) return;
        area.innerHTML = `
            <img id="editImgPreview" src="${url}" class="current-image">
            <button type="button" class="remove-img-btn" onclick="clearSelectedImage()"><i class="bi bi-x-lg"></i></button>
        `;
    }

    function slugifyVideoName(value) {
        let slug = cleanMetaText(value);
        slug = slug.replace(/\s+/g, '_');
        slug = slug.replace(/İ/g, 'i');

        for (let i = 0; i <= 5; i += 1) {
            slug = slug.replace(/__/g, '_');
        }

        return slug || 'video';
    }

    function ensureSeoFields() {
        const sourceValue = (nameInput?.value || titleInput?.value || '').trim();
        if (!sourceValue) return;

        const cleanedValue = cleanMetaText(sourceValue);

        if (titleInput && !titleInput.value.trim()) {
            titleInput.value = cleanedValue;
            titleInput.dataset.autofilled = 'true';
        }

        if (keywordsInput && !keywordsInput.value.trim()) {
            keywordsInput.value = makeKeywordFallback(sourceValue);
            keywordsInput.dataset.autofilled = 'true';
        }

        if (descriptionInput && !descriptionInput.value.trim()) {
            descriptionInput.value = cleanedValue;
            descriptionInput.dataset.autofilled = 'true';
        }
    }

    function updateSeoPreview() {
        const seoPreviewInput = document.getElementById('seoPreviewInput');
        if (!seoPreviewInput) return;
        const slug = slugifyVideoName(nameInput?.value || titleInput?.value || '');
        seoPreviewInput.value = `${siteBase}video/{id}-${slug}`;
    }

    async function runAutofill(force = false) {
        if (!embedInput || autofillInFlight) return;

        const signature = `${embedInput.value.trim()}|${originalInput?.value.trim() || ''}`;
        if (!signature.trim()) return;
        if (!force && signature === lastAutofillSignature) return;

        autofillInFlight = true;
        if (autofillButton) {
            autofillButton.disabled = true;
        }
        setAutofillStatus('{{ lang.mod_video_embed.autofill.loading }}');

        try {
            const response = await fetch(`${siteBase}mod_video_embed/autofill_metadata`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams({
                    embed: embedInput.value,
                    original: originalInput?.value || '',
                    ajax_request: '1'
                }).toString()
            });

            const result = await response.json();
            if (!response.ok || result.status !== 'success' || !result.data) {
                throw new Error(result.message || '{{ lang.mod_video_embed.autofill.error }}');
            }

            const data = result.data;
            setFieldValue(nameInput, data.name || '');
            setFieldValue(titleInput, data.title || '');
            setFieldValue(keywordsInput, data.keywords || '');
            setFieldValue(descriptionInput, data.description || '');
            setTextAreaValue(contentInput, data.content || '');
            if (durationInput && data.duration) {
                setFieldValue(durationInput, data.duration);
            }
            if (originalInput && (!originalInput.value || originalInput.dataset.autofilled === 'true')) {
                originalInput.value = data.original || originalInput.value;
                originalInput.dataset.autofilled = 'true';
            }
            if (embedInput && data.embed) {
                embedInput.value = data.embed;
                embedInput.dataset.autofilled = 'true';
            }
            if (autofillImageInput && data.image) {
                autofillImageInput.value = data.image;
            }
            if (data.image_url) {
                renderStoredImage(data.image_url);
                const fileInput = document.getElementById('resimInput');
                if (fileInput) {
                    fileInput.value = '';
                }
            }

            ensureSeoFields();
            updateEmbedPreview();
            updateSeoPreview();
            saveFormData();
            lastAutofillSignature = signature;
            if (data.duration_available) {
                setAutofillStatus(result.message || '{{ lang.mod_video_embed.autofill.success }}');
            } else {
                setAutofillStatus('{{ lang.mod_video_embed.autofill.partial }}');
            }
        } catch (error) {
            setAutofillStatus(error.message || '{{ lang.mod_video_embed.autofill.error }}', true);
        } finally {
            autofillInFlight = false;
            if (autofillButton) {
                autofillButton.disabled = false;
            }
        }
    }

    if (embedInput) {
        embedInput.addEventListener('input', function() {
            updateEmbedPreview();
            window.clearTimeout(autofillTimer);
            autofillTimer = window.setTimeout(() => runAutofill(false), 900);
        });
    }

    if (originalInput) {
        originalInput.addEventListener('input', function() {
            window.clearTimeout(autofillTimer);
            autofillTimer = window.setTimeout(() => runAutofill(false), 900);
        });
    }

    if (nameInput) {
        nameInput.addEventListener('input', function() {
            const value = this.value;
            const cleanedValue = cleanMetaText(value);
            if (titleInput && (!titleInput.value || titleInput.dataset.autofilled !== 'false')) {
                titleInput.value = cleanedValue;
                titleInput.dataset.autofilled = 'true';
            }
            if (keywordsInput && (!keywordsInput.value || keywordsInput.dataset.autofilled !== 'false')) {
                keywordsInput.value = makeKeywordFallback(value);
                keywordsInput.dataset.autofilled = 'true';
            }
            if (descriptionInput && (!descriptionInput.value || descriptionInput.dataset.autofilled !== 'false')) {
                descriptionInput.value = cleanedValue;
                descriptionInput.dataset.autofilled = 'true';
            }
            saveFormData();
            updateSeoPreview();
        });
    }

    ['titleInput', 'keywordsInput', 'aciklamaInput', 'videoContent'].forEach(function(id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('input', function() {
            el.dataset.autofilled = 'false';
            saveFormData();
        });
    });

    if (dateInput && !dateInput.value) {
        const now = new Date();
        const local = new Date(now.getTime() - (now.getTimezoneOffset() * 60000));
        dateInput.value = local.toISOString().slice(0, 16);
        saveFormData();
    }

    if (form) {
        const hiddenBtn = document.createElement('input');
        hiddenBtn.type = 'hidden';
        hiddenBtn.name = 'add';
        hiddenBtn.value = '{{ lang.mod_video_embed.button.add }}';
        form.appendChild(hiddenBtn);

        form.addEventListener('submit', function(event) {
            const restrictedFields = [nameInput, titleInput, keywordsInput, descriptionInput, contentInput];
            const hasUnsupportedCharacter = restrictedFields.some(function(field) {
                return field && /[\u{10000}-\u{10FFFF}]/u.test(field.value || '');
            });

            if (hasUnsupportedCharacter) {
                event.preventDefault();
                Swal.fire({
                    icon: 'warning',
                    text: '{{ lang.mod_video_embed.validator.unsupported_emoji|e('js')|replace({'%s': lang.mod_video_embed.admin.columns.content|e('js')}) }}',
                    confirmButtonText: '{{ lang.mod_video_embed.button.tamam|e('js') }}',
                    confirmButtonColor: '#ba1a1a'
                });
            }
        });
    }

    if (typeof initSelectPickerSheets === 'function') {
        initSelectPickerSheets();
    }

    if (autofillButton) {
        autofillButton.addEventListener('click', function() {
            runAutofill(true);
        });
    }

    {% if autofill_image is defined and autofill_image %}
        renderStoredImage('{{ site.radres }}mod_video_embed/thumb/{{ autofill_image }}?v={{ "now"|date("U") }}');
    {% endif %}

    ensureSeoFields();
    updateEmbedPreview();
    updateSeoPreview();
});
</script>

<link rel="stylesheet" href="/templates/admin/assets/css/mod_video_embed.css">
<script>
function previewEditImage(input) {
    if (input.files && input.files[0]) {
        const autofillImageInput = document.getElementById('autofillImageInput');
        if (autofillImageInput) {
            autofillImageInput.value = '';
        }
        const reader = new FileReader();
        reader.onload = function (e) {
            const area = document.getElementById('imageUploadArea');
            area.innerHTML = `
                <img id="editImgPreview" src="${e.target.result}" class="current-image">
                <button type="button" class="remove-img-btn" onclick="clearSelectedImage()"><i class="bi bi-x-lg"></i></button>
            `;
        }
        reader.readAsDataURL(input.files[0]);
    }
}

function clearSelectedImage() {
    const input = document.getElementById('resimInput');
    const autofillImageInput = document.getElementById('autofillImageInput');
    input.value = '';
    if (autofillImageInput) {
        autofillImageInput.value = '';
    }
    const area = document.getElementById('imageUploadArea');
    area.innerHTML = `
        <i class="bi bi-cloud-arrow-up-fill upload-icon"></i>
