{% set module_lang_key = 'mod_video_embed' %}
{% set hide_fab = true %}
{% set hide_search = true %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set show_extra_sheets = false %}
{% extends is_ajax ? 'admin/layout_blank.twig' : 'admin/layout.twig' %}
{% block title %}{{ lang.mod_video_embed.named }}{% endblock %}
{% block headline %}{{ lang.mod_video_embed.named }}{% endblock %}

{% block styles %}
    {% if not is_ajax %}{{ parent() }}{% endif %}
    <link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/mod_video_embed.css?v=2.1">
{% endblock %}

{% macro select_nested_category_id_function(parent_id, level, allowed_langs) %}
    {% for entry in attribute(select_nested_category_id_result, parent_id) %}
        {% set parent_id = entry.id %}
        {% set entry_lang = entry.lang is defined ? entry.lang|lower : '' %}
        {% set is_allowed = entry_lang == '' or entry_lang in allowed_langs %}
        {% if is_allowed %}
            {% if (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#') %}
                <optgroup label="{{ '-'|repeat(level) }}{{ entry.name }}{% if entry.lang is defined %} ({{ entry.lang }}){% endif %}">
            {% else %}
                <option
                    value="{{ entry.id }}"
                    {% if entry.lang is defined %}data-lang="{{ entry.lang|upper }}"{% endif %}
                    data-trigger-label="{{ entry.name|e('html_attr') }}"
                >
                    {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.name }}
                    {% if entry.lang is defined %}({{ entry.lang }}){% endif %}
                </option>
            {% endif %}
        {% endif %}
        {% if attribute(select_nested_category_id_result, parent_id) is not empty and attribute(select_nested_category_id_result, parent_id) is iterable %}
            {{ _self.select_nested_category_id_function(parent_id, level + 1, allowed_langs) }}
        {% endif %}
        {% if is_allowed and ((entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#')) %}
            </optgroup>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% block content %}
{% set selected_lang = lang_value is defined ? lang_value : site.lang %}
{% set allowed_langs = [] %}
{% for item in lang_lang %}
    {% if item.status == 'y' or item.seo == selected_lang %}
        {% set allowed_langs = allowed_langs|merge([item.seo|lower]) %}
    {% endif %}
{% endfor %}
<div class="form-container" data-modal-title="{{ lang.mod_video_embed.named }}" data-modal-icon="bi-camera-video">
    {% if success is defined %}
        <div class="banner-m3 banner-success-soft">
            <i class="bi bi-check-circle-fill"></i>
            <span>{{ message|default(lang.mod_video_embed.message.success.add) }}</span>
        </div>
    {% endif %}
    {% if error is defined and errors is not defined %}
        <div class="banner-m3 banner-error-soft">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>{{ message|default(lang.mod_video_embed.error) }}</span>
        </div>
    {% endif %}
    {% if errors is defined and errors is not empty %}
        <div class="banner-m3 banner-error-soft">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                {% for err in errors %}
                    <div>{{ err }}</div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <form
        method="POST"
        action="{{ site.saddress }}mod_video_embed/add"
        id="videoAddForm"
        enctype="multipart/form-data"
        data-id="{id}"
        data-site-address="{{ site.saddress }}"
        data-i18n-ok="{{ lang.mod_video_embed.button.ok|e('html_attr') }}"
        data-i18n-yes="{{ lang.mod_video_embed.button.yes|e('html_attr') }}"
        data-i18n-no="{{ lang.mod_video_embed.button.no|e('html_attr') }}"
        data-i18n-cancel="{{ lang.mod_video_embed.button.cancel|e('html_attr') }}"
        data-i18n-save="{{ lang.mod_video_embed.button.save|e('html_attr') }}"
        data-i18n-info="{{ lang.mod_video_embed.information|e('html_attr') }}"
        data-i18n-error="{{ lang.mod_video_embed.error|e('html_attr') }}"
        data-i18n-success="{{ lang.mod_video_embed.success|e('html_attr') }}"
        data-i18n-image-update-confirm="{{ lang.mod_video_embed.image_update_confirm|e('html_attr') }}"
        data-i18n-remove-image-title="{{ lang.mod_video_embed.remove_image|e('html_attr') }}"
        data-i18n-remove-image-confirm="{{ lang.mod_video_embed.delete_confirm|e('html_attr') }}"
        data-i18n-remove-image-success="{{ lang.mod_video_embed.remove_image_success|e('html_attr') }}"
        data-i18n-unsupported-emoji="{{ lang.mod_video_embed.validator.unsupported_emoji|replace({'%s': lang.mod_video_embed.admin.columns.content})|e('html_attr') }}"
        data-i18n-autofill-missing="{{ lang.mod_video_embed.autofill.missing_source|e('html_attr') }}"
        data-i18n-autofill-invalid="{{ lang.mod_video_embed.autofill.invalid_source|e('html_attr') }}"
        data-i18n-autofill-loading="{{ lang.mod_video_embed.autofill.loading|e('html_attr') }}"
        data-i18n-autofill-success="{{ lang.mod_video_embed.autofill.success|e('html_attr') }}"
        data-i18n-autofill-partial="{{ lang.mod_video_embed.autofill.partial|e('html_attr') }}"
        data-i18n-autofill-error="{{ lang.mod_video_embed.autofill.error|e('html_attr') }}"
        data-i18n-missing-duration="{{ lang.mod_video_embed.admin.columns.duration|e('html_attr') }}"
        data-i18n-missing-image="{{ lang.mod_video_embed.admin.columns.image|e('html_attr') }}"
        data-i18n-missing-content="{{ lang.mod_video_embed.admin.columns.content|e('html_attr') }}"
        data-i18n-upload-text="{{ lang.mod_video_embed.wizard.label.upload_text|e('html_attr') }}"
        data-i18n-preview-text="{{ lang.mod_video_embed.admin.columns.preview|e('html_attr') }}"
        data-i18n-fallback-slug="{{ lang.mod_video_embed.js_fallback.video|e('html_attr') }}"
    >
        <input type="hidden" name="add" value="{{ lang.mod_video_embed.button.add }}">
        <input type="hidden" name="target_module" id="videoTargetModule" value="{{ target_module|default('') }}">
        <input type="hidden" name="target_id" id="videoTargetId" value="{{ target_id|default('') }}">

        {# Card 1: Embed Code + Live Preview + Textless Loading Indicator #}
        <div class="m3-card" id="embedCard">
            <div class="form-group mb-2">
                <label class="form-label" for="embedInput">{{ lang.mod_video_embed.admin.columns.embed }}</label>
                <textarea name="embed" id="embedInput" rows="3" class="form-input embed-code-input" required>{{ embed|default('') }}</textarea>
            </div>
            <div class="embed-fetch-bar-track" id="embedFetchBar" aria-hidden="true">
                <div class="embed-fetch-bar-indeterminate"></div>
            </div>
            <div id="embedPreview" class="embed-preview{% if embed is defined and embed != '' %} has-content{% endif %}">
                <div class="embed-fetch-spinner" aria-hidden="true">
                    <span class="embed-spinner-ring"></span>
                </div>
                {% if embed is defined and embed != '' %}
                    {{ embed|raw }}
                {% else %}
                    <div class="embed-placeholder">
                        <i class="bi bi-play-circle embed-placeholder-icon"></i>
                        <span class="embed-placeholder-text">{{ lang.mod_video_embed.admin.columns.preview }}</span>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Card 2: Basic Info #}
        <div class="m3-card">
            <div class="form-group">
                <label class="form-label" for="nameInput">{{ lang.mod_video_embed.admin.columns.name }}</label>
                <input type="text" name="name" id="nameInput" value="{{ name|default('') }}" class="form-input" autocomplete="off" required>
            </div>

            <div class="form-group">
                <label class="form-label" for="originalInput">{{ lang.mod_video_embed.admin.columns.original }}</label>
                <input type="text" name="original" id="originalInput" value="{{ original|default('') }}" class="form-input" placeholder="{{ lang.mod_video_embed.placeholder.original }}">
            </div>

            <div class="form-row-2col">
                <div class="form-col form-group">
                    <label class="form-label" for="durationInput">{{ lang.mod_video_embed.admin.columns.duration }}</label>
                    <input type="text" name="sure" id="durationInput" value="{{ sure|default('') }}" class="form-input" placeholder="{{ lang.mod_video_embed.placeholder.duration }}" required>
                </div>
                <div class="form-col form-group">
                    <label class="form-label" for="dateInput">{{ lang.mod_video_embed.admin.columns.date }}</label>
                    <input type="datetime-local" name="created_at" id="dateInput" value="{{ created_at|default('now'|date('Y-m-d') ~ 'T' ~ 'now'|date('H:i'))|replace({' ': 'T'}) }}" class="form-input" required>
                </div>
            </div>
        </div>

        {# Card 3: Settings #}
        <div class="m3-card">
            <div class="form-row-2col">
                <div class="form-col form-group">
                    <label class="form-label" for="langSelect">{{ lang.mod_video_embed.admin.columns.language }}</label>
                    <div class="select-wrapper">
                        <select name="lang" id="langSelect" class="form-select" required>
                            {% for item in lang_lang %}
                                {% if item.status == 'y' or item.seo == selected_lang %}
                                    <option value="{{ item.seo }}"{% if selected_lang == item.seo %} selected{% endif %}>{{ item.name }} ({{ item.seo|upper }})</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="form-col form-group">
                    <label class="form-label" for="statusSelect">{{ lang.mod_video_embed.admin.columns.status }}</label>
                    <div class="select-wrapper">
                        <select name="status" id="statusSelect" class="form-select">
                            <option value="y"{% if status is not defined or status == 'y' %} selected{% endif %}>{{ lang.mod_video_embed.admin.radio.publish_yes }}</option>
                            <option value="n"{% if status is defined and status == 'n' %} selected{% endif %}>{{ lang.mod_video_embed.admin.radio.publish_no }}</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="categorySelect">{{ lang.mod_video_embed.admin.columns.category_id }}</label>
                <div class="select-wrapper">
                    <select
                        name="category_id"
                        id="categorySelect"
                        class="form-select select-picker-native"
                        data-picker-sheet="category"
                        data-picker-title="{{ lang.mod_video_embed.admin.columns.category_id }}"
                        data-picker-placeholder="{{ lang.mod_video_embed.choose_wish }}"
                        data-picker-lang-source="langSelect"
                    >
                        <option value="0">{{ lang.mod_video_embed.choose_wish }}</option>
                        {{ _self.select_nested_category_id_function(0, 0, allowed_langs) }}
                    </select>
                    <div class="m3-fake-select select-picker-trigger" data-picker-trigger-for="categorySelect">
                        <span class="select-picker-label">{{ lang.mod_video_embed.choose_wish }}</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>
            </div>

            <div class="form-group mb-0">
                <label class="form-label" for="aclSelect">{{ lang.mod_video_embed.admin.columns.acl_id }}</label>
                <div class="acl-row">
                    <div class="select-wrapper acl-select-wrap">
                        <select name="acl_id" id="aclSelect" class="form-select">
                            <option value="0">{{ lang.mod_video_embed.choose_wish }}</option>
                            {% for item in mod_acl_acl_id %}
                                <option value="{{ item.id }}"{% if acl_id is defined and acl_id == item.id %} selected{% endif %}>{{ item.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <a href="{{ site.saddress }}mod_acl/list" class="acl-settings-btn" title="{{ lang.management.acl }}">
                        <i class="bi bi-gear acl-icon"></i>
                    </a>
                </div>
            </div>
        </div>

        {# Card 4: Content + Image #}
        <div class="m3-card">
            <div class="form-group">
                <label class="form-label" for="videoContent">{{ lang.mod_video_embed.admin.columns.content }}</label>
                <textarea name="content" id="videoContent" rows="5" class="form-input content-textarea">{{ content|default('') }}</textarea>
            </div>

            <div class="form-group mb-0">
                <label class="form-label">{{ lang.mod_video_embed.admin.columns.image }}</label>
                <div class="image-upload-area" id="imageUploadArea">
                    {% if autofill_image is defined and autofill_image != '' %}
                        <div class="current-image-wrapper">
                            <img id="editImgPreview" src="{{ site.iaddress }}mod_video_embed/thumb/{{ autofill_image }}" class="current-image" alt="{{ name|default('Video Image') }}">
                            <button type="button" class="remove-img-btn" id="btnRemoveExistingImage" aria-label="{{ lang.mod_video_embed.remove_image }}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    {% else %}
                        <i class="bi bi-cloud-arrow-up-fill upload-icon"></i>
                        <p class="upload-text">{{ lang.mod_video_embed.wizard.label.upload_text }}</p>
                    {% endif %}
                </div>
                <input type="file" name="image" id="imageInput" accept="image/*" class="d-none">
                <input type="hidden" name="autofill_image" id="autofillImageInput" value="{{ autofill_image|default('') }}">
            </div>
        </div>

        {# Card 5: SEO #}
        <div class="m3-card">
            <div class="card-title">
                <i class="bi bi-search"></i> {{ lang.mod_video_embed.seo_title }}
            </div>
            <div class="form-group">
                <label class="form-label" for="seoPreviewInput">{{ lang.mod_video_embed.admin.columns.seo_preview }}</label>
                <input type="text" id="seoPreviewInput" class="form-input" value="" readonly>
                <small class="seo-preview-help">{{ lang.mod_video_embed.admin.help.seo_preview }}</small>
            </div>
            <div class="form-group">
                <label class="form-label" for="titleInput">{{ lang.mod_video_embed.admin.columns.title }}</label>
                <input type="text" name="title" id="titleInput" value="{{ title|default('') }}" class="form-input" required>
            </div>
            <div class="form-group">
                <label class="form-label" for="keywordsInput">{{ lang.mod_video_embed.admin.columns.keywords }}</label>
                <input type="text" name="keywords" id="keywordsInput" value="{{ keywords|default('') }}" class="form-input" required>
            </div>
            <div class="form-group mb-0">
                <label class="form-label" for="descriptionInput">{{ lang.mod_video_embed.admin.columns.description }}</label>
                <input type="text" name="description" id="descriptionInput" value="{{ description|default('') }}" class="form-input" required>
            </div>
        </div>

        {# In-Modal Native Top-Layer AJAX Alert Dialog #}
        <dialog id="videoAutofillAlertDialog" class="m3-ajax-alert-dialog">
            <div class="m3-alert-body">
                <div class="m3-alert-icon-wrapper" id="videoAutofillAlertIcon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h4 class="m3-alert-title" id="videoAutofillAlertTitle">{{ lang.mod_video_embed.information }}</h4>
                <p class="m3-alert-message" id="videoAutofillAlertMessage"></p>
                <div class="m3-alert-details is-hidden" id="videoAutofillAlertDetails">
                    <ul class="m3-alert-list" id="videoAutofillAlertList"></ul>
                </div>
                <div class="m3-alert-actions">
                    <button type="button" class="m3-alert-btn-confirm" id="btnVideoAutofillAlertOk">{{ lang.mod_video_embed.button.ok }}</button>
                </div>
            </div>
        </dialog>

    </form>
</div>
{% endblock %}

{% block fixed_bottom %}
    {% include 'admin/partials/fixed_bottom_form_bar.twig' with {
        cancel_url: site.saddress ~ 'mod_video_embed/list',
        cancel_label: lang.mod_video_embed.button.cancel,
        submit_label: lang.mod_video_embed.button.save,
        form_id: 'videoAddForm'
    } %}
{% endblock %}

{% block scripts %}
    <script src="{{ site.address }}templates/admin/assets/js/mod_video_embed_edit.js?v=2.6"></script>
{% endblock %}
