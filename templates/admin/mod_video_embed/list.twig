{% set module_lang_key = 'mod_video_embed' %}
{% set hide_navbar = true %}
{% set hide_fab = true %}
{% extends is_ajax ? 'admin/layout_blank.twig' : 'admin/layout.twig' %}
{% block title %}{{ lang.mod_video_embed.list }}{% endblock %}

{% block headline %}{{ lang.mod_video_embed.list }}{% endblock %}

{% block styles %}
    {% if not is_ajax %}{{ parent() }}{% endif %}
    <link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/mod_video_embed.css?v=2.1">
{% endblock %}

{% block content %}
<div class="video-embed-list-shell" data-modal-title="{{ lang.mod_video_embed.list }}" data-modal-icon="bi-camera-video">
<!-- PULL TO REFRESH SPINNER -->
<div id="ptr-spinner" class="ptr-spinner">
    <div class="spinner-track">
        <div class="spinner-fill"></div>
    </div>
</div>

<!-- DYNAMIC CONTENT (Cards) -->
<div id="content-list-container" class="content-list"
    data-module-url="{{ site.saddress }}mod_video_embed/"
    data-data-url="{{ site.saddress }}mod_video_embed/datatable_json"
    data-i18n-active="{{ lang.mod_video_embed.status_badge.active|e('html_attr') }}"
    data-i18n-draft="{{ lang.mod_video_embed.status_badge.draft|e('html_attr') }}"
    data-i18n-slider-badge="{{ lang.mod_video_embed.hero_slider_badge|e('html_attr') }}"
    data-i18n-slider-add="{{ lang.mod_video_embed.hero_slider_add|e('html_attr') }}"
    data-i18n-slider-remove="{{ lang.mod_video_embed.hero_slider_remove|e('html_attr') }}"
    data-i18n-slider-added="{{ lang.mod_video_embed.hero_slider_added|e('html_attr') }}"
    data-i18n-slider-removed="{{ lang.mod_video_embed.hero_slider_removed|e('html_attr') }}"
    data-i18n-slider-error="{{ lang.mod_video_embed.hero_slider_error|e('html_attr') }}"
    data-i18n-publish="{{ lang.mod_video_embed.admin.publish.key|e('html_attr') }}"
    data-i18n-unpublish="{{ lang.mod_video_embed.admin.unpublish.key|e('html_attr') }}"
    data-i18n-delete-confirm="{{ lang.mod_video_embed.delete_confirm|e('html_attr') }}"
    data-i18n-publish-confirm="{{ lang.mod_video_embed.quick_publish_confirm|e('html_attr') }}"
    data-i18n-unpublish-confirm="{{ lang.mod_video_embed.quick_unpublish_confirm|e('html_attr') }}"
    data-i18n-error="{{ lang.mod_video_embed.error|e('html_attr') }}"
    data-i18n-yes="{{ lang.mod_video_embed.button.yes|e('html_attr') }}"
    data-i18n-no="{{ lang.mod_video_embed.button.no|e('html_attr') }}"
    data-i18n-loading="{{ lang.mod_video_embed.datatable.loading_records|e('html_attr') }}"
    data-i18n-info="{{ lang.mod_video_embed.information|e('html_attr') }}"
    data-i18n-image-confirm="{{ lang.mod_video_embed.image_update_confirm|e('html_attr') }}"
    data-i18n-cancel="{{ lang.mod_video_embed.button.cancel|e('html_attr') }}"
    data-i18n-ok="{{ lang.mod_video_embed.sheet.ok|e('html_attr') }}"
    data-i18n-load-more="{{ lang.mod_video_embed.grid.load_more|e('html_attr') }}">
    <!-- Cards will be injected here via JS -->
</div>

<!-- EMPTY STATE -->
<div id="empty-state" class="empty-state-container d-none">
    <div class="empty-icon-box">
        <i class="bi bi-camera-video"></i>
    </div>
    <h2 class="fw-800">{{ lang.mod_video_embed.datatable.zero_records }}</h2>
    <p class="color-variant fs-14 mt-4">{{ lang.mod_video_embed.datatable.empty_table }}</p>
</div>

<!-- INFINITE SCROLL LOADER -->
<div id="infinite-loader" class="infinite-loader d-none">
    <div class="spinner-track">
        <div class="spinner-fill"></div>
    </div>
    <span>{{ lang.mod_video_embed.datatable.loading_records }}</span>
</div>

<!-- HIDDEN FILTERS -->
<form id="filterForm" class="d-none">
    <input type="hidden" name="start" id="filterStart" value="0">
    <input type="hidden" name="length" id="filterLength" value="10">
    <input type="hidden" name="draw" id="filterDraw" value="1">
    <input type="hidden" name="search[name]" id="filterSearch" value="">
    <input type="hidden" name="search[lang]" id="filterLang" value="">
    <input type="hidden" name="order[0][column]" id="filterSortColumn" value="1">
    <input type="hidden" name="order[0][dir]" id="filterSortDir" value="desc">
</form>
</div>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button id="toolbarSlider" class="toolbar-item is-disabled" data-action="slider" title="{{ lang.mod_video_embed.hero_slider_add }}">
            <i class="bi bi-stars"></i>
            <span>{{ lang.mod_video_embed.hero_slider_badge }}</span>
        </button>

        <button id="toolbarEdit" class="toolbar-item is-disabled" data-action="edit">
            <i class="bi bi-pencil-fill"></i>
            <span>{{ lang.mod_video_embed.button.edit }}</span>
        </button>
        
        <button id="toolbarImage" class="toolbar-item is-disabled" data-action="image">
            <i class="bi bi-image"></i>
            <span>{{ lang.mod_video_embed.admin.columns.image }}</span>
        </button>

        <button id="toolbarPublish" class="toolbar-item is-disabled" data-action="publish">
            <i id="toolbarPublishIcon" class="bi bi-eye-fill"></i>
            <span id="toolbarPublishText">{{ lang.mod_video_embed.admin.publish.key }}</span>
        </button>

        <button id="toolbarDelete" class="toolbar-item is-disabled" data-action="delete">
            <i class="bi bi-trash3-fill"></i>
            <span>{{ lang.mod_video_embed.button.delete }}</span>
        </button>
    </div>

    <!-- Main FAB Button -->
    <button class="main-fab" id="mainFab" data-href="{{ site.saddress }}mod_video_embed/add" aria-label="{{ lang.mod_video_embed.add }}">
        <i class="bi bi-plus-lg"></i>
    </button>
{% endblock %}

{% block scripts %}
<script src="/templates/admin/assets/js/mod_video_embed.js?v=2.1"></script>
{% endblock %}
