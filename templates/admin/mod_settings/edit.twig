{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}

{% block title %}{{ lang.mod_settings.settings.title }}{% endblock %}
{% block headline %}{{ lang.mod_settings.settings.title }}{% endblock %}

{% macro asset_card(field, setting, selected_lang, label, help_text, accept, preview_type) %}
    {% set value = attribute(setting, field)|default('') %}
    {% set input_name = field == 'logo_path' ? 'logo_' ~ selected_lang : field ~ '_' ~ selected_lang %}
    {% set extension = value and '.' in value ? value|split('.')|last|upper : '' %}
    <section class="settings-asset-card" id="asset-card-{{ field }}">
        <div class="settings-asset-top">
            <div>
                <h3>{{ label }}</h3>
                <p>{{ help_text }}</p>
            </div>
            {% if value %}
                <button
                    class="asset-remove-btn"
                    type="button"
                    title="{{ lang.mod_settings.delete }}"
                    aria-label="{{ lang.mod_settings.delete }}"
                    data-remove-asset="true"
                    data-lang="{{ selected_lang }}"
                    data-field="{{ field }}">
                    <i class="bi bi-trash3"></i>
                    <span class="sr-only">{{ lang.mod_settings.delete }}</span>
                </button>
            {% endif %}
        </div>

        <div class="settings-asset-body">
            <div class="asset-preview" id="asset-preview-{{ field }}">
                {% if value %}
                    {% if preview_type == 'file' %}
                        <div class="asset-file-box">
                            <i class="bi bi-file-earmark-code"></i>
                            {% if extension %}
                                <strong>{{ extension }}</strong>
                            {% endif %}
                            <a
                                href="{{ site.address }}static/mod_settings/{{ value }}"
                                target="_blank"
                                rel="noopener"
                                title="{{ lang.mod_settings.view_file }}"
                                aria-label="{{ lang.mod_settings.view_file }}">
                                <i class="bi bi-box-arrow-up-right"></i>
                                <span class="sr-only">{{ lang.mod_settings.view_file }}</span>
                            </a>
                        </div>
                    {% else %}
                        <img src="{{ site.address }}static/mod_settings/{{ value }}" alt="{{ label }}">
                    {% endif %}
                {% else %}
                    <div class="asset-empty">
                        <i class="bi bi-image"></i>
                        <span>{{ lang.mod_settings.not_uploaded }}</span>
                    </div>
                {% endif %}
            </div>

            <div class="asset-input-col">
                <input type="text" class="m3-input-lg asset-path-input" id="current-{{ field }}" value="{{ value }}" readonly>

                <label
                    class="asset-file-trigger"
                    for="upload-{{ field }}"
                    title="{{ lang.mod_settings.choose_file }}"
                    aria-label="{{ lang.mod_settings.choose_file }}">
                    <i class="bi bi-upload"></i>
                    <span>{{ lang.mod_settings.choose_file }}</span>
                </label>
                <input
                    id="upload-{{ field }}"
                    class="asset-file-input"
                    type="file"
                    name="{{ input_name }}"
                    accept="{{ accept }}"
                    data-asset-input="true"
                    data-field="{{ field }}"
                    data-preview-type="{{ preview_type }}"
                    data-label="{{ label }}">

                <div class="asset-file-name" id="file-name-{{ field }}">{{ lang.mod_settings.no_file_selected }}</div>
                <div class="asset-file-meta" id="file-meta-{{ field }}"></div>
            </div>
        </div>
    </section>
{% endmacro %}

{% macro generated_asset_row(label, value, base_url, empty_text) %}
    <div class="generated-asset-row">
        <span>{{ label }}</span>
        {% if value %}
            <a href="{{ base_url }}static/mod_settings/{{ value }}" target="_blank" rel="noopener">{{ value }}</a>
        {% else %}
            <span>{{ empty_text }}</span>
        {% endif %}
    </div>
{% endmacro %}

{% block styles %}
<link rel="stylesheet" href="/templates/admin/assets/css/mod_settings.css?v=2.0">
<link href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/@sweetalert2/theme-bootstrap-4/bootstrap-4.css" rel="stylesheet">
{% endblock %}

{% block content %}
<div class="settings-page">
    {% if error is defined %}
        <div class="settings-banner error">
            <i class="bi bi-exclamation-octagon-fill"></i>
            <span>{{ message }}</span>
        </div>
    {% endif %}

    {% if success is defined %}
        <div class="settings-banner success">
            <i class="bi bi-check-circle-fill"></i>
            <span>{{ message }}</span>
        </div>
    {% endif %}

    {% if errors is defined %}
        <div class="settings-banner error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                {% for error_message in errors %}
                    <div>{{ error_message }}</div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <form
        id="settingsForm"
        method="POST"
        action="{{ site.saddress }}mod_settings/edit/{{ selected_lang }}"
        enctype="multipart/form-data"
        class="settings-shell">

        <input type="hidden" name="lang" value="{{ selected_lang }}">
        <input type="hidden" name="edit" value="1">
        <input type="hidden" name="logo_type" value="{{ setting.logo_type|default('rectangle') }}">
        <input type="hidden" name="show_logo" value="{{ setting.show_logo|default('y') }}">

        <section class="settings-topbar">
            <div class="settings-lang-inline">
                <select
                    name="selected_lang"
                    id="selectedLang"
                    class="m3-input-lg">
                    {% for lang_item in langs %}
                        <option value="{{ lang_item.seo }}" {% if lang_item.seo == selected_lang %}selected{% endif %}>
                            {{ lang_item.name }} ({{ lang_item.seo|upper }})
                        </option>
                    {% endfor %}
                </select>
            </div>

            <button type="submit" class="m3-btn-half m3-btn-half-primary">
                {{ lang.mod_settings.save }}
            </button>
        </section>

        <section class="settings-panel">
            <div class="settings-grid">
                <div class="m3-input-wrapper">
                    <input type="text" class="m3-input-lg" name="title" id="title" placeholder=" " value="{{ setting.title|default('') }}">
                    <label class="m3-floating-label">{{ lang.mod_settings.title }}</label>
                </div>

                <div class="m3-input-wrapper">
                    <input type="text" class="m3-input-lg" name="site_name" id="site_name" placeholder=" " value="{{ setting.site_name|default('') }}">
                    <label class="m3-floating-label">{{ lang.mod_settings.site_name }}</label>
                </div>

                <div class="m3-input-wrapper">
                    <textarea class="m3-input-lg" name="description" id="description" placeholder=" ">{{ setting.description|default('') }}</textarea>
                    <label class="m3-floating-label">{{ lang.mod_settings.description }}</label>
                </div>

                <div class="settings-grid two">
                    <div class="m3-input-wrapper">
                        <input type="text" class="m3-input-lg" name="owner_name" id="owner_name" placeholder=" " value="{{ setting.owner_name|default('') }}">
                        <label class="m3-floating-label">{{ lang.mod_settings.owner_name }}</label>
                    </div>

                    <div class="m3-input-wrapper">
                        <input type="text" class="m3-input-lg" name="established_year" id="established_year" placeholder=" " value="{{ setting.established_year|default('') }}">
                        <label class="m3-floating-label">{{ lang.mod_settings.established_year }}</label>
                    </div>
                </div>
            </div>
        </section>

        <section class="settings-panel">
            <div class="settings-contact-grid">
                {% include 'mod_user/parts/phone_input.twig' with {
                    'phone_value': setting.phone|default(''),
                    'label_text': lang.mod_settings.phone,
                    'input_id': 'phone',
                    'field_name': 'phone',
                    'store_mode': 'full',
                    'icon_class': 'bi-telephone'
                } %}

                {% include 'mod_user/parts/phone_input.twig' with {
                    'phone_value': setting.whatsapp|default(''),
                    'label_text': lang.mod_settings.whatsapp,
                    'input_id': 'whatsapp',
                    'field_name': 'whatsapp',
                    'store_mode': 'full',
                    'icon_class': 'bi-whatsapp'
                } %}
            </div>

            <div class="m3-input-wrapper">
                <input type="email" class="m3-input-lg" name="email" id="email" placeholder=" " value="{{ setting.email|default('') }}">
                <label class="m3-floating-label">{{ lang.mod_settings.email }}</label>
            </div>

            <div class="m3-input-wrapper">
                <textarea class="m3-input-lg" name="office_address" id="office_address" placeholder=" ">{{ setting.office_address|default('') }}</textarea>
                <label class="m3-floating-label">{{ lang.mod_settings.office_address }}</label>
            </div>

            <div class="m3-input-wrapper">
                <textarea class="m3-input-lg" name="work_address" id="work_address" placeholder=" ">{{ setting.work_address|default('') }}</textarea>
                <label class="m3-floating-label">{{ lang.mod_settings.work_address }}</label>
            </div>
        </section>

        <details class="settings-section-toggle" open>
            <summary>
                <span class="settings-section-icon"><i class="bi bi-search"></i></span>
                <span class="settings-section-label">
                    <strong>{{ lang.mod_settings.sections.seo_title }}</strong>
                    <span>{{ lang.mod_settings.sections.seo_description }}</span>
                </span>
                <span class="settings-section-chevron"><i class="bi bi-chevron-down"></i></span>
            </summary>
            <div class="settings-section-body">
                <div class="m3-input-wrapper">
                    <textarea class="m3-input-lg" name="map_embed_code" id="map_embed_code" placeholder=" ">{{ setting.map_embed_code|default('') }}</textarea>
                    <label class="m3-floating-label">{{ lang.mod_settings.map_embed_code }}</label>
                </div>

                <div class="m3-input-wrapper">
                    <textarea class="m3-input-lg" name="google_search_console" id="google_search_console" placeholder=" ">{{ setting.google_search_console|default('') }}</textarea>
                    <label class="m3-floating-label">{{ lang.mod_settings.google_search_console }}</label>
                </div>

                <div class="m3-input-wrapper">
                    <textarea class="m3-input-lg" name="google_analytics" id="google_analytics" placeholder=" ">{{ setting.google_analytics|default('') }}</textarea>
                    <label class="m3-floating-label">{{ lang.mod_settings.google_analytics }}</label>
                </div>

                <div class="m3-input-wrapper">
                    <textarea class="m3-input-lg" name="meta_tags" id="meta_tags" placeholder=" ">{{ setting.meta_tags|default('') }}</textarea>
                    <label class="m3-floating-label">{{ lang.mod_settings.meta_tags }}</label>
                </div>
            </div>
        </details>

    </form>

        <section class="settings-mcp-card">
            <div class="settings-mcp-head">
                <i class="bi bi-plug-fill settings-mcp-icon"></i>
                <div>
                    <div class="settings-mcp-title">{{ lang.mod_settings.mcp_link_title }}</div>
                    <div class="settings-mcp-desc">{{ lang.mod_mcp.page_intro }}</div>
                </div>
            </div>
            <a
                href="{{ site.saddress }}mod_mcp/list"
                class="m3-btn-half m3-btn-half-neutral settings-mcp-link"
                data-skip-unsaved-warning="true">
                {{ lang.mod_settings.mcp_link_button }}
            </a>
        </section>
</div>
{% endblock %}

{% block fixed_bottom %}
<div class="m3-final-bar">
    <a
        href="{{ site.saddress }}mod_user/panel"
        class="m3-btn-half m3-btn-half-neutral"
        data-skip-unsaved-warning="true">
        {{ lang.mod_settings.button.close }}
    </a>
    <button
        type="submit"
        form="settingsForm"
        class="m3-btn-half m3-btn-half-primary">
        {{ lang.mod_settings.save }}
    </button>
</div>
{% endblock %}

{% block scripts %}
<script>
    window.modSettingsConfig = {
        selectedLang: '{{ selected_lang|e('js') }}',
        editBaseUrl: '{{ site.saddress }}mod_settings/edit/',
        removeUrl: '{{ site.saddress }}mod_settings/image_remove_image',
        toggleLogoUrl: '{{ site.saddress }}mod_settings/ajax_toggle_logo',
        uploadCroppedUrl: '{{ site.saddress }}mod_settings/upload_cropped_logo_ajax',

        messages: {
            confirm: '{{ lang.mod_settings.button.confirm|e('js') }}',
            cancel: '{{ lang.mod_settings.button.cancel|e('js') }}',
            delete: '{{ lang.mod_settings.delete|e('js') }}',
            confirmDelete: '{{ lang.mod_settings.confirm_delete|e('js') }}',
            deleteSuccess: '{{ lang.mod_settings.delete_success|e('js') }}',
            deleteError: '{{ lang.mod_settings.delete_error|e('js') }}',
            genericError: '{{ lang.mod_settings.generic_error|e('js') }}',
            noFileSelected: '{{ lang.mod_settings.no_file_selected|e('js') }}',
            notUploaded: '{{ lang.mod_settings.not_uploaded|e('js') }}',
            unsavedChanges: '{{ lang.mod_settings.unsaved_changes|e('js') }}',
            leavePage: '{{ lang.mod_settings.button.leave_page|e('js') }}',
            stayOnPage: '{{ lang.mod_settings.button.stay|e('js') }}',
            edit: '{{ lang.mod_settings.button.edit|e('js') }}',
            save: '{{ lang.mod_settings.save|e('js') }}',
            cropSquare: '{{ lang.mod_settings.crop_square|e('js') }}',
            cropRect: '{{ lang.mod_settings.crop_rect|e('js') }}',
            cropSymbol: '{{ lang.mod_settings.crop_symbol|e('js') }}',
            logoSymbolTitle: '{{ lang.mod_settings.logo_symbol_title|e('js') }}',
            logoSymbolHelpText: '{{ lang.mod_settings.logo_symbol_help_text|e('js') }}',
            loadingMessage: '{{ lang.mod_settings.loading_message|e('js') }}'
        }
    };
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
<script src="/templates/admin/assets/js/mod_settings.js?v=2.0"></script>
{% endblock %}
