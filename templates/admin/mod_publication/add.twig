{% set module_lang_key = 'mod_publication' %}
{% set wizard_module = 'mod_publication' %}
{% extends 'admin/layout.twig' %}
{% set hide_search = true %}
{% set hide_fab = true %}

{% block title %}{{ lang.mod_publication.add }}{% endblock %}

{% block content %}
    <!-- 
        The Wizard is technically an overlay in the prototype, 
        but for a dedicated "/add" route, we can show it immediately 
        or use the page as a wrapper for the wizard.
        To keep "Single Page App" feel, we might want to auto-open 
        the wizard overlay on load.
    -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const fabContainer = document.getElementById('fabContainer');
            const fabOverlay = document.getElementById('fabOverlay');
            if (fabContainer) {
                fabContainer.classList.remove('active');
                fabContainer.style.display = 'none';
            }
            if (fabOverlay) {
                fabOverlay.classList.remove('active');
                fabOverlay.style.display = 'none';
            }

            // Auto open wizard if we are on the 'add' page
            // But we need the wizard HTML to be present. 
            // It is included in layout.twig block 'wizards' -> 'wizard_content.twig'
            
            // We need to initialize the wizard with Form behavior.
            const wizardOverlay = document.getElementById('contentWizard');
            if (wizardOverlay) {
                wizardOverlay.classList.add('active');
                wizardOverlay.style.visibility = 'visible';
            }

            if (typeof wizardData !== 'undefined') {
                var activeRouteLang = '{{ site.lang|lower }}';
                wizardData.lang = activeRouteLang;
                if (typeof restoreWizardUI === 'function') {
                    restoreWizardUI();
                } else {
                    if (typeof ensureWizardCategoryMatchesLanguage === 'function') ensureWizardCategoryMatchesLanguage();
                    if (typeof syncWizardCategorySheet === 'function') syncWizardCategorySheet();
                }
            }
        });
    </script>
    
    <div style="padding: 24px; text-align: center; color: #666;">
        <div class="spinner-track" style="display:inline-block; margin-bottom:16px;">
            <div class="spinner-fill"></div>
        </div>
        <p>{{ lang.mod_publication.wizard_loading }}</p>
    </div>

{% endblock %}

{% block scripts %}
{# 
    prepareAndSubmitWizard() function is now fully implemented in script.js
    with proper AJAX handling, TinyMCE support, and localStorage integration.
    No need for inline override here.
#}
{% endblock %}
