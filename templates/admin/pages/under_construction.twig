{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.management.under_construction_page_title }}{% endblock %}

{% block headline %}{{ lang.management.under_construction_module_title }}{% endblock %}

{% block content %}
<div class="empty-state">
    <div class="empty-icon" style="background:#fff3e0; color:#e65100;">
        <i class="bi bi-cone-striped"></i>
    </div>
    <h3>{{ lang.management.under_construction_heading }}</h3>
    <p>{{ lang.management.under_construction_description }}</p>
    <br>
    <a href="{{ site.sadres }}" class="m3-btn-outlined">{{ lang.management.back_to_home }}</a>
</div>
{% endblock %}
