<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <base href="{{ site.sadres }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{% block title %}{{ site.title }} Admin{% if site.version is defined and site.version %} v{{ site.version }}{% if site.build is defined and site.build %} ({{ site.build }}){% endif %}{% endif %}{% endblock %}</title>

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- CSS Assets (Absolute Path) -->
<link rel="stylesheet" href="/templates/admin/assets/css/style.css?v=4.1">
    {% block styles %}{% endblock %}
</head>
<body class="{% if hide_navbar %}hide-navbar{% endif %} {% if hide_search %}hide-search{% endif %}">

    <!-- Simulator Wrapper for Desktop -->
    <div class="mobile-wrapper">

        {% set page_headline %}
            {% block headline %}{% endblock %}
        {% endset %}
        {% include 'admin/partials/header.twig' with {'headline': page_headline} %}


        <!-- SCROLLABLE CONTENT AREA -->
        <div class="app-scroll-frame">

            <!-- MAIN CONTENT -->
            <main class="main-content" id="mainContent">
                {% block content %}{% endblock %}
            </main>

            <!-- FOOTER/PAGINATION IF NEEDED -->
            {% block footer %}{% endblock %}

        </div> <!-- END SCROLL FRAME -->

        <!-- FIXED ELEMENTS (Outside Scroll Frame) -->
        {% if show_fab is not defined or show_fab %}
            {% include 'admin/partials/fab.twig' %}
        {% endif %}
        {% if show_navbar is not defined or show_navbar %}
            {% include 'admin/partials/navbar.twig' %}
        {% endif %}
        
        <!-- FIXED BOTTOM UI (e.g. Action Bars) -->
        {% block fixed_bottom %}{% endblock %}

        <!-- SHEETS & DRAWERS -->
        {% if show_sidebar is not defined or show_sidebar %}
            {% include 'admin/partials/sidebar.twig' %}
        {% endif %}
        {% if show_filter_sheet is not defined or show_filter_sheet %}
            {% include 'admin/partials/filter_sheet.twig' %}
        {% endif %}

        <!-- WIZARDS & MODALS -->
        {% if show_wizards is not defined or show_wizards %}
            {% block wizards %}
                {% include 'admin/partials/wizard_content.twig' %}
                {% include 'admin/partials/wizard_video_embed.twig' %}
            {% endblock %}
        {% endif %}
        
        <!-- OTHER OVERLAYS -->
        {% if show_extra_sheets is not defined or show_extra_sheets %}
            {% include 'admin/partials/sheets_extra.twig' %}
        {% endif %}

    </div>

    <!-- CORE SCRIPTS (Absolute Path) -->
    {% set wizard_lang_key = wizard_module is defined ? wizard_module : 'mod_content' %}
    {% set wizard_lang = attribute(lang, wizard_lang_key) %}
    {% set wizard_title_key = 'content_title' %}
    {% set wizard_body_key = 'content' %}
    {% if wizard_lang_key == 'mod_news' %}
        {% set wizard_title_key = 'news_title' %}
        {% set wizard_body_key = 'news' %}
    {% elseif wizard_lang_key == 'mod_publication' %}
        {% set wizard_title_key = 'publication_title' %}
        {% set wizard_body_key = 'publication' %}
    {% endif %}
    <script>
        const SITE_URL = '{{ site.sadres }}';
        const WIZARD_MODULE = '{{ wizard_lang_key }}';
        const adminLang = {
            wizard: {
                step: {
                    language: '{{ wizard_lang.wizard.step.language|e("js") }}',
                    category: '{{ wizard_lang.wizard.step.category|e("js") }}',
                    title: '{{ wizard_lang.wizard.step.title|e("js") }}',
                    date: '{{ wizard_lang.wizard.step.date|e("js") }}',
                    intro: '{{ wizard_lang.wizard.step.intro|e("js") }}',
                    content: '{{ attribute(wizard_lang.wizard.step, wizard_body_key)|e("js") }}',
                    image: '{{ wizard_lang.wizard.step.image|e("js") }}',
                    finish: '{{ wizard_lang.wizard.step.finish|e("js") }}'
                },
                messages: {
                    success_sim: '{{ wizard_lang.wizard.messages.success_sim|e("js") }}'
                },
                label: {
                    change_image: '{{ wizard_lang.wizard.label.change_image|e("js") }}'
                },
                summary: {
                    selected_none: '{{ wizard_lang.wizard.summary.selected_none|e("js") }}'
                },
                button: {
                    save: '{{ wizard_lang.wizard.button.save|e("js") }}',
                    next: '{{ wizard_lang.wizard.button.next|e("js") }}',
                    prev: '{{ wizard_lang.wizard.button.prev|e("js") }}',
                    finish: '{{ wizard_lang.wizard.button.finish|e("js") }}'
                }
            },
            video_embed: {
                messages: {
                    success: '{{ lang.mod_video_embed.message.oke.add|e("js") }}',
                    embed_error: '{{ lang.mod_video_embed.validator.required|replace({"%s": lang.mod_video_embed.namemin.columns.embed})|e("js") }}',
                    title_error: '{{ lang.mod_video_embed.validator.length|replace({"%s": lang.mod_video_embed.namemin.columns.name, "%s": 3, "%s": 255})|e("js") }}'
                },
                label: {
                    change_image: '{{ lang.mod_video_embed.wizard.label.change_image|e("js") }}'
                },
                wizard: {
                    step: {
                        language: '{{ lang.mod_video_embed.wizard.step.language|e("js") }}',
                        category: '{{ lang.mod_video_embed.wizard.step.category|e("js") }}',
                        embed: '{{ lang.mod_video_embed.wizard.step.embed|e("js") }}',
                        details: '{{ lang.mod_video_embed.wizard.step.details|e("js") }}',
                        content: '{{ lang.mod_video_embed.wizard.step.content|e("js") }}',
                        image: '{{ lang.mod_video_embed.wizard.step.image|e("js") }}',
                        seo: '{{ lang.mod_video_embed.wizard.step.seo|e("js") }}',
                        finish: '{{ lang.mod_video_embed.wizard.step.finish|e("js") }}'
                    },
                    subtitle: {
                        language: '{{ lang.mod_video_embed.wizard.subtitle.language|e("js") }}',
                        category: '{{ lang.mod_video_embed.wizard.subtitle.category|e("js") }}',
                        embed: '{{ lang.mod_video_embed.wizard.subtitle.embed|e("js") }}',
                        details: '{{ lang.mod_video_embed.wizard.subtitle.details|e("js") }}',
                        content: '{{ lang.mod_video_embed.wizard.subtitle.content|e("js") }}',
                        image: '{{ lang.mod_video_embed.wizard.subtitle.image|e("js") }}',
                        seo: '{{ lang.mod_video_embed.wizard.subtitle.seo|e("js") }}',
                        finish: '{{ lang.mod_video_embed.wizard.subtitle.finish|e("js") }}'
                    },
                    label: {
                        upload_text: '{{ lang.mod_video_embed.wizard.label.upload_text|e("js") }}',
                        published: '{{ lang.mod_video_embed.wizard.label.published|e("js") }}',
                        published_desc: '{{ lang.mod_video_embed.wizard.label.published_desc|e("js") }}',
                        category_select: '{{ lang.mod_video_embed.wizard.label.category_select|e("js") }}',
                        change_image: '{{ lang.mod_video_embed.wizard.label.change_image|e("js") }}'
                    },
                    summary: {
                        title: '{{ lang.mod_video_embed.wizard.summary.title|e("js") }}',
                        selected_none: '{{ lang.mod_video_embed.wizard.summary.selected_none|e("js") }}'
                    },
                    button: {
                        save: '{{ lang.mod_video_embed.wizard.button.save|e("js") }}',
                        next: '{{ lang.mod_video_embed.wizard.button.next|e("js") }}',
                        prev: '{{ lang.mod_video_embed.wizard.button.prev|e("js") }}',
                        finish: '{{ lang.mod_video_embed.wizard.button.finish|e("js") }}'
                    }
                }
            },
            general: {
                delete_confirm: '{{ wizard_lang.delete_confirm|e("js") }}',
                card_click: '{{ wizard_lang.wizard.messages.card_click|e("js") }}'
            },
            status: {
                active: '{{ wizard_lang.status_badge.active|e("js") }}',
                draft: '{{ wizard_lang.status_badge.draft|e("js") }}'
            },
            mock: {
                titles: {{ wizard_lang.mock.titles|json_encode|raw }},
                categories: {{ wizard_lang.mock.categories|json_encode|raw }},
                authors: {{ wizard_lang.mock.authors|json_encode|raw }}
            },
            context_menu: {
                edit: '{{ wizard_lang.context_menu.edit|e("js") }}',
                publish: '{{ wizard_lang.context_menu.publish|e("js") }}',
                unpublish: '{{ wizard_lang.context_menu.unpublish|e("js") }}',
                published_msg: '{{ wizard_lang.context_menu.published_msg|e("js") }}',
                unpublished_msg: '{{ wizard_lang.context_menu.unpublished_msg|e("js") }}',
                confirm: '{{ wizard_lang.context_menu.confirm|e("js") }}',
                cancel: '{{ wizard_lang.context_menu.cancel|e("js") }}',
                edit_alert: '{{ wizard_lang.context_menu.edit_alert|replace({"\n": "\\n"})|e("js") }}',
                gallery_alert: '{{ wizard_lang.context_menu.gallery_alert|replace({"\n": "\\n"})|e("js") }}',
                files_alert: '{{ wizard_lang.context_menu.files_alert|replace({"\n": "\\n"})|e("js") }}',
                status_alert: '{{ wizard_lang.context_menu.status_alert|replace({"\n": "\\n"})|e("js") }}',
                delete_confirm: '{{ wizard_lang.context_menu.delete_confirm|e("js") }}',
                delete_success: '{{ wizard_lang.context_menu.delete_success|e("js") }}'
            },
            filter: {
                default_sort: '{{ wizard_lang.ui.default_sort|e("js") }}',
                default_lang: '{{ site.lang|upper }}'
            },
            ui: {
                select: '{{ wizard_lang.ui.select|e("js") }}',
                all: '{{ wizard_lang.ui.all|e("js") }}',
                filter_cleared: '{{ wizard_lang.ui.filter_cleared|e("js") }}',
                filter_applied: '{{ wizard_lang.ui.filter_applied|e("js") }}',
                sort_label: '{{ wizard_lang.ui.sort_label|e("js") }}',
                limit_label: '{{ wizard_lang.ui.limit_label|e("js") }}',
                lang_label: '{{ wizard_lang.ui.lang_label|e("js") }}'
            },
            adminCategories: {{ categories|json_encode|raw }},
            video_embed_categories: {{ video_embed_categories|json_encode|raw }},
            date_locale: '{{ site.lang }}',
            languages: [
                {% if lang_lang is defined and lang_lang is not empty %}
                    {% for l in lang_lang %}
                        { code: '{{ l.seo|upper }}', name: '{{ l.name|e("js") }}' },
                    {% endfor %}
                {% endif %}
            ]
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/7.5.1/tinymce.min.js" referrerpolicy="origin"></script>
    <script src="/templates/admin/assets/js/script.js?v=1.47"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
