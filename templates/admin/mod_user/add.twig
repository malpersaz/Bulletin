{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}
	{{ lang.mod_user.admin.add_user }}
{% endblock %}

{% block content %}
	<style>
			.edit-container {
				padding: 12px;
				display: flex;
				flex-direction: column;
				gap: 12px;
				padding-bottom: 96px;
			}
			.edit-card {
				background: var(--md-sys-color-surface);
				border-radius: 18px;
				padding: 16px;
				box-shadow: var(--md-sys-elevation-1);
			}
			.form-row {
				margin-bottom: 14px;
			}
		.form-row:last-child {
			margin-bottom: 0;
		}
		.m3-input-wrapper {
			position: relative;
			margin-bottom: 4px;
		}
			.m3-input-lg {
				width: 100%;
				padding: 14px 16px;
				border-radius: 14px;
			border: 1px solid var(--md-sys-color-outline);
			background: transparent;
			color: var(--md-sys-color-on-surface);
			font-size: 16px;
			outline: none;
            box-sizing: border-box;
		}
			.m3-input-lg:focus {
				border-color: var(--md-sys-color-primary);
				border-width: 2px;
				padding: 13px 15px;
			}
		.m3-input-lg:focus + .m3-floating-label,
		.m3-input-lg:not(:placeholder-shown) + .m3-floating-label {
			top: -10px;
			left: 12px;
			font-size: 12px;
			color: var(--md-sys-color-primary);
			background: var(--md-sys-color-surface);
			padding: 0 4px;
		}
		.m3-floating-label {
			position: absolute;
			top: 12px;
			left: 16px;
			color: var(--md-sys-color-on-surface-variant);
			font-size: 16px;
			pointer-events: none;
			transition: all 0.2s;
		}
        .image-preview-container {
            margin-top: 12px;
            display: flex;
            justify-content: center;
            border: 1px dashed var(--md-sys-color-outline);
            border-radius: 8px;
            padding: 16px;
            position: relative;
        }
        .image-preview-container img {
            max-width: 150px;
            max-height: 150px;
            border-radius: 50%;
            object-fit: cover;
            box-shadow: var(--md-sys-elevation-2);
        }
	        .filter-group-label {
            display: block;
            font-size: 12px;
            font-weight: 500;
            color: var(--md-sys-color-primary);
            margin-bottom: 8px;
            margin-left: 4px;
	        }
	        .contact-grid {
	            display: grid;
	            gap: 14px;
	        }
	        .sr-only {
	            position: absolute;
	            width: 1px;
	            height: 1px;
	            padding: 0;
	            margin: -1px;
	            overflow: hidden;
	            clip: rect(0, 0, 0, 0);
	            white-space: nowrap;
	            border: 0;
	        }
	</style>

	<div class="edit-container">
		{% if success is defined %}
			<div class="banner-m3 banner-success mb-4" style="background: #e6f4ea; color: #1e4620; padding: 16px; border-radius: 12px; display: flex; align-items: center; gap: 12px; font-size: 14px;">
				<i class="bi bi-check-circle-fill"></i>
				<span>{{ message }}</span>
			</div>
			<script>
				setTimeout(() => {
					window.location.href = "{{ site.saddress }}mod_user/list";
				}, 2000);
			</script>
		{% else %}
			{% if errors is defined %}
				<div class="banner-m3 banner-danger mb-4" style="background: #fce8e6; color: #c62828; padding: 16px; border-radius: 12px; margin-bottom: 16px;">
					{% for error in errors %}
						<div style="display: flex; align-items: center; gap: 12px; font-size: 14px; margin-bottom: 4px;">
							<i class="bi bi-exclamation-circle-fill"></i>
							<span>{{ error }}</span>
						</div>
					{% endfor %}
				</div>
			{% endif %}

			<form method="POST" action="" id="addForm" enctype="multipart/form-data">
				{# Card 1: Account #}
					<div class="edit-card">
					<div class="form-row">
						<div class="m3-input-wrapper">
							<input class="m3-input-lg" name="username" value="{{ username }}" type="text" id="username" placeholder=" " required>
							<label class="m3-floating-label">{{ lang.mod_user.username }}</label>
						</div>
					</div>

					<div class="form-row">
						<div class="m3-input-wrapper">
							<input class="m3-input-lg" name="password" type="password" id="password" placeholder=" " required>
							<label class="m3-floating-label">{{ lang.mod_user.password }}</label>
						</div>
					</div>

					<div class="form-row">
						<div class="m3-input-wrapper">
							<input class="m3-input-lg" name="email" value="{{ email }}" type="email" id="email" placeholder=" " required>
							<label class="m3-floating-label">{{ lang.mod_user.email }}</label>
						</div>
					</div>

					{% macro select(parent_id, level, group) %}
						{% for entry in attribute(group, parent_id) %}
							{% set current_parent_id = entry.group_id %}
							<option value="{{ entry.group_id }}">
								{{ '-'|repeat(level * 2) }} {{ entry.name }}
							</option>
							{% if attribute(group, current_parent_id) is defined and attribute(group, current_parent_id) is iterable %}
								{{ _self.select(current_parent_id, level + 1, group) }}
							{% endif %}
						{% endfor %}
					{% endmacro %}

					<div class="form-row">
						<label class="filter-group-label">{{ lang.mod_user.admin.user_group }}</label>
						<div class="m3-input-wrapper">
							<select class="m3-input-lg" name="group_id" id="group_id" required>
								{{ _self.select(0, 0, group) }}
							</select>
						</div>
					</div>

					<div class="form-row">
						<label class="filter-group-label">{{ lang.mod_user.admin.columns.status }}</label>
						<div class="m3-input-wrapper">
							<select class="m3-input-lg" name="status" id="status" required>
								<option value="y" {% if status == 'y' %} selected {% endif %}>{{ lang.mod_user.grid.active }}</option>
								<option value="n" {% if status == 'n' %} selected {% endif %}>{{ lang.mod_user.grid.waiting_email_activation }}</option>
								<option value="a" {% if status == 'a' %} selected {% endif %}>{{ lang.mod_user.grid.waiting_admin_activation }}</option>
							</select>
						</div>
					</div>
				</div>

				{# Card 2: Personal Info #}
					<div class="edit-card" style="margin-top: 16px;">
						<div class="contact-grid">
							<div class="form-row">
								<div class="m3-input-wrapper">
									<input class="m3-input-lg" name="name" value="{{ name }}" type="text" id="name" placeholder=" " required>
									<label class="m3-floating-label">{{ lang.mod_user.your_name }}</label>
								</div>
							</div>

							<div class="form-row">
								<div class="m3-input-wrapper">
									<input class="m3-input-lg" name="last_name" value="{{ last_name }}" type="text" id="last_name" placeholder=" " required>
									<label class="m3-floating-label">{{ lang.mod_user.your_surname }}</label>
								</div>
							</div>

							<div class="form-row">
								{% include 'mod_user/parts/phone_input.twig' with {
                                'country_code_value': country_code,
                                'phone_value': phone,
                                'label_text': lang.mod_user.mobile_phone,
                                'input_id': 'phone'
                            } %}
							</div>

							<div class="form-row">
								<div class="m3-input-wrapper">
									<input class="m3-input-lg" name="city" value="{{ city }}" type="text" id="city" placeholder=" ">
									<label class="m3-floating-label">{{ lang.mod_user.city }}</label>
								</div>
							</div>
						</div>
					</div>

				{# Card 3: Author Profile #}
					<div class="edit-card" style="margin-top: 16px;">
					<div class="form-row">
						<div class="m3-input-wrapper">
							<input class="m3-input-lg" name="blog_name" value="{{ blog_name }}" type="text" id="blog_name" placeholder=" ">
							<label class="m3-floating-label">{{ lang.mod_user.blog_name }}</label>
						</div>
					</div>

					<div class="form-row">
						<div class="m3-input-wrapper">
							<textarea class="m3-input-lg" name="about" id="about" rows="4" placeholder=" " oninput="updateCharCounter(this, 'aboutCounter', 255)">{{ about }}</textarea>
							<label class="m3-floating-label">{{ lang.mod_user.about_me }}</label>
						</div>
						<div style="text-align: right; font-size: 12px; color: var(--md-sys-color-on-surface-variant); margin-top: 4px;" id="aboutCounter">
							{{ about|length }} / 255
						</div>
					</div>
				</div>

				{# Card 4: Social Media #}
				<div class="edit-card" style="margin-top: 16px;">
					<label class="filter-group-label">{{ lang.mod_user.admin.social_media }}</label>
					{% include 'mod_user/parts/social_links.twig' with {
                        'social_platforms': social_platforms,
                        'social_links': social_links
                    } %}
				</div>

				{# Card 5: Image #}
					<div class="edit-card" style="margin-top: 16px;">
					<div class="form-row">
						<div class="m3-input-wrapper">
							<input type="file" name="image" id="image" class="m3-input-lg" onchange="previewAvatar(this)">
							<label class="m3-floating-label">{{ lang.mod_user.profile_picture }}</label>
						</div>
						<div class="image-preview-container" id="avatarPreviewContainer">
							<div style="color: var(--md-sys-color-outline); font-size: 14px;">{{ lang.mod_user.button.select_image }}</div>
						</div>
					</div>
				</div>
			</form>
		{% endif %}
	</div>
{% endblock %}

{% block fixed_bottom %}
	{% if oke is not defined %}
		<div class="m3-final-bar">
			<a href="{{ site.saddress }}mod_user/list" class="m3-btn-half m3-btn-half-neutral">
				<i class="bi bi-x-lg"></i>
				<span class="sr-only">{{ lang.mod_user.button.cancel }}</span>
			</a>
			<button type="submit" form="addForm" name="add" value="{{ lang.mod_user.admin.add_user }}" class="m3-btn-half m3-btn-half-primary">
				<i class="bi bi-check-lg"></i>
				<span class="sr-only">{{ lang.mod_user.admin.add_user }}</span>
			</button>
		</div>
	{% endif %}
{% endblock %}

{% block scripts %}
	<script>
		function previewAvatar(input) {
			if (input.files && input.files[0]) {
				var reader = new FileReader();
				reader.onload = function (e) {
					var container = document.getElementById('avatarPreviewContainer');
					container.innerHTML = '<img src="' + e.target.result + '" id="avatarPreview" style="max-width: 150px; max-height: 150px; border-radius: 50%; object-fit: cover; box-shadow: var(--md-sys-elevation-2);" alt="Avatar">';
				}
				reader.readAsDataURL(input.files[0]);
			}
		}

		function updateCharCounter(input, counterId, max) {
			const currentLength = input.value.length;
			const counter = document.getElementById(counterId);
			if (counter) {
				counter.innerText = `${currentLength} / ${max}`;
				if (currentLength > max) {
					counter.style.color = 'var(--md-sys-color-error)';
				} else {
					counter.style.color = 'var(--md-sys-color-on-surface-variant)';
				}
			}
		}
	</script>
{% endblock %}
