{% extends is_ajax ? 'admin/layout_blank.twig' : 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}
	{{ lang.mod_user.profile_menu.edit_profile }}
{% endblock %}

{% block headline %}
	{{ lang.mod_user.profile_menu.edit_profile }}
{% endblock %}

{% set back_url = '/' ~ site.lang ~ '/mod_user/list' %}
{% set breadcrumb_parent_url = '/' ~ site.lang ~ '/mod_user/list' %}
{% set breadcrumb_parent_title = lang.mod_user.name %}

{% block content %}
	<div class="edit-container" data-modal-title="{{ lang.mod_user.profile_menu.edit_profile }}" data-modal-icon="bi-person-gear">

		{% if Success is defined or success is defined %}
			<div class="banner-m3 banner-success">
				<i class="bi bi-check-circle-fill"></i>
				<span>{{ message }}</span>
			</div>
		{% else %}
			{% if errors is defined %}
				<div class="banner-m3 banner-danger">
					{% for error in errors %}
						<div class="error-item">
							<i class="bi bi-exclamation-circle-fill"></i>
							<span>{{ error }}</span>
						</div>
					{% endfor %}
				</div>
			{% endif %}

			<form method="POST" action="" id="profileInfoForm" enctype="multipart/form-data" novalidate
				data-msg-current-password-required="{{ lang.mod_user.js.current_password_required }}"
				data-msg-email-required="{{ lang.mod_user.js.email_required }}"
				data-msg-unsaved-title="{{ lang.mod_user.js.unsaved_changes_title }}"
				data-msg-unsaved-message="{{ lang.mod_user.js.unsaved_changes_message }}"
				data-msg-exit-without-saving="{{ lang.mod_user.js.exit_without_saving }}"
				data-msg-save="{{ lang.mod_user.button.save }}"
				data-msg-continue-editing="{{ lang.mod_user.js.continue_editing }}">
				<input type="file" name="image" id="image" class="visually-hidden" data-action="preview-avatar">

				{# Profile Hero Banner #}
				<div class="m3-profile-hero">
					<div class="m3-hero-avatar-wrapper" id="avatarPreviewContainer" data-initial-src="{% if d.image is defined and d.image != '' %}{{ site.iaddress }}mod_user/{{ d.image }}{% endif %}" data-initial-id="{{ d.id|default('') }}">
						{% if d.image is defined and d.image != '' %}
							<img src="{{ site.iaddress }}mod_user/{{ d.image }}" id="avatarPreview" class="m3-hero-avatar" alt="Avatar">
							<button type="button" class="m3-hero-avatar-btn remove-btn" data-action="delete-avatar" data-id="{{ d.id|default('') }}" title="{{ lang.mod_user.button.delete }}">
								<i class="bi bi-trash"></i>
							</button>
						{% else %}
							<div class="m3-hero-avatar-placeholder" data-action="select-avatar">
								<i class="bi bi-person-fill"></i>
							</div>
							<button type="button" class="m3-hero-avatar-btn upload-btn" data-action="select-avatar" title="{{ lang.mod_user.button.select_image }}">
								<i class="bi bi-camera-fill"></i>
							</button>
						{% endif %}
					</div>
					<div class="m3-hero-info">
						<h3 class="m3-hero-name">{{ d.name|default('') }} {{ d.last_name|default('') }}</h3>
						<p class="m3-hero-email">{{ d.email|default('') }}</p>
						{% if d.created_at is defined and d.created_at != '' %}
							<span class="m3-hero-badge">
								<i class="bi bi-calendar-event"></i> {{ lang.mod_user.membership_date }}: {{ d.created_at }}
							</span>
						{% endif %}
					</div>
				</div>

				{# Segmented Tab Pill Navigation #}
				<div class="m3-profile-tabs" role="tablist">
					<button type="button" class="m3-tab-btn active" data-action="switch-tab" data-tab-target="tab-basic-info" role="tab" aria-selected="true">
						<i class="bi bi-person-vcard"></i>
						<span>{{ lang.mod_user.tabs.basic_info }}</span>
					</button>
					<button type="button" class="m3-tab-btn" data-action="switch-tab" data-tab-target="tab-author-profile" role="tab" aria-selected="false">
						<i class="bi bi-journal-text"></i>
						<span>{{ lang.mod_user.tabs.author_profile }}</span>
					</button>
					<button type="button" class="m3-tab-btn" data-action="switch-tab" data-tab-target="tab-social-media" role="tab" aria-selected="false">
						<i class="bi bi-share"></i>
						<span>{{ lang.mod_user.tabs.social_media }}</span>
					</button>
				</div>

				{# Tab 1: Basic Info (High Priority) #}
				<div class="m3-tab-content active" id="tab-basic-info" role="tabpanel">
					<div class="edit-card">
						<div class="contact-grid">
							<div class="form-row">
								<div class="m3-input-wrapper">
									<input class="m3-input-lg" name="name" value="{{ d.name|default('') }}" type="text" id="name" autocomplete="given-name" placeholder=" " required>
									<label class="m3-floating-label" for="name">{{ lang.mod_user.your_name }}</label>
								</div>
							</div>

							<div class="form-row">
								<div class="m3-input-wrapper">
									<input class="m3-input-lg" name="last_name" value="{{ d.last_name|default('') }}" type="text" id="last_name" autocomplete="family-name" placeholder=" " required>
									<label class="m3-floating-label" for="last_name">{{ lang.mod_user.your_surname }}</label>
								</div>
							</div>
						</div>

						<div class="form-row">
							<div class="m3-input-wrapper">
								<input class="m3-input-lg" name="email" value="{{ d.email|default('') }}" type="email" id="email" autocomplete="email" placeholder=" " required>
								<label class="m3-floating-label" for="email">{{ lang.mod_user.your_email }}</label>
							</div>
						</div>

						<div class="form-row">
							{% include 'mod_user/parts/phone_input.twig' with {
								'country_code_value': d.country_code|default(''),
								'phone_value': d.phone|default(''),
								'label_text': lang.mod_user.mobile_phone,
								'input_id': 'phone'
							} %}
						</div>

						<div class="form-row">
							<div class="m3-input-wrapper">
								<input class="m3-input-lg" name="city" value="{{ d.city|default('') }}" type="text" id="city" autocomplete="address-level2" placeholder=" ">
								<label class="m3-floating-label" for="city">{{ lang.mod_user.city }}</label>
							</div>
						</div>

						<div class="form-row">
							<div class="m3-input-wrapper">
								<input class="m3-input-lg" name="current_password" type="password" id="current_password" autocomplete="current-password" placeholder=" " required>
								<label class="m3-floating-label" for="current_password">{{ lang.mod_user.current_password }}</label>
								<div class="input-icon-right" data-action="toggle-password" data-target="current_password" role="button" tabindex="0">
									<i class="bi bi-eye"></i>
								</div>
							</div>
						</div>
					</div>
				</div>

				{# Tab 2: Author Profile (Medium Priority) #}
				<div class="m3-tab-content" id="tab-author-profile" role="tabpanel">
					<div class="edit-card">
						<div class="form-row">
							<div class="m3-input-wrapper">
								<input class="m3-input-lg" name="blog_name" value="{{ d.blog_name|default('') }}" type="text" id="blog_name" placeholder=" ">
								<label class="m3-floating-label" for="blog_name">{{ lang.mod_user.blog_name }}</label>
							</div>
						</div>

						<div class="form-row">
							<div class="m3-input-wrapper">
								<textarea class="m3-input-lg" name="about" id="about" rows="5" placeholder=" " data-counter-id="aboutCounter" data-counter-max="255">{{ d.about|default('') }}</textarea>
								<label class="m3-floating-label" for="about">{{ lang.mod_user.about_me }}</label>
							</div>
							<div class="m3-char-counter" id="aboutCounter">
								{{ d.about|default('')|length }} / 255
							</div>
						</div>
					</div>
				</div>

				{# Tab 3: Social Media (Secondary Priority) #}
				<div class="m3-tab-content" id="tab-social-media" role="tabpanel">
					<div class="edit-card">
						<label class="filter-group-label">{{ lang.mod_user.admin.social_media }}</label>
						{% include 'mod_user/parts/social_links.twig' with {
							'social_platforms': social_platforms,
							'social_links': d.social_links|default({})
						} %}
					</div>
				</div>

				{# Action Bar #}
				<div class="m3-form-actions-sticky">
					<button type="submit" name="edit" value="{{ lang.mod_user.button.save }}" class="m3-btn-filled full-width">
						<i class="bi bi-check-lg"></i>
						<span>{{ lang.mod_user.button.save }}</span>
					</button>
				</div>
			</form>
		{% endif %}
	</div>
{% endblock %}

{% block fixed_bottom %}{% endblock %}
