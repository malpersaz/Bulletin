{% extends is_ajax ? 'admin/layout_blank.twig' : 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}
	{{ lang.mod_user.profile_menu.change_password }}
{% endblock %}

{% block headline %}
    {{ lang.mod_user.profile_menu.change_password }} - {{ session.username }}
{% endblock %}

{% set back_url = '/' ~ site.lang ~ '/mod_user/list' %}
{% set breadcrumb_parent_url = '/' ~ site.lang ~ '/mod_user/list' %}
{% set breadcrumb_parent_title = lang.mod_user.name %}

{% block content %}
	<div class="edit-container" data-modal-title="{{ lang.mod_user.profile_menu.change_password }}" data-modal-icon="bi-key">

		{% if Success is defined or success is defined %}
			<div class="banner-m3 banner-success">
				<i class="bi bi-check-circle-fill"></i>
				<div>
					<div class="banner-title">{{ lang.mod_user.success }}</div>
					<div class="banner-desc">{{ message }}</div>
				</div>
			</div>
		{% else %}
			{% if errors is defined %}
				<div class="banner-m3 banner-danger">
					<div class="banner-title">
						<i class="bi bi-exclamation-triangle-fill"></i>
						{{ lang.mod_user.error_title }}
					</div>
					{% for error in errors %}
						<div class="error-item">
							<i class="bi bi-dot"></i>
							<span>{{ error }}</span>
						</div>
					{% endfor %}
				</div>
			{% endif %}

			<form method="POST" action="" id="changePasswordForm" novalidate
				data-msg-current-password-required="{{ lang.mod_user.js.current_password_required }}"
				data-msg-new-password-required="{{ lang.mod_user.js.new_password_required }}"
				data-msg-confirm-password-required="{{ lang.mod_user.js.confirm_password_required }}"
				data-msg-password-min-length="{{ lang.mod_user.js.password_min_length }}"
				data-msg-password-mismatch="{{ lang.mod_user.js.passwords_mismatch }}"
				data-msg-unsaved-title="{{ lang.mod_user.js.unsaved_changes_title }}"
				data-msg-unsaved-message="{{ lang.mod_user.js.unsaved_changes_message }}"
				data-msg-exit-without-saving="{{ lang.mod_user.js.exit_without_saving }}"
				data-msg-save="{{ lang.mod_user.button.save }}"
				data-msg-continue-editing="{{ lang.mod_user.js.continue_editing }}">
				<input type="hidden" name="edit" value="1">
				<div class="edit-card">
					<div class="form-group">
						<div class="m3-input-wrapper">
							<input class="m3-input-lg" name="current_password" type="password" id="current_password" placeholder=" " required autofocus>
							<label class="m3-floating-label" for="current_password">{{ lang.mod_user.current_password }}</label>
							<div class="input-icon-right" data-action="toggle-password" data-target="current_password" role="button" tabindex="0">
								<i class="bi bi-eye"></i>
							</div>
						</div>
					</div>

					<div class="form-group">
						<div class="m3-input-wrapper">
							<input class="m3-input-lg" name="new_password" type="password" id="new_password" placeholder=" " required data-action="check-strength">
							<label class="m3-floating-label" for="new_password">{{ lang.mod_user.new_password }}</label>
							<div class="input-icon-right" data-action="toggle-password" data-target="new_password" role="button" tabindex="0">
								<i class="bi bi-eye"></i>
							</div>
						</div>
						<div class="strength-container">
							<div class="strength-bar">
								<div id="strength-progress" class="strength-progress"></div>
							</div>
							<div id="strength-text" class="strength-text"></div>
						</div>
						<div class="password-requirements">
							<div class="req-item" id="req-len">
								<i class="bi bi-circle"></i>
								<span>{{ lang.mod_user.js.password_len_req }}</span>
							</div>
							<div class="req-item" id="req-complex">
								<i class="bi bi-circle"></i>
								<span>{{ lang.mod_user.js.password_complex_req }}</span>
							</div>
						</div>
					</div>

					<div class="form-group">
						<div class="m3-input-wrapper">
							<input class="m3-input-lg" name="confirm_password" type="password" id="confirm_password" placeholder=" " required data-action="check-match">
							<label class="m3-floating-label" for="confirm_password">{{ lang.mod_user.confirm_new_password }}</label>
							<div class="input-icon-right" data-action="toggle-password" data-target="confirm_password" role="button" tabindex="0">
								<i class="bi bi-eye"></i>
							</div>
						</div>
						<div id="match-feedback">
							<i class="bi bi-check-circle"></i>
							<span>{{ lang.mod_user.password_match.success }}</span>
						</div>
					</div>
				</div>

				<div class="m3-form-actions-sticky">
					<button type="submit" id="submitBtn" class="m3-btn-filled full-width">
						<i class="bi bi-check-lg" id="btnIcon"></i>
						<span id="btnText">{{ lang.mod_user.change }}</span>
					</button>
				</div>
			</form>
		{% endif %}
	</div>
{% endblock %}

{% block fixed_bottom %}{% endblock %}
