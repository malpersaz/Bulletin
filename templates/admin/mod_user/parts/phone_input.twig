{# mod_user phone_input part - MD3 Phone-First Pure Twig Template #}
{% set phone_input_id = input_id|default(field_name|default('phone')) %}
{% set phone_field_name = field_name|default('phone') %}
{% set hidden_country_id = hidden_country_input_id|default('country_code') %}
{% set hidden_country_name = hidden_country_input_name|default('country_code') %}
{% set store_mode = store_mode|default('split') %}

<div class="phone-input-wrapper">
    <div class="phone-input-shell">
        {% if store_mode == 'split' %}
            <input type="hidden" id="{{ hidden_country_id }}" name="{{ hidden_country_name }}" value="{{ country_code_value }}">
        {% endif %}
        <input
            class="form-input"
            name="{{ phone_field_name }}"
            value="{{ phone_value }}"
            type="tel"
            id="{{ phone_input_id }}"
            data-phone-store-mode="{{ store_mode }}"
            {% if store_mode == 'split' %}
            data-country-target-id="{{ hidden_country_id }}"
            {% endif %}
            autocomplete="tel"
            inputmode="tel"
            placeholder=" ">
        {% if hide_label is not defined or not hide_label %}
            <label class="phone-floating-label" for="{{ phone_input_id }}">{{ label_text|default('Mobile Phone') }}</label>
        {% endif %}
    </div>
</div>
