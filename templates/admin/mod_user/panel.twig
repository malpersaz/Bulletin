{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_navbar = false %}
{% set show_fab = false %}
{% set is_panel = true %}

{% block title %}{{ lang.mod_user.panel.panel_title }} - {{ lang.mod_user.panel.admin_brand }}{% endblock %}

{% block headline %}{{ lang.mod_user.panel.panel_title }}{% endblock %}

{% block styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/mod_user_modules.css?v=1.7">
{% endblock %}

{% block content %}
<div class="panel-modules" id="panelModules">

    {% for category in panel_categories %}
        <section class="panel-cat" data-cat-search="{{ category.search }}">
            {% if not category.hide_title and not (category.modules|length == 1 and category.label == category.modules[0].title) %}
            <h2 class="panel-cat-title">
                <i class="bi {{ category.icon }} panel-cat-icon"></i>
                {{ category.label }}
            </h2>
            {% endif %}
            <div class="panel-module-grid">
                {% for module in category.modules %}
                    <div class="panel-module-card" data-search="{{ module.search }}" data-title-search="{{ module.title_search }}">
                        <a class="panel-module-main" href="{{ module.links[0].url }}" data-default-url="{{ module.links[0].url }}">
                            <span class="panel-module-icon"><i class="bi {{ module.icon }}"></i></span>
                            <span class="panel-module-title-wrap">
                                <span class="panel-module-title" data-default-title="{{ module.title }}">{{ module.title }}</span>
                                <span class="panel-module-context" hidden></span>
                            </span>
                        </a>
                        <div class="panel-module-links">
                            {% for link in module.links %}
                                {% if link.action is defined %}
                                    <button type="button" class="panel-module-link" data-action="{{ link.action }}" data-link-search="{{ link.search }}">{{ link.label }}</button>
                                {% else %}
                                    <a href="{{ link.url }}" class="panel-module-link" data-link-search="{{ link.search }}">{{ link.label }}</a>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endfor %}

    <p class="panel-no-results" id="panelNoResults" hidden aria-live="polite">{{ lang.management.module_search_empty }}</p>

</div>
{% endblock %}

{% block fixed_bottom %}
<!-- Fixed Bottom Search -->
<div class="panel-search-bar">
    <div class="panel-search-pill">
        <i class="bi bi-search panel-search-icon" aria-hidden="true"></i>
        <input
            type="text"
            id="panelSearchInput"
            class="panel-search-input"
            placeholder="{{ lang.management.module_search_placeholder }}"
            autocomplete="off"
            aria-label="{{ lang.management.module_search_placeholder }}">
        <button type="button" class="panel-search-clear" id="panelSearchClear" hidden aria-label="{{ lang.mod_user.panel.clear_search }}">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
</div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script src="{{ site.address }}templates/admin/assets/js/mod_user_modules.js?v=1.9"></script>
{% endblock %}
