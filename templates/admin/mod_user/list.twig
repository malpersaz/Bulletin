{% set module_lang_key = 'mod_user' %}
{% set hide_navbar = true %}
{% set hide_fab = true %}
{% set show_search = true %}
{% set show_search_filter_button = false %}
{% set search_placeholder = lang.mod_user.admin.columns.username ~ ', ' ~ lang.mod_user.admin.columns.email ~ '...' %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_user.admin.list }}{% endblock %}
{% block headline %}{{ lang.mod_user.admin.list }}{% endblock %}

{% block content %}
<div class="content-stats-container">
    <div class="content-stats-row">
        <button type="button" class="content-stat-card active" data-status-filter="all" aria-label="{{ lang.mod_user.total_users }}">
            <div id="statTotalUsers" class="content-stat-value">{{ total_users|default(0) }}</div>
            <div class="content-stat-label">{{ lang.mod_user.total_users }}</div>
        </button>
        <button type="button" class="content-stat-card stat-active" data-status-filter="y" aria-label="{{ lang.mod_user.active_users }}">
            <div id="statActiveUsers" class="content-stat-value">{{ active_users|default(0) }}</div>
            <div class="content-stat-label">{{ lang.mod_user.active_users }}</div>
        </button>
        <button type="button" class="content-stat-card stat-pending" data-status-filter="pending" aria-label="{{ lang.mod_user.pending_users }}">
            <div id="statPendingUsers" class="content-stat-value">{{ pending_users|default(0) }}</div>
            <div class="content-stat-label">{{ lang.mod_user.pending_users }}</div>
        </button>
    </div>
</div>

<div id="ptrSpinner" class="ptr-spinner">
    <div class="spinner-track"></div>
</div>

<div id="userListContainer" class="content-list"
    data-module-url="{{ site.saddress }}mod_user/"
    data-data-url="{{ site.saddress }}mod_user/datatable_json"
    data-image-url="{{ site.iaddress }}mod_user/thumb/">
</div>

<div id="emptyState" class="empty-state is-hidden">
    <div class="empty-icon"><i class="bi bi-people"></i></div>
    <h3>{{ lang.mod_user.empty_state.title }}</h3>
    <p>{{ lang.mod_user.empty_state.desc }}</p>
    <div class="empty-state-actions">
        <a href="{{ site.saddress }}mod_user/add" class="m3-btn-filled">
            <i class="bi bi-plus-lg"></i> {{ lang.mod_user.add }}
        </a>
        <button type="button" class="m3-btn-tonal" data-action="clear-search">
            <i class="bi bi-x-circle"></i> {{ lang.mod_user.empty_state.clear_search }}
        </button>
    </div>
</div>

<div class="load-more-container">
    <button type="button" id="loadMoreBtn" class="load-more-btn is-hidden">
        <i class="bi bi-arrow-down-circle"></i>
        <span>{{ lang.mod_user.grid.page }}</span>
    </button>
</div>

<div id="infiniteLoader" class="infinite-loader is-hidden">
    <div class="spinner-track"></div>
    <span>{{ lang.mod_user.grid.loading_data }}</span>
</div>

<form id="filterForm" class="is-hidden">
    <input type="hidden" name="filter[identity]" id="filterSearch" value="">
    <input type="hidden" name="filter_radio[status]" id="filterStatus" value="">
    <input type="hidden" name="start" value="0">
    <input type="hidden" name="length" value="15">
    <input type="hidden" name="draw" value="1">
</form>
{% endblock %}

{% block fixed_bottom %}
<div class="standard-toolbar user-toolbar" id="userToolbar">
    <button type="button" class="toolbar-item is-disabled" id="toolbarEdit" title="{{ lang.mod_user.button.edit }}" aria-label="{{ lang.mod_user.button.edit }}">
        <i class="bi bi-pencil-fill"></i>
        <span>{{ lang.mod_user.button.edit }}</span>
    </button>

    <button type="button" class="toolbar-item is-disabled" id="toolbarActivate" title="{{ lang.mod_user.grid.status.key }}" aria-label="{{ lang.mod_user.grid.status.key }}">
        <i class="bi bi-eye-slash-fill" id="toolbarActivateIcon"></i>
        <span id="toolbarActivateText">{{ lang.mod_user.grid.deactivate_confirm.key }}</span>
    </button>

    <button type="button" class="toolbar-item is-disabled" id="toolbarAcl" title="{{ lang.mod_user.admin.roles }}" aria-label="{{ lang.mod_user.admin.roles }}">
        <i class="bi bi-shield-lock-fill"></i>
        <span>{{ lang.mod_user.admin.roles }}</span>
    </button>

    <button type="button" class="toolbar-item is-disabled" id="toolbarDelete" title="{{ lang.mod_user.button.delete }}" aria-label="{{ lang.mod_user.button.delete }}">
        <i class="bi bi-trash3-fill"></i>
        <span>{{ lang.mod_user.button.delete }}</span>
    </button>
</div>

<!-- Main FAB Link -->
<a class="main-fab" id="mainFab" href="{{ site.saddress }}mod_user/add" aria-label="{{ lang.mod_user.add }}">
    <i class="bi bi-plus-lg"></i>
</a>
{% endblock %}
