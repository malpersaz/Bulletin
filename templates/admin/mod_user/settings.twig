{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}
	{{ lang.mod_user.admin.membership_settings }}
{% endblock %}

{% block headline %}
	{{ lang.mod_user.admin.membership_settings }}
{% endblock %}

{% set back_url = '/' ~ site.lang ~ '/mod_user/list' %}
{% set breadcrumb_parent_url = '/' ~ site.lang ~ '/mod_user/list' %}
{% set breadcrumb_parent_title = lang.mod_user.name %}

{% block content %}
	{% macro select(parent_id, level, selected_id, group) %}
		{% for entry in attribute(group, parent_id) %}
			{% set current_parent_id = entry.group_id %}
			<option value="{{ entry.group_id }}" {% if entry.group_id == selected_id %}selected="selected"{% endif %}>
				{{ '-'|repeat(level * 2) ~ (entry.display_name|default(entry.name)) }}
			</option>
			{% if attribute(group, current_parent_id) is not empty and attribute(group, current_parent_id) is iterable %}
				{{ _self.select(current_parent_id, level + 1, selected_id, group) }}
			{% endif %}
		{% endfor %}
	{% endmacro %}

	<div class="edit-container" data-module="user-form" data-mode="settings">

		<div id="formAlert" class="form-alert-container">
			{% if Success is defined or success is defined %}
				<div class="banner-m3 banner-success">
					<i class="bi bi-check-circle-fill"></i>
					<span>{{ message }}</span>
				</div>
			{% endif %}

			{% if errors is defined and errors is not empty %}
				<div class="banner-m3 banner-danger">
					{% for error in errors %}
						<div class="error-item">
							<i class="bi bi-exclamation-circle-fill"></i>
							<span>{{ error }}</span>
						</div>
					{% endfor %}
				</div>
			{% endif %}
		</div>

		<form method="POST" action="" id="settingsForm" novalidate data-redirect-url="{{ redirect_url|default('/' ~ site.lang ~ '/mod_user/list') }}">
			<input type="hidden" name="edit" value="1">
			<div class="edit-card">
				<div class="card-header-edit">
					<i class="bi bi-gear-fill"></i>
					<h3>{{ lang.mod_user.admin.membership_settings }}</h3>
				</div>

				<div class="form-row">
					<label class="filter-group-label" for="group_id">{{ lang.mod_user.admin.settings.new_user_group }}</label>
					<div class="m3-input-wrapper">
						<select class="m3-input-lg" name="group_id" id="group_id">
							{{ _self.select(0, 0, d.group_id|default(group_id), group) }}
						</select>
					</div>
				</div>

				<div class="form-row">
					<label class="filter-group-label" for="status">{{ lang.mod_user.admin.settings.membership_open }}</label>
					<div class="m3-input-wrapper">
						<select name="status" id="status" class="m3-input-lg">
							<option value="1" {% if status == '1' %}selected="selected"{% endif %}>{{ lang.mod_user.admin.settings.open }}</option>
							<option value="0" {% if status == '0' %}selected="selected"{% endif %}>{{ lang.mod_user.admin.settings.closed }}</option>
						</select>
					</div>
				</div>

				<div class="form-row">
					<label class="filter-group-label" for="activation">{{ lang.mod_user.admin.settings.membership_activation }}</label>
					<div class="m3-input-wrapper">
						<select name="activation" id="activation" class="m3-input-lg">
							<option value="2" {% if activation == '2' %}selected="selected"{% endif %}>{{ lang.mod_user.admin.settings.admin_approval }}</option>
							<option value="1" {% if activation == '1' %}selected="selected"{% endif %}>{{ lang.mod_user.admin.settings.email_approval }}</option>
							<option value="0" {% if activation == '0' %}selected="selected"{% endif %}>{{ lang.mod_user.admin.settings.automatic_approval }}</option>
						</select>
					</div>
				</div>

				<div class="form-row">
					<label class="filter-group-label" for="check_user_login">{{ lang.mod_user.admin.settings.allow_multiple_logins }}</label>
					<div class="m3-input-wrapper">
						<select name="check_user_login" id="check_user_login" class="m3-input-lg">
							<option value="1" {% if check_user_login == '1' %}selected="selected"{% endif %}>
								{{ lang.mod_user.admin.settings.yes }}
							</option>
							<option value="2" {% if check_user_login == '2' %}selected="selected"{% endif %}>
								{{ lang.mod_user.admin.settings.no }}
							</option>
						</select>
					</div>
				</div>
			</div>
		</form>
	</div>
{% endblock %}

{% block fixed_bottom %}
	<div class="m3-final-bar">
		<a href="{{ back_url }}" class="m3-btn-half m3-btn-half-neutral">
			<i class="bi bi-x-lg"></i>
			<span>{{ lang.mod_user.button.cancel }}</span>
		</a>
		<button type="submit" form="settingsForm" id="submitBtn" name="edit" value="1" class="m3-btn-half m3-btn-half-primary">
			<i class="bi bi-check-lg" id="submitIcon"></i>
			<span id="submitText">{{ lang.mod_user.admin.update_membership_settings }}</span>
		</button>
	</div>
{% endblock %}
