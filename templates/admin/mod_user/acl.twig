{% set hide_navbar = true %}
{% set hide_fab = true %}
{% set hide_search = true %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_user.admin.9 }}{% endblock %}
{% block headline %}{{ lang.mod_user.admin.9 }}{% endblock %}

{% block content %}
<style>
    .acl-container {
        padding: 16px 16px 100px 16px;
        background: var(--md-sys-color-surface, #fdfbff);
    }
    .acl-module-card {
        background: var(--md-sys-color-surface-container, #f3edf7);
        border-radius: 28px;
        padding: 0;
        margin-bottom: 24px;
        border: none;
        overflow: hidden;
    }
    .acl-module-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        cursor: pointer;
        transition: background 0.2s;
        user-select: none;
    }
    .acl-module-header:active {
        background: rgba(0,0,0,0.03);
    }
    .acl-module-header i.header-icon {
        font-size: 22px;
        color: var(--md-sys-color-primary);
    }
    .acl-module-header .header-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--md-sys-color-primary);
        flex: 1;
    }
    .acl-module-header .chevron {
        font-size: 18px;
        color: var(--md-sys-color-on-surface-variant);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .acl-module-header .chevron.open {
        transform: rotate(180deg);
    }
    .acl-table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 0 0 28px 28px;
    }
    .acl-table {
        width: max-content;
        min-width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }
    .acl-table th {
        background: var(--md-sys-color-surface-variant, #e7e0eb);
        color: var(--md-sys-color-on-surface-variant);
        text-align: center;
        padding: 12px 16px;
        font-weight: 500;
        font-size: 13px;
        border-bottom: 1px solid var(--md-sys-color-outline-variant);
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 10;
    }
    .acl-table th:first-child {
        text-align: left;
        padding-left: 20px;
        width: 140px;
        min-width: 140px;
        position: sticky;
        left: 0;
        z-index: 30;
        background: #e7e0eb !important;
        box-shadow: 4px 0 8px rgba(0,0,0,0.1);
        white-space: normal;
    }
    .acl-table td {
        padding: 12px 16px;
        border-bottom: 1px solid var(--md-sys-color-outline-variant);
        vertical-align: middle;
        color: var(--md-sys-color-on-surface);
        font-size: 14px;
        text-align: center;
        background: #f3edf7;
    }
    .acl-table td:first-child {
        text-align: left;
        padding-left: 20px;
        width: 140px;
        min-width: 140px;
        position: sticky;
        left: 0;
        z-index: 20;
        background: #f3edf7 !important;
        font-weight: 600;
        box-shadow: 4px 0 8px rgba(0,0,0,0.1);
        white-space: normal;
        border-right: 1px solid rgba(0,0,0,0.05);
    }
    .acl-table tr:hover td {
        background: #eeeef2;
    }
    .acl-checkbox {
        width: 22px;
        height: 22px;
        accent-color: var(--md-sys-color-primary);
        cursor: pointer;
        border-radius: 6px;
    }
    .acl-group-toggle {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }
    .acl-group-name {
        font-size: 12px;
        font-weight: 600;
    }
</style>

{% if error %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Swal.fire({
                icon: 'warning',
                html: '<b><i class="bi bi-exclamation-triangle-fill"></i> {{ error }}</b>',
                confirmButtonText: '{{ lang.mod_user.button.evet }}',
                confirmButtonColor: '#ba1a1a'
            });
        });
    </script>
{% endif %}

<form action="" method="POST" id="aclForm" onsubmit="return false;">
    <div class="acl-container">
        {% for m in modlar %}
            {% set mod_name = m.mod_name %}
            {% set mod_id = m.mod_id %}
            <div class="acl-module-card">
                <div class="acl-module-header" onclick="toggleAclModule(this)">
                    <i class="bi bi-shield-lock-fill header-icon"></i>
                    <span class="header-title">
                        {{ attribute(lang, m.mod_name).roll.roles | default(attribute(lang, m.mod_name).roll.name) | default(m.mod_name) }}
                    </span>
                    <i class="bi bi-chevron-down chevron"></i>
                </div>
                <div class="acl-table-wrapper" style="display: none;">
                    <table class="acl-table">
                        <thead>
                            <tr>
                                <th>{{ lang.mod_user.admin.user_group }}</th>
                                {% for grup in gruplar %}
                                    <th style="min-width: 120px; border-left: 1px solid rgba(0,0,0,0.05);">
                                        <div class="acl-group-toggle">
                                            <input type="checkbox" class="acl-checkbox" onchange="toggleGroup(this, '{{ m.mod_id }}', '{{ grup.group_id }}')">
                                            <span class="acl-group-name">{{ lang.mod_user.groups[grup.name] | default(grup.name) }}</span>
                                        </div>
                                    </th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for roll in attribute(roller, mod_id) %}
                                <tr>
                                    {% set roll_name = roll.roll_name %}
                                    <td class="sticky-col">{{ attribute(attribute(lang, mod_name).roll, roll.roll_name) | default(roll.roll_name) }}</td>
                                    {% for grup in gruplar %}
                                        <td style="border-left: 1px solid rgba(0,0,0,0.05);">
                                            <input type="checkbox"
                                                   class="acl-checkbox g-{{ m.mod_id }}-{{ grup.group_id }}"
                                                   name="list[{{ grup.group_id }}][{{ m.mod_id }}][{{ roll.roll_id }}]"
                                                   onchange="updatePermission(this, '{{ grup.group_id }}', '{{ m.mod_id }}', '{{ roll.roll_id }}')"
                                                   {% for p in permler %}
                                                       {% if grup.group_id == p.group_id and m.mod_id == p.mod_id and roll.roll_id == p.roll_id %}
                                                           checked="checked"
                                                       {% endif %}
                                                   {% endfor %}>
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endfor %}
    </div>
</form>

<div id="saveStatus" style="position: fixed; top: 120px; left: 50%; transform: translateX(-50%); padding: 12px 24px; border-radius: 50px; background: #6750A4; color: white; font-size: 15px; font-weight: 600; display: none; z-index: 999999; box-shadow: 0 10px 25px rgba(0,0,0,0.4); border: 2px solid white; pointer-events: none;"></div>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button class="toolbar-item active" onclick="window.history.back()">
            <i class="bi bi-x-lg"></i>
            <span>{{ lang.mod_user.button.vazgec }}</span>
        </button>

        <div class="toolbar-fab" onclick="window.location.reload()">
            <i class="bi bi-arrow-clockwise"></i>
        </div>

        <button class="toolbar-item active" onclick="window.location.reload()">
            <i class="bi bi-arrow-clockwise"></i>
            <span>{{ lang.mod_user.admin.refresh_permissions | default('Rojanekirin') }}</span>
        </button>
    </div>
{% endblock %}

{% block scripts %}
<script>
    // Toggle module accordion
    function toggleAclModule(header) {
        var wrapper = header.nextElementSibling;
        var chevron = header.querySelector('.chevron');
        if (wrapper.style.display === 'none') {
            wrapper.style.display = 'block';
            chevron.classList.add('open');
        } else {
            wrapper.style.display = 'none';
            chevron.classList.remove('open');
        }
    }

    // AJAX function to update single permission
    function updatePermission(el, groupId, modId, rollId) {
        var status = document.getElementById('saveStatus');
        status.style.display = 'block';
        status.innerHTML = '<i class="bi bi-hourglass-split"></i> {{ lang.mod_user.admin.permissions_updated | default('Tê tomarkirin...') }}';
        
        var formData = new FormData();
        formData.append('group_id', groupId);
        formData.append('mod_id', modId);
        formData.append('roll_id', rollId);
        formData.append('checked', el.checked);

        // Robust URL detection (e.g., /ku/mod_user/acl -> /ku/mod_user/acl_ajax)
        var url = window.location.href.split('?')[0].replace(/\/acl$/, '/acl_ajax');

        fetch(url, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            status.innerHTML = '<i class="bi bi-check2-circle"></i> {{ lang.mod_user.admin.permissions_updated | default('Hate tomarkirin') }}';
            setTimeout(() => {
                status.style.display = 'none';
            }, 1200);
        })
        .catch(error => {
            console.error('Error:', error);
            status.style.background = '#ba1a1a';
            status.innerHTML = '<i class="bi bi-exclamation-triangle"></i> Şaşî derket!';
            setTimeout(() => {
                status.style.display = 'none';
                status.style.background = '#6750A4';
            }, 3000);
        });
    }

    // Toggle all checkboxes in a group column and update via AJAX
    function toggleGroup(el, modId, groupId) {
        var checked = el.checked;
        var cells = document.querySelectorAll('.g-' + modId + '-' + groupId);
        
        cells.forEach(function(cb) {
            if (cb.checked !== checked) {
                cb.checked = checked;
                var nameParts = cb.name.match(/\[(\d+)\]$/);
                if (nameParts && nameParts[1]) {
                    updatePermission(cb, groupId, modId, nameParts[1]);
                }
            }
        });
    }
</script>
{% endblock %}
