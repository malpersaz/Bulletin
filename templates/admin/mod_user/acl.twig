{% set hide_navbar = true %}
{% set hide_fab = true %}
{% set hide_search = true %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_user.admin.acl }}{% endblock %}
{% block headline %}{{ lang.mod_user.admin.acl }}{% endblock %}

{% block content %}
<style>
    .acl-container {
        padding: 16px 16px 100px 16px;
        background: var(--md-sys-color-surface, #fdfbff);
    }
    .acl-module-card {
        background: var(--md-sys-color-surface-container, #f3edf7);
        border-radius: 28px;
        padding: 0;
        margin-bottom: 24px;
        border: none;
        overflow: hidden;
    }
    .acl-module-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        cursor: pointer;
        transition: background 0.2s;
        user-select: none;
    }
    .acl-module-header:active {
        background: rgba(0,0,0,0.03);
    }
    .acl-module-header i.header-icon {
        font-size: 22px;
        color: var(--md-sys-color-primary);
    }
    .acl-module-header .header-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--md-sys-color-primary);
        flex: 1;
    }
    .acl-module-header .chevron {
        font-size: 18px;
        color: var(--md-sys-color-on-surface-variant);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .acl-module-header .chevron.open {
        transform: rotate(180deg);
    }
    .acl-table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 0 0 28px 28px;
    }
    .acl-table {
        width: max-content;
        min-width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }
    .acl-table th {
        background: var(--md-sys-color-surface-variant, #e7e0eb);
        color: var(--md-sys-color-on-surface-variant);
        text-align: center;
        padding: 12px 16px;
        font-weight: 500;
        font-size: 13px;
        border-bottom: 1px solid var(--md-sys-color-outline-variant);
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 10;
    }
    .acl-table th:first-child {
        text-align: left;
        padding-left: 20px;
        width: 140px;
        min-width: 140px;
        position: sticky;
        left: 0;
        z-index: 30;
        background: #e7e0eb !important;
        box-shadow: 4px 0 8px rgba(0,0,0,0.1);
        white-space: normal;
    }
    .acl-table td {
        padding: 12px 16px;
        border-bottom: 1px solid var(--md-sys-color-outline-variant);
        vertical-align: middle;
        color: var(--md-sys-color-on-surface);
        font-size: 14px;
        text-align: center;
        background: #f3edf7;
    }
    .acl-table td:first-child {
        text-align: left;
        padding-left: 20px;
        width: 140px;
        min-width: 140px;
        position: sticky;
        left: 0;
        z-index: 20;
        background: #f3edf7 !important;
        font-weight: 600;
        box-shadow: 4px 0 8px rgba(0,0,0,0.1);
        white-space: normal;
        border-right: 1px solid rgba(0,0,0,0.05);
    }
    .acl-table tr:hover td {
        background: #eeeef2;
    }
    .acl-checkbox {
        width: 22px;
        height: 22px;
        accent-color: var(--md-sys-color-primary);
        cursor: pointer;
        border-radius: 6px;
    }
    .acl-group-toggle {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }
    .acl-group-name {
        font-size: 12px;
        font-weight: 600;
    }
</style>

{% if error %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Swal.fire({
                icon: 'warning',
                html: '<b><i class="bi bi-exclamation-triangle-fill"></i> {{ error }}</b>',
                confirmButtonText: '{{ lang.mod_user.button.yes }}',
                confirmButtonColor: '#ba1a1a'
            });
        });
    </script>
{% endif %}

{% if oke is defined %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Swal.fire({
                icon: 'success',
                html: '<b><i class="bi bi-check-circle-fill"></i> {{ mesaj }}</b>',
                confirmButtonText: '{{ lang.mod_user.button.yes }}',
                confirmButtonColor: '#2e7d32'
            });
        });
    </script>
{% endif %}

<form action="" method="POST" id="aclForm">
    <div class="acl-container">
        {% for m in modlar %}
            {% set mod_name = m.mod_name %}
            {% set mod_id = m.mod_id %}
            {% set mod_roll_lang = attribute(attribute(lang, m.mod_name), 'roll') %}
            {% set mod_title = m.mod_name %}
            {% if mod_roll_lang is defined and mod_roll_lang.roles is defined %}
                {% set mod_title = mod_roll_lang.roles %}
            {% elseif mod_roll_lang is defined and mod_roll_lang.name is defined %}
                {% set mod_title = mod_roll_lang.name %}
            {% endif %}
            <div class="acl-module-card">
                <div class="acl-module-header" onclick="toggleAclModule(this)">
                    <i class="bi bi-shield-lock-fill header-icon"></i>
                    <span class="header-title">{{ mod_title }}</span>
                    <i class="bi bi-chevron-down chevron"></i>
                </div>
                <div class="acl-table-wrapper" style="display: none;">
                    <table class="acl-table">
                        <thead>
                            <tr>
                                <th>{{ lang.mod_user.admin.user_group }}</th>
                                {% for grup in gruplar %}
                                    <th style="min-width: 120px; border-left: 1px solid rgba(0,0,0,0.05);">
                                        <div class="acl-group-toggle">
                                            <input type="checkbox" class="acl-checkbox" onchange="toggleGroup(this, '{{ m.mod_id }}', '{{ grup.group_id }}')">
                                            <span class="acl-group-name">{{ lang.mod_user.groups[grup.name] is defined ? lang.mod_user.groups[grup.name] : grup.name }}</span>
                                        </div>
                                    </th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for roll in attribute(roller, mod_id) %}
                                <tr>
                                    {% set roll_name = roll.roll_name %}
                                    {% set role_label = roll.roll_name %}
                                    {% if mod_roll_lang is defined and attribute(mod_roll_lang, roll.roll_name) is defined %}
                                        {% set role_label = attribute(mod_roll_lang, roll.roll_name) %}
                                    {% endif %}
                                    <td class="sticky-col">{{ role_label }}</td>
                                    {% for grup in gruplar %}
                                        <td style="border-left: 1px solid rgba(0,0,0,0.05);">
                                            <input type="checkbox"
                                                   class="acl-checkbox g-{{ m.mod_id }}-{{ grup.group_id }}"
                                                   name="list[{{ grup.group_id }}][{{ m.mod_id }}][{{ roll.roll_id }}]"
                                                   {% for p in permler %}
                                                       {% if grup.group_id == p.group_id and m.mod_id == p.mod_id and roll.roll_id == p.roll_id %}
                                                           checked="checked"
                                                       {% endif %}
                                                   {% endfor %}>
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endfor %}
    </div>
</form>

{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button class="toolbar-item active" onclick="window.history.back()">
            <i class="bi bi-x-lg"></i>
            <span>{{ lang.mod_user.button.cancel }}</span>
        </button>

        <div class="toolbar-fab" onclick="document.getElementById('aclForm').submit()">
            <i class="bi bi-check-lg"></i>
        </div>

        <button class="toolbar-item active" onclick="document.getElementById('aclForm').submit()">
            <i class="bi bi-floppy-fill"></i>
            <span>{{ lang.mod_user.admin.refresh_permissions }}</span>
        </button>
    </div>
{% endblock %}

{% block scripts %}
<script>
    // Toggle module accordion
    function toggleAclModule(header) {
        var wrapper = header.nextElementSibling;
        var chevron = header.querySelector('.chevron');
        if (wrapper.style.display === 'none') {
            wrapper.style.display = 'block';
            chevron.classList.add('open');
        } else {
            wrapper.style.display = 'none';
            chevron.classList.remove('open');
        }
    }

    // Toggle all checkboxes in a group column
    function toggleGroup(el, modId, groupId) {
        var checked = el.checked;
        var cells = document.querySelectorAll('.g-' + modId + '-' + groupId);
        
        cells.forEach(function(cb) {
            cb.checked = checked;
        });
    }

    (function() {
        var form = document.getElementById('aclForm');
        if (form) {
            var hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'gonder';
            hidden.value = '{{ lang.mod_user.admin.refresh_permissions }}';
            form.appendChild(hidden);
        }
    })();
</script>
{% endblock %}
