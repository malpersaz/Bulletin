{% set hide_navbar = true %}
{% set hide_fab = true %}
{% set hide_search = true %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_user.admin.acl }}{% endblock %}
{% block headline %}{{ lang.mod_user.admin.acl }}{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="/templates/admin/assets/css/mod_user_acl.css?v=2.0">
{% endblock %}

{% block content %}
<div class="acl-container" id="aclContainer">

    <!-- Top Asynchronous Progress Bar -->
    <div id="aclProgressBar" class="acl-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-hidden="true">
        <div class="acl-progress-bar-fill"></div>
    </div>

    <!-- Sticky User Group Carousel Navigation -->
    <nav class="acl-group-carousel-container" aria-label="{{ lang.mod_user.admin.user_group }}">
        <div class="acl-group-carousel" role="tablist" aria-label="{{ lang.mod_user.admin.user_group }}">
            {% for group in groups %}
                {% set g_name = lang.mod_user.groups[group.name] is defined ? lang.mod_user.groups[group.name] : group.name %}
                <button type="button"
                        role="tab"
                        class="acl-group-tab {% if loop.first %}is-active{% endif %}"
                        id="tab-group-{{ group.group_id }}"
                        data-group-id="{{ group.group_id }}"
                        data-group-name="{{ g_name }}"
                        aria-selected="{% if loop.first %}true{% else %}false{% endif %}"
                        tabindex="{% if loop.first %}0{% else %}-1{% endif %}">
                    <span class="tab-label">{{ g_name }}</span>
                </button>
            {% endfor %}
        </div>
    </nav>

    <!-- Search & Summary Metrics Toolbar -->
    <section class="acl-toolbar" aria-label="ACL Toolbar">
        <div class="acl-metrics-card">
            <div class="acl-metrics-pill">
                <span class="metrics-label">{{ lang.mod_user.admin.user_group }}:</span>
                <strong id="activeGroupLabel" class="metrics-active-name"></strong>
                <span class="metrics-separator">•</span>
                <span class="metrics-count-wrap">
                    <span id="totalEnabledCount" class="metrics-number">0</span>
                    <span class="metrics-slash">/</span>
                    <span id="totalAvailableCount" class="metrics-total">0</span>
                    <span class="metrics-unit">{{ lang.mod_user.admin.enabled }}</span>
                </span>
            </div>
        </div>

        <div class="acl-search-container">
            <div class="acl-search-wrapper">
                <i class="bi bi-search acl-search-icon"></i>
                <input type="search"
                       id="aclSearchInput"
                       class="acl-search-input"
                       placeholder="{{ lang.management.module_search_placeholder }}"
                       autocomplete="off"
                       spellcheck="false">
                <button type="button" class="acl-clear-search-btn is-hidden" data-action="clear-search" aria-label="{{ lang.mod_user.admin.clear_search|e('html_attr') }}">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- Empty Search State -->
    <div id="aclEmptyState" class="acl-empty-state is-hidden" role="region" aria-live="polite">
        <i class="bi bi-search acl-empty-icon"></i>
        <h3 class="acl-empty-title">{{ lang.mod_user.admin.search_no_results }}</h3>
        <p class="acl-empty-desc">{{ lang.mod_user.admin.search_try_again }}</p>
        <button type="button" class="acl-btn-reset-search" data-action="clear-search">{{ lang.mod_user.admin.clear_search }}</button>
    </div>

    <!-- Modules List Accordions -->
    <div class="acl-modules-list" id="aclModulesList">
        {% for m in modules %}
            {% set mod_name = m.mod_name %}
            {% set mod_id = m.mod_id %}
            {% set mod_role_lang = attribute(attribute(lang, m.mod_name), 'role') %}
            {% set mod_title = m.mod_name %}
            {% if mod_role_lang is defined and mod_role_lang.roles is defined %}
                {% set mod_title = mod_role_lang.roles %}
            {% elseif mod_role_lang is defined and mod_role_lang.name is defined %}
                {% set mod_title = mod_role_lang.name %}
            {% endif %}
            
            {% set mod_roles = attribute(roles, mod_id)|default([]) %}
            {% if mod_roles|length > 0 %}
                <article class="acl-module-card is-expanded" data-module-id="{{ mod_id }}">
                    <button type="button" class="acl-module-header" id="heading-mod-{{ mod_id }}" aria-expanded="true" aria-controls="body-mod-{{ mod_id }}">
                        <div class="module-header-left">
                            <div class="module-icon-badge">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <div class="module-text-wrap">
                                <h3 class="module-title">{{ mod_title }}</h3>
                                <span class="module-code">{{ mod_name }}</span>
                            </div>
                        </div>
                        <div class="module-header-right">
                            <span class="acl-module-counter" data-module-counter="{{ mod_id }}">{{ lang.mod_user.admin.permission_counter|format(0, mod_roles|length) }}</span>
                            <i class="bi bi-chevron-down acl-chevron"></i>
                        </div>
                    </button>

                    <div class="acl-module-body" id="body-mod-{{ mod_id }}" role="region" aria-labelledby="heading-mod-{{ mod_id }}">
                        <!-- Action Bar (Grant All / Revoke All) -->
                        <div class="acl-module-actions-bar">
                            <button type="button" class="acl-btn-action acl-btn-grant" data-action="grant-all" data-module-id="{{ mod_id }}">
                                <i class="bi bi-check2"></i>
                                <span>{{ lang.mod_user.admin.grant_all }}</span>
                            </button>
                            <button type="button" class="acl-btn-action acl-btn-revoke" data-action="revoke-all" data-module-id="{{ mod_id }}">
                                <i class="bi bi-x-lg"></i>
                                <span>{{ lang.mod_user.admin.revoke_all }}</span>
                            </button>
                        </div>

                        <!-- Permission Rows -->
                        <div class="acl-permission-rows">
                            {% for role in mod_roles %}
                                {% set role_label = role.role_name %}
                                {% if mod_role_lang is defined and attribute(mod_role_lang, role.role_name) is defined %}
                                    {% set role_label = attribute(mod_role_lang, role.role_name) %}
                                {% endif %}
                                <div class="acl-permission-row" data-role-id="{{ role.role_id }}">
                                    <div class="permission-info">
                                        <span class="permission-name">{{ role_label }}</span>
                                        <span class="permission-code">{{ role.role_name }}</span>
                                    </div>
                                    <div class="permission-control">
                                        <button type="button"
                                                role="switch"
                                                class="acl-permission-switch"
                                                data-mod-id="{{ mod_id }}"
                                                data-role-id="{{ role.role_id }}"
                                                aria-checked="false"
                                                aria-label="{{ role_label }}">
                                            <span class="switch-track"><span class="switch-thumb"></span></span>
                                        </button>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </article>
            {% endif %}
        {% endfor %}
    </div>

    <!-- Hidden Initial Permissions Dataset for Fast JS Hydration -->
    <div id="aclInitialData" hidden
         data-permissions="{{ permissions|json_encode|e('html_attr') }}"
         data-groups="{{ groups|json_encode|e('html_attr') }}"
         data-counter-template="{{ lang.mod_user.admin.permission_counter|e('html_attr') }}">
    </div>

    <!-- Safe Bottom Spacer -->
    <div class="acl-bottom-spacer" aria-hidden="true"></div>

    <!-- MD3 Floating Toast -->
    <div id="aclToast" class="acl-toast" role="status" aria-live="polite" aria-hidden="true">
        <i class="bi bi-check-circle-fill acl-toast-icon"></i>
        <span id="aclToastMsg" class="acl-toast-message"></span>
    </div>
</div>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button type="button" class="toolbar-item active" id="btnAclBack" title="{{ lang.mod_user.button.cancel }}">
            <i class="bi bi-x-lg"></i>
            <span>{{ lang.mod_user.button.cancel }}</span>
        </button>
    </div>
{% endblock %}

{% block scripts %}
    <script src="/templates/admin/assets/js/mod_user_acl.js?v=1.1"></script>
{% endblock %}
