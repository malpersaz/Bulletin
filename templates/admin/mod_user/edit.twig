{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}
	{{ lang.mod_user.admin.edit_user }}
{% endblock %}

{% block headline %}
	{{ lang.mod_user.admin.edit_user }}
{% endblock %}

{% set back_url = '/' ~ site.lang ~ '/mod_user/list' %}
{% set breadcrumb_parent_url = '/' ~ site.lang ~ '/mod_user/list' %}
{% set breadcrumb_parent_title = lang.mod_user.name %}

{% block content %}
	{% macro select(parent_id, level, selected_id, group) %}
		{% for entry in attribute(group, parent_id) %}
			{% set current_parent_id = entry.group_id %}
			<option value="{{ entry.group_id }}" {% if entry.group_id == selected_id %}selected="selected"{% endif %}>
				{{ '-'|repeat(level * 2) ~ (entry.display_name|default(entry.name)) }}
			</option>
			{% if attribute(group, current_parent_id) is defined and attribute(group, current_parent_id) is iterable and attribute(group, current_parent_id) is not empty %}
				{{ _self.select(current_parent_id, level + 1, selected_id, group) }}
			{% endif %}
		{% endfor %}
	{% endmacro %}

	<div class="edit-container" data-module="user-form" data-mode="edit">

		<div id="formAlert" class="form-alert-container">
			{% if Success is defined or success is defined %}
				<div class="banner-m3 banner-success">
					<i class="bi bi-check-circle-fill"></i>
					<span>{{ message }}</span>
				</div>
			{% endif %}

			{% if errors is defined and errors is not empty %}
				<div class="banner-m3 banner-danger">
					{% for error in errors %}
						<div class="error-item">
							<i class="bi bi-exclamation-circle-fill"></i>
							<span>{{ error }}</span>
						</div>
					{% endfor %}
				</div>
			{% endif %}
		</div>

		<form method="POST" action="" id="editForm" enctype="multipart/form-data" novalidate data-redirect-url="{{ redirect_url|default('/' ~ site.lang ~ '/mod_user/list') }}">
			<input type="hidden" name="edit" value="1">
			<input type="hidden" name="delete_image" id="deleteImageInput" value="0">
			<input type="file" name="image" id="image" class="visually-hidden" accept="image/*" data-action="preview-avatar">

			{# Hero Identity Card with Avatar & Live Info #}
			<div class="m3-profile-hero">
				<div class="m3-hero-avatar-wrapper" id="avatarPreviewContainer" data-initial-src="{% if d.image is defined and d.image != '' %}{{ site.iaddress }}mod_user/{{ d.image }}{% endif %}">
					{% if d.image is defined and d.image != '' %}
						<img src="{{ site.iaddress }}mod_user/{{ d.image }}" id="avatarPreview" class="m3-hero-avatar" alt="Avatar">
						<button type="button" class="m3-hero-avatar-btn remove-btn" data-action="delete-avatar" title="{{ lang.mod_user.admin.remove_avatar }}">
							<i class="bi bi-trash"></i>
						</button>
					{% else %}
						<div class="m3-hero-avatar-placeholder" data-action="select-avatar" role="button" tabindex="0" title="{{ lang.mod_user.admin.upload_avatar }}">
							<i class="bi bi-person-fill"></i>
						</div>
						<button type="button" class="m3-hero-avatar-btn upload-btn" data-action="select-avatar" title="{{ lang.mod_user.admin.upload_avatar }}">
							<i class="bi bi-camera-fill"></i>
						</button>
					{% endif %}
				</div>
				<div class="m3-hero-info">
					<h3 class="m3-hero-name" id="heroNamePreview">
						{{ d.name|default('') }} {{ d.last_name|default('') }}
					</h3>
					<p class="m3-hero-email" id="heroSubtitlePreview">
						@{{ d.username|default('user') }}
					</p>
					{% if d.created_at is defined and d.created_at != '' %}
						<span class="m3-hero-badge">
							<i class="bi bi-calendar-event"></i> {{ lang.mod_user.membership_date }}: {{ d.created_at }}
						</span>
					{% endif %}
				</div>
			</div>

			{# 3-Tab Segmented Navigation #}
			<div class="m3-profile-tabs" role="tablist">
				<button type="button" class="m3-tab-btn active" data-action="switch-tab" data-tab-target="tab-basic-info" role="tab" aria-selected="true">
					<i class="bi bi-person-vcard"></i>
					<span>{{ lang.mod_user.admin.tab_basic }}</span>
				</button>
				<button type="button" class="m3-tab-btn" data-action="switch-tab" data-tab-target="tab-author-profile" role="tab" aria-selected="false">
					<i class="bi bi-journal-text"></i>
					<span>{{ lang.mod_user.admin.tab_author }}</span>
				</button>
				<button type="button" class="m3-tab-btn" data-action="switch-tab" data-tab-target="tab-social-media" role="tab" aria-selected="false">
					<i class="bi bi-share"></i>
					<span>{{ lang.mod_user.admin.tab_social }}</span>
				</button>
			</div>

			{# Tab 1: Identity & Account #}
			<div class="m3-tab-content active" id="tab-basic-info" role="tabpanel">
				{# Account Credentials Card #}
				<div class="edit-card">
					<div class="card-header-edit">
						<i class="bi bi-shield-lock-fill"></i>
						<h3>{{ lang.mod_user.admin.tab_basic }}</h3>
					</div>

					<div class="form-row">
						<div class="m3-input-wrapper">
							<input class="m3-input-lg" name="username" value="{{ d.username|default('') }}" type="text" id="username" autocomplete="username" placeholder=" " required data-sync-hero="username">
							<label class="m3-floating-label" for="username">{{ lang.mod_user.username }}</label>
						</div>
					</div>

					<div class="form-row">
						<div class="m3-input-wrapper">
							<input class="m3-input-lg" name="email" value="{{ d.email|default('') }}" type="email" id="email" autocomplete="email" placeholder=" " required>
							<label class="m3-floating-label" for="email">{{ lang.mod_user.email }}</label>
						</div>
					</div>

					<div class="form-row">
						<div class="m3-input-wrapper">
							<input class="m3-input-lg" name="password" type="password" id="password" autocomplete="new-password" placeholder=" " data-action="check-strength">
							<label class="m3-floating-label" for="password">{{ lang.mod_user.new_password }}</label>
							<div class="input-icon-right" data-action="toggle-password" data-target="password" role="button" tabindex="0" title="Show/Hide Password">
								<i class="bi bi-eye"></i>
							</div>
						</div>
						<div class="strength-container">
							<div class="strength-bar">
								<div id="strength-progress" class="strength-progress"></div>
							</div>
							<div id="strength-text" class="strength-text"></div>
						</div>
					</div>

					<div class="form-row">
						<label class="filter-group-label" for="group_id">{{ lang.mod_user.admin.user_group }}</label>
						<div class="m3-input-wrapper">
							<select class="m3-input-lg" name="group_id" id="group_id" required>
								{{ _self.select(0, 0, d.group_id, group) }}
							</select>
						</div>
					</div>

					<div class="form-row">
						<label class="filter-group-label" for="status">{{ lang.mod_user.admin.columns.status }}</label>
						<div class="m3-input-wrapper">
							<select class="m3-input-lg" name="status" id="status" required>
								<option value="y" {% if d.status == 'y' %} selected {% endif %}>{{ lang.mod_user.grid.active }}</option>
								<option value="n" {% if d.status == 'n' %} selected {% endif %}>{{ lang.mod_user.grid.waiting_email_activation }}</option>
								<option value="a" {% if d.status == 'a' %} selected {% endif %}>{{ lang.mod_user.grid.waiting_admin_activation }}</option>
							</select>
						</div>
					</div>
				</div>

				{# Personal Details Card #}
				<div class="edit-card">
					<div class="card-header-edit">
						<i class="bi bi-person-lines-fill"></i>
						<h3>{{ lang.mod_user.personal_info }}</h3>
					</div>

					<div class="contact-grid">
						<div class="form-row">
							<div class="m3-input-wrapper">
								<input class="m3-input-lg" name="name" value="{{ d.name|default('') }}" type="text" id="name" autocomplete="given-name" placeholder=" " required data-sync-hero="name">
								<label class="m3-floating-label" for="name">{{ lang.mod_user.your_name }}</label>
							</div>
						</div>

						<div class="form-row">
							<div class="m3-input-wrapper">
								<input class="m3-input-lg" name="last_name" value="{{ d.last_name|default('') }}" type="text" id="last_name" autocomplete="family-name" placeholder=" " required data-sync-hero="last_name">
								<label class="m3-floating-label" for="last_name">{{ lang.mod_user.your_surname }}</label>
							</div>
						</div>
					</div>

					<div class="form-row">
						{% include 'mod_user/parts/phone_input.twig' with {
							'country_code_value': d.country_code|default('+90'),
							'phone_value': d.phone_national|default(''),
							'label_text': lang.mod_user.mobile_phone,
							'input_id': 'phone'
						} %}
					</div>

					<div class="form-row">
						<div class="m3-input-wrapper">
							<input class="m3-input-lg" name="city" value="{{ d.city|default('') }}" type="text" id="city" autocomplete="address-level2" placeholder=" ">
							<label class="m3-floating-label" for="city">{{ lang.mod_user.city }}</label>
						</div>
					</div>
				</div>
			</div>

			{# Tab 2: Author Profile #}
			<div class="m3-tab-content" id="tab-author-profile" role="tabpanel">
				<div class="edit-card">
					<div class="card-header-edit">
						<i class="bi bi-feather"></i>
						<h3>{{ lang.mod_user.admin.tab_author }}</h3>
					</div>

					<div class="form-row">
						<div class="m3-input-wrapper">
							<input class="m3-input-lg" name="blog_name" value="{{ d.blog_name|default('') }}" type="text" id="blog_name" placeholder=" ">
							<label class="m3-floating-label" for="blog_name">{{ lang.mod_user.blog_name }}</label>
						</div>
					</div>

					<div class="form-row">
						<div class="m3-input-wrapper">
							<textarea class="m3-input-lg" name="about" id="about" rows="5" placeholder=" " data-counter-id="aboutCounter" data-char-limit="500">{{ d.about|default('') }}</textarea>
							<label class="m3-floating-label" for="about">{{ lang.mod_user.about_me }}</label>
						</div>
						<div class="m3-char-counter" id="aboutCounter">
							{{ (d.about|default(''))|length }} / 500
						</div>
					</div>
				</div>
			</div>

			{# Tab 3: Social Media #}
			<div class="m3-tab-content" id="tab-social-media" role="tabpanel">
				<div class="edit-card">
					<div class="card-header-edit">
						<i class="bi bi-globe2"></i>
						<h3>{{ lang.mod_user.admin.social_media }}</h3>
					</div>
					{% include 'mod_user/parts/social_links.twig' with {
						'social_platforms': social_platforms,
						'social_links': d.social_links|default({}),
						'social_active': d.social_active|default({})
					} %}
				</div>
			</div>
		</form>
	</div>
{% endblock %}

{% block fixed_bottom %}
	<div class="m3-final-bar">
		<a href="{{ back_url }}" class="m3-btn-half m3-btn-half-neutral">
			<i class="bi bi-x-lg"></i>
			<span>{{ lang.mod_user.button.cancel }}</span>
		</a>
		<button type="submit" form="editForm" id="submitBtn" name="edit" value="1" class="m3-btn-half m3-btn-half-primary">
			<i class="bi bi-check-lg" id="submitIcon"></i>
			<span id="submitText">{{ lang.mod_user.button.save }}</span>
		</button>
	</div>
{% endblock %}
