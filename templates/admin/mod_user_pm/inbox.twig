{% set show_fab = false %}
{% set show_navbar = false %}
{% set show_search = true %}
{% set show_search_filter_button = false %}
{% set show_sidebar = false %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set show_extra_sheets = false %}
{% set hide_contextual_bar = true %}
{% set search_placeholder = lang.mod_user_pm.search %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_user_pm.inbox_title }}{% endblock %}
{% block headline %}{{ lang.mod_user_pm.inbox_title }}{% endblock %}

{% block content %}
<div class="pm-inbox-shell"
     data-delete-title="{{ lang.mod_user_pm.confirm_delete_msg }}"
     data-delete-text="{{ lang.mod_user_pm.confirm_delete_msg }}"
     data-delete-confirm="{{ lang.mod_user_pm.confirm_delete_yes }}"
     data-delete-cancel="{{ lang.mod_user_pm.cancel }}"
     data-delete-success="{{ lang.mod_user_pm.message_deleted_success }}">

    <p class="pm-inbox-intro">{{ lang.mod_user_pm.inbox_area_desc }}</p>

    <div id="message-list-container" class="pm-inbox-list"></div>

    <section id="empty-state"
             class="pm-empty-state"
             data-empty-title="{{ lang.mod_user_pm.no_messages }}"
             data-empty-desc="{{ lang.mod_user_pm.empty_desc }}"
             data-search-title="{{ lang.mod_user_pm.no_messages }}"
             data-search-desc="{{ lang.mod_user_pm.empty_search_desc }}"
             style="display: none;">
        <div class="pm-empty-icon"><i class="bi bi-inbox"></i></div>
        <h3>{{ lang.mod_user_pm.no_messages }}</h3>
        <p>{{ lang.mod_user_pm.empty_desc }}</p>
    </section>

    <div id="infinite-loader" class="pm-inbox-loader" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">{{ lang.mod_user_pm.loading }}</span>
        </div>
    </div>

    <form id="filterForm" hidden>
        <input type="hidden" name="start" id="filterStart" value="0">
        <input type="hidden" name="length" id="filterLength" value="10">
        <input type="hidden" name="draw" id="filterDraw" value="1">
        <input type="hidden" name="arama[subject]" id="filterSearch" value="">
        <input type="hidden" name="order[0][column]" id="filterSortColumn" value="1">
        <input type="hidden" name="order[0][dir]" id="filterSortDir" value="desc">
    </form>
</div>
{% endblock %}

{% block styles %}
<style>
    .pm-inbox-shell {
        --pm-bg: linear-gradient(180deg, #eef3ee 0%, #edf4f2 36%, #f7efe2 100%);
        --pm-surface: rgba(255, 255, 255, 0.84);
        --pm-line: rgba(36, 54, 43, 0.12);
        --pm-text: #18231c;
        --pm-muted: #637166;
        --pm-primary: #234f3e;
        --pm-primary-soft: #dcebe1;
        --pm-accent: #c47532;
        --pm-danger: #ad2d2d;
        padding: 8px 16px 16px;
        min-height: auto;
        background:
            radial-gradient(circle at top left, rgba(35, 79, 62, 0.16), transparent 24%),
            radial-gradient(circle at bottom right, rgba(196, 117, 50, 0.16), transparent 28%),
            var(--pm-bg);
        color: var(--pm-text);
    }

    .pm-inbox-list {
        display: grid;
        gap: 12px;
    }

    .pm-inbox-intro {
        margin: 0 0 12px;
        font-size: 13px;
        line-height: 1.6;
        color: var(--pm-muted);
    }

    .pm-inbox-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 14px;
        margin-bottom: 0;
        border-radius: 18px;
        border: 1px solid rgba(48, 59, 47, 0.1);
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.78)),
            linear-gradient(135deg, rgba(220, 235, 225, 0.4), rgba(255, 255, 255, 0.2));
        box-shadow: 0 12px 40px rgba(35, 47, 33, 0.06);
        cursor: pointer;
    }

    .pm-inbox-card.is-unread {
        border-color: rgba(35, 79, 62, 0.18);
        box-shadow: 0 18px 42px rgba(35, 79, 62, 0.08);
    }

    .pm-inbox-topline {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: 10px;
        align-items: center;
    }

    .pm-inbox-avatar {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: linear-gradient(135deg, var(--pm-primary-soft), #f0f4ee);
        color: var(--pm-primary);
        font-size: 18px;
        font-weight: 800;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .pm-inbox-sender {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .pm-inbox-sender-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--pm-muted);
    }

    .pm-inbox-sender h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .pm-inbox-date {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        font-size: 11px;
        color: var(--pm-muted);
        font-weight: 700;
    }

    .pm-inbox-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 28px;
        padding: 0 10px;
        border-radius: 999px;
        background: rgba(35, 79, 62, 0.1);
        color: var(--pm-primary);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .pm-inbox-subject {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 12px 14px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.76);
        border: 1px solid rgba(48, 59, 47, 0.08);
    }

    .pm-inbox-subject-line {
        color: var(--pm-text);
        font-size: 16px;
        font-weight: 750;
        line-height: 1.35;
        letter-spacing: -0.02em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pm-inbox-preview {
        color: var(--pm-muted);
        font-size: 12px;
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .pm-inbox-status-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .pm-inbox-status {
        font-size: 12px;
        font-weight: 700;
        color: var(--pm-muted);
    }

    .pm-inbox-status.is-unread {
        color: var(--pm-primary);
    }

    .pm-inbox-menu {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        border: 1px solid rgba(48, 59, 47, 0.1);
        background: rgba(255, 255, 255, 0.88);
        color: var(--pm-muted);
        cursor: pointer;
    }

    .pm-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 56px 28px;
        border-radius: 26px;
        border: 1px dashed rgba(48, 59, 47, 0.18);
        background: var(--pm-surface);
        text-align: center;
    }

    .pm-empty-icon {
        width: 76px;
        height: 76px;
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(35, 79, 62, 0.1), rgba(196, 117, 50, 0.12));
        color: var(--pm-primary);
        font-size: 30px;
    }

    .pm-empty-state h3 {
        margin: 0;
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .pm-empty-state p {
        max-width: 52ch;
        margin: 0;
        color: var(--pm-muted);
        line-height: 1.7;
    }

    .pm-inbox-loader {
        justify-content: center;
        padding: 20px;
    }

    @media (max-width: 767px) {
        .pm-inbox-shell {
            padding: 8px 12px 12px;
        }

        .pm-inbox-topline {
            grid-template-columns: auto 1fr;
        }

        .pm-inbox-date {
            grid-column: 1 / -1;
            align-items: flex-start;
            flex-direction: row;
            justify-content: space-between;
        }
    }
</style>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button class="toolbar-item" onclick="history.back()">
            <i class="bi bi-chevron-left"></i>
            <span>{{ lang.mod_user_pm.back }}</span>
        </button>

        <button class="toolbar-item active" onclick="location.href='mod_user_pm/inbox'">
            <i class="bi bi-inbox-fill"></i>
            <span>{{ lang.mod_user_pm.inbox_title }}</span>
        </button>

        <button type="button"
                class="toolbar-fab"
                onclick="location.href='mod_user_pm/send'"
                aria-label="{{ lang.mod_user_pm.new_message_action }}"
                title="{{ lang.mod_user_pm.new_message_action }}">
            <i class="bi bi-plus-lg"></i>
        </button>

        <button class="toolbar-item" onclick="location.href='mod_user_pm/sent'">
            <i class="bi bi-send"></i>
            <span>{{ lang.mod_user_pm.sent_title }}</span>
        </button>

        <button class="toolbar-item" onclick="window.messageManager?.loadData(true)">
            <i class="bi bi-arrow-clockwise"></i>
            <span>{{ lang.mod_user_pm.refresh_action }}</span>
        </button>
    </div>
{% endblock %}

{% block scripts %}
<script>
    const RADRES_URL = '{{ site.radres }}';
    const PM_LANG = {
        read: "{{ lang.mod_user_pm.view_action|e('js') }}",
        reply: "{{ lang.mod_user_pm.reply_action|e('js') }}",
        delete: "{{ lang.mod_user_pm.delete_action|e('js') }}",
        unread: "{{ lang.mod_user_pm.unread_status|e('js') }}",
        read_status: "{{ lang.mod_user_pm.read_status|e('js') }}",
        new_tag: "{{ lang.mod_user_pm.new_tag|e('js') }}",
        loading: "{{ lang.mod_user_pm.loading|e('js') }}",
        load_more: "{{ lang.mod_user_pm.next|e('js') }}",
        confirm_title: "{{ lang.mod_user_pm.confirm_delete_msg|e('js') }}",
        confirm_yes: "{{ lang.mod_user_pm.confirm_delete_yes|e('js') }}",
        confirm_no: "{{ lang.mod_user_pm.cancel|e('js') }}",
        delete_success: "{{ lang.mod_user_pm.message_deleted_success|e('js') }}",
        today_label: "{{ lang.mod_user_pm.today_label|e('js') }}",
        yesterday_label: "{{ lang.mod_user_pm.yesterday_label|e('js') }}",
        sender_label: "{{ lang.mod_user_pm.sender_col|e('js') }}"
    };
</script>
<script src="/templates/admin/assets/js/mod_user_pm.js?v=1.6"></script>
{% endblock %}
