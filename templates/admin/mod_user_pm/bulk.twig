{% set show_fab = false %}
{% set show_navbar = false %}
{% set show_sidebar = false %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set show_extra_sheets = false %}
{% set hide_contextual_bar = true %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_user_pm.bulk_pm_area_desc }}{% endblock %}
{% block headline %}{{ lang.mod_user_pm.bulk_pm_area_desc }}{% endblock %}

{% block content %}
<div class="pm-compose-shell pm-compose-shell-bulk">
    <section class="pm-compose-card">
        <div class="pm-compose-head">
            <div class="pm-compose-icon"><i class="bi bi-people"></i></div>
            <div class="pm-compose-title">
                <span class="pm-compose-chip">{{ lang.mod_user_pm.usernames_label }}</span>
                <h1>{{ lang.mod_user_pm.bulk_pm_area_desc }}</h1>
                <p>{{ lang.mod_user_pm.select_multiple_recipients_help }}</p>
            </div>
        </div>

        {% if oke is defined %}
            <div class="pm-compose-alert pm-compose-alert-success">
                <i class="bi bi-check-circle-fill"></i>
                <div><strong>{{ lang.mod_user_pm.success_prefix }}</strong> {{ message }}</div>
            </div>

            <div class="pm-compose-success-actions">
                <a href="mod_user_pm/sent" class="pm-compose-secondary">
                    <i class="bi bi-send"></i>
                    <span>{{ lang.mod_user_pm.sent_link_label }}</span>
                </a>
            </div>
        {% else %}
            {% if errors is defined %}
                {% for error in errors %}
                    <div class="pm-compose-alert pm-compose-alert-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div><strong>{{ lang.mod_user_pm.error_prefix }}</strong> {{ error }}</div>
                    </div>
                {% endfor %}
            {% endif %}

            <form method="POST" action="" id="bulk" class="pm-compose-form" novalidate>
                <label class="pm-compose-field">
                    <span class="pm-compose-label">{{ lang.mod_user_pm.usernames_label }}</span>
                    <div class="pm-compose-input-shell pm-compose-select-shell">
                        <i class="bi bi-people"></i>
                        <select name="recipients[]" id="recipients" multiple required>
                            {% if recipients %}
                                {% for k in recipients|split(',') %}
                                    <option value="{{ k }}" selected>{{ k }}</option>
                                {% endfor %}
                            {% endif %}
                        </select>
                    </div>
                    <small>{{ lang.mod_user_pm.select_multiple_recipients_help }}</small>
                </label>

                <label class="pm-compose-field">
                    <span class="pm-compose-label">{{ lang.mod_user_pm.subject_label }}</span>
                    <div class="pm-compose-input-shell">
                        <i class="bi bi-tag"></i>
                        <input name="subject"
                               value="{{ subject }}"
                               type="text"
                               id="subject"
                               placeholder="{{ lang.mod_user_pm.subject_placeholder }}"
                               required>
                    </div>
                </label>

                <label class="pm-compose-field">
                    <span class="pm-compose-label">{{ lang.mod_user_pm.message_label }}</span>
                    <div class="pm-compose-textarea-shell">
                        <textarea name="message"
                                  id="message"
                                  rows="8"
                                  placeholder="{{ lang.mod_user_pm.message_placeholder }}"
                                  required>{{ message }}</textarea>
                    </div>
                </label>

                <div class="pm-compose-actions">
                    <button type="submit" name="bulk" value="{{ lang.mod_user_pm.send_button }}" class="pm-compose-primary">
                        <i class="bi bi-send-fill"></i>
                        <span>{{ lang.mod_user_pm.send_button }}</span>
                    </button>
                    <button type="reset" class="pm-compose-ghost">{{ lang.mod_user_pm.cancel }}</button>
                </div>
            </form>
        {% endif %}
    </section>
</div>
{% endblock %}

{% block styles %}
<style>
    .pm-compose-shell {
        --pm-bg: linear-gradient(180deg, #eef3ee 0%, #edf4f2 34%, #f7efe2 100%);
        --pm-surface: rgba(255, 255, 255, 0.84);
        --pm-line: rgba(36, 54, 43, 0.12);
        --pm-text: #18231c;
        --pm-muted: #637166;
        --pm-primary: #234f3e;
        --pm-primary-soft: #dcebe1;
        --pm-accent: #c47532;
        --pm-danger: #ad2d2d;
        padding: 8px 16px 16px;
        background:
            radial-gradient(circle at top left, rgba(35, 79, 62, 0.16), transparent 24%),
            radial-gradient(circle at bottom right, rgba(196, 117, 50, 0.16), transparent 28%),
            var(--pm-bg);
        color: var(--pm-text);
    }

    .pm-compose-shell-bulk {
        --pm-primary: #7b5200;
        --pm-primary-soft: #f7ead0;
    }

    .pm-compose-card {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 18px;
        border-radius: 24px;
        border: 1px solid var(--pm-line);
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.86)),
            linear-gradient(135deg, rgba(247, 239, 226, 0.3), rgba(255, 255, 255, 0.2));
        box-shadow:
            0 18px 48px rgba(30, 42, 35, 0.08),
            inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .pm-compose-head {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 12px;
        align-items: start;
    }

    .pm-compose-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--pm-primary-soft), #f6f1e4);
        color: var(--pm-primary);
        font-size: 20px;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .pm-compose-title {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
    }

    .pm-compose-chip {
        display: inline-flex;
        width: fit-content;
        min-height: 30px;
        padding: 0 12px;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: rgba(123, 82, 0, 0.08);
        color: var(--pm-primary);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .pm-compose-title h1 {
        margin: 0;
        font-size: 25px;
        line-height: 1.12;
        letter-spacing: -0.04em;
        font-weight: 820;
    }

    .pm-compose-title p {
        margin: 0;
        font-size: 13px;
        line-height: 1.6;
        color: var(--pm-muted);
    }

    .pm-compose-alert {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 10px;
        align-items: start;
        padding: 14px;
        border-radius: 18px;
        border: 1px solid rgba(48, 59, 47, 0.08);
        font-size: 14px;
        line-height: 1.55;
    }

    .pm-compose-alert i {
        font-size: 18px;
        margin-top: 1px;
    }

    .pm-compose-alert-success {
        background: rgba(35, 79, 62, 0.08);
        color: #234f3e;
    }

    .pm-compose-alert-danger {
        background: rgba(173, 45, 45, 0.06);
        color: #ad2d2d;
        border-color: rgba(173, 45, 45, 0.12);
    }

    .pm-compose-form {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .pm-compose-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .pm-compose-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--pm-muted);
    }

    .pm-compose-input-shell,
    .pm-compose-textarea-shell {
        position: relative;
        border-radius: 18px;
        border: 1px solid rgba(48, 59, 47, 0.1);
        background: rgba(255, 255, 255, 0.82);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .pm-compose-input-shell i {
        position: absolute;
        top: 50%;
        left: 14px;
        transform: translateY(-50%);
        color: var(--pm-muted);
    }

    .pm-compose-input-shell input,
    .pm-compose-input-shell select,
    .pm-compose-textarea-shell textarea {
        width: 100%;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--pm-text);
        font-size: 15px;
    }

    .pm-compose-input-shell input,
    .pm-compose-input-shell select {
        min-height: 52px;
        padding: 0 16px 0 44px;
    }

    .pm-compose-textarea-shell textarea {
        min-height: 220px;
        padding: 16px 18px;
        line-height: 1.8;
        resize: vertical;
    }

    .pm-compose-field small {
        font-size: 12px;
        color: var(--pm-muted);
        line-height: 1.5;
    }

    .pm-compose-actions,
    .pm-compose-success-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pm-compose-primary,
    .pm-compose-secondary,
    .pm-compose-ghost {
        min-height: 46px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 16px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .pm-compose-primary {
        border: 0;
        background: linear-gradient(135deg, #8a5e06, #b98717);
        color: #fff;
        box-shadow: 0 12px 28px rgba(123, 82, 0, 0.2);
    }

    .pm-compose-secondary,
    .pm-compose-ghost {
        background: rgba(255, 255, 255, 0.88);
        color: var(--pm-text);
        border: 1px solid rgba(48, 59, 47, 0.1);
    }

    .ts-wrapper {
        width: 100%;
    }

    .pm-compose-select-shell .ts-control {
        min-height: 52px;
        padding: 10px 16px 10px 44px !important;
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
    }

    .ts-wrapper.multi .ts-control > div {
        background: rgba(123, 82, 0, 0.08);
        color: #7b5200;
        border: 1px solid rgba(123, 82, 0, 0.12);
        border-radius: 999px;
        padding: 4px 10px;
        margin: 3px;
    }

    @media (max-width: 767px) {
        .pm-compose-shell {
            padding: 8px 12px 12px;
        }

        .pm-compose-card {
            padding: 14px;
            border-radius: 18px;
        }

        .pm-compose-title h1 {
            font-size: 22px;
        }
    }
</style>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button class="toolbar-item" onclick="history.back()">
            <i class="bi bi-chevron-left"></i>
            <span>{{ lang.mod_user_pm.back }}</span>
        </button>

        <button class="toolbar-item" onclick="location.href='mod_user_pm/inbox'">
            <i class="bi bi-inbox"></i>
            <span>{{ lang.mod_user_pm.inbox_title }}</span>
        </button>

        <button type="button"
                class="toolbar-fab"
                onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
                aria-label="{{ lang.mod_user_pm.new_message_action }}"
                title="{{ lang.mod_user_pm.new_message_action }}">
            <i class="bi bi-plus-lg"></i>
        </button>

        <button class="toolbar-item" onclick="location.href='mod_user_pm/sent'">
            <i class="bi bi-send"></i>
            <span>{{ lang.mod_user_pm.sent_title }}</span>
        </button>

        <button class="toolbar-item" onclick="document.getElementById('message')?.focus()">
            <i class="bi bi-pencil"></i>
            <span>{{ lang.mod_user_pm.message_label }}</span>
        </button>
    </div>
{% endblock %}
