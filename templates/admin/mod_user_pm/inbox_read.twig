{% set show_fab = false %}
{% set show_navbar = false %}
{% set show_sidebar = false %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set show_extra_sheets = false %}
{% set hide_contextual_bar = true %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_user_pm.inbox_title }}{% endblock %}
{% block headline %}{{ lang.mod_user_pm.inbox_title }}{% endblock %}

{% block content %}
{% set sender_name = veri.username|default('') %}
{% set subject_text = veri.subject|default('') %}
{% set initial = sender_name|slice(0, 1)|upper %}
{% set iso_date = veri.created_at|date('Y-m-d') %}
{% set time_text = veri.created_at|date('H:i') %}
{% set formatted_date = veri.created_at|date('d M Y') %}
{% set detail_date = iso_date == "now"|date('Y-m-d')
    ? lang.mod_user_pm.today_label ~ ' ' ~ time_text
    : (iso_date == ("-1 day"|date('Y-m-d'))
        ? lang.mod_user_pm.yesterday_label ~ ' ' ~ time_text
        : formatted_date ~ ' ' ~ time_text) %}
{% set note_sender = sender_name|e %}
{% set note_date = detail_date|e %}

<div class="pm-detail-shell"
     id="alan_{{ veri.id }}"
     data-delete-title="{{ lang.mod_user_pm.confirm_delete_msg }}"
     data-delete-text="{{ lang.mod_user_pm.confirm_delete_msg }}"
     data-delete-confirm="{{ lang.mod_user_pm.confirm_delete_yes }}"
     data-delete-cancel="{{ lang.mod_user_pm.cancel }}"
     data-delete-success="{{ lang.mod_user_pm.message_deleted_success }}">

    <section class="pm-detail-card">
        <div class="pm-detail-head">
            <a href="mod_user_pm/inbox" class="pm-detail-back" aria-label="{{ lang.mod_user_pm.back }}">
                <i class="bi bi-chevron-left"></i>
            </a>
            <div class="pm-detail-title-block">
                <h1>{{ subject_text }}</h1>
            </div>
        </div>

        <div class="pm-detail-meta">
            <div class="pm-detail-recipient">
                <span>{{ lang.mod_user_pm.sender_col }}</span>
                <strong>{{ sender_name }}</strong>
            </div>
            <time class="pm-detail-time" datetime="{{ iso_date }}">{{ detail_date }}</time>
        </div>

        <div class="pm-detail-actions">
            <a href="mod_user_pm/send/{{ sender_name|url_encode }}/{{ subject_text|url_encode }}" class="pm-detail-action">
                <i class="bi bi-reply"></i>
                <span>{{ lang.mod_user_pm.reply_action }}</span>
            </a>
            <button type="button" class="pm-detail-action pm-detail-action-danger" onclick="deleteMessage('{{ veri.id }}', 'inbox')">
                <i class="bi bi-trash3"></i>
                <span>{{ lang.mod_user_pm.delete_action }}</span>
            </button>
        </div>

        <article class="pm-detail-body">
            <div class="pm-detail-body-mark" aria-hidden="true"></div>
            {{ veri.message|nl2br }}
        </article>

        <p class="pm-detail-note">{{ lang.mod_user_pm.message_info_inbox|format(note_sender, note_date)|raw }}</p>
    </section>
</div>
{% endblock %}

{% block styles %}
<style>
    .pm-detail-shell {
        --pm-bg: linear-gradient(180deg, #f1f5ef 0%, #edf4f2 32%, #f7efe2 100%);
        --pm-surface: rgba(255, 255, 255, 0.84);
        --pm-line: rgba(36, 54, 43, 0.12);
        --pm-text: #18231c;
        --pm-muted: #637166;
        --pm-primary: #234f3e;
        --pm-primary-soft: #dcebe1;
        --pm-accent: #c47532;
        --pm-danger: #ad2d2d;
        padding: 8px 16px 16px;
        background:
            radial-gradient(circle at top left, rgba(35, 79, 62, 0.16), transparent 24%),
            radial-gradient(circle at bottom right, rgba(196, 117, 50, 0.16), transparent 28%),
            var(--pm-bg);
        color: var(--pm-text);
    }

    .pm-detail-card {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 16px;
        border-radius: 24px;
        border: 1px solid var(--pm-line);
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.86)),
            linear-gradient(135deg, rgba(220, 235, 225, 0.38), rgba(255, 255, 255, 0.2));
        box-shadow:
            0 18px 48px rgba(30, 42, 35, 0.08),
            inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .pm-detail-head {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .pm-detail-back {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid var(--pm-line);
        color: var(--pm-text);
        text-decoration: none;
        box-shadow: 0 8px 18px rgba(30, 42, 35, 0.06);
    }

    .pm-detail-title-block {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .pm-detail-title-block h1 {
        margin: 0;
        font-size: 23px;
        line-height: 1.18;
        letter-spacing: -0.045em;
        font-weight: 780;
    }

    .pm-detail-meta {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
        padding: 0 0 2px;
        border-bottom: 1px solid rgba(48, 59, 47, 0.1);
    }

    .pm-detail-recipient {
        display: flex;
        align-items: baseline;
        gap: 6px;
        min-width: 0;
    }

    .pm-detail-recipient span {
        font-size: 12px;
        font-weight: 600;
        color: var(--pm-muted);
    }

    .pm-detail-recipient strong {
        font-size: 14px;
        line-height: 1.3;
        font-weight: 700;
    }

    .pm-detail-time {
        font-size: 12px;
        color: var(--pm-muted);
        font-weight: 600;
        white-space: nowrap;
    }

    .pm-detail-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
    }

    .pm-detail-action {
        min-height: 40px;
        padding: 0 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.92);
        color: var(--pm-text);
        border: 1px solid rgba(48, 59, 47, 0.1);
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(30, 42, 35, 0.05);
    }

    .pm-detail-action-danger {
        color: var(--pm-danger);
        border-color: rgba(173, 45, 45, 0.16);
        background: rgba(173, 45, 45, 0.04);
        box-shadow: none;
    }

    .pm-detail-body {
        position: relative;
        padding: 22px 20px 20px 24px;
        border-radius: 22px;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(255, 255, 255, 0.72)),
            linear-gradient(135deg, rgba(247, 239, 226, 0.44), rgba(255, 255, 255, 0.14));
        border: 1px solid rgba(48, 59, 47, 0.08);
        line-height: 1.9;
        font-size: 16px;
        color: var(--pm-text);
        white-space: pre-wrap;
        word-break: break-word;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .pm-detail-body-mark {
        position: absolute;
        top: 16px;
        left: 0;
        width: 4px;
        height: calc(100% - 32px);
        border-radius: 0 999px 999px 0;
        background: linear-gradient(180deg, var(--pm-primary), var(--pm-accent));
    }

    .pm-detail-note {
        margin: 0;
        font-size: 12px;
        line-height: 1.7;
        color: var(--pm-muted);
        text-align: center;
        max-width: 28ch;
        align-self: center;
        opacity: 0.88;
    }

    @media (max-width: 767px) {
        .pm-detail-shell {
            padding: 8px 12px 12px;
        }

        .pm-detail-card {
            border-radius: 18px;
            padding: 14px;
        }

        .pm-detail-body {
            padding: 18px 16px 16px 20px;
            border-radius: 18px;
        }

        .pm-detail-meta {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button class="toolbar-item" onclick="history.back()">
            <i class="bi bi-chevron-left"></i>
            <span>{{ lang.mod_user_pm.back }}</span>
        </button>

        <button class="toolbar-item active" onclick="location.href='mod_user_pm/inbox'">
            <i class="bi bi-inbox-fill"></i>
            <span>{{ lang.mod_user_pm.inbox_title }}</span>
        </button>

        {% if session.permissions.mod_user_pm.send is defined %}
            <button type="button"
                    class="toolbar-fab"
                    onclick="location.href='mod_user_pm/send'"
                    aria-label="{{ lang.mod_user_pm.new_message_action }}"
                    title="{{ lang.mod_user_pm.new_message_action }}">
                <i class="bi bi-plus-lg"></i>
            </button>
        {% endif %}

        <button class="toolbar-item" onclick="location.href='mod_user_pm/sent'">
            <i class="bi bi-send"></i>
            <span>{{ lang.mod_user_pm.sent_title }}</span>
        </button>

        <button class="toolbar-item" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">
            <i class="bi bi-arrow-up"></i>
            <span>{{ lang.mod_user_pm.scroll_top_action }}</span>
        </button>
    </div>
{% endblock %}

{% block scripts %}
<script>
    const RADRES_URL = '{{ site.radres }}';
    const PM_LANG = {
        read: "{{ lang.mod_user_pm.inbox_title|e('js') }}",
        reply: "{{ lang.mod_user_pm.reply_action|e('js') }}",
        delete: "{{ lang.mod_user_pm.delete_action|e('js') }}",
        unread: "{{ lang.mod_user_pm.unread_status|e('js') }}",
        read_status: "{{ lang.mod_user_pm.read_status|e('js') }}",
        new_tag: "{{ lang.mod_user_pm.new_tag|e('js') }}",
        loading: "{{ lang.mod_user_pm.loading|e('js') }}",
        load_more: "{{ lang.mod_user_pm.next|e('js') }}",
        confirm_title: "{{ lang.mod_user_pm.confirm_delete_msg|e('js') }}",
        confirm_yes: "{{ lang.mod_user_pm.confirm_delete_yes|e('js') }}",
        confirm_no: "{{ lang.mod_user_pm.cancel|e('js') }}",
        delete_success: "{{ lang.mod_user_pm.message_deleted_success|e('js') }}"
    };
</script>
<script src="/templates/admin/assets/js/mod_user_pm.js?v=1.5"></script>
{% endblock %}
