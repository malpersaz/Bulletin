{% set hide_navbar = true %}
{% set hide_fab = true %}
{% extends "admin/layout.twig" %}

{% block title %}{{ lang.mod_publication_category.list }}{% endblock %}
{% block headline %}{{ lang.mod_publication_category.list }}{% endblock %}

{% block styles %}
    <style>
        .list-children-empty {
            min-height: 48px;
            border: 2px dashed rgba(103, 80, 164, 0.4);
            border-radius: 12px;
            margin-top: 8px;
            margin-left: 24px;
            display: none;
        }
        body.reorder-active .list-children-empty {
            display: block;
        }
    </style>
{% endblock %}

{% macro render_tree(items, parent_id, level) %}
    {% if items[parent_id] is defined %}
        {% for entry in items[parent_id] %}
            {% set display_name = entry.display_name %}
            {% set has_children = items[entry.id] is defined %}
            <div class="category-node" data-id="{{ entry.id }}" data-parent="{{ parent_id }}" data-name="{{ display_name|lower }}">
                <div class="m3-list-card" onclick="selectCategory('{{ entry.id }}', this)">
                    <div class="drag-handle" onclick="event.stopPropagation()"><i class="bi bi-grip-vertical"></i></div>
                    
                    {% if has_children %}
                        <button class="toggle-btn collapsed" onclick="toggleCategory(this, event)">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    {% else %}
                        <div style="width:24px; margin-right:4px;"></div>
                    {% endif %}

                    <div class="card-thumb">
                        {% if entry.image %}
                            <img src="{{ site.saddress }}static/mod_publication_category/thumb/{{ entry.image }}" style="width:100%; height:100%; object-fit:cover;">
                        {% else %}
                            <i class="bi bi-folder2-fill"></i>
                        {% endif %}
                    </div>

                    <div class="card-info">
                        <div class="card-title">{{ display_name }}</div>
                        <div class="card-meta">
                            {% if entry.lang %} <span class="meta-badge">{{ entry.lang|upper }}</span> {% endif %}
                            <span class="meta-id">#{{ entry.id }}</span>
                        </div>
                    </div>
                </div>
                
                {% if entry.id != parent_id and level < 20 %}
                <div class="list-children collapsed{% if not has_children %} list-children-empty{% endif %}">
                    {% if has_children %}
                        {{ _self.render_tree(items, entry.id, level + 1) }}
                    {% endif %}
                </div>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}
{% endmacro %}

{% block content %}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <div class="content-list" id="categoryRootList">
        
        <div class="reorder-controller" style="display: flex; justify-content: flex-end; margin-bottom: 12px;">
            <button id="reorderToggleBtn" class="btn-m3-tonal" onclick="toggleReorderMode()" style="border-radius: 12px; padding: 8px 16px; display: flex; align-items: center; gap: 8px; border: none; background: #f3edf7; color: #6750a4; font-weight: 600; cursor: pointer;">
                <i class="bi bi-lock-fill" id="reorderIcon"></i>
                <span id="reorderText">{{ lang.mod_publication_category.actions.unlock_reorder }}</span>
            </button>
        </div>

        {% if category_tree[0] is defined %}
             {{ _self.render_tree(category_tree, 0, 0) }}
        {% else %}
            <div class="empty-state-container">
                <div class="empty-icon-box">
                    <i class="bi bi-folder2-open"></i>
                </div>
                <h2 style="font-weight: 800;">{{ lang.mod_publication_category.empty.no_categories }}</h2>
                <div class="toolbar-fab" style="margin: 40px auto 0 auto; position: static;" onclick="location.href='{{ site.saddress }}mod_publication_category/add'">
                    <i class="bi bi-plus-lg"></i>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button id="toolbarEdit" class="toolbar-item" onclick="editSelected()" style="opacity:0.3; pointer-events:none;">
            <i class="bi bi-pencil-fill"></i>
            <span>{{ lang.mod_publication_category.button.edit }}</span>
        </button>

        <button id="toolbarDelete" class="toolbar-item" onclick="deleteSelected()" style="opacity:0.3; pointer-events:none;">
            <i class="bi bi-trash3-fill"></i>
            <span>{{ lang.mod_publication_category.button.delete }}</span>
        </button>
    </div>

    <!-- Main FAB Button -->
    <button class="main-fab" id="mainFab" onclick="location.href='{{ site.saddress }}mod_publication_category/add'" aria-label="{{ lang.mod_publication_category.add }}">
        <i class="bi bi-plus-lg"></i>
    </button>
{% endblock %}

{% block scripts %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
    {{ include("mod_publication_category/script.twig") }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var wrapper = document.querySelector('.mobile-wrapper');
            if(wrapper) {
                wrapper.classList.add('mesh-bg');
            }
        });
    </script>
{% endblock %}
