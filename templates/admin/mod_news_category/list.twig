{% set hide_navbar = true %}
{% set hide_fab = true %}
{% extends "admin/layout.twig" %}

{% block title %}{{ lang.mod_news_category.list }}{% endblock %}
{% block headline %}{{ lang.mod_news_category.list }}{% endblock %}

{% block styles %}
    {# Styles moved to global admin/assets/css/style.css #}
{% endblock %}

{% macro render_tree(items, parent_id, level) %}
    {% for entry in items %}
        {% set is_child = false %}
        {% if parent_id == 0 %}
            {% if entry.parent_id is empty or entry.parent_id == 0 or entry.parent_id == '0' %} {% set is_child = true %} {% endif %}
        {% else %}
            {% if entry.parent_id == parent_id %} {% set is_child = true %} {% endif %}
        {% endif %}

        {% if is_child %}
            <div class="category-node" data-id="{{ entry.id }}" data-parent="{{ entry.parent_id }}" data-name="{{ entry.name|lower }}">
                <div class="m3-list-card" onclick="selectCategory('{{ entry.id }}', this)">
                    <div class="drag-handle" onclick="event.stopPropagation()"><i class="bi bi-grip-vertical"></i></div>
                    
                    <button class="toggle-btn" onclick="toggleCategory(this, event)">
                        <i class="bi bi-chevron-down"></i>
                    </button>

                    <div class="card-thumb">
                        {% if entry.image %}
                            <img src="{{ site.sadres }}static/mod_news_category/thumb/{{ entry.image }}" style="width:100%; height:100%; object-fit:cover;">
                        {% else %}
                            <i class="bi bi-folder2-fill"></i>
                        {% endif %}
                    </div>

                    <div class="card-info">
                        <div class="card-title">{{ entry.name }}</div>
                        <div class="card-meta">
                            {% if entry.lang %} <span class="meta-badge">{{ entry.lang|upper }}</span> {% endif %}
                            <span class="meta-id">#{{ entry.id }}</span>
                        </div>
                    </div>
                </div>
                
                {% if entry.id != parent_id and level < 20 %}
                <div class="list-children">
                    {{ _self.render_tree(items, entry.id, level + 1) }}
                </div>
                {% endif %}
            </div>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% block content %}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <div class="content-list" id="categoryRootList">
        
        <!-- Reorder Toggle Bar -->
        <div class="reorder-controller" style="display: flex; justify-content: flex-end; margin-bottom: 12px;">
            <button id="reorderToggleBtn" class="btn-m3-tonal" onclick="toggleReorderMode()" style="border-radius: 12px; padding: 8px 16px; display: flex; align-items: center; gap: 8px; border: none; background: #f3edf7; color: #6750a4; font-weight: 600; cursor: pointer;">
                <i class="bi bi-lock-fill" id="reorderIcon"></i>
                <span id="reorderText">{{ lang.mod_news_category.actions.unlock_reorder }}</span>
            </button>
        </div>

        {% if all_categories is defined and all_categories|length > 0 %}
             {{ _self.render_tree(all_categories, 0, 0) }}
        {% else %}
            <div class="empty-state-container">
                <div class="empty-icon-box">
                    <i class="bi bi-folder2-open"></i>
                </div>
                <h2 style="font-weight: 800;">{{ lang.mod_news_category.empty.no_categories }}</h2>
                <div class="toolbar-fab" style="margin: 40px auto 0 auto; position: static;" onclick="location.href='{{ site.sadres }}mod_news_category/add'">
                    <i class="bi bi-plus-lg"></i>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button id="toolbarEdit" class="toolbar-item" onclick="editSelected()" style="opacity:0.3; pointer-events:none;">
            <i class="bi bi-pencil-fill"></i>
            <span>{{ lang.mod_news_category.button.edit|default('Biguhere') }}</span>
        </button>
        
        <div class="toolbar-fab" onclick="location.href='{{ site.sadres }}mod_news_category/add'">
            <i class="bi bi-plus-lg"></i>
        </div>

        <button id="toolbarDelete" class="toolbar-item" onclick="deleteSelected()" style="opacity:0.3; pointer-events:none;">
            <i class="bi bi-trash3-fill"></i>
            <span>{{ lang.mod_news_category.button.delete|default('Jê bibe') }}</span>
        </button>
    </div>
{% endblock %}

{% block scripts %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
    {{ include("mod_news_category/script.twig") }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var wrapper = document.querySelector('.mobile-wrapper');
            if(wrapper) {
                wrapper.classList.add('mesh-bg');
            }
        });
    </script>
{% endblock %}
