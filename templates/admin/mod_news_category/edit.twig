{% block scripts %}
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
	    document.addEventListener('DOMContentLoaded', function() {
	        const langSelect = document.getElementById('lang');

	        function reloadForCategoryContext() {
	            if (!langSelect) {
	                return;
	            }

	            const url = new URL(window.location.href);
	            url.searchParams.set('lang', langSelect.value);
	            window.location.href = url.toString();
	        }

	        if (langSelect) {
	            langSelect.addEventListener('change', reloadForCategoryContext);
	        }

	        function initM3Select(selector, config) {
	            const element = document.querySelector(selector);
	            if (!element) {
	                return null;
	            }

	            return new TomSelect(selector, Object.assign({
	                create: false,
	                maxOptions: 200,
	                dropdownClass: 'm3-select-dropdown',
	                render: {
	                    item: function(data, escape) {
	                        return '<div class="m3-ts-selected-value" title="' + escape(data.text || '') + '">' + escape(data.text || '') + '</div>';
	                    },
	                    option: function(data, escape) {
	                        return '<div class="m3-ts-option-value">' + escape(data.text || '') + '</div>';
	                    }
	                }
	            }, config || {}));
	        }

	        initM3Select('#lang', {
	            searchField: ['text'],
	            sortField: [{ field: '$order' }]
	        });
	        initM3Select('#parent_id', {
	            searchField: ['text']
	        });
	        initM3Select('#menu', {
	            searchField: ['text']
	        });
	        initM3Select('#acl_id', {
	            searchField: ['text']
	        });
	    });

    function temizle(veri) {
        var temiz = veri.replace(/[^a-zA-ZıIğĞüÜşŞöÖçÇîêûÎÊÛ1234567890\s_]/g, " ");
        temiz = temiz.replace(/^\s+|\s+$/g, "");
        return temiz.replace(/\s+/g, ' ');
    }

    function makeSeoValue(veri) {
        return temizle(veri).replace(/\s+/g, "_").replace(/İ/g, 'i').toLowerCase();
    }

    function makeKeywordsValue(veri) {
        return temizle(veri).replace(/\s+/g, ",").toLowerCase().replace(/İ/g, 'i');
    }

    function updateMetaFields() {
        const name = document.getElementById('name').value;
        const seoInput = document.getElementById('seo');
        
	        document.getElementById('seo').value = makeSeoValue(name);
        document.getElementById('title').value = temizle(name);
        document.getElementById('keywords').value = makeKeywordsValue(name);
        document.getElementById('description').value = temizle(name);
    }

    function toggleAdvanced() {
        const content = document.getElementById('advancedContent');
        const icon = document.getElementById('advancedIcon');
        content.classList.toggle('active');
        icon.classList.toggle('bi-chevron-up');
        icon.classList.toggle('bi-chevron-down');
    }

    function selectRootStatus(el, val) {
        document.querySelectorAll('#rootHidden ~ .selection-grid .selection-card').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        document.getElementById('rootHidden').value = val;
    }

    function selectHomepageStatus(el, val) {
        document.querySelectorAll('#homepageHidden ~ .selection-grid .selection-card').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        document.getElementById('homepageHidden').value = val;
    }

    function previewImage(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const area = document.querySelector('.image-upload-area');
                area.innerHTML = `
                    <img id="editImgPreview" src="${e.target.result}" style="width:100%; height:auto; border-radius:8px;">
                    <button type="button" class="remove-img-btn" onclick="event.preventDefault(); removeImage()"><i class="bi bi-trash"></i></button>
                `;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    function removeImage() {
        const id = "{{ d.id }}";
        Swal.fire({
	            title: '{{ lang.mod_news_category.confirmations.remove_image }}',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ba1a1a',
            cancelButtonColor: '#6e7881',
	            confirmButtonText: '{{ lang.mod_news_category.buttons.yes }}',
	            cancelButtonText: '{{ lang.mod_news_category.buttons.no }}'
        }).then((result) => {
            if (result.isConfirmed) {
                var formData = new URLSearchParams();
                formData.append('id', id);

                fetch('{{ site.sadres }}mod_news_category/image_remove_image', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                })
                .then(r => r.text())
                .then(data => {
                    if (data.trim() === 'Oke') {
	                        Swal.fire('{{ lang.mod_news_category.oke }}', '{{ lang.mod_news_category.messages.success.image_removed }}', 'success');
                        const area = document.querySelector('.image-upload-area');
                        area.innerHTML = `
                            <i class="bi bi-cloud-arrow-up-fill upload-icon"></i>
	                            <p>{{ lang.mod_news_category.admin.columns.image_select }}</p>
                        `;
                        document.getElementById('editImgInput').value = '';
                    } else {
	                        Swal.fire('{{ lang.mod_news_category.hata }}', data, 'error');
                    }
                });
            }
        });
    }

    function submitEditForm(formId) {
        const form = document.getElementById(formId);
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        form.submit();
    }
</script>
{% endblock %}
