{% set hide_navbar = true %}
{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}
	{{ lang.mod_news_category.edit }}
{% endblock %}

{% block headline %}
	{{ lang.mod_news_category.edit }}
{% endblock %}

{% macro select_nested_parent_id_function(select_nested_parent_id_result, parent_id, selected_id, self_id, level = 0, disable = false) %}
    {% if select_nested_parent_id_result[parent_id] is defined %}
        {% for entry in select_nested_parent_id_result[parent_id] %}
            {% set parent_id_loop = entry.id %}
            <option value="{{ entry.id }}" {% if selected_id == entry.id %} selected="selected" {% endif %} {% if entry.id == self_id or disable %} disabled="disabled" {% endif %}>
                {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.display_name }} ({% if entry.lang is defined %}{{ entry.lang|upper }}{% endif %})
            </option>
            {% if select_nested_parent_id_result[parent_id_loop] is defined and select_nested_parent_id_result[parent_id_loop] is iterable and parent_id_loop != parent_id and level < 20 %}
                {% set next_disable = disable or (entry.id == self_id) %}
                {{ _self.select_nested_parent_id_function(select_nested_parent_id_result, parent_id_loop, selected_id, self_id, level + 1, next_disable) }}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% macro select_nested_menu_function(select_nested_menu_result, parent_id, selected_id, level = 0) %}
    {% if select_nested_menu_result[parent_id] is defined %}
        {% for entry in select_nested_menu_result[parent_id] %}
            {% set sub_loop = entry.id %}
            <option value="{{ entry.id }}" {% if selected_id == entry.id %} selected="selected" {% endif %}>
                 {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.display_name }}
            </option>
            {% if select_nested_menu_result[sub_loop] is defined and select_nested_menu_result[sub_loop] is iterable and sub_loop != parent_id and level < 20 %}
                {{ _self.select_nested_menu_function(select_nested_menu_result, sub_loop, selected_id, level + 1) }}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% block content %}
    {% set selected_parent_id = category_selected_parent_id %}
    {% set selected_menu_id = d.menu is defined ? d.menu : 0 %}
    {% set selected_acl_id = d.acl_id is defined ? d.acl_id : 0 %}
	<style>
		.edit-container {
			padding: 16px;
			display: flex;
			flex-direction: column;
			gap: 16px;
			padding-bottom: 120px;
		}
		.edit-card {
			background: var(--md-sys-color-surface);
			border-radius: 12px;
			padding: 20px;
			box-shadow: var(--md-sys-elevation-1);
		}
		.card-header-edit {
			display: flex;
			align-items: center;
			gap: 8px;
			margin-bottom: 16px;
			color: var(--md-sys-color-primary);
		}
		.card-header-edit i {
			font-size: 20px;
		}
		.card-header-edit h3 {
			margin: 0;
			font-size: 16px;
			font-weight: 500;
		}
		.form-row {
			margin-bottom: 20px;
		}
		.m3-input-wrapper {
			position: relative;
			margin-bottom: 4px;
		}
		.m3-input-wrapper:focus-within {
			z-index: 9999;
		}
		.m3-input-lg {
			width: 100%;
			padding: 12px 16px;
			border-radius: 8px;
			border: 1px solid var(--md-sys-color-outline);
			background: transparent;
			color: var(--md-sys-color-on-surface);
			font-size: 16px;
			outline: none;
            box-sizing: border-box;
		}
		.m3-input-lg:focus {
			border-color: var(--md-sys-color-primary);
			border-width: 2px;
			padding: 11px 15px;
		}
		.m3-floating-label {
			position: absolute;
			top: 12px;
			left: 16px;
			color: var(--md-sys-color-on-surface-variant);
			font-size: 16px;
			pointer-events: none;
			transition: all 0.2s;
            z-index: 10;
		}
        .m3-input-lg:focus ~ .m3-floating-label,
		.m3-input-lg:not(:placeholder-shown) ~ .m3-floating-label,
        select.m3-input-lg ~ .m3-floating-label,
        .ts-wrapper.m3-input-lg ~ .m3-floating-label {
			top: -10px;
			left: 12px;
			font-size: 12px;
			color: var(--md-sys-color-on-surface-variant);
			background: var(--md-sys-color-surface);
			padding: 0 4px;
		}
        .m3-input-lg:focus ~ .m3-floating-label,
        select.m3-input-lg:focus ~ .m3-floating-label,
        .ts-wrapper.m3-input-lg.focus ~ .m3-floating-label {
            color: var(--md-sys-color-primary);
        }
        /* TomSelect override */
        .ts-wrapper.m3-input-lg {
            padding: 0;
            border: none;
        }
        .ts-wrapper.m3-input-lg .ts-control {
            border-radius: 8px;
            border: 1px solid var(--md-sys-color-outline);
            background: transparent;
            padding: 12px 16px;
            min-height: 48px;
            font-size: 16px;
            box-shadow: none;
        }
        .ts-wrapper.m3-input-lg.focus .ts-control {
            border-color: var(--md-sys-color-primary);
            border-width: 2px;
            padding: 11px 15px;
        }
        .image-upload-area {
            border: 2px dashed var(--md-sys-color-outline);
            border-radius: 12px;
            padding: 24px;
            text-align: center;
            color: var(--md-sys-color-on-surface-variant);
            position: relative;
            background: rgba(0,0,0,0.02);
            transition: all 0.2s;
            margin-top: 8px;
        }
        .image-upload-area:hover {
            background: rgba(0,0,0,0.05);
            border-color: var(--md-sys-color-primary);
        }
		.advanced-toggle {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 12px 0;
			cursor: pointer;
			color: var(--md-sys-color-on-surface-variant);
			font-size: 14px;
			border-top: 1px solid var(--md-sys-color-outline-variant);
			margin-top: 16px;
		}
		.advanced-content {
			display: none;
			padding-top: 16px;
		}
		.advanced-content.active {
			display: block;
		}
        .selection-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 8px;
        }
        .selection-card {
            border: 1px solid var(--md-sys-color-outline);
            border-radius: 12px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
        }
        .selection-card.active {
            background: var(--md-sys-color-primary-container);
            border-color: var(--md-sys-color-primary);
        }
        .check-icon {
            position: absolute;
            top: 8px;
            right: 8px;
            color: var(--md-sys-color-primary);
            display: none;
        }
        .selection-card.active .check-icon {
            display: block;
        }
        .upload-icon {
            font-size: 32px;
            color: var(--md-sys-color-primary);
            margin-bottom: 8px;
        }
        .remove-img-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            background: #ba1a1a !important;
            color: white !important;
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            transition: all 0.2s;
            z-index: 10;
        }
        .remove-img-btn:hover {
            background: #93000a !important;
            transform: scale(1.1);
        }
        .remove-img-btn i {
            font-size: 18px;
            color: white !important;
        }
	</style>

	<form id="editForm" method="POST" action="{{ site.sadres }}mod_news_category/edit/{{ d.id }}" enctype="multipart/form-data">
		<input type="hidden" name="id" value="{{ d.id }}">
		<input type="hidden" name="edit" value="1">

		<div class="edit-container">
            {% if error is defined %}
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        Swal.fire({
                            icon: 'warning',
                            html: '<b><i class="bi bi-exclamation-triangle-fill"></i> {{ mesaj }}</b>',
	                            confirmButtonText: '{{ lang.mod_news_category.buttons.yes }}',
                            confirmButtonColor: '#ba1a1a'
                        });
                    });
                </script>
            {% endif %}

            {% if hatalar is defined %}
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        let errorHtml = '<div style="text-align: left;">';
                        {% for hata in hatalar %}
                            errorHtml += '<div style="margin-bottom: 8px;"><i class="bi bi-exclamation-triangle-fill" style="color: #ba1a1a;"></i> <b>{{ hata }}</b></div>';
                        {% endfor %}
                        errorHtml += '</div>';

                        Swal.fire({
                            icon: 'warning',
                            html: errorHtml,
	                            confirmButtonText: '{{ lang.mod_news_category.buttons.yes }}',
                            confirmButtonColor: '#ba1a1a'
                        });
                    });
                </script>
            {% endif %}

            {% if oke is defined %}
                <div class="banner-m3 banner-success mb-4" style="background: #e6f4ea; color: #1e4620; padding: 16px; border-radius: 12px; display: flex; align-items: center; gap: 12px; font-size: 14px;">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>{{ mesaj }}</span>
                </div>
                <script>
                    setTimeout(() => {
                        window.location.href = "{{ site.sadres }}mod_news_category/list";
                    }, 2000);
                </script>
            {% endif %}

			{# Card 1: Basics #}
			<div class="edit-card">
				<div class="form-row">
					<div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="lang" id="lang" required>
                            {% for item in lang_lang %}
	                                <option value="{{ item.seo }}" {% if selected_lang|lower == item.seo|lower %} selected {% endif %}>{{ item.name }} ({{ item.seo|upper }})</option>
                            {% endfor %}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_news_category.admin.columns.language }}</label>
                    </div>
				</div>

				<div class="form-row">
					<div class="m3-input-wrapper">
						<input type="text" class="m3-input-lg" name="name" id="name" placeholder=" " autocomplete="off" value="{{ d.name }}" required oninput="updateMetaFields()">
						<label class="m3-floating-label">{{ lang.mod_news_category.admin.columns.name }}</label>
					</div>
				</div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
	                        <select class="m3-input-lg" name="parent_id" id="parent_id" required>
	                            {% if category_parent_root_id > 0 %}
	                                <option value="{{ category_parent_root_id }}" {% if selected_parent_id == category_parent_root_id %} selected {% endif %}>{{ category_language_root_label }}</option>
	                            {% endif %}
	                            {% if category_parent_root_id == 0 or category_allow_system_parent %}
	                                <option value="0" {% if selected_parent_id == 0 %} selected {% endif %}>{{ lang.mod_news_category.parent_labels.system_root }}</option>
	                            {% endif %}
	                            {{ _self.select_nested_parent_id_function(select_nested_parent_id_result, category_parent_root_id, selected_parent_id, d.id) }}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_news_category.admin.columns.parent_id }}</label>
                    </div>
                </div>
			</div>

			{# Card 3: Media & Settings #}
			<div class="edit-card">

                <div class="form-row">
                    <label class="filter-group-label" style="font-size:14px; margin-bottom:8px; display:block; font-weight: 500;">{{ lang.mod_news_category.admin.columns.root }}</label>
                    <input type="hidden" name="root" value="{{ d.root }}" id="rootHidden">
                    <div class="selection-grid">
                        <div class="selection-card {% if d.root == 'y' %} active {% endif %}" onclick="selectRootStatus(this, 'y')">
                            <i class="bi bi-folder-check" style="font-size:24px;"></i>
	                            <div class="selection-label">{{ lang.mod_news_category.admin.select_values.root_yes }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                        <div class="selection-card {% if d.root == 'n' %} active {% endif %}" onclick="selectRootStatus(this, 'n')">
                            <i class="bi bi-folder" style="font-size:24px;"></i>
	                            <div class="selection-label">{{ lang.mod_news_category.admin.select_values.root_no }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <label class="filter-group-label" style="font-size:14px; margin-bottom:8px; display:block; font-weight: 500;">{{ lang.management.show_on_homepage }}</label>
                    <input type="hidden" name="show_on_homepage" value="{{ d.show_on_homepage }}" id="homepageHidden">
                    <div class="selection-grid">
                        <div class="selection-card {% if d.show_on_homepage == 'y' %} active {% endif %}" onclick="selectHomepageStatus(this, 'y')">
                            <i class="bi bi-pin-angle-fill" style="font-size:24px;"></i>
	                            <div class="selection-label">{{ lang.mod_news_category.admin.select_values.root_yes }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                        <div class="selection-card {% if d.show_on_homepage == 'n' %} active {% endif %}" onclick="selectHomepageStatus(this, 'n')">
                            <i class="bi bi-pin-angle" style="font-size:24px;"></i>
	                            <div class="selection-label">{{ lang.mod_news_category.admin.select_values.root_no }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                    </div>
                </div>

				<div class="form-row">
					<label class="filter-group-label" style="font-size:14px; margin-bottom:8px; display:block; font-weight: 500;">{{ lang.mod_news_category.admin.columns.image }}</label>
					<div id="image-container-edit">
                        <label for="editImgInput" class="image-upload-area" style="cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                            {% if d.image %}
                                <img id="editImgPreview" src="{{ site.radres }}mod_news_category/thumb/{{ d.image }}" style="width:100%; height:auto; border-radius:8px;">
                                <button type="button" class="remove-img-btn" onclick="event.preventDefault(); removeImage()"><i class="bi bi-trash"></i></button>
                            {% else %}
                                <i class="bi bi-cloud-arrow-up-fill upload-icon"></i>
	                                <p>{{ lang.mod_news_category.admin.columns.image_select }}</p>
                            {% endif %}
                        </label>
                        <input type="file" name="image" id="editImgInput" style="display:none;" onchange="previewImage(this)">
                    </div>
				</div>

				<div class="form-row">
					<label class="filter-group-label" style="font-size:14px; margin-bottom:8px; display:block; font-weight: 500;">{{ lang.mod_news_category.admin.columns.acl_id|raw }}</label>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <select class="m3-input-lg" name="acl_id" id="acl_id" style="flex: 1;">
	                            <option value="0" {% if selected_acl_id == 0 %}selected{% endif %}>{{ lang.mod_news_category.choose_wish }}</option>
	                            {% for item in mod_acl_acl_id %}
	                                <option value="{{ item.id }}" {% if selected_acl_id == item.id %}selected{% endif %}>{{ item.name }}</option>
	                            {% endfor %}
	                        </select>
	                        <a href="{{ site.sadres }}mod_acl/list" class="btn btn-sm btn-light" style="display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 8px; border: 1px solid var(--md-sys-color-outline); color: var(--md-sys-color-primary); background: var(--md-sys-color-surface);" title="{{ lang.mod_news_category.admin.tooltips.acl_settings }}">
                            <i class="bi bi-gear" style="font-size: 20px;"></i>
                        </a>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="menu" id="menu">
	                            <option value="0" {% if selected_menu_id == 0 %}selected{% endif %}>{{ lang.mod_news_category.choose_wish }}</option>
	                            {{ _self.select_nested_menu_function(select_nested_menu_result, category_menu_root_id, selected_menu_id) }}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_news_category.admin.columns.menu }}</label>
                    </div>
                </div>

				<div class="advanced-toggle" onclick="toggleAdvanced()">
						<span>{{ lang.mod_news_category.form.seo_settings }}</span>
					<i class="bi bi-chevron-down" id="advancedIcon"></i>
				</div>

                <div class="advanced-content" id="advancedContent">
                    <div class="form-row">
                        <div class="m3-input-wrapper">
                            <input type="text" class="m3-input-lg" name="seo" id="seo" value="{{ d.seo }}" placeholder=" ">
	                            <label class="m3-floating-label">{{ lang.mod_news_category.admin.columns.seo }}</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="m3-input-wrapper">
                            <input type="text" class="m3-input-lg" name="title" id="title" value="{{ d.title }}" placeholder=" ">
                            <label class="m3-floating-label">{{ lang.mod_news_category.admin.columns.title }}</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="m3-input-wrapper">
                            <input type="text" class="m3-input-lg" name="keywords" id="keywords" value="{{ d.keywords }}" placeholder=" ">
                            <label class="m3-floating-label">{{ lang.mod_news_category.admin.columns.keywords }}</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="m3-input-wrapper">
                            <input type="text" class="m3-input-lg" name="description" id="description" value="{{ d.description }}" placeholder=" ">
                            <label class="m3-floating-label">{{ lang.mod_news_category.admin.columns.description }}</label>
                        </div>
                    </div>
                </div>
			</div>

		</div>
	</form>
{% endblock %}

