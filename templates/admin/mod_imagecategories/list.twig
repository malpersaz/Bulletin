{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}{{ lang.mod_imagecategories.list }}{% endblock %}
{% block headline %}{{ lang.mod_imagecategories.list }}{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/mod_imagecategories.css?v=1.0">
{% endblock %}

{% macro render_tree(items, parent_id, level) %}
    {% if items[parent_id] is defined %}
        {% for entry in items[parent_id] %}
            {% set has_children = items[entry.id] is defined %}
            <div class="image-category-node category-node level-{{ level }}" data-id="{{ entry.id }}" data-parent="{{ parent_id }}" data-name="{{ entry.display_name|lower }}">
                <article class="image-category-card m3-list-card" data-id="{{ entry.id }}">
                    <div class="drag-handle"><i class="bi bi-grip-vertical"></i></div>
                    {% if has_children %}
                        <button type="button" class="toggle-btn collapsed" data-action="toggle-category">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    {% else %}
                        <div class="toggle-spacer"></div>
                    {% endif %}
                    <div class="image-category-card-head">
                        <div class="image-category-thumb">
                            {% if entry.image %}
                                <img src="{{ site.iaddress ~ 'mod_imagecategories/thumb/' ~ entry.image }}" alt="{{ entry.display_name }}">
                            {% else %}
                                <i class="bi bi-images"></i>
                            {% endif %}
                        </div>
                        <div>
                            <h3 class="image-category-name">{{ entry.display_name }}</h3>
                            <div class="image-category-meta">
                                <span class="image-category-chip">{{ entry.lang|upper }}</span>
                                <span class="image-category-chip">#{{ entry.id }}</span>
                                <span class="image-category-chip">{{ entry.seo }}</span>
                                <span class="image-category-chip {% if entry.root == 'y' %}is-root{% endif %}">
                                    {% if entry.root == 'y' %}{{ lang.mod_imagecategories.status.root }}{% else %}{{ lang.mod_imagecategories.status.nested }}{% endif %}
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="image-category-summary">{{ entry.description }}</div>
                    <button type="button" class="image-category-edit-btn" data-action="edit-category" data-id="{{ entry.id }}">
                        <i class="bi bi-pencil-square"></i>
                        <span>{{ lang.mod_imagecategories.button.edit }}</span>
                    </button>
                </article>
                <div class="image-category-children list-children collapsed{% if not has_children %} list-children-empty{% endif %}">
                    {% if has_children %}
                        {{ _self.render_tree(items, entry.id, level + 1) }}
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endmacro %}

{% block content %}
<div class="image-category-list-shell" id="categoryRootList"
     data-site-address="{{ site.saddress }}"
     data-move-url="{{ site.saddress }}mod_imagecategories/move"
     data-edit-url="{{ site.saddress }}mod_imagecategories/edit/"
     data-delete-url="{{ site.saddress }}mod_imagecategories/delete"
     data-add-url="{{ site.saddress }}mod_imagecategories/add"
     data-i18n-reorder-title="{{ lang.mod_imagecategories.list_ui.reorder_title|e('html_attr') }}"
     data-i18n-reorder-confirm="{{ lang.mod_imagecategories.list_ui.reorder_confirm|e('html_attr') }}"
     data-i18n-save="{{ lang.mod_imagecategories.button.save|e('html_attr') }}"
     data-i18n-cancel="{{ lang.mod_imagecategories.button.cancel|e('html_attr') }}"
     data-i18n-select-record="{{ lang.mod_imagecategories.list_ui.select_record|e('html_attr') }}"
     data-i18n-lock-reorder="{{ lang.mod_imagecategories.list_ui.lock_reorder|e('html_attr') }}"
     data-i18n-unlock-reorder="{{ lang.mod_imagecategories.list_ui.unlock_reorder|e('html_attr') }}"
     data-i18n-mode-unlocked="{{ lang.mod_imagecategories.list_ui.mode_unlocked|e('html_attr') }}"
     data-i18n-success-reordered="{{ lang.mod_imagecategories.message.success.reordered|e('html_attr') }}"
     data-i18n-network-error="{{ lang.mod_imagecategories.list_ui.network_error|e('html_attr') }}"
     data-i18n-empty-state="{{ lang.mod_imagecategories.empty_state|e('html_attr') }}"
     data-i18n-empty-cta="{{ lang.mod_imagecategories.list_ui.empty_cta|e('html_attr') }}"
     data-i18n-delete-title="{{ lang.mod_imagecategories.list_ui.delete_title|e('html_attr') }}"
     data-i18n-delete-confirm-text="{{ lang.mod_imagecategories.remove_record|e('html_attr') }}"
     data-i18n-delete-confirm-button="{{ lang.mod_imagecategories.list_ui.delete_confirm_button|e('html_attr') }}"
     data-i18n-delete-cancel-button="{{ lang.mod_imagecategories.list_ui.delete_cancel_button|e('html_attr') }}"
     data-i18n-success-delete="{{ lang.mod_imagecategories.message.success.delete|e('html_attr') }}">
    <div class="reorder-controller">
        <button id="reorderToggleBtn" type="button" class="reorder-toggle" data-action="toggle-reorder">
            <i class="bi bi-lock-fill" id="reorderIcon"></i>
            <span id="reorderText">{{ lang.mod_imagecategories.list_ui.unlock_reorder }}</span>
        </button>
    </div>

    {% if category_tree[0] is defined %}
        {{ _self.render_tree(category_tree, 0, 0) }}
    {% else %}
        <div class="empty-state">
            <i class="bi bi-images"></i>
            <strong>{{ lang.mod_imagecategories.empty_state }}</strong>
            <a href="{{ site.saddress }}mod_imagecategories/add" class="primary-btn empty-state-cta">{{ lang.mod_imagecategories.list_ui.empty_cta }}</a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block fixed_bottom %}
<div class="image-category-toolbar">
    <button type="button" class="secondary-btn" data-action="delete-selected">
        <i class="bi bi-trash3-fill"></i>
        <span>{{ lang.mod_imagecategories.list_ui.delete_cta }}</span>
    </button>
    <button type="button" class="secondary-btn" data-action="edit-selected">
        <i class="bi bi-pencil-square"></i>
        <span>{{ lang.mod_imagecategories.button.edit }}</span>
    </button>
    <a href="{{ site.saddress }}mod_imagecategories/add" class="primary-btn">
        <i class="bi bi-plus-lg"></i>
        <span>{{ lang.mod_imagecategories.list_ui.add_cta }}</span>
    </a>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
<script src="{{ site.address }}templates/admin/assets/js/mod_imagecategories.js?v=1.0"></script>
{% endblock %}
