{% macro nested_options(items, parent_id, selected_id, level, self_id, disable = false) %}
    {% if items[parent_id] is defined %}
        {% for entry in items[parent_id] %}
            <option value="{{ entry.id }}" {% if entry.id == selected_id %}selected{% endif %} {% if entry.id == self_id or disable %}disabled{% endif %}>
                {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.display_name }} ({{ entry.lang|upper }})
            </option>
            {% if items[entry.id] is defined %}
                {% set next_disable = disable or (entry.id == self_id) %}
                {{ _self.nested_options(items, entry.id, selected_id, level + 1, self_id, next_disable) }}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% macro menu_options(items, parent_id, selected_id, level) %}
    {% if items[parent_id] is defined %}
        {% for entry in items[parent_id] %}
            <option value="{{ entry.id }}" {% if entry.id == selected_id %}selected{% endif %}>
                {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.display_name }}
            </option>
            {{ _self.menu_options(items, entry.id, selected_id, level + 1) }}
        {% endfor %}
    {% endif %}
{% endmacro %}

<div class="image-category-shell">
    {% set current_lang = form_lang is defined ? form_lang : selected_lang %}
    {% set selected_parent = parent_id is defined ? parent_id : category_selected_parent_id %}
    {% set selected_root = root is defined ? root : record.root %}
    {% set selected_menu = menu is defined ? menu : record.menu %}
    {% set selected_acl = acl_id is defined ? acl_id : record.acl_id %}

    {% if success is defined %}
        <div class="form-status success">{{ message }}</div>
    {% endif %}
    {% if fatal_error is defined %}
        <div class="form-status error">{{ message }}</div>
    {% endif %}
    {% if errors is defined %}
        <div class="form-status error">
            {% for msg in errors %}
                <div>{{ msg }}</div>
            {% endfor %}
        </div>
    {% endif %}

    <form method="POST" action="" enctype="multipart/form-data" id="{{ form_id }}" class="image-category-shell image-category-form-inner"
          data-site-address="{{ site.saddress }}"
          data-remove-image-url="{{ site.saddress }}mod_imagecategories/image_remove_image"
          data-i18n-remove-image-confirm="{{ lang.mod_imagecategories.remove_image|e('html_attr') }}"
          data-i18n-remove-button="{{ lang.mod_imagecategories.button.remove|e('html_attr') }}"
          data-i18n-cancel-button="{{ lang.mod_imagecategories.button.cancel|e('html_attr') }}"
          data-i18n-image-removed-success="{{ lang.mod_imagecategories.message.success.image_removed|e('html_attr') }}"
          data-i18n-network-error="{{ lang.mod_imagecategories.list_ui.network_error|e('html_attr') }}">
        <div class="image-category-card image-category-card-form">
            <h3 class="image-category-title">{{ lang.mod_imagecategories.form.basics }}</h3>

            <div class="m3-input-wrapper">
                <select class="m3-input-lg" name="lang" id="image-category-lang" required>
                    {% for item in lang_lang %}
                        <option value="{{ item.seo }}" {% if item.seo == current_lang %}selected{% endif %}>{{ item.name }} ({{ item.seo|upper }})</option>
                    {% endfor %}
                </select>
                <label class="m3-floating-label">{{ lang.mod_imagecategories.admin.columns.lang }}</label>
            </div>

            <div class="m3-input-wrapper">
                <input class="m3-input-lg" type="text" name="name" id="image-category-name" value="{{ name is defined ? name : record.name }}" placeholder=" ">
                <label class="m3-floating-label">{{ lang.mod_imagecategories.admin.columns.name }}</label>
            </div>

            <div class="m3-input-wrapper">
                <input class="m3-input-lg" type="text" name="seo" id="image-category-seo" value="{{ seo is defined ? seo : record.seo }}" placeholder=" ">
                <label class="m3-floating-label">{{ lang.mod_imagecategories.admin.columns.seo }}</label>
            </div>

            <div class="m3-input-wrapper">
                <textarea class="m3-input-lg" name="content" id="image-category-content" placeholder=" ">{{ content is defined ? content : record.content }}</textarea>
                <label class="m3-floating-label">{{ lang.mod_imagecategories.admin.columns.content }}</label>
            </div>
        </div>

        <div class="image-category-card image-category-card-form">
            <h3 class="image-category-title">{{ lang.mod_imagecategories.form.structure }}</h3>

            <div class="m3-input-wrapper">
                <select class="m3-input-lg" name="parent_id" required>
                    {% if category_parent_root_id > 0 %}
                        <option value="{{ category_parent_root_id }}" {% if selected_parent == category_parent_root_id %}selected{% endif %}>{{ category_language_root_label }}</option>
                    {% endif %}
                    {% if category_parent_root_id == 0 or category_allow_system_parent %}
                        <option value="0" {% if selected_parent == 0 or selected_parent == '0' %}selected{% endif %}>{{ lang.mod_imagecategories.parent_labels.system_root }}</option>
                    {% endif %}
                    {{ _self.nested_options(select_nested_parent_id_result, category_parent_root_id, selected_parent, 0, mode == 'edit' ? record.id : 0) }}
                </select>
                <label class="m3-floating-label">{{ lang.mod_imagecategories.admin.columns.parent_id }}</label>
            </div>

            <div class="selection-grid" data-selection-group>
                <label class="selection-card{% if selected_root == 'y' %} active{% endif %}">
                    <input type="radio" name="root" value="y" {% if selected_root == 'y' %}checked{% endif %}>
                    <div class="selection-title">{{ lang.mod_imagecategories.admin.radio.root_y }}</div>
                    <div class="selection-copy">{{ lang.mod_imagecategories.status.root }}</div>
                </label>
                <label class="selection-card{% if selected_root == 'n' %} active{% endif %}">
                    <input type="radio" name="root" value="n" {% if selected_root == 'n' %}checked{% endif %}>
                    <div class="selection-title">{{ lang.mod_imagecategories.admin.radio.root_n }}</div>
                    <div class="selection-copy">{{ lang.mod_imagecategories.status.nested }}</div>
                </label>
            </div>
        </div>

        <div class="image-category-card image-category-card-form">
            <h3 class="image-category-title">{{ lang.mod_imagecategories.form.seo }}</h3>

            <div class="m3-input-wrapper">
                <input class="m3-input-lg" type="text" name="title" id="image-category-title" value="{{ title is defined ? title : record.title }}" placeholder=" ">
                <label class="m3-floating-label">{{ lang.mod_imagecategories.admin.columns.title }}</label>
            </div>

            <div class="m3-input-wrapper">
                <input class="m3-input-lg" type="text" name="keywords" id="image-category-keywords" value="{{ keywords is defined ? keywords : record.keywords }}" placeholder=" ">
                <label class="m3-floating-label">{{ lang.mod_imagecategories.admin.columns.keywords }}</label>
            </div>

            <div class="m3-input-wrapper">
                <textarea class="m3-input-lg" name="description" id="image-category-description" placeholder=" ">{{ description is defined ? description : record.description }}</textarea>
                <label class="m3-floating-label">{{ lang.mod_imagecategories.admin.columns.description }}</label>
            </div>
        </div>

        <div class="image-category-card image-category-card-form">
            <h3 class="image-category-title">{{ lang.mod_imagecategories.form.publishing }}</h3>

            <div class="m3-input-wrapper">
                <select class="m3-input-lg" name="menu">
                    <option value="0" {% if selected_menu == 0 or selected_menu == '0' %}selected{% endif %}>{{ lang.mod_imagecategories.form.menu_none }}</option>
                    {{ _self.menu_options(select_nested_menu_result, category_menu_root_id, selected_menu, 0) }}
                </select>
                <label class="m3-floating-label">{{ lang.mod_imagecategories.admin.columns.menu }}</label>
            </div>

            <div class="m3-input-wrapper">
                <select class="m3-input-lg" name="acl_id">
                    <option value="0" {% if selected_acl == 0 or selected_acl == '0' %}selected{% endif %}>{{ lang.mod_imagecategories.form.acl_none }}</option>
                    {% for acl in mod_acl_acl_id %}
                        <option value="{{ acl.id }}" {% if acl.id == selected_acl %}selected{% endif %}>{{ acl.name }}</option>
                    {% endfor %}
                </select>
                <label class="m3-floating-label">{{ lang.mod_imagecategories.admin.columns.acl_id }}</label>
            </div>

            {% if mode == 'edit' and record.image %}
                <div class="current-image" id="image-category-current-image">
                    <img src="{{ site.iaddress ~ 'mod_imagecategories/thumb/' ~ record.image }}" alt="{{ record.name }}">
                    <button type="button" class="image-remove-btn" data-action="remove-image" data-id="{{ record.id }}">
                        <i class="bi bi-x-circle"></i>
                        <span>{{ lang.mod_imagecategories.button.remove }}</span>
                    </button>
                </div>
            {% endif %}

            <input class="m3-input-lg m3-input-file" type="file" name="image" accept="image/*">
            <div class="image-note">{{ lang.mod_imagecategories.form.image_help }}</div>
        </div>
    </form>
</div>
