{% set module_lang_key = 'mod_slider' %}
{% set hide_navbar = true %}
{% set hide_fab = true %}
{% set show_search = true %}
{% set show_search_filter_button = false %}
{% set search_placeholder = lang.mod_slider.search_placeholder %}
{% extends 'admin/layout.twig' %}
{% block title %}{{ lang.mod_slider.list }}{% endblock %}

{% block headline %}{{ lang.mod_slider.list }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/templates/admin/assets/css/mod_slider.css?v=1.0">
{% endblock %}

{% block content %}
<!-- PULL TO REFRESH SPINNER -->
<div id="ptr-spinner" class="ptr-spinner">
    <div class="spinner-track">
        <div class="spinner-fill"></div>
    </div>
</div>

<!-- DYNAMIC CONTENT (Cards) -->
<div id="content-list-container" class="content-list"
    data-module-url="{{ site.saddress }}mod_slider/"
    data-data-url="{{ site.saddress }}mod_slider/datatable_json">
</div>

<!-- EMPTY STATE -->
<div id="empty-state" class="empty-state is-hidden">
    <div class="empty-icon"><i class="bi bi-inbox"></i></div>
    <h3 id="empty-state-desc">{{ lang.mod_slider.empty.no_data }}</h3>
</div>

<!-- INFINITE SCROLL LOADER -->
<div id="infinite-loader" class="infinite-loader is-hidden">
    <div class="spinner-track">
        <div class="spinner-fill"></div>
    </div>
    <span>{{ lang.mod_slider.datatable.loadingRecords }}</span>
</div>

<!-- HIDDEN FILTERS -->
<form id="filterForm" class="is-hidden">
    <input type="hidden" name="start" id="filterStart" value="0">
    <input type="hidden" name="length" id="filterLength" value="10">
    <input type="hidden" name="draw" id="filterDraw" value="1">
    
    <!-- Search / Filter inputs -->
    <input type="hidden" name="search[name]" id="filterSearch" value="">
    <input type="hidden" name="search[lang]" id="filterLang" value="">
    
    <!-- Order -->
    <input type="hidden" name="order[0][column]" id="filterSortColumn" value="1">
    <input type="hidden" name="order[0][dir]" id="filterSortDir" value="desc">
</form>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar slider-toolbar" id="contentToolbar">
        <button id="toolbarSlider" class="toolbar-item is-disabled is-selected" data-action="remove-slider" title="{{ lang.mod_slider.button.remove }}" aria-label="{{ lang.mod_slider.button.remove }}">
            <i class="bi bi-stars"></i>
        </button>

        <button id="toolbarGallery" class="toolbar-item is-disabled" data-action="open-gallery" title="{{ lang.mod_slider.button.gallery }}" aria-label="{{ lang.mod_slider.button.gallery }}">
            <i class="bi bi-image"></i>
        </button>

        <button id="toolbarFiles" class="toolbar-item is-disabled" data-action="open-files" title="{{ lang.mod_slider.button.files }}" aria-label="{{ lang.mod_slider.button.files }}">
            <i class="bi bi-paperclip"></i>
        </button>

        <button id="toolbarEdit" class="toolbar-item is-disabled" data-action="edit-content" title="{{ lang.mod_slider.button.edit }}" aria-label="{{ lang.mod_slider.button.edit }}">
            <i class="bi bi-pencil-fill"></i>
        </button>

        <button id="toolbarDelete" class="toolbar-item is-disabled" data-action="remove-slider" title="{{ lang.mod_slider.button.remove }}" aria-label="{{ lang.mod_slider.button.remove }}">
            <i class="bi bi-trash3-fill"></i>
        </button>
    </div>
{% endblock %}

{% block scripts %}
<script src="/templates/admin/assets/js/mod_slider.js?v=3.0"></script>
{% endblock %}
