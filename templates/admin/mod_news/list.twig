{% set module_lang_key = 'mod_news' %}
{% set hide_navbar = true %}
{% set hide_fab = true %}
{% set show_search = true %}
{% set show_search_filter_button = true %}
{% set wizard_module = 'mod_news' %}
{% extends 'admin/layout.twig' %}
{% block title %}{{ lang.mod_news.list }}{% endblock %}

{% block headline %}{{ lang.mod_news.list }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/templates/admin/assets/css/mod_news.css?v={{ site.version }}.4">
{% endblock %}

{% block content %}
{% set stat_total_news_label = lang.mod_news.status_badge.general %}
{% set stat_published_news_label = lang.mod_news.status_badge.active %}
{% set stat_draft_news_label = lang.mod_news.status_badge.draft %}
{% set empty_zero_records_label = lang.mod_news.datatable.zeroRecords %}
{% set empty_table_label = lang.mod_news.datatable.emptyTable %}
{% set loading_records_label = lang.mod_news.datatable.loadingRecords %}
<div class="content-stats-container">
    <div class="content-stats-row">
        <button type="button" class="content-stat-card active" data-status-filter="all" aria-label="{{ stat_total_news_label }}">
            <div id="statTotalNews" class="content-stat-value">{{ total_news|default(0) }}</div>
            <div class="content-stat-label">{{ stat_total_news_label }}</div>
        </button>
        <button type="button" class="content-stat-card stat-published" data-status-filter="y" aria-label="{{ stat_published_news_label }}">
            <div id="statPublishedNews" class="content-stat-value">{{ published_news|default(0) }}</div>
            <div class="content-stat-label">{{ stat_published_news_label }}</div>
        </button>
        <button type="button" class="content-stat-card stat-draft" data-status-filter="n" aria-label="{{ stat_draft_news_label }}">
            <div id="statDraftNews" class="content-stat-value">{{ draft_news|default(0) }}</div>
            <div class="content-stat-label">{{ stat_draft_news_label }}</div>
        </button>
    </div>
</div>

<div id="ptr-spinner" class="ptr-spinner">
    <div class="spinner-track">
        <div class="spinner-fill"></div>
    </div>
</div>

<div id="content-list-container" class="content-list"
    data-module-url="{{ site.saddress }}mod_news/"
    data-data-url="{{ site.saddress }}mod_news/datatable_json"
    data-categories="{{ categories|json_encode|escape('html_attr') }}">
</div>

<div id="empty-state" class="empty-state is-hidden">
    <div class="empty-icon"><i class="bi bi-inbox"></i></div>
    <h3>{{ empty_zero_records_label }}</h3>
    <p>{{ empty_table_label }}</p>
</div>

<div id="infinite-loader" class="infinite-loader is-hidden">
    <div class="spinner-track">
        <div class="spinner-fill"></div>
    </div>
    <span>{{ loading_records_label }}</span>
</div>

<form id="filterForm" class="is-hidden">
    <input type="hidden" name="start" id="filterStart" value="0">
    <input type="hidden" name="length" id="filterLength" value="10">
    <input type="hidden" name="draw" id="filterDraw" value="1">
    <input type="hidden" name="search[name]" id="filterSearch" value="">
    <input type="hidden" name="search[lang]" id="filterLang" value="">
    <input type="hidden" name="search[category_id]" id="filterCategory" value="">
    <input type="hidden" name="search_radio[status]" id="filterStatus" value="">
    <input type="hidden" name="order[0][column]" id="filterSortColumn" value="1">
    <input type="hidden" name="order[0][dir]" id="filterSortDir" value="desc">
</form>

<div id="newsImageModal" class="news-image-modal" aria-hidden="true">
    <div class="news-image-modal__scrim" data-action="close-image-uploader"></div>
    <div class="news-image-modal__sheet" role="dialog" aria-modal="true" aria-labelledby="newsImageModalTitle">
        <header class="wizard-header">
            <button type="button" class="icon-btn" data-action="close-image-uploader">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="wizard-title">
                <span id="newsImageModalTitle">{{ lang.mod_news.wizard.step.image }}</span>
                <span id="newsImageModalSubtitle" hidden></span>
            </div>
            <button type="button" id="newsImageSaveBtn" class="m3-btn-text news-image-save" data-action="submit-list-image-upload" disabled hidden>{{ lang.mod_news.wizard.button.save }}</button>
        </header>

        <div class="wizard-progress-bar">
            <div class="wizard-progress-fill progress-full-width"></div>
        </div>

        <div class="wizard-content news-image-modal__body">
            {% include 'admin/partials/image_uploader.twig' with {
                shell_id: 'listImageShell',
                shell_class: 'news-image-shell',
                has_image: false,
                shell_attrs: {
                    'data-drop-title': lang.mod_news.wizard.image.drop_title,
                    'data-drop-description': lang.mod_news.wizard.image.drop_description,
                    'data-upload-link': lang.mod_news.wizard.image.upload_link,
                    'data-link-separator': lang.mod_news.wizard.image.link_separator,
                    'data-link-placeholder': lang.mod_news.wizard.image.link_placeholder,
                    'data-link-action': lang.mod_news.wizard.image.link_action,
                    'data-hint-loading': lang.mod_news.wizard.image.hint_loading,
                    'data-hint-invalid-type': lang.mod_news.wizard.image.hint_invalid_type,
                    'data-hint-no-drop-data': lang.mod_news.wizard.image.hint_no_drop_data,
                    'data-hint-remote-failed': lang.mod_news.wizard.image.hint_remote_failed,
                    'data-empty-name': lang.mod_news.wizard.summary.selected_none,
                    'data-empty-meta': lang.mod_news.wizard.image.drop_description
                },
                dropzone_id: 'listImageDropzone',
                empty_state_id: 'listImageEmptyState',
                drop_title: lang.mod_news.wizard.image.drop_title,
                upload_link: lang.mod_news.wizard.image.upload_link,
                preview_card_id: 'listImagePreviewCard',
                remove_button_label: lang.mod_news.button.delete,
                preview_img_id: 'listImgPreview',
                preview_alt: '',
                preview_hidden: true,
                meta_id: 'listImageMeta',
                meta_hidden: true,
                file_name_id: 'listImageFileName',
                file_name_text: lang.mod_news.wizard.summary.selected_none,
                file_details_id: 'listImageFileDetails',
                file_details_text: lang.mod_news.wizard.image.drop_description,
                divider_hidden: false,
                link_separator: lang.mod_news.wizard.image.link_separator,
                url_row_hidden: false,
                url_input_id: 'listImageUrlInput',
                link_placeholder: lang.mod_news.wizard.image.link_placeholder,
                import_btn_id: 'listImageUrlImportBtn',
                link_action: lang.mod_news.wizard.image.link_action,
                file_input_id: 'listImgInput'
            } %}

            <div id="newsImageModalFooter" class="wizard-footer news-image-modal__footer is-single-action">
                <button type="button" id="newsImageCancelBtn" class="m3-btn-outlined" data-action="close-image-uploader">{{ lang.mod_news.button.cancel }}</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block fixed_bottom %}
<div class="standard-toolbar news-toolbar" id="contentToolbar" role="toolbar" aria-label="{{ lang.mod_news.list }}" aria-hidden="true">
    {% if session.permissions.mod_news.edit is defined or session.permissions.mod_news.change_status is defined or session.permissions.mod_news.approval is defined %}
        <button id="toolbarStatus" class="toolbar-item is-disabled" data-action="toggle-status" title="{{ lang.mod_news.status_badge.active }}" aria-label="{{ lang.mod_news.status_badge.active }}">
            <i class="bi bi-eye-fill"></i>
        </button>
    {% endif %}

    {% if session.permissions.mod_news.edit is defined %}
        <button id="toolbarDeck" class="toolbar-item is-disabled" data-action="toggle-deck" title="{{ lang.mod_news.deck_add }}" aria-label="{{ lang.mod_news.deck_add }}">
            <i class="bi bi-bookmark-star"></i>
        </button>
    {% endif %}

    {% if session.permissions.mod_news.edit is defined %}
        <button id="toolbarSlider" class="toolbar-item is-disabled" data-action="toggle-slider" title="{{ lang.mod_news.hero_slider_add }}" aria-label="{{ lang.mod_news.hero_slider_add }}">
            <i class="bi bi-stars"></i>
        </button>
    {% endif %}

    {% if session.permissions.mod_news.edit is defined %}
        <button id="toolbarVideo" class="toolbar-item is-disabled" data-action="open-video" title="{{ lang.mod_news.context_menu.video }}" aria-label="{{ lang.mod_news.context_menu.video }}">
            <i class="bi bi-camera-video"></i>
        </button>
    {% endif %}

    {% if session.permissions.mod_news.gallery is defined %}
        <button id="toolbarGallery" class="toolbar-item is-disabled" data-action="open-gallery" title="{{ lang.mod_news.context_menu.gallery }}" aria-label="{{ lang.mod_news.context_menu.gallery }}">
            <i class="bi bi-images"></i>
        </button>
    {% endif %}

    {% if session.permissions.mod_news.file is defined %}
        <button id="toolbarFiles" class="toolbar-item is-disabled" data-action="open-files" title="{{ lang.mod_news.context_menu.files }}" aria-label="{{ lang.mod_news.context_menu.files }}">
            <i class="bi bi-paperclip"></i>
        </button>
    {% endif %}

    {% if session.permissions.mod_news.faq is defined or session.permissions.mod_news.edit is defined %}
        <button id="toolbarFaq" class="toolbar-item is-disabled" data-action="open-faq" title="{{ lang.mod_faq.module_title }}" aria-label="{{ lang.mod_faq.module_title }}">
            <i class="bi bi-patch-question-fill"></i>
        </button>
    {% endif %}

    {% if session.permissions.mod_news.edit is defined %}
        <button id="toolbarEdit" class="toolbar-item is-disabled" data-action="edit-content" title="{{ lang.mod_news.context_menu.edit }}" aria-label="{{ lang.mod_news.context_menu.edit }}">
            <i class="bi bi-pencil-fill"></i>
        </button>
    {% endif %}

    {% if session.permissions.mod_news.delete is defined %}
        <button id="toolbarDelete" class="toolbar-item is-disabled" data-action="delete-content" title="{{ lang.mod_news.context_menu.delete }}" aria-label="{{ lang.mod_news.context_menu.delete }}">
            <i class="bi bi-trash3-fill"></i>
        </button>
    {% endif %}
</div>

{% if session.permissions.mod_news.add is defined %}
    <!-- Main FAB Link -->
    <a class="main-fab" id="mainFab" href="{{ site.saddress }}mod_news/add" aria-label="{{ lang.mod_news.add }}">
        <i class="bi bi-plus-lg"></i>
    </a>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="/templates/admin/assets/js/mod_news.js?v={{ site.version }}.4"></script>
{% endblock %}
