{% set hide_navbar = true %}
{% set hide_search = true %}
{% set hide_fab = true %}
{% set module_lang_key = 'mod_news' %}
{% set wizard_module = 'mod_news' %}
{% extends 'admin/layout.twig' %}

{% block title %}
	{{ d.name }} - {{ lang.mod_news.edit }}
{% endblock %}

{% block headline %}
	{{ d.name }}
{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/templates/admin/assets/css/mod_news.css?v=3.0">
{% endblock %}

{% block content %}
	<form id="editForm" method="POST" action="{{ site.saddress }}mod_news/edit/{{ d.id }}" enctype="multipart/form-data"
		data-lang="{{ d.lang|lower }}"
		data-errors="{{ (errors is defined and errors is not empty ? errors : (error is defined ? [message|default('Error')] : []))|json_encode|escape('html_attr') }}"
		data-error-message="{{ (message is defined ? message : (errors is defined and errors is not empty ? errors[0] : ''))|escape('html_attr') }}"
		data-ok-text="{{ lang.mod_news.button.ok|escape('html_attr') }}"
		data-success-url="{% if success is defined %}{{ site.saddress }}mod_news/list{% endif %}"
		data-redirect-delay="2000"
		data-ai-url="{{ site.saddress }}mod_news/ajax_ai_assist"
		data-ai-generating="{{ (lang.mod_news.ai.generating is defined ? lang.mod_news.ai.generating : 'Generating...')|escape('html_attr') }}"
		data-ai-select-headline="{{ (lang.mod_news.ai.select_headline is defined ? lang.mod_news.ai.select_headline : 'Select a Headline')|escape('html_attr') }}"
		data-ai-copy="{{ (lang.mod_news.ai.copy is defined ? lang.mod_news.ai.copy : 'Use This')|escape('html_attr') }}">
		<input type="hidden" name="edit" value="1">
		<input type="hidden" name="lang" id="editLang" value="{{ d.lang|lower }}">
		<input type="hidden" name="category_id" id="editCategoryId" value="{{ d.category_id }}">

		<div class="edit-container">
			{% if success is defined %}
				<div class="banner-m3 banner-success-soft">
					<i class="bi bi-check-circle-fill"></i>
					<span>{{ message|default('') }}</span>
				</div>
			{% endif %}
			{% if error is defined and errors is not defined %}
				<div class="banner-m3 banner-error-soft">
					<i class="bi bi-exclamation-triangle-fill"></i>
					<span>{{ message|default('') }}</span>
				</div>
			{% endif %}

			{# Card 1: Basics #}
			<div class="edit-card">
				<div class="form-row">
					<label class="field-section-label">{{ lang.mod_news.wizard.step.language }}</label>
					<div class="m3-fake-select" data-action="open-lang-sheet">
						<span id="editSelectedLang">
							{% set current_lang_name = d.lang|upper %}
							{% if lang_lang is defined %}
								{% for l in lang_lang %}
									{% if l.seo == d.lang %}
										{% set current_lang_name = l.name|default(l.ad) %}
									{% endif %}
								{% endfor %}
							{% endif %}
							{{ current_lang_name }}
						</span>
						<i class="bi bi-chevron-down"></i>
					</div>
				</div>

				<div class="form-row">
					<label class="field-section-label">{{ lang.mod_news.wizard.step.category }}</label>
					<div class="m3-fake-select" data-action="toggle-category-sheet">
						<span id="wizardSelectedCategory">
							{% set current_cat_name = '' %}
							{% if categories is defined %}
								{% for cat in categories %}
									{% if cat.id == d.category_id %}
										{% set current_cat_name = cat.name %}
									{% endif %}
								{% endfor %}
							{% endif %}
							{{ current_cat_name ? current_cat_name : lang.mod_news.choose_wish }}
						</span>
						<i class="bi bi-chevron-down"></i>
					</div>
				</div>

				<div class="form-row">
					<div class="m3-input-wrapper">
						<input type="text" class="m3-input-lg" name="name" id="editTitleInput" placeholder=" " autocomplete="off" value="{{ d.name }}" required>
						<label class="m3-floating-label">{{ lang.mod_news.wizard.label.news_title }}</label>
					</div>
					<div class="ai-action-bar">
						<button type="button" class="m3-ai-btn" id="btnAiSuggestHeadlines" data-action="ai-suggest-headlines" title="{{ (lang.mod_news.ai.suggest_headlines is defined ? lang.mod_news.ai.suggest_headlines : 'Suggest Headlines with AI')|escape('html_attr') }}">
							<i class="bi bi-stars"></i>
							<span>{{ lang.mod_news.ai.suggest_headlines is defined ? lang.mod_news.ai.suggest_headlines : 'Suggest Headlines' }}</span>
						</button>
					</div>
					<div id="aiHeadlinesContainer" class="ai-suggestions-container is-hidden"></div>
				</div>

				<div class="form-row">
					<div class="m3-input-wrapper">
						<input type="datetime-local" class="m3-input-lg" name="created_at" id="editDateInput" value="{{ d.created_at ? d.created_at|replace({' ': 'T'}) : '' }}" placeholder=" ">
						<label class="m3-floating-label">{{ lang.mod_news.wizard.step.date }}</label>
					</div>
				</div>

				<div class="form-row">
					<div class="m3-input-wrapper">
						<input type="datetime-local" class="m3-input-lg" name="updated_at" id="editUpdatedAtInput" value="{{ d.updated_at ? d.updated_at|replace({' ': 'T'}) : '' }}" placeholder=" ">
						<label class="m3-floating-label">{{ lang.mod_news.admin.columns.updated_at }}</label>
					</div>
				</div>
			</div>

			{# Card 2: Main Content #}
			<div class="edit-card">
				<div class="form-row">
					<div class="m3-input-wrapper">
						<textarea class="m3-input-lg" name="summary" id="editIntroInput" rows="3" placeholder=" " minlength="90" maxlength="120" data-counter-target="editIntroCounter" data-counter-min="90" data-counter-max="120" required>{{ d.summary|striptags }}</textarea>
						<label class="m3-floating-label">{{ lang.mod_news.wizard.label.intro_text }}</label>
					</div>
					<div class="deck-helper-bar">
						<div class="char-counter" id="editIntroCounter">{{ d.summary|length }} / 120</div>
						<button type="button" class="m3-ai-btn" id="btnAiGenerateDeck" data-action="ai-generate-deck" title="{{ (lang.mod_news.ai.generate_deck is defined ? lang.mod_news.ai.generate_deck : 'Generate Deck with AI')|escape('html_attr') }}">
							<i class="bi bi-stars"></i>
							<span>{{ lang.mod_news.ai.generate_deck is defined ? lang.mod_news.ai.generate_deck : 'Generate Deck with AI' }}</span>
						</button>
					</div>
				</div>

				{# Deck toggle #}
				<div class="form-row">
					<label class="field-section-label">{{ lang.mod_news.admin.columns.deck }}</label>
					<input type="hidden" name="deck" id="deckHidden" value="{{ d.deck == 'y' ? 'y' : 'n' }}">
					<div class="selection-grid">
						<div class="selection-card {% if d.deck == 'y' %}active{% endif %}" data-action="select-deck" data-value="y">
							<i class="bi bi-star-fill selection-icon"></i>
							<div class="selection-label">{{ lang.mod_news.admin.radio.deck_yes }}</div>
							<i class="bi bi-check-circle-fill check-icon"></i>
						</div>
						<div class="selection-card {% if d.deck != 'y' %}active{% endif %}" data-action="select-deck" data-value="n">
							<i class="bi bi-star selection-icon"></i>
							<div class="selection-label">{{ lang.mod_news.admin.radio.deck_no }}</div>
							<i class="bi bi-check-circle-fill check-icon"></i>
						</div>
					</div>
				</div>

				<div class="form-row">
					<label class="field-section-label">{{ lang.mod_news.wizard.step.news }}</label>
					<div class="mod-news-editor-wrap">
						<textarea name="content" id="editContentTextarea">{{ d.content|raw }}</textarea>
					</div>
				</div>
			</div>

			{# Card 3: Media & Relations #}
			<div class="edit-card">
				<div class="form-row">
					<label class="field-section-label">{{ lang.mod_news.admin.columns.image }}</label>
					{% include 'admin/partials/image_uploader.twig' with {
						shell_id: 'editImageShell',
						shell_class: 'edit-image-shell',
						has_image: d.image ? true : false,
						shell_attrs: {
							'data-drop-title': lang.mod_news.wizard.image.drop_title,
							'data-drop-description': lang.mod_news.wizard.image.drop_description,
							'data-upload-link': lang.mod_news.wizard.image.upload_link,
							'data-link-separator': lang.mod_news.wizard.image.link_separator,
							'data-link-placeholder': lang.mod_news.wizard.image.link_placeholder,
							'data-link-action': lang.mod_news.wizard.image.link_action,
							'data-hint-loading': lang.mod_news.wizard.image.hint_loading,
							'data-hint-invalid-type': lang.mod_news.wizard.image.hint_invalid_type,
							'data-hint-no-drop-data': lang.mod_news.wizard.image.hint_no_drop_data,
							'data-hint-remote-failed': lang.mod_news.wizard.image.hint_remote_failed,
							'data-empty-name': lang.mod_news.wizard.summary.selected_none,
							'data-empty-meta': lang.mod_news.wizard.image.drop_description,
							'data-existing-image': d.image ? 'true' : 'false',
							'data-existing-src': d.image ? (site.iaddress ~ 'mod_news/thumb/' ~ d.image) : '',
							'data-existing-name': d.image ? d.image : '',
							'data-existing-meta': lang.mod_news.admin.columns.image,
							'data-remove-url': site.saddress ~ 'mod_news/image_remove_image',
							'data-remove-id': d.id,
							'data-remove-title': lang.mod_news.remove_image,
							'data-remove-confirm': lang.mod_news.remove_image,
							'data-remove-confirm-text': lang.mod_news.button.yes,
							'data-remove-cancel-text': lang.mod_news.button.no,
							'data-success-title': lang.mod_news.success,
							'data-success-message': lang.mod_news.remove_image_success,
							'data-error-title': lang.mod_news.error_occurred
						},
						dropzone_id: 'editImageDropzone',
						trigger_picker_js: 'triggerEditImagePicker()',
						empty_state_id: 'editImageEmptyState',
						empty_hidden: d.image ? true : false,
						drop_title: lang.mod_news.wizard.image.drop_title,
						upload_link: lang.mod_news.wizard.image.upload_link,
						preview_card_id: 'editImagePreviewCard',
						remove_button_label: lang.mod_news.button.delete,
						remove_action_js: 'removeEditImage()',
						preview_img_id: 'editImgPreview',
						preview_alt: lang.mod_news.wizard.step.image,
						preview_hidden: d.image ? false : true,
						preview_src: d.image ? (site.iaddress ~ 'mod_news/thumb/' ~ d.image) : '',
						meta_id: 'editImageMeta',
						meta_hidden: true,
						file_name_id: 'editImageFileName',
						file_name_text: '',
						file_details_id: 'editImageFileDetails',
						file_details_text: '',
						divider_hidden: d.image ? true : false,
						link_separator: lang.mod_news.wizard.image.link_separator,
						url_row_hidden: d.image ? true : false,
						url_input_id: 'editImageUrlInput',
						link_placeholder: lang.mod_news.wizard.image.link_placeholder,
						import_btn_id: 'editImageUrlImportBtn',
						link_action: lang.mod_news.wizard.image.link_action,
						file_input_id: 'editImgInput',
						file_input_onchange: 'previewEditImage(this)'
					} %}
				</div>

				{# Gallery #}
				<div class="form-row">
					<label class="field-section-label">{{ lang.mod_news.admin.columns.gallery_id }}</label>
					<div class="m3-input-wrapper">
						<select class="m3-input-lg" name="gallery_id" id="editGallerySelect">
							<option value="0">{{ lang.mod_news.choose_wish }}</option>
							{% for item in mod_news_gallery_id %}
								<option value="{{ item.id }}" {% if d.gallery_id == item.id %}selected{% endif %}>{{ item.name }}</option>
							{% endfor %}
						</select>
					</div>
				</div>

				{# File #}
				<div class="form-row">
					<label class="field-section-label">{{ lang.mod_news.admin.columns.file_id }}</label>
					<div class="m3-input-wrapper">
						<select class="m3-input-lg" name="file_id" id="editFileSelect">
							<option value="0">{{ lang.mod_news.choose_wish }}</option>
							{% for item in mod_news_file_id %}
								<option value="{{ item.id }}" {% if d.file_id == item.id %}selected{% endif %}>{{ item.name }}</option>
							{% endfor %}
						</select>
					</div>
				</div>

				{# ACL #}
				<div class="form-row">
					<label class="field-section-label">{{ lang.mod_news.admin.columns.acl_id }}</label>
					<div class="m3-input-wrapper">
						<select class="m3-input-lg" name="acl_id" id="editAclSelect">
							<option value="0">{{ lang.mod_news.choose_wish }}</option>
							{% for item in mod_acl_acl_id %}
								<option value="{{ item.id }}" {% if d.acl_id == item.id %}selected{% endif %}>{{ item.name }}</option>
							{% endfor %}
						</select>
					</div>
				</div>

				<div class="advanced-toggle" data-action="toggle-advanced">
					<div class="advanced-toggle-label">
						<i class="bi bi-globe-americas"></i>
						<span>{{ lang.mod_news.admin.columns.seo }} & {{ lang.mod_news.admin.columns.title }}</span>
					</div>
					<i class="bi bi-chevron-down" id="advancedIcon"></i>
				</div>

				<div class="advanced-content" id="advancedContent">
					<div class="form-row">
						<div class="m3-input-wrapper">
							<input type="text" class="m3-input-lg" name="seo" id="seo" value="{{ d.seo }}" placeholder=" ">
							<label class="m3-floating-label">{{ lang.mod_news.admin.columns.seo }}</label>
						</div>
					</div>
					<div class="form-row">
						<div class="m3-input-wrapper">
							<input type="text" class="m3-input-lg" name="title" id="title" value="{{ d.title }}" placeholder=" ">
							<label class="m3-floating-label">{{ lang.mod_news.admin.columns.title }}</label>
						</div>
					</div>
					<div class="form-row">
						<div class="m3-input-wrapper">
							<input type="text" class="m3-input-lg" name="keywords" id="keywords" value="{{ d.keywords }}" placeholder=" ">
							<label class="m3-floating-label">{{ lang.mod_news.admin.columns.keywords }}</label>
						</div>
					</div>
					<div class="form-row">
						<div class="m3-input-wrapper">
							<input type="text" class="m3-input-lg" name="description" id="description" value="{{ d.description }}" placeholder=" ">
							<label class="m3-floating-label">{{ lang.mod_news.admin.columns.description }}</label>
						</div>
					</div>
				</div>
			</div>

			{# Card 4: Publishing Decision #}
			<div class="edit-card">
				<input type="hidden" name="status" value="{{ d.status }}" id="publishHidden">

				<div class="selection-grid">
					<div class="selection-card {% if d.status == 'y' %}active{% endif %}" data-action="select-status" data-value="y">
						<i class="bi bi-cloud-check-fill selection-icon"></i>
						<div class="selection-label">{{ lang.mod_news.context_menu.publish }}</div>
						<i class="bi bi-check-circle-fill check-icon"></i>
					</div>
					<div class="selection-card {% if d.status != 'y' %}active{% endif %}" data-action="select-status" data-value="n">
						<i class="bi bi-pencil-square selection-icon"></i>
						<div class="selection-label">{{ lang.mod_news.context_menu.unpublish }}</div>
						<i class="bi bi-check-circle-fill check-icon"></i>
					</div>
				</div>
			</div>
		</div>
	</form>
{% endblock %}

{% block fixed_bottom %}
	<div class="m3-final-bar">
		<button type="button" class="m3-btn-half m3-btn-half-neutral" data-action="cancel-edit" data-href="{{ site.saddress }}mod_news/list">
			<i class="bi bi-x-lg"></i>
			<span>{{ lang.mod_news.button.cancel }}</span>
		</button>
		<button type="button" class="m3-btn-half m3-btn-half-primary" data-action="submit-edit-form">
			<i class="bi bi-check-lg"></i>
			<span>{{ lang.mod_news.button.edit }}</span>
		</button>
	</div>
{% endblock %}

{% block scripts %}
	<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
	<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="/templates/admin/assets/js/mod_news.js?v=4.2"></script>
{% endblock %}
