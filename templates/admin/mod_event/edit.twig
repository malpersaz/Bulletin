{% set hide_navbar = true %}
{% set hide_search = true %}
{% set hide_fab = true %}
{% set module_lang_key = 'mod_event' %}
{% extends 'admin/layout.twig' %}

{% block title %}
    {{ d.name }} - {{ lang.mod_event.edit }}
{% endblock %}

{% block headline %}
    {{ d.name }}
{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/templates/admin/assets/css/mod_event.css?v={{ site.version }}">
{% endblock %}

{% block content %}
    <form id="editForm" method="POST" action="{{ site.saddress }}mod_event/edit/{{ d.id }}" enctype="multipart/form-data"
        data-lang="{{ d.lang|lower }}"
        data-errors="{{ (errors is defined and errors is not empty ? errors : (error is defined ? [message is defined and message ? message : lang.mod_event.error_occurred] : []))|json_encode|escape('html_attr') }}"
        data-error-message="{{ (message is defined ? message : (errors is defined and errors is not empty ? errors[0] : ''))|escape('html_attr') }}"
        data-ok-text="{{ lang.mod_event.button.ok|escape('html_attr') }}"
        data-success-url="{% if success is defined %}{{ site.saddress }}mod_event/list{% endif %}"
        data-redirect-delay="2000">
        <input type="hidden" name="edit" value="1">
        <input type="hidden" name="lang" id="editLang" value="{{ d.lang|lower }}">
        <input type="hidden" name="category_id" id="editCategoryId" value="{{ d.category_id }}">

        <div class="edit-container">
            {% if success is defined %}
                <div class="banner-m3 banner-success-soft">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>{{ message is defined ? message : '' }}</span>
                </div>
            {% endif %}
            {% if error is defined and errors is not defined %}
                <div class="banner-m3 banner-error-soft">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>{{ message is defined ? message : '' }}</span>
                </div>
            {% endif %}

            {# Card 1: Basics & Category #}
            <div class="edit-card">
                <div class="form-row">
                    <label class="field-section-label">{{ lang.mod_event.wizard.step_titles.step1 }}</label>
                    <div class="m3-fake-select" data-action="open-lang-sheet">
                        <span id="editSelectedLang">
                            {% set current_lang_name = d.lang|upper %}
                            {% if lang_lang is defined %}
                                {% for l in lang_lang %}
                                    {% if l.seo == d.lang %}
                                        {% set current_lang_name = l.name %}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                            {{ current_lang_name }}
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>

                <div class="form-row">
                    <label class="field-section-label">{{ lang.mod_event.admin.columns.category_id }}</label>
                    <div class="m3-fake-select" data-action="toggle-category-sheet">
                        <span id="wizardSelectedCategory">
                            {% set current_cat_name = '' %}
                            {% if categories is defined %}
                                {% for cat in categories %}
                                    {% if cat.id == d.category_id %}
                                        {% set current_cat_name = cat.name %}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                            {{ current_cat_name ? current_cat_name : lang.mod_event.choose_wish }}
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <input type="text" class="m3-input-lg" name="name" id="editTitleInput" placeholder=" " autocomplete="off" value="{{ d.name }}" required>
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.name }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <input type="text" class="m3-input-lg" name="subject" id="editSubjectInput" placeholder=" " autocomplete="off" value="{{ d.subject }}">
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.subject }}</label>
                    </div>
                </div>
            </div>

            {# Card 2: Schedule & Venue #}
            <div class="edit-card">
                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <input type="datetime-local" class="m3-input-lg" name="start_date" id="editStartDateInput" value="{{ d.start_date ? d.start_date|replace({' ': 'T'}) : '' }}" placeholder=" " required>
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.start_date }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <input type="datetime-local" class="m3-input-lg" name="end_date" id="editEndDateInput" value="{{ d.end_date ? d.end_date|replace({' ': 'T'}) : '' }}" placeholder=" ">
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.end_date }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <input type="text" class="m3-input-lg" name="location" id="editLocationInput" placeholder=" " autocomplete="off" value="{{ d.location }}">
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.location }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <input type="text" class="m3-input-lg" name="participants" id="editParticipantsInput" placeholder=" " autocomplete="off" value="{{ d.participants }}">
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.participants }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <input type="text" class="m3-input-lg" name="guests" id="editGuestsInput" placeholder=" " autocomplete="off" value="{{ d.guests }}">
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.guests }}</label>
                    </div>
                </div>
            </div>

            {# Card 3: Summary & Content #}
            <div class="edit-card">
                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <textarea class="m3-input-lg" name="summary" id="editIntroInput" rows="3" placeholder=" " minlength="90" maxlength="255" data-counter-target="editIntroCounter" data-counter-min="90" data-counter-max="255" required>{{ d.summary|striptags }}</textarea>
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.summary }}</label>
                    </div>
                    <div class="deck-helper-bar">
                        <div class="char-counter" id="editIntroCounter">{{ d.summary|length }} / 255</div>
                    </div>
                </div>

                {# Deck toggle #}
                <div class="form-row">
                    <label class="field-section-label">{{ lang.mod_event.admin.columns.deck }}</label>
                    <input type="hidden" name="deck" id="deckHidden" value="{{ d.deck == 'y' ? 'y' : 'n' }}">
                    <div class="selection-grid">
                        <div class="selection-card {% if d.deck == 'y' %}active{% endif %}" data-action="select-deck" data-value="y">
                            <i class="bi bi-star-fill selection-icon"></i>
                            <div class="selection-label">{{ lang.mod_event.admin.radio.deck_yes }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                        <div class="selection-card {% if d.deck != 'y' %}active{% endif %}" data-action="select-deck" data-value="n">
                            <i class="bi bi-star selection-icon"></i>
                            <div class="selection-label">{{ lang.mod_event.admin.radio.deck_no }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                    </div>
                </div>

                {# Hero Slider toggle #}
                <div class="form-row">
                    <label class="field-section-label">{{ lang.mod_event.admin.columns.slider }}</label>
                    <input type="hidden" name="slider" id="sliderHidden" value="{{ d.slider == 'y' ? 'y' : 'n' }}">
                    <div class="selection-grid">
                        <div class="selection-card {% if d.slider == 'y' %}active{% endif %}" data-action="select-slider" data-value="y">
                            <i class="bi bi-stars selection-icon"></i>
                            <div class="selection-label">{{ lang.mod_event.admin.radio.slider_yes }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                        <div class="selection-card {% if d.slider != 'y' %}active{% endif %}" data-action="select-slider" data-value="n">
                            <i class="bi bi-dash-circle selection-icon"></i>
                            <div class="selection-label">{{ lang.mod_event.admin.radio.slider_no }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <label class="field-section-label">{{ lang.mod_event.admin.columns.content }}</label>
                    <div class="mod-event-editor-wrap">
                        <textarea name="content" id="editContentTextarea">{{ d.content|raw }}</textarea>
                    </div>
                </div>
            </div>

            {# Card 4: Poster Image (3:4 ratio) #}
            <div class="edit-card">
                <div class="form-row">
                    <label class="field-section-label">{{ lang.mod_event.admin.columns.image }}</label>
                    {% include 'admin/partials/image_uploader.twig' with {
                        shell_id: 'editImageShell',
                        shell_class: 'edit-image-shell',
                        has_image: d.image ? true : false,
                        shell_attrs: {
                            'data-drop-title': lang.mod_event.upload_image,
                            'data-drop-description': lang.mod_event.admin.columns.image,
                            'data-upload-link': lang.mod_event.add_image,
                            'data-link-separator': lang.mod_event.filter.clear,
                            'data-link-placeholder': lang.mod_event.filter.select_label,
                            'data-link-action': lang.mod_event.filter.apply,
                            'data-hint-loading': lang.mod_event.grid.loading,
                            'data-hint-invalid-type': lang.mod_event.validator.inarray,
                            'data-hint-no-drop-data': lang.mod_event.grid.no_data,
                            'data-hint-remote-failed': lang.mod_event.grid.connection_error,
                            'data-empty-name': lang.mod_event.filter.select_label,
                            'data-empty-meta': lang.mod_event.admin.columns.image,
                            'data-existing-image': d.image ? 'true' : 'false',
                            'data-existing-src': d.image ? (site.iaddress ~ 'mod_event/thumb/' ~ d.image) : '',
                            'data-existing-name': d.image ? d.image : '',
                            'data-existing-meta': lang.mod_event.admin.columns.image,
                            'data-remove-url': site.saddress ~ 'mod_event/image_remove_image',
                            'data-remove-id': d.id,
                            'data-remove-title': lang.mod_event.remove_image_title,
                            'data-remove-confirm': lang.mod_event.remove_image,
                            'data-remove-confirm-text': lang.mod_event.button.yes ~ ', ' ~ lang.mod_event.button.delete,
                            'data-remove-cancel-text': lang.mod_event.button.cancel,
                            'data-success-title': lang.mod_event.success,
                            'data-success-message': lang.mod_event.remove_image_success,
                            'data-error-title': lang.mod_event.error_occurred
                        },
                        dropzone_id: 'editImageDropzone',
                        empty_state_id: 'editImageEmptyState',
                        drop_title: lang.mod_event.upload_image,
                        upload_link: lang.mod_event.add_image,
                        preview_card_id: 'editImagePreviewCard',
                        remove_button_label: lang.mod_event.button.delete,
                        preview_img_id: 'editImgPreview',
                        preview_alt: d.name,
                        preview_hidden: d.image ? false : true,
                        meta_id: 'editImageMeta',
                        meta_hidden: d.image ? false : true,
                        file_name_id: 'editImageFileName',
                        file_name_text: d.image ? d.image : lang.mod_event.filter.select_label,
                        file_details_id: 'editImageFileDetails',
                        file_details_text: lang.mod_event.admin.columns.image,
                        divider_hidden: false,
                        link_separator: lang.mod_event.filter.clear,
                        url_row_hidden: false,
                        url_input_id: 'editImageUrlInput',
                        link_placeholder: lang.mod_event.filter.select_label,
                        import_btn_id: 'editImageUrlImportBtn',
                        link_action: lang.mod_event.filter.apply,
                        file_input_id: 'editImgInput'
                    } %}
                </div>
            </div>

            {# Card 5: Publishing & Metadata #}
            <div class="edit-card">
                <div class="form-row">
                    <label class="field-section-label">{{ lang.mod_event.admin.columns.status }}</label>
                    <input type="hidden" name="status" id="statusHidden" value="{{ d.status == 'y' ? 'y' : 'n' }}">
                    <div class="selection-grid">
                        <div class="selection-card {% if d.status == 'y' %}active{% endif %}" data-action="select-status" data-value="y">
                            <i class="bi bi-cloud-check selection-icon"></i>
                            <div class="selection-label">{{ lang.mod_event.admin.radio.publish_yes }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                        <div class="selection-card {% if d.status != 'y' %}active{% endif %}" data-action="select-status" data-value="n">
                            <i class="bi bi-pencil-square selection-icon"></i>
                            <div class="selection-label">{{ lang.mod_event.admin.radio.publish_no }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <input type="text" class="m3-input-lg" name="seo" id="editSeoInput" placeholder=" " autocomplete="off" value="{{ d.seo }}">
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.seo }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <input type="text" class="m3-input-lg" name="title" id="editMetaTitleInput" placeholder=" " autocomplete="off" value="{{ d.title }}">
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.title }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <input type="text" class="m3-input-lg" name="keywords" id="editMetaKeywordsInput" placeholder=" " autocomplete="off" value="{{ d.keywords }}">
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.keywords }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <textarea class="m3-input-lg" name="description" id="editMetaDescriptionInput" rows="2" placeholder=" ">{{ d.description }}</textarea>
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.description }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <input type="datetime-local" class="m3-input-lg" name="created_at" id="editDateInput" value="{{ d.created_at ? d.created_at|replace({' ': 'T'}) : '' }}" placeholder=" ">
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.created_at }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <input type="datetime-local" class="m3-input-lg" name="updated_at" id="editUpdatedAtInput" value="{{ d.updated_at ? d.updated_at|replace({' ': 'T'}) : '' }}" placeholder=" ">
                        <label class="m3-floating-label">{{ lang.mod_event.admin.columns.updated_at }}</label>
                    </div>
                </div>
            </div>

            <div class="form-actions-bar">
                <button type="submit" class="m3-btn-filled" id="btnSaveEvent">
                    <i class="bi bi-check2"></i>
                    <span>{{ lang.mod_event.button.edit }}</span>
                </button>
                <a href="{{ site.saddress }}mod_event/list" class="m3-btn-outlined">
                    <span>{{ lang.mod_event.button.cancel }}</span>
                </a>
            </div>
        </div>
    </form>
{% endblock %}

{% block scripts %}
<script src="/templates/admin/assets/js/mod_event.js?v={{ site.version }}"></script>
{% endblock %}
