<!-- TOP APP BAR -->
<header class="top-app-bar top-app-bar-default">
    {% if back_url is defined and back_url %}
        <a href="{{ back_url }}" class="header-back-btn" aria-label="{{ lang.management.back }}">
            <i class="bi bi-chevron-left"></i>
        </a>
    {% endif %}
    {% set breadcrumb_current = (page_headline is defined and page_headline is not empty ? page_headline : '')|striptags|trim %}
    <div class="headline-wrap">
        <div class="headline{% if page_headline is not defined or page_headline is empty %} site-title-font{% endif %}">{{ (page_headline is defined and page_headline is not empty ? page_headline : site.title)|raw }}</div>
        <nav class="breadcrumb-nav" aria-label="{{ lang.management.site_home }} / {{ lang.mod_user.panel.panel_title }}">
            <a href="{{ site.saddress }}" target="_blank" rel="noopener" class="breadcrumb-link">{{ lang.management.site_home }}</a>
            <i class="bi bi-chevron-right breadcrumb-sep" aria-hidden="true"></i>
            <a href="{{ site.saddress }}mod_user/panel" class="breadcrumb-link">{{ lang.mod_user.panel.panel_title }}</a>
            {% if breadcrumb_current is not empty and breadcrumb_current != lang.mod_user.panel.panel_title %}
                <i class="bi bi-chevron-right breadcrumb-sep" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">{{ breadcrumb_current|raw }}</span>
            {% endif %}
        </nav>
    </div>
    <div class="user-menu-wrapper">
        <div class="avatar-small" data-action="open-user-menu" title="{{ lang.management.user_menu_title }}">
            {% if session.image is defined and session.image != '' and session.image != 'avatar.png' %}
                <img src="{{ site.iaddress }}mod_user/{{ session.image }}" alt="" class="avatar-img">
            {% else %}
                <span class="avatar-initials">{{ (session.full_name is defined and session.full_name is not empty ? session.full_name : session.username)|slice(0, 1)|upper }}</span>
            {% endif %}
        </div>
    </div>
</header>

<!-- USER MENU SHEET -->
<div class="overlay" id="user-menu-overlay" data-action="close-user-menu"></div>
<dialog class="bottom-sheet" id="user-menu-sheet" aria-modal="true" aria-labelledby="user-menu-header-name">
    <div class="context-menu-header">
        <!-- TOP LEFT: CLOSE BUTTON (X) -->
        <button type="button" class="icon-btn modal-close-btn user-menu-close-btn" data-action="close-user-menu" title="{{ lang.mod_settings.button.close }}" aria-label="{{ lang.mod_settings.button.close }}">
            <i class="bi bi-x-lg"></i>
        </button>

        <!-- CENTER: USER AVATAR & INFO -->
        <div class="modal-title-wrapper user-menu-header-center" id="user-menu-header-center">
            <div class="user-menu-avatar-large">
                {% if session.image is defined and session.image != '' and session.image != 'avatar.png' %}
                    <img src="{{ site.iaddress }}mod_user/{{ session.image }}" alt="Avatar">
                {% else %}
                    <span>{{ (session.full_name is defined and session.full_name is not empty ? session.full_name : session.username)|slice(0, 1)|upper }}</span>
                {% endif %}
            </div>
            <div class="user-menu-header-info">
                <span class="user-menu-header-name" id="user-menu-header-name">{{ session.full_name }}</span>
                <span class="user-menu-header-group">{% if session.group_name is defined %}{{ session.group_name }}{% else %}{{ lang.management.administrator_group }}{% endif %}</span>
            </div>
        </div>

        <!-- CENTER: SUBMENU TITLE -->
        <div class="modal-title-wrapper user-menu-header-sub is-hidden" id="user-menu-header-sub">
            <i class="bi bi-shield-lock" id="user-menu-sub-icon"></i>
            <h3 id="user-menu-sub-title" data-title-admin="{{ lang.management.administration_menu }}" data-title-pm="{{ lang.management.pm_management_menu }}">{{ lang.management.administration_menu }}</h3>
        </div>

        <!-- TOP RIGHT: BACK BUTTON (<) (Visible in submenus) -->
        <button type="button" class="icon-btn modal-back-btn user-menu-back-btn is-hidden" id="user-menu-back-btn" data-action="user-menu-main" title="{{ lang.mod_settings.button.back }}" aria-label="{{ lang.mod_settings.button.back }}">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>
    
    <div id="user-menu-main" class="user-menu-list">
        <a href="{{ site.saddress }}mod_user/info" data-action="modal-push" data-url="{{ site.saddress }}mod_user/info" class="context-action-item">
            <div class="context-icon"><i class="bi bi-person"></i></div>
            <span class="context-action-label">{{ lang.management.edit_profile_menu }}</span>
        </a>
        <a href="{{ site.saddress }}mod_user/change_password" data-action="modal-push" data-url="{{ site.saddress }}mod_user/change_password" class="context-action-item">
            <div class="context-icon"><i class="bi bi-key"></i></div>
            <span class="context-action-label">{{ lang.management.change_password_menu }}</span>
        </a>
        
        <div class="context-divider user-menu-divider"></div>
        
        <div class="context-action-item" data-action="user-submenu" data-target="user-menu-pm">
            <div class="context-icon"><i class="bi bi-chat-dots"></i></div>
            <span class="context-action-label">{{ lang.management.pm_management_menu }}</span>
            {% if session.okunmamis is defined and session.okunmamis > 0 %}
                <span class="badge user-menu-pm-badge">{{ session.okunmamis }}</span>
            {% endif %}
            <i class="bi bi-chevron-right user-menu-chevron"></i>
        </div>
        
        {% if session.permissions.mod_settings.edit is defined %}
        <div class="context-divider user-menu-divider"></div>
        <div class="context-action-item" data-action="open-site-status" id="user-menu-site-status-item">
            <div class="context-icon user-menu-site-status-icon-wrapper {{ site.site_status == 'closed' ? 'status-closed' : 'status-open' }}" id="user-menu-site-status-icon-wrapper">
                <i class="bi {{ site.site_status == 'closed' ? 'bi-shield-lock-fill' : 'bi-globe2' }}" id="user-menu-site-status-icon"></i>
            </div>
            <span class="context-action-label user-menu-site-status-label" id="user-menu-site-status-label">{{ site.site_status == 'closed' ? lang.mod_settings.site_closed_label : lang.mod_settings.site_open_label }}</span>
            <span id="user-menu-site-status-dot" class="user-menu-site-status-dot {{ site.site_status == 'closed' ? 'status-closed' : 'status-open' }}"></span>
        </div>
        {% endif %}

        {% if session.permissions.mod_user.setting is defined or session.permissions.mod_settings.edit is defined or session.permissions.mod_user.acl is defined or session.permissions.mod_user.list is defined or session.permissions.mod_user_group.list is defined or session.permissions.mod_acl.list is defined %}
        <div class="context-divider user-menu-divider"></div>
        <div class="context-action-item" data-action="user-submenu" data-target="user-menu-admin">
            <div class="context-icon"><i class="bi bi-shield-lock"></i></div>
            <span class="context-action-label">{{ lang.management.administration_menu }}</span>
            <i class="bi bi-chevron-right user-menu-chevron"></i>
        </div>
        {% endif %}

        <div class="context-divider user-menu-divider"></div>
        
        <a href="{{ site.saddress }}logout" class="context-action-item action-danger user-menu-logout-item">
            <div class="context-icon icon-delete"><i class="bi bi-box-arrow-right"></i></div>
            <span class="context-action-label">{{ lang.management.logout_menu }}</span>
        </a>
    </div>

    <div id="user-menu-pm" class="user-menu-list is-hidden">
        <a href="{{ site.saddress }}mod_user_pm/inbox" data-action="close-user-menu" class="context-action-item">
            <div class="context-icon"><i class="bi bi-envelope-open"></i></div>
            <span class="context-action-label">{{ lang.mod_user_pm.inbox_link_label }}</span>
            {% if session.okunmamis is defined and session.okunmamis > 0 %}
                <span class="badge user-menu-pm-badge-end">{{ session.okunmamis }}</span>
            {% endif %}
        </a>
        <a href="{{ site.saddress }}mod_user_pm/sent" data-action="close-user-menu" class="context-action-item">
            <div class="context-icon"><i class="bi bi-send"></i></div>
            <span class="context-action-label">{{ lang.mod_user_pm.sent_title }}</span>
        </a>
        
        {% if session.permissions.mod_user_pm.send is defined %}
        <a href="{{ site.saddress }}mod_user_pm/send" data-action="close-user-menu" class="context-action-item">
            <div class="context-icon"><i class="bi bi-pencil-square"></i></div>
            <span class="context-action-label">{{ lang.mod_user_pm.new_message_action }}</span>
        </a>
        {% endif %}
    </div>

    <div id="user-menu-admin" class="user-menu-list is-hidden">
        {% if session.permissions.mod_user.list is defined %}
        <a href="{{ site.saddress }}mod_user/list" data-action="close-user-menu" class="context-action-item">
            <div class="context-icon"><i class="bi bi-people"></i></div>
            <span class="context-action-label">{{ lang.mod_user.admin.list }}</span>
        </a>
        {% endif %}
        
        {% if session.permissions.mod_user_group.list is defined %}
        <a href="{{ site.saddress }}mod_user_group/list" data-action="close-user-menu" class="context-action-item">
            <div class="context-icon"><i class="bi bi-collection"></i></div>
            <span class="context-action-label">{{ lang.mod_user_group.admin.list }}</span>
        </a>
        {% endif %}
        
        {% if session.permissions.mod_user.setting is defined %}
        <a href="{{ site.saddress }}mod_user/settings" data-action="close-user-menu" class="context-action-item">
            <div class="context-icon"><i class="bi bi-person-gear"></i></div>
            <span class="context-action-label">{{ lang.mod_user.admin.membership_settings }}</span>
        </a>
        {% endif %}
        
        <div class="context-action-item" data-action="open-newsletter">
            <div class="context-icon"><i class="bi bi-envelope-at"></i></div>
            <span class="context-action-label">{{ lang.management.newsletter_management }}</span>
            <i class="bi bi-chevron-right user-menu-chevron"></i>
        </div>
        
        {% if session.permissions.mod_settings.edit is defined %}
        <div class="context-action-item" data-action="open-stats">
            <div class="context-icon"><i class="bi bi-bar-chart-line"></i></div>
            <span class="context-action-label">{{ lang.mod_settings.stats_title }}</span>
            <i class="bi bi-chevron-right user-menu-chevron"></i>
        </div>
        <div class="context-action-item" data-action="open-site-settings-menu">
            <div class="context-icon"><i class="bi bi-sliders"></i></div>
            <span class="context-action-label">{{ lang.mod_settings.site_settings_menu_title }}</span>
            <i class="bi bi-chevron-right user-menu-chevron"></i>
        </div>
        {% endif %}
    </div>
</dialog>

<!-- SITE SETTINGS OPTIONS MENU MODAL -->
