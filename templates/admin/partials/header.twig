            <div class="site-settings-option-icon icon-primary">
                <i class="bi bi-card-heading"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.mod_settings.site_profile_title }}</h4>
