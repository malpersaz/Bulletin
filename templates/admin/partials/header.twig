    <div class="modal-header-bar">
        <button type="button" class="icon-btn modal-close-btn" data-action="modal-close-all" aria-label="{{ lang.mod_settings.button.close }}">
            <i class="bi bi-x-lg"></i>
        </button>
        <div class="modal-title-wrapper" id="siteSettingsMenuModalTitle">
            <i class="bi bi-sliders"></i>
            <h3>{{ lang.mod_settings.site_settings_menu_title }}</h3>
        </div>
        <button type="button" class="icon-btn modal-back-btn" data-action="modal-back-settings" aria-label="{{ lang.mod_settings.button.back }}">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>

    <div class="modal-body-content site-settings-list">
        {% if session.permissions.mod_settings.edit is defined %}
