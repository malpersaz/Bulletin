            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </a>

        <a href="{{ site.saddress }}mod_settings/legal_info" data-action="modal-push" data-url="{{ site.saddress }}mod_settings/legal_info" class="site-settings-option-card">
            <div class="site-settings-option-icon icon-tertiary">
                <i class="bi bi-building-lock"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.mod_settings.legal_info_title }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.legal_info_description }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </a>

        <a href="{{ site.saddress }}mod_settings/cookie_policy" data-action="modal-push" data-url="{{ site.saddress }}mod_settings/cookie_policy" class="site-settings-option-card">
