        </div>
    </div>
</dialog>

<!-- SITE STATUS MODAL DIALOG -->
<dialog class="af-modal-dialog" id="site-status-modal" aria-labelledby="siteStatusModalTitle">
    <div class="modal-header-bar">
        <button type="button" class="icon-btn modal-close-btn" data-action="modal-close-all" aria-label="{{ lang.mod_settings.button.close }}">
            <i class="bi bi-x-lg"></i>
        </button>
        <div class="modal-title-wrapper" id="siteStatusModalTitle">
            <i class="bi {{ site.site_status == 'closed' ? 'bi-shield-lock-fill' : 'bi-power' }}" id="site-status-modal-header-icon"></i>
            <h3>{{ lang.mod_settings.site_status_menu_title }}</h3>
        </div>
        <button type="button" class="icon-btn modal-back-btn" data-action="modal-back-status" aria-label="{{ lang.mod_settings.button.back }}">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>

    <div class="modal-body-content site-status-body">
        <!-- Compact Instant AJAX Segmented Switch -->
        <div class="site-status-segmented-control">
            <button type="button" data-action="site-status-open" id="segmented-btn-open" class="segmented-status-btn {{ site.site_status == 'closed' ? 'inactive-open' : 'active-open' }}">
                <i class="bi bi-globe2"></i>
                <span>{{ lang.mod_settings.site_open_label }}</span>
            </button>

            <button type="button" data-action="site-status-closed" id="segmented-btn-closed" class="segmented-status-btn {{ site.site_status == 'closed' ? 'active-closed' : 'inactive-closed' }}">
                <i class="bi bi-shield-lock-fill"></i>
                <span>{{ lang.mod_settings.site_closed_label }}</span>
            </button>
        </div>

        <!-- Maintenance Message Field (Auto-Saves on Change/Blur) -->
        <div>
            <label for="maintenance_message_input" class="maintenance-label">
                {{ lang.mod_settings.maintenance_message_label }}
            </label>
            <textarea id="maintenance_message_input" rows="3" class="maintenance-textarea" placeholder="{{ lang.mod_settings.default_maintenance_message }}">{{ site.maintenance_message|default(lang.mod_settings.default_maintenance_message) }}</textarea>
        </div>
    </div>
</dialog>

<!-- STATS EDIT MODAL -->
<dialog class="af-modal-dialog" id="stats-modal" aria-labelledby="statsModalTitle">
    <div class="modal-header-bar">
        <button type="button" class="icon-btn modal-close-btn" data-action="modal-close-all" aria-label="{{ lang.mod_settings.button.close }}">
            <i class="bi bi-x-lg"></i>
        </button>
        <div class="modal-title-wrapper" id="statsModalTitle">
            <i class="bi bi-bar-chart-line"></i>
            <h3>{{ lang.mod_settings.stats_title }}</h3>
        </div>
        <button type="button" class="icon-btn modal-back-btn" data-action="modal-back-stats" aria-label="{{ lang.mod_settings.button.back }}">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>

    <form id="statsModalForm">
        <div class="modal-body-content">
            <div class="m3-input-wrapper mb-3">
                <input type="number" class="m3-input-lg stats-input" name="stat_workforce" id="modal_stat_workforce" value="{{ site.stat_workforce|default(1200) }}" required>
                <label class="m3-floating-label">{{ lang.mod_settings.stat_workforce }}</label>
            </div>

            <div class="m3-input-wrapper mb-3">
                <input type="number" class="m3-input-lg stats-input" name="stat_offices" id="modal_stat_offices" value="{{ site.stat_offices|default(18) }}" required>
                <label class="m3-floating-label">{{ lang.mod_settings.stat_offices }}</label>
            </div>
        </div>

        <div class="stats-modal-footer">
            <button type="button" class="m3-btn-half m3-btn-half-neutral" data-action="close-stats">
                {{ lang.mod_settings.button.cancel }}
            </button>
            <button type="submit" class="m3-btn-half m3-btn-half-primary" id="saveStatsModalBtn">
                {{ lang.mod_settings.save }}
            </button>
        </div>
    </form>
</dialog>

<dialog class="bottom-sheet sheet-dialog-large" id="newsletter-sheet">
    <div class="drag-handle-bar" data-action="close-newsletter"></div>
    
    <div class="sheet-header-bar">
        <button class="icon-btn modal-close-btn sheet-header-btn" data-action="close-newsletter" aria-label="{{ lang.mod_settings.button.close }}">
            <i class="bi bi-x-lg btn-icon-muted"></i>
        </button>

        <div class="modal-title-wrapper sheet-title-wrapper">
            <div class="sheet-title-icon-box">
                <i class="bi bi-envelope-at-fill"></i>
            </div>
            <div>
                <h3 class="sheet-title-text">{{ lang.mod_newsletter.module_title }}</h3>
                <span id="newsletter-stats-pill" class="badge sheet-stats-badge">0 {{ lang.mod_newsletter.subscribers_count_unit }}</span>
            </div>
        </div>

        <div class="sheet-header-actions">
            <button class="icon-btn sheet-header-btn" data-action="export-newsletter-csv" title="{{ lang.mod_newsletter.export_csv }}" aria-label="{{ lang.mod_newsletter.export_csv }}">
                <i class="bi bi-file-earmark-spreadsheet-fill btn-icon-primary"></i>
            </button>
            <button class="icon-btn sheet-header-btn" data-action="toggle-newsletter-add" title="{{ lang.mod_newsletter.add_subscriber_title }}" aria-label="{{ lang.mod_newsletter.add_subscriber_title }}">
                <i class="bi bi-person-plus-fill btn-icon-primary"></i>
            </button>
            <button class="icon-btn modal-back-btn sheet-header-btn" data-action="modal-back-newsletter" title="{{ lang.mod_settings.button.back }}" aria-label="{{ lang.mod_settings.button.back }}">
                <i class="bi bi-chevron-left btn-icon-large"></i>
            </button>
        </div>
    </div>

    <div id="newsletter-add-form" class="sheet-inline-form-container">
        <form id="newsletter-add-admin-form" class="sheet-inline-form">
            <input type="email" id="new-subscriber-email" class="form-control sheet-form-input-email" placeholder="{{ lang.mod_newsletter.enter_email_placeholder }}" required>
            <button type="submit" class="btn btn-primary sheet-form-submit-btn">
                <i class="bi bi-plus-lg"></i> {{ lang.mod_newsletter.add }}
            </button>
        </form>
    </div>

    <div class="sheet-filter-bar">
        <div class="sheet-search-box">
            <i class="bi bi-search sheet-search-icon"></i>
            <input type="text" id="newsletter-search-input" class="sheet-search-input" placeholder="{{ lang.mod_newsletter.search_subscribers_placeholder }}">
        </div>
        <div class="sheet-pills-row">
            <button class="filter-pill active" data-status="all" data-action="filter-newsletter">
                {{ lang.mod_newsletter.all_subscribers }}
            </button>
            <button class="filter-pill" data-status="active" data-action="filter-newsletter">
                {{ lang.mod_newsletter.active_subscribers }}
            </button>
            <button class="filter-pill" data-status="unsubscribed" data-action="filter-newsletter">
                {{ lang.mod_newsletter.unsubscribed_subscribers }}
            </button>
        </div>
    </div>

    <div id="newsletter-subscribers-body" class="sheet-scroll-body">
        <div class="sheet-loading-placeholder">
            <div class="spinner-border spinner-border-sm" role="status"></div>
        </div>
    </div>
</dialog>

<dialog class="bottom-sheet sheet-dialog-large" id="redirect-sheet" aria-labelledby="redirect-sheet-title">
    <div class="drag-handle-bar" data-action="close-redirect" role="button" tabindex="0" aria-label="{{ lang.mod_settings.button.close }}"></div>
    
    <div class="sheet-header-bar">
        <button type="button" class="icon-btn modal-close-btn sheet-header-btn" data-action="close-redirect" aria-label="{{ lang.mod_settings.button.close }}">
            <i class="bi bi-x-lg btn-icon-muted"></i>
        </button>

        <div class="modal-title-wrapper sheet-title-wrapper">
            <div class="sheet-title-icon-box">
                <i class="bi bi-arrow-return-right"></i>
            </div>
            <div>
                <h3 id="redirect-sheet-title" class="sheet-title-text">{{ lang.management.redirect_management }}</h3>
                <span id="redirect-stats-pill" class="badge sheet-stats-badge">0 {{ lang.mod_redirect.admin.dashboard.active_redirects }}</span>
            </div>
        </div>

        <div class="sheet-header-actions">
            <button type="button" class="icon-btn sheet-header-btn" data-action="toggle-redirect-add" title="{{ lang.mod_redirect.button.add }}" aria-label="{{ lang.mod_redirect.button.add }}">
                <i class="bi bi-plus-lg btn-icon-large"></i>
            </button>
            <button type="button" class="icon-btn modal-back-btn sheet-header-btn" data-action="modal-back-redirect" title="{{ lang.mod_settings.button.back }}" aria-label="{{ lang.mod_settings.button.back }}">
                <i class="bi bi-chevron-left btn-icon-large"></i>
            </button>
        </div>
    </div>

    <div id="redirect-form-container" class="sheet-inline-form-container">
        <div class="redirect-form-header">
            <strong id="redirect-form-title" class="redirect-form-title">{{ lang.mod_redirect.add }}</strong>
            <button type="button" class="redirect-cancel-btn" data-action="hide-redirect-form" aria-label="{{ lang.mod_redirect.button.cancel }}">{{ lang.mod_redirect.button.cancel }}</button>
        </div>
        <form id="redirect-admin-form" class="redirect-form">
            <input type="hidden" id="redirect-form-id" value="">
            <input type="text" id="redirect-old-url" class="form-control redirect-input" placeholder="{{ lang.mod_redirect.admin.columns.old_url }}" aria-label="{{ lang.mod_redirect.admin.columns.old_url }}" required>
            <input type="text" id="redirect-new-url" class="form-control redirect-input" placeholder="{{ lang.mod_redirect.admin.columns.new_url }}" aria-label="{{ lang.mod_redirect.admin.columns.new_url }}" required>
            <div class="redirect-actions-row">
                <select id="redirect-status-code" class="form-control redirect-select" aria-label="{{ lang.mod_redirect.admin.columns.status_code }}">
                    <option value="301">{{ lang.mod_redirect.admin.columns.status_code_301 }}</option>
                    <option value="302">{{ lang.mod_redirect.admin.columns.status_code_302 }}</option>
                </select>
                <button type="submit" id="redirect-submit-btn" class="btn btn-primary redirect-submit-btn">
                    {{ lang.mod_redirect.button.add }}
                </button>
            </div>
        </form>
    </div>

    <div class="sheet-filter-bar">
        <div class="sheet-search-box">
            <i class="bi bi-search sheet-search-icon" aria-hidden="true"></i>
            <input type="text" id="redirect-search-input" class="sheet-search-input" placeholder="{{ lang.mod_redirect.admin.search_placeholder }}" aria-label="{{ lang.mod_redirect.admin.search_placeholder }}">
        </div>
    </div>

    <div id="redirect-items-body" class="sheet-scroll-body" role="region" aria-label="{{ lang.management.redirect_management }}">
        <div class="sheet-loading-placeholder">
            <div class="spinner-border spinner-border-sm" role="status" aria-label="Loading"></div>
        </div>
    </div>
</dialog>

<!-- DYNAMIC ROUTE MODAL CONTAINER -->
<dialog class="af-modal-dialog" id="modal-dynamic-dialog">
    <div class="modal-header-bar">
        <button type="button" class="icon-btn modal-close-btn" data-action="modal-close-all" aria-label="{{ lang.mod_settings.button.close }}">
            <i class="bi bi-x-lg"></i>
        </button>
        <div class="modal-title-wrapper" id="modal-dynamic-title">
            <i class="bi bi-gear"></i>
            <h3>Admin Panel</h3>
        </div>
        <button type="button" class="icon-btn modal-back-btn" data-action="modal-dynamic-back" aria-label="{{ lang.mod_settings.button.back }}">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>
    <div id="modal-dynamic-body"></div>
</dialog>

<!-- TOP APP BAR (CONTEXTUAL) -->
{% if hide_contextual_bar is not defined or not hide_contextual_bar %}
{% set selection_lang = attribute(lang, active_module_lang_key) %}
<header class="top-app-bar top-app-bar-contextual">
    <button class="icon-btn" data-action="exit-selection"><i class="bi bi-x-lg"></i></button>
    <div class="headline" id="selectionCount">0 {{ selection_lang.ui.record_selected }}</div>
    <button class="icon-btn"><i class="bi bi-trash3"></i></button>
    <button class="icon-btn"><i class="bi bi-three-dots-vertical"></i></button>
</header>
{% endif %}

<!-- SEARCH AREA -->
{% if show_search %}
<div class="search-row">
    <div class="search-bar-container">
        <i class="bi bi-search search-icon"></i>
        <input type="text" class="search-input" id="searchInput" placeholder="{{ search_placeholder is defined ? search_placeholder : lang.mod_user.panel.search_placeholder }}" autocomplete="off">
        <button id="clearSearchBtn" data-action="clear-search">
            <i class="bi bi-x-circle-fill"></i>
        </button>
    </div>

    {% if show_search_filter_button is not defined or show_search_filter_button %}
    <button class="filter-btn" data-action="open-filter-sheet">
        <i class="bi bi-sliders2"></i>
    </button>
    {% endif %}
</div>
{% endif %}
