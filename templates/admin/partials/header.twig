                <i class="bi bi-cookie"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.mod_settings.cookie_policy_title }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.cookie_policy_menu_desc }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </a>

        <a href="{{ site.saddress }}mod_settings/working_hours" data-action="modal-push" data-url="{{ site.saddress }}mod_settings/working_hours" class="site-settings-option-card">
            <div class="site-settings-option-icon icon-primary">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.mod_settings.working_hours_title }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.working_hours_menu_desc }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </a>

        <a href="{{ site.saddress }}mod_settings/affiliations" data-action="modal-push" data-url="{{ site.saddress }}mod_settings/affiliations" class="site-settings-option-card">
            <div class="site-settings-option-icon icon-tertiary">
                <i class="bi bi-building-check"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.mod_settings.affiliations_title }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.affiliations_menu_desc }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </a>

        <div class="site-settings-option-card" data-action="open-theme-management">
            <div class="site-settings-option-icon icon-secondary">
                <i class="bi bi-palette"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.mod_settings.theme_management_title }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.theme_select_label }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </div>

        <div class="site-settings-option-card" data-action="open-logo-icon-management">
            <div class="site-settings-option-icon icon-tertiary">
                <i class="bi bi-images"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.mod_settings.logo_icon_management_title }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.logo_icon_management_desc }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </div>
        {% endif %}

        {% if session.permissions.mod_user.acl is defined %}
        <a href="{{ site.saddress }}mod_user/acl" data-action="close-site-settings-menu" class="site-settings-option-card">
            <div class="site-settings-option-icon icon-primary">
                <i class="bi bi-shield-lock"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.mod_user.admin.acl }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.user_group_acl_desc }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </a>
        {% endif %}

        {% if session.permissions.mod_acl.list is defined %}
        <a href="{{ site.saddress }}mod_acl/list" data-action="close-site-settings-menu" class="site-settings-option-card">
            <div class="site-settings-option-icon icon-secondary">
                <i class="bi bi-shield-check"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.mod_acl.admin.list }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.acl_list_desc }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </a>
        {% endif %}

        {% if session.permissions.mod_settings.edit is defined %}
        <a href="{{ site.saddress }}lang/panel" data-action="close-site-settings-menu" class="site-settings-option-card">
            <div class="site-settings-option-icon icon-tertiary">
                <i class="bi bi-translate"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.management.language_management_menu }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.language_management_desc }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </a>

        <a href="{{ site.saddress }}mod_settings/social_media" data-action="close-site-settings-menu" class="site-settings-option-card">
            <div class="site-settings-option-icon icon-primary">
                <i class="bi bi-share"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.mod_user.admin.social_media }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.social_media_desc }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </a>

        <a href="{{ site.saddress }}mod_settings/google_settings" data-action="close-site-settings-menu" class="site-settings-option-card">
            <div class="site-settings-option-icon icon-secondary">
                <i class="bi bi-google"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.management.google_services_hub }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.google_services_desc }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </a>

        <div data-action="open-redirect" class="site-settings-option-card">
            <div class="site-settings-option-icon icon-tertiary">
                <i class="bi bi-arrow-return-right"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.management.redirect_management }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.redirect_management_desc }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </div>

        <a href="{{ site.saddress }}mod_seo/index" data-action="close-site-settings-menu" class="site-settings-option-card">
            <div class="site-settings-option-icon icon-primary">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
            <div class="site-settings-option-info">
                <h4 class="site-settings-option-title">{{ lang.mod_settings.google_rankings_seo_title }}</h4>
                <p class="site-settings-option-desc">{{ lang.mod_settings.google_rankings_seo_desc }}</p>
            </div>
            <i class="bi bi-chevron-right site-settings-option-chevron"></i>
        </a>
        {% endif %}
    </div>
</dialog>

