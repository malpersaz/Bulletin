<!-- TOP APP BAR -->
<header class="top-app-bar top-app-bar-default">
    <button class="icon-btn" onclick="toggleDrawer()"><i class="bi bi-list" style="font-size:24px;"></i></button>
    <div class="headline">{{ (page_headline is defined and page_headline is not empty ? page_headline : site.title)|raw }}</div>
    <div class="user-menu-wrapper" style="position: relative; display: inline-flex; justify-content: center; align-items: center; padding-right: 4px;">
        <div class="avatar-small" style="cursor:pointer;" onclick="openUserMenuSheet()" title="User Menu">
            {% if session.image is defined and session.image != '' and session.image != 'avatar.png' %}
                <img src="{{ site.radres }}mod_user/{{ session.image }}" alt="" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;">
            {% else %}
                <span style="font-size: 16px; font-weight: 600; color: var(--md-sys-color-on-primary-container, #21005D);">{{ (session.full_name is defined and session.full_name is not empty ? session.full_name : session.username)|slice(0, 1)|upper }}</span>
            {% endif %}
        </div>
    </div>
</header>

<!-- USER MENU SHEET -->
<div class="overlay" id="user-menu-overlay" onclick="closeUserMenuSheet()"></div>
<div class="bottom-sheet" id="user-menu-sheet">
    <div class="context-menu-header">
        <div class="user-menu-avatar-large">
            {% if session.image is defined and session.image != '' and session.image != 'avatar.png' %}
                <img src="{{ site.radres }}mod_user/{{ session.image }}" alt="Avatar" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
            {% else %}
                <span style="font-size: 36px; font-weight: 600; color: var(--md-sys-color-on-primary-container, #21005D); display: flex; align-items: center; justify-content: center; height: 100%;">{{ (session.full_name is defined and session.full_name is not empty ? session.full_name : session.username)|slice(0, 1)|upper }}</span>
            {% endif %}
        </div>
        <div class="user-menu-header-info">
            <span class="user-menu-header-name">{{ session.full_name }}</span>
            <span class="user-menu-header-group">{% if session.group_name is defined %}{{ session.group_name }}{% else %}Administrator{% endif %}</span>
        </div>
    </div>
    
    <div id="user-menu-main" style="padding: 4px 0;">
        <a href="{{ site.sadres }}mod_user/info" class="context-action-item" style="text-decoration:none;">
            <div class="context-icon"><i class="bi bi-person"></i></div>
            <span class="context-action-label">{{ lang.management.edit_profile_menu }}</span>
        </a>
        <a href="{{ site.sadres }}mod_user/change_password" class="context-action-item" style="text-decoration:none;">
            <div class="context-icon"><i class="bi bi-key"></i></div>
            <span class="context-action-label">{{ lang.management.change_password_menu }}</span>
        </a>
        
        <div class="context-divider" style="margin: 4px 0;"></div>
        
        <div class="context-action-item" onclick="showUserSubmenu('user-menu-pm')" style="cursor:pointer;">
            <div class="context-icon"><i class="bi bi-chat-dots"></i></div>
            <span class="context-action-label">{{ lang.management.pm_management_menu }}</span>
            {% if session.okunmamis is defined and session.okunmamis > 0 %}
                <span class="badge" style="background: var(--md-sys-color-error); color: white; border-radius: 12px; padding: 2px 6px; font-size: 0.75rem; margin-left: 8px;">{{ session.okunmamis }}</span>
            {% endif %}
            <i class="bi bi-chevron-right" style="margin-left: auto; font-size: 14px; color: var(--md-sys-color-outline);"></i>
        </div>
        
        {% if session.permissions.mod_user.setting is defined or session.permissions.mod_settings.edit is defined or session.permissions.mod_user.acl is defined or session.permissions.mod_user.list is defined or session.permissions.mod_user_group.list is defined or session.permissions.mod_acl.list is defined %}
        <div class="context-divider" style="margin: 4px 0;"></div>
        <div class="context-action-item" onclick="showUserSubmenu('user-menu-admin')" style="cursor:pointer;">
            <div class="context-icon"><i class="bi bi-shield-lock"></i></div>
            <span class="context-action-label">{{ lang.management.administration_menu }}</span>
            <i class="bi bi-chevron-right" style="margin-left: auto; font-size: 14px; color: var(--md-sys-color-outline);"></i>
        </div>
        {% endif %}
        
        <div class="context-divider" style="margin: 4px 0;"></div>
        
        <a href="{{ site.sadres }}mod_user/logout" class="context-action-item action-danger" style="text-decoration:none; margin-bottom:16px;">
            <div class="context-icon icon-delete"><i class="bi bi-box-arrow-right"></i></div>
            <span class="context-action-label">{{ lang.management.logout_menu }}</span>
        </a>
    </div>

    <div id="user-menu-pm" style="display: none; padding: 4px 0;">
        <div class="context-action-item" onclick="showUserMenuMain()" style="cursor:pointer; color: var(--md-sys-color-primary);">
            <div class="context-icon" style="background: transparent; justify-content: flex-start; margin-left: -8px;"><i class="bi bi-chevron-left" style="font-size: 20px;"></i></div>
        </div>
        <div class="context-divider" style="margin: 4px 0;"></div>
        <a href="{{ site.sadres }}mod_user_pm/inbox" class="context-action-item" style="text-decoration:none;">
            <div class="context-icon"><i class="bi bi-envelope-open"></i></div>
            <span class="context-action-label">{{ lang.mod_user_pm.inbox_link_label }}</span>
            {% if session.okunmamis is defined and session.okunmamis > 0 %}
                <span class="badge" style="background: var(--md-sys-color-error); color: white; border-radius: 12px; padding: 2px 6px; font-size: 0.75rem; margin-left: auto;">{{ session.okunmamis }}</span>
            {% endif %}
        </a>
        <a href="{{ site.sadres }}mod_user_pm/sent" class="context-action-item" style="text-decoration:none;">
            <div class="context-icon"><i class="bi bi-send"></i></div>
            <span class="context-action-label">{{ lang.mod_user_pm.sent_title }}</span>
        </a>
        
        {% if session.permissions.mod_user_pm.send is defined %}
        <a href="{{ site.sadres }}mod_user_pm/send" class="context-action-item" style="text-decoration:none;">
            <div class="context-icon"><i class="bi bi-pencil-square"></i></div>
            <span class="context-action-label">{{ lang.mod_user_pm.new_message_action }}</span>
        </a>
        {% endif %}
    </div>

    <div id="user-menu-admin" style="display: none; padding: 4px 0;">
        <div class="context-action-item" onclick="showUserMenuMain()" style="cursor:pointer; color: var(--md-sys-color-primary);">
           <div class="context-icon" style="background: transparent; justify-content: flex-start; margin-left: -8px;"><i class="bi bi-chevron-left" style="font-size: 20px;"></i></div>
        </div>
        <div class="context-divider" style="margin: 4px 0;"></div>
        
        {% if session.permissions.mod_user.list is defined %}
        <a href="{{ site.sadres }}mod_user/list" class="context-action-item" style="text-decoration:none;">
            <div class="context-icon"><i class="bi bi-people"></i></div>
            <span class="context-action-label">{{ lang.mod_user.admin.list }}</span>
        </a>
        {% endif %}
        
        {% if session.permissions.mod_user_group.list is defined %}
        <a href="{{ site.sadres }}mod_user_group/list" class="context-action-item" style="text-decoration:none;">
            <div class="context-icon"><i class="bi bi-collection"></i></div>
            <span class="context-action-label">{{ lang.mod_user_group.admin.list }}</span>
        </a>
        {% endif %}

        {% if session.permissions.mod_user.acl is defined %}
        <a href="{{ site.sadres }}mod_user/acl" class="context-action-item" style="text-decoration:none;">
            <div class="context-icon"><i class="bi bi-shield-lock"></i></div>
            <span class="context-action-label">{{ lang.mod_user.admin.acl }}</span>
        </a>
        {% endif %}
        
        {% if session.permissions.mod_acl.list is defined %}
        <a href="{{ site.sadres }}mod_acl/list" class="context-action-item" style="text-decoration:none;">
            <div class="context-icon"><i class="bi bi-shield-check"></i></div>
            <span class="context-action-label">{{ lang.mod_acl.admin.list }}</span>
        </a>
        {% endif %}
        
        {% if session.permissions.mod_user.setting is defined %}
        <a href="{{ site.sadres }}mod_user/settings" class="context-action-item" style="text-decoration:none;">
            <div class="context-icon"><i class="bi bi-person-gear"></i></div>
            <span class="context-action-label">{{ lang.mod_user.admin.settings }}</span>
        </a>
        {% endif %}
        
        {% if session.permissions.mod_settings.edit is defined %}
        <a href="{{ site.sadres }}mod_settings/social_media" class="context-action-item" style="text-decoration:none;">
            <div class="context-icon"><i class="bi bi-share"></i></div>
            <span class="context-action-label">{{ lang.mod_user.admin.social_media }}</span>
        </a>
        <a href="{{ site.sadres }}mod_settings/edit" class="context-action-item" style="text-decoration:none;">
            <div class="context-icon"><i class="bi bi-sliders"></i></div>
            <span class="context-action-label">{{ lang.mod_user.admin.site_settings }}</span>
        </a>
        {% endif %}
    </div>
</div>

<!-- TOP APP BAR (CONTEXTUAL) -->
{% if hide_contextual_bar is not defined or not hide_contextual_bar %}
{% set selection_lang = attribute(lang, active_module_lang_key) %}
<header class="top-app-bar top-app-bar-contextual">
    <button class="icon-btn" onclick="exitSelectionMode()"><i class="bi bi-x-lg"></i></button>
    <div class="headline" id="selectionCount">0 {{ selection_lang.ui.record_selected }}</div>
    <button class="icon-btn"><i class="bi bi-trash3"></i></button>
    <button class="icon-btn"><i class="bi bi-three-dots-vertical"></i></button>
</header>
{% endif %}

<!-- SEARCH AREA -->
{% if show_search %}
<!-- SEARCH AREA -->
<div class="search-row" style="display: flex !important;">
    <div class="search-bar-container">
        <i class="bi bi-search search-icon"></i>
        <input type="text" class="search-input" id="searchInput" placeholder="{{ search_placeholder is defined ? search_placeholder : lang.mod_user.panel.search_placeholder }}" autocomplete="off">
        <button id="clearSearchBtn" onclick="clearSearch()">
            <i class="bi bi-x-circle-fill"></i>
        </button>
    </div>

    {% if show_search_filter_button is not defined or show_search_filter_button %}
    <button class="filter-btn" onclick="openSheet()">
        <i class="bi bi-sliders2"></i>
    </button>
    {% endif %}
</div>
{% endif %}
