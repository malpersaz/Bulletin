{% set wizard_lang_key = wizard_module %}
{% set wizard_lang = attribute(lang, wizard_lang_key) %}
{% set wizard_title_key = 'content_title' %}
{% set wizard_body_key = 'content' %}
{% if wizard_lang_key == 'mod_news' %}
    {% set wizard_title_key = 'news_title' %}
    {% set wizard_body_key = 'news' %}
{% elseif wizard_lang_key == 'mod_publication' %}
    {% set wizard_title_key = 'publication_title' %}
    {% set wizard_body_key = 'publication' %}
{% endif %}
<form id="addForm" method="POST" action="{{ site.saddress }}{{ wizard_lang_key }}/add" enctype="multipart/form-data">
<div id="contentWizard" class="wizard-overlay">

    <!-- Wizard Header -->
    <header class="wizard-header">
        <button type="button" class="icon-btn" data-action="close-content-wizard" data-list-url="{{ site.saddress }}{{ wizard_lang_key }}/list"><i class="bi bi-x-lg"></i></button>
        <div class="wizard-title">
            <span id="wizardStepTitle">{{ wizard_lang.wizard.step.language }}</span>
            <span id="wizardStepCounter">1/8</span>
        </div>
        <button type="button" class="m3-btn-text" data-action="submit-content-wizard">{{ wizard_lang.wizard.button.save }}</button>
    </header>

    <!-- Progress Bar -->
    <div class="wizard-progress-bar">
        <div class="wizard-progress-fill" id="wizardProgressFill"></div>
    </div>

    <!-- Wizard Content Scrollable -->
    <div class="wizard-content">

        <!-- Hidden Defaults -->
        <input type="hidden" name="deck" value="n">
        <input type="hidden" name="highlighted" value="n">
        <input type="hidden" name="gallery_id" value="0">
        <input type="hidden" name="file_id" value="0">
        <input type="hidden" name="acl_id" value="0">
        <input type="hidden" name="menu" value="0">
        <input type="hidden" name="video" value="">
        <input type="hidden" name="add" value="1">
        <input type="hidden" name="seo" id="seo" value="">
        <input type="hidden" name="title" id="title" value="">
        <input type="hidden" name="keywords" id="keywords" value="">
        <input type="hidden" name="description" id="description" value="">
        <input type="hidden" name="lang" id="wizardHiddenLang" value="{{ site.lang|lower }}">
        <input type="hidden" name="category_id" id="wizardHiddenCategory" value="0">

        <!-- Step 1: Language -->
        <div class="wizard-step active" id="wizardStep1">
            <h2 class="step-headline">{{ wizard_lang.wizard.step.language }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.subtitle.language }}</p>
            <div class="selection-grid">
                {% for item in lang_lang %}
                <div class="selection-card{% if item.seo|lower == site.lang|lower %} active{% endif %}" data-action="select-wizard-lang" data-lang="{{ item.seo|lower }}">
                    <div class="selection-icon">{{ item.seo|upper }}</div>
                    <div class="selection-label">{{ item.name }}</div>
                    <i class="bi bi-check-circle-fill check-icon"></i>
                </div>
                {% endfor %}
            </div>
        </div>


        <!-- Step 2: Category -->
        <div class="wizard-step" id="wizardStep2">
            <h2 class="step-headline">{{ wizard_lang.wizard.step.category }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.subtitle.category }}</p>

            <div class="m3-input-wrapper">
                <div class="m3-fake-select" data-action="toggle-wizard-category-sheet">
                    <span id="wizardSelectedCategory">{{ wizard_lang.wizard.label.category_select }}</span>
                    <i class="bi bi-chevron-down"></i>
                </div>
            </div>
        </div>

        <!-- Step 3: Title -->
        <div class="wizard-step" id="wizardStep3">
            <h2 class="step-headline">{{ wizard_lang.wizard.step.title }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.subtitle.title }}</p>

            <div class="input-wrapper-lg">
                <input type="text" class="m3-input-lg" name="name" id="wizardTitleInput" placeholder=" " autocomplete="off" maxlength="70">
                <label class="m3-floating-label">{{ attribute(wizard_lang.wizard.label, wizard_title_key) }}</label>
            </div>
            <div class="char-counter" id="titleCharCounter">0 / 70</div>
            <div class="validation-msg" id="titleValidationMsg">{{ wizard_lang.validator.title_length }}</div>
        </div>

        <!-- Step 4: Date -->
        <div class="wizard-step" id="wizardStep4">
            <h2 class="step-headline">{{ wizard_lang.wizard.step.date }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.subtitle.date }}</p>

            <div class="input-wrapper-lg">
                <input type="datetime-local" class="m3-input-lg" name="created_at" id="wizardDateInput" value="{{ 'now'|date('Y-m-d') }}T{{ 'now'|date('H:i') }}">
            </div>
        </div>

        <!-- Step 5: Intro (Deck) -->
        <div class="wizard-step" id="wizardStep5">
            <h2 class="step-headline">{{ wizard_lang.wizard.step.intro }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.subtitle.intro }}</p>

            <div class="input-wrapper-lg">
                <textarea class="m3-input-lg" name="summary" id="wizardIntroInput" rows="5" placeholder=" " minlength="90" maxlength="120" required></textarea>
                <label class="m3-floating-label">{{ wizard_lang.wizard.label.intro_text }}</label>
            </div>
            <div class="char-counter" id="introCharCounter">0 / 120</div>
            <div class="validation-msg" id="introValidationMsg"><i class="bi bi-exclamation-circle-fill"></i> <span>{{ wizard_lang.validator.deck_length }}</span></div>
        </div>

        <!-- Step 6: Content -->
        <div class="wizard-step" id="wizardStep6">
            <h2 class="step-headline">{{ attribute(wizard_lang.wizard.step, wizard_body_key) }}</h2>
            <p class="step-subhead">{{ attribute(wizard_lang.wizard.subtitle, wizard_body_key) }}</p>
            
            <div class="mod-news-editor-wrap">
                <textarea name="content" id="wizardContentTextarea"></textarea>
            </div>
            {% if wizard_lang_key == 'mod_news' %}
            <div class="news-quality-meter" data-editor-id="wizardContentTextarea">
                <div class="quality-meter-header">
                    <span class="quality-meter-title">
                        <i class="bi bi-shield-check"></i>
                        <span>{{ wizard_lang.quality_meter.title }}</span>
                    </span>
                    <span class="quality-badge badge-needs-work" data-badge>{{ wizard_lang.quality_meter.status_poor }}</span>
                </div>
                <div class="quality-meter-metrics">
                    <div class="quality-metric" data-metric="chars">
                        <span class="metric-label">{{ wizard_lang.quality_meter.chars }}</span>
                        <span class="metric-value"><strong data-count="chars">0</strong> / 2,500</span>
                    </div>
                    <div class="quality-metric" data-metric="words">
                        <span class="metric-label">{{ wizard_lang.quality_meter.words }}</span>
                        <span class="metric-value"><strong data-count="words">0</strong></span>
                    </div>
                    <div class="quality-metric" data-metric="h2">
                        <span class="metric-label">{{ wizard_lang.quality_meter.subheadings }}</span>
                        <span class="metric-value"><strong data-count="h2">0</strong> / 2</span>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Step 7: Image -->
        <div class="wizard-step" id="wizardStep7">
            <h2 class="step-headline">{{ wizard_lang.wizard.step.image }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.subtitle.image }}</p>
            {% set wizard_img_lang = wizard_lang.wizard.image is defined and wizard_lang.wizard.image ? wizard_lang.wizard.image : {} %}
            {% include 'admin/partials/image_uploader.twig' with {
                shell_id: 'wizardImageShell',
                shell_class: '',
                has_image: false,
                shell_attrs: {
                    'data-drop-title': wizard_img_lang.drop_title,
                    'data-drop-description': wizard_img_lang.drop_description,
                    'data-upload-link': wizard_img_lang.upload_link,
                    'data-link-separator': wizard_img_lang.link_separator,
                    'data-link-placeholder': wizard_img_lang.link_placeholder,
                    'data-link-action': wizard_img_lang.link_action,
                    'data-hint-loading': wizard_img_lang.hint_loading,
                    'data-hint-invalid-type': wizard_img_lang.hint_invalid_type,
                    'data-hint-no-drop-data': wizard_img_lang.hint_no_drop_data,
                    'data-hint-remote-failed': wizard_img_lang.hint_remote_failed,
                    'data-empty-name': wizard_lang.wizard.summary.selected_none,
                    'data-empty-meta': wizard_img_lang.drop_description
                },
                dropzone_id: 'wizardImageDropzone',
                empty_state_id: 'wizardImageEmptyState',
                drop_title: wizard_img_lang.drop_title,
                upload_link: wizard_img_lang.upload_link,
                preview_card_id: 'wizardImagePreviewCard',
                remove_btn_id: 'wizardImageRemoveBtn',
                preview_img_id: 'wizardImgPreview',
                preview_alt: wizard_lang.wizard.step.image,
                preview_hidden: true,
                meta_hidden: false,
                file_name_id: 'wizardImageFileName',
                file_name_text: wizard_lang.wizard.summary.selected_none,
                file_details_id: 'wizardImageFileDetails',
                file_details_text: wizard_img_lang.drop_description,
                divider_hidden: false,
                link_separator: wizard_img_lang.link_separator,
                url_row_hidden: false,
                url_input_id: 'wizardImageUrlInput',
                link_placeholder: wizard_img_lang.link_placeholder,
                import_btn_id: 'wizardImageUrlImportBtn',
                link_action: wizard_img_lang.link_action,
                file_input_id: 'wizardImgInput'
            } %}
            {% if wizard_lang_key == 'mod_news' %}
            <div class="form-row mt-3">
                <div class="m3-input-wrapper">
                    <input type="text" class="m3-input-lg" name="image_alt" id="wizardImageAltInput" placeholder=" " autocomplete="off" maxlength="255">
                    <label class="m3-floating-label">{{ wizard_lang.admin.columns.image_alt }}</label>
                </div>
            </div>
            <div class="form-row">
                <div class="m3-input-wrapper">
                    <input type="text" class="m3-input-lg" name="image_credit" id="wizardImageCreditInput" placeholder=" " autocomplete="off" maxlength="255">
                    <label class="m3-floating-label">{{ wizard_lang.admin.columns.image_credit }}</label>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Step 8: Publish -->
        <div class="wizard-step" id="wizardStep8">
            <h2 class="step-headline">{{ wizard_lang.wizard.step.finish }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.subtitle.finish }}</p>

            <input type="hidden" name="status" value="y" id="wizardPublishHidden">
            <input type="hidden" name="show_on_homepage" value="y" id="wizardHomepageHidden">
            
            <div class="selection-grid">
                <div class="selection-card active" data-action="select-wizard-publish-status" data-status="y">
                    <i class="bi bi-cloud-check selection-icon"></i>
                    <div class="selection-label">{{ wizard_lang.context_menu.publish }}</div>
                    <i class="bi bi-check-circle-fill check-icon"></i>
                </div>
                <div class="selection-card" data-action="select-wizard-publish-status" data-status="n">
                    <i class="bi bi-pencil-square selection-icon"></i>
                    <div class="selection-label">{{ wizard_lang.context_menu.unpublish }}</div>
                    <i class="bi bi-check-circle-fill check-icon"></i>
                </div>
            </div>

            {% if wizard_lang_key == 'mod_news' %}
            <div class="form-row mt-3">
                <label class="field-section-label">{{ wizard_lang.admin.columns.show_on_homepage }}</label>
                <div class="selection-grid">
                    <div class="selection-card active" data-action="select-wizard-homepage-status" data-homepage="y">
                        <i class="bi bi-eye-fill selection-icon"></i>
                        <div class="selection-label">{{ wizard_lang.admin.radio.show_on_homepage_yes }}</div>
                        <i class="bi bi-check-circle-fill check-icon"></i>
                    </div>
                    <div class="selection-card" data-action="select-wizard-homepage-status" data-homepage="n">
                        <i class="bi bi-eye-slash selection-icon"></i>
                        <div class="selection-label">{{ wizard_lang.admin.radio.show_on_homepage_no }}</div>
                        <i class="bi bi-check-circle-fill check-icon"></i>
                    </div>
                </div>
            </div>

            {% if social_accounts is defined and social_accounts is not empty %}
            <div class="form-row mt-3">
                <label class="field-section-label">{{ wizard_lang.social.share_channels_title }}</label>
                <div class="selection-grid social-channels-grid">
                    {% for account in social_accounts %}
                    <div class="selection-card{% if account.auto_share_default == 'y' %} active{% endif %}" data-action="toggle-social-channel" data-account-id="{{ account.id }}">
                        <input type="checkbox" name="social_channels[]" value="{{ account.id }}" class="visually-hidden social-channel-checkbox"{% if account.auto_share_default == 'y' %} checked{% endif %}>
                        {% if account.platform == 'x' %}
                            <i class="bi bi-twitter-x selection-icon"></i>
                        {% elseif account.platform == 'facebook' %}
                            <i class="bi bi-facebook selection-icon"></i>
                        {% elseif account.platform == 'instagram_story' %}
                            <i class="bi bi-instagram selection-icon"></i>
                        {% else %}
                            <i class="bi bi-share selection-icon"></i>
                        {% endif %}
                        <div class="selection-label">{{ account.account_label }}</div>
                        <i class="bi bi-check-circle-fill check-icon"></i>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
            {% endif %}

            <div class="wizard-summary">
                <h3>{{ wizard_lang.wizard.summary.title }}</h3>
                <div class="summary-item">
                    <i class="bi bi-translate"></i> <span id="summaryLang">{{ site.lang|upper }}</span>
                </div>
                <div class="summary-item">
                    <i class="bi bi-folder"></i> <span id="summaryCategory">{{ wizard_lang.wizard.summary.selected_none }}</span>
                </div>
            </div>
        </div>

    </div>

    <!-- Wizard Footer -->
    <div class="wizard-footer">
        <button type="button" class="m3-btn-outlined" id="btnWizardPrev" data-action="prev-wizard-step" disabled>{{ wizard_lang.wizard.button.prev }}</button>
        <button type="button" class="m3-btn-filled" id="btnWizardNext" data-action="next-wizard-step">{{ wizard_lang.wizard.button.next }}</button>
        <button type="button" class="m3-btn-filled success" id="btnWizardFinish" hidden>{{ wizard_lang.wizard.button.finish }}</button>
    </div>
</div>
</form>
