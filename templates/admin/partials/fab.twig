<!-- SPEED DIAL FAB -->
{% if not hide_fab %}
<div class="fab-container" id="fabContainer">
    <div class="fab-overlay" id="fabOverlay"></div>
    <div class="fab-actions">
        {% if shared_admin_modules is defined and shared_admin_modules.mod_news %}
        <a href="{{ site.saddress }}mod_news/add" class="fab-mini fab-row-news" title="{{ lang.mod_user.fab.add_news }}" data-action="news-add">
            <span class="fab-label">{{ lang.mod_user.fab.add_news }}</span>
            <i class="bi bi-newspaper main-icon"></i>
            <div class="add-badge"><i class="bi bi-plus"></i></div>
        </a>
        {% endif %}
        {% if shared_admin_modules is defined and shared_admin_modules.mod_page %}
        <a href="{{ site.saddress }}mod_page/add" class="fab-mini fab-row-page" title="{{ lang.mod_user.fab.add_page }}" data-action="page-add">
            <span class="fab-label">{{ lang.mod_user.fab.add_page }}</span>
            <i class="bi bi-file-earmark-richtext-fill main-icon"></i>
            <div class="add-badge"><i class="bi bi-plus"></i></div>
        </a>
        {% endif %}
        {% if shared_admin_modules is defined and shared_admin_modules.mod_publication %}
        <a href="{{ site.saddress }}mod_publication/add" class="fab-mini fab-row-publication" title="{{ lang.mod_user.fab.add_publication }}" data-action="publication-add">
            <span class="fab-label">{{ lang.mod_user.fab.add_publication }}</span>
            <i class="bi bi-journal-richtext main-icon"></i>
            <div class="add-badge"><i class="bi bi-plus"></i></div>
        </a>
        {% endif %}
        {% if shared_admin_modules is defined and shared_admin_modules.mod_video_embed %}
        <a href="{{ site.saddress }}mod_video_embed/add" class="fab-mini fab-row-video" title="{{ lang.mod_user.fab.add_video }}" data-action="video-embed-add">
            <span class="fab-label">{{ lang.mod_user.fab.add_video }}</span>
            <i class="bi bi-camera-reels-fill main-icon"></i>
            <div class="add-badge"><i class="bi bi-plus"></i></div>
        </a>
        {% endif %}
        <a href="{{ site.saddress }}mod_announcements/add" class="fab-mini fab-row-announcement" title="{{ lang.mod_user.fab.add_announcement }}" data-action="announcement-add">
            <span class="fab-label">{{ lang.mod_user.fab.add_announcement }}</span>
            <i class="bi bi-megaphone-fill main-icon"></i>
            <div class="add-badge"><i class="bi bi-plus"></i></div>
        </a>
    </div>
    <div class="fab-large" id="fabLarge" role="button" tabindex="0" aria-label="{{ lang.mod_user.panel.admin_brand }}">
        <i class="bi bi-plus-lg" id="fabIcon"></i>
    </div>
</div>
{% endif %}
