<!-- SPEED DIAL FAB -->
{% if not hide_fab %}
<div class="fab-container" id="fabContainer">
    <div class="fab-overlay" id="fabOverlay" onclick="toggleFabMenu()"></div>
    <div class="fab-actions">
        <button class="fab-mini" onclick="window.location.href='{{ site.sadres }}mod_content/add'" title="{{ lang.mod_user.fab.add_content }}" data-action="content-add">
            <span class="fab-label">{{ lang.mod_user.fab.add_content }}</span>
            <i class="bi bi-file-text-fill main-icon"></i>
            <div class="add-badge"><i class="bi bi-plus"></i></div>
        </button>
        <button class="fab-mini" onclick="window.location.href='{{ site.sadres }}mod_publication/add'" title="{{ lang.mod_user.fab.add_publication }}" data-action="publication-add">
            <span class="fab-label">{{ lang.mod_user.fab.add_publication }}</span>
            <i class="bi bi-journal-richtext main-icon"></i>
            <div class="add-badge"><i class="bi bi-plus"></i></div>
        </button>
        <button class="fab-mini" onclick="window.location.href='{{ site.sadres }}mod_video_embed/ekle'" title="{{ lang.mod_user.fab.add_video }}" data-action="video-embed-add">
            <span class="fab-label">{{ lang.mod_user.fab.add_video }}</span>
            <i class="bi bi-camera-reels-fill main-icon"></i>
            <div class="add-badge"><i class="bi bi-plus"></i></div>
        </button>
        <button class="fab-mini" onclick="window.location.href='{{ site.sadres }}mod_announcements/ekle'" title="{{ lang.mod_user.fab.add_announcement }}">
            <span class="fab-label">{{ lang.mod_user.fab.add_announcement }}</span>
            <i class="bi bi-megaphone-fill main-icon"></i>
            <div class="add-badge"><i class="bi bi-plus"></i></div>
        </button>
    </div>
    <div class="fab-large" onclick="toggleFabMenu()">
        <i class="bi bi-plus-lg" id="fabIcon"></i>
    </div>
</div>
{% endif %}
