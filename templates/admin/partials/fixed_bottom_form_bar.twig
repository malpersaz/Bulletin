<div class="standard-toolbar">
    <!-- Go to List -->
    <a href="{{ cancel_url }}" class="toolbar-item" title="{{ cancel_label }}" aria-label="{{ cancel_label }}">
        <i class="bi bi-chevron-left"></i>
    </a>

    <!-- Symmetrical Center Menu Button (Purple Circle) -->
    <button type="button" class="toolbar-start-btn" onclick="if(typeof toggleDrawer==='function')toggleDrawer();" title="{{ lang.management.start_menu }}" aria-label="{{ lang.management.start_menu }}">
        <i class="bi bi-list"></i>
    </button>

    <!-- Submit Form -->
    <button type="submit" form="{{ form_id }}" class="toolbar-item" title="{{ submit_label }}" aria-label="{{ submit_label }}">
        <i class="bi bi-check-lg"></i>
    </button>
</div>
