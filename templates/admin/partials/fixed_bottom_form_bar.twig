<div class="m3-final-bar">
    <a
        href="{{ cancel_url }}"
        class="m3-btn-half m3-btn-half-neutral"
        data-skip-unsaved-warning="true">
        <i class="bi bi-x-lg"></i>
        {{ cancel_label }}
    </a>
    <button
        type="submit"
        form="{{ form_id }}"
        class="m3-btn-half m3-btn-half-primary">
        <i class="bi bi-check-lg"></i>
        {{ submit_label }}
    </button>
</div>
