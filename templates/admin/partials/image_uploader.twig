<div
    class="wizard-image-shell {{ shell_class is defined ? shell_class : '' }}{% if has_image is defined and has_image %} has-image{% endif %}"
    id="{{ shell_id }}"
    {% for key, value in shell_attrs is defined ? shell_attrs : {} %}
        {% if value is not null and value is not same as('') %}
            {{ key }}="{{ value }}"
        {% endif %}
    {% endfor %}
>
    <div class="image-upload-area wizard-image-dropzone" id="{{ dropzone_id }}" tabindex="0" role="button" data-action="trigger-image-picker">
        <div class="wizard-image-empty" id="{{ empty_state_id }}"{% if empty_hidden is defined and empty_hidden %} hidden{% endif %}>
            <div class="wizard-image-empty-icon">
                <i class="bi bi-cloud-arrow-up-fill"></i>
            </div>
            <div class="wizard-image-empty-copy">
                <span class="wizard-image-empty-title">{{ upload_link is defined and upload_link ? upload_link : (lang.mod_gallery.admin.add_images is defined ? lang.mod_gallery.admin.add_images : (lang.mod_news.wizard.image.upload_link is defined ? lang.mod_news.wizard.image.upload_link : 'Upload Image')) }}</span>
                <span class="wizard-image-empty-hint">{{ drop_description is defined and drop_description ? drop_description : (drop_title is defined and drop_title ? drop_title : 'Upload, paste, or move') }}</span>
            </div>
        </div>

        <div class="wizard-image-preview-card" id="{{ preview_card_id }}"{% if preview_hidden is not defined or preview_hidden %} hidden{% endif %}>
            <div class="wizard-image-preview-frame">
                <button
                    type="button"
                    class="wizard-image-remove-btn"
                    {% if remove_btn_id is defined and remove_btn_id %} id="{{ remove_btn_id }}"{% endif %}
                    aria-label="{{ remove_button_label is defined ? remove_button_label : '' }}"
                    title="{{ remove_button_label is defined ? remove_button_label : '' }}"
                    data-action="remove-uploader-image"
                >
                    <i class="bi bi-trash-fill"></i>
                </button>
                <img id="{{ preview_img_id }}" class="wizard-img-preview" alt="{{ preview_alt is defined ? preview_alt : '' }}"{% if preview_hidden is not defined or preview_hidden %} hidden{% endif %}{% if preview_src is defined and preview_src %} src="{{ preview_src }}"{% endif %}>
            </div>
            <div class="wizard-image-meta"{% if meta_id is defined and meta_id %} id="{{ meta_id }}"{% endif %}{% if meta_hidden is defined and meta_hidden %} hidden{% endif %}>
                <strong id="{{ file_name_id }}">{{ file_name_text }}</strong>
                <p id="{{ file_details_id }}">{{ file_details_text }}</p>
            </div>
        </div>
    </div>

    <div class="wizard-image-divider" aria-hidden="true"{% if divider_hidden is defined and divider_hidden %} hidden{% endif %}>
        <span>{{ link_separator }}</span>
    </div>

    <div class="wizard-image-url-row"{% if url_row_hidden is defined and url_row_hidden %} hidden{% endif %}>
        <input
            type="url"
            id="{{ url_input_id }}"
            class="wizard-image-url-input"
            placeholder="{{ link_placeholder }}"
            inputmode="url"
            autocomplete="off"
            spellcheck="false"
        >
        <button type="button" class="m3-btn-filled wizard-image-url-btn" id="{{ import_btn_id }}">
            <span>{{ link_action }}</span>
        </button>
    </div>

    <input
        type="file"
        name="{{ input_name is defined ? input_name : 'image' }}"
        id="{{ file_input_id }}"
        hidden
        accept="image/*"
        data-action="uploader-file-input"
    >
</div>
