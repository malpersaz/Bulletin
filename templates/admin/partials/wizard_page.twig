{% macro select_nested_parent_id_function(select_nested_parent_id_result, parent_id, level, selected_id = 0) %}
    {% if select_nested_parent_id_result[parent_id] is defined %}
        {% for entry in select_nested_parent_id_result[parent_id] %}
            {% set parent_id_loop = entry.id %}
            {% set skip_root = entry.root is defined and entry.root == 'y' %}
            {% if not skip_root %}
                <option value="{{ entry.id }}" {% if selected_id == entry.id %}selected{% endif %}>
                    {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.name }}{% if entry.lang is defined %} ({{ entry.lang|upper }}){% endif %}
                </option>
            {% endif %}
            {% if select_nested_parent_id_result[parent_id_loop] is defined and select_nested_parent_id_result[parent_id_loop] is iterable %}
                {{ _self.select_nested_parent_id_function(select_nested_parent_id_result, parent_id_loop, level + (skip_root ? 0 : 1), selected_id) }}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% macro select_nested_category_id_function(select_nested_category_id_result, parent_id, level, selected_id = 0) %}
    {% if select_nested_category_id_result[parent_id] is defined %}
        {% for entry in select_nested_category_id_result[parent_id] %}
            {% set parent_id_loop = entry.id %}
            {% set skip_root = (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#') %}
            {% if not skip_root %}
                <option
                    value="{{ entry.id }}"
                    {% if entry.lang is defined %}data-lang="{{ entry.lang|upper }}"{% endif %}
                    data-trigger-label="{{ entry.name|e('html_attr') }}"
                    {% if selected_id == entry.id %}selected{% endif %}
                >
                    {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.name }}{% if entry.lang is defined %} ({{ entry.lang|upper }}){% endif %}
                </option>
            {% endif %}
            {% if select_nested_category_id_result[parent_id_loop] is defined and select_nested_category_id_result[parent_id_loop] is iterable %}
                {{ _self.select_nested_category_id_function(select_nested_category_id_result, parent_id_loop, level + (skip_root ? 0 : 1), selected_id) }}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% macro select_nested_menu_function(select_nested_menu_result, parent_id, level, selected_id = 0) %}
    {% if select_nested_menu_result[parent_id] is defined %}
        {% for entry in select_nested_menu_result[parent_id] %}
            {% set parent_id_loop = entry.id %}
            {% set skip_root = entry.root is defined and entry.root == 'y' %}
            {% if not skip_root %}
                <option value="{{ entry.id }}" {% if selected_id == entry.id %}selected{% endif %}>
                    {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.name }}{% if entry.lang is defined %} ({{ entry.lang|upper }}){% endif %}
                </option>
            {% endif %}
            {% if select_nested_menu_result[parent_id_loop] is defined and select_nested_menu_result[parent_id_loop] is iterable %}
                {{ _self.select_nested_menu_function(select_nested_menu_result, parent_id_loop, level + (skip_root ? 0 : 1), selected_id) }}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

<form id="pageWizardForm" method="POST" action="{{ site.saddress }}mod_page/add" enctype="multipart/form-data">
<div id="pageWizard" class="wizard-overlay">
    <header class="wizard-header">
        <button type="button" class="icon-btn" onclick="closePageWizard()"><i class="bi bi-x-lg"></i></button>
        <div class="wizard-title">
            <span id="pageWizardStepTitle">{{ lang.mod_page.wizard.steps.language }}</span>
            <span id="pageWizardStepCounter">1/8</span>
        </div>
        <button type="button" class="m3-btn-text" onclick="submitPageWizard()">{{ lang.mod_page.button.add }}</button>
    </header>

    <div class="wizard-progress-bar">
        <div class="wizard-progress-fill" id="pageWizardProgressFill" style="width: 12.5%;"></div>
    </div>

    <div class="wizard-content">
        <input type="hidden" name="add" value="{{ lang.mod_page.button.add }}">
        <input type="hidden" name="wizard_step" id="pageWizardStepInput" value="{{ wizard_step is defined ? wizard_step : 1 }}">

        <div class="wizard-step active" id="pageWizardStep1">
            <h2 class="step-headline">{{ lang.mod_page.admin.columns.language }}</h2>
            <p class="step-subhead">{{ lang.mod_page.wizard.descriptions.language }}</p>
            <input type="hidden" name="lang" id="pageWizardHiddenLang" value="{{ (selected_lang is defined ? selected_lang : site.lang)|lower }}">
            <div class="selection-grid">
                {% for item in lang_lang %}
                    <div class="selection-card{% if (selected_lang is defined ? selected_lang : site.lang)|lower == item.seo|lower %} active{% endif %}" data-value="{{ item.seo|lower }}" onclick="selectPageWizardLang(this, '{{ item.seo|lower }}')">
                        <div class="selection-icon">{{ item.seo|upper }}</div>
                        <div class="selection-label">{{ item.name }}</div>
                        <i class="bi bi-check-circle-fill check-icon"></i>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="wizard-step" id="pageWizardStep2">
            <h2 class="step-headline">{{ lang.mod_page.wizard.steps.structure }}</h2>
            <p class="step-subhead">{{ lang.mod_page.wizard.descriptions.structure }}</p>

            <div class="input-wrapper-lg">
                <select class="m3-input-lg" name="parent_id" id="pageWizardParentId">
                    <option value="0">{{ lang.mod_page.choose_wish }}</option>
                    {{ _self.select_nested_parent_id_function(select_nested_parent_id_result, 0, 0, parent_id is defined ? parent_id : 0) }}
                </select>
                <label class="m3-floating-label">{{ lang.mod_page.admin.columns.parent_id }}</label>
            </div>

            <div class="input-wrapper-lg">
                <label class="filter-group-label mod-page-section-label strong">{{ lang.mod_page.admin.columns.category_id }}</label>
                <select
                    class="m3-input-lg select-picker-native"
                    name="category_id"
                    id="pageWizardCategoryId"
                    data-picker-sheet="category"
                    data-picker-title="{{ lang.mod_page.admin.columns.category_id }}"
                    data-picker-placeholder="{{ lang.mod_page.choose_wish }}"
                    data-picker-lang-source="pageWizardHiddenLang"
                >
                    <option value="0">{{ lang.mod_page.choose_wish }}</option>
                    {{ _self.select_nested_category_id_function(select_nested_category_id_result, 0, 0, category_id is defined ? category_id : 0) }}
                </select>
                <div class="m3-fake-select select-picker-trigger" data-picker-trigger-for="pageWizardCategoryId">
                    <span class="select-picker-label">{{ lang.mod_page.choose_wish }}</span>
                    <i class="bi bi-chevron-down"></i>
                </div>
            </div>

            <div class="input-wrapper-lg">
                <select class="m3-input-lg" name="menu" id="pageWizardMenuId">
                    <option value="__none__" {% if menu_binding_value is defined and menu_binding_value == '__none__' %}selected{% endif %}>{{ lang.mod_page.menu_options.none }}</option>
                    <option value="__top__" {% if menu_binding_value is defined and menu_binding_value == '__top__' %}selected{% endif %}>{{ lang.mod_page.menu_options.top_level }}</option>
                    {{ _self.select_nested_menu_function(select_nested_menu_result, 0, 0, menu_binding_value is defined ? menu_binding_value : (menu is defined ? menu : '__none__')) }}
                </select>
                <label class="m3-floating-label">{{ lang.mod_page.admin.columns.menu }}</label>
            </div>
        </div>

        <div class="wizard-step" id="pageWizardStep3">
            <h2 class="step-headline">{{ lang.mod_page.wizard.steps.title }}</h2>
            <p class="step-subhead">{{ lang.mod_page.wizard.descriptions.title }}</p>

            <div class="input-wrapper-lg">
                <input type="text" class="m3-input-lg" name="name" id="pageWizardNameInput" value="{{ name is defined ? name : '' }}" placeholder=" " autocomplete="off" maxlength="255">
                <label class="m3-floating-label">{{ lang.mod_page.admin.columns.name }}</label>
            </div>
            <div class="char-counter" id="pageWizardNameCounter">0 / 255</div>
        </div>

        <div class="wizard-step" id="pageWizardStep4">
            <h2 class="step-headline">{{ lang.mod_page.wizard.steps.summary }}</h2>
            <p class="step-subhead">{{ lang.mod_page.wizard.descriptions.summary }}</p>

            <div class="input-wrapper-lg">
                <textarea class="m3-input-lg" name="summary" id="pageWizardSummaryInput" rows="5" placeholder=" " minlength="90" maxlength="120" data-counter-target="pageWizardSummaryCounter" data-counter-min="90" data-counter-max="120" required>{{ summary is defined ? summary : '' }}</textarea>
                <label class="m3-floating-label">{{ lang.mod_page.admin.columns.summary }}</label>
            </div>
            <div class="char-counter" id="pageWizardSummaryCounter">{{ (summary is defined ? summary : '')|length }} / 120</div>
        </div>

        <div class="wizard-step" id="pageWizardStep5">
            <h2 class="step-headline">{{ lang.mod_page.wizard.steps.content }}</h2>
            <p class="step-subhead">{{ lang.mod_page.wizard.descriptions.content }}</p>

            <div class="mod-page-wizard-editor-wrap">
                <textarea name="content" id="pageWizardContentTextarea">{{ content is defined ? content : '' }}</textarea>
            </div>
        </div>

        <div class="wizard-step" id="pageWizardStep6">
            <h2 class="step-headline">{{ lang.mod_page.wizard.steps.display }}</h2>
            <p class="step-subhead">{{ lang.mod_page.wizard.descriptions.display }}</p>

            <input type="hidden" name="root" value="{{ root is defined ? root : 'n' }}" id="pageWizardRootSelect">
            <label class="filter-group-label mod-page-section-label strong">{{ lang.mod_page.admin.columns.root }}</label>
            <div class="selection-grid" id="pageWizardRootGrid">
                <div class="selection-card{% if root is defined and root == 'y' %} active{% endif %}" data-value="y" onclick="selectPageWizardRoot(this, 'y')">
                    <i class="bi bi-house-door selection-icon mod-page-wizard-icon-lg"></i>
                    <div class="selection-label">{{ lang.mod_page.admin.select_value.root_e }}</div>
                    <i class="bi bi-check-circle-fill check-icon"></i>
                </div>
                <div class="selection-card{% if root is not defined or root == 'n' %} active{% endif %}" data-value="n" onclick="selectPageWizardRoot(this, 'n')">
                    <i class="bi bi-file-earmark selection-icon mod-page-wizard-icon-lg"></i>
                    <div class="selection-label">{{ lang.mod_page.admin.select_value.root_h }}</div>
                    <i class="bi bi-check-circle-fill check-icon"></i>
                </div>
            </div>

            <input type="hidden" name="deck" value="{{ deck is defined ? deck : 'n' }}" id="pageWizardDeckSelect">
            <label class="filter-group-label mod-page-section-label strong">{{ lang.mod_page.admin.columns.deck }}</label>
            <div class="selection-grid" id="pageWizardDeckGrid">
                <div class="selection-card{% if deck is defined and deck == 'y' %} active{% endif %}" data-value="y" onclick="selectPageWizardDeck(this, 'y')">
                    <i class="bi bi-text-paragraph selection-icon mod-page-wizard-icon-lg"></i>
                    <div class="selection-label">{{ lang.mod_page.admin.radio.deck_yes }}</div>
                    <i class="bi bi-check-circle-fill check-icon"></i>
                </div>
                <div class="selection-card{% if deck is not defined or deck == 'n' %} active{% endif %}" data-value="n" onclick="selectPageWizardDeck(this, 'n')">
                    <i class="bi bi-dash-circle selection-icon mod-page-wizard-icon-lg"></i>
                    <div class="selection-label">{{ lang.mod_page.admin.radio.deck_no }}</div>
                    <i class="bi bi-check-circle-fill check-icon"></i>
                </div>
            </div>
        </div>

        <div class="wizard-step" id="pageWizardStep7">
            <h2 class="step-headline">{{ lang.mod_page.wizard.steps.relations }}</h2>
            <p class="step-subhead">{{ lang.mod_page.wizard.descriptions.relations }}</p>

            <div class="input-wrapper-lg">
                <select class="m3-input-lg" name="gallery_id" id="pageWizardGalleryId">
                    <option value="0">{{ lang.mod_page.choose_wish }}</option>
                    {% for item in mod_page_gallery_id %}
                        <option value="{{ item.id }}" {% if gallery_id is defined and gallery_id == item.id %}selected{% endif %}>{{ item.name }}{% if item.lang is defined %} ({{ item.lang|upper }}){% endif %}</option>
                    {% endfor %}
                </select>
                <label class="m3-floating-label">{{ lang.mod_page.admin.columns.gallery_id|raw }}</label>
            </div>

            <div class="input-wrapper-lg">
                <select class="m3-input-lg" name="file_id" id="pageWizardFileId">
                    <option value="0">{{ lang.mod_page.choose_wish }}</option>
                    {% for item in mod_page_file_id %}
                        <option value="{{ item.id }}" {% if file_id is defined and file_id == item.id %}selected{% endif %}>{{ item.name }}{% if item.lang is defined %} ({{ item.lang|upper }}){% endif %}</option>
                    {% endfor %}
                </select>
                <label class="m3-floating-label">{{ lang.mod_page.admin.columns.file_id|raw }}</label>
            </div>

            <div class="input-wrapper-lg">
                <select class="m3-input-lg" name="acl_id" id="pageWizardAclId">
                    <option value="0">-- {{ lang.mod_page.choose_wish }} --</option>
                    {% for item in mod_acl_acl_id %}
                        <option value="{{ item.id }}" {% if acl_id is defined and acl_id == item.id %}selected{% endif %}>{{ item.name }}{% if item.lang is defined %} ({{ item.lang|upper }}){% endif %}</option>
                    {% endfor %}
                </select>
                <label class="m3-floating-label">{{ lang.mod_page.admin.columns.acl_id|raw }}</label>
            </div>

            <img id="pageWizardImgPreview" class="wizard-img-preview mod-page-wizard-preview-hidden" alt="">
            <div class="image-upload-area interactive" onclick="document.getElementById('pageWizardImgInput').click()">
                <i class="bi bi-cloud-arrow-up-fill upload-icon"></i>
                <p>{{ lang.mod_page.button.upload }}</p>
                <input type="file" name="image" id="pageWizardImgInput" hidden onchange="previewPageWizardImage(this)">
            </div>
        </div>

        <div class="wizard-step" id="pageWizardStep8">
            <h2 class="step-headline">{{ lang.mod_page.wizard.steps.seo_finish }}</h2>
            <p class="step-subhead">{{ lang.mod_page.wizard.descriptions.seo_finish }}</p>

            <input type="hidden" name="status" value="{{ status is defined ? status : 'y' }}" id="pageWizardStatusHidden">

            <div class="input-wrapper-lg">
                <input type="text" class="m3-input-lg" name="seo" id="pageWizardSeoInput" value="{{ seo is defined ? seo : '' }}" placeholder=" ">
                <label class="m3-floating-label">{{ lang.mod_page.admin.columns.seo }}</label>
            </div>

            <div class="input-wrapper-lg">
                <input type="text" class="m3-input-lg" name="title" id="pageWizardTitleInput" value="{{ title is defined ? title : '' }}" placeholder=" ">
                <label class="m3-floating-label">{{ lang.mod_page.admin.columns.title }}</label>
            </div>

            <div class="input-wrapper-lg">
                <input type="text" class="m3-input-lg" name="keywords" id="pageWizardKeywordsInput" value="{{ keywords is defined ? keywords : '' }}" placeholder=" ">
                <label class="m3-floating-label">{{ lang.mod_page.admin.columns.keywords }}</label>
            </div>

            <div class="input-wrapper-lg">
                <input type="text" class="m3-input-lg" name="description" id="pageWizardDescriptionInput" value="{{ description is defined ? description : '' }}" placeholder=" ">
                <label class="m3-floating-label">{{ lang.mod_page.admin.columns.description }}</label>
            </div>

            <div class="wizard-summary">
                <h3>{{ lang.mod_page.wizard.page_summary }}</h3>
                <div class="summary-item">
                    <i class="bi bi-translate"></i> <span id="pageWizardSummaryLang">{{ (selected_lang is defined ? selected_lang : site.lang)|upper }}</span>
                </div>
                <div class="summary-item">
                    <i class="bi bi-file-earmark-text"></i> <span id="pageWizardSummaryName">{{ name is defined ? name : lang.mod_page.choose_wish }}</span>
                </div>
                <div class="summary-item">
                    <i class="bi bi-folder"></i> <span id="pageWizardSummaryCategory">{{ lang.mod_page.choose_wish }}</span>
                </div>
                <div class="summary-item">
                    <i class="bi bi-menu-button-wide"></i> <span id="pageWizardSummaryMenu">{{ lang.mod_page.choose_wish }}</span>
                </div>
            </div>

            <div class="selection-grid" id="pageWizardStatusGrid">
                <div class="selection-card{% if status is not defined or status == 'y' %} active{% endif %}" data-value="y" onclick="selectPageWizardStatus(this, 'y')">
                    <i class="bi bi-cloud-check selection-icon mod-page-wizard-icon-lg"></i>
                    <div class="selection-label">{{ lang.mod_page.admin.radio.publish_yes }}</div>
                    <i class="bi bi-check-circle-fill check-icon"></i>
                </div>
                <div class="selection-card{% if status is defined and status == 'n' %} active{% endif %}" data-value="n" onclick="selectPageWizardStatus(this, 'n')">
                    <i class="bi bi-pencil-square selection-icon mod-page-wizard-icon-lg"></i>
                    <div class="selection-label">{{ lang.mod_page.admin.radio.publish_no }}</div>
                    <i class="bi bi-check-circle-fill check-icon"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="wizard-footer">
        <button type="button" class="m3-btn-outlined" id="btnPageWizardPrev" onclick="prevPageWizardStep(); return false;" disabled>{{ lang.mod_page.wizard.previous }}</button>
        <button type="button" class="m3-btn-filled" id="btnPageWizardNext" onclick="nextPageWizardStep(); return false;">{{ lang.mod_page.wizard.next }}</button>
        <button type="button" class="m3-btn-filled success" id="btnPageWizardFinish" onclick="submitPageWizard(); return false;" style="display:none;">{{ lang.mod_page.button.add }}</button>
    </div>
</div>
</form>
