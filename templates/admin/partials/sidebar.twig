<div class="drawer-scrim" id="drawerScrim"></div>

{% set content_active = mod == 'mod_news_category' or mod == 'mod_news' or mod == 'mod_publication' or mod == 'mod_publication_category' or mod == 'mod_menu' or mod == 'mod_page' or mod == 'mod_document' or mod == 'mod_survey' %}
{% set media_active = mod == 'mod_video' or mod == 'mod_video_embed' or mod == 'mod_video_embed_category' or mod == 'mod_slider' or mod == 'mod_headline' or mod == 'mod_imagecategories' or mod == 'mod_gallery_mod' or mod == 'mod_attachment_mod' %}
{% set announcements_active = mod == 'mod_announcements' or mod == 'mod_popup' or mod == 'mod_newsletter' %}
{% set seo_active = mod == 'mod_seo' or mod == 'mod_redirect' %}

<aside class="nav-drawer" id="navDrawer">
    <div class="drawer-header">
        <div>
            <div class="drawer-title site-title-font">{{ site.title }}</div>
            <div class="drawer-subtitle">v{{ site.version }}{% if site.build %} ({{ site.build }}){% endif %}</div>
        </div>
        <button type="button" class="drawer-close-btn" id="drawerCloseBtn" aria-label="{{ lang.management.quick_menu }}">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <div class="drawer-content">
        <div class="drawer-search-shell">
            <i class="bi bi-search drawer-search-icon"></i>
            <input
                type="text"
                id="drawerSearchInput"
                class="drawer-search-input"
                placeholder="{{ lang.management.module_search_placeholder }}"
                autocomplete="off"
            >
        </div>
        <div class="drawer-search-results" id="drawerSearchResults" hidden></div>
        <div class="drawer-search-empty" id="drawerSearchEmpty" hidden>{{ lang.management.module_search_empty }}</div>

        <div class="drawer-root-links">
            <a href="{{ site.saddress }}mod_user/panel" class="nav-item nav-root-item {% if mod == 'mod_user' and (act is not defined or act == 'panel') %}active{% endif %}" data-nav-track="1" data-nav-id="mod_user_panel" data-nav-label="{{ lang.management.dashboard }}">
                <i class="bi bi-speedometer2 nav-item-icon"></i>
                <span class="nav-item-label">{{ lang.management.dashboard }}</span>
            </a>
            <a href="{{ site.saddress }}" target="_blank" class="nav-item nav-root-item" data-nav-track="0" data-nav-label="{{ lang.management.site_home|default(lang.management.home|default('Home')) }}">
                <i class="bi bi-house-door-fill nav-item-icon"></i>
                <span class="nav-item-label">{{ lang.management.site_home|default(lang.management.home|default('Home')) }}</span>
            </a>
        </div>

        <div class="nav-divider"></div>

        <div class="nav-group{% if content_active %} expanded{% endif %}" data-nav-group="content">
            <button type="button" class="nav-group-header" data-nav-label="{{ lang.management.content_and_page }}">
                <i class="bi bi-rocket-takeoff-fill nav-item-icon"></i>
                <span class="nav-item-label">{{ lang.management.content_and_page }}</span>
                <i class="bi bi-chevron-down group-indicator"></i>
            </button>
            <div class="nav-group-items">
                {% if session.permissions.mod_news_category.list is defined %}
                    <a href="{{ site.saddress }}mod_news_category/list" class="nav-item {% if mod == 'mod_news_category' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_news_category" data-nav-label="{{ lang.management.news_categories }}">
                        <i class="bi bi-bookmarks-fill nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.news_categories }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_publication_category.list is defined %}
                    <a href="{{ site.saddress }}mod_publication_category/list" class="nav-item {% if mod == 'mod_publication_category' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_publication_category" data-nav-label="{{ lang.management.publication_categories }}">
                        <i class="bi bi-collection-fill nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.publication_categories }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_menu.list is defined %}
                    <a href="{{ site.saddress }}mod_menu/list" class="nav-item {% if mod == 'mod_menu' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_menu" data-nav-label="{{ lang.management.menu_management }}">
                        <i class="bi bi-list nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.menu_management }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_page.list is defined %}
                    <a href="{{ site.saddress }}mod_page/list" class="nav-item {% if mod == 'mod_page' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_page" data-nav-label="{{ lang.management.page_management }}">
                        <i class="bi bi-file-richtext nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.page_management }}</span>
                    </a>
                {% endif %}

                {% if session.permissions.mod_document.list is defined %}
                    <a href="{{ site.saddress }}mod_document/list" class="nav-item {% if mod == 'mod_document' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_document" data-nav-label="{{ lang.management.file_management }}">
                        <i class="bi bi-folder-fill nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.file_management }}</span>
                    </a>
                {% endif %}

                {% if session.permissions.mod_survey.list is defined %}
                    <a href="{{ site.saddress }}mod_survey/list" class="nav-item {% if mod == 'mod_survey' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_survey" data-nav-label="{{ lang.management.survey_management }}">
                        <i class="bi bi-ui-checks-grid nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.survey_management }}</span>
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="nav-group{% if media_active %} expanded{% endif %}" data-nav-group="media">
            <button type="button" class="nav-group-header" data-nav-label="{{ lang.management.video_and_images }}">
                <i class="bi bi-camera-video-fill nav-item-icon"></i>
                <span class="nav-item-label">{{ lang.management.video_and_images }}</span>
                <i class="bi bi-chevron-down group-indicator"></i>
            </button>
            <div class="nav-group-items">
                {% if session.permissions.mod_video.list is defined %}
                    <a href="{{ site.saddress }}mod_video/list" class="nav-item {% if mod == 'mod_video' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_video" data-nav-label="{{ lang.management.videos }}">
                        <i class="bi bi-camera-reels-fill nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.videos }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_video_embed_category.list is defined %}
                    <a href="{{ site.saddress }}mod_video_embed_category/list" class="nav-item {% if mod == 'mod_video_embed_category' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_video_embed_category" data-nav-label="{{ lang.management.remote_video_category }}">
                        <i class="bi bi-collection-play-fill nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.remote_video_category }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_slider.list is defined %}
                    <a href="{{ site.saddress }}mod_slider/list" class="nav-item {% if mod == 'mod_slider' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_slider" data-nav-label="{{ lang.management.headline_management }}">
                        <i class="bi bi-card-image nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.headline_management }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_headline.list is defined %}
                    <a href="{{ site.saddress }}mod_headline/list" class="nav-item {% if mod == 'mod_headline' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_headline" data-nav-label="{{ lang.management.full_headline_management }}">
                        <i class="bi bi-layout-text-window-reverse nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.full_headline_management }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_imagecategories.list is defined %}
                    <a href="{{ site.saddress }}mod_imagecategories/list" class="nav-item {% if mod == 'mod_imagecategories' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_imagecategories" data-nav-label="{{ lang.management.image_gallery }}">
                        <i class="bi bi-image-fill nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.image_gallery }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_gallery_mod.list is defined %}
                    <a href="{{ site.saddress }}mod_gallery_mod/list" class="nav-item {% if mod == 'mod_gallery_mod' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_gallery_mod" data-nav-label="{{ lang.management.gallery_modules }}">
                        <i class="bi bi-images nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.gallery_modules }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_attachment_mod.list is defined %}
                    <a href="{{ site.saddress }}mod_attachment_mod/list" class="nav-item {% if mod == 'mod_attachment_mod' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_attachment_mod" data-nav-label="{{ lang.management.file_modules }}">
                        <i class="bi bi-paperclip nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.file_modules }}</span>
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="nav-group{% if announcements_active %} expanded{% endif %}" data-nav-group="announcements">
            <button type="button" class="nav-group-header" data-nav-label="{{ lang.management.announcement_management }}">
                <i class="bi bi-megaphone-fill nav-item-icon"></i>
                <span class="nav-item-label">{{ lang.management.announcement_management }}</span>
                <i class="bi bi-chevron-down group-indicator"></i>
            </button>
            <div class="nav-group-items">
                {% if session.permissions.mod_announcements.list is defined %}
                    <a href="{{ site.saddress }}mod_announcements/list" class="nav-item {% if mod == 'mod_announcements' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_announcements" data-nav-label="{{ lang.management.announcement_management }}">
                        <i class="bi bi-volume-up-fill nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.announcement_management }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_popup.list is defined %}
                    <a href="{{ site.saddress }}mod_popup/list" class="nav-item {% if mod == 'mod_popup' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_popup" data-nav-label="{{ lang.management.popup_announcements }}">
                        <i class="bi bi-layout-wtf nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.popup_announcements }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_newsletter.list is defined or session.user_id is defined %}
                    <a href="{{ site.saddress }}mod_newsletter/list" class="nav-item {% if mod == 'mod_newsletter' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_newsletter" data-nav-label="{{ lang.management.newsletter_management|default('Newsletter') }}">
                        <i class="bi bi-envelope-at-fill nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.newsletter_management|default('Newsletter') }}</span>
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="nav-group{% if seo_active %} expanded{% endif %}" data-nav-group="seo">
            <button type="button" class="nav-group-header" data-nav-label="{{ lang.management.seo_and_redirects }}">
                <i class="bi bi-globe nav-item-icon"></i>
                <span class="nav-item-label">{{ lang.management.seo_and_redirects }}</span>
                <i class="bi bi-chevron-down group-indicator"></i>
            </button>
            <div class="nav-group-items">
                {% if session.permissions.mod_seo.list is defined %}
                    <a href="{{ site.saddress }}seo" class="nav-item {% if mod == 'mod_seo' and (act is not defined or act == 'index') %}active{% endif %}" data-nav-track="1" data-nav-id="mod_seo_list" data-nav-label="{{ lang.mod_seo.list }}">
                        <i class="bi bi-google nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.mod_seo.list }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_seo.settings is defined %}
                    <a href="{{ site.saddress }}seo/settings" class="nav-item {% if mod == 'mod_seo' and act == 'settings' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_seo_settings" data-nav-label="{{ lang.mod_seo.settings }}">
                        <i class="bi bi-sliders2-vertical nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.mod_seo.settings }}</span>
                    </a>
                {% endif %}
                {% if session.permissions.mod_redirect.list is defined %}
                    <a href="{{ site.saddress }}mod_redirect/list" class="nav-item {% if mod == 'mod_redirect' %}active{% endif %}" data-nav-track="1" data-nav-id="mod_redirect" data-nav-label="{{ lang.management.redirect_management }}">
                        <i class="bi bi-signpost-split-fill nav-item-icon"></i>
                        <span class="nav-item-label">{{ lang.management.redirect_management }}</span>
                    </a>
                {% endif %}
            </div>
        </div>

    </div>
</aside>
