<!-- NAVIGATION DRAWER (SIDEBAR) -->
<div class="drawer-scrim" id="drawerScrim" onclick="toggleDrawer()"></div>
<aside class="nav-drawer" id="navDrawer">
    <div class="drawer-header">
        <div class="drawer-title">{{ site.title }}</div>
        <div class="drawer-subtitle">v{{ site.version }}{% if site.build %} ({{ site.build }}){% endif %}</div>
    </div>
    <div class="drawer-content">
        <!-- Dashboard -->
        <!-- Site Home (Malper) -->
        <a href="{{ site.sadres }}" target="_blank" class="nav-item">
            <i class="bi bi-house-door-fill nav-item-icon"></i>
            <span class="nav-item-label">{{ lang.management.anasayfa }}</span>
        </a>

        <!-- Admin Dashboard -->
        <a href="{{ site.sadres }}mod_user/panel" class="nav-item {% if mod == 'mod_user' and (act is not defined or act == 'panel') %}active{% endif %}">
            <i class="bi bi-speedometer2 nav-item-icon"></i>
            <span class="nav-item-label">{{ lang.management.dashboard }}</span>
        </a>

        <div class="nav-divider"></div>

        <!-- 1. Group: Üyelik (Membership) -->
        {% if session.permissions.mod_user.list is defined %}
        <div class="nav-group {% if (mod == 'mod_user' and act is defined and act != 'panel') or mod == 'mod_user_group' or mod == 'mod_acl' or mod == 'mod_gallery_mod' or mod == 'mod_attachment_mod' or mod == 'mod_settings' %}expanded{% endif %}">
            <div class="nav-group-header" onclick="toggleGroup(this)">
                <i class="bi bi-people-fill nav-item-icon"></i>
                <span class="nav-item-label">{{ lang.management.uyelik }}</span>
                <i class="bi bi-chevron-down group-indicator"></i>
            </div>
            <div class="nav-group-items">
                {% if session.permissions.mod_user.list is defined %}
                <a href="{{ site.sadres }}mod_user/list" class="nav-item {% if mod == 'mod_user' and act == 'list' %}active{% endif %}">
                    <i class="bi bi-person nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.uyeler }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_user.setting is defined %}
                <a href="{{ site.sadres }}mod_user/settings" class="nav-item {% if mod == 'mod_user' and act == 'settings' %}active{% endif %}">
                    <i class="bi bi-gear nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.membership_setting }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_user_group.list is defined %}
                <a href="{{ site.sadres }}mod_user_group/list" class="nav-item {% if mod == 'mod_user_group' %}active{% endif %}">
                    <i class="bi bi-people nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.uye_gruplari }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_user.acl is defined %}
                <a href="{{ site.sadres }}mod_user/acl" class="nav-item {% if mod == 'mod_user' and act == 'acl' %}active{% endif %}">
                    <i class="bi bi-shield-lock nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.uye_permission_yonetimi_acl }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_acl.list is defined %}
                <a href="{{ site.sadres }}mod_acl/list" class="nav-item {% if mod == 'mod_acl' %}active{% endif %}">
                    <i class="bi bi-database-fill nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.acl }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_attachment_mod.list is defined %}
                <a href="{{ site.sadres }}mod_attachment_mod/list" class="nav-item {% if mod == 'mod_attachment_mod' %}active{% endif %}">
                    <i class="bi bi-paperclip nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.dosya_modulleri }}</span>
                </a>
                {% endif %}
            </div>
        </div>
        {% endif %}

        <!-- 2. Group: Content & Page -->
        <div class="nav-group {% if mod == 'mod_category' or mod == 'mod_news_category' or mod == 'mod_content' or mod == 'mod_news' or mod == 'mod_menu' or mod == 'mod_page' or mod == 'mod_document' or mod == 'mod_survey' or mod == 'mod_service_guide' %}expanded{% endif %}">
            <div class="nav-group-header" onclick="toggleGroup(this)">
                <i class="bi bi-rocket-takeoff-fill nav-item-icon"></i>
                <span class="nav-item-label">{{ lang.management.content_and_page }}</span>
                <i class="bi bi-chevron-down group-indicator"></i>
            </div>
            <div class="nav-group-items">
                {% if session.permissions.mod_category.list is defined %}
                <a href="{{ site.sadres }}mod_category/list" class="nav-item {% if mod == 'mod_category' %}active{% endif %}">
                    <i class="bi bi-tags-fill nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.content_categories }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_news_category.list is defined %}
                <a href="{{ site.sadres }}mod_news_category/list" class="nav-item {% if mod == 'mod_news_category' %}active{% endif %}">
                    <i class="bi bi-bookmarks-fill nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.news_categories }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_content.list is defined %}
                <a href="{{ site.sadres }}mod_content/list" class="nav-item {% if mod == 'mod_content' %}active{% endif %}">
                    <i class="bi bi-file-text-fill nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.content_management }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_publication_category.list is defined %}
                <a href="{{ site.sadres }}mod_publication_category/list" class="nav-item {% if mod == 'mod_publication_category' %}active{% endif %}">
                    <i class="bi bi-bookmarks-fill nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.publication_categories }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_menu.list is defined %}
                <a href="{{ site.sadres }}mod_menu/list" class="nav-item {% if mod == 'mod_menu' %}active{% endif %}">
                    <i class="bi bi-list nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.menu_management }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_page.list is defined %}
                <a href="{{ site.sadres }}mod_page/list" class="nav-item {% if mod == 'mod_page' %}active{% endif %}">
                    <i class="bi bi-file-richtext nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.page_management }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_document.list is defined %}
                <a href="{{ site.sadres }}mod_document/list" class="nav-item {% if mod == 'mod_document' %}active{% endif %}">
                    <i class="bi bi-folder-fill nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.file_management }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_service_guide.list is defined %}
                <a href="{{ site.sadres }}mod_service_guide/list" class="nav-item {% if mod == 'mod_service_guide' %}active{% endif %}">
                    <i class="bi bi-bank nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.service_guide }}</span>
                </a>
                {% endif %}
            </div>
        </div>

        <!-- 3. Group: Video & Images -->
        <div class="nav-group {% if mod == 'mod_video' or mod == 'mod_video_embed' or mod == 'mod_video_embed_category' or mod == 'mod_slider' or mod == 'mod_headline' or mod == 'mod_imagecategories' %}expanded{% endif %}">
            <div class="nav-group-header" onclick="toggleGroup(this)">
                <i class="bi bi-camera-video-fill nav-item-icon"></i>
                <span class="nav-item-label">{{ lang.management.video_and_images }}</span>
                <i class="bi bi-chevron-down group-indicator"></i>
            </div>
            <div class="nav-group-items">
                {% if session.permissions.mod_video.list is defined %}
                <a href="{{ site.sadres }}mod_video/list" class="nav-item {% if mod == 'mod_video' %}active{% endif %}">
                    <i class="bi bi-camera-reels-fill nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.videos }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_video_embed.list is defined %}
                <a href="{{ site.sadres }}mod_video_embed/list" class="nav-item {% if mod == 'mod_video_embed' %}active{% endif %}">
                    <i class="bi bi-youtube nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.remote_videos }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_video_embed_category.list is defined %}
                <a href="{{ site.sadres }}mod_video_embed_category/list" class="nav-item {% if mod == 'mod_video_embed_category' %}active{% endif %}">
                    <i class="bi bi-collection-play-fill nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.uzak_video_kategorisi }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_slider.list is defined %}
                <a href="{{ site.sadres }}mod_slider/list" class="nav-item {% if mod == 'mod_slider' %}active{% endif %}">
                    <i class="bi bi-card-image nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.manset_yonetimi }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_headline.list is defined %}
                <a href="{{ site.sadres }}mod_headline/list" class="nav-item {% if mod == 'mod_headline' %}active{% endif %}">
                    <i class="bi bi-newspaper nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.full_manset_yonetimi }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_imagecategories.list is defined %}
                <a href="{{ site.sadres }}mod_imagecategories/list" class="nav-item {% if mod == 'mod_imagecategories' %}active{% endif %}">
                    <i class="bi bi-images nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.image_gallery }}</span>
                </a>
                {% endif %}
            </div>
        </div>

        <!-- 4. Group: Announcements -->
        <div class="nav-group {% if mod == 'mod_announcements' or mod == 'mod_popup' %}expanded{% endif %}">
            <div class="nav-group-header" onclick="toggleGroup(this)">
                <i class="bi bi-megaphone-fill nav-item-icon"></i>
                <span class="nav-item-label">{{ lang.management.announcement_management }}</span>
                <i class="bi bi-chevron-down group-indicator"></i>
            </div>
            <div class="nav-group-items">
                {% if session.permissions.mod_announcements.list is defined %}
                <a href="{{ site.sadres }}mod_announcements/list" class="nav-item {% if mod == 'mod_announcements' %}active{% endif %}">
                    <i class="bi bi-volume-up-fill nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.announcement_management }}</span>
                </a>
                {% endif %}
                {% if session.permissions.mod_popup.list is defined %}
                <a href="{{ site.sadres }}mod_popup/list" class="nav-item {% if mod == 'mod_popup' %}active{% endif %}">
                    <i class="bi bi-layout-wtf nav-item-icon"></i> <span class="nav-item-label">{{ lang.management.popup_announcements }}</span>
                </a>
                {% endif %}
            </div>
        </div>

        <div class="nav-divider"></div>

        {% if shared_admin_module_health is defined and shared_admin_module_health is not empty %}
            {% set health_labels = {
                'mod_content': lang.management.content_management,
                'mod_news': lang.management.news_management,
                'mod_publication': lang.management.publication_management,
                'mod_video_embed': lang.management.remote_videos,
                'mod_category': lang.management.content_categories,
                'mod_news_category': lang.management.news_categories,
                'mod_publication_category': lang.management.publication_categories,
                'mod_video_embed_category': lang.management.uzak_video_kategorisi
            } %}
            {% set health_modules = [
                shared_admin_module_health.mod_content,
                shared_admin_module_health.mod_news,
                shared_admin_module_health.mod_publication,
                shared_admin_module_health.mod_video_embed
            ] %}
            <section style="padding: 0 16px 24px;">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;">
                    <div style="font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:#6d5f0f; font-weight:700;">
                        {{ lang.management.module_health }}
                    </div>
                    <i class="bi bi-activity" style="font-size:14px; color:#7a7f87;"></i>
                </div>
                <div style="display:grid; gap:10px;">
                    {% for item in health_modules %}
                        {% set is_ready = item.ready %}
                        {% set status_key = 'module_health_status_' ~ item.status %}
                        <div style="border-radius:18px; padding:12px 13px; background:{% if is_ready %}linear-gradient(135deg, #edf9f0 0%, #e3f6e8 100%){% else %}linear-gradient(135deg, #fff4e8 0%, #ffe8d9 100%){% endif %}; border:1px solid {% if is_ready %}#c9e8d1{% else %}#f1d1b7{% endif %};">
                            <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
                                <div style="font-size:13px; font-weight:700; color:#1f2933;">
                                    {{ attribute(health_labels, item.module) }}
                                </div>
                                <div style="font-size:11px; font-weight:700; padding:4px 8px; border-radius:999px; background:{% if is_ready %}#1f7a45{% else %}#b45309{% endif %}; color:#fff;">
                                    {{ attribute(lang.management, status_key) }}
                                </div>
                            </div>
                            {% if session.permissions.mod_user.acl is defined %}
                                <div style="margin-top:10px; display:flex; justify-content:flex-end;">
                                    {% if item.status == 'disabled' %}
                                        <a href="{{ site.sadres }}management/module_status/{{ item.module }}/ready" style="display:inline-flex; align-items:center; justify-content:center; min-height:32px; padding:0 12px; border-radius:999px; background:#1f7a45; color:#fff; font-size:11px; font-weight:700; text-decoration:none;">
                                            {{ lang.management.module_health_enable }}
                                        </a>
                                    {% elseif not is_ready %}
                                        <a href="{{ site.sadres }}management/module_repair/{{ item.module }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:32px; padding:0 12px; border-radius:999px; background:#fff; color:#265d3b; border:1px solid #9bcbac; font-size:11px; font-weight:700; text-decoration:none;">
                                            {{ lang.management.module_health_repair }}
                                        </a>
                                    {% else %}
                                        <a href="{{ site.sadres }}management/module_status/{{ item.module }}/disabled" style="display:inline-flex; align-items:center; justify-content:center; min-height:32px; padding:0 12px; border-radius:999px; background:#fff; color:#8a4b11; border:1px solid #dfb188; font-size:11px; font-weight:700; text-decoration:none;">
                                            {{ lang.management.module_health_disable }}
                                        </a>
                                    {% endif %}
                                </div>
                            {% endif %}
                            {% if not is_ready %}
                                {% if item.missing_modules is not empty %}
                                    <div style="margin-top:8px; font-size:11px; line-height:1.4; color:#6b4423;">
                                        <strong>{{ lang.management.module_health_missing_modules }}:</strong>
                                        {% for module_name in item.missing_modules %}
                                            {% if health_labels[module_name] is defined %}
                                                {{ health_labels[module_name] }}
                                            {% else %}
                                                {{ module_name }}
                                            {% endif %}{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                {% if item.missing_tables is not empty %}
                                    <div style="margin-top:6px; font-size:11px; line-height:1.4; color:#6b4423;">
                                        <strong>{{ lang.management.module_health_missing_tables }}:</strong>
                                        {{ item.missing_tables|join(', ') }}
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
        
    </div>
</aside>
