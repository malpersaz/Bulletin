{% set filter_lang = attribute(lang, active_module_lang_key) %}
<!-- Filter Sheet -->
<div class="overlay" id="sheet-overlay" data-action="close-sheet"></div>
<div class="bottom-sheet" id="sheet-menu">
    <!-- Sticky Header -->
    <div class="sheet-header-sticky">
        <div class="sheet-handle-bar"></div>
        <div class="filter-sheet-header-row">
            <h3 class="filter-sheet-title">{{ filter_lang.filter.title }}</h3>
            <button class="filter-sheet-close-btn" data-action="close-sheet">{{ filter_lang.filter.close }}</button>
        </div>
    </div>

    <!-- Scrollable Content -->
    <div class="sheet-content-scrollable">
        <!-- Sort Order -->
        <label class="filter-group-label filter-group-label-first">{{ filter_lang.filter.sort_label }}</label>
        <div class="chip-scroll-container">
            <div class="filter-chip active" data-action="select-chip" data-chip-type="sort" data-sort-col="6" data-sort-dir="desc">{{ filter_lang.filter.newest }}</div>
            <div class="filter-chip" data-action="select-chip" data-chip-type="sort" data-sort-col="6" data-sort-dir="asc">{{ filter_lang.filter.oldest }}</div>
            <div class="filter-chip" data-action="select-chip" data-chip-type="sort" data-sort-col="2" data-sort-dir="asc">{{ filter_lang.filter.title_az }}</div>
            <div class="filter-chip" data-action="select-chip" data-chip-type="sort" data-sort-col="2" data-sort-dir="desc">{{ filter_lang.filter.title_za }}</div>
        </div>

        <!-- Limit Selection -->
        <label class="filter-group-label filter-group-label-spaced">{{ filter_lang.filter.limit_label }}</label>
        <div class="chip-scroll-container">
            <div class="filter-chip active" data-action="select-chip" data-chip-type="limit">10</div>
            <div class="filter-chip" data-action="select-chip" data-chip-type="limit">20</div>
            <div class="filter-chip" data-action="select-chip" data-chip-type="limit">50</div>
            <div class="filter-chip" data-action="select-chip" data-chip-type="limit">100</div>
        </div>

        <!-- Language Selection (Summary Mode) -->
        <label class="filter-group-label filter-group-label-spaced">{{ filter_lang.filter.lang_label }}</label>
        <div class="selected-lang-summary filter-lang-summary-box" id="langSummaryContainer" data-select-label="{{ filter_lang.filter.select_label }}">
            <span class="filter-lang-summary-label">{{ filter_lang.filter.selected_lang }}:</span>
            <button class="add-lang-btn" data-action="open-lang-sheet">
                <i class="bi bi-globe filter-lang-btn-icon"></i> {{ filter_lang.filter.all_langs }}
            </button>
        </div>

        <!-- Date Range -->
        <label class="filter-group-label filter-group-label-spaced">{{ filter_lang.filter.date_label }}</label>
        <div class="filter-date-row">
            <div class="input-wrapper filter-date-col">
                <label class="filter-date-label">{{ filter_lang.filter.start_date }}</label>
                <input type="date" class="m3-input">
            </div>
            <div class="input-wrapper filter-date-col">
                <label class="filter-date-label">{{ filter_lang.filter.end_date }}</label>
                <input type="date" class="m3-input">
            </div>
        </div>
    </div>

    <!-- Sticky Footer -->
    <div class="sheet-footer-sticky">
        <div class="filter-footer-row">
            <button class="m3-btn-outlined filter-footer-btn" data-action="clear-filters">{{ filter_lang.filter.clear }}</button>
            <button class="m3-btn-filled filter-footer-btn" data-action="apply-filters">{{ filter_lang.filter.apply }}</button>
        </div>
    </div>
</div>
