{% set wizard_lang = lang.mod_event %}
<form id="addForm" method="POST" action="{{ site.saddress }}mod_event/add" enctype="multipart/form-data">
<div id="contentWizard" class="wizard-overlay event-wizard-overlay">

    <!-- Wizard Header -->
    <header class="wizard-header">
        <button type="button" class="icon-btn" data-action="close-content-wizard" data-list-url="{{ site.saddress }}mod_event/list" aria-label="{{ wizard_lang.button.cancel }}">
            <i class="bi bi-x-lg"></i>
        </button>
        <div class="wizard-title">
            <span id="wizardStepTitle">{{ wizard_lang.wizard.steps.lang_category }}</span>
            <span id="wizardStepCounter">1/9</span>
        </div>
        <button type="button" class="m3-btn-text" data-action="submit-content-wizard">{{ wizard_lang.button.send }}</button>
    </header>

    <!-- Progress Bar -->
    <div class="wizard-progress-bar">
        <div class="wizard-progress-fill" id="wizardProgressFill"></div>
    </div>

    <!-- Wizard Content Scrollable -->
    <div class="wizard-content">

        <!-- Hidden Defaults -->
        <input type="hidden" name="add" value="1">
        <input type="hidden" name="deck" id="wizardHiddenDeck" value="n">
        <input type="hidden" name="slider" id="wizardHiddenSlider" value="n">
        <input type="hidden" name="is_official_holiday" id="wizardHiddenOfficialHoliday" value="n">
        <input type="hidden" name="holiday_duration" id="wizardHiddenHolidayDuration" value="0.0">
        <input type="hidden" name="is_recurring" id="wizardHiddenRecurring" value="n">
        <input type="hidden" name="gallery_id" value="0">
        <input type="hidden" name="file_id" value="0">
        <input type="hidden" name="acl_id" id="wizardHiddenAcl" value="0">
        <input type="hidden" name="menu" id="wizardHiddenMenu" value="0">
        <input type="hidden" name="video" value="">
        <input type="hidden" name="seo" id="seo" value="">
        <input type="hidden" name="title" id="title" value="">
        <input type="hidden" name="keywords" id="keywords" value="">
        <input type="hidden" name="description" id="description" value="">
        <input type="hidden" name="lang" id="wizardHiddenLang" value="{{ site.lang|lower }}">
        <input type="hidden" name="category_id" id="wizardHiddenCategory" value="0">

        <!-- Step 1: Language & Category -->
        <div class="wizard-step active" id="wizardStep1">
            <h2 class="step-headline">{{ wizard_lang.wizard.step_titles.step1 }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.step_subtitles.step1 }}</p>

            <label class="field-section-label">{{ wizard_lang.admin.columns.language }}</label>
            <div class="selection-grid">
                {% for item in lang_lang %}
                <div class="selection-card{% if item.seo|lower == site.lang|lower %} active{% endif %}" data-action="select-wizard-lang" data-lang="{{ item.seo|lower }}">
                    <div class="selection-icon">{{ item.seo|upper }}</div>
                    <div class="selection-label">{{ item.name }}</div>
                    <i class="bi bi-check-circle-fill check-icon"></i>
                </div>
                {% endfor %}
            </div>

            <div class="form-row-spacing">
                <label class="field-section-label">{{ wizard_lang.admin.columns.category_id }}</label>
                <div class="m3-input-wrapper">
                    <div class="m3-fake-select" data-action="toggle-wizard-category-sheet">
                        <span id="wizardSelectedCategory">{{ wizard_lang.choose_wish }}</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 2: Event Title & Subject -->
        <div class="wizard-step" id="wizardStep2">
            <h2 class="step-headline">{{ wizard_lang.wizard.step_titles.step2 }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.step_subtitles.step2 }}</p>

            <div class="input-wrapper-lg">
                <input type="text" class="m3-input-lg" name="name" id="wizardTitleInput" placeholder=" " autocomplete="off" maxlength="70" required>
                <label class="m3-floating-label">{{ wizard_lang.admin.columns.name }}</label>
            </div>
            <div class="char-counter" id="titleCharCounter">0 / 70</div>
            <div class="validation-msg" id="titleValidationMsg">{{ wizard_lang.validator.title_length }}</div>

            <div class="input-wrapper-lg form-row-spacing">
                <input type="text" class="m3-input-lg" name="subject" id="wizardSubjectInput" placeholder=" " autocomplete="off">
                <label class="m3-floating-label">{{ wizard_lang.admin.columns.subject }}</label>
            </div>
        </div>

        <!-- Step 3: Schedule & Venue -->
        <div class="wizard-step" id="wizardStep3">
            <h2 class="step-headline">{{ wizard_lang.wizard.step_titles.step3 }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.step_subtitles.step3 }}</p>

            <div class="input-wrapper-lg">
                <input type="datetime-local" class="m3-input-lg" name="start_date" id="wizardStartDateInput" value="{{ 'now'|date('Y-m-d') }}T{{ 'now'|date('H:i') }}" required>
                <label class="m3-floating-label">{{ wizard_lang.admin.columns.start_date }}</label>
            </div>

            <div class="input-wrapper-lg form-row-spacing">
                <input type="datetime-local" class="m3-input-lg" name="end_date" id="wizardEndDateInput">
                <label class="m3-floating-label">{{ wizard_lang.admin.columns.end_date }}</label>
            </div>

            <div class="input-wrapper-lg form-row-spacing">
                <input type="text" class="m3-input-lg" name="location" id="wizardLocationInput" placeholder=" " autocomplete="off">
                <label class="m3-floating-label">{{ wizard_lang.admin.columns.location }}</label>
            </div>
        </div>

        <!-- Step 4: Participants & Guests -->
        <div class="wizard-step" id="wizardStep4">
            <h2 class="step-headline">{{ wizard_lang.wizard.step_titles.step4 }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.step_subtitles.step4 }}</p>

            <div class="input-wrapper-lg">
                <input type="text" class="m3-input-lg" name="participants" id="wizardParticipantsInput" placeholder=" " autocomplete="off">
                <label class="m3-floating-label">{{ wizard_lang.admin.columns.participants }}</label>
            </div>

            <div class="input-wrapper-lg form-row-spacing">
                <input type="text" class="m3-input-lg" name="guests" id="wizardGuestsInput" placeholder=" " autocomplete="off">
                <label class="m3-floating-label">{{ wizard_lang.admin.columns.guests }}</label>
            </div>
        </div>

        <!-- Step 5: Summary & Lead Text -->
        <div class="wizard-step" id="wizardStep5">
            <h2 class="step-headline">{{ wizard_lang.wizard.step_titles.step5 }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.step_subtitles.step5 }}</p>

            <div class="input-wrapper-lg">
                <textarea class="m3-input-lg" name="summary" id="wizardIntroInput" rows="5" placeholder=" " minlength="90" maxlength="255" required></textarea>
                <label class="m3-floating-label">{{ wizard_lang.admin.columns.summary }}</label>
            </div>
            <div class="char-counter" id="introCharCounter">0 / 255</div>
            <div class="validation-msg" id="introValidationMsg"><i class="bi bi-exclamation-circle-fill"></i> <span>{{ wizard_lang.validator.deck_length }}</span></div>

            <div class="form-row-spacing">
                <label class="field-section-label">{{ wizard_lang.admin.columns.deck }}</label>
                <div class="selection-grid">
                    <div class="selection-card" data-action="select-wizard-deck" data-value="y">
                        <i class="bi bi-star-fill selection-icon"></i>
                        <div class="selection-label">{{ wizard_lang.admin.radio.deck_yes }}</div>
                        <i class="bi bi-check-circle-fill check-icon"></i>
                    </div>
                    <div class="selection-card active" data-action="select-wizard-deck" data-value="n">
                        <i class="bi bi-star selection-icon"></i>
                        <div class="selection-label">{{ wizard_lang.admin.radio.deck_no }}</div>
                        <i class="bi bi-check-circle-fill check-icon"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 6: Detailed Content -->
        <div class="wizard-step" id="wizardStep6">
            <h2 class="step-headline">{{ wizard_lang.wizard.step_titles.step6 }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.step_subtitles.step6 }}</p>

            <div class="mod-event-editor-wrap">
                <textarea name="content" id="wizardContentTextarea"></textarea>
            </div>
        </div>

        <!-- Step 7: Poster Image (3:4 ratio) -->
        <div class="wizard-step" id="wizardStep7">
            <h2 class="step-headline">{{ wizard_lang.wizard.step_titles.step7 }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.step_subtitles.step7 }}</p>

            {% include 'admin/partials/image_uploader.twig' with {
                shell_id: 'wizardImageShell',
                shell_class: 'event-poster-shell',
                has_image: false,
                shell_attrs: {
                    'data-drop-title': wizard_lang.upload_image,
                    'data-drop-description': wizard_lang.admin.columns.image,
                    'data-upload-link': wizard_lang.add_image,
                    'data-link-separator': wizard_lang.filter.clear,
                    'data-link-placeholder': wizard_lang.filter.select_label,
                    'data-link-action': wizard_lang.filter.apply,
                    'data-hint-loading': wizard_lang.grid.loading,
                    'data-hint-invalid-type': wizard_lang.validator.inarray,
                    'data-hint-no-drop-data': wizard_lang.grid.no_data,
                    'data-hint-remote-failed': wizard_lang.grid.connection_error,
                    'data-empty-name': wizard_lang.filter.select_label,
                    'data-empty-meta': wizard_lang.admin.columns.image
                },
                dropzone_id: 'wizardImageDropzone',
                empty_state_id: 'wizardImageEmptyState',
                drop_title: wizard_lang.upload_image,
                upload_link: wizard_lang.add_image,
                preview_card_id: 'wizardImagePreviewCard',
                remove_btn_id: 'wizardImageRemoveBtn',
                preview_img_id: 'wizardImgPreview',
                preview_alt: wizard_lang.admin.columns.image,
                preview_hidden: true,
                meta_hidden: false,
                file_name_id: 'wizardImageFileName',
                file_name_text: wizard_lang.filter.select_label,
                file_details_id: 'wizardImageFileDetails',
                file_details_text: wizard_lang.admin.columns.image,
                divider_hidden: false,
                link_separator: wizard_lang.filter.clear,
                url_row_hidden: false,
                url_input_id: 'wizardImageUrlInput',
                link_placeholder: wizard_lang.filter.select_label,
                import_btn_id: 'wizardImageUrlImportBtn',
                link_action: wizard_lang.filter.apply,
                file_input_id: 'wizardImgInput'
            } %}
        </div>

        <!-- Step 8: Media, Menu & Access -->
        <div class="wizard-step" id="wizardStep8">
            <h2 class="step-headline">{{ wizard_lang.wizard.step_titles.step8 }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.step_subtitles.step8 }}</p>

            <div class="form-row">
                <label class="field-section-label">{{ wizard_lang.admin.columns.slider }}</label>
                <div class="selection-grid">
                    <div class="selection-card" data-action="select-wizard-slider" data-value="y">
                        <i class="bi bi-stars selection-icon"></i>
                        <div class="selection-label">{{ wizard_lang.admin.radio.slider_yes }}</div>
                        <i class="bi bi-check-circle-fill check-icon"></i>
                    </div>
                    <div class="selection-card active" data-action="select-wizard-slider" data-value="n">
                        <i class="bi bi-dash-circle selection-icon"></i>
                        <div class="selection-label">{{ wizard_lang.admin.radio.slider_no }}</div>
                        <i class="bi bi-check-circle-fill check-icon"></i>
                    </div>
                </div>
            </div>

            <div class="form-row-spacing">
                <div class="m3-input-wrapper">
                    <input type="datetime-local" class="m3-input-lg" name="created_at" id="wizardDateInput" value="{{ 'now'|date('Y-m-d') }}T{{ 'now'|date('H:i') }}">
                    <label class="m3-floating-label">{{ wizard_lang.admin.columns.created_at }}</label>
                </div>
            </div>
        </div>

        <!-- Step 9: Review & Publish -->
        <div class="wizard-step" id="wizardStep9">
            <h2 class="step-headline">{{ wizard_lang.wizard.step_titles.step9 }}</h2>
            <p class="step-subhead">{{ wizard_lang.wizard.step_subtitles.step9 }}</p>

            <input type="hidden" name="status" value="y" id="wizardPublishHidden">

            <label class="field-section-label">{{ wizard_lang.admin.columns.status }}</label>
            <div class="selection-grid">
                <div class="selection-card active" data-action="select-wizard-publish-status" data-status="y">
                    <i class="bi bi-cloud-check selection-icon"></i>
                    <div class="selection-label">{{ wizard_lang.admin.radio.publish_yes }}</div>
                    <i class="bi bi-check-circle-fill check-icon"></i>
                </div>
                <div class="selection-card" data-action="select-wizard-publish-status" data-status="n">
                    <i class="bi bi-pencil-square selection-icon"></i>
                    <div class="selection-label">{{ wizard_lang.admin.radio.publish_no }}</div>
                    <i class="bi bi-check-circle-fill check-icon"></i>
                </div>
            </div>

            <div class="wizard-summary event-wizard-summary">
                <h3>{{ wizard_lang.wizard.review.event_details }}</h3>
                <div class="summary-item">
                    <i class="bi bi-translate"></i> <span id="summaryLang">{{ site.lang|upper }}</span>
                </div>
                <div class="summary-item">
                    <i class="bi bi-folder"></i> <span id="summaryCategory">{{ wizard_lang.choose_wish }}</span>
                </div>
                <div class="summary-item">
                    <i class="bi bi-type-h1"></i> <span id="summaryTitle">{{ wizard_lang.wizard.review.title }}</span>
                </div>
                <div class="summary-item">
                    <i class="bi bi-calendar-event"></i> <span id="summarySchedule">{{ wizard_lang.admin.columns.start_date }}</span>
                </div>
                <div class="summary-item">
                    <i class="bi bi-geo-alt"></i> <span id="summaryVenue">{{ wizard_lang.admin.columns.location }}</span>
                </div>
            </div>
        </div>

    </div>

    <!-- Wizard Footer -->
    <div class="wizard-footer">
        <button type="button" class="m3-btn-outlined" id="btnWizardPrev" data-action="prev-wizard-step" disabled>{{ wizard_lang.button.prev }}</button>
        <button type="button" class="m3-btn-filled" id="btnWizardNext" data-action="next-wizard-step">{{ wizard_lang.button.next }}</button>
        <button type="button" class="m3-btn-filled success" id="btnWizardFinish" data-action="finish-wizard-step" hidden>{{ wizard_lang.button.send }}</button>
    </div>
</div>
</form>
