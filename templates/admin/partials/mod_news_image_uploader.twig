<div
    class="wizard-image-shell {{ shell_class|default('') }}{% if has_image|default(false) %} has-image{% endif %}"
    id="{{ shell_id }}"
    {% for key, value in shell_attrs|default({}) %}
        {% if value is not null and value is not same as('') %}
            {{ key }}="{{ value }}"
        {% endif %}
    {% endfor %}
>
    <div class="image-upload-area wizard-image-dropzone" id="{{ dropzone_id }}" tabindex="0" role="button" onclick="{{ trigger_picker_js }}">
        <div class="wizard-image-empty" id="{{ empty_state_id }}"{% if empty_hidden|default(false) %} hidden{% endif %}>
            <div class="wizard-image-empty-icon">
                <i class="bi bi-images"></i>
            </div>
            <div class="wizard-image-empty-copy">
                <p class="wizard-image-empty-line">
                    <span class="wizard-image-empty-text">{{ drop_title }}</span>
                    <button type="button" class="wizard-image-inline-link" onclick="event.stopPropagation(); {{ trigger_picker_js }}">{{ upload_link }}</button>
                </p>
            </div>
        </div>

        <div class="wizard-image-preview-card" id="{{ preview_card_id }}"{% if preview_hidden|default(true) %} hidden{% endif %}>
            <div class="wizard-image-preview-frame">
                <button type="button" class="wizard-image-remove-btn"{% if remove_btn_id|default('') %} id="{{ remove_btn_id }}"{% endif %} onclick="event.stopPropagation(); {{ remove_action_js }}">
                    <i class="bi bi-x-lg"></i>
                </button>
                <img id="{{ preview_img_id }}" class="wizard-img-preview" alt="{{ preview_alt|default('') }}"{% if preview_hidden|default(true) %} hidden{% endif %}{% if preview_src|default('') %} src="{{ preview_src }}"{% endif %}>
            </div>
            <div class="wizard-image-meta"{% if meta_id|default('') %} id="{{ meta_id }}"{% endif %}{% if meta_hidden|default(false) %} hidden{% endif %}>
                <strong id="{{ file_name_id }}">{{ file_name_text }}</strong>
                <p id="{{ file_details_id }}">{{ file_details_text }}</p>
            </div>
        </div>
    </div>

    <div class="wizard-image-divider" aria-hidden="true"{% if divider_hidden|default(false) %} hidden{% endif %}>
        <span>{{ link_separator }}</span>
    </div>

    <div class="wizard-image-url-row"{% if url_row_hidden|default(false) %} hidden{% endif %}>
        <input
            type="url"
            id="{{ url_input_id }}"
            class="wizard-image-url-input"
            placeholder="{{ link_placeholder }}"
            inputmode="url"
            autocomplete="off"
            spellcheck="false"
        >
        <button type="button" class="m3-btn-filled" id="{{ import_btn_id }}">
            <span>{{ link_action }}</span>
        </button>
    </div>

    <input
        type="file"
        name="{{ input_name|default('image') }}"
        id="{{ file_input_id }}"
        hidden
        accept="image/*"
        {% if file_input_onchange|default('') %}
            onchange="{{ file_input_onchange }}"
        {% endif %}
    >
</div>
