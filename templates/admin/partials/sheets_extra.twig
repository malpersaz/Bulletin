{% set wizard_lang = attribute(lang, active_module_lang_key) %}

<!-- Language Selection Sheet -->
<div class="overlay" id="lang-sheet-overlay" data-action="close-lang-sheet"></div>
<div class="bottom-sheet" id="lang-sheet">
    <div class="sheet-handle-bar"></div>

    <div class="lang-sheet-header-row">
        <h3 class="lang-sheet-title">{{ wizard_lang.sheet.lang_title }}</h3>
        <button data-action="confirm-lang-selection" class="m3-btn-text lang-sheet-ok-btn">{{ wizard_lang.sheet.ok }}</button>
    </div>

    <div class="sheet-content-scrollable lang-sheet-body-scroll">
        <div class="lang-list-container" id="langListContainer">
            <!-- Dynamic List Generated by JS -->
        </div>
    </div>
</div>

<!-- Context Menu Sheet for Card Actions -->
<div class="overlay" id="context-menu-overlay" data-action="close-context-menu"></div>
<div class="bottom-sheet" id="context-menu-sheet">
    <div class="context-menu-header">
        <h3 id="contextMenuTitle">{{ wizard_lang.context_menu.title }}</h3>
    </div>

    <div class="context-menu-body">
        <div class="context-action-item" id="contextActionEdit" data-action="context-action" data-context-type="edit">
            <div class="context-icon icon-edit">
                <i class="bi bi-pencil"></i>
            </div>
            <span class="context-action-label">{{ wizard_lang.context_menu.edit }}</span>
        </div>

        <div class="context-action-item is-hidden" id="contextActionSubmissions" data-action="context-action" data-context-type="submissions">
            <div class="context-icon icon-submissions">
                <i class="bi bi-people"></i>
            </div>
            <span class="context-action-label">{{ wizard_lang.context_menu.submissions|default('Submissions') }}</span>
        </div>

        <div class="context-divider"></div>

        <div class="context-action-item" id="contextActionVideo" data-action="context-action" data-context-type="video">
            <div class="context-icon icon-video context-icon-video-custom">
                <i class="bi bi-camera-video"></i>
            </div>
            <span class="context-action-label">{{ wizard_lang.context_menu.video }}</span>
        </div>

        <div class="context-action-item" id="contextActionGallery" data-action="context-action" data-context-type="gallery">
            <div class="context-icon icon-gallery">
                <i class="bi bi-images"></i>
            </div>
            <span class="context-action-label">{{ wizard_lang.context_menu.gallery }}</span>
            <span class="context-badge is-hidden" id="contextGalleryBadge">0</span>
        </div>

        <div class="context-action-item" id="contextActionFiles" data-action="context-action" data-context-type="files">
            <div class="context-icon icon-files">
                <i class="bi bi-paperclip"></i>
            </div>
            <span class="context-action-label">{{ wizard_lang.context_menu.files }}</span>
            <span class="context-badge is-hidden" id="contextFilesBadge">0</span>
        </div>

        <div class="context-action-item" id="contextActionFaq" data-action="context-action" data-context-type="faq">
            <div class="context-icon icon-faq">
                <i class="bi bi-patch-question-fill"></i>
            </div>
            <span class="context-action-label">{{ wizard_lang.context_menu.faq|default('FAQ') }}</span>
        </div>

        <div class="context-divider"></div>

        <!-- Dynamic Status Action (filled by JS) -->
        <div class="context-action-item" id="contextActionStatus" data-action="context-action" data-context-type="status">
            <div class="context-icon icon-status">
                <i class="bi bi-arrow-repeat nav-item-icon"></i>
            </div>
            <span class="context-action-label nav-item-label">{{ wizard_lang.context_menu.status }}</span>
        </div>

        <div class="context-action-item action-danger" id="contextActionDelete" data-action="context-action" data-context-type="delete">
            <div class="context-icon icon-delete">
                <i class="bi bi-trash3"></i>
            </div>
            <span class="context-action-label">{{ wizard_lang.context_menu.delete }}</span>
        </div>
    </div>
</div>

<!-- Category Sheet for Wizard (Shared) -->
<div class="overlay" id="wizard-cat-overlay" data-action="toggle-wizard-cat"></div>
<div class="bottom-sheet" id="wizard-cat-sheet">
    <div class="sheet-handle-bar"></div>
    <h3 class="wizard-cat-sheet-title">{{ wizard_lang.sheet.category_title }}</h3>
    <div class="category-sheet-meta">
        <div class="category-sheet-pill">
            <i class="bi bi-translate"></i>
            <span id="wizardCatActiveLang">{{ site.lang|upper }}</span>
        </div>
        <div class="category-sheet-pill">
            <i class="bi bi-folder2-open"></i>
            <span id="wizardCatVisibleCount">0</span>
        </div>
    </div>
    <input
        type="search"
        id="wizardCategorySearchInput"
        class="category-sheet-search"
        placeholder="{{ wizard_lang.ui.search }}"
        autocomplete="off"
    >
    <div class="nav-drawer-content category-list">
        {% if categories is defined %}
            {% for cat in categories %}
            <div
                class="nav-item category-item content-cat"
                data-lang="{{ cat.lang }}"
                data-name="{{ cat.name|e('html_attr') }}"
                data-category-id="{{ cat.id }}"
                data-action="select-wizard-cat"
                data-id="{{ cat.id }}"
            >
                <div class="category-item-meta">
                    <i class="bi bi-bookmark-star"></i>
                </div>
                <div class="category-item-body">
                    <span class="category-item-title">{{ cat.name }}</span>
                    <span class="category-item-subtitle">{{ cat.lang|upper }}</span>
                </div>
                <i class="bi bi-check-circle-fill category-item-check"></i>
            </div>
            {% endfor %}
        {% endif %}

        {% if video_embed_categories is defined %}
            {% for cat in video_embed_categories %}
            <div
                class="nav-item category-item video-cat is-hidden"
                data-lang="{{ cat.lang }}"
                data-name="{{ cat.name|e('html_attr') }}"
                data-category-id="{{ cat.id }}"
                data-action="select-video-cat"
                data-id="{{ cat.id }}"
            >
                <div class="category-item-meta">
                    <i class="bi bi-collection"></i>
                </div>
                <div class="category-item-body">
                    <span class="category-item-title">{{ cat.name }}</span>
                    <span class="category-item-subtitle">{{ cat.lang|upper }}</span>
                </div>
                <i class="bi bi-check-circle-fill category-item-check"></i>
            </div>
            {% endfor %}
        {% endif %}

        <div id="no-category-msg" class="no-category-msg-box">
            <i class="bi bi-folder-x no-category-msg-icon"></i>
            <p class="no-category-msg-text">{{ wizard_lang.wizard.messages.no_category_for_lang }}</p>
        </div>
    </div>
</div>

<div class="overlay" id="select-picker-overlay" data-action="close-select-picker"></div>
<div class="bottom-sheet" id="select-picker-sheet">
    <div class="sheet-handle-bar"></div>
    <div class="select-picker-title-row">
        <div class="select-picker-title-col">
            <h3 id="selectPickerTitle" class="select-picker-title-text">{{ wizard_lang.sheet.category_title }}</h3>
            <div id="selectPickerSubtitle" class="select-picker-subtitle-text"></div>
        </div>
        <div class="select-picker-actions-wrapper">
            <button type="button" id="selectPickerAddBtn" class="m3-btn-select-add is-hidden" data-action="select-picker-add">
                <div class="add-btn-bg"></div>
                <span class="add-btn-content"><i class="bi bi-plus-lg"></i> {{ wizard_lang.button.add }}</span>
            </button>
            <button type="button" class="m3-btn-icon-close" aria-label="Close" data-action="close-select-picker"><i class="bi bi-x-lg"></i></button>
        </div>
    </div>
    <div class="select-picker-meta is-hidden">
        <div class="select-picker-pill">
            <i class="bi bi-translate"></i>
            <span id="selectPickerActiveLang">{{ site.lang|upper }}</span>
        </div>
        <div class="select-picker-pill">
            <i class="bi bi-grid"></i>
            <span id="selectPickerVisibleCount">0</span>
        </div>
    </div>
    <input
        type="search"
        id="selectPickerSearchInput"
        class="select-picker-search"
        placeholder="{{ wizard_lang.ui.search }}"
        autocomplete="off"
    >
    <div class="select-picker-list" id="selectPickerList"></div>
    <div id="selectPickerEmpty" class="select-picker-empty">
        <i class="bi bi-search select-picker-empty-icon"></i>
        <p class="select-picker-empty-text">{{ wizard_lang.wizard.summary.selected_none }}</p>
    </div>
</div>
