{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}{{ lang.mod_announcements.edit }}{% endblock %}
{% block headline %}{{ lang.mod_announcements.edit }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/templates/admin/assets/css/mod_announcements.css?v=6.0">
{% endblock %}

{% block content %}
<div class="announcements-form-shell">
    {% if success is defined %}
        <div class="form-status success">{{ message }}</div>
    {% endif %}
    {% if error is defined %}
        <div class="form-status error">{{ message }}</div>
    {% endif %}
    {% if errors is defined %}
        <div class="form-status error">
            {% for msg in errors %}
                <div>{{ msg }}</div>
            {% endfor %}
        </div>
    {% endif %}

    <form method="POST" action="" enctype="multipart/form-data" id="announcementEditForm" class="announcements-form-shell form-shell-clean">
        <input type="hidden" name="id" value="{{ d.id }}">
        <input type="file" name="image_original" id="editImgOriginalInput" hidden>

        <div class="announcements-form-card">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.information }}</h3>

            <!-- Language -->
            <div class="m3-input-wrapper">
                <select class="m3-input-lg" name="lang">
                    {% set selected_lang = lang_value|default(d.lang) %}
                    {% for item in lang_lang %}
                        {% if item.status == 'y' or item.seo == selected_lang %}
                            <option value="{{ item.seo }}" {% if item.seo == selected_lang %}selected{% endif %}>{{ item.name|default(item.ad) }} ({{ item.seo|upper }})</option>
                        {% endif %}
                    {% endfor %}
                </select>
                <label class="m3-floating-label">{{ lang.mod_announcements.admin.columns.language }}</label>
            </div>

            <!-- Title -->
            <div class="m3-input-wrapper mb-12">
                <input class="m3-input-lg" type="text" name="name" id="announcement-name" value="{{ name|default(d.name) }}" placeholder=" " maxlength="255" required>
                <label class="m3-floating-label">{{ lang.mod_announcements.admin.columns.name }}</label>
                <div class="input-char-counter" id="name-counter">0 / 255</div>
            </div>

            <!-- SEO URL Slug -->
            <div class="m3-input-wrapper">
                <input class="m3-input-lg" type="text" name="seo" id="announcement-seo" value="{{ seo|default(d.seo) }}" placeholder=" " maxlength="255">
                <label class="m3-floating-label">{{ lang.mod_announcements.admin.columns.seo }}</label>
                <div class="input-char-counter" id="seo-counter">0 / 255</div>
            </div>

            <!-- Created At -->
            <div class="m3-input-wrapper">
                <input class="m3-input-lg" type="datetime-local" name="created_at" id="announcement-created-at" value="{{ (created_at|default(d.created_at)) ? (created_at|default(d.created_at))|replace({' ': 'T'}) : '' }}" placeholder=" " required>
                <label class="m3-floating-label">{{ lang.mod_announcements.admin.columns.date }}</label>
            </div>
        </div>

        <!-- Publish Status -->
        <div class="announcements-form-card">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.admin.columns.status }}</h3>
            <div class="selection-grid" data-selection-group>
                {% set current_status = status|default(d.status) %}
                <label class="selection-card{% if current_status == 'y' %} active{% endif %}">
                    <input type="radio" name="status" value="y" {% if current_status == 'y' %}checked{% endif %}>
                    <div class="selection-card-header">
                        <div class="selection-title">{{ lang.mod_announcements.admin.radio.publish_yes }}</div>
                        <i class="bi bi-check-circle-fill selection-check-icon"></i>
                    </div>
                    <div class="selection-copy">{{ lang.mod_announcements.grid.publish.key }}</div>
                </label>
                <label class="selection-card{% if current_status == 'n' %} active{% endif %}">
                    <input type="radio" name="status" value="n" {% if current_status == 'n' %}checked{% endif %}>
                    <div class="selection-card-header">
                        <div class="selection-title">{{ lang.mod_announcements.admin.radio.publish_no }}</div>
                        <i class="bi bi-check-circle-fill selection-check-icon"></i>
                    </div>
                    <div class="selection-copy">{{ lang.mod_announcements.grid.unpublish.key }}</div>
                </label>
            </div>
        </div>

        <!-- Display in Featured (Deck) -->
        <div class="announcements-form-card">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.admin.columns.deck }}</h3>
            <div class="selection-grid" data-selection-group>
                {% set current_deck = deck|default(d.deck) %}
                <label class="selection-card{% if current_deck == 'y' %} active{% endif %}">
                    <input type="radio" name="deck" value="y" {% if current_deck == 'y' %}checked{% endif %}>
                    <div class="selection-card-header">
                        <div class="selection-title">{{ lang.mod_announcements.admin.radio.deck_yes }}</div>
                        <i class="bi bi-check-circle-fill selection-check-icon"></i>
                    </div>
                </label>
                <label class="selection-card{% if current_deck == 'n' %} active{% endif %}">
                    <input type="radio" name="deck" value="n" {% if current_deck == 'n' %}checked{% endif %}>
                    <div class="selection-card-header">
                        <div class="selection-title">{{ lang.mod_announcements.admin.radio.deck_no }}</div>
                        <i class="bi bi-check-circle-fill selection-check-icon"></i>
                    </div>
                </label>
            </div>
        </div>

        <!-- Summary (Intro) -->
        <div class="announcements-form-card">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.admin.columns.summary }}</h3>
            <div class="m3-input-wrapper mb-12">
                <textarea class="m3-input-lg" name="summary" id="announcement-summary" placeholder=" " maxlength="250">{{ summary|default(d.summary) }}</textarea>
                <label class="m3-floating-label">{{ lang.mod_announcements.admin.columns.summary }}</label>
                <div class="input-char-counter" id="summary-counter">0 / 250</div>
            </div>
        </div>

        <!-- Rich Editor Content -->
        <div class="announcements-form-card">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.admin.columns.content }}</h3>
            <div class="m3-input-wrapper editor-wrapper">
                <textarea id="announcement-content" name="content" placeholder=" ">{{ content|default(d.content) }}</textarea>
            </div>
        </div>

        <!-- Premium Image Uploader with 3:4 Cropper -->
        <div class="announcements-form-card form-card-compact">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.admin.columns.image }}</h3>
            {% include 'admin/partials/image_uploader.twig' with {
                shell_id: 'editImageShell',
                shell_class: '',
                has_image: d.image ? true : false,
                shell_attrs: {
                    'data-drop-title': lang.mod_announcements.wizard.image.drop_title,
                    'data-drop-description': lang.mod_announcements.wizard.image.drop_description,
                    'data-upload-link': lang.mod_announcements.wizard.image.upload_link,
                    'data-link-separator': lang.mod_announcements.wizard.image.link_separator,
                    'data-link-placeholder': lang.mod_announcements.wizard.image.link_placeholder,
                    'data-link-action': lang.mod_announcements.wizard.image.link_action,
                    'data-hint-loading': lang.mod_announcements.wizard.image.hint_loading,
                    'data-hint-invalid-type': lang.mod_announcements.wizard.image.hint_invalid_type,
                    'data-hint-no-drop-data': lang.mod_announcements.wizard.image.hint_no_drop_data,
                    'data-hint-remote-failed': lang.mod_announcements.wizard.image.hint_remote_failed,
                    'data-empty-name': lang.mod_announcements.wizard.summary.selected_none,
                    'data-empty-meta': lang.mod_announcements.wizard.image.drop_description,
                    'data-existing-image': d.image ? 'true' : 'false',
                    'data-existing-src': d.image ? (site.iaddress ~ 'mod_announcements/thumb/' ~ d.image) : '',
                    'data-existing-name': d.image ? d.image : '',
                    'data-existing-meta': lang.mod_announcements.admin.columns.image,
                    'data-remove-url': site.saddress ~ 'mod_announcements/image_remove_image',
                    'data-remove-id': d.id,
                    'data-remove-title': lang.mod_announcements.remove_image,
                    'data-remove-confirm': lang.mod_announcements.remove_image,
                    'data-remove-confirm-text': lang.mod_announcements.button.yes,
                    'data-remove-cancel-text': lang.mod_announcements.button.no,
                    'data-success-title': lang.mod_announcements.success,
                    'data-success-message': lang.mod_announcements.remove_image_success,
                    'data-error-title': lang.mod_announcements.error
                },
                dropzone_id: 'editImageDropzone',
                trigger_picker_js: "document.getElementById('editImgInput')?.click()",
                empty_state_id: 'editImageEmptyState',
                empty_hidden: d.image ? true : false,
                drop_title: lang.mod_announcements.wizard.image.drop_title,
                upload_link: lang.mod_announcements.wizard.image.upload_link,
                preview_card_id: 'editImagePreviewCard',
                remove_btn_id: 'editImageRemoveBtn',
                remove_action_js: 'window.announcementFormManager?.removeImage()',
                preview_img_id: 'editImgPreview',
                preview_alt: lang.mod_announcements.admin.columns.image,
                preview_hidden: d.image ? false : true,
                preview_src: d.image ? (site.iaddress ~ 'mod_announcements/thumb/' ~ d.image) : '',
                meta_id: 'editImageMeta',
                meta_hidden: d.image ? false : true,
                file_name_id: 'editImageFileName',
                file_name_text: d.image ? d.image : lang.mod_announcements.wizard.summary.selected_none,
                file_details_id: 'editImageFileDetails',
                file_details_text: lang.mod_announcements.wizard.image.drop_description,
                divider_hidden: d.image ? true : false,
                link_separator: lang.mod_announcements.wizard.image.link_separator,
                url_row_hidden: d.image ? true : false,
                url_input_id: 'editImageUrlInput',
                link_placeholder: lang.mod_announcements.wizard.image.link_placeholder,
                import_btn_id: 'editImageUrlImportBtn',
                link_action: lang.mod_announcements.wizard.image.link_action,
                file_input_id: 'editImgInput'
            } %}

            <!-- Embedded 3:4 Cropper Shell -->
            <div id="announcementFormCropperContainer" class="form-cropper-shell" hidden>
                <div class="form-cropper-header">
                    <div class="announcement-cropper-icon">
                        <i class="bi bi-aspect-ratio-fill"></i>
                    </div>
                    <div class="announcement-cropper-title-box">
                        <h4 class="announcement-cropper-title">{{ lang.mod_announcements.wizard.cropper.title }}</h4>
                        <p class="announcement-cropper-desc">{{ lang.mod_announcements.wizard.cropper.instruction }}</p>
                    </div>
                </div>

                <div class="form-cropper-checkerboard">
                    <img id="announcementFormCropperImage" src="" alt="Cropper Target">
                </div>

                <div class="cropper-toolbar-controls">
                    <button type="button" class="cropper-tool-btn" data-form-crop-action="zoom-out" title="{{ lang.mod_announcements.wizard.cropper.zoom_out }}" aria-label="{{ lang.mod_announcements.wizard.cropper.zoom_out }}">
                        <i class="bi bi-zoom-out"></i>
                    </button>
                    <button type="button" class="cropper-tool-btn" data-form-crop-action="zoom-in" title="{{ lang.mod_announcements.wizard.cropper.zoom_in }}" aria-label="{{ lang.mod_announcements.wizard.cropper.zoom_in }}">
                        <i class="bi bi-zoom-in"></i>
                    </button>
                    <button type="button" class="cropper-tool-btn" data-form-crop-action="rotate-left" title="{{ lang.mod_announcements.wizard.cropper.rotate_left }}" aria-label="{{ lang.mod_announcements.wizard.cropper.rotate_left }}">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                    <button type="button" class="cropper-tool-btn" data-form-crop-action="rotate-right" title="{{ lang.mod_announcements.wizard.cropper.rotate_right }}" aria-label="{{ lang.mod_announcements.wizard.cropper.rotate_right }}">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                    <button type="button" class="cropper-tool-btn cropper-tool-btn-reset" data-form-crop-action="reset" title="{{ lang.mod_announcements.wizard.cropper.reset }}" aria-label="{{ lang.mod_announcements.wizard.cropper.reset }}">
                        <i class="bi bi-aspect-ratio"></i>
                        <span>{{ lang.mod_announcements.wizard.cropper.reset }}</span>
                    </button>
                </div>

                <div class="cropper-actions-row">
                    <button type="button" class="cropper-cancel-btn" data-form-crop-action="cancel-crop">
                        {{ lang.mod_announcements.wizard.cropper.cancel }}
                    </button>
                    <button type="button" class="cropper-save-btn" data-form-crop-action="apply-crop">
                        <i class="bi bi-check-lg"></i>
                        <span>{{ lang.mod_announcements.wizard.cropper.apply }}</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Access Control (ACL) -->
        <div class="announcements-form-card">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.admin.columns.acl_id|raw }}</h3>
            <div class="m3-input-wrapper mb-0">
                <select class="m3-input-lg" name="acl_id">
                    {% set current_acl = acl_id|default(d.acl_id) %}
                    <option value="0" {% if current_acl == 0 %}selected{% endif %}>{{ lang.mod_announcements.choose_wish }}</option>
                    {% for item in mod_acl_acl_id %}
                        <option value="{{ item.id }}" {% if current_acl == item.id %}selected{% endif %}>{{ item.name|default(item.ad) }}</option>
                    {% endfor %}
                </select>
                <label class="m3-floating-label">{{ lang.mod_announcements.choose_wish }}</label>
            </div>
        </div>
    </form>
</div>
{% endblock %}

{% block fixed_bottom %}
{% if success is not defined %}
    <div class="announcements-bottom-bar">
        <a href="{{ site.saddress }}mod_announcements/list" class="cancel-btn">
            <i class="bi bi-arrow-left"></i>
            <span>{{ lang.mod_announcements.button.cancel }}</span>
        </a>
        <button type="submit" form="announcementEditForm" name="edit" value="1" class="save-btn" id="announcementSubmitBtn">
            <i class="bi bi-check2-circle"></i>
            <span>{{ lang.mod_announcements.button.edit }}</span>
        </button>
    </div>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="/templates/admin/assets/js/mod_announcements.js?v=6.0"></script>
{% endblock %}
