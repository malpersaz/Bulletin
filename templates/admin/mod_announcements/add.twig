{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}{{ lang.mod_announcements.add }}{% endblock %}
{% block headline %}{{ lang.mod_announcements.add }}{% endblock %}

{% block styles %}
<style>
    .announcements-form-shell { padding: 16px; padding-bottom: 120px; display: grid; gap: 16px; }
    .announcements-form-card { background: var(--md-sys-color-surface); border-radius: 20px; padding: 20px; box-shadow: var(--md-sys-elevation-1); display: grid; gap: 16px; position: relative; }
    .announcements-form-title { font-size: 15px; font-weight: 700; color: var(--md-sys-color-primary); margin: 0; }
    .form-status { border-radius: 16px; padding: 14px 16px; font-size: 14px; line-height: 1.5; }
    .form-status.error { background: #fce8e6; color: #b3261e; }
    .form-status.success { background: #e6f4ea; color: #1e4620; }
    
    .m3-input-wrapper { position: relative; width: 100%; margin-bottom: 8px; }
    .m3-input-lg { width: 100%; padding: 16px; border-radius: 16px; border: 1px solid var(--md-sys-color-outline); background: var(--md-sys-color-surface, #fff); color: var(--md-sys-color-on-surface); box-sizing: border-box; outline: none; min-height: 56px; display: block; font-family: inherit; font-size: 16px; }
    .m3-input-lg:focus { border-width: 2px; border-color: var(--md-sys-color-primary); padding: 15px; }
    textarea.m3-input-lg { min-height: 120px; resize: vertical; padding-top: 20px; }
    
    .m3-floating-label { position: absolute; top: 16px; left: 16px; background: var(--md-sys-color-surface, #fff); padding: 0 6px; color: var(--md-sys-color-on-surface-variant); pointer-events: none; transition: all 0.2s ease; z-index: 2; line-height: 1; }
    .m3-input-lg:focus + .m3-floating-label, 
    .m3-input-lg:not(:placeholder-shown) + .m3-floating-label, 
    select.m3-input-lg + .m3-floating-label, 
    textarea.m3-input-lg:focus + .m3-floating-label, 
    textarea.m3-input-lg:not(:placeholder-shown) + .m3-floating-label, 
    input[type="datetime-local"].m3-input-lg + .m3-floating-label { 
        top: -8px; 
        left: 12px; 
        font-size: 12px; 
        color: var(--md-sys-color-primary); 
        font-weight: 700;
        z-index: 5;
    }
    
    .selection-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .selection-card { border: 1px solid var(--md-sys-color-outline); border-radius: 16px; padding: 16px; display: grid; gap: 6px; cursor: pointer; transition: all 0.2s cubic-bezier(0.2, 0, 0, 1); background: var(--md-sys-color-surface-container-low, #faf8fc); position: relative; }
    .selection-card input { display: none; }
    .selection-card.active { border: 2px solid var(--md-sys-color-primary); padding: 15px; background: color-mix(in srgb, var(--md-sys-color-primary) 8%, var(--md-sys-color-surface, #fff)); box-shadow: var(--md-sys-elevation-1); }
    .selection-title { font-weight: 700; color: var(--md-sys-color-on-surface); }
    .selection-copy { font-size: 13px; color: var(--md-sys-color-on-surface-variant); }
    .selection-card.active .selection-title { color: var(--md-sys-color-primary); }
    
    .input-char-counter { position: absolute; right: 16px; bottom: -20px; font-size: 11px; font-weight: 700; color: var(--md-sys-color-on-surface-variant); }
    
    .announcements-bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1000; display: flex; gap: 12px; padding: 14px 16px 18px; background: color-mix(in srgb, var(--md-sys-color-surface) 90%, transparent); backdrop-filter: blur(12px); border-top: 1px solid var(--md-sys-color-outline-variant, rgba(0, 0, 0, 0.08)); }
    .announcements-bottom-bar a, .announcements-bottom-bar button { flex: 1; min-height: 52px; border-radius: 999px; border: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; font-weight: 700; cursor: pointer; }
    .announcements-bottom-bar .cancel-btn { background: var(--md-sys-color-surface); color: var(--md-sys-color-on-surface); border: 1px solid var(--md-sys-color-outline) !important; }
    .announcements-bottom-bar .save-btn { background: var(--md-sys-color-primary); color: var(--md-sys-color-on-primary); }
</style>
{% endblock %}

{% block content %}
<div class="announcements-form-shell">
    {% if success is defined %}
        <div class="form-status success">{{ message }}</div>
    {% endif %}
    {% if error is defined %}
        <div class="form-status error">{{ message }}</div>
    {% endif %}
    {% if errors is defined %}
        <div class="form-status error">
            {% for msg in errors %}
                <div>{{ msg }}</div>
            {% endfor %}
        </div>
    {% endif %}

    {% if site.lang|lower == 'ku' %}
        {% set upload_lang = {
            drop_title: 'Wêneya kapaxê bikişînin vir',
            drop_description: 'Pel bar bikin, pêve bikin an wêneyekî berdin.',
            upload_link: 'pelê hilbijêre',
            link_separator: 'AN DIKARÎ',
            link_placeholder: 'Navnîşana wêneyî (URL) pêve bike',
            link_action: 'Bişîne',
            hint_loading: 'Wêne tê barkirin...',
            hint_invalid_type: 'Tenê pelên wêneyan (JPG, PNG, GIF) têne piştgirîkirin.',
            hint_no_drop_data: 'Wêneyekî derbasdar nehate dîtin.',
            hint_remote_failed: 'Barkirina wêneyê nehişt.',
            selected_none: 'Wêne nehat hilbijartin'
        } %}
        {% set acl_label = 'Koma Gihîştinê (ACL)' %}
    {% else %}
        {% set upload_lang = {
            drop_title: 'Kapak görselini buraya sürükleyin',
            drop_description: 'Dosya yükleyin, yapıştırın veya sürükleyin.',
            upload_link: 'dosya seçin',
            link_separator: 'VEYA',
            link_placeholder: 'Görsel bağlantısını (URL) yapıştırın',
            link_action: 'İçe Aktar',
            hint_loading: 'Görsel yükleniyor...',
            hint_invalid_type: 'Sadece görsel dosyaları (JPG, PNG, GIF) desteklenir.',
            hint_no_drop_data: 'Geçerli bir görsel bulunamadı.',
            hint_remote_failed: 'Görsel kaynaktan çekilemedi.',
            selected_none: 'Görsel seçilmedi'
        } %}
        {% set acl_label = 'Erişim Grubu (ACL)' %}
    {% endif %}

    <form method="POST" action="" enctype="multipart/form-data" id="announcementAddForm" class="announcements-form-shell" style="padding:0; gap:16px;">
        <div class="announcements-form-card">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.information }}</h3>

            <!-- Language -->
            <div class="m3-input-wrapper">
                <select class="m3-input-lg" name="lang">
                    {% set selected_lang = form_lang|default(form_defaults.lang)|default(site.lang) %}
                    {% for item in lang_lang %}
                        {% if item.status == 'y' or item.seo == selected_lang %}
                            <option value="{{ item.seo }}" {% if item.seo == selected_lang %}selected{% endif %}>{{ item.name }} ({{ item.seo|upper }})</option>
                        {% endif %}
                    {% endfor %}
                </select>
                <label class="m3-floating-label">{{ lang.mod_announcements.admin.columns.language }}</label>
            </div>

            <!-- Title -->
            <div class="m3-input-wrapper" style="margin-bottom: 12px;">
                <input class="m3-input-lg" type="text" name="name" id="announcement-name" value="{{ name|default(form_defaults.name) }}" placeholder=" " oninput="syncAnnouncementMeta(); updateCharCounter('announcement-name', 'name-counter', 255)" maxlength="255" required>
                <label class="m3-floating-label">{{ lang.mod_announcements.admin.columns.ad }}</label>
                <div class="input-char-counter" id="name-counter">0 / 255</div>
            </div>

            <!-- SEO URL -->
            <div class="m3-input-wrapper">
                <input class="m3-input-lg" type="text" name="seo" id="announcement-seo" value="{{ seo|default(form_defaults.seo) }}" placeholder=" ">
                <label class="m3-floating-label">{{ lang.mod_announcements.admin.columns.seo }}</label>
            </div>

            <!-- Created At -->
            <div class="m3-input-wrapper">
                <input class="m3-input-lg" type="datetime-local" name="created_at" id="announcement-created-at" value="{{ created_at|default(form_defaults.created_at)|default('now'|date('Y-m-d') ~ 'T' ~ 'now'|date('H:i')) }}" placeholder=" " required>
                <label class="m3-floating-label">{{ lang.mod_announcements.admin.columns.tarih }}</label>
            </div>
        </div>

        <!-- Publish Status -->
        <div class="announcements-form-card">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.admin.columns.status }}</h3>
            <div class="selection-grid" data-selection-group>
                <label class="selection-card{% if status|default('y') == 'y' %} active{% endif %}">
                    <input type="radio" name="status" value="y" {% if status|default('y') == 'y' %}checked{% endif %}>
                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                        <div class="selection-title">{{ lang.mod_announcements.admin.radio.publish_yes }}</div>
                        <i class="bi bi-check-circle-fill selection-check-icon" style="color: var(--md-sys-color-primary); font-size: 20px; display: {% if status|default('y') == 'y' %}block{% else %}none{% endif %};"></i>
                    </div>
                    <div class="selection-copy">{{ lang.mod_announcements.grid.publish.key }}</div>
                </label>
                <label class="selection-card{% if status|default('y') == 'n' %} active{% endif %}">
                    <input type="radio" name="status" value="n" {% if status|default('y') == 'n' %}checked{% endif %}>
                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                        <div class="selection-title">{{ lang.mod_announcements.admin.radio.publish_no }}</div>
                        <i class="bi bi-check-circle-fill selection-check-icon" style="color: var(--md-sys-color-primary); font-size: 20px; display: {% if status|default('y') == 'n' %}block{% else %}none{% endif %};"></i>
                    </div>
                    <div class="selection-copy">{{ lang.mod_announcements.grid.unpublish.key }}</div>
                </label>
            </div>
        </div>

        <!-- Display in Featured -->
        <div class="announcements-form-card">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.admin.columns.deck }}</h3>
            <div class="selection-grid" data-selection-group>
                <label class="selection-card{% if deck|default('n') == 'y' %} active{% endif %}">
                    <input type="radio" name="deck" value="y" {% if deck|default('n') == 'y' %}checked{% endif %}>
                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                        <div class="selection-title">{{ lang.mod_announcements.admin.radio.deck_yes }}</div>
                        <i class="bi bi-check-circle-fill selection-check-icon" style="color: var(--md-sys-color-primary); font-size: 20px; display: {% if deck|default('n') == 'y' %}block{% else %}none{% endif %};"></i>
                    </div>
                </label>
                <label class="selection-card{% if deck|default('n') == 'n' %} active{% endif %}">
                    <input type="radio" name="deck" value="n" {% if deck|default('n') == 'n' %}checked{% endif %}>
                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                        <div class="selection-title">{{ lang.mod_announcements.admin.radio.deck_no }}</div>
                        <i class="bi bi-check-circle-fill selection-check-icon" style="color: var(--md-sys-color-primary); font-size: 20px; display: {% if deck|default('n') == 'n' %}block{% else %}none{% endif %};"></i>
                    </div>
                </label>
            </div>
        </div>

        <!-- Summary (Intro) -->
        <div class="announcements-form-card">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.admin.columns.summary }}</h3>
            <div class="m3-input-wrapper" style="margin-bottom: 12px;">
                <textarea class="m3-input-lg" name="summary" id="announcement-summary" placeholder=" " oninput="updateCharCounter('announcement-summary', 'summary-counter', 250)" maxlength="250">{{ summary|default(form_defaults.summary) }}</textarea>
                <label class="m3-floating-label">{{ lang.mod_announcements.admin.columns.summary }}</label>
                <div class="input-char-counter" id="summary-counter">0 / 250</div>
            </div>
        </div>

        <!-- Rich Editor Content -->
        <div class="announcements-form-card">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.admin.columns.content }}</h3>
            <div class="m3-input-wrapper" style="min-height: 400px; margin-bottom: 0;">
                <textarea id="announcement-content" name="content" placeholder=" ">{{ content|default(form_defaults.content) }}</textarea>
            </div>
        </div>

        <!-- Premium Image Uploader -->
        <div class="announcements-form-card" style="gap:12px;">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.admin.columns.image }}</h3>
            {% include 'admin/partials/image_uploader.twig' with {
                shell_id: 'editImageShell',
                shell_class: '',
                has_image: false,
                shell_attrs: {
                    'data-drop-title': upload_lang.drop_title,
                    'data-drop-description': upload_lang.drop_description,
                    'data-upload-link': upload_lang.upload_link,
                    'data-link-separator': upload_lang.link_separator,
                    'data-link-placeholder': upload_lang.link_placeholder,
                    'data-link-action': upload_lang.link_action,
                    'data-hint-loading': upload_lang.hint_loading,
                    'data-hint-invalid-type': upload_lang.hint_invalid_type,
                    'data-hint-no-drop-data': upload_lang.hint_no_drop_data,
                    'data-hint-remote-failed': upload_lang.hint_remote_failed,
                    'data-empty-name': upload_lang.selected_none,
                    'data-empty-meta': upload_lang.drop_description
                },
                dropzone_id: 'editImageDropzone',
                trigger_picker_js: 'triggerEditImagePicker()',
                empty_state_id: 'editImageEmptyState',
                drop_title: upload_lang.drop_title,
                upload_link: upload_lang.upload_link,
                preview_card_id: 'editImagePreviewCard',
                remove_btn_id: 'editImageRemoveBtn',
                remove_action_js: 'removeEditImage()',
                preview_img_id: 'editImgPreview',
                preview_alt: lang.mod_announcements.admin.columns.image,
                preview_hidden: true,
                meta_hidden: false,
                file_name_id: 'editImageFileName',
                file_name_text: upload_lang.selected_none,
                file_details_id: 'editImageFileDetails',
                file_details_text: upload_lang.drop_description,
                divider_hidden: false,
                link_separator: upload_lang.link_separator,
                url_row_hidden: false,
                url_input_id: 'editImageUrlInput',
                link_placeholder: upload_lang.link_placeholder,
                import_btn_id: 'editImageUrlImportBtn',
                link_action: upload_lang.link_action,
                file_input_id: 'editImgInput',
                file_input_onchange: 'previewEditImage(this)'
            } %}
        </div>

        <!-- Access Control (ACL) -->
        <div class="announcements-form-card">
            <h3 class="announcements-form-title">{{ lang.mod_announcements.admin.columns.acl_id|raw }}</h3>
            <div class="m3-input-wrapper" style="margin-bottom: 0;">
                <select class="m3-input-lg" name="acl_id">
                    <option value="0" {% if acl_id|default(0) == 0 %}selected{% endif %}>{{ lang.mod_announcements.choose_wish }}</option>
                    {% for item in mod_acl_acl_id %}
                        <option value="{{ item.id }}" {% if acl_id|default(0) == item.id %}selected{% endif %}>{{ item.ad }}</option>
                    {% endfor %}
                </select>
                <label class="m3-floating-label">{{ acl_label }}</label>
            </div>
        </div>
    </form>
</div>
{% endblock %}

{% block fixed_bottom %}
{% if success is not defined %}
    <div class="announcements-bottom-bar">
        <a href="{{ site.saddress }}mod_announcements/list" class="cancel-btn">
            <i class="bi bi-arrow-left"></i>
            <span>{{ lang.mod_announcements.button.vazgec }}</span>
        </a>
        <button type="submit" form="announcementAddForm" name="add" value="1" class="save-btn">
            <i class="bi bi-check2-circle"></i>
            <span>{{ lang.mod_announcements.button.add }}</span>
        </button>
    </div>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
function syncAnnouncementMeta() {
    const nameInput = document.getElementById('announcement-name');
    const seoInput = document.getElementById('announcement-seo');
    if (!nameInput || !seoInput) {
        return;
    }
    if (!seoInput.dataset.touched) {
        seoInput.value = nameInput.value
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9\s-]/g, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-');
    }
}

function updateCharCounter(inputId, counterId, maxLen) {
    const input = document.getElementById(inputId);
    const counter = document.getElementById(counterId);
    if (input && counter) {
        const len = input.value.length;
        counter.textContent = `${len} / ${maxLen}`;
        if (len > maxLen) {
            counter.style.color = 'var(--md-sys-color-error, #b3261e)';
        } else {
            counter.style.color = 'var(--md-sys-color-on-surface-variant)';
        }
    }
}

document.addEventListener('DOMContentLoaded', function () {
    const seoInput = document.getElementById('announcement-seo');
    if (seoInput) {
        seoInput.addEventListener('input', function () {
            seoInput.dataset.touched = '1';
        });
    }

    document.querySelectorAll('[data-selection-group]').forEach(function (group) {
        group.addEventListener('change', function (event) {
            if (event.target.type !== 'radio') return;
            group.querySelectorAll('.selection-card').forEach(function (card) {
                const isActive = card.contains(event.target);
                card.classList.toggle('active', isActive);
                const icon = card.querySelector('.selection-check-icon');
                if (icon) icon.style.display = isActive ? 'block' : 'none';
            });
        });
    });

    if (typeof window.initializeEditImageInteractions === 'function') {
        window.initializeEditImageInteractions();
    }

    if (typeof window.initRichEditor === 'function') {
        window.initRichEditor('#announcement-content', 400);
    }
    
    // Initial counter setup
    updateCharCounter('announcement-name', 'name-counter', 255);
    updateCharCounter('announcement-summary', 'summary-counter', 250);
});
</script>
<!-- wizard_content -->
{% endblock %}
