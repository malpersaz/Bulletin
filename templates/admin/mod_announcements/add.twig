{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set module_lang_key = 'mod_announcements' %}

{% block title %}{{ lang.mod_announcements.add }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/templates/admin/assets/css/mod_announcements_wizard.css?v=6.0">
{% endblock %}

{% block content %}
<form id="announcementWizardForm" method="POST" action="{{ site.saddress }}mod_announcements/add" enctype="multipart/form-data">
    <div id="announcementWizardShell" class="announcements-wizard-shell" data-wizard-lang="{{ lang.mod_announcements.wizard|default({})|json_encode|e('html_attr') }}">
        
        <!-- Wizard Header -->
        <header class="announcements-wizard-header">
            <button type="button" class="wizard-icon-btn" id="btnWizardClose" aria-label="{{ lang.mod_announcements.button.cancel }}">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="announcements-wizard-title-group">
                <span class="wizard-step-name" id="wizardStepName">{{ lang.mod_announcements.wizard.step.language }}</span>
                <span class="wizard-step-badge" id="wizardStepBadge">1/9</span>
            </div>
            <button type="button" class="wizard-text-btn" id="btnWizardQuickSave">
                {{ lang.mod_announcements.wizard.button.save }}
            </button>
        </header>

        <!-- Progress Bar -->
        <div class="announcements-wizard-progress-bar">
            <div class="announcements-wizard-progress-fill" id="wizardProgressFill"></div>
        </div>

        <!-- Wizard Scrollable Content -->
        <div class="announcements-wizard-content">

            <!-- Hidden Defaults and Tracking -->
            <input type="hidden" name="add" value="1">
            <input type="hidden" name="lang" id="wizardHiddenLang" value="{{ (selected_lang|default(site.lang))|lower }}">
            <input type="hidden" name="seo" id="wizardHiddenSeo" value="">
            <input type="hidden" name="deck" id="wizardHiddenDeck" value="n">
            <input type="hidden" name="acl_id" id="wizardHiddenAcl" value="0">
            <input type="hidden" name="status" id="wizardHiddenStatus" value="y">

            <!-- Step 1: Language -->
            <div class="wizard-step active" id="wizardStep1">
                <h2 class="wizard-step-headline">{{ lang.mod_announcements.wizard.step.language }}</h2>
                <p class="wizard-step-subhead">{{ lang.mod_announcements.wizard.subtitle.language }}</p>

                <div class="wizard-selection-grid grid-2col">
                    {% for item in lang_lang %}
                        {% if item.status == 'y' or item.seo|lower == (selected_lang|default(site.lang))|lower %}
                            <div class="wizard-selection-card{% if item.seo|lower == (selected_lang|default(site.lang))|lower %} active{% endif %}" data-wizard-select="lang" data-value="{{ item.seo|lower }}">
                                <div class="wizard-card-main">
                                    <div class="wizard-card-icon">{{ item.seo|upper }}</div>
                                    <div class="wizard-card-text">
                                        <div class="wizard-card-title">{{ item.name }}</div>
                                    </div>
                                </div>
                                <i class="bi bi-check2 wizard-card-check"></i>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            <!-- Step 2: Title -->
            <div class="wizard-step" id="wizardStep2">
                <h2 class="wizard-step-headline">{{ lang.mod_announcements.wizard.step.title }}</h2>
                <p class="wizard-step-subhead">{{ lang.mod_announcements.wizard.subtitle.title }}</p>

                <div class="wizard-input-wrapper">
                    <input type="text" class="wizard-input-lg" name="name" id="wizardTitleInput" placeholder=" " maxlength="70" autocomplete="off">
                    <label class="wizard-floating-label" for="wizardTitleInput">{{ lang.mod_announcements.wizard.label.announcement_title }}</label>
                </div>
                <div class="wizard-char-counter" id="wizardTitleCounter">0 / 70</div>
                <div class="wizard-validation-msg" id="wizardTitleMsg">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>{{ lang.mod_announcements.validator.title_length }}</span>
                </div>
            </div>

            <!-- Step 3: Date -->
            <div class="wizard-step" id="wizardStep3">
                <h2 class="wizard-step-headline">{{ lang.mod_announcements.wizard.step.date }}</h2>
                <p class="wizard-step-subhead">{{ lang.mod_announcements.wizard.subtitle.date }}</p>

                <div class="wizard-input-wrapper">
                    <input type="datetime-local" class="wizard-input-lg" name="created_at" id="wizardDateInput">
                </div>
            </div>

            <!-- Step 4: Introduction (Deck) -->
            <div class="wizard-step" id="wizardStep4">
                <h2 class="wizard-step-headline">{{ lang.mod_announcements.wizard.step.intro }}</h2>
                <p class="wizard-step-subhead">{{ lang.mod_announcements.wizard.subtitle.intro }}</p>

                <div class="wizard-input-wrapper">
                    <textarea class="wizard-input-lg wizard-textarea-lg" name="summary" id="wizardIntroInput" placeholder=" " rows="4" maxlength="120"></textarea>
                    <label class="wizard-floating-label" for="wizardIntroInput">{{ lang.mod_announcements.wizard.label.intro_text }}</label>
                </div>
                <div class="wizard-char-counter" id="wizardIntroCounter">0 / 120</div>
                <div class="wizard-validation-msg" id="wizardIntroMsg">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>{{ lang.mod_announcements.validator.deck_length }}</span>
                </div>
            </div>

            <!-- Step 5: Content -->
            <div class="wizard-step" id="wizardStep5">
                <h2 class="wizard-step-headline">{{ lang.mod_announcements.wizard.step.content }}</h2>
                <p class="wizard-step-subhead">{{ lang.mod_announcements.wizard.subtitle.content }}</p>

                <div class="wizard-editor-frame">
                    <textarea name="content" id="wizardContentTextarea"></textarea>
                </div>
            </div>

            <!-- Step 6: Image -->
            <div class="wizard-step" id="wizardStep6">
                <h2 class="wizard-step-headline">{{ lang.mod_announcements.wizard.step.image }}</h2>
                <p class="wizard-step-subhead">{{ lang.mod_announcements.wizard.subtitle.image }}</p>

                {% include 'admin/partials/image_uploader.twig' with {
                    shell_id: 'wizardImageShell',
                    shell_class: '',
                    has_image: false,
                    shell_attrs: {
                        'data-drop-title': lang.mod_announcements.wizard.image.drop_title,
                        'data-drop-description': lang.mod_announcements.wizard.image.drop_description,
                        'data-upload-link': lang.mod_announcements.wizard.image.upload_link,
                        'data-link-separator': lang.mod_announcements.wizard.image.link_separator,
                        'data-link-placeholder': lang.mod_announcements.wizard.image.link_placeholder,
                        'data-link-action': lang.mod_announcements.wizard.image.link_action,
                        'data-hint-loading': lang.mod_announcements.wizard.image.hint_loading,
                        'data-hint-invalid-type': lang.mod_announcements.wizard.image.hint_invalid_type,
                        'data-hint-no-drop-data': lang.mod_announcements.wizard.image.hint_no_drop_data,
                        'data-hint-remote-failed': lang.mod_announcements.wizard.image.hint_remote_failed,
                        'data-empty-name': lang.mod_announcements.wizard.summary.selected_none,
                        'data-empty-meta': lang.mod_announcements.wizard.image.drop_description
                    },
                    dropzone_id: 'wizardImageDropzone',
                    trigger_picker_js: '',
                    empty_state_id: 'wizardImageEmptyState',
                    empty_hidden: false,
                    drop_title: lang.mod_announcements.wizard.image.drop_title,
                    upload_link: lang.mod_announcements.wizard.image.upload_link,
                    preview_card_id: 'wizardImagePreviewCard',
                    remove_btn_id: 'wizardImageRemoveBtn',
                    remove_action_js: '',
                    preview_img_id: 'wizardImgPreview',
                    preview_alt: lang.mod_announcements.admin.columns.image,
                    preview_hidden: true,
                    meta_id: 'wizardImageMeta',
                    meta_hidden: true,
                    file_name_id: 'wizardImageFileName',
                    file_name_text: lang.mod_announcements.wizard.summary.selected_none,
                    file_details_id: 'wizardImageFileDetails',
                    file_details_text: lang.mod_announcements.wizard.image.drop_description,
                    divider_hidden: false,
                    link_separator: lang.mod_announcements.wizard.image.link_separator,
                    url_row_hidden: false,
                    url_input_id: 'wizardImageUrlInput',
                    link_placeholder: lang.mod_announcements.wizard.image.link_placeholder,
                    import_btn_id: 'wizardImageUrlImportBtn',
                    link_action: lang.mod_announcements.wizard.image.link_action,
                    file_input_id: 'wizardImgInput'
                } %}
            </div>

            <!-- Step 7: Display in Featured -->
            <div class="wizard-step" id="wizardStep7">
                <h2 class="wizard-step-headline">{{ lang.mod_announcements.wizard.step.featured }}</h2>
                <p class="wizard-step-subhead">{{ lang.mod_announcements.wizard.subtitle.featured }}</p>

                <div class="wizard-selection-grid">
                    <div class="wizard-selection-card" data-wizard-select="deck" data-value="y">
                        <div class="wizard-card-main">
                            <div class="wizard-card-icon">
                                <i class="bi bi-stars"></i>
                            </div>
                            <div class="wizard-card-text">
                                <div class="wizard-card-title">{{ lang.mod_announcements.wizard.label.featured_yes }}</div>
                                <div class="wizard-card-desc">{{ lang.mod_announcements.wizard.label.featured_yes_desc }}</div>
                            </div>
                        </div>
                        <i class="bi bi-check2 wizard-card-check"></i>
                    </div>

                    <div class="wizard-selection-card active" data-wizard-select="deck" data-value="n">
                        <div class="wizard-card-main">
                            <div class="wizard-card-icon">
                                <i class="bi bi-card-text"></i>
                            </div>
                            <div class="wizard-card-text">
                                <div class="wizard-card-title">{{ lang.mod_announcements.wizard.label.featured_no }}</div>
                                <div class="wizard-card-desc">{{ lang.mod_announcements.wizard.label.featured_no_desc }}</div>
                            </div>
                        </div>
                        <i class="bi bi-check2 wizard-card-check"></i>
                    </div>
                </div>
            </div>

            <!-- Step 8: ACL -->
            <div class="wizard-step" id="wizardStep8">
                <h2 class="wizard-step-headline">{{ lang.mod_announcements.wizard.step.acl }}</h2>
                <p class="wizard-step-subhead">{{ lang.mod_announcements.wizard.subtitle.acl }}</p>

                <div class="wizard-selection-grid">
                    <div class="wizard-selection-card active" data-wizard-select="acl" data-value="0">
                        <div class="wizard-card-main">
                            <div class="wizard-card-icon">
                                <i class="bi bi-globe2"></i>
                            </div>
                            <div class="wizard-card-text">
                                <div class="wizard-card-title">{{ lang.mod_announcements.wizard.label.acl_public }}</div>
                                <div class="wizard-card-desc">{{ lang.mod_announcements.wizard.label.acl_public_desc }}</div>
                            </div>
                        </div>
                        <i class="bi bi-check2 wizard-card-check"></i>
                    </div>

                    {% for item in mod_acl_acl_id %}
                        <div class="wizard-selection-card" data-wizard-select="acl" data-value="{{ item.id }}">
                            <div class="wizard-card-main">
                                <div class="wizard-card-icon">
                                    <i class="bi bi-shield-lock"></i>
                                </div>
                                <div class="wizard-card-text">
                                    <div class="wizard-card-title">{{ item.name|default(item.ad) }}</div>
                                    <div class="wizard-card-desc">ACL #{{ item.id }}</div>
                                </div>
                            </div>
                            <i class="bi bi-check2 wizard-card-check"></i>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Step 9: Publish Status -->
            <div class="wizard-step" id="wizardStep9">
                <h2 class="wizard-step-headline">{{ lang.mod_announcements.wizard.step.finish }}</h2>
                <p class="wizard-step-subhead">{{ lang.mod_announcements.wizard.subtitle.finish }}</p>

                <div class="wizard-selection-grid">
                    <div class="wizard-selection-card active" data-wizard-select="status" data-value="y">
                        <div class="wizard-card-main">
                            <div class="wizard-card-icon">
                                <i class="bi bi-cloud-check"></i>
                            </div>
                            <div class="wizard-card-text">
                                <div class="wizard-card-title">{{ lang.mod_announcements.wizard.label.publish_yes }}</div>
                                <div class="wizard-card-desc">{{ lang.mod_announcements.wizard.label.publish_yes_desc }}</div>
                            </div>
                        </div>
                        <i class="bi bi-check2 wizard-card-check"></i>
                    </div>

                    <div class="wizard-selection-card" data-wizard-select="status" data-value="n">
                        <div class="wizard-card-main">
                            <div class="wizard-card-icon">
                                <i class="bi bi-pencil-square"></i>
                            </div>
                            <div class="wizard-card-text">
                                <div class="wizard-card-title">{{ lang.mod_announcements.wizard.label.publish_no }}</div>
                                <div class="wizard-card-desc">{{ lang.mod_announcements.wizard.label.publish_no_desc }}</div>
                            </div>
                        </div>
                        <i class="bi bi-check2 wizard-card-check"></i>
                    </div>
                </div>

                <!-- Wizard Summary Card -->
                <div class="wizard-summary-card">
                    <h4 class="wizard-summary-title">
                        <i class="bi bi-card-checklist"></i>
                        <span>{{ lang.mod_announcements.wizard.summary.title }}</span>
                    </h4>
                    <div class="wizard-summary-list">
                        <div class="wizard-summary-item">
                            <span class="wizard-summary-label"><i class="bi bi-translate"></i> {{ lang.mod_announcements.wizard.summary.lang }}</span>
                            <span class="wizard-summary-value" id="sumWizardLang">{{ (selected_lang|default(site.lang))|upper }}</span>
                        </div>
                        <div class="wizard-summary-item">
                            <span class="wizard-summary-label"><i class="bi bi-type-h1"></i> {{ lang.mod_announcements.wizard.summary.name }}</span>
                            <span class="wizard-summary-value" id="sumWizardTitle">-</span>
                        </div>
                        <div class="wizard-summary-item">
                            <span class="wizard-summary-label"><i class="bi bi-calendar3"></i> {{ lang.mod_announcements.wizard.summary.date }}</span>
                            <span class="wizard-summary-value" id="sumWizardDate">-</span>
                        </div>
                        <div class="wizard-summary-item">
                            <span class="wizard-summary-label"><i class="bi bi-stars"></i> {{ lang.mod_announcements.wizard.summary.featured }}</span>
                            <span class="wizard-summary-badge badge-draft" id="sumWizardFeatured">{{ lang.mod_announcements.wizard.label.featured_no }}</span>
                        </div>
                        <div class="wizard-summary-item">
                            <span class="wizard-summary-label"><i class="bi bi-shield-check"></i> {{ lang.mod_announcements.wizard.summary.acl }}</span>
                            <span class="wizard-summary-value" id="sumWizardAcl">{{ lang.mod_announcements.wizard.label.acl_public }}</span>
                        </div>
                        <div class="wizard-summary-item">
                            <span class="wizard-summary-label"><i class="bi bi-broadcast"></i> {{ lang.mod_announcements.wizard.summary.status }}</span>
                            <span class="wizard-summary-badge badge-success" id="sumWizardStatus">{{ lang.mod_announcements.wizard.label.publish_yes }}</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Wizard Fixed Footer -->
        <footer class="announcements-wizard-footer">
            <button type="button" class="wizard-btn-prev" id="btnWizardPrev" disabled>
                <i class="bi bi-arrow-left"></i>
                <span>{{ lang.mod_announcements.wizard.button.prev }}</span>
            </button>
            <button type="button" class="wizard-btn-next" id="btnWizardNext">
                <span>{{ lang.mod_announcements.wizard.button.next }}</span>
                <i class="bi bi-arrow-right"></i>
            </button>
            <button type="button" class="wizard-btn-finish" id="btnWizardFinish">
                <i class="bi bi-check2-circle"></i>
                <span>{{ lang.mod_announcements.wizard.button.finish }}</span>
            </button>
        </footer>

    </div>
</form>
{% endblock %}

{% block scripts %}
<script src="/templates/admin/assets/js/mod_announcements_wizard.js?v=6.0"></script>
{% endblock %}
