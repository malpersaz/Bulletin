{% extends 'admin/layout.twig' %}

{% set module_lang_key = 'mod_acl' %}
{% set hide_navbar = true %}
{% set hide_fab = true %}
{% set show_search = true %}
{% set show_search_filter_button = false %}
{% set search_placeholder = lang.mod_acl.admin.search_placeholder %}

{% block title %}
    {{ lang.mod_acl.list }}
{% endblock %}

{% block headline %}
    {{ lang.mod_acl.list }}
{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="/templates/admin/assets/css/mod_acl.css?v=1.0">
{% endblock %}

{% block content %}
    <div class="acl-list-container">
        {% if success is defined %}
            <div class="acl-banner-success">
                <i class="bi bi-check-circle-fill"></i>
                <span>{{ message }}</span>
            </div>
        {% endif %}

        <!-- Pull-to-refresh spinner -->
        <div id="pull-spinner" class="acl-pull-spinner d-none">
            <div class="acl-spinner"></div>
        </div>

        <!-- ACL Cards Container -->
        <div id="acl-list-container"></div>

        <!-- Empty State -->
        <div id="empty-state" class="acl-empty-state d-none">
            <i class="bi bi-shield-slash"></i>
            <h3>{{ lang.mod_acl.grid.no_data }}</h3>
        </div>

        <!-- Loading spinner -->
        <div id="infinite-loader" class="acl-infinite-loader">
            <div class="acl-spinner"></div>
        </div>
    </div>

    <!-- Hidden filter form -->
    <form id="filterForm" class="d-none">
        <input type="text" name="search[name]" id="filterSearch" value="">
    </form>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <a href="{{ site.saddress }}management" class="toolbar-item" title="{{ lang.mod_acl.button.cancel }}">
            <i class="bi bi-chevron-left"></i>
        </a>

        {% if session.permissions.mod_acl.delete is defined %}
            <button type="button" class="toolbar-item" id="toolbarDelete" title="{{ lang.mod_acl.button.delete }}">
                <i class="bi bi-trash-fill"></i>
            </button>
        {% endif %}
    </div>

    {% if session.permissions.mod_acl.add is defined %}
        <!-- Main FAB Button -->
        <a href="{{ site.saddress }}mod_acl/add" class="main-fab" id="mainFab" aria-label="{{ lang.mod_acl.button.new_role }}">
            <i class="bi bi-plus-lg"></i>
        </a>
    {% endif %}
{% endblock %}

{% block scripts %}
    <script>
        window.MOD_ACL_CONFIG = {
            siteAddress: {{ site.saddress|json_encode|raw }},
            permissions: {
                canEdit: {{ (session.permissions.mod_acl.edit is defined)|json_encode|raw }},
                canDelete: {{ (session.permissions.mod_acl.delete is defined)|json_encode|raw }}
            },
            lang: {
                edit: {{ lang.mod_acl.button.edit|json_encode|raw }},
                delete: {{ lang.mod_acl.button.delete|json_encode|raw }},
                page: {{ lang.mod_acl.grid.page|json_encode|raw }},
                confirmTitle: {{ lang.mod_acl.confirm_title|json_encode|raw }},
                removeRecord: {{ lang.mod_acl.remove_record|json_encode|raw }},
                yes: {{ lang.mod_acl.button.yes|json_encode|raw }},
                no: {{ lang.mod_acl.button.no|json_encode|raw }},
                successTitle: {{ lang.mod_acl.success_title|json_encode|raw }},
                errorTitle: {{ lang.mod_acl.error_title|json_encode|raw }},
                records: {{ lang.mod_acl.records|json_encode|raw }}
            }
        };
        window.MOD_ACL_FLASH = {
            error: {{ (error is defined ? message : '')|json_encode|raw }},
            errors: {{ (errors is defined ? errors : [])|json_encode|raw }},
            success: {{ (success is defined ? message : '')|json_encode|raw }},
            buttonOk: {{ lang.mod_acl.button.ok|json_encode|raw }}
        };
    </script>
    <script src="/templates/admin/assets/js/mod_acl.js?v=1.0"></script>
{% endblock %}
