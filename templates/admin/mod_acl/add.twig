{% extends 'admin/layout.twig' %}

{% set module_lang_key = 'mod_acl' %}
{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}
    {{ lang.mod_acl.add }}
{% endblock %}

{% block headline %}
    {{ lang.mod_acl.add }}
{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="/templates/admin/assets/css/mod_acl.css?v=1.0">
{% endblock %}

{% block content %}
    <form id="addForm" method="POST" action="{{ site.saddress }}mod_acl/add" enctype="multipart/form-data">
        <input type="hidden" name="add" value="1">

        <div class="acl-container">
            {% if success is defined %}
                <div class="acl-banner-success">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>{{ message }}</span>
                </div>
            {% endif %}

            <div class="acl-card-form">
                <div class="acl-form-row">
                    <div class="acl-input-wrapper">
                        <input type="text" class="acl-input-lg" name="name" id="name" placeholder=" " autocomplete="off" value="{{ name }}" required>
                        <label for="name" class="acl-floating-label">{{ lang.mod_acl.admin.columns.name }}</label>
                    </div>
                </div>
            </div>

            <div class="acl-card-form">
                <div class="acl-card-header">
                    <i class="bi bi-shield-lock"></i>
                    <h3>{{ lang.mod_acl.admin.columns.acl }}</h3>
                </div>

                <div class="acl-form-row">
                    <p class="acl-form-description">{{ lang.mod_acl.message.information.select_roles }}</p>
                    <div class="acl-selection-grid">
                        {% for group in _group_list %}
                            <label class="acl-selection-card">
                                <i class="bi bi-key acl-selection-icon"></i>
                                <div class="acl-selection-label">{{ group.name }}</div>
                                <i class="bi bi-check-circle-fill acl-check-icon"></i>
                                <input type="checkbox" name="group_id[{{ group.group_id }}]" value="{{ group.group_id }}" class="acl-hidden-checkbox">
                            </label>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}

{% block fixed_bottom %}
    <div class="m3-final-bar">
        <a href="{{ site.saddress }}mod_acl/list" class="m3-btn-half m3-btn-half-neutral">
            <i class="bi bi-x-lg"></i>
            {{ lang.mod_acl.button.cancel }}
        </a>
        <button type="button" id="submitAddBtn" class="m3-btn-half m3-btn-half-primary">
            <i class="bi bi-plus-lg"></i>
            {{ lang.mod_acl.button.add }}
        </button>
    </div>
{% endblock %}

{% block scripts %}
    <script>
        window.MOD_ACL_FLASH = {
            error: {{ (error is defined ? message : '')|json_encode|raw }},
            errors: {{ (errors is defined ? errors : [])|json_encode|raw }},
            success: {{ (success is defined ? message : '')|json_encode|raw }},
            redirectAfter: {{ (success is defined ? site.saddress ~ 'mod_acl/list' : '')|json_encode|raw }},
            buttonOk: {{ lang.mod_acl.button.ok|json_encode|raw }}
        };
    </script>
    <script src="/templates/admin/assets/js/mod_acl.js?v=1.0"></script>
{% endblock %}
