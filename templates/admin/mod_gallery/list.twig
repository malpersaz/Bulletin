{% set module_lang_key = 'mod_gallery' %}
{% set hide_navbar = true %}
{% set hide_fab = true %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_gallery.admin.title }}{% endblock %}

{% block headline %}{{ lang.mod_gallery.admin.list_title }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/mod_gallery.css?v=2.0">
{% endblock %}

{% block content %}
<div class="gallery-list-container">
    <!-- Interactive Top Stats Row -->
    <div class="gallery-stats-row" role="tablist" aria-label="Filter Galleries">
        <button type="button" class="gallery-stat-card active" data-module="all" role="tab" aria-selected="true">
            <span class="gallery-stat-value">{{ total_galleries }}</span>
            <span class="gallery-stat-label">{{ lang.mod_gallery.admin.list_title }}</span>
        </button>
        {% for m in gallery_modules %}
            <button type="button" class="gallery-stat-card" data-module="{{ m.mod_name }}" role="tab" aria-selected="false">
                <span class="gallery-stat-value">{{ m.count }}</span>
                <span class="gallery-stat-label">{{ m.label }}</span>
            </button>
        {% endfor %}
        <div class="gallery-stat-card" data-module="images_count_stat">
            <span class="gallery-stat-value">{{ total_images }}</span>
            <span class="gallery-stat-label">{{ lang.mod_gallery.grid.image_count }}</span>
        </div>
    </div>

    <!-- Search Bar Component -->
    <div class="gallery-search-wrap">
        <i class="bi bi-search gallery-search-icon" aria-hidden="true"></i>
        <input type="text" id="gallerySearchInput" class="gallery-search-input" placeholder="{{ lang.mod_gallery.admin.search_placeholder }}" autocomplete="off" spellcheck="false" aria-label="{{ lang.mod_gallery.admin.search_placeholder }}">
        <button type="button" id="gallerySearchClear" class="gallery-search-clear" aria-label="{{ lang.mod_gallery.admin.clear_search }}">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- Results Count Bar -->
    <div class="gallery-results-meta">
        <span>
            <strong id="galleryResultsCount">{{ total_galleries }}</strong> {{ lang.mod_gallery.admin.list_title }}
        </span>
        <span>{{ total_images }} {{ lang.mod_gallery.grid.image_count }}</span>
    </div>

    <!-- Gallery Cards List (SSR) -->
    <div id="galleryCardsList" class="gallery-cards-list">
        {% for item in galleries %}
            <a href="{{ item.url }}" class="gallery-album-card" data-title="{{ item.name }}" data-module="{{ item.mod_name }}" data-key="{{ item.id }}" title="{{ item.name }}">
                <div class="gallery-stack-wrap">
                    {% if item.preview_urls|length >= 3 %}
                        <div class="gallery-stack-layer">
                            <img class="gallery-stack-img" src="{{ item.preview_urls[2] }}" alt="" loading="lazy">
                        </div>
                        <div class="gallery-stack-layer">
                            <img class="gallery-stack-img" src="{{ item.preview_urls[1] }}" alt="" loading="lazy">
                        </div>
                        <div class="gallery-stack-layer is-front">
                            <img class="gallery-stack-img" src="{{ item.preview_urls[0] }}" alt="{{ item.name }}" loading="lazy">
                        </div>
                    {% elseif item.preview_urls|length == 2 %}
                        <div class="gallery-stack-layer">
                            <img class="gallery-stack-img" src="{{ item.preview_urls[1] }}" alt="" loading="lazy">
                        </div>
                        <div class="gallery-stack-layer is-front">
                            <img class="gallery-stack-img" src="{{ item.preview_urls[0] }}" alt="{{ item.name }}" loading="lazy">
                        </div>
                    {% elseif item.preview_urls|length == 1 %}
                        <div class="gallery-stack-layer is-front">
                            <img class="gallery-stack-img" src="{{ item.preview_urls[0] }}" alt="{{ item.name }}" loading="lazy">
                        </div>
                    {% else %}
                        <div class="gallery-stack-layer is-front">
                            <div class="gallery-stack-empty">
                                <i class="bi bi-images"></i>
                            </div>
                        </div>
                    {% endif %}
                </div>
                <div class="gallery-card-body">
                    <h3 class="gallery-card-title">{{ item.name }}</h3>
                    <div class="gallery-card-badges">
                        <span class="gallery-badge-count">
                            <i class="bi bi-images"></i>
                            <span>{{ item.image_count }}</span>
                        </span>
                        <span class="gallery-badge-module">{{ item.mod_label }}</span>
                    </div>
                </div>
                <div class="gallery-card-chevron" aria-hidden="true">
                    <i class="bi bi-chevron-right"></i>
                </div>
            </a>
        {% else %}
            <div class="gallery-empty-state">
                <div class="gallery-empty-icon">
                    <i class="bi bi-folder2-open"></i>
                </div>
                <h3 class="gallery-empty-title">{{ lang.mod_gallery.admin.no_galleries }}</h3>
                <p class="gallery-empty-desc">{{ lang.mod_gallery.admin.no_results }}</p>
            </div>
        {% endfor %}
    </div>

    <!-- Empty Search State Component -->
    <div id="galleryEmptyState" class="gallery-empty-state is-hidden">
        <div class="gallery-empty-icon">
            <i class="bi bi-folder2-open"></i>
        </div>
        <h3 class="gallery-empty-title">{{ lang.mod_gallery.admin.no_results }}</h3>
        <p class="gallery-empty-desc">{{ lang.mod_gallery.admin.no_filtered_images }}</p>
        <button type="button" id="galleryEmptyReset" class="gallery-empty-reset">
            {{ lang.mod_gallery.admin.clear_search }}
        </button>
    </div>
</div>
{% endblock %}

{% block fixed_bottom %}
<nav class="gallery-bottom-bar" aria-label="Gallery Toolbar">
    <!-- Slot 1: Back -->
    <button type="button" class="gallery-toolbar-btn" data-gallery-action="back" title="{{ lang.mod_gallery.admin.back }}" aria-label="{{ lang.mod_gallery.admin.back }}">
        <i class="bi bi-chevron-left"></i>
    </button>

    <!-- Slot 2: Search Focus -->
    <button type="button" class="gallery-toolbar-btn" data-gallery-action="focus-search" title="{{ lang.mod_gallery.admin.search_placeholder }}" aria-label="{{ lang.mod_gallery.admin.search_placeholder }}">
        <i class="bi bi-search"></i>
    </button>

    <!-- Slot 3: Refresh -->
    <button type="button" class="gallery-toolbar-btn" data-gallery-action="refresh" title="{{ lang.mod_gallery.admin.browse_description }}" aria-label="{{ lang.mod_gallery.admin.browse_description }}">
        <i class="bi bi-arrow-clockwise"></i>
    </button>

    <!-- Slot 5: Categories / Modules -->
    <a href="{{ site.saddress }}mod_imagecategories/list" class="gallery-toolbar-btn" title="{{ lang.management.image_gallery }}" aria-label="{{ lang.management.image_gallery }}">
        <i class="bi bi-folder2-open"></i>
    </a>

    <!-- Slot 6: Scroll to top -->
    <button type="button" class="gallery-toolbar-btn" data-gallery-action="scroll-top" title="{{ lang.mod_gallery.admin.toolbar_start }}" aria-label="{{ lang.mod_gallery.admin.toolbar_start }}">
        <i class="bi bi-arrow-up"></i>
    </button>

    <!-- Slot 7: Dashboard / Home -->
    <a href="{{ site.saddress }}management/dashboard" class="gallery-toolbar-btn" title="{{ lang.management.dashboard }}" aria-label="{{ lang.management.dashboard }}">
        <i class="bi bi-house-door"></i>
    </a>
</nav>
{% endblock %}

{% block scripts %}
<script src="{{ site.address }}templates/admin/assets/js/mod_gallery_list.js?v=2.0"></script>
{% endblock %}
