{% set module_lang_key = 'mod_gallery' %}
{% set hide_navbar = true %}
{% set hide_fab = true %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_gallery.admin.title }}{% endblock %}

{% block headline %}{{ lang.mod_gallery.admin.list_title }}{% endblock %}

{% block styles %}
<style>
    .gallery-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
        padding: 16px;
    }
    .gallery-card {
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: 24px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        transition: all 0.3s cubic-bezier(0.2, 0, 0, 1);
        cursor: pointer;
        position: relative;
    }
    .gallery-card:hover {
        background: var(--md-sys-color-surface-container-high);
        transform: translateY(-4px);
        box-shadow: var(--md-sys-elevation-level2);
        border-color: var(--md-sys-color-primary-container);
    }
    .gallery-card__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }
    .gallery-card__info {
        flex: 1;
    }
    .gallery-card__title {
        font-size: 18px;
        font-weight: 500;
        color: var(--md-sys-color-on-surface);
        margin: 0;
        line-height: 1.2;
    }
    .gallery-card__subtitle {
        font-size: 12px;
        color: var(--md-sys-color-on-surface-variant);
        margin-top: 4px;
    }
    .gallery-card__stats {
        display: flex;
        gap: 12px;
        margin-top: 8px;
    }
    .stat-badge {
        background: var(--md-sys-color-secondary-container);
        color: var(--md-sys-color-on-secondary-container);
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .gallery-card__actions {
        display: flex;
        gap: 8px;
        margin-top: auto;
    }
    .gallery-card__actions .action-btn {
        flex: 1;
        height: 40px;
        border-radius: 12px;
        font-size: 13px;
    }
</style>
{% endblock %}

{% block content %}
<div class="m3-card" style="margin: 16px; border-radius: 24px; overflow: hidden;">
    <!-- Toolbar -->
    <div style="padding: 16px; display: flex; align-items: center; gap: 16px; border-bottom: 1px solid var(--md-sys-color-outline-variant);">
        <div class="m3-search-bar" style="flex: 1;">
            <i class="bi bi-search"></i>
            <input type="text" id="gallerySearch" placeholder="{{ lang.mod_gallery.admin.search_placeholder }}" onkeyup="GalleryManager.search(this.value)">
        </div>
        <a href="{{ site.sadres }}mod_gallery_mod/add" class="m3-btn-filled" style="border-radius: 16px;">
            <i class="bi bi-plus-lg"></i>
            <span>{{ lang.mod_gallery.admin.create_gallery }}</span>
        </a>
    </div>

    <!-- Gallery Grid -->
    <div id="galleryGrid" class="gallery-cards">
        <!-- Loaded via AJAX -->
        <div class="loading-state" style="grid-column: 1/-1; padding: 100px; text-align: center;">
            <div class="spinner-border text-primary" role="status"></div>
            <p style="margin-top: 16px; color: var(--md-sys-color-on-surface-variant);">{{ lang.mod_gallery.admin.loading_galleries }}</p>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ site.adres }}templates/admin/assets/js/mod_gallery.js"></script>
<script>
    GalleryManager.init({
        baseUrl: '{{ site.sadres }}mod_gallery/',
        listUrl: '{{ site.sadres }}mod_gallery/ajax_list',
        lang: {
            images: '{{ lang.mod_gallery.grid.image_count }}',
            no_galleries: '{{ lang.mod_gallery.admin.no_galleries }}',
            no_results: '{{ lang.mod_gallery.admin.no_results }}',
            load_failed: '{{ lang.mod_gallery.errors.load_failed }}',
            view_images: '{{ lang.mod_gallery.admin.add_images }}',
            delete: '{{ lang.mod_gallery.admin.remove_image }}'
        }
    });

    // Initial load
    GalleryManager.loadGalleries();
</script>
{% endblock %}
