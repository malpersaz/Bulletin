    function openUploadSheet() {
        GalleryManager.exitSelectionMode();
        GalleryManager.closeToolsSheet();
        GalleryManager.closeDetailSheet();
        document.getElementById('uploadSheet').classList.add('active');
    }

    function closeUploadSheet() {
        if (GalleryManager.isUploading) {
            return;
        }
        document.getElementById('uploadSheet').classList.remove('active');
        GalleryManager.resetUpload();
    }

    const initGalleryUI = function () {
        GalleryManager.sortImages(document.getElementById('gallerySortSelect')?.value || 'newest');
        GalleryManager.filterImages('');
        GalleryManager.openFirstVisibleImage();
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGalleryUI);
    } else {
        setTimeout(initGalleryUI, 50);
    }
