{% set module_lang_key = 'mod_gallery' %}
{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}
{% extends is_ajax ? 'admin/layout_blank.twig' : 'admin/layout.twig' %}

{% block title %}{{ record_label is defined and record_label ? record_label : lang.mod_gallery.admin.title }}{% endblock %}

{% block headline %}{{ record_label is defined and record_label ? record_label : lang.mod_gallery.admin.title }}{% endblock %}

{% block content %}
<style>
    .headline {
        font-size: 18px !important;
        line-height: 1.15 !important;
        font-weight: 600 !important;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .gallery-shell {
        padding: 10px 10px 0;
        display: grid;
        gap: 10px;
    }
    .gallery-context {
        padding: 4px 0 16px 0;
        border-radius: 0;
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--md-sys-color-outline-variant);
        box-shadow: none;
        display: grid;
        gap: 10px;
    }
    .gallery-context__eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
        color: var(--md-sys-color-primary);
        background: color-mix(in srgb, var(--md-sys-color-primary) 12%, transparent);
    }
    .gallery-context__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .gallery-context__chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 32px;
        padding: 0 10px;
        border-radius: 999px;
        background: var(--md-sys-color-surface-container-low);
        color: var(--md-sys-color-on-surface);
        border: 1px solid var(--md-sys-color-outline-variant);
        font-size: 12px;
        font-weight: 700;
    }
    .gallery-tools-sheet {
        position: fixed;
        inset: 0;
        z-index: 12005;
        display: none !important;
        align-items: flex-end;
        justify-content: center;
    }
    .gallery-tools-sheet.active {
        display: flex !important;
    }
    .gallery-selection-sheet {
        position: fixed;
        inset: 0;
        z-index: 12006;
        display: none !important;
        align-items: flex-end;
        justify-content: center;
    }
    .gallery-selection-sheet.active {
        display: flex !important;
    }
    .gallery-tools-sheet__scrim {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.42);
        backdrop-filter: blur(4px);
    }
    .gallery-selection-sheet__scrim {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.42);
        backdrop-filter: blur(4px);
    }
    .gallery-tools-sheet__content {
        position: relative;
        width: 100%;
        max-width: 412px;
        border-radius: 28px 28px 0 0;
        background: var(--md-sys-color-surface);
        box-shadow: var(--md-sys-elevation-level4);
        transform: translateY(100%);
        transition: transform 0.35s cubic-bezier(0.1, 0.9, 0.2, 1);
        padding: 14px 14px 18px;
        display: grid;
        gap: 12px;
    }
    .gallery-tools-sheet.active .gallery-tools-sheet__content {
        transform: translateY(0);
    }
    .gallery-selection-sheet__content {
        position: relative;
        width: 100%;
        max-width: 412px;
        border-radius: 28px 28px 0 0;
        background: var(--md-sys-color-surface);
        box-shadow: var(--md-sys-elevation-level4);
        transform: translateY(100%);
        transition: transform 0.35s cubic-bezier(0.1, 0.9, 0.2, 1);
        padding: 14px 14px 18px;
        display: grid;
        gap: 12px;
    }
    .gallery-selection-sheet.active .gallery-selection-sheet__content {
        transform: translateY(0);
    }
    .gallery-tools-sheet__handle {
        width: 52px;
        height: 5px;
        border-radius: 999px;
        background: var(--md-sys-color-outline-variant);
        margin: 0 auto 4px;
    }
    .gallery-selection-sheet__handle {
        width: 52px;
        height: 5px;
        border-radius: 999px;
        background: var(--md-sys-color-outline-variant);
        margin: 0 auto 4px;
    }
    .gallery-tools-sheet__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .gallery-selection-sheet__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .gallery-tools-sheet__search {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        padding: 0 14px;
        border-radius: 16px;
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid var(--md-sys-color-outline-variant);
    }
    .gallery-tools-sheet__search input {
        border: 0;
        outline: 0;
        background: transparent;
        width: 100%;
        color: var(--md-sys-color-on-surface);
    }
    .gallery-tools-sheet__group {
        display: grid;
        gap: 10px;
    }
    .gallery-tools-sheet__row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }
    .gallery-tools-sheet__select {
        min-height: 44px;
        padding: 0 12px;
        border-radius: 16px;
        border: 1px solid var(--md-sys-color-outline-variant);
        background: var(--md-sys-color-surface-container-low);
        color: var(--md-sys-color-on-surface);
    }
    .gallery-selection-pill {
        display: none;
        align-items: center;
        gap: 8px;
        min-height: 48px;
        padding: 0 16px;
        border-radius: 16px;
        background: color-mix(in srgb, var(--md-sys-color-primary) 14%, transparent);
        color: var(--md-sys-color-primary);
        font-weight: 700;
    }
    .gallery-selection-pill.is-visible {
        display: inline-flex;
    }
    .gallery-selection-sheet__actions {
        display: grid;
        gap: 10px;
    }
    .gallery-board {
        border-radius: 28px;
        overflow: hidden;
        background: var(--md-sys-color-surface);
        border: 1px solid var(--md-sys-color-outline-variant);
        box-shadow: var(--md-sys-elevation-level1);
    }
    .gallery-workspace {
        display: grid;
        grid-template-columns: 1fr;
        align-items: start;
    }
    .gallery-workspace__main {
        min-width: 0;
    }
    .gallery-detail-sheet {
        position: fixed;
        inset: 0;
        z-index: 12010;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(18, 15, 23, 0.98);
        backdrop-filter: blur(20px);
    }
    .gallery-detail-sheet.active {
        display: flex;
    }
    .gallery-detail-sheet__scrim {
        position: absolute;
        inset: 0;
        background: transparent;
    }
    .gallery-detail-sheet__content {
        position: relative;
        width: 100%;
        height: 100%;
        max-width: 412px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: transparent;
        box-shadow: none;
        padding: 0;
        box-sizing: border-box;
        transform: scale(0.95);
        opacity: 0;
        transition: transform 0.3s cubic-bezier(0.1, 0.9, 0.2, 1), opacity 0.3s ease;
    }
    .gallery-detail-sheet.active .gallery-detail-sheet__content {
        transform: scale(1);
        opacity: 1;
    }
    .gallery-detail__top-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px;
        background: linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, transparent 100%);
        color: #ffffff;
        z-index: 3;
    }
    .gallery-detail__top-bar .close-btn {
        background: rgba(255, 255, 255, 0.08);
        border: none;
        color: #ffffff;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
        box-shadow: none;
    }
    .gallery-detail__top-bar .close-btn:hover {
        background: rgba(255, 255, 255, 0.16);
    }
    .gallery-detail__title-section {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }
    .gallery-detail__title-section .title {
        font-size: 16px;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #ffffff;
        margin: 0;
    }
    .gallery-detail__title-section .subtitle {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.6);
        font-weight: 500;
        margin: 2px 0 0 0;
    }
    .gallery-detail__preview-container {
        position: relative;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 12px;
        z-index: 2;
        min-height: 0;
    }
    .gallery-detail__preview {
        width: 100%;
        height: 100%;
        max-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        border-radius: 0;
        box-shadow: none;
    }
    .gallery-detail__preview img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .gallery-detail__empty {
        padding: 28px 20px;
        text-align: center;
        color: rgba(255, 255, 255, 0.5);
    }
    .nav-overlay-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 5;
        transition: background 0.2s, transform 0.2s;
        backdrop-filter: blur(4px);
        box-shadow: none;
    }
    .nav-overlay-btn:active {
        transform: translateY(-50%) scale(0.9);
    }
    .nav-overlay-btn.prev {
        left: 16px;
    }
    .nav-overlay-btn.next {
        right: 16px;
    }
    .gallery-detail__bottom-panel {
        padding: 20px 16px 32px 16px;
        background: linear-gradient(0deg, rgba(0, 0, 0, 0.8) 0%, transparent 100%);
        display: flex;
        flex-direction: column;
        gap: 16px;
        z-index: 3;
    }
    .gallery-detail__meta-summary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.7);
        text-align: center;
        padding: 0 8px;
    }
    .gallery-detail__meta-summary .meta-filename {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 250px;
    }
    .gallery-detail__meta-summary .meta-divider {
        opacity: 0.3;
    }
    .gallery-detail__meta-summary strong {
        color: #ffffff;
    }
    .gallery-detail__actions {
        display: flex;
        gap: 10px;
        justify-content: center;
        width: 100%;
    }
    .detail-action-btn {
        flex: 1;
        max-width: 120px;
        height: 40px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(255, 255, 255, 0.08);
        color: #e3e3e3;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.2, 0, 0, 1);
        backdrop-filter: blur(4px);
        box-shadow: none;
    }
    .detail-action-btn:hover {
        background: rgba(255, 255, 255, 0.15);
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.3);
    }
    .detail-action-btn i {
        font-size: 14px;
    }
    .detail-action-btn.delete-btn {
        background: rgba(179, 38, 30, 0.15);
        color: #f2b8b5;
        border-color: rgba(179, 38, 30, 0.3);
    }
    .detail-action-btn.delete-btn:hover {
        background: rgba(179, 38, 30, 0.25);
        color: #ffffff;
        border-color: rgba(179, 38, 30, 0.5);
    }
    .gallery-board__hint {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        border-bottom: 1px solid var(--md-sys-color-outline-variant);
        color: var(--md-sys-color-on-surface-variant);
        background: var(--md-sys-color-surface-container-low);
        font-size: 13px;
    }
    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        padding: 12px;
    }
    .gallery-item {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid var(--md-sys-color-outline-variant);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        cursor: pointer;
    }
    .gallery-item:hover {
        border-color: var(--md-sys-color-primary-container);
        transform: translateY(-2px);
        box-shadow: var(--md-sys-elevation-level1);
    }
    .gallery-item.is-selected {
        outline: 2px solid var(--md-sys-color-primary);
        outline-offset: 2px;
    }
    .gallery-item.is-active {
        border-color: var(--md-sys-color-primary);
        box-shadow: var(--md-sys-elevation-level1);
    }
    .gallery-item.is-hidden {
        display: none;
    }
    .gallery-item__select {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 2;
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.9);
        color: var(--md-sys-color-on-surface);
        display: none;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }
    .gallery-board.is-selection-mode .gallery-item__select {
        display: inline-flex;
    }
    .gallery-item__select.is-selected {
        background: var(--md-sys-color-primary);
        color: var(--md-sys-color-on-primary);
    }
    .gallery-item__media {
        position: relative;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: var(--md-sys-color-surface-container-high);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .gallery-item img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .gallery-item:hover img {
        transform: none;
    }
    .gallery-item__meta {
        padding: 10px 12px 12px;
        background: var(--md-sys-color-surface);
    }
    .gallery-item__name {
        color: var(--md-sys-color-on-surface);
        font-size: 14px;
        font-weight: 600;
        line-height: 1.3;
        word-break: break-word;
    }
    .gallery-item__actions {
        position: absolute;
        left: 8px;
        right: 8px;
        bottom: 8px;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 6px;
    }
    .gallery-item__actions .action-btn {
        width: 36px;
        min-width: 36px;
        height: 36px;
        min-height: 36px;
        padding: 0;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.9);
        color: var(--md-sys-color-on-surface);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        font-size: 16px;
        font-weight: 400;
        border: none;
        cursor: pointer;
        backdrop-filter: none;
        box-shadow: none;
    }
    .gallery-item__actions .action-btn span {
        display: none;
    }
    .gallery-item__actions .action-btn:hover {
        background: rgba(255, 255, 255, 0.98);
        color: var(--md-sys-color-primary);
    }
    .gallery-empty-search {
        display: none;
        padding: 56px 24px 72px;
        text-align: center;
    }
    .gallery-empty-search.is-visible {
        display: block;
    }
    .gallery-empty-search__icon {
        width: 88px;
        height: 88px;
        border-radius: 28px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        color: var(--md-sys-color-primary);
        background: color-mix(in srgb, var(--md-sys-color-primary) 12%, transparent);
    }
    .gallery-empty-search h3 {
        margin: 0;
        font-size: 20px;
        color: var(--md-sys-color-on-surface);
    }
    .gallery-empty-search p {
        margin: 8px 0 0;
        color: var(--md-sys-color-on-surface-variant);
    }
    .gallery-empty {
        padding: 88px 40px;
        text-align: center;
    }
    .gallery-empty__icon {
        background: var(--md-sys-color-surface-container-high);
        width: 96px;
        height: 96px;
        border-radius: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        font-size: 48px;
        color: var(--md-sys-color-outline);
    }
    .gallery-bottom-bar {
        z-index: 1000;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .gallery-bottom-bar.is-hidden {
        opacity: 0;
        pointer-events: none;
        transform: translateY(120%) !important;
    }
    .gallery-upload-section {
        padding: 10px 10px 0;
        background: transparent;
        border: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        margin: 10px 10px 0;
    }
    .upload-dropzone {
        padding: 10px 8px;
        text-align: center;
        background: transparent;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        width: 100%;
        box-sizing: border-box;
    }
    .m3-btn-browse {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        background: var(--md-sys-color-surface-container-high);
        color: var(--md-sys-color-on-surface);
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: 999px;
        padding: 6px 6px 6px 18px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        gap: 12px;
        transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);
        outline: none;
        height: 40px;
        box-sizing: border-box;
    }
    .m3-btn-browse__icon-wrapper {
        width: 28px;
        height: 28px;
        background: color-mix(in srgb, var(--md-sys-color-primary) 12%, transparent);
        color: var(--md-sys-color-primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.25s;
        flex-shrink: 0;
    }
    .m3-btn-browse .m3-btn-browse__icon-wrapper i {
        font-size: 16px !important;
        color: inherit !important;
        margin: 0 !important;
        padding: 0 !important;
    }
    .m3-btn-browse:hover {
        background: var(--md-sys-color-surface-container-highest);
        color: var(--md-sys-color-primary);
        border-color: var(--md-sys-color-primary);
    }
    .m3-btn-browse:hover .m3-btn-browse__icon-wrapper {
        background: var(--md-sys-color-primary);
        color: var(--md-sys-color-on-primary);
    }
    .upload-dropzone-subtitle {
        font-size: 11px;
        color: var(--md-sys-color-outline);
        margin: 0;
    }
    .upload-sheet {
        position: fixed;
        inset: 0;
        z-index: 12000;
        display: none;
        align-items: flex-end;
        justify-content: center;
    }
    .upload-sheet.active {
        display: flex;
    }
    .upload-sheet__scrim {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
    }
    .upload-sheet__content {
        position: relative;
        width: 100%;
        max-width: 680px;
        max-height: min(92vh, 860px);
        background: var(--md-sys-color-surface);
        border-radius: 32px 32px 0 0;
        padding: 32px;
        display: grid;
        grid-template-rows: auto auto auto 1fr auto;
        gap: 18px;
        overflow: hidden;
        transform: translateY(100%);
        transition: transform 0.4s cubic-bezier(0.1, 0.9, 0.2, 1);
        box-shadow: var(--md-sys-elevation-level4);
    }
    .upload-sheet.active .upload-sheet__content {
        transform: translateY(0);
    }
    .upload-sheet__subtitle {
        margin: 8px 0 0;
        font-size: 13px;
        color: var(--md-sys-color-on-surface-variant);
    }
    .upload-sheet__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }
    .upload-sheet__overall {
        display: grid;
        gap: 10px;
        padding: 16px 18px;
        border-radius: 22px;
        background: color-mix(in srgb, var(--md-sys-color-primary) 10%, var(--md-sys-color-surface));
        border: 1px solid color-mix(in srgb, var(--md-sys-color-primary) 22%, transparent);
    }
    .upload-sheet__overall[hidden],
    .upload-sheet__safety[hidden] {
        display: none;
    }
    .upload-sheet__overall.is-uploading {
        background: color-mix(in srgb, #0D47A1 11%, var(--md-sys-color-surface));
        border-color: color-mix(in srgb, #0D47A1 28%, transparent);
    }
    .upload-sheet__overall.is-complete {
        background: color-mix(in srgb, #1B5E20 11%, var(--md-sys-color-surface));
        border-color: color-mix(in srgb, #1B5E20 26%, transparent);
    }
    .upload-sheet__overall.is-error {
        background: color-mix(in srgb, #B71C1C 10%, var(--md-sys-color-surface));
        border-color: color-mix(in srgb, #B71C1C 24%, transparent);
    }
    .upload-sheet__overall-title {
        font-size: 14px;
        font-weight: 800;
        color: var(--md-sys-color-on-surface);
    }
    .upload-sheet__overall-meta {
        font-size: 12px;
        color: var(--md-sys-color-on-surface-variant);
    }
    .upload-sheet__overall-progress {
        height: 9px;
        border-radius: 999px;
        overflow: hidden;
        background: color-mix(in srgb, var(--md-sys-color-outline-variant) 45%, transparent);
    }
    .upload-sheet__overall-bar {
        height: 100%;
        width: 0;
        border-radius: inherit;
        background: linear-gradient(90deg, #0D47A1 0%, #1976D2 100%);
        transition: width 0.2s ease;
    }
    .upload-sheet__safety {
        display: grid;
        gap: 6px;
        padding: 14px 16px;
        border-radius: 20px;
        background: color-mix(in srgb, #E65100 14%, var(--md-sys-color-surface));
        border: 1px solid color-mix(in srgb, #E65100 22%, transparent);
    }
    .upload-sheet__safety-title {
        font-size: 13px;
        font-weight: 800;
        color: #8A3300;
    }
    .upload-sheet__safety-text {
        font-size: 12px;
        line-height: 1.45;
        color: var(--md-sys-color-on-surface);
    }
    .upload-sheet__queue {
        display: none;
        gap: 12px;
        min-height: 0;
    }
    .upload-sheet__queue.is-visible {
        display: grid;
    }
    .upload-sheet__queue-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .upload-sheet__queue-header h4 {
        margin: 0;
        font-size: 15px;
        color: var(--md-sys-color-on-surface);
    }
    .upload-sheet__queue-header p {
        margin: 4px 0 0;
        font-size: 12px;
        color: var(--md-sys-color-on-surface-variant);
    }
    .upload-sheet__queue-list {
        display: grid;
        gap: 10px;
        min-height: 0;
        max-height: 100%;
        overflow-y: auto;
        padding-right: 6px;
    }
    .upload-queue-item {
        display: grid;
        grid-template-columns: 68px minmax(0, 1fr) auto;
        gap: 12px;
        align-items: center;
        padding: 12px;
        border-radius: 18px;
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid var(--md-sys-color-outline-variant);
    }
    .upload-queue-item__thumb {
        width: 68px;
        height: 68px;
        border-radius: 16px;
        overflow: hidden;
        background: var(--md-sys-color-surface-container);
    }
    .upload-queue-item__thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .upload-queue-item__name {
        font-size: 13px;
        font-weight: 600;
        color: var(--md-sys-color-on-surface);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .upload-queue-item__meta {
        margin-top: 4px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        font-size: 12px;
        color: var(--md-sys-color-on-surface-variant);
    }
    .upload-queue-item__status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        background: var(--md-sys-color-surface-container);
        color: var(--md-sys-color-on-surface-variant);
    }
    .upload-queue-item__status.is-uploading {
        background: color-mix(in srgb, #0D47A1 16%, transparent);
        color: #0D47A1;
    }
    .upload-queue-item__status.is-success {
        background: color-mix(in srgb, #1B5E20 14%, transparent);
        color: #1B5E20;
    }
    .upload-queue-item__status.is-error {
        background: color-mix(in srgb, #B71C1C 14%, transparent);
        color: #B71C1C;
    }
    .upload-queue-item__progress {
        position: relative;
        width: 100%;
        height: 7px;
        margin-top: 8px;
        border-radius: 999px;
        overflow: hidden;
        background: var(--md-sys-color-surface-container-high);
    }
    .upload-queue-item__progress-bar {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #0D47A1 0%, #1976D2 100%);
        transition: width 0.18s ease;
    }
    .upload-queue-item__progress-label {
        margin-top: 6px;
        font-size: 11px;
        font-weight: 700;
        color: var(--md-sys-color-on-surface-variant);
    }
    .image-upload-area {
        background: var(--md-sys-color-surface-container-low);
        border: 2px dashed var(--md-sys-color-outline-variant);
        border-radius: 24px;
        padding: 40px;
        text-align: center;
        transition: all 0.3s ease;
    }
    .image-upload-area:hover,
    .image-upload-area.is-dragover {
        background: var(--md-sys-color-secondary-container);
        border-color: var(--md-sys-color-secondary);
    }
    .image-upload-area.is-disabled {
        opacity: 0.55;
        pointer-events: none;
        filter: grayscale(0.08);
    }
    .image-upload-area i {
        font-size: 56px;
        color: var(--md-sys-color-primary);
        margin-bottom: 16px;
    }
    .upload-sheet__footer {
        display: flex;
        gap: 16px;
        padding-top: 6px;
    }
    .upload-sheet.is-uploading .upload-sheet__scrim {
        background: rgba(15, 23, 42, 0.66);
    }
    .upload-sheet.is-uploading [data-upload-close] {
        opacity: 0.45;
        cursor: not-allowed;
        pointer-events: none;
    }
    @media (max-width: 640px) {
        .gallery-shell {
            padding: 10px 10px 0;
        }
        .gallery-context,
        .gallery-board {
            border-radius: 20px;
        }
        .gallery-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            padding: 10px;
        }
        .gallery-item__actions {
            display: none !important;
        }
        .upload-sheet__content {
            padding: 24px 18px;
            max-height: 94vh;
            gap: 14px;
            border-radius: 20px 20px 0 0;
        }
        .upload-sheet__footer {
            gap: 12px;
        }
        .nav-overlay-btn {
            width: 38px;
            height: 38px;
        }
        .nav-overlay-btn.prev {
            left: 8px;
        }
        .nav-overlay-btn.next {
            right: 8px;
        }
    }

    @media (min-width: 1024px) {
        .gallery-detail-sheet,
        .gallery-tools-sheet,
        .gallery-selection-sheet {
            position: absolute !important;
        }
        .gallery-detail-sheet.active,
        .gallery-tools-sheet.active,
        .gallery-selection-sheet.active {
            display: flex !important;
        }
    }

    /* Modal Dynamic Dialog & Hero Add Images Card Styling */
    #modal-dynamic-dialog .gallery-bottom-bar,
    #modal-dynamic-dialog .standard-toolbar,
    .edit-container .gallery-bottom-bar,
    .gallery-tools-sheet:not(.active),
    .gallery-selection-sheet:not(.active),
    .gallery-detail-sheet:not(.active),
    #modal-dynamic-dialog .gallery-tools-sheet:not(.active),
    #modal-dynamic-dialog .gallery-selection-sheet:not(.active),
    #modal-dynamic-dialog .gallery-detail-sheet:not(.active) {
        display: none !important;
        opacity: 0 !important;
        pointer-events: none !important;
        visibility: hidden !important;
    }
    #modal-dynamic-dialog .modal-header-bar {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        padding: 12px 16px !important;
    }
    #modal-dynamic-dialog .modal-header-bar .modal-title-wrapper {
        flex: 1 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 8px !important;
        min-width: 0 !important;
        text-align: center !important;
    }
    #modal-dynamic-dialog .modal-header-bar .modal-title-wrapper h3 {
        font-size: 14px !important;
        font-weight: 700 !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        margin: 0 !important;
        max-width: 220px !important;
        text-align: center !important;
    }
    .gallery-modal-container {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        width: 100% !important;
        box-sizing: border-box !important;
    }
    .gallery-hero-upload-card {
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
        background: linear-gradient(135deg, var(--md-sys-color-surface-container-low, #f7f2fa) 0%, var(--md-sys-color-surface-container-high, #ece6f0) 100%);
        border: 2px dashed var(--md-sys-color-primary, #6750a4);
        border-radius: 24px;
        padding: 32px 20px !important;
        text-align: center !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 14px !important;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.2, 0, 0, 1);
        box-shadow: 0 4px 16px rgba(103, 80, 164, 0.06);
        margin: 0 auto !important;
    }
    .gallery-hero-upload-card * {
        text-align: center !important;
        margin-left: auto !important;
        margin-right: auto !important;
    }
    .gallery-hero-upload-card:hover {
        background: var(--md-sys-color-surface-container-high, #ece6f0);
        border-color: var(--md-sys-color-primary, #6750a4);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(103, 80, 164, 0.12);
    }
    .gallery-hero-upload-icon {
        width: 60px !important;
        height: 60px !important;
        border-radius: 50% !important;
        background: color-mix(in srgb, var(--md-sys-color-primary, #6750a4) 14%, transparent) !important;
        color: var(--md-sys-color-primary, #6750a4) !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-size: 30px !important;
        margin: 0 auto 4px auto !important;
    }
    .gallery-add-btn-hero {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 10px !important;
        min-height: 48px !important;
        padding: 0 28px !important;
        border-radius: 24px !important;
        font-size: 15px !important;
        font-weight: 700 !important;
        box-shadow: 0 4px 14px rgba(103, 80, 164, 0.25) !important;
        background: var(--md-sys-color-primary, #6750a4) !important;
        color: var(--md-sys-color-on-primary, #ffffff) !important;
        border: none !important;
        cursor: pointer !important;
        margin: 0 auto !important;
    }
    .gallery-hero-upload-hint {
        margin: 0 auto !important;
        font-size: 12px !important;
        color: var(--md-sys-color-on-surface-variant, #49454f) !important;
        font-weight: 500 !important;
        text-align: center !important;
    }
</style>

{% set image_count = pictures is defined ? pictures|length : 0 %}

<div class="edit-container gallery-modal-container" data-modal-title="{{ record_label is defined and record_label ? record_label : lang.mod_gallery.admin.title }}" data-modal-icon="bi-images">
    
    <!-- CONTEXT SUB-HEADER -->
    <div class="gallery-context-bar" style="display: {{ image_count > 0 ? 'flex' : 'none' }}; align-items: center; justify-content: space-between; padding: 4px 4px 10px; border-bottom: 1px solid var(--md-sys-color-outline-variant); margin-bottom: 4px;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <span class="gallery-context__chip" style="font-size: 12px; padding: 4px 12px; border-radius: 12px; background: color-mix(in srgb, var(--md-sys-color-primary) 12%, transparent); color: var(--md-sys-color-primary); font-weight: 700;">
                <i class="bi bi-collection"></i>
                <strong id="galleryVisibleCount">{{ lang.mod_gallery.admin.images_summary|format(image_count) }}</strong>
            </span>
        </div>
    </div>

    <!-- PROMINENT CENTERED HERO ADD IMAGES CARD -->
    <div class="gallery-hero-upload-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; width: 100%; box-sizing: border-box; padding: 32px 20px; margin: 0 auto;" onclick="window.lastFileInputTime = Date.now(); document.getElementById('fileInput').click()" ondragenter="GalleryManager.setUploadDragState(true)" ondragover="event.preventDefault(); GalleryManager.setUploadDragState(true)" ondragleave="GalleryManager.setUploadDragState(false)" ondrop="GalleryManager.handleDrop(event)">
        <div class="gallery-hero-upload-icon" style="margin: 0 auto 4px auto; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-cloud-arrow-up-fill"></i>
        </div>
        <button type="button" class="m3-btn-filled gallery-add-btn-hero" style="margin: 0 auto; display: inline-flex; align-items: center; justify-content: center;" onclick="event.stopPropagation(); window.lastFileInputTime = Date.now(); document.getElementById('fileInput').click();">
            <i class="bi bi-plus-lg"></i>
            <span>{{ lang.mod_gallery.admin.add_images }}</span>
        </button>
        <p class="gallery-hero-upload-hint" style="margin: 0 auto; text-align: center;">{{ lang.mod_gallery.admin.upload_hint }}</p>
    </div>

    <input type="file" id="fileInput" multiple hidden accept="image/*" onchange="window.lastFileInputTime = Date.now(); GalleryManager.handleFileSelect(this)">

    <!-- EMBEDDED UPLOAD SECTION QUEUE -->
    <div id="uploadSheet" class="gallery-upload-section">
        <div id="uploadPreview" class="upload-sheet__queue" aria-live="polite" style="width: 100%;">
            <div class="upload-sheet__queue-header" style="margin-top: 10px;">
                <div>
                    <h4 style="margin: 0; font-size: 14px; font-weight: 700;">{{ lang.mod_gallery.admin.upload_queue_title }}</h4>
                    <p id="uploadQueueSummary" style="margin: 2px 0 0; font-size: 11px; color: var(--md-sys-color-outline);">{{ lang.mod_gallery.admin.queue_ready|format(0) }}</p>
                </div>
            </div>

            <div id="uploadOverall" class="upload-sheet__overall" hidden style="margin-top: 8px;">
                <div id="uploadOverallTitle" class="upload-sheet__overall-title">{{ lang.mod_gallery.admin.upload_status_ready }}</div>
                <div id="uploadOverallMeta" class="upload-sheet__overall-meta">{{ lang.mod_gallery.admin.upload_progress|format(0, 0) }}</div>
                <div class="upload-sheet__overall-progress">
                    <div id="uploadOverallBar" class="upload-sheet__overall-bar"></div>
                </div>
            </div>

            <div id="uploadSafetyBanner" class="upload-sheet__safety" hidden style="margin-top: 8px;">
                <div id="uploadSafetyTitle" class="upload-sheet__safety-title">{{ lang.mod_gallery.admin.upload_status_active }}</div>
                <div id="uploadSafetyText" class="upload-sheet__safety-text">{{ lang.mod_gallery.admin.upload_sheet_lock }}</div>
            </div>

            <div id="uploadQueueList" class="upload-sheet__queue-list" style="margin-top: 8px;"></div>

            <div class="upload-sheet__footer" style="margin-top: 10px; display: flex; justify-content: flex-end;">
                <button id="uploadBtn" class="m3-btn-filled" type="button" style="display: none;" disabled onclick="GalleryManager.startUpload()">
                </button>
            </div>
        </div>
    </div>

    <section id="galleryBoard" class="gallery-board" style="display: {{ image_count > 0 ? 'block' : 'none' }};">
        {% if pictures is defined and pictures|length > 0 %}
            <div class="gallery-workspace">
                <div class="gallery-workspace__main">
                    <div class="gallery-board__hint">
                        <i class="bi bi-lightning-charge"></i>
                        <span id="galleryBoardHint">{{ lang.mod_gallery.admin.edit_hint }}</span>
                    </div>

                    <div id="galleryGrid" class="gallery-grid">
                        {% for picture in pictures %}
                            {% set original_url = site.iaddress ~ 'mod_gallery/' ~ mod_name ~ '/original/' ~ picture.url %}
                            {% set thumb_url = site.iaddress ~ 'mod_gallery/' ~ mod_name ~ '/thumb/' ~ picture.url %}
                            <article
                                class="gallery-item"
                                id="image-{{ picture.id }}"
                                data-id="{{ picture.id }}"
                                data-name="{{ picture.name|lower|e('html_attr') }}"
                                data-original-name="{{ picture.name|e('html_attr') }}"
                                data-original-url="{{ original_url|e('html_attr') }}"
                                data-thumb-url="{{ thumb_url|e('html_attr') }}"
                                onclick="GalleryManager.handleImageCardClick('{{ picture.id }}')"
                                ondblclick="GalleryManager.editName('{{ picture.id }}', '{{ picture.name|escape('js') }}')"
                            >
                                <div class="gallery-item__media">
                                    <button type="button" class="gallery-item__select" onclick="event.stopPropagation(); GalleryManager.toggleImageSelection('{{ picture.id }}')">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <img src="{{ thumb_url }}" alt="{{ picture.name }}">
                                    <div class="gallery-item__actions">
                                        <button class="action-btn" onclick="event.stopPropagation(); GalleryManager.openImageDetail('{{ picture.id }}')" title="{{ lang.mod_gallery.admin.open_detail }}">
                                            <i class="bi bi-layout-sidebar-inset"></i>
                                            <span>{{ lang.mod_gallery.admin.open_detail }}</span>
                                        </button>
                                        <button class="action-btn" onclick="event.stopPropagation(); GalleryManager.editName('{{ picture.id }}', '{{ picture.name|escape('js') }}')" title="{{ lang.mod_gallery.admin.rename_image }}">
                                            <i class="bi bi-pencil"></i>
                                            <span>{{ lang.mod_gallery.admin.rename_image }}</span>
                                        </button>
                                    </div>
                                </div>
                                <div class="gallery-item__meta">
                                    <div class="gallery-item__name item-name">{{ picture.name }}</div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>

                    <div id="galleryEmptySearch" class="gallery-empty-search">
                        <div class="gallery-empty-search__icon">
                            <i class="bi bi-search"></i>
                        </div>
                        <h3>{{ lang.mod_gallery.admin.no_filtered_images }}</h3>
                        <p>{{ lang.mod_gallery.admin.clear_search }}</p>
                    </div>
                </div>

            </div>
        {% endif %}
    </section>
</div>

{% if pictures is defined and pictures|length > 0 %}
<div id="galleryToolsSheet" class="gallery-tools-sheet">
    <div class="gallery-tools-sheet__scrim" onclick="GalleryManager.closeToolsSheet()"></div>
    <div class="gallery-tools-sheet__content">
        <div class="gallery-tools-sheet__handle"></div>
        <div class="gallery-tools-sheet__header">
            <div class="gallery-context__eyebrow">
                <i class="bi bi-sliders"></i>
                <span>{{ lang.mod_gallery.admin.sort_label }}</span>
            </div>
            <button class="m3-icon-btn" type="button" onclick="GalleryManager.closeToolsSheet()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="gallery-tools-sheet__search">
            <i class="bi bi-search"></i>
            <input
                type="text"
                id="galleryImageSearch"
                placeholder="{{ lang.mod_gallery.admin.search_images }}"
                oninput="GalleryManager.filterImages(this.value)"
            >
        </div>
        <div class="gallery-tools-sheet__group">
            <select id="gallerySortSelect" class="gallery-tools-sheet__select" onchange="GalleryManager.sortImages(this.value)">
                <option value="newest">{{ lang.mod_gallery.admin.sort_label }}: {{ lang.mod_gallery.admin.sort_newest }}</option>
                <option value="oldest">{{ lang.mod_gallery.admin.sort_label }}: {{ lang.mod_gallery.admin.sort_oldest }}</option>
                <option value="name_asc">{{ lang.mod_gallery.admin.sort_label }}: {{ lang.mod_gallery.admin.sort_name_asc }}</option>
                <option value="name_desc">{{ lang.mod_gallery.admin.sort_label }}: {{ lang.mod_gallery.admin.sort_name_desc }}</option>
            </select>
            <div class="gallery-tools-sheet__row">
                <div class="gallery-context__chip">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span id="galleryToolbarCount">{{ lang.mod_gallery.admin.images_summary|format(image_count) }}</span>
                </div>
                <div id="gallerySelectionCount" class="gallery-selection-pill">
                    <i class="bi bi-check2-circle"></i>
                    <span>{{ lang.mod_gallery.admin.selected_summary|format(0) }}</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="gallerySelectionSheet" class="gallery-selection-sheet">
    <div class="gallery-selection-sheet__scrim" onclick="GalleryManager.exitSelectionMode()"></div>
    <div class="gallery-selection-sheet__content">
        <div class="gallery-selection-sheet__handle"></div>
        <div class="gallery-selection-sheet__header">
            <div id="gallerySelectionCountSheet" class="gallery-selection-pill">
                <i class="bi bi-check2-circle"></i>
                <span>{{ lang.mod_gallery.admin.selected_summary|format(0) }}</span>
            </div>
            <button class="m3-icon-btn" type="button" onclick="GalleryManager.exitSelectionMode()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="gallery-selection-sheet__actions">
            <button class="m3-btn-outlined" type="button" onclick="GalleryManager.selectAllVisible()">
                <i class="bi bi-check2-all"></i>
                <span>{{ lang.mod_gallery.admin.select_all }}</span>
            </button>
            <button class="m3-btn-outlined" type="button" onclick="GalleryManager.clearSelection()">
                <i class="bi bi-eraser"></i>
                <span>{{ lang.mod_gallery.admin.clear_selection }}</span>
            </button>
            <button class="m3-btn-filled" type="button" onclick="GalleryManager.bulkDeleteSelected()">
                <i class="bi bi-trash"></i>
                <span>{{ lang.mod_gallery.admin.bulk_delete }}</span>
            </button>
        </div>
    </div>
</div>

<div id="galleryDetailSheet" class="gallery-detail-sheet">
    <div class="gallery-detail-sheet__scrim" onclick="GalleryManager.closeDetailSheet()"></div>
    <div class="gallery-detail-sheet__content">
        <!-- Sernavê Top-Bar -->
        <div class="gallery-detail__top-bar">
            <button class="close-btn" type="button" onclick="GalleryManager.closeDetailSheet()" aria-label="Girtin">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div class="gallery-detail__title-section">
                <h4 id="galleryDetailTitle" class="title">-</h4>
                <span id="galleryDetailPosition" class="subtitle">-</span>
            </div>
            <div style="width: 40px;"></div>
        </div>

        <!-- Side Action Preview -->
        <div class="gallery-detail__preview-container">
            <button class="nav-overlay-btn prev" type="button" onclick="GalleryManager.showPreviousImage()" aria-label="Previous Image">
                <i class="bi bi-chevron-left"></i>
            </button>

            <div class="gallery-detail__preview">
                <img id="galleryDetailImage" src="" alt="{{ lang.mod_gallery.admin.preview_alt }}" style="display: none;">
                <div id="galleryDetailEmpty" class="gallery-detail__empty">
                    {{ lang.mod_gallery.admin.detail_empty }}
                </div>
            </div>

            <button class="nav-overlay-btn next" type="button" onclick="GalleryManager.showNextImage()" aria-label="Next Image">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>

        <!-- Bottom Info and Actions -->
        <div class="gallery-detail__bottom-panel">
            <div class="gallery-detail__meta-summary">
                <span class="meta-label">ID: <strong id="galleryDetailId">-</strong></span>
                <span class="meta-divider">|</span>
                <span class="meta-filename" id="galleryDetailFilename">-</span>
            </div>

            <div class="gallery-detail__actions">
                <button class="detail-action-btn view-btn" type="button" onclick="GalleryManager.viewActiveImageOriginal()" title="{{ lang.mod_gallery.admin.view_original }}">
                    <i class="bi bi-arrows-fullscreen"></i>
                    <span>{{ lang.mod_gallery.admin.view_original }}</span>
                </button>
                <button class="detail-action-btn rename-btn" type="button" onclick="GalleryManager.editActiveImageName()" title="{{ lang.mod_gallery.admin.rename_image }}">
                    <i class="bi bi-pencil"></i>
                    <span>{{ lang.mod_gallery.admin.rename_image }}</span>
                </button>
                <button class="detail-action-btn delete-btn" type="button" onclick="GalleryManager.deleteActiveImage()" title="{{ lang.mod_gallery.admin.remove_image }}">
                    <i class="bi bi-trash"></i>
                    <span>{{ lang.mod_gallery.admin.remove_image }}</span>
                </button>
            </div>
        </div>
    </div>
</div>

<div id="galleryOriginalLightbox" class="gallery-original-lightbox" style="display:none; position:fixed; inset:0; z-index:999999; background:rgba(18, 15, 23, 0.98); backdrop-filter:blur(16px); align-items:center; justify-content:center;">
    <div class="gallery-original-lightbox__content" style="position:relative; width:100%; height:100%; max-width:412px; display:flex; flex-direction:column; justify-content:space-between; box-sizing:border-box; margin:0 auto;">
        
        <!-- Phone Top Bar -->
        <div style="display:flex; align-items:center; justify-content:space-between; padding:16px; background:linear-gradient(180deg, rgba(0,0,0,0.6) 0%, transparent 100%); z-index:3;">
            <button type="button" class="close-btn" onclick="GalleryManager.closeOriginalLightbox()" style="background:rgba(255,255,255,0.08); border:none; color:#fff; width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer;" title="Girtin">
                <i class="bi bi-arrow-left" style="font-size:18px;"></i>
            </button>
            <span style="font-size:14px; font-weight:700; color:#fff;">View Original</span>
            <a id="lightboxOpenTabBtn" href="#" target="_blank" style="background:rgba(255,255,255,0.08); border:none; color:#fff; width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; text-decoration:none;" title="Open in new tab">
                <i class="bi bi-box-arrow-up-right" style="font-size:16px;"></i>
            </a>
        </div>

        <!-- Phone Center Image Preview -->
        <div style="flex:1; display:flex; align-items:center; justify-content:center; padding:12px; min-height:0; z-index:2;" onclick="GalleryManager.closeOriginalLightbox()">
            <img id="lightboxImage" src="" alt="Original Image" style="max-width:100%; max-height:100%; object-fit:contain; border-radius:16px; box-shadow:0 8px 32px rgba(0,0,0,0.6);" onclick="event.stopPropagation()">
        </div>

        <!-- Phone Bottom Bar -->
        <div style="padding:16px; background:linear-gradient(0deg, rgba(0,0,0,0.6) 0%, transparent 100%); text-align:center; z-index:3;">
            <span id="lightboxFilename" style="font-size:12px; color:rgba(255,255,255,0.7); font-weight:500;"></span>
        </div>
    </div>
</div>
{% endif %}
