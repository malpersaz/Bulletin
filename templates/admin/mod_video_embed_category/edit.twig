{% extends "management/admin-layout.twig" %}
{% block title %}{{ lang.mod_video_embed_category.edit }}{% endblock %}
{% block body %}
    {% if error is defined %}
        <div class="alert alert-danger">
            <strong>{{ lang.mod_video_embed_category.error }}</strong> {{ mesaj }}
        </div>
    {% else %}
        <div class="portlet box green">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-edit"></i>{{ lang.mod_video_embed_category.edit }}
                </div>
            </div>
            <div class="portlet-body form">
                <!--  Mesajlar -->
                {% if oke is defined %}
                    <div class="alert alert-success">
                        <strong>{{ lang.mod_video_embed_category.oke }}</strong>{{ mesaj }}
                        <hr>
                        <a href="{{ site.adres }}mod_video_embed_category/add" class="btn green">{{ lang.mod_video_embed_category.button.add }}</a>
                        <a href="{{ site.adres }}mod_video_embed_category/edit/{{ d.id }}"
                           class="btn red">{{ lang.mod_video_embed_category.button.edit }}</a>
                        <a href="{{ site.adres }}mod_video_embed_category/list" class="btn blue">{{ lang.mod_video_embed_category.list }}</a>
                    </div>
                {% else %}
                    {% if hatalar is defined %}
                        {% for hata in hatalar %}
                            <div class="alert alert-danger">
                                <strong>{{ lang.mod_video_embed_category.hata }}</strong> {{ hata }}
                            </div>
                        {% endfor %}
                    {% endif %}
                    <form method="POST"
                          action=""
                          id="edit"
                          enctype="multipart/form-data"
                          class="form-horizontal">
                        <div class="form-body">
                            <!-- İnputlar Başlar -->
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_video_embed_category.admin.columns.lang }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge  validate[required]"
                                                name="lang"
                                                id="lang">
                                            {% for item in lang_lang %}
                                                <option value="{{ item.seo }}"
                                                        {% if d.lang == item.seo %}selected="selected"{% endif %}>
                                                    {{ item.name }}
                                                    {% if item.lang is defined %}({{ item.lang }}){% endif %}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_video_embed_category.admin.columns.name }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input class="form-control input-xlarge  validate[required,length[2,255]]"
                                               name="name"
                                               value="{{ d.name }}"
                                               type="text"
                                               id="name">
                                    </div>
                                </div>
                            </div>
                            {% macro select_nested_parent_id_function(parent_id = 0, level = 0, disable = "false") %}
                                {% for entry in select_nested_parent_id_result[parent_id] %}
                                    {% set parent_id = entry.id %}
                                    <option value="{{ entry.id }}"
                                            {% if entry.id == d.parent_id %}selected="selected"{% endif %}
                                            {% if entry.id == d.id or disable == "true" %}disabled="disabled"{% endif %}>
                                        {{ '-'|repeat(level) }}{{ entry.name }}
                                    </option>
                                    {% if select_nested_parent_id_result[parent_id] is defined and select_nested_parent_id_result[parent_id] is iterable %}
                                        {% if parent_id == d.id %}
                                            {{ _self.select_nested_parent_id_function(parent_id, level + 1, "true") }}
                                        {% else %}
                                            {% if disable == "true" %}
                                                {{ _self.select_nested_parent_id_function(parent_id, level + 1, "true") }}
                                            {% else %}
                                                {{ _self.select_nested_parent_id_function(parent_id, level + 1, "false") }}
                                            {% endif %}
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            {% endmacro %}
                            <div class="form-group">
                                <label class="col-md-3 control-label">{{ lang.mod_video_embed_category.admin.columns.parent_id }} :</label>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <select class="form-control input-xlarge  validate[required]"
                                                name="parent_id"
                                                id="parent_id">
                                        <option value="0" {% if d.parent_id == '0' %}selected="selected"{% endif %}>{{ lang.mod_video_embed_category.choose_wish }}</option>
                                        {{ _self.select_nested_parent_id_function() }}
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_video_embed_category.admin.columns.root }} :</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <select class="form-control input-xlarge  validate[required]"
                                            name="root"
                                            id="root">
                                        <option value="y" {% if d.root == 'y' %}selected="selected"{% endif %}>
                                            {{ lang.mod_video_embed_category.admin.select_value.root_e }}
                                        </option>
                                        <option value="n" {% if d.root == 'n' %}selected="selected"{% endif %}>
                                            {{ lang.mod_video_embed_category.admin.select_value.root_h }}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_video_embed_category.admin.columns.seo }} :</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input class="form-control input-xlarge  validate[required]"
                                           name="seo"
                                           value="{{ d.seo }}"
                                           type="text"
                                           id="seo">
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_video_embed_category.admin.columns.title }} :</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input class="form-control input-xlarge  validate[required]"
                                           name="title"
                                           value="{{ d.title }}"
                                           type="text"
                                           id="title">
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_video_embed_category.admin.columns.keywords }} :</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input class="form-control input-xlarge  validate[required]"
                                           name="keywords"
                                           value="{{ d.keywords }}"
                                           type="text"
                                           id="keywords">
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_video_embed_category.admin.columns.description }} :</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input class="form-control input-xlarge  validate[required]"
                                           name="description"
                                           value="{{ d.description }}"
                                           type="text"
                                           id="description">
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 control-label">{{ lang.mod_video_embed_category.admin.columns.image }} :</label>
                            <div class="col-md-4">
                                <div class="input-group">
                                    {% if d.image == "" %}
                                        <input name="image" type="file">
                                    {% else %}
                                        <p id="image-{{ d.id }}">
                                            <img src="static/mod_video_embed_category/thumb/{{ d.image }}">
                                            <a href="javascript:void(0)" onclick="image_remove_image('{{ d.id }}');">{{ lang.mod_video_embed_category.button.kaldir }}</a>
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        <!-- İnputlar Biter -->
                    </div>
                    <!-- form body end -->
                    <div class="form-actions">
                        <div class="row">
                            <div class="col-md-offset-3 col-md-9">
                                <button class="btn green"
                                        name="edit"
                                        value="{{ lang.mod_video_embed_category.button.edit }}">
                                    {{ lang.mod_video_embed_category.button.edit }}
                                </button>
                                <a class="btn blue" href="mod_video_embed_category/list">{{ lang.mod_video_embed_category.button.vazgec }}</a>
                            </div>
                        </div>
                    </div>
                    <!-- form actions end -->
                </form>
            {% endif %}
        </div>
    </div>
{% endif %}
{% endblock %}
{% block extra %}
    <script>
    $(document).ready(function() {
        $("#edit").validationEngine();


        function temizle(veri) {

            var temiz = veri.replace(/[^a-zA-ZığüşöçİĞÜŞÖÇîêûÎÊÛ1234567890"' ]+/g, " ");
            temiz = temiz.replace(/^\s+|\s+$/g, "");

            for (i = 0; i <= 15; i ++) {
                temiz = temiz.replace('  ', ' ');
            }
            return temiz;
        }

        // SEO YAPAR
        function make_seo(name, seo) {
            $("#" + name).change(
                    function () {
                        var deger = temizle($("#" + name).val());
                        deger = deger.replace(/\s+/g, "_");
                        deger = deger.replace('İ', 'i');

                        $("#" + seo).val(deger);
                    });
        }

        // Make keywords
        function make_keywords(name, keywords) {
            $("#" + name).change(
                    function () {
                        var deger = temizle($("#" + name).val());
                        deger = deger.replace(/\s+/g, ",");
                        deger = deger.toLowerCase();
                        deger = deger.replace('İ', 'i');

                        $("#" + keywords).val(deger);
                    });
        }

        // Make Title
        function make_title(name, title) {
            $("#" + name).change(
                    function () {
                        var deger = temizle($("#" + name).val());
                        $("#" + title).val(deger);
                    });
        }

        // Make Açıklama
        function make_aciklama(name, description) {
            $("#" + name).change(
                    function () {
                        var deger = temizle($("#" + name).val());
                        $("#" + description).val(deger);
                    });
        }
        // Make Preview
        function make_preview(name) {
            $("#" + name).change(function() {
                $("#" + name + "_preview").html($("#" + name).val());
            });
        }


        var simdi = new Date();
        var yil = simdi.getFullYear();
        var ay = (simdi.getMonth() < 9 ? '0' : '') + (simdi.getMonth() + 1);
        var gun = (simdi.getDate() < 10 ? '0' : '') + simdi.getDate();
        var saat = (simdi.getHours() < 10 ? '0' : '') + simdi.getHours();
        var dakika = (simdi.getMinutes() < 10 ? '0' : '') + simdi.getMinutes();

        var now = yil + "-" + ay + "-" + gun + " " + saat + ":" + dakika;

                        make_seo('name','seo');
                make_title('name','title');
                make_keywords('name','keywords');
                make_aciklama('name','description');

    });
    </script>
    <script type="text/javascript">
function image_remove_image(id){

    $.prompt('{{ lang.mod_video_embed_category.remove_image }}', {
      buttons: [
        {
        title: '{{ lang.mod_video_embed_category.button.evet }}',
        value: true},
        {
        title: '{{ lang.mod_video_embed_category.button.hayir }}',
        value: false}
            ],
      submit: function(v, m, f) {
        if (v === true) {
      	  $.ajax({
      		  type: "POST",
      		  url: "{{ site.adres }}mod_video_embed_category/image_remove_image",
      		  data: { id: id },
      		  success: function(msg) {
      		    if (msg == 'Oke') {
      		      $.achtung({
      		        className: 'achtungSuccess',
      		        message: '{{ lang.mod_video_embed_category.remove_image_oke }}',
      		        timeout: 5
      		      });
      		      $("#image-"+id).html('<input name="image" type="file">');
      		    } else {
      		      $.achtung({
      		        className: 'achtungFail',
      		        message: msg,
      		        timeout: 5
      		      });
      		    }
      		  }
      		});
        }
      }
    });
	}
    </script>
{% endblock %}
