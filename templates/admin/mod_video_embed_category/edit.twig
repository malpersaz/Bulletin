{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}{{ lang.mod_video_embed_category.edit }}{% endblock %}
{% block headline %}{{ lang.mod_video_embed_category.edit }}{% endblock %}

{% block content %}
{% if fatal_error is defined %}
    <div class="video-category-shell">
        <div class="form-status error">{{ message }}</div>
    </div>
{% else %}
    {% include 'admin/mod_video_embed_category/_form.twig' with { mode: 'edit', form_id: 'videoCategoryEditForm', record: record } %}
{% endif %}
{% endblock %}

{% block fixed_bottom %}
{% if success is not defined and fatal_error is not defined %}
    <div class="video-category-bottom-bar">
        <a href="{{ site.saddress }}mod_video_embed_category/list" class="cancel-btn">
            <i class="bi bi-arrow-left"></i>
            <span>{{ lang.mod_video_embed_category.button.cancel }}</span>
        </a>
        <button type="submit" form="videoCategoryEditForm" name="edit" value="1" class="save-btn">
            <i class="bi bi-check2-circle"></i>
            <span>{{ lang.mod_video_embed_category.button.save }}</span>
        </button>
    </div>
{% endif %}
{% endblock %}
