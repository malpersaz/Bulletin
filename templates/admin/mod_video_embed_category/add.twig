{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}{{ lang.mod_video_embed_category.add }}{% endblock %}
{% block headline %}{{ lang.mod_video_embed_category.add }}{% endblock %}

{% block content %}
{% include 'admin/mod_video_embed_category/_form.twig' with { mode: 'add', form_id: 'videoCategoryAddForm', record: record } %}
{% endblock %}

{% block fixed_bottom %}
{% if success is not defined %}
    <div class="video-category-bottom-bar">
        <a href="{{ site.saddress }}mod_video_embed_category/list" class="cancel-btn">
            <i class="bi bi-arrow-left"></i>
            <span>{{ lang.mod_video_embed_category.button.cancel }}</span>
        </a>
        <button type="submit" form="videoCategoryAddForm" name="add" value="1" class="save-btn">
            <i class="bi bi-check2-circle"></i>
            <span>{{ lang.mod_video_embed_category.button.add }}</span>
        </button>
    </div>
{% endif %}
{% endblock %}
