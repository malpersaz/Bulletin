{% set hide_navbar = true %}
{% set module_lang_key = 'mod_page' %}
{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% block title %}
	{{ d.name }} - {{ lang.mod_page.edit }}
{% endblock %}

{% block headline %}
	{{ d.name }}
{% endblock %}
{% block styles %}
<link rel="stylesheet" href="/templates/admin/assets/css/mod_page.css?v=5">
{% endblock %}

{% macro select_nested_parent_id_function(select_nested_parent_id_result, parent_id, selected_id, self_id, level = 0) %}
    {% if select_nested_parent_id_result[parent_id] is defined %}
        {% for entry in select_nested_parent_id_result[parent_id] %}
            {% set parent_id_loop = entry.id %}
            {% if entry.id != self_id %}
                <option value="{{ entry.id }}" {% if selected_id == entry.id %} selected="selected" {% endif %}>
                    {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.name }} ({% if entry.lang is defined %}{{ entry.lang|upper }}{% endif %})
                </option>
                {% if select_nested_parent_id_result[parent_id_loop] is defined and select_nested_parent_id_result[parent_id_loop] is iterable %}
                    {{ _self.select_nested_parent_id_function(select_nested_parent_id_result, parent_id_loop, selected_id, self_id, level + 1) }}
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% macro select_nested_category_id_function(select_nested_category_id_result, parent_id, selected_id, level = 0) %}
    {% if select_nested_category_id_result[parent_id] is defined %}
        {% for entry in select_nested_category_id_result[parent_id] %}
            {% set parent_id_loop = entry.id %}
            {% if (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#') %}
                <optgroup label="{{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.name }}{% if entry.lang is defined %} ({{ entry.lang }}){% endif %}">
            {% else %}
                <option
                    value="{{ entry.id }}"
                    {% if entry.lang is defined %}data-lang="{{ entry.lang|upper }}"{% endif %}
                    data-trigger-label="{{ entry.name|e('html_attr') }}"
                    {% if selected_id == entry.id %} selected="selected" {% endif %}
                >
                    {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.name }}
                    {% if entry.lang is defined %}({{ entry.lang }}){% endif %}
                </option>
            {% endif %}
            
            {% if select_nested_category_id_result[parent_id_loop] is defined and select_nested_category_id_result[parent_id_loop] is iterable %}
                {{ _self.select_nested_category_id_function(select_nested_category_id_result, parent_id_loop, selected_id, level + 1) }}
            {% endif %}
            
            {% if (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '#') %}
                </optgroup>
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% macro select_nested_menu_function(select_nested_menu_result, parent_id, selected_id, level = 0) %}
    {% if select_nested_menu_result[parent_id] is defined %}
        {% for entry in select_nested_menu_result[parent_id] %}
            {% set parent_id_loop = entry.id %}
            {% set skip_root = (entry.root is defined and entry.root == 'y') or (entry.url is defined and entry.url == '##') %}
            {% if not skip_root %}
                <option value="{{ entry.id }}" {% if selected_id == entry.id %} selected="selected" {% endif %}>
                    {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ entry.name }}
                    {% if entry.lang is defined %}({{ entry.lang }}){% endif %}
                </option>
            {% endif %}
            {% if select_nested_menu_result[parent_id_loop] is defined and select_nested_menu_result[parent_id_loop] is iterable %}
                {{ _self.select_nested_menu_function(select_nested_menu_result, parent_id_loop, selected_id, level + (skip_root ? 0 : 1)) }}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% block content %}
	<form id="editForm" method="POST" action="{{ site.saddress }}mod_page/edit/{{ d.id }}" enctype="multipart/form-data"
		data-mode="edit"
		data-deck-length-error="{{ lang.mod_page.validator.deck_length|e('html_attr') }}"
		data-ok-text="{{ lang.mod_page.button.ok|e('html_attr') }}"
		data-error-message="{{ (message is defined ? message : '')|e('html_attr') }}"
		data-errors="{{ (errors is defined and errors is not empty ? errors : [])|json_encode|e('html_attr') }}"
		data-success-url="{% if success is defined %}{{ site.saddress }}mod_page/list{% endif %}"
		data-redirect-delay="2000"
		data-remove-url="{{ site.saddress }}mod_page/image_remove_image"
		data-remove-id="{{ d.id }}"
		data-remove-title="{{ lang.mod_page.remove_image|e('html_attr') }}"
		data-remove-confirm="{{ lang.mod_page.remove_image_question|e('html_attr') }}"
		data-remove-confirm-text="{{ lang.mod_page.button.yes|e('html_attr') }}"
		data-remove-cancel-text="{{ lang.mod_page.button.no|e('html_attr') }}"
		data-success-title="{{ lang.mod_page.success|e('html_attr') }}"
		data-success-message="{{ lang.mod_page.remove_image_success|e('html_attr') }}"
		data-error-title="{{ lang.mod_page.error|e('html_attr') }}"
		data-upload-text="{{ lang.mod_page.button.upload|e('html_attr') }}">
		<input type="hidden" name="id" value="{{ d.id }}">
		<input type="hidden" name="edit" value="{{ lang.mod_page.button.edit }}">

		<div class="edit-container">
            {% if success is defined %}
                <div class="banner-m3 banner-success-soft">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>{{ message }}</span>
                </div>
            {% endif %}

			{# Card 1: Basics #}
			<div class="edit-card">
				<div class="card-header-edit">
					<i class="bi bi-info-circle-fill"></i>
					<h3>{{ lang.mod_page.wizard.step.language }} & {{ lang.mod_page.admin.columns.name }}</h3>
				</div>

				<div class="form-row">
					<div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="lang" id="lang" required>
                            {% for item in lang_lang %}
                                <option value="{{ item.seo }}" {% if d.lang == item.seo %} selected {% endif %}>{{ item.name }} ({{ item.seo|upper }})</option>
                            {% endfor %}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_page.admin.columns.language }}</label>
                    </div>
				</div>

				<div class="form-row">
					<div class="m3-input-wrapper">
						<input type="text" class="m3-input-lg" name="name" id="name" placeholder=" " autocomplete="off" value="{{ d.name }}" required>
						<label class="m3-floating-label">{{ lang.mod_page.admin.columns.name }}</label>
					</div>
				</div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="parent_id" id="parent_id">
                            <option value="0" {% if d.parent_id == '0' %} selected {% endif %}>{{ lang.mod_page.choose_wish }}</option>
                            {{ _self.select_nested_parent_id_function(select_nested_parent_id_result, 0, d.parent_id, d.id) }}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_page.admin.columns.parent_id }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <label class="filter-group-label mod-page-section-label strong">{{ lang.mod_page.admin.columns.category_id }}</label>
                        <select
                            class="m3-input-lg select-picker-native"
                            name="category_id"
                            id="category_id"
                            data-picker-sheet="category"
                            data-picker-title="{{ lang.mod_page.admin.columns.category_id }}"
                            data-picker-placeholder="{{ lang.mod_page.choose_wish }}"
                            data-picker-lang-source="lang"
                        >
                            <option value="0" {% if d.category_id == 0 %} selected {% endif %}>{{ lang.mod_page.choose_wish }}</option>
                            {{ _self.select_nested_category_id_function(select_nested_category_id_result, 0, d.category_id) }}
                        </select>
                        <div class="m3-fake-select select-picker-trigger" data-picker-trigger-for="category_id">
                            <span class="select-picker-label">{{ lang.mod_page.choose_wish }}</span>
                            <i class="bi bi-chevron-down"></i>
                        </div>
                    </div>
                </div>
			</div>

			{# Card 2: Main Content #}
			<div class="edit-card">
				<div class="card-header-edit">
					<i class="bi bi-file-earmark-text-fill"></i>
					<h3>{{ lang.mod_page.wizard.step.content }}</h3>
				</div>

				<div class="form-row">
					<div class="m3-input-wrapper">
						<textarea class="m3-input-lg" name="summary" id="summary" rows="3" placeholder=" " minlength="90" maxlength="120" data-counter-target="introCounter" data-counter-min="90" data-counter-max="120" required>{{ d.summary|striptags|raw }}</textarea>
						<label class="m3-floating-label">{{ lang.mod_page.admin.columns.summary }}</label>
					</div>
					<div class="char-counter mod-page-counter" id="introCounter">{{ d.summary|length }} / 120</div>
				</div>

				<div class="form-row">
					<label class="filter-group-label mod-page-section-label strong">{{ lang.mod_page.admin.columns.deck }}</label>
					<input type="hidden" name="deck" value="{{ d.deck is defined ? d.deck : 'n' }}" id="deckHidden">
					<div class="selection-grid">
						<div class="selection-card compact {% if d.deck == 'y' %} active {% endif %}" data-action="select-deck" data-value="y">
							<div class="selection-label">{{ lang.mod_page.admin.radio.deck_yes }}</div>
							<i class="bi bi-check-circle-fill check-icon"></i>
						</div>
						<div class="selection-card compact {% if d.deck != 'y' %} active {% endif %}" data-action="select-deck" data-value="n">
							<div class="selection-label">{{ lang.mod_page.admin.radio.deck_no }}</div>
							<i class="bi bi-check-circle-fill check-icon"></i>
						</div>
					</div>
				</div>

				<div class="form-row">
					<label class="filter-group-label mod-page-section-label">{{ lang.mod_page.admin.columns.content }}</label>
                    <div class="mod-page-content-wrap">
					    <textarea name="content" id="contentTextarea">{{ d.content|raw }}</textarea>
                    </div>
				</div>
			</div>

			{# Card 3: Media & Settings #}
			<div class="edit-card">
				<div class="card-header-edit">
					<i class="bi bi-images"></i>
					<h3>{{ lang.mod_page.admin.columns.image }} & {{ lang.mod_page.admin.columns.menu }}</h3>
				</div>

				<div class="form-row">
					<label class="filter-group-label mod-page-section-label strong">{{ lang.mod_page.admin.columns.image }}</label>
                    {% include 'admin/partials/image_uploader.twig' with {
                        shell_id: 'editImageShell',
                        shell_class: 'edit-image-shell',
                        has_image: d.image ? true : false,
                        shell_attrs: {
                            'data-drop-title': lang.mod_page.wizard.image.drop_title,
                            'data-drop-description': lang.mod_page.wizard.image.drop_description,
                            'data-upload-link': lang.mod_page.wizard.image.upload_link,
                            'data-link-separator': lang.mod_page.wizard.image.link_separator,
                            'data-link-placeholder': lang.mod_page.wizard.image.link_placeholder,
                            'data-link-action': lang.mod_page.wizard.image.link_action,
                            'data-hint-loading': lang.mod_page.wizard.image.hint_loading,
                            'data-hint-invalid-type': lang.mod_page.wizard.image.hint_invalid_type,
                            'data-hint-no-drop-data': lang.mod_page.wizard.image.hint_no_drop_data,
                            'data-hint-remote-failed': lang.mod_page.wizard.image.hint_remote_failed,
                            'data-empty-name': lang.mod_page.choose_wish,
                            'data-empty-meta': lang.mod_page.wizard.image.drop_description,
                            'data-existing-image': d.image ? 'true' : 'false',
                            'data-existing-src': d.image ? (site.iaddress ~ 'mod_page/thumb/' ~ d.image) : '',
                            'data-existing-name': d.image|default(''),
                            'data-existing-meta': lang.mod_page.admin.columns.image,
                            'data-remove-url': site.saddress ~ 'mod_page/image_remove_image',
                            'data-remove-id': d.id,
                            'data-remove-title': lang.mod_page.remove_image,
                            'data-remove-confirm': lang.mod_page.remove_image_question,
                            'data-remove-confirm-text': lang.mod_page.button.yes,
                            'data-remove-cancel-text': lang.mod_page.button.no,
                            'data-success-title': lang.mod_page.success,
                            'data-success-message': lang.mod_page.remove_image_success,
                            'data-error-title': lang.mod_page.error
                        },
                        dropzone_id: 'editImageDropzone',
                        trigger_picker_js: 'triggerEditImagePicker()',
                        empty_state_id: 'editImageEmptyState',
                        empty_hidden: d.image ? true : false,
                        drop_title: lang.mod_page.wizard.image.drop_title,
                        drop_description: lang.mod_page.wizard.image.drop_description,
                        upload_link: lang.mod_page.wizard.image.upload_link,
                        preview_card_id: 'editImagePreviewCard',
                        remove_button_label: lang.mod_page.button.delete,
                        remove_action_js: 'removeEditImage()',
                        preview_img_id: 'editImgPreview',
                        preview_alt: lang.mod_page.admin.columns.image,
                        preview_hidden: d.image ? false : true,
                        preview_src: d.image ? (site.iaddress ~ 'mod_page/thumb/' ~ d.image) : '',
                        meta_id: 'editImageMeta',
                        meta_hidden: true,
                        file_name_id: 'editImageFileName',
                        file_name_text: '',
                        file_details_id: 'editImageFileDetails',
                        file_details_text: '',
                        divider_hidden: d.image ? true : false,
                        link_separator: lang.mod_page.wizard.image.link_separator,
                        url_row_hidden: d.image ? true : false,
                        url_input_id: 'editImageUrlInput',
                        link_placeholder: lang.mod_page.wizard.image.link_placeholder,
                        import_btn_id: 'editImageUrlImportBtn',
                        link_action: lang.mod_page.wizard.image.link_action,
                        file_input_id: 'editImgInput',
                        file_input_onchange: 'previewEditImage(this)'
                    } %}
				</div>

                <div class="form-row">
                    <label class="filter-group-label mod-page-section-label strong">{{ lang.mod_page.admin.columns.root }}</label>
                    <input type="hidden" name="root" value="{{ d.root }}" id="rootHidden">
                    <div class="selection-grid">
                        <div class="selection-card {% if d.root == 'y' %} active {% endif %}" data-action="select-root" data-value="y">
                            <i class="bi bi-house-door mod-page-icon-lg"></i>
                            <div class="selection-label">{{ lang.mod_page.admin.select_value.root_e }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                        <div class="selection-card {% if d.root == 'n' %} active {% endif %}" data-action="select-root" data-value="n">
                            <i class="bi bi-file-earmark mod-page-icon-lg"></i>
                            <div class="selection-label">{{ lang.mod_page.admin.select_value.root_h }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="menu_slot" id="menu_slot">
                            {% for option in menu_slot_options %}
                                <option value="{{ option.value }}" {% if selected_menu_slot is defined and selected_menu_slot == option.value %} selected {% endif %}>{{ option.label }}</option>
                            {% endfor %}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_page.admin.columns.menu_slot }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="menu" id="menu">
                            <option value="__none__" {% if menu_binding_value == '__none__' %} selected {% endif %}>{{ lang.mod_page.menu_options.none }}</option>
                            <option value="__top__" {% if menu_binding_value == '__top__' %} selected {% endif %}>{{ selected_menu_slot is defined and selected_menu_slot != 'none' ? lang.mod_page.menu_options.slot_root : lang.mod_page.menu_options.top_level }}</option>
                            {{ _self.select_nested_menu_function(select_nested_menu_result, menu_parent_root_id is defined ? menu_parent_root_id : 0, menu_binding_value) }}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_page.admin.columns.menu }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="gallery_id" id="gallery_id">
                            <option value="0" {% if d.gallery_id == 0 %}selected{% endif %}>{{ lang.mod_page.choose_wish }}</option>
                            {% for item in mod_page_gallery_id %}
                                <option value="{{ item.id }}" {% if d.gallery_id == item.id %}selected{% endif %}>{{ item.name }}{% if item.lang is defined %} ({{ item.lang|upper }}){% endif %}</option>
                            {% endfor %}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_page.admin.columns.gallery_id|raw }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="file_id" id="file_id">
                            <option value="0" {% if d.file_id == 0 %}selected{% endif %}>{{ lang.mod_page.choose_wish }}</option>
                            {% for item in mod_page_file_id %}
                                <option value="{{ item.id }}" {% if d.file_id == item.id %}selected{% endif %}>{{ item.name }}{% if item.lang is defined %} ({{ item.lang|upper }}){% endif %}</option>
                            {% endfor %}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_page.admin.columns.file_id|raw }}</label>
                    </div>
                </div>

                <div class="form-row">
                    <label class="filter-group-label mod-page-section-label strong">{{ lang.mod_page.admin.columns.acl_id|raw }}</label>
                    <div class="mod-page-acl-row">
                        <select class="m3-input-lg mod-page-acl-select" name="acl_id" id="acl_id">
                            <option value="0" {% if d.acl_id == 0 %}selected{% endif %}>-- {{ lang.mod_page.choose_wish }} --</option>
                            {% for item in mod_acl_acl_id %}
                                <option value="{{ item.id }}" {% if d.acl_id == item.id %}selected{% endif %}>{{ item.name }}</option>
                            {% endfor %}
                        </select>
                        <a href="{{ site.saddress }}mod_acl/list" class="mod-page-acl-link small" title="{{ lang.management.acl }}">
                            <i class="bi bi-shield-lock-fill mod-page-icon-md"></i>
                        </a>
                    </div>
                </div>

				<div class="advanced-toggle" data-action="toggle-advanced">
					<div class="advanced-toggle-label">
						<i class="bi bi-globe-americas"></i>
						<span>{{ lang.mod_page.seo_meta }}</span>
					</div>
					<i class="bi bi-chevron-down" id="advancedIcon"></i>
				</div>

                <div class="advanced-content" id="advancedContent">
                    <div class="form-row">
                        <div class="m3-input-wrapper">
                            <input type="text" class="m3-input-lg" name="seo" id="seo" value="{{ d.seo }}" placeholder=" ">
                            <label class="m3-floating-label">{{ lang.mod_page.admin.columns.seo }}</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="m3-input-wrapper">
                            <input type="text" class="m3-input-lg" name="title" id="title" value="{{ d.title }}" placeholder=" ">
                            <label class="m3-floating-label">{{ lang.mod_page.admin.columns.title }}</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="m3-input-wrapper">
                            <input type="text" class="m3-input-lg" name="keywords" id="keywords" value="{{ d.keywords }}" placeholder=" ">
                            <label class="m3-floating-label">{{ lang.mod_page.admin.columns.keywords }}</label>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="m3-input-wrapper">
                            <input type="text" class="m3-input-lg" name="description" id="description" value="{{ d.description }}" placeholder=" ">
                            <label class="m3-floating-label">{{ lang.mod_page.admin.columns.description }}</label>
                        </div>
                    </div>
                </div>
			</div>

            {# Card 4: Publishing Decision #}
            <div class="edit-card">
				<div class="card-header-edit">
					<i class="bi bi-send-check-fill"></i>
					<h3>{{ lang.mod_page.admin.columns.publish_desc }}</h3>
				</div>
                <input type="hidden" name="status" value="{{ d.status }}" id="publishHidden">
                
                <div class="selection-grid">
                    <div class="selection-card {% if d.status == 'y' %} active {% endif %}" data-action="select-status" data-value="y">
                        <i class="bi bi-cloud-check mod-page-icon-lg"></i>
                        <div class="selection-label">{{ lang.mod_page.admin.radio.publish_yes }}</div>
                        <i class="bi bi-check-circle-fill check-icon"></i>
                    </div>
                    <div class="selection-card {% if d.status != 'y' %} active {% endif %}" data-action="select-status" data-value="n">
                        <i class="bi bi-pencil-square mod-page-icon-lg"></i>
                        <div class="selection-label">{{ lang.mod_page.admin.radio.publish_no }}</div>
                        <i class="bi bi-check-circle-fill check-icon"></i>
                    </div>
                </div>
            </div>
		</div>
	</form>
{% endblock %}

{% block fixed_bottom %}
	<div class="m3-final-bar">
		<button type="button" class="m3-btn-half m3-btn-half-neutral" data-action="cancel-edit" data-href="{{ site.saddress }}mod_page/list">
			<i class="bi bi-x-lg"></i>
			<span>{{ lang.mod_page.button.cancel }}</span>
		</button>
		<button type="button" class="m3-btn-half m3-btn-half-primary" data-action="submit-edit-form" data-form="editForm">
			<i class="bi bi-check-lg"></i>
			<span>{{ lang.mod_page.button.edit }}</span>
		</button>
	</div>
{% endblock %}

{% block scripts %}
<script src="/templates/admin/assets/js/mod_page.js?v=11"></script>
{% endblock %}
