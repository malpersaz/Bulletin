{% extends 'admin/layout.twig' %}
{% set hide_search = true %}
{% set show_fab = false %}
{% set hide_navbar = true %}
{% set show_sidebar = false %}
{% set show_filter_sheet = false %}
{% set show_extra_sheets = true %}
{% set show_wizards = true %}
{% set module_lang_key = 'mod_page' %}

{% block title %}{{ lang.mod_page.add }}{% endblock %}
{% block headline %}{{ lang.mod_page.add }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/templates/admin/assets/css/mod_page_wizard.css?v=2">
{% endblock %}

{% block content %}
    {% if oke is defined %}
        <div class="mod-page-wizard-loader">
            <div class="spinner-track mod-page-wizard-spinner">
                <div class="spinner-fill"></div>
            </div>
            <p>{{ mesaj is defined ? mesaj : lang.mod_page.messages.oke.add }}</p>
        </div>
    {% else %}
        <div class="mod-page-wizard-loader">
            <div class="spinner-track mod-page-wizard-spinner">
                <div class="spinner-fill"></div>
            </div>
            <p>{{ lang.mod_page.add }} wizard is loading...</p>
        </div>
    {% endif %}
{% endblock %}

{% block wizards %}
    {% include 'admin/partials/wizard_page.twig' %}
{% endblock %}

{% block scripts %}
<script>
    window.MOD_PAGE_WIZARD_CONFIG = {
        submitUrl: {{ (site.saddress ~ 'mod_page/add')|json_encode|raw }},
        initialLang: {{ (selected_lang is defined ? selected_lang : site.lang)|lower|json_encode|raw }},
        initialStep: {{ (wizard_step is defined ? wizard_step : 1)|json_encode|raw }},
        hasErrors: {{ (hatalar is defined and hatalar is not empty)|json_encode|raw }},
        hasSuccess: {{ (oke is defined)|json_encode|raw }},
        errorMessages: {{ (hatalar is defined ? hatalar : [])|json_encode|raw }},
        texts: {
            selectedNone: {{ lang.mod_page.choose_wish|json_encode|raw }},
            save: {{ lang.mod_page.button.add|json_encode|raw }},
            next: {{ lang.mod_page.button.next|json_encode|raw }},
            prev: {{ lang.mod_page.button.prev|json_encode|raw }},
            finish: {{ lang.mod_page.button.add|json_encode|raw }},
            validationName: {{ lang.mod_page.admin.columns.name|json_encode|raw }},
            validationContent: {{ lang.mod_page.admin.columns.content|json_encode|raw }},
            closeRedirect: {{ (site.saddress ~ 'mod_user/panel/')|json_encode|raw }}
        }
    };
</script>
<script src="/templates/admin/assets/js/mod_page_wizard.js?v=4"></script>
<!-- wizard_content -->
{% endblock %}
