<script>
    var selectedMenuId = null;
    var sortableInstances = [];
    var isReorderActive = false;

    document.addEventListener('DOMContentLoaded', function() {
        
        // --- 1. Init SortableJS (Disabled by Default) ---
        var root = document.getElementById('menuRootList');
        if(root) initSortable(root);

        document.querySelectorAll('.list-children').forEach(function(el) {
            initSortable(el);
        });

        function initSortable(el) {
            var s = new Sortable(el, {
                group: 'menu_nested',
                animation: 300,
                handle: '.drag-handle',
                disabled: true, // LOCKED BY DEFAULT
                fallbackOnBody: true,
                swapThreshold: 0.65,
                ghostClass: 'sortable-ghost',
                onEnd: function (evt) {
                    Swal.fire({
                        title: '{{ lang.mod_page.messages.warning.reorder }}',
                        text: '{{ lang.mod_page.confirmations.reorder_single }}',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: '{{ lang.mod_page.options.yes }}',
                        cancelButtonText: '{{ lang.mod_page.options.no }}',
                        customClass: { popup: 'm3-swal-popup' }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            var itemEl = evt.item;
                            var newParentId = 0;
                            var container = evt.to;
                            if (container.classList.contains('list-children')) {
                                var parentNode = container.closest('.menu-node');
                                if(parentNode) newParentId = parentNode.getAttribute('data-id');
                            }

                            var activeIds = [];
                            var siblings = container.querySelectorAll(':scope > .menu-node');
                            siblings.forEach(function(node) {
                                activeIds.push(node.getAttribute('data-id'));
                            });
                            
                            updateMenuOrder(itemEl.getAttribute('data-id'), newParentId, activeIds);
                        } else {
                            location.reload(); 
                        }
                    });
                }
            });
            sortableInstances.push(s);
        }

        // --- Toggle Logic ---
        window.toggleReorderMode = function() {
            isReorderActive = !isReorderActive;
            var btn = document.getElementById('reorderToggleBtn');
            var icon = document.getElementById('reorderIcon');
            var text = document.getElementById('reorderText');

            if(isReorderActive) {
                document.body.classList.add('reorder-active');
                icon.className = 'bi bi-unlock-fill';
                text.innerText = '{{ lang.mod_page.actions.lock_reorder }}';
                btn.style.background = '#eaddff'; 
                
                sortableInstances.forEach(s => s.option('disabled', false));
                
                const Toast = Swal.mixin({
                    toast: true, position: 'top-end', showConfirmButton: false, timer: 1500
                });
                Toast.fire({ icon: 'info', title: 'Mode: Rêzkirin (Unlocked)' });

            } else {
                document.body.classList.remove('reorder-active');
                icon.className = 'bi bi-lock-fill';
                text.innerText = '{{ lang.mod_page.actions.unlock_reorder }}';
                btn.style.background = '#f3edf7';
                
                sortableInstances.forEach(s => s.option('disabled', true));
            }
        };

        // --- 2. AJAX Order Update ---
        function updateMenuOrder(id, parent_id, order) {
            var formData = new URLSearchParams();
            formData.append('id', id);
            formData.append('parent_id', parent_id);
            order.forEach(function(sid) { formData.append('order[]', sid); });
            
            fetch('{{ site.saddress }}mod_page/tasi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            })
            .then(function(response) { return response.text(); })
            .then(function(data) {
                if (data.trim() === 'Oke') {
                    const Toast = Swal.mixin({
                        toast: true, position: 'top-end', showConfirmButton: false, timer: 2000
                    });
                    Toast.fire({ icon: 'success', title: '{{ lang.mod_page.oke }}' });
                } else {
                    Swal.fire({ icon: 'error', title: '{{ lang.mod_page.error }}', text: data });
                }
            });
        }

        // --- 3. Search Filter ---
        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function(e) {
                filterMenus(e.target.value);
            });
        }

        window.filterMenus = function(val) {
            var term = val.toLowerCase().trim();
            var nodes = document.querySelectorAll('.menu-node');
            
            if (term.length < 1) {
                nodes.forEach(function(n) { n.style.display = ''; });
                return;
            }

            nodes.forEach(function(n) { n.style.display = 'none'; });

            nodes.forEach(function(n) {
                var name = n.getAttribute('data-name');
                if (name && name.includes(term)) {
                    showNodeRecursive(n);
                }
            });
        };

        function showNodeRecursive(node) {
            node.style.display = 'block';
            var parent = node.parentElement.closest('.menu-node');
            if (parent) {
                showNodeRecursive(parent);
                var children = parent.querySelector('.list-children');
                if(children) {
                    children.classList.remove('collapsed');
                }
                var btn = parent.querySelector('.toggle-btn');
                if(btn) btn.classList.remove('collapsed');
            }
        }
    });

    // --- 4. Interactivity Functions ---

    window.toggleMenu = function(btn, e) {
        if(e) e.stopPropagation();
        var node = btn.closest('.menu-node');
        var children = node.querySelector('.list-children');
        if (children) {
            children.classList.toggle('collapsed');
            btn.classList.toggle('collapsed');
        }
    };

    window.selectMenu = function(id, card) {
        document.querySelectorAll('.m3-list-card.selected').forEach(function(el) {
            el.classList.remove('selected');
        });

        if (selectedMenuId === id) {
            selectedMenuId = null;
            updateToolbar(false);
        } else {
            card.classList.add('selected');
            selectedMenuId = id;
            var status = card.getAttribute('data-status');
            updateToolbar(true, status);
            if (window.navigator.vibrate) window.navigator.vibrate(10);
        }
    };

    function updateToolbar(active, status) {
        var editBtn = document.getElementById('toolbarEdit');
        var delBtn = document.getElementById('toolbarDelete');
        var galleryBtn = document.getElementById('toolbarGallery');
        var filesBtn = document.getElementById('toolbarFiles');
        var approveBtn = document.getElementById('toolbarApprove');
        var approveIcon = document.getElementById('approveIcon');
        var approveText = document.getElementById('approveText');
        
        if (active) {
            editBtn.style.pointerEvents = 'auto';
            editBtn.classList.add('active');
            
            delBtn.style.pointerEvents = 'auto';
            delBtn.classList.add('active');
            
            galleryBtn.style.pointerEvents = 'auto';
            galleryBtn.classList.add('active');
            
            filesBtn.style.pointerEvents = 'auto';
            filesBtn.classList.add('active');
            
            approveBtn.style.pointerEvents = 'auto';
            approveBtn.classList.add('active');
            
            if (status === 'y') {
                approveIcon.className = 'bi bi-eye-slash-fill';
                approveText.innerText = '{{ lang.mod_page.radio.publish_no|default("Neweşîne") }}';
                approveBtn.classList.add('is-unpublished');
            } else {
                approveIcon.className = 'bi bi-eye-fill';
                approveText.innerText = '{{ lang.mod_page.radio.publish_yes|default("Biweşîne") }}';
                approveBtn.classList.remove('is-unpublished');
            }
        } else {
            editBtn.style.pointerEvents = 'none';
            editBtn.classList.remove('active');
            
            delBtn.style.pointerEvents = 'none';
            delBtn.classList.remove('active');
            
            galleryBtn.style.pointerEvents = 'none';
            galleryBtn.classList.remove('active');
            
            filesBtn.style.pointerEvents = 'none';
            filesBtn.classList.remove('active');
            
            approveBtn.style.pointerEvents = 'none';
            approveBtn.classList.remove('active');
            approveBtn.classList.remove('is-unpublished');
            
            approveIcon.className = 'bi bi-eye-fill';
            approveText.innerText = '{{ lang.mod_page.radio.publish_yes|default("Biweşîne") }}';
        }
    }

    window.editSelected = function() {
        if (selectedMenuId) {
            window.location.href = '{{ site.saddress }}mod_page/edit/' + selectedMenuId;
        }
    };

    window.approveSelected = function() {
        if (!selectedMenuId) return;

        var selectedCard = document.querySelector('.m3-list-card.selected');
        if (!selectedCard) return;

        var currentStatus = selectedCard.getAttribute('data-status');
        var isPublishing = currentStatus !== 'y';

        var titleMsg = isPublishing 
            ? '{{ lang.mod_page.quick_publish_confirm }}' 
            : '{{ lang.mod_page.quick_unpublish_confirm }}';

        var successMsg = isPublishing 
            ? '{{ lang.mod_page.published_msg }}' 
            : '{{ lang.mod_page.unpublished_msg }}';

        Swal.fire({
            title: titleMsg,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: '{{ lang.mod_page.options.yes }}',
            cancelButtonText: '{{ lang.mod_page.options.no }}',
            confirmButtonColor: isPublishing ? '#2e7d32' : '#e65100',
            cancelButtonColor: '#6750a4',
            customClass: { popup: 'm3-swal-popup' }
        }).then((result) => {
            if (result.isConfirmed) {
                var formData = new URLSearchParams();
                formData.append('query[]', selectedMenuId);

                var endpoint = isPublishing ? 'approve' : 'unapprove';

                fetch('{{ site.saddress }}mod_page/' + endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                })
                .then(r => r.text())
                .then(data => {
                    if (data.trim() === 'Success') {
                        Swal.fire({
                            title: '{{ lang.mod_page.oke }}',
                            text: successMsg,
                            icon: 'success',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('{{ lang.mod_page.error }}', data, 'error');
                    }
                });
            }
        });
    };

    window.gallerySelected = function() {
        if (selectedMenuId) {
            window.location.href = '{{ site.saddress }}mod_gallery/list/mod_page/' + selectedMenuId;
        }
    };

    window.filesSelected = function() {
        if (selectedMenuId) {
            window.location.href = '{{ site.saddress }}mod_attachment/list/mod_page/' + selectedMenuId;
        }
    };

    window.deleteSelected = function() {
        if (!selectedMenuId) return;

        Swal.fire({
            title: '{{ lang.mod_page.messages.warning.delete }}',
            text: "{{ lang.mod_page.confirmations.delete_single }}",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: '{{ lang.mod_page.options.yes }}',
            cancelButtonText: '{{ lang.mod_page.options.no }}',
            background: 'rgba(255,255,255,0.95)',
            backdrop: `rgba(0,0,10,0.5)`
        }).then((result) => {
            if (result.isConfirmed) {
                var formData = new URLSearchParams();
                formData.append('delete', selectedMenuId);

                fetch('{{ site.saddress }}mod_page/dragdrop_delete', {
                    method: 'POST',
                     headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                })
                .then(r => r.text())
                .then(data => {
                    if (data.trim() === 'Oke') {
                         Swal.fire(
                            '{{ lang.mod_page.oke }}',
                            '{{ lang.mod_page.messages.success.delete }}',
                            'success'
                        ).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('{{ lang.mod_page.error }}', data, 'error');
                    }
                });
            }
        });
    };
</script>
