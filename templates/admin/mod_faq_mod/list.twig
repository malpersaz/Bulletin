{% set hide_navbar = true %}
{% set show_fab = false %}
{% set show_search = true %}
{% set show_search_filter_button = false %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set show_extra_sheets = false %}
{% set hide_contextual_bar = true %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_faq_mod.list }}{% endblock %}
{% block headline %}{{ lang.mod_faq_mod.list }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/mod_faq_mod.css?v=1.0">
{% endblock %}

{% block content %}
<div id="faqModShell" class="faq-mod-shell"
    data-add-url="{{ site.saddress }}mod_faq_mod/add"
    data-datatable-url="{{ site.saddress }}mod_faq_mod/datatable_json"
    data-edit-url="{{ site.saddress }}mod_faq_mod/edit/"
    data-delete-url="{{ site.saddress }}mod_faq_mod/delete"
    data-labels="{{ {
        'modName': lang.mod_faq_mod.admin.columns.mod_name,
        'modKey': lang.mod_faq_mod.admin.columns.mod_key,
        'modValue': lang.mod_faq_mod.admin.columns.mod_value,
        'name': lang.mod_faq_mod.admin.columns.name
    }|json_encode|e('html_attr') }}"
    data-messages="{{ {
        'removeRecord': lang.mod_faq_mod.remove_record,
        'yes': lang.mod_faq_mod.button.yes,
        'no': lang.mod_faq_mod.button.no,
        'deleteSuccess': lang.mod_faq_mod.message.success.delete
    }|json_encode|e('html_attr') }}">
    <div id="faqModList" class="faq-mod-list"></div>
    <section id="faqModEmpty" class="faq-mod-empty">
        <div class="empty-icon-box"><i class="bi bi-patch-question"></i></div>
        <h3>{{ lang.mod_faq_mod.grid.no_data }}</h3>
        <p>{{ lang.mod_faq_mod.admin.empty_description }}</p>
    </section>
</div>
{% endblock %}

{% block fixed_bottom %}
<div class="standard-toolbar">
    <button id="toolbarEdit" class="toolbar-item" disabled>
        <i class="bi bi-pencil-fill"></i>
        <span>{{ lang.mod_faq_mod.button.edit }}</span>
    </button>

    <button id="toolbarDelete" class="toolbar-item" disabled>
        <i class="bi bi-trash3-fill"></i>
        <span>{{ lang.mod_faq_mod.button.delete }}</span>
    </button>
</div>

<!-- Main FAB Button -->
<button class="main-fab" id="mainFab" aria-label="{{ lang.mod_faq_mod.add }}">
    <i class="bi bi-plus-lg"></i>
</button>
{% endblock %}

{% block scripts %}
<script src="{{ site.address }}templates/admin/assets/js/mod_faq_mod_list.js?v=1.0"></script>
{% endblock %}
