{% set module_lang_key = 'mod_content' %}
{% set hide_navbar = true %}
{% set hide_fab = true %}
{% set show_search = true %}
{% set wizard_module = 'mod_content' %}
{% extends 'admin/layout.twig' %}
{% block title %}{{ lang.mod_content.list }}{% endblock %}

{% block headline %}{{ lang.mod_content.list }}{% endblock %}

{% block styles %}
<style>
    .news-toolbar .toolbar-item {
        gap: 0;
        min-width: 44px;
        padding: 8px 4px;
    }
    .news-toolbar .toolbar-item span {
        display: none;
    }
    .news-toolbar #toolbarDelete.active {
        color: #b3261e !important;
        background: rgba(179, 38, 30, 0.12);
    }
    .news-toolbar #toolbarDelete.active i {
        filter: drop-shadow(0 2px 4px rgba(179, 38, 30, 0.24));
    }
    .news-toolbar #toolbarSlider.active {
        color: #0b57d0 !important;
        background: rgba(11, 87, 208, 0.12);
    }
    .news-toolbar #toolbarSlider.is-selected {
        color: #2e7d32 !important;
        background: rgba(46, 125, 50, 0.12);
    }
    .news-image-modal {
        position: fixed;
        inset: 0;
        z-index: 12000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px 16px;
        box-sizing: border-box;
        opacity: 0;
        pointer-events: none;
        overflow-x: hidden;
        transition: opacity 0.24s ease;
    }
    .news-image-modal.active {
        opacity: 1;
        pointer-events: auto;
    }
    .news-image-modal__scrim {
        position: absolute;
        inset: 0;
        z-index: 0;
        background: rgba(28, 27, 31, 0.54);
        backdrop-filter: blur(3px);
    }
    .news-image-modal__sheet {
        position: relative;
        z-index: 1;
        width: min(calc(100vw - 32px), 560px);
        max-height: min(88vh, 760px);
        overflow: auto;
        overflow-x: hidden;
        border-radius: 28px;
        background: var(--md-sys-color-surface, #fff);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.22);
        transform: translateY(28px);
        transition: transform 0.24s ease;
    }
    .news-image-modal.active .news-image-modal__sheet {
        transform: translateY(0);
    }
    .news-image-modal__body {
        padding-bottom: 20px;
    }
    .wizard-title #newsImageModalTitle {
        font-size: 16px;
        font-weight: 500;
    }
    .wizard-title #newsImageModalSubtitle {
        font-size: 12px;
        color: var(--md-sys-color-on-surface-variant);
    }
    .news-image-shell {
        background: var(--md-sys-color-surface-container-low, #f8f2fa);
        border-radius: 24px;
        padding: 16px;
        overflow-x: hidden;
    }
    .news-image-shell .wizard-image-url-row {
        display: grid !important;
        grid-template-columns: 1fr !important;
        align-items: stretch !important;
        gap: 12px !important;
    }
    .news-image-shell .wizard-image-url-input,
    .news-image-shell .wizard-image-url-row .m3-btn-filled {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }
    .news-image-shell .wizard-image-url-row .m3-btn-filled {
        justify-content: center !important;
        white-space: normal !important;
    }
    .news-image-shell .wizard-image-dropzone {
        min-height: 220px;
    }
    .news-image-shell .wizard-image-meta {
        padding-top: 12px;
    }
    .news-image-shell .wizard-image-meta[hidden] {
        display: none !important;
    }
    .news-image-shell .wizard-image-meta strong {
        word-break: break-word;
    }
    .news-image-save[disabled] {
        opacity: 0.45;
        pointer-events: none;
    }
    .news-image-save[hidden] {
        display: none !important;
    }
    .news-image-modal__footer.is-single-action {
        justify-content: flex-start;
    }
    .news-image-modal__footer.is-single-action > * {
        width: 100%;
    }
    .news-image-modal__footer.wizard-footer {
        padding-top: 16px;
        padding-bottom: 24px;
    }
    body.news-image-modal-open {
        overflow: hidden;
        overflow-x: hidden;
    }
    body.news-image-modal-open .app-scroll-frame {
        overflow-x: hidden;
    }
    body.news-image-modal-open .top-app-bar,
    body.news-image-modal-open .search-row,
    body.news-image-modal-open .standard-toolbar {
        opacity: 0;
        pointer-events: none;
        transform: translateY(-8px);
        transition: opacity 0.18s ease, transform 0.18s ease;
    }
    @media (max-width: 767px) {
        .news-image-modal {
            align-items: flex-end;
            padding: 0;
        }
        .news-image-modal__sheet {
            width: 100%;
            max-height: 88vh;
            border-radius: 28px 28px 0 0;
        }
        .news-image-modal__body,
        .news-image-modal__footer {
            padding-left: 12px;
            padding-right: 12px;
        }
    }
</style>
{% endblock %}

{% block content %}
<div style="padding: 0 16px 16px 16px; display: flex; flex-direction: column; gap: 12px; margin-bottom: 8px;">
    <div style="display: flex; gap: 12px;">
        <div class="stat-card" style="flex: 1; background: #F3EDF7; padding: 16px; border-radius: 12px; text-align: center;">
            <div style="font-size: 24px; font-weight: 700; color: #6750A4;">{{ total_content }}</div>
            <div style="font-size: 12px; color: #49454F; font-weight: 500;">{{ lang.mod_user.panel.total_content }}</div>
        </div>
        <div class="stat-card" style="flex: 1; background: #F3EDF7; padding: 16px; border-radius: 12px; text-align: center;">
            <div style="font-size: 24px; font-weight: 700; color: #6750A4;">{{ draft_content }}</div>
            <div style="font-size: 12px; color: #49454F; font-weight: 500;">{{ lang.mod_user.panel.draft_content }}</div>
        </div>
    </div>
</div>

<div id="ptr-spinner" class="ptr-spinner">
    <div class="spinner-track">
        <div class="spinner-fill"></div>
    </div>
</div>

<div id="content-list-container" class="content-list">
</div>

<div id="empty-state" class="empty-state" style="display: none;">
    <div class="empty-icon"><i class="bi bi-inbox"></i></div>
    <h3>{{ lang.mod_content.datatable.zeroRecords }}</h3>
    <p>{{ lang.mod_content.datatable.emptyTable }}</p>
</div>

<div id="infinite-loader" class="infinite-loader" style="display: none;">
    <div class="spinner-track">
        <div class="spinner-fill"></div>
    </div>
    <span>{{ lang.mod_content.datatable.loadingRecords }}</span>
</div>

<form id="filterForm" style="display: none;">
    <input type="hidden" name="start" id="filterStart" value="0">
    <input type="hidden" name="length" id="filterLength" value="10">
    <input type="hidden" name="draw" id="filterDraw" value="1">
    <input type="hidden" name="search[name]" id="filterSearch" value="">
    <input type="hidden" name="search[lang]" id="filterLang" value="">
    <input type="hidden" name="search[category_id]" id="filterCategory" value="">
    <input type="hidden" name="order[0][column]" id="filterSortColumn" value="1">
    <input type="hidden" name="order[0][dir]" id="filterSortDir" value="desc">
</form>

<div id="newsImageModal" class="news-image-modal" aria-hidden="true">
    <div class="news-image-modal__scrim" onclick="window.contentManager?.closeImageUploader()"></div>
    <div class="news-image-modal__sheet" role="dialog" aria-modal="true" aria-labelledby="newsImageModalTitle">
        <header class="wizard-header">
            <button type="button" class="icon-btn" onclick="window.contentManager?.closeImageUploader()">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="wizard-title">
                <span id="newsImageModalTitle">{{ lang.mod_content.wizard.step.image }}</span>
                <span id="newsImageModalSubtitle" hidden></span>
            </div>
        </header>

        <div class="wizard-progress-bar">
            <div class="wizard-progress-fill" style="width: 100%;"></div>
        </div>

        <div class="wizard-content news-image-modal__body">
            {% include 'admin/partials/image_uploader.twig' with {
                shell_id: 'listImageShell',
                shell_class: 'news-image-shell',
                has_image: false,
                shell_attrs: {
                    'data-drop-title': lang.mod_content.wizard.image.drop_title,
                    'data-drop-description': lang.mod_content.wizard.image.drop_description,
                    'data-upload-link': lang.mod_content.wizard.image.upload_link,
                    'data-link-separator': lang.mod_content.wizard.image.link_separator,
                    'data-link-placeholder': lang.mod_content.wizard.image.link_placeholder,
                    'data-link-action': lang.mod_content.wizard.image.link_action,
                    'data-hint-loading': lang.mod_content.wizard.image.hint_loading,
                    'data-hint-invalid-type': lang.mod_content.wizard.image.hint_invalid_type,
                    'data-hint-no-drop-data': lang.mod_content.wizard.image.hint_no_drop_data,
                    'data-hint-remote-failed': lang.mod_content.wizard.image.hint_remote_failed,
                    'data-empty-name': lang.mod_content.wizard.summary.selected_none,
                    'data-empty-meta': lang.mod_content.wizard.image.drop_description
                },
                dropzone_id: 'listImageDropzone',
                trigger_picker_js: "document.getElementById('listImgInput')?.click()",
                empty_state_id: 'listImageEmptyState',
                drop_title: lang.mod_content.wizard.image.drop_title,
                upload_link: lang.mod_content.wizard.image.upload_link,
                preview_card_id: 'listImagePreviewCard',
                remove_button_label: lang.mod_content.button.delete,
                remove_action_js: 'window.contentManager?.handleListImageRemoveAction()',
                preview_img_id: 'listImgPreview',
                preview_alt: '',
                preview_hidden: true,
                meta_id: 'listImageMeta',
                meta_hidden: true,
                file_name_id: 'listImageFileName',
                file_name_text: lang.mod_content.wizard.summary.selected_none,
                file_details_id: 'listImageFileDetails',
                file_details_text: lang.mod_content.wizard.image.drop_description,
                divider_hidden: false,
                link_separator: lang.mod_content.wizard.image.link_separator,
                url_row_hidden: false,
                url_input_id: 'listImageUrlInput',
                link_placeholder: lang.mod_content.wizard.image.link_placeholder,
                import_btn_id: 'listImageUrlImportBtn',
                link_action: lang.mod_content.wizard.image.link_action,
                file_input_id: 'listImgInput'
            } %}
        </div>

        <div id="newsImageModalFooter" class="wizard-footer news-image-modal__footer is-single-action">
            <button type="button" id="newsImageCancelBtn" class="m3-btn-outlined" onclick="window.contentManager?.closeImageUploader()">{{ lang.mod_content.button.vazgec }}</button>
        </div>
    </div>
</div>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar news-toolbar">
        <button id="toolbarSlider" class="toolbar-item" onclick="sliderSelected()" style="opacity:0.3; pointer-events:none;" title="{{ lang.mod_content.hero_slider_add }}">
            <i class="bi bi-stars"></i>
        </button>

        <button id="toolbarVideo" class="toolbar-item" onclick="videoSelected()" style="opacity:0.3; pointer-events:none;" title="{{ lang.mod_content.context_menu.video }}">
            <i class="bi bi-camera-video"></i>
        </button>

        <button id="toolbarGallery" class="toolbar-item" onclick="gallerySelected()" style="opacity:0.3; pointer-events:none;" title="{{ lang.mod_content.context_menu.gallery }}">
            <i class="bi bi-image"></i>
        </button>

        <button id="toolbarFiles" class="toolbar-item" onclick="filesSelected()" style="opacity:0.3; pointer-events:none;" title="{{ lang.mod_content.context_menu.files }}">
            <i class="bi bi-paperclip"></i>
        </button>

        <button id="toolbarEdit" class="toolbar-item" onclick="editSelected()" style="opacity:0.3; pointer-events:none;" title="{{ lang.mod_content.context_menu.edit }}">
            <i class="bi bi-pencil-fill"></i>
        </button>

        <button id="toolbarDelete" class="toolbar-item" onclick="deleteSelected()" style="opacity:0.3; pointer-events:none;" title="{{ lang.mod_content.context_menu.delete }}">
            <i class="bi bi-trash3-fill"></i>
        </button>
    </div>

    <!-- Main FAB Button -->
    <button class="main-fab" id="mainFab" onclick="location.href='{{ site.saddress }}mod_content/add'" aria-label="{{ lang.mod_content.add }}">
        <i class="bi bi-plus-lg"></i>
    </button>
{% endblock %}

{% block scripts %}
<script>
    const MODULE_URL = SITE_URL + "mod_content/";
    const DATA_URL = SITE_URL + "mod_content/datatable_json";

    const CATEGORY_MAP = {
        {% for cat in categories %}
        "{{ cat.id }}": "{{ cat.name|escape('js') }}",
        {% endfor %}
    };
    const CONTENT_LANG = {
        active: "{{ lang.mod_content.status_badge.active|e('js') }}",
        draft: "{{ lang.mod_content.status_badge.draft|e('js') }}",
        general: "{{ lang.mod_content.status_badge.general|e('js') }}",
        sheet_all: "{{ lang.mod_content.sheet.all|e('js') }}",
        confirm_delete: "{{ lang.mod_content.delete_confirm|e('js') }}",
        confirm_publish: "{{ lang.mod_content.quick_publish_confirm|e('js') }}",
        confirm_unpublish: "{{ lang.mod_content.quick_unpublish_confirm|e('js') }}",
        error_general: "{{ lang.mod_content.hata|e('js') }}",
        error_upload: "{{ lang.mod_content.message.error.add|e('js') }}",
        save_image: "{{ lang.mod_content.wizard.button.save|e('js') }}",
        cancel: "{{ lang.mod_content.button.vazgec|e('js') }}",
        image_title: "{{ lang.mod_content.wizard.step.image|e('js') }}",
        image_empty: "{{ lang.mod_content.wizard.summary.selected_none|e('js') }}",
        image_remote_failed: "{{ lang.mod_content.wizard.image.hint_remote_failed|e('js') }}",
        image_drop_description: "{{ lang.mod_content.wizard.image.drop_description|e('js') }}",
        image_updated: "{{ lang.mod_content.oke|e('js') }}",
        image_remove_title: "{{ lang.mod_content.remove_image|e('js') }}",
        image_remove_confirm: "{{ lang.mod_content.context_menu.delete_confirm|e('js') }}",
        image_remove_confirm_text: "{{ lang.mod_content.button.evet|e('js') }}",
        image_remove_cancel_text: "{{ lang.mod_content.button.hayir|e('js') }}",
        image_remove_success: "{{ lang.mod_content.remove_image_oke|e('js') }}",
        hero_slider_add: "{{ lang.mod_content.hero_slider_add|e('js') }}",
        hero_slider_remove: "{{ lang.mod_content.hero_slider_remove|e('js') }}",
        hero_slider_added: "{{ lang.mod_content.hero_slider_added|e('js') }}",
        hero_slider_removed: "{{ lang.mod_content.hero_slider_removed|e('js') }}",
        hero_slider_error: "{{ lang.mod_content.hero_slider_error|e('js') }}",
        hero_slider_badge: "{{ lang.mod_content.hero_slider_badge|e('js') }}",
        picker: {
            file: "{{ lang.mod_content.picker.file|e('js') }}",
            video: "{{ lang.mod_content.context_menu.video|e('js') }}"
        },
        loading: "{{ lang.mod_content.datatable.loadingRecords|e('js') }}",
        grid: {
            load_more: "{{ lang.mod_content.grid.load_more|e('js') }}"
        }
    };
</script>
<script src="/templates/admin/assets/js/mod_content.js?v=3.5"></script>
{% endblock %}
