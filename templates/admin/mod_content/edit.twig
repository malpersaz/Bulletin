{% block scripts %}
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script>
        // Initialize Rich Editor
        document.addEventListener('DOMContentLoaded', () => {
            const currentLang = '{{ d.lang|lower }}';
            if (typeof adminLang !== 'undefined' && Array.isArray(adminLang.languages)) {
                adminLang.languages = adminLang.languages.filter((item) => item.status === 'y' || item.code === currentLang);
            }
            if (typeof wizardData !== 'undefined') {
                wizardData.lang = currentLang;
            }
            initRichEditor('#editContentTextarea', 400);
            initializeEditImageInteractions();
        });

        // Store current edit mode to override sheet behavior
        let isEditMode = true;

		// Handle Language Selection via Sheet
        function openLangSheetForEdit() {
            // Re-render sheet to use radio-like selection for single lang
            tempSelectedLang = document.getElementById('editLang').value;
            renderLangList();
            
            // Override toggle functionality for this session
            window.toggleLangSelection = function(code) {
                tempSelectedLang = code;
                window.confirmLangSelection();
            };
            
            // Override confirm functionality
            window.confirmLangSelection = function() {
                const lang = tempSelectedLang;
                document.getElementById('editLang').value = lang;
                
                // Update Name Label
                const langObj = adminLang.languages.find(l => l.code === lang.toUpperCase() || l.code === lang.toLowerCase());
                document.getElementById('editSelectedLang').innerText = langObj ? langObj.name : lang.toUpperCase();
                
                closeLangSheet();
                
                // Sync with wizardData for category filtering if needed
                if(window.wizardData) wizardData.lang = lang;
            };
            
            openLangSheet();
        }

		// Handle Category Selection
		window.selectWizardCategory = function (name, id) {
			document.getElementById('editCategoryId').value = id;
			document.getElementById('wizardSelectedCategory').innerText = name;
            document.getElementById('wizardSelectedCategory').style.color = 'var(--md-sys-color-on-surface)';
			toggleWizardCategorySheet();
		};

        // Character Counter
        window.updateCharCounter = function(input, counterId, max) {
            const currentLength = input.value.length;
            const counter = document.getElementById(counterId);
            if(counter) {
                counter.innerText = `${currentLength} / ${max}`;
            }
        };

		// Advanced Accordion
		        function selectPublishStatus(el, val) {
            document.querySelectorAll('#publishHidden ~ .selection-grid .selection-card').forEach(c => c.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('publishHidden').value = val;
        }

		function selectDeckStatus(el, val) {
            document.querySelectorAll('#deckHidden ~ div .selection-card').forEach(c => c.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('deckHidden').value = val;
        }

        function toggleAdvanced() {
			const content = document.getElementById('advancedContent');
			const icon = document.getElementById('advancedIcon');
			content.classList.toggle('active');
			icon.classList.toggle('bi-chevron-up');
			icon.classList.toggle('bi-chevron-down');
		}

		// Meta Fields Sync
		function updateMetaFields() {
			const name = document.getElementById('editTitleInput').value;
			document.getElementById('seo').value = makeSeoValue(name);
			document.getElementById('title').value = temizle(name);
			document.getElementById('keywords').value = makeKeywordsValue(name);
			document.getElementById('description').value = temizle(name);
            
			document.getElementById('keywords').value = makeKeywordsValue(name);
			document.getElementById('description').value = temizle(name);
		}

        function submitEditForm(formId) {
            if (typeof tinymce !== 'undefined') {
                tinymce.triggerSave();
            }

            const form = document.getElementById(formId);
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }
            form.submit();
        }
	</script>
{% endblock %}
