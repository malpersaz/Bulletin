			<i class="bi bi-x-lg"></i>
			{{ lang.mod_content.button.vazgec }}
		</button>
		<button type="button" class="m3-btn-half" onclick="submitEditForm('editForm')" style="background: var(--md-sys-color-primary) !important; color: var(--md-sys-color-on-primary) !important;">
