<script>
    let selectedUserGroupId = null;
    let sortableInstances = [];
    let isReorderActive = false;

    document.addEventListener('DOMContentLoaded', function() {
        // --- 1. Global Search Integration ---
        const globalSearchInput = document.getElementById('searchInput');
        if (globalSearchInput) {
            globalSearchInput.addEventListener('input', function(e) {
                filterUserGroups(e.target.value);
            });
        }

        window.clearSearch = function() {
            if (globalSearchInput) {
                globalSearchInput.value = '';
                filterUserGroups('');
            }
        };

        // --- 2. Sortable (Safe Reorder Mode) ---
        function initSortable(el) {
            if (!el || typeof Sortable === 'undefined') return;
            var s = new Sortable(el, {
                group: 'nested_groups',
                animation: 300,
                fallbackOnBody: true,
                swapThreshold: 0.65,
                handle: '.drag-handle',
                disabled: true, // LOCKED BY DEFAULT
                ghostClass: 'sortable-ghost',
                dragClass: 'sortable-drag',
                onEnd: function(evt) {
                    Swal.fire({
                        title: '{{ lang.mod_user_group[19]|default("Rêzkirin")|e('js') }}',
                        text: '{{ lang.mod_user_group[15]|default("Ma tu dixwazî rêzê biguherî?")|e('js') }}',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: '{{ lang.mod_user_group[15]|default("Erê")|e('js') }}',
                        cancelButtonText: '{{ lang.mod_user_group[16]|default("Na")|e('js') }}',
                        customClass: { popup: 'm3-swal-popup' }
                    }).then((result) => {
                        if (result.isConfirmed) {
                             updateOrder(evt);
                        } else {
                            location.reload();
                        }
                    });
                }
            });
            sortableInstances.push(s);
        }

        const rootList = document.getElementById('userGroupRootList');
        if(rootList) initSortable(rootList);
        document.querySelectorAll('.list-children').forEach(el => initSortable(el));

        // --- Toggle Logic ---
        window.toggleReorderMode = function() {
            isReorderActive = !isReorderActive;
            var btn = document.getElementById('reorderToggleBtn');
            var icon = document.getElementById('reorderIcon');
            var text = document.getElementById('reorderText');

            if(isReorderActive) {
                document.body.classList.add('reorder-active');
                icon.className = 'bi bi-unlock-fill';
                text.innerText = '{{ lang.mod_user_group[19]|default("Rêzkirinê Bigire")|e('js') }}';
                btn.style.background = '#eaddff'; 
                
                sortableInstances.forEach(s => s.option('disabled', false));
                
                const Toast = Swal.mixin({
                    toast: true, position: 'top-end', showConfirmButton: false, timer: 1500
                });
                Toast.fire({ icon: 'info', title: 'Mode: Rêzkirin (Vekirî)' });

            } else {
                document.body.classList.remove('reorder-active');
                icon.className = 'bi bi-lock-fill';
                text.innerText = '{{ lang.mod_user_group[19]|default("Rêzkirinê Veke")|e('js') }}';
                btn.style.background = '#f3edf7';
                
                sortableInstances.forEach(s => s.option('disabled', true));
            }
        };

        function updateOrder(evt) {
            const itemEl = evt.item;
            const groupId = itemEl.dataset.id;
            const container = evt.to;
            
            let parentId = 0;
            if (container.classList.contains('list-children')) {
                const wrapperNode = container.closest('.category-node');
                if (wrapperNode) parentId = wrapperNode.dataset.id;
            }

            const allIds = [];
            document.querySelectorAll('.category-node').forEach(node => {
                if (node.dataset.id) { allIds.push(node.dataset.id); }
            });

            const card = itemEl.querySelector('.m3-list-card');
            if(card) card.style.opacity = "0.5";

            const formData = new URLSearchParams();
            formData.append('group_id', groupId);
            formData.append('parent_id', parentId);
            
            fetch('{{ site.sadres }}mod_user_group/move', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            })
            .then(response => response.text())
            .then(resp => {
                if (resp.trim().toUpperCase() === 'OK') {
                    const orderData = new URLSearchParams();
                    allIds.forEach(sid => orderData.append('order[]', sid));
                    
                    return fetch('{{ site.sadres }}mod_user_group/order', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: orderData
                    });
                } else {
                    throw new Error(resp);
                }
            })
            .then(response => response.text())
            .then(orderResp => {
                if(card) card.style.opacity = "1";
                if (orderResp.trim().toUpperCase() === 'OK') {
                    const Toast = Swal.mixin({
                        toast: true, position: 'top-end', showConfirmButton: false, timer: 2000, timerProgressBar: true
                    });
                    Toast.fire({ icon: 'success', title: '{{ lang.mod_user_group[10]|default("Serkeftî!")|e('js') }}' });
                } else {
                    throw new Error(orderResp);
                }
            })
            .catch(err => {
                if(card) card.style.opacity = "1";
                console.error('Order update error:', err);
                Swal.fire({ icon: 'error', title: 'Çewtî', text: String(err) });
                setTimeout(() => location.reload(), 1000);
            });
        }
    });

    window.filterUserGroups = function(val) {
        const term = val.toLowerCase().trim();
        const nodes = document.querySelectorAll('.category-node');
        
        if (!term) {
            nodes.forEach(n => {
                n.style.display = '';
                const children = n.querySelector('.list-children');
                if(children) children.classList.remove('collapsed');
                n.querySelector('.toggle-btn')?.classList.remove('collapsed');
            });
            return;
        }

        nodes.forEach(n => n.style.display = 'none');
        nodes.forEach(n => {
            const name = n.dataset.name || '';
            if (name.includes(term)) {
                showRecursively(n);
            }
        });

        function showRecursively(node) {
            node.style.display = 'block';
            let parent = node.parentElement.closest('.category-node');
            while (parent) {
                parent.style.display = 'block';
                parent.querySelector('.list-children')?.classList.remove('collapsed');
                parent.querySelector('.toggle-btn')?.classList.remove('collapsed');
                parent = parent.parentElement.closest('.category-node');
            }
        }
    };

    window.toggleUserGroup = function(btn, event) {
        if (event) event.stopPropagation();
        const node = btn.closest('.category-node');
        const children = node.querySelector('.list-children');
        
        if (children) {
            children.classList.toggle('collapsed');
            btn.classList.toggle('collapsed');
        }
    };

    window.selectUserGroup = function(id, element) {
        const isCurrent = element.classList.contains('selected');
        document.querySelectorAll('.m3-list-card.selected').forEach(el => {
            el.classList.remove('selected');
        });

        if (!isCurrent) {
            element.classList.add('selected');
            selectedUserGroupId = id;
            toggleToolbar(true);
            if (window.navigator.vibrate) window.navigator.vibrate(10);
        } else {
            selectedUserGroupId = null;
            toggleToolbar(false);
        }
    };

    function toggleToolbar(active) {
        const edit = document.getElementById('toolbarEdit');
        const del = document.getElementById('toolbarDelete');
        if (edit && del) {
            if (active) {
                edit.classList.add('active');
                del.classList.add('active');
                edit.style.pointerEvents = "auto";
                del.style.pointerEvents = "auto";
                edit.style.opacity = "1";
                del.style.opacity = "1";
            } else {
                edit.classList.remove('active');
                del.classList.remove('active');
                edit.style.pointerEvents = "none";
                del.style.pointerEvents = "none";
                edit.style.opacity = "0.3";
                del.style.opacity = "0.3";
            }
        }
    }

    window.editSelected = function() {
        if (selectedUserGroupId) {
            window.location.href = "{{ site.sadres }}mod_user_group/edit/" + selectedUserGroupId;
        }
    };

    window.deleteSelected = function() {
        if (!selectedUserGroupId) return;

        Swal.fire({
            title: '{{ lang.mod_user_group[8]|default("Ma tu dixwazî jê bibî?")|e('js') }}',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ff4444',
            cancelButtonColor: '#999',
            confirmButtonText: '{{ lang.mod_user_group[15]|default("Erê")|e('js') }}',
            cancelButtonText: '{{ lang.mod_user_group[16]|default("Na")|e('js') }}',
            customClass: { popup: 'premium-swal-popup' }
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('{{ site.sadres }}mod_user_group/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ group_id: selectedUserGroupId }).toString()
                })
                .then(response => response.text())
                .then(resp => {
                    if (resp.trim().toUpperCase() === 'OK') {
                        Swal.fire({ icon: 'success', title: 'Serkeftî!', timer: 1000, showConfirmButton: false });
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        Swal.fire('Çewtî', resp, 'error');
                    }
                })
                .catch(err => {
                    console.error('Delete error:', err);
                    Swal.fire('Çewtî', 'Çewtiya torê', 'error');
                });
            }
        });
    };
</script>
