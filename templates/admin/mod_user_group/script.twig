<script>
    let selectedUserGroupId = null;
    let userGroupSortables = [];
    let reorderActive = false;

    document.addEventListener('DOMContentLoaded', function () {
        const root = document.getElementById('userGroupRootList');
        if (root) initSortable(root);
        document.querySelectorAll('.list-children').forEach(el => initSortable(el));

        // Mobile Mesh Background support
        var wrapper = document.querySelector('.mobile-wrapper');
        if(wrapper) {
            wrapper.classList.add('mesh-bg');
        }

        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', e => filterUserGroups(e.target.value));
        }
    });

    function initSortable(el) {
        const sortable = new Sortable(el, {
            group: 'user_group_nested',
            animation: 250,
            handle: '.drag-handle',
            disabled: true,
            fallbackOnBody: true,
            swapThreshold: 0.65,
            ghostClass: 'sortable-ghost',
            onEnd: function (evt) {
                Swal.fire({
                    title: '{{ lang.mod_user_group[19]|e('js') }}',
                    text: '{{ lang.mod_user_group[15]|default('Confirm')|e('js') }}',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: '{{ lang.mod_user_group[15]|default('Yes')|e('js') }}',
                    cancelButtonText: '{{ lang.mod_user_group[16]|default('Cancel')|e('js') }}'
                }).then(result => {
                    if (!result.isConfirmed) {
                        location.reload();
                        return;
                    }

                    const item = evt.item;
                    const groupId = item.dataset.id;
                    let parentId = 0;
                    if (evt.to.classList.contains('list-children')) {
                        const parentNode = evt.to.closest('.user-group-node');
                        if (parentNode) parentId = parentNode.dataset.id;
                    }

                    const orderIds = [];
                    // We need to get ids in current container for specific order if backend supports it
                    // But usually, we send all visible IDs in order
                    document.querySelectorAll('.user-group-node').forEach(node => {
                        if (node.dataset.id) orderIds.push(node.dataset.id);
                    });

                    fetch('{{ site.sadres }}mod_user_group/tasi', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: new URLSearchParams({ group_id: groupId, parent_id: parentId }).toString()
                    })
                    .then(response => response.text())
                    .then(moveResponse => {
                        if (moveResponse.trim().toUpperCase() !== 'OK') {
                            throw new Error(moveResponse);
                        }

                        const orderData = new URLSearchParams();
                        orderIds.forEach(id => orderData.append('order[]', id));
                        return fetch('{{ site.sadres }}mod_user_group/sira', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: orderData.toString()
                        });
                    })
                    .then(response => response.text())
                    .then(orderResponse => {
                        if (orderResponse.trim().toUpperCase() !== 'OK') {
                            throw new Error(orderResponse);
                        }
                        showSnackbar('{{ lang.mod_user_group[10]|e('js') }}', 'success');
                    })
                    .catch(error => {
                        showSnackbar(String(error.message || error), 'error');
                        setTimeout(() => location.reload(), 700);
                    });
                });
            }
        });
        userGroupSortables.push(sortable);
    }

    window.toggleReorderMode = function () {
        reorderActive = !reorderActive;
        const icon = document.getElementById('reorderIcon');
        const text = document.getElementById('reorderText');
        const btn = document.getElementById('reorderToggleBtn');

        if (reorderActive) {
            icon.className = 'bi bi-unlock-fill';
            text.textContent = '{{ lang.mod_user_group[19]|e('js') }}';
            btn.style.background = '#eaddff';
            userGroupSortables.forEach(sortable => sortable.option('disabled', false));
        } else {
            icon.className = 'bi bi-lock-fill';
            text.textContent = '{{ lang.mod_user_group[19]|e('js') }}';
            btn.style.background = '#f3edf7';
            userGroupSortables.forEach(sortable => sortable.option('disabled', true));
        }
    };

    window.toggleUserGroup = function (button, event) {
        if (event) event.stopPropagation();
        const node = button.closest('.user-group-node');
        const children = node.querySelector('.list-children');
        if (children) {
            children.classList.toggle('collapsed');
            button.classList.toggle('collapsed');
        }
    };

    window.selectUserGroup = function (id, card) {
        document.querySelectorAll('.m3-list-card.selected').forEach(el => el.classList.remove('selected'));

        if (selectedUserGroupId === id) {
            selectedUserGroupId = null;
            updateToolbar(false);
            return;
        }

        selectedUserGroupId = id;
        card.classList.add('selected');
        updateToolbar(true);
    };

    function updateToolbar(active) {
        const edit = document.getElementById('toolbarEdit');
        const del = document.getElementById('toolbarDelete');
        [edit, del].forEach(btn => {
            if (!btn) return;
            btn.style.pointerEvents = active ? 'auto' : 'none';
            btn.style.opacity = active ? '1' : '0.3';
            btn.classList.toggle('active', active);
        });
    }

    window.editSelected = function () {
        if (!selectedUserGroupId) return;
        window.location.href = '{{ site.sadres }}mod_user_group/edit/' + selectedUserGroupId;
    };

    window.deleteSelected = function () {
        if (!selectedUserGroupId) return;

        Swal.fire({
            title: '{{ lang.mod_user_group[8]|e('js') }}',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '{{ lang.mod_user_group[15]|default('Yes')|e('js') }}',
            cancelButtonText: '{{ lang.mod_user_group[16]|default('Cancel')|e('js') }}'
        }).then(result => {
            if (!result.isConfirmed) return;

            fetch('{{ site.sadres }}mod_user_group/sil', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ group_id: selectedUserGroupId }).toString()
            })
            .then(response => response.text())
            .then(text => {
                if (text.trim().toUpperCase() !== 'OK') {
                    throw new Error(text);
                }
                showSnackbar('{{ lang.mod_user_group[9]|e('js') }}', 'success');
                setTimeout(() => location.reload(), 500);
            })
            .catch(error => showSnackbar(String(error.message || error), 'error'));
        });
    };

    window.filterUserGroups = function (value) {
        const term = String(value || '').toLowerCase().trim();
        const nodes = document.querySelectorAll('.user-group-node');

        if (!term) {
            nodes.forEach(node => node.style.display = '');
            return;
        }

        nodes.forEach(node => node.style.display = 'none');
        nodes.forEach(node => {
            const name = node.dataset.name || '';
            if (name.includes(term)) showParents(node);
        });
    };

    function showParents(node) {
        node.style.display = 'block';
        let parent = node.parentElement.closest('.user-group-node');
        while (parent) {
            parent.style.display = 'block';
            parent.querySelector('.list-children')?.classList.remove('collapsed');
            parent.querySelector('.toggle-btn')?.classList.remove('collapsed');
            parent = parent.parentElement.closest('.user-group-node');
        }
    }
</script>
