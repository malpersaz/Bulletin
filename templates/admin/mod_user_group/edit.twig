{% extends 'admin/layout.twig' %}

{% set module_lang_key = 'mod_user_group' %}
{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}
{% set show_filter_sheet = false %}
{% set show_extra_sheets = false %}
{% set breadcrumb_parent_url = site.saddress ~ 'mod_user_group/list' %}
{% set breadcrumb_parent_title = lang.mod_user_group.admin.list %}

{% macro select(parent_id, level, current_id, selected_id, items, disable) %}
    {% if items[parent_id] is defined %}
        {% for entry in items[parent_id] %}
            {% set next_disable = disable or entry.group_id == current_id %}
            <option value="{{ entry.group_id }}" {% if entry.group_id == selected_id %}selected{% endif %} {% if entry.group_id == current_id or disable %}disabled{% endif %}>
                {{ '-'|repeat(level * 2) ~ entry.name }}
            </option>
            {{ _self.select(entry.group_id, level + 1, current_id, selected_id, items, next_disable) }}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% block title %}{{ lang.mod_user_group.admin.edit_area }}{% endblock %}
{% block headline %}{{ lang.mod_user_group.admin.edit_area }}{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/mod_user_group.css?v=1.0">
{% endblock %}

{% block content %}
<div class="user-group-form-shell">
    {% if success is defined %}
        <div class="form-status success">{{ message }}</div>
    {% endif %}
    {% if error is defined %}
        <div class="form-status error">{{ error }}</div>
    {% endif %}
    {% if errors is defined %}
        <div class="form-status error">
            {% for msg in errors %}
                <div>{{ msg }}</div>
            {% endfor %}
        </div>
    {% endif %}

    <form method="POST" action="" id="editUserGroupForm" class="user-group-form-card">
        <div class="m3-input-wrapper">
            <input class="m3-input-lg" name="name" value="{{ d.name }}" type="text" id="name" placeholder=" ">
            <label class="m3-floating-label">{{ lang.mod_user_group.admin.group_name }}</label>
        </div>

        <div class="m3-input-wrapper">
            <select class="m3-input-lg" name="parent_id" id="parent_id">
                <option value="0" {% if d.parent_id == '0' or d.parent_id == 0 %}selected{% endif %}>{{ lang.mod_user_group.select_optional }}</option>
                {{ _self.select(0, 0, d.group_id, d.parent_id, user_groupm, false) }}
            </select>
            <label class="m3-floating-label">{{ lang.mod_user_group.admin.sub_group }}</label>
        </div>
    </form>
</div>
{% endblock %}

{% block fixed_bottom %}
{% if success is not defined %}
    <div class="user-group-bottom-bar">
        <a href="{{ site.saddress }}mod_user_group/list" class="cancel-btn">
            <i class="bi bi-arrow-left"></i>
            <span>{{ lang.mod_user_group.buttons.cancel }}</span>
        </a>
        <button type="submit" form="editUserGroupForm" name="edit" value="1" class="save-btn">
            <i class="bi bi-check2-circle"></i>
            <span>{{ lang.mod_user_group.buttons.save }}</span>
        </button>
    </div>
{% endif %}
{% endblock %}
