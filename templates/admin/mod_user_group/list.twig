{% set module_lang_key = 'mod_user_group' %}
{% set hide_navbar = true %}
{% set hide_fab = true %}
{% set show_filter_sheet = false %}
{% set show_extra_sheets = false %}
{% extends "admin/layout.twig" %}

{% block title %}{{ lang.mod_user_group.admin.list }}{% endblock %}
{% block headline %}{{ lang.mod_user_group.admin.list }}{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/mod_user_group.css?v=1.0">
{% endblock %}

{% macro render_tree(items, parent_id, level) %}
    {% if items[parent_id] is defined %}
        {% for entry in items[parent_id] %}
            <div class="category-node" data-id="{{ entry.group_id }}" data-parent="{{ entry.parent_id }}" data-name="{{ entry.name|lower }}">
                <div class="m3-list-card" data-action="select-user-group" data-id="{{ entry.group_id }}">
                    <div class="drag-handle"><i class="bi bi-grip-vertical"></i></div>

                    {% if items[entry.group_id] is defined %}
                        <button type="button" class="toggle-btn collapsed" data-action="toggle-user-group" aria-label="{{ entry.name }}">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    {% else %}
                        <div class="user-group-tree-spacer"></div>
                    {% endif %}

                    <div class="card-thumb">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <div class="card-info">
                        <div class="card-title">{{ entry.name }}</div>
                        <div class="card-meta">
                            <span class="meta-id">#{{ entry.group_id }}</span>
                            <span class="meta-badge">L{{ level + 1 }}</span>
                        </div>
                    </div>
                </div>

                {% if items[entry.group_id] is defined %}
                    <div class="list-children collapsed">
                        {{ _self.render_tree(items, entry.group_id, level + 1) }}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}
{% endmacro %}

{% block content %}
    <div class="content-list" id="userGroupRootList">
        <div class="reorder-controller">
            <button type="button" id="reorderToggleBtn" class="btn-m3-tonal" data-action="toggle-reorder-mode">
                <i class="bi bi-lock-fill" id="reorderIcon"></i>
                <span id="reorderText">{{ lang.mod_user_group.reorder_active }}</span>
            </button>
        </div>

        {% if user_groupm[0] is defined %}
            {{ _self.render_tree(user_groupm, 0, 0) }}
        {% else %}
            <div class="empty-state-container">
                <div class="empty-icon-box">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <h2 class="empty-state-title">{{ lang.mod_user_group.admin.list }}</h2>
                <a href="{{ site.saddress }}mod_user_group/add" class="toolbar-fab empty-state-fab" aria-label="{{ lang.mod_user_group.add }}">
                    <i class="bi bi-plus-lg"></i>
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button type="button" id="toolbarEdit" class="toolbar-item is-disabled" data-action="edit-selected">
            <i class="bi bi-pencil-fill"></i>
            <span>{{ lang.mod_user_group.buttons.edit }}</span>
        </button>

        <button type="button" id="toolbarDelete" class="toolbar-item is-disabled" data-action="delete-selected">
            <i class="bi bi-trash3-fill"></i>
            <span>{{ lang.mod_user_group.buttons.delete }}</span>
        </button>
    </div>

    <a href="{{ site.saddress }}mod_user_group/add" class="main-fab" id="mainFab" aria-label="{{ lang.mod_user_group.add }}">
        <i class="bi bi-plus-lg"></i>
    </a>
{% endblock %}

{% block scripts %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
    <script src="{{ site.address }}templates/admin/assets/js/mod_user_group.js?v=1.0"></script>
{% endblock %}
