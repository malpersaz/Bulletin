{% set hide_navbar = true %}
{% set hide_fab = true %}
{% extends "admin/layout.twig" %}

{% block title %}{{ lang.mod_user_group[17]|default('Lîsteya Koman') }}{% endblock %}
{% block headline %}{{ lang.mod_user_group[17]|default('Lîsteya Koman') }}{% endblock %}

{% block styles %}
    {# Styles moved to global admin/assets/css/style.css #}
{% endblock %}

{% macro render_tree(items, parent_id, level) %}
    {% if items[parent_id] is defined %}
        {% for entry in items[parent_id] %}
            <div class="user-group-node" data-id="{{ entry.group_id }}" data-parent="{{ entry.parent_id }}" data-name="{{ entry.name|lower }}">
                <div class="m3-list-card" onclick="selectUserGroup('{{ entry.group_id }}', this)">
                    <div class="drag-handle" onclick="event.stopPropagation()"><i class="bi bi-grip-vertical"></i></div>

                    {% if items[entry.group_id] is defined %}
                        <button class="toggle-btn" onclick="toggleUserGroup(this, event)">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    {% else %}
                        <div style="width: 24px; margin-right: 4px;"></div>
                    {% endif %}

                    <div class="card-thumb">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <div class="card-info">
                        <div class="card-title">{{ entry.name }}</div>
                        <div class="card-meta">
                            <span class="meta-id">#{{ entry.group_id }}</span>
                            <span class="meta-badge">L{{ level + 1 }}</span>
                        </div>
                    </div>
                </div>

                {% if items[entry.group_id] is defined %}
                    <div class="list-children">
                        {{ _self.render_tree(items, entry.group_id, level + 1) }}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}
{% endmacro %}

{% block content %}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <div class="content-list" id="userGroupRootList">
        
        <!-- Reorder Toggle Bar -->
        <div class="reorder-controller" style="display: flex; justify-content: flex-end; margin-bottom: 12px;">
            <button id="reorderToggleBtn" class="btn-m3-tonal" onclick="toggleReorderMode()" style="border-radius: 12px; padding: 8px 16px; display: flex; align-items: center; gap: 8px; border: none; background: #f3edf7; color: #6750a4; font-weight: 600; cursor: pointer;">
                <i class="bi bi-lock-fill" id="reorderIcon"></i>
                <span id="reorderText">{{ lang.mod_user_group[19]|default('Rêzkirinê veke') }}</span>
            </button>
        </div>

        {% if user_groupm[0] is defined %}
             {{ _self.render_tree(user_groupm, 0, 0) }}
        {% else %}
            <div class="empty-state-container">
                <div class="empty-icon-box">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <h2 style="font-weight: 800;">{{ lang.mod_user_group[17]|default('Kom nehatin dîtin') }}</h2>
                <div class="toolbar-fab" style="margin: 40px auto 0 auto; position: static;" onclick="location.href='{{ site.sadres }}mod_user_group/add'">
                    <i class="bi bi-plus-lg"></i>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar">
        <button id="toolbarEdit" class="toolbar-item" onclick="editSelected()" style="opacity:0.3; pointer-events:none;">
            <i class="bi bi-pencil-fill"></i>
            <span>{{ lang.mod_user_group.buttons.edit|default('Biguhere') }}</span>
        </button>
        
        <div class="toolbar-fab" onclick="location.href='{{ site.sadres }}mod_user_group/add'">
            <i class="bi bi-plus-lg"></i>
        </div>

        <button id="toolbarDelete" class="toolbar-item" onclick="deleteSelected()" style="opacity:0.3; pointer-events:none;">
            <i class="bi bi-trash3-fill"></i>
            <span>{{ lang.mod_user_group.buttons.delete|default('Jê bibe') }}</span>
        </button>
    </div>
{% endblock %}

{% block scripts %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
    {{ include("mod_user_group/script.twig") }}
{% endblock %}
