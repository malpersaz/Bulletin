{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}
{% set hide_navbar = true %}

{% macro select(parent_id, level, selected_id, items) %}
    {% if items[parent_id] is defined %}
        {% for entry in items[parent_id] %}
            <option value="{{ entry.group_id }}" {% if entry.group_id == selected_id %}selected{% endif %}>
                {{ '-'|repeat(level * 2) ~ entry.name }}
            </option>
            {{ _self.select(entry.group_id, level + 1, selected_id, items) }}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% block title %}{{ lang.mod_user_group.admin.1 }}{% endblock %}
{% block headline %}{{ lang.mod_user_group.admin.1 }}{% endblock %}

{% block content %}
<style>
    .user-group-form-shell { padding: 16px; padding-bottom: 120px; display: grid; gap: 16px; }
    .user-group-form-card { background: var(--md-sys-color-surface); border-radius: 20px; padding: 20px; box-shadow: var(--md-sys-elevation-1); display: grid; gap: 16px; }
    .form-status { border-radius: 16px; padding: 14px 16px; font-size: 14px; line-height: 1.5; }
    .form-status.error { background: #fce8e6; color: #b3261e; }
    .form-status.success { background: #e6f4ea; color: #1e4620; }
    .m3-input-wrapper { position: relative; }
    .m3-input-lg { width: 100%; padding: 16px; border-radius: 16px; border: 1px solid var(--md-sys-color-outline); background: transparent; color: var(--md-sys-color-on-surface); box-sizing: border-box; outline: none; }
    .m3-input-lg:focus { border-width: 2px; border-color: var(--md-sys-color-primary); padding: 15px; }
    .m3-floating-label { position: absolute; top: 16px; left: 16px; background: var(--md-sys-color-surface); padding: 0 6px; color: var(--md-sys-color-on-surface-variant); pointer-events: none; transition: all 0.2s ease; }
    .m3-input-lg:focus + .m3-floating-label, .m3-input-lg:not(:placeholder-shown) + .m3-floating-label, select.m3-input-lg + .m3-floating-label { top: -9px; left: 12px; font-size: 12px; color: var(--md-sys-color-primary); }
    .user-group-bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1000; display: flex; gap: 12px; padding: 14px 16px 18px; background: color-mix(in srgb, var(--md-sys-color-surface) 90%, transparent); backdrop-filter: blur(12px); border-top: 1px solid var(--md-sys-color-outline-variant, rgba(0, 0, 0, 0.08)); }
    .user-group-bottom-bar a, .user-group-bottom-bar button { flex: 1; min-height: 52px; border-radius: 999px; border: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; font-weight: 700; cursor: pointer; }
    .user-group-bottom-bar .cancel-btn { background: var(--md-sys-color-surface); color: var(--md-sys-color-on-surface); border: 1px solid var(--md-sys-color-outline) !important; }
    .user-group-bottom-bar .save-btn { background: var(--md-sys-color-primary); color: var(--md-sys-color-on-primary); }
</style>

<div class="user-group-form-shell">
    {% if success is defined %}
        <div class="form-status success">{{ message }}</div>
    {% endif %}
    {% if error is defined %}
        <div class="form-status error">{{ error }}</div>
    {% endif %}
    {% if errors is defined %}
        <div class="form-status error">
            {% for msg in errors %}
                <div>{{ msg }}</div>
            {% endfor %}
        </div>
    {% endif %}

    <form method="POST" action="" id="addUserGroupForm" class="user-group-form-card">
        <div class="m3-input-wrapper">
            <input class="m3-input-lg" name="name" value="{{ name }}" type="text" id="name" placeholder=" ">
            <label class="m3-floating-label">{{ lang.mod_user_group.admin.7 }}</label>
        </div>

        <div class="m3-input-wrapper">
            <select class="m3-input-lg" name="parent_id" id="parent_id">
                <option value="0">{{ lang.mod_user_group[5] }}</option>
                {{ _self.select(0, 0, parent_id, user_groupm) }}
            </select>
            <label class="m3-floating-label">{{ lang.mod_user_group.admin.22 }}</label>
        </div>
    </form>
</div>
{% endblock %}

{% block fixed_bottom %}
{% if success is not defined %}
    <div class="user-group-bottom-bar">
        <a href="{{ site.saddress }}mod_user_group/list" class="cancel-btn">
            <i class="bi bi-arrow-left"></i>
            <span>{{ lang.mod_user_group.buttons.cancel }}</span>
        </a>
        <button type="submit" form="addUserGroupForm" name="add" value="1" class="save-btn">
            <i class="bi bi-check2-circle"></i>
            <span>{{ lang.mod_user_group.buttons.add }}</span>
        </button>
    </div>
{% endif %}
{% endblock %}
