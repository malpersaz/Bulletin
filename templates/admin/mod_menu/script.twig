<script>
    var selectedMenuIds = [];
    var selectedMenuId = null;
    var sortableInstances = [];
    var isReorderActive = false;

    document.addEventListener('DOMContentLoaded', function() {
        
        // --- 1. Init SortableJS (Disabled by Default) ---
        var root = document.getElementById('menuRootList');
        if(root) initSortable(root);

        document.querySelectorAll('.list-children').forEach(function(el) {
            initSortable(el);
        });

        function initSortable(el) {
            var s = new Sortable(el, {
                group: 'menu_nested',
                animation: 300,
                handle: '.drag-handle',
                disabled: true, // LOCKED BY DEFAULT
                fallbackOnBody: true,
                swapThreshold: 0.65,
                ghostClass: 'sortable-ghost',
                onEnd: function (evt) {
                    // ASK USER CONFIRMATION
                    Swal.fire({
                        title: '{{ lang.mod_menu.messages.warning.reorder }}',
                        text: '{{ lang.mod_menu.confirmations.reorder_single }}',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: '{{ lang.mod_menu.options.yes }}',
                        cancelButtonText: '{{ lang.mod_menu.options.no }}',
                        customClass: { popup: 'm3-swal-popup' }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Proceed with update
                            var itemEl = evt.item;
                            var newParentId = 0;
                            var container = evt.to;
                            if (container.classList.contains('list-children')) {
                                var parentNode = container.closest('.menu-node');
                                if(parentNode) newParentId = parentNode.getAttribute('data-id');
                            }

                            var activeIds = [];
                            var siblings = container.querySelectorAll(':scope > .menu-node');
                            siblings.forEach(function(node) {
                                activeIds.push(node.getAttribute('data-id'));
                            });
                            
                            // Auto expand target parent after reload
                            if (newParentId > 0) {
                                var expanded = getExpandedNodeIds();
                                var pStr = newParentId.toString();
                                if (expanded.indexOf(pStr) === -1) {
                                    expanded.push(pStr);
                                    saveExpandedNodeIds(expanded);
                                }
                            }
                            
                            updateMenuOrder(itemEl.getAttribute('data-id'), newParentId, activeIds);
                        } else {
                            // Revert Change if Cancelled
                            // Sortable doesn't have a simple 'revert', we move it back manually logic or reload
                            // Simple revert: reload page or better, move DOM back.
                            // Since reloading is safest to restore tree state:
                            location.reload(); 
                        }
                    });
                }
            });
            sortableInstances.push(s);
        }

        // --- Toggle Logic ---
        window.toggleReorderMode = function() {
            isReorderActive = !isReorderActive;
            var btn = document.getElementById('reorderToggleBtn');
            var icon = document.getElementById('reorderIcon');
            var text = document.getElementById('reorderText');

            if(isReorderActive) {
                document.body.classList.add('reorder-active');
                icon.className = 'bi bi-unlock-fill';
                text.innerText = '{{ lang.mod_menu.actions.lock_reorder }}';
                btn.style.background = '#eaddff'; // Active color
                
                // Enable Sortables
                sortableInstances.forEach(s => s.option('disabled', false));
                
                const Toast = Swal.mixin({
                    toast: true, position: 'top-end', showConfirmButton: false, timer: 1500
                });
                Toast.fire({ icon: 'info', title: '{{ lang.mod_menu.messages.info.reorder_mode }}' });

            } else {
                document.body.classList.remove('reorder-active');
                icon.className = 'bi bi-lock-fill';
                text.innerText = '{{ lang.mod_menu.actions.unlock_reorder }}';
                btn.style.background = '#f3edf7';
                
                // Disable Sortables
                sortableInstances.forEach(s => s.option('disabled', true));
            }
        };

        // --- 2. AJAX Order Update ---
        function updateMenuOrder(id, parent_id, orderList, cardElement) {
            var formData = new URLSearchParams();
            formData.append('id', id);
            formData.append('parent_id', parent_id);
            orderList.forEach(function(sid) { formData.append('order[]', sid); });
            
            fetch('{{ site.address }}mod_menu/tasi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            })
            .then(function(response) { return response.text(); })
            .then(function(data) {
                if (data.trim() === 'Oke') {
                    const Toast = Swal.mixin({
                        toast: true, position: 'top-end', showConfirmButton: false, timer: 1500
                    });
                    Toast.fire({ icon: 'success', title: '{{ lang.mod_menu.messages.success.reordered }}' });
                    setTimeout(function() {
                        location.reload();
                    }, 1000);
                } else {
                    Swal.fire({ icon: 'error', title: '{{ lang.mod_menu.error }}', text: data });
                }
            });
        }

        // --- 3. Search Filter (Global Layout Input) ---
        // mod_category accesses globalSearchInput. We should do the same.
        // Assuming layout provides an input with id="searchInput"
        var searchInput = document.getElementById('searchInput');
        
        if (searchInput) {
            searchInput.addEventListener('input', function(e) {
                filterMenus(e.target.value);
            });
        }

        // Expose function globally in case layout uses it
        window.filterMenus = function(val) {
            var term = val.toLowerCase().trim();
            var nodes = document.querySelectorAll('.menu-node');
            
            if (term.length < 1) {
                nodes.forEach(function(n) { 
                    n.style.display = ''; 
                    // Remove collapsed modifications if any
                    // But we don't want to re-collapse everything, just leave as is
                });
                return;
            }

            nodes.forEach(function(n) { n.style.display = 'none'; });

            nodes.forEach(function(n) {
                var name = n.getAttribute('data-name');
                if (name && name.includes(term)) {
                    showNodeRecursive(n);
                }
            });
        };

        function showNodeRecursive(node) {
            node.style.display = 'block';
            var parent = node.parentElement.closest('.menu-node');
            if (parent) {
                showNodeRecursive(parent);
                var children = parent.querySelector('.list-children');
                if(children) {
                    children.classList.remove('collapsed');
                }
                var btn = parent.querySelector('.toggle-btn');
                if(btn) btn.classList.remove('collapsed');
            }
        }
        restoreExpandedState();
    });

    // --- State Preservation for Tree Expansion ---
    function getExpandedNodeIds() {
        try {
            var stored = localStorage.getItem('mod_menu_expanded_nodes');
            return stored ? JSON.parse(stored) : [];
        } catch (e) {
            return [];
        }
    }

    function saveExpandedNodeIds(ids) {
        try {
            localStorage.setItem('mod_menu_expanded_nodes', JSON.stringify(ids));
        } catch (e) {}
    }

    function updateExpandedState() {
        var expandedIds = [];
        document.querySelectorAll('.menu-node').forEach(function(node) {
            var children = node.querySelector('.list-children');
            if (children && !children.classList.contains('collapsed')) {
                var id = node.getAttribute('data-id');
                if (id) expandedIds.push(id);
            }
        });
        saveExpandedNodeIds(expandedIds);
    }

    function restoreExpandedState() {
        var expandedIds = getExpandedNodeIds();
        if (expandedIds && expandedIds.length > 0) {
            expandedIds.forEach(function(id) {
                var node = document.querySelector('.menu-node[data-id="' + id + '"]');
                if (node) {
                    var children = node.querySelector('.list-children');
                    var btn = node.querySelector('.toggle-btn');
                    if (children) children.classList.remove('collapsed');
                    if (btn) btn.classList.remove('collapsed');
                }
            });
        }
    }

    // --- 4. Interactivity Functions ---

    window.toggleMenu = function(btn, e) {
        if(e) e.stopPropagation();
        var node = btn.closest('.menu-node');
        var children = node.querySelector('.list-children');
        if (children) {
            children.classList.toggle('collapsed');
            btn.classList.toggle('collapsed');
            updateExpandedState();
        }
    };

    window.selectMenu = function(id, card) {
        var index = selectedMenuIds.indexOf(id);
        if (index > -1) {
            selectedMenuIds.splice(index, 1);
            card.classList.remove('selected');
        } else {
            selectedMenuIds.push(id);
            card.classList.add('selected');
            if (window.navigator.vibrate) window.navigator.vibrate(10);
        }
        selectedMenuId = selectedMenuIds.length === 1 ? selectedMenuIds[0] : null;

        updateToolbar(selectedMenuIds.length > 0);
    };

    function updateToolbar(active) {
        var editBtn = document.getElementById('toolbarEdit');
        var delBtn = document.getElementById('toolbarDelete');
        var eyeBtn = document.getElementById('toolbarEye');
        
        if (active) {
            if (selectedMenuIds.length === 1) {
                editBtn.style.pointerEvents = 'auto';
                editBtn.style.opacity = '1';
                editBtn.classList.add('active');
            } else {
                editBtn.style.pointerEvents = 'none';
                editBtn.style.opacity = '0.3';
                editBtn.classList.remove('active');
            }
            
            delBtn.style.pointerEvents = 'auto';
            delBtn.style.opacity = '1';
            delBtn.classList.add('active');

            if (eyeBtn) {
                eyeBtn.style.pointerEvents = 'auto';
                eyeBtn.style.opacity = '1';
                eyeBtn.classList.add('active');
            }
        } else {
            editBtn.style.pointerEvents = 'none';
            editBtn.style.opacity = '0.3';
            editBtn.classList.remove('active');
            
            delBtn.style.pointerEvents = 'none';
            delBtn.style.opacity = '0.3';
            delBtn.classList.remove('active');

            if (eyeBtn) {
                eyeBtn.style.pointerEvents = 'none';
                eyeBtn.style.opacity = '0.3';
                eyeBtn.classList.remove('active');
            }
        }
    }

    window.editSelected = function() {
        if (selectedMenuIds.length === 1) {
            window.location.href = '{{ site.saddress }}mod_menu/edit/' + selectedMenuIds[0];
        }
    };

    window.toggleStatusSelected = function() {
        if (selectedMenuIds.length === 0) return;

        var statuses = [];
        selectedMenuIds.forEach(function(id) {
            var node = document.querySelector('.menu-node[data-id="' + id + '"]');
            if (node) {
                statuses.push(node.getAttribute('data-status'));
            }
        });

        var allActive = statuses.length > 0 && statuses.every(function(s) { return s === 'y'; });
        var isPublishing = !allActive;
        var endpoint = isPublishing ? 'approve' : 'unapprove';

        var confirmMsg = isPublishing
            ? '{{ lang.mod_menu.confirmations.publish }}'
            : '{{ lang.mod_menu.confirmations.unpublish }}';

        var successMsg = isPublishing
            ? '{{ lang.mod_menu.messages.success.published }}'
            : '{{ lang.mod_menu.messages.success.unpublished }}';

        Swal.fire({
            title: confirmMsg,
            icon: isPublishing ? 'question' : 'info',
            iconColor: isPublishing ? '#2E7D32' : '#E65100',
            showCancelButton: true,
            confirmButtonColor: isPublishing ? '#2E7D32' : '#E65100',
            cancelButtonColor: '#6750A4',
            confirmButtonText: isPublishing
                ? '<i class="bi bi-eye"></i> {{ lang.mod_menu.options.yes }}'
                : '<i class="bi bi-eye-slash"></i> {{ lang.mod_menu.options.yes }}',
            cancelButtonText: '<i class="bi bi-x-lg"></i> {{ lang.mod_menu.options.no }}',
            background: 'rgba(255,255,255,0.95)',
            backdrop: `rgba(0,0,10,0.5)`
        }).then((result) => {
            if (result.isConfirmed) {
                var formData = new URLSearchParams();
                selectedMenuIds.forEach(function(id) {
                    formData.append('query[]', id);
                });

                fetch('{{ site.address }}mod_menu/' + endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                })
                .then(response => response.text())
                .then(msg => {
                    if (msg.trim() === 'Success') {
                        Swal.fire(
                            '{{ lang.mod_menu.oke }}',
                            successMsg,
                            'success'
                        ).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('{{ lang.mod_menu.error }}', msg, 'error');
                    }
                })
                .catch(err => {
                    console.error('Status toggle error:', err);
                    Swal.fire('{{ lang.mod_menu.error }}', '{{ lang.mod_menu.errors.general }}', 'error');
                });
            }
        });
    };

    window.deleteSelected = function() {
        if (selectedMenuIds.length === 0) return;

        var isMultiple = selectedMenuIds.length > 1;
        var title = isMultiple
            ? '{{ lang.mod_menu.confirmations.delete_multiple }}'.replace(':count', selectedMenuIds.length)
            : '{{ lang.mod_menu.messages.warning.delete }}';
        var text = isMultiple
            ? '{{ lang.mod_menu.confirmations.delete_multiple }}'.replace(':count', selectedMenuIds.length)
            : '{{ lang.mod_menu.confirmations.delete_single }}';

        Swal.fire({
            title: title,
            text: text,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: '{{ lang.mod_menu.options.yes }}',
            cancelButtonText: '{{ lang.mod_menu.options.no }}',
            background: 'rgba(255,255,255,0.95)',
            backdrop: `rgba(0,0,10,0.5)`
        }).then((result) => {
            if (result.isConfirmed) {
                var formData = new URLSearchParams();
                selectedMenuIds.forEach(function(id) {
                    formData.append('delete[]', id);
                });

                fetch('{{ site.address }}mod_menu/dragdrop_delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                })
                .then(r => r.text())
                .then(data => {
                    if (data.trim() === 'Oke') {
                         Swal.fire(
                            '{{ lang.mod_menu.oke }}',
                            '{{ lang.mod_menu.messages.success.delete }}',
                            'success'
                        ).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('{{ lang.mod_menu.error }}', data, 'error');
                    }
                });
            }
        });
    };
</script>
