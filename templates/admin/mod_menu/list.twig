{% set hide_navbar = true %}
{% set hide_fab = true %}
{% extends "admin/layout.twig" %}

{% block title %}{{ lang.mod_menu.list }}{% endblock %}
{% block headline %}{{ lang.mod_menu.list }}{% endblock %}

{% block styles %}
    <style>
        .list-children-empty {
            min-height: 48px;
            border: 2px dashed rgba(103, 80, 164, 0.4);
            border-radius: 12px;
            margin-top: 8px;
            margin-left: 24px;
            display: none;
        }
        body.reorder-active .list-children-empty {
            display: block;
        }
        /* Two-line layout for menu items to prevent truncation of titles on mobile */
        .m3-list-card .card-info {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }
        .m3-list-card .card-title {
            white-space: normal;
            word-break: break-word;
            width: 100%;
        }
        .list-children {
            padding-left: 20px; /* Reduced from 32px to save horizontal space */
        }
        .list-children::before {
            left: 11px; /* Align hierarchy dotted line with the new padding */
        }
    </style>
{% endblock %}

{% macro render_tree(items, parent_id, level) %}
    {% for entry in items[parent_id] %}
        {% set is_container = entry.url is defined and entry.url == '##' %}
        {% set display_name = entry.display_name %}
        <div class="menu-node" data-id="{{ entry.id }}" data-parent="{{ parent_id }}" data-name="{{ display_name|lower }}" data-status="{{ entry.status }}">
            <div class="m3-list-card" onclick="selectMenu('{{ entry.id }}', this)">
                <div class="drag-handle"><i class="bi bi-grip-vertical"></i></div>
                
                {% if items[entry.id] is defined or is_container %}
                    <button class="toggle-btn collapsed" onclick="toggleMenu(this, event)">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                {% else %}
                    <div style="width:24px; margin-right:4px;"></div> <!-- Spacer -->
                {% endif %}

                <div class="card-thumb">
                    {% if entry.icon %}
                        <i class="{{ entry.icon }}"></i>
                    {% else %}
                        <i class="bi bi-link-45deg"></i>
                    {% endif %}
                </div>

                <div class="card-info">
                    <div class="card-title">{{ display_name }}</div>
                    <div class="card-meta">
                        <span class="meta-badge">{{ entry.lang|upper }}</span>
                        <span class="meta-id">#{{ entry.id }}</span>
                        {% if entry.status == 'y' %}
                            <span class="meta-status" style="margin-left: 8px; color: #2e7d32;"><i class="bi bi-eye-fill"></i></span>
                        {% else %}
                            <span class="meta-status" style="margin-left: 8px; color: #b3261e; opacity: 0.7;"><i class="bi bi-eye-slash-fill"></i></span>
                        {% endif %}
                    </div>
                </div>
            </div>
            
            {% if entry.id != parent_id and level < 20 %}
                <div class="list-children collapsed{% if items[entry.id] is not defined %} list-children-empty{% endif %}">
                    {% if items[entry.id] is defined %}
                        {{ _self.render_tree(items, entry.id, level + 1) }}
                    {% endif %}
                </div>
            {% endif %}
        </div>
    {% endfor %}
{% endmacro %}

{% block content %}
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="content-list" id="menuRootList">
    
    <!-- Reorder Toggle Bar -->
    <div class="reorder-controller" style="display: flex; justify-content: flex-end; margin-bottom: 12px;">
        <button id="reorderToggleBtn" class="btn-m3-tonal" onclick="toggleReorderMode()" style="border-radius: 12px; padding: 8px 16px; display: flex; align-items: center; gap: 8px; border: none; background: #f3edf7; color: #6750a4; font-weight: 600; cursor: pointer;">
            <i class="bi bi-lock-fill" id="reorderIcon"></i>
            <span id="reorderText">{{ lang.mod_menu.actions.unlock_reorder }}</span>
        </button>
    </div>

    {% if select_nested_mod_menu_result[0] is defined %}
        {{ _self.render_tree(select_nested_mod_menu_result, 0, 0) }}
    {% else %}
        <div class="empty-state-container">
            <div class="empty-icon-box">
                 <i class="bi bi-diagram-3"></i>
            </div>
            <h2 style="font-weight: 800;">{{ lang.mod_menu.empty.no_menus }}</h2>
            <div class="toolbar-fab" style="margin: 40px auto 0 auto; position: static;" onclick="location.href='{{ site.saddress }}mod_menu/add'">
                <i class="bi bi-plus-lg"></i>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block fixed_bottom %}
    <div class="standard-toolbar menu-toolbar">
        <button id="toolbarEdit" class="toolbar-item" onclick="editSelected()" style="opacity:0.3; pointer-events:none;">
            <i class="bi bi-pencil-fill"></i>
            <span>{{ lang.mod_menu.actions.edit }}</span>
        </button>

        <button id="toolbarEye" class="toolbar-item" onclick="toggleStatusSelected()" style="opacity:0.3; pointer-events:none;">
            <i class="bi bi-eye-fill"></i>
            <span>{{ lang.mod_menu.actions.publish_toggle }}</span>
        </button>

        <button id="toolbarDelete" class="toolbar-item" onclick="deleteSelected()" style="opacity:0.3; pointer-events:none;">
            <i class="bi bi-trash3-fill"></i>
            <span>{{ lang.mod_menu.actions.delete }}</span>
        </button>
    </div>

    <!-- Main FAB Button -->
    <button class="main-fab" id="mainFab" onclick="location.href='{{ site.saddress }}mod_menu/add'" aria-label="{{ lang.mod_menu.add|default('Menuyê Lêzêde Bike') }}">
        <i class="bi bi-plus-lg"></i>
    </button>
{% endblock %}

{% block scripts %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
    {% include 'mod_menu/script.twig' %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var wrapper = document.querySelector('.mobile-wrapper');
            if(wrapper) {
                wrapper.classList.add('mesh-bg');
            }
        });
    </script>
{% endblock %}
