{% block scripts %}
{{ parent() }}
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var langSelect = document.getElementById('lang');

        function reloadForMenuContext() {
            if (!langSelect) {
                return;
            }

            var url = new URL(window.location.href);
            url.searchParams.set('lang', langSelect.value);
            window.location.href = url.toString();
        }

        if (langSelect) {
            langSelect.addEventListener('change', reloadForMenuContext);
        }

        function initM3Select(selector, config) {
            var element = document.querySelector(selector);
            if (!element) {
                return null;
            }

            return new TomSelect(selector, Object.assign({
                create: false,
                maxOptions: 200,
                dropdownClass: 'm3-select-dropdown',
                render: {
                    item: function(data, escape) {
                        return '<div class="m3-ts-selected-value" title="' + escape(data.text || '') + '">' + escape(data.text || '') + '</div>';
                    },
                    option: function(data, escape) {
                        return '<div class="m3-ts-option-value">' + escape(data.text || '') + '</div>';
                    }
                }
            }, config || {}));
        }

        initM3Select('#lang', {
            searchField: ['text'],
            sortField: [{ field: '$order' }]
        });
        initM3Select('#parent_id', {
            searchField: ['text']
        });
        initM3Select('#acl_id', {
            searchField: ['text']
        });

        // Icon Preview functionality
        const iconInput = document.getElementById('icon');
        const iconPreview = document.getElementById('iconPreview');
        
        if (iconInput && iconPreview) {
            iconInput.addEventListener('input', function() {
                const iconClass = this.value.trim();
                
                // Add pop animation effect
                iconPreview.style.transform = 'scale(0.8)';
                
                setTimeout(() => {
                    if (iconClass) {
                        iconPreview.innerHTML = `<i class="${iconClass}"></i>`;
                        iconPreview.style.color = 'var(--md-sys-color-primary)';
                        iconPreview.style.background = 'var(--md-sys-color-primary-container)';
                    } else {
                        iconPreview.innerHTML = '<i class="bi bi-question"></i>';
                        iconPreview.style.color = 'var(--md-sys-color-on-surface-variant)';
                        iconPreview.style.background = 'var(--md-sys-color-surface-variant)';
                    }
                    iconPreview.style.transform = 'scale(1.1)';
                    
                    setTimeout(() => {
                        iconPreview.style.transform = 'scale(1)';
                    }, 150);
                }, 150);
            });
        }

        // Clear custom validity on input
        document.querySelectorAll('[required]').forEach(input => {
            input.addEventListener('input', () => input.setCustomValidity(''));
            input.addEventListener('change', () => input.setCustomValidity(''));
        });
    });

    function selectTargetStatus(el, val) {
        document.querySelectorAll('#targetHidden ~ .selection-grid .selection-card').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        document.getElementById('targetHidden').value = val;
    }

    function updateStatusSelection(el, val) {
        document.querySelectorAll('#statusHidden ~ .selection-grid .selection-card').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        document.getElementById('statusHidden').value = val;
    }

    function submitAddForm(formId) {
        const form = document.getElementById(formId);
        if (!form) return;

        // Clear current validation state.
        const inputs = form.querySelectorAll('[required]');
        inputs.forEach(input => input.setCustomValidity(''));

        if (!form.checkValidity()) {
            inputs.forEach(input => {
                if (!input.validity.valid) {
                    let msg = "";
                    if (input.id === 'parent_id') {
                        msg = "{{ lang.mod_menu.errors.parent_selection_required|e('js') }}";
                    } else if (input.id === 'name') {
                        msg = "{{ lang.mod_menu.validation.required|replace({':field': lang.mod_menu.admin.columns.name})|e('js') }}";
                    } else if (input.id === 'lang') {
                        msg = "{{ lang.mod_menu.validation.required|replace({':field': lang.mod_menu.admin.columns.language})|e('js') }}";
                    } else {
                        msg = "{{ lang.mod_menu.errors.general|e('js') }}";
                    }
                    input.setCustomValidity(msg);
                }
            });
            form.reportValidity();
            return;
        }

        // Add hidden field for 'add' button since we changed from type="submit"
        if (!form.querySelector('input[name="add"]')) {
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'add';
            hidden.value = '1';
            form.appendChild(hidden);
        }
        form.submit();
    }
</script>
{% endblock %}
