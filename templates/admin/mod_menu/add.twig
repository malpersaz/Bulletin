{% set hide_navbar = true %}
{% set hide_search = true %}
{% set hide_fab = true %}
{% set show_wizards = true %}
{% extends 'admin/layout.twig' %}

{% block title %}
    {{ lang.mod_menu.wizard.title }}
{% endblock %}

{% block headline %}
    {{ lang.mod_menu.wizard.title }}
{% endblock %}

{% block styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/mod_menu_wizard.css?v=4.0">
{% endblock %}

{% macro select_nested_parent_id_function(select_nested_parent_id_result, parent_id, selected_id, self_id, level = 0, disable = false) %}
    {% if select_nested_parent_id_result[parent_id] is defined %}
        {% for entry in select_nested_parent_id_result[parent_id] %}
            {% set parent_id_loop = entry.id %}
            {% set display_name = entry.display_name %}
            <option value="{{ entry.id }}" {% if selected_id == entry.id %} selected="selected" {% endif %} {% if entry.id == self_id or disable %} disabled="disabled" {% endif %}>
                {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ display_name }} ({% if entry.lang is defined %}{{ entry.lang|upper }}{% endif %})
            </option>
            {% if select_nested_parent_id_result[parent_id_loop] is defined and select_nested_parent_id_result[parent_id_loop] is iterable and parent_id_loop != parent_id and level < 20 %}
                {% set next_disable = disable or (entry.id == self_id) %}
                {{ _self.select_nested_parent_id_function(select_nested_parent_id_result, parent_id_loop, selected_id, self_id, level + 1, next_disable) }}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% block content %}
    <div class="menu-wizard-loader">
        <div class="menu-wizard-spinner"></div>
        <p>{{ lang.mod_menu.loading.loading }}</p>
    </div>
{% endblock %}

{% block wizards %}
    {% set active_lang_code = (selected_lang is defined and selected_lang != '' ? selected_lang : site.lang)|lower %}
    {% set selected_parent_id = menu_selected_parent_id is defined ? menu_selected_parent_id : (parent_id is defined and parent_id != '' ? parent_id : menu_parent_default_id) %}
    {% set target_val = target is defined and target != '' ? target : 'n' %}
    {% set status_val = status is defined and status != '' ? status : 'y' %}

    <form id="menuWizardForm" method="POST" action="">
        <input type="hidden" name="add" value="1">
        <input type="hidden" name="lang" id="menuWizardLangInput" value="{{ active_lang_code }}">
        <input type="hidden" name="target" id="menuWizardTargetHidden" value="{{ target_val }}">
        <input type="hidden" name="status" id="menuWizardStatusHidden" value="{{ status_val }}">

        <div id="menuWizardOverlay"
            class="menu-wizard-overlay active"
            data-has-errors="{{ (errors is defined and errors is not empty) ? 'true' : 'false' }}"
            data-error-messages="{{ (errors is defined ? errors : [])|json_encode|e('html_attr') }}"
            data-text-ok="{{ lang.mod_menu.options.ok }}"
            data-step-title-1="{{ lang.mod_menu.wizard.steps.step_1 }}"
            data-step-title-2="{{ lang.mod_menu.wizard.steps.step_2 }}"
            data-step-title-3="{{ lang.mod_menu.wizard.steps.step_3 }}"
            data-step-title-4="{{ lang.mod_menu.wizard.steps.step_4 }}"
            data-step-title-5="{{ lang.mod_menu.wizard.steps.step_5 }}"
            data-step-title-6="{{ lang.mod_menu.wizard.steps.step_6 }}"
            data-step-title-7="{{ lang.mod_menu.wizard.steps.step_7 }}"
            data-step-title-8="{{ lang.mod_menu.wizard.steps.step_8 }}"
            data-step-title-9="{{ lang.mod_menu.wizard.steps.step_9 }}"
            data-step-title-10="{{ lang.mod_menu.wizard.steps.step_10 }}"
            data-text-same-window="{{ lang.mod_menu.wizard.summary.same_window }}"
            data-text-new-window="{{ lang.mod_menu.wizard.summary.new_window }}"
            data-text-published="{{ lang.mod_menu.wizard.summary.published }}"
            data-text-draft="{{ lang.mod_menu.wizard.summary.draft }}">

            <!-- Header -->
            <header class="menu-wizard-header">
                <button type="button"
                    id="menuWizardCloseBtn"
                    class="menu-wizard-close-btn"
                    data-redirect-url="{{ site.saddress }}mod_menu/list"
                    aria-label="{{ lang.mod_menu.actions.cancel }}">
                    <i class="bi bi-x-lg"></i>
                </button>
                <div class="menu-wizard-header-title">
                    <span id="menuWizardStepName" class="menu-wizard-step-name">{{ lang.mod_menu.wizard.steps.step_1 }}</span>
                    <span id="menuWizardStepIndicator" class="menu-wizard-step-indicator">1 / 10</span>
                </div>
                <div class="menu-wizard-header-spacer"></div>
            </header>

            <!-- Progress Bar -->
            <div class="menu-wizard-progress-bar">
                <div id="menuWizardProgressFill" class="menu-wizard-progress-fill"></div>
            </div>

            <!-- Content -->
            <div class="menu-wizard-content">

                <!-- Step 1: Language -->
                <div class="menu-wizard-step active" id="menuWizardStep1">
                    <div class="menu-step-badge-wrap">
                        <div class="menu-step-avatar"><i class="bi bi-translate"></i></div>
                        <div class="menu-step-meta">
                            <span class="menu-step-tag">{{ lang.mod_menu.wizard.labels.step_prefix }} 1 / 10</span>
                            <h2 class="menu-step-headline">{{ lang.mod_menu.wizard.steps.step_1 }}</h2>
                        </div>
                    </div>
                    <p class="menu-step-subhead">{{ lang.mod_menu.wizard.subtitles.step_1 }}</p>

                    <div class="menu-selection-grid">
                        {% for item in lang_lang %}
                            {% set is_active = (active_lang_code == item.seo|lower) %}
                            <div class="menu-selection-card{% if is_active %} active{% endif %}" data-lang-code="{{ item.seo|lower }}">
                                <span class="menu-card-badge">{{ item.seo|upper }}</span>
                                <span class="menu-card-label">{{ item.name }}</span>
                                <i class="bi bi-check-circle-fill menu-check-badge"></i>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Step 2: Menu Name -->
                <div class="menu-wizard-step" id="menuWizardStep2">
                    <div class="menu-step-badge-wrap">
                        <div class="menu-step-avatar"><i class="bi bi-cursor-text"></i></div>
                        <div class="menu-step-meta">
                            <span class="menu-step-tag">{{ lang.mod_menu.wizard.labels.step_prefix }} 2 / 10</span>
                            <h2 class="menu-step-headline">{{ lang.mod_menu.wizard.steps.step_2 }}</h2>
                        </div>
                    </div>
                    <p class="menu-step-subhead">{{ lang.mod_menu.wizard.subtitles.step_2 }}</p>

                    <div class="menu-field-group">
                        <label class="menu-field-label" for="menuWizardNameInput">{{ lang.mod_menu.admin.columns.name }} *</label>
                        <div class="menu-input-with-icon">
                            <i class="bi bi-card-heading menu-input-leading-icon"></i>
                            <input type="text"
                                class="menu-input-lg"
                                name="name"
                                id="menuWizardNameInput"
                                placeholder="{{ lang.mod_menu.placeholders.menu_name }}"
                                autocomplete="off"
                                maxlength="255"
                                value="{{ name|default('') }}"
                                required>
                        </div>
                        <div class="menu-char-counter" id="menuCharCounter">0 / 255</div>
                        <div class="menu-validation-text" id="menuNameValidation">
                            {{ lang.mod_menu.wizard.validation.name_required }}
                        </div>
                    </div>

                    <!-- Live Navigation Bar Preview Pill -->
                    <div class="menu-live-nav-preview" id="menuLiveNavPreview">
                        <span class="menu-live-nav-preview-label">{{ lang.mod_menu.wizard.labels.live_preview }}</span>
                        <div class="menu-live-nav-pill">
                            <i class="bi bi-list" id="menuLiveNavIcon"></i>
                            <span id="menuLiveNavText">{{ name|default(lang.mod_menu.placeholders.menu_name) }}</span>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Parent Menu -->
                <div class="menu-wizard-step" id="menuWizardStep3">
                    <div class="menu-step-badge-wrap">
                        <div class="menu-step-avatar"><i class="bi bi-diagram-3-fill"></i></div>
                        <div class="menu-step-meta">
                            <span class="menu-step-tag">{{ lang.mod_menu.wizard.labels.step_prefix }} 3 / 10</span>
                            <h2 class="menu-step-headline">{{ lang.mod_menu.wizard.steps.step_3 }}</h2>
                        </div>
                    </div>
                    <p class="menu-step-subhead">{{ lang.mod_menu.wizard.subtitles.step_3 }}</p>

                    <div class="menu-field-group">
                        <label class="menu-field-label" for="menuWizardParentSelect">{{ lang.mod_menu.admin.columns.parent_id }} *</label>
                        <div class="menu-select-wrapper">
                            <i class="bi bi-diagram-3 menu-select-icon"></i>
                            <select class="menu-select-lg" name="parent_id" id="menuWizardParentSelect" required>
                                <option value="" {% if selected_parent_id == '' %}selected{% endif %} disabled>{{ lang.mod_menu.parent_labels.select_parent }}</option>
                                {% if menu_show_language_root_option %}
                                    <option value="{{ menu_parent_root_id }}" {% if selected_parent_id == menu_parent_root_id %}selected{% endif %}>{{ menu_language_root_label }}</option>
                                {% endif %}
                                {{ _self.select_nested_parent_id_function(select_nested_parent_id_result, menu_parent_root_id, selected_parent_id, 0) }}
                            </select>
                            <i class="bi bi-chevron-down menu-select-chevron"></i>
                        </div>
                        <div class="menu-field-hint">
                            <i class="bi bi-info-circle"></i> {{ lang.mod_menu.help.parent_menu }}
                        </div>
                        <div class="menu-validation-text" id="menuParentValidation">
                            {{ lang.mod_menu.wizard.validation.parent_required }}
                        </div>
                    </div>

                    <!-- Live Hierarchy Placement Preview Card -->
                    <div class="menu-hierarchy-preview-card" id="menuHierarchyPreviewCard">
                        <div class="menu-preview-card-header">
                            <div class="menu-preview-card-header-left">
                                <i class="bi bi-diagram-2-fill"></i>
                                <span>{{ lang.mod_menu.wizard.labels.placement_preview }}</span>
                            </div>
                            <i class="bi bi-check-circle text-success"></i>
                        </div>
                        <div class="menu-hierarchy-tree">
                            <div class="menu-tree-node parent-node">
                                <i class="bi bi-folder2-open"></i>
                                <span id="menuHierarchyParentName">-</span>
                            </div>
                            <div class="menu-tree-branch">
                                <div class="menu-tree-node child-node">
                                    <i class="bi bi-arrow-return-right"></i>
                                    <span id="menuHierarchyChildName">{{ name|default(lang.mod_menu.wizard.steps.step_2) }}</span>
                                    <span class="menu-badge-new">{{ lang.mod_menu.wizard.labels.will_be_added_here }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 4: Link (URL) -->
                <div class="menu-wizard-step" id="menuWizardStep4">
                    <div class="menu-step-badge-wrap">
                        <div class="menu-step-avatar"><i class="bi bi-link-45deg"></i></div>
                        <div class="menu-step-meta">
                            <span class="menu-step-tag">{{ lang.mod_menu.wizard.labels.step_prefix }} 4 / 10</span>
                            <h2 class="menu-step-headline">{{ lang.mod_menu.wizard.steps.step_4 }}</h2>
                        </div>
                    </div>
                    <p class="menu-step-subhead">{{ lang.mod_menu.wizard.subtitles.step_4 }}</p>

                    <div class="menu-field-group">
                        <label class="menu-field-label" for="menuWizardUrlInput">{{ lang.mod_menu.admin.columns.url }}</label>
                        <div class="menu-input-with-icon">
                            <i class="bi bi-link-45deg menu-input-leading-icon"></i>
                            <input type="text"
                                class="menu-input-lg"
                                name="url"
                                id="menuWizardUrlInput"
                                placeholder="{{ lang.mod_menu.placeholders.menu_url }}"
                                value="{{ url|default('') }}">
                        </div>
                        <div class="menu-field-hint">
                            <i class="bi bi-info-circle"></i> {{ lang.mod_menu.help.url }}
                        </div>

                        <!-- Quick Link Presets -->
                        <div class="menu-preset-chips-wrap">
                            <div class="menu-preset-chips-title">{{ lang.mod_menu.wizard.labels.quick_links }}</div>
                            <div class="menu-preset-chips-list">
                                <button type="button" class="menu-preset-chip" data-url="/">
                                    <i class="bi bi-house"></i>
                                    <span>{{ lang.mod_menu.wizard.labels.preset_home }}</span>
                                </button>
                                <button type="button" class="menu-preset-chip" data-url="https://">
                                    <i class="bi bi-globe"></i>
                                    <span>{{ lang.mod_menu.wizard.labels.preset_external }}</span>
                                </button>
                                <button type="button" class="menu-preset-chip" data-url="#">
                                    <i class="bi bi-hash"></i>
                                    <span>{{ lang.mod_menu.wizard.labels.preset_header_only }}</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 5: Icon -->
                <div class="menu-wizard-step" id="menuWizardStep5">
                    <div class="menu-step-badge-wrap">
                        <div class="menu-step-avatar"><i class="bi bi-stars"></i></div>
                        <div class="menu-step-meta">
                            <span class="menu-step-tag">{{ lang.mod_menu.wizard.labels.step_prefix }} 5 / 10</span>
                            <h2 class="menu-step-headline">{{ lang.mod_menu.wizard.steps.step_5 }}</h2>
                        </div>
                    </div>
                    <p class="menu-step-subhead">{{ lang.mod_menu.wizard.subtitles.step_5 }}</p>

                    <div class="menu-field-group">
                        <label class="menu-field-label" for="menuWizardIconInput">{{ lang.mod_menu.admin.columns.icon }}</label>
                        <div class="menu-icon-input-wrap">
                            <input type="text"
                                class="menu-input-lg"
                                name="icon"
                                id="menuWizardIconInput"
                                placeholder="{{ lang.mod_menu.placeholders.icon_class }}"
                                value="{{ icon|default('') }}">
                            <div class="menu-icon-preview-box" id="menuWizardIconPreview">
                                <i class="bi bi-question"></i>
                            </div>
                        </div>
                        <div class="menu-field-hint">
                            <i class="bi bi-stars"></i> {{ lang.mod_menu.help.icon }}
                        </div>

                        <!-- Quick Icon Chips -->
                        <div class="menu-icon-chips-wrap">
                            <div class="menu-chips-title">{{ lang.mod_menu.wizard.labels.popular_icons }}</div>
                            <div class="menu-chips-scroll">
                                <button type="button" class="menu-icon-chip" data-icon="bi bi-house">
                                    <i class="bi bi-house"></i> bi-house
                                </button>
                                <button type="button" class="menu-icon-chip" data-icon="bi bi-grid">
                                    <i class="bi bi-grid"></i> bi-grid
                                </button>
                                <button type="button" class="menu-icon-chip" data-icon="bi bi-info-circle">
                                    <i class="bi bi-info-circle"></i> bi-info-circle
                                </button>
                                <button type="button" class="menu-icon-chip" data-icon="bi bi-envelope">
                                    <i class="bi bi-envelope"></i> bi-envelope
                                </button>
                                <button type="button" class="menu-icon-chip" data-icon="bi bi-newspaper">
                                    <i class="bi bi-newspaper"></i> bi-newspaper
                                </button>
                                <button type="button" class="menu-icon-chip" data-icon="bi bi-folder">
                                    <i class="bi bi-folder"></i> bi-folder
                                </button>
                                <button type="button" class="menu-icon-chip" data-icon="bi bi-image">
                                    <i class="bi bi-image"></i> bi-image
                                </button>
                                <button type="button" class="menu-icon-chip" data-icon="bi bi-bag">
                                    <i class="bi bi-bag"></i> bi-bag
                                </button>
                                <button type="button" class="menu-icon-chip" data-icon="bi bi-telephone">
                                    <i class="bi bi-telephone"></i> bi-telephone
                                </button>
                                <button type="button" class="menu-icon-chip" data-icon="bi bi-gear">
                                    <i class="bi bi-gear"></i> bi-gear
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 6: Menu File (Optional) -->
                <div class="menu-wizard-step" id="menuWizardStep6">
                    <div class="menu-step-badge-wrap">
                        <div class="menu-step-avatar"><i class="bi bi-file-earmark-code"></i></div>
                        <div class="menu-step-meta">
                            <span class="menu-step-tag">{{ lang.mod_menu.wizard.labels.step_prefix }} 6 / 10</span>
                            <h2 class="menu-step-headline">{{ lang.mod_menu.wizard.steps.step_6 }}</h2>
                        </div>
                    </div>
                    <p class="menu-step-subhead">{{ lang.mod_menu.wizard.subtitles.step_6 }}</p>

                    <div class="menu-field-group">
                        <label class="menu-field-label" for="menuWizardFileInput">{{ lang.mod_menu.admin.columns.file }}</label>
                        <div class="menu-input-with-icon">
                            <i class="bi bi-file-earmark-code menu-input-leading-icon"></i>
                            <input type="text"
                                class="menu-input-lg"
                                name="file"
                                id="menuWizardFileInput"
                                placeholder="{{ lang.mod_menu.placeholders.menu_file }}"
                                value="{{ file|default('') }}">
                        </div>
                        <div class="menu-field-hint">
                            <i class="bi bi-info-circle"></i> {{ lang.mod_menu.help.file }}
                        </div>
                    </div>
                </div>

                <!-- Step 7: Custom HTML (Optional) -->
                <div class="menu-wizard-step" id="menuWizardStep7">
                    <div class="menu-step-badge-wrap">
                        <div class="menu-step-avatar"><i class="bi bi-code-slash"></i></div>
                        <div class="menu-step-meta">
                            <span class="menu-step-tag">{{ lang.mod_menu.wizard.labels.step_prefix }} 7 / 10</span>
                            <h2 class="menu-step-headline">{{ lang.mod_menu.wizard.steps.step_7 }}</h2>
                        </div>
                    </div>
                    <p class="menu-step-subhead">{{ lang.mod_menu.wizard.subtitles.step_7 }}</p>

                    <div class="menu-field-group">
                        <label class="menu-field-label" for="menuWizardHtmlInput">{{ lang.mod_menu.admin.columns.html }}</label>
                        <div class="menu-input-wrapper">
                            <textarea class="menu-input-lg"
                                name="html"
                                id="menuWizardHtmlInput"
                                rows="3"
                                placeholder="{{ lang.mod_menu.placeholders.menu_html }}">{{ html|default('') }}</textarea>
                        </div>
                        <div class="menu-field-hint">
                            <i class="bi bi-code-slash"></i> {{ lang.mod_menu.help.html }}
                        </div>
                    </div>
                </div>

                <!-- Step 8: Target Window -->
                <div class="menu-wizard-step" id="menuWizardStep8">
                    <div class="menu-step-badge-wrap">
                        <div class="menu-step-avatar"><i class="bi bi-box-arrow-up-right"></i></div>
                        <div class="menu-step-meta">
                            <span class="menu-step-tag">{{ lang.mod_menu.wizard.labels.step_prefix }} 8 / 10</span>
                            <h2 class="menu-step-headline">{{ lang.mod_menu.wizard.steps.step_8 }}</h2>
                        </div>
                    </div>
                    <p class="menu-step-subhead">{{ lang.mod_menu.wizard.subtitles.step_8 }}</p>

                    <div class="menu-field-group">
                        <label class="menu-field-label">{{ lang.mod_menu.admin.columns.target }}</label>
                        <div class="menu-selection-grid">
                            <div class="menu-selection-card{% if target_val != 'y' %} active{% endif %}" data-target-value="n">
                                <i class="bi bi-box-arrow-in-right menu-card-icon"></i>
                                <span class="menu-card-label">{{ lang.mod_menu.admin.select_value.target_h }}</span>
                                <span class="menu-card-desc">{{ lang.mod_menu.wizard.labels.target_same_desc }}</span>
                                <i class="bi bi-check-circle-fill menu-check-badge"></i>
                            </div>
                            <div class="menu-selection-card{% if target_val == 'y' %} active{% endif %}" data-target-value="y">
                                <i class="bi bi-box-arrow-up-right menu-card-icon"></i>
                                <span class="menu-card-label">{{ lang.mod_menu.admin.select_value.target_e }}</span>
                                <span class="menu-card-desc">{{ lang.mod_menu.wizard.labels.target_blank_desc }}</span>
                                <i class="bi bi-check-circle-fill menu-check-badge"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 9: Access Level (ACL) -->
                <div class="menu-wizard-step" id="menuWizardStep9">
                    <div class="menu-step-badge-wrap">
                        <div class="menu-step-avatar"><i class="bi bi-shield-check"></i></div>
                        <div class="menu-step-meta">
                            <span class="menu-step-tag">{{ lang.mod_menu.wizard.labels.step_prefix }} 9 / 10</span>
                            <h2 class="menu-step-headline">{{ lang.mod_menu.wizard.steps.step_9 }}</h2>
                        </div>
                    </div>
                    <p class="menu-step-subhead">{{ lang.mod_menu.wizard.subtitles.step_9 }}</p>

                    <div class="menu-field-group">
                        <label class="menu-field-label">{{ lang.mod_menu.admin.columns.acl_id|striptags }}</label>

                        <!-- Tactile ACL Role Selection Cards -->
                        <div class="menu-acl-cards-grid" id="menuWizardAclCards">
                            <div class="menu-acl-card{% if acl_id is not defined or acl_id == 0 or acl_id == '' %} active{% endif %}" data-acl-value="0">
                                <div class="menu-acl-card-icon-box">
                                    <i class="bi bi-globe2"></i>
                                </div>
                                <div class="menu-acl-card-content">
                                    <span class="menu-acl-card-title">{{ lang.mod_menu.choose_wish }}</span>
                                    <span class="menu-acl-card-subtitle">{{ lang.mod_menu.help.access_control }}</span>
                                </div>
                                <i class="bi bi-check-circle-fill menu-acl-card-check"></i>
                            </div>
                            {% for item in mod_acl_acl_id %}
                                <div class="menu-acl-card{% if acl_id is defined and acl_id == item.id %} active{% endif %}" data-acl-value="{{ item.id }}">
                                    <div class="menu-acl-card-icon-box">
                                        <i class="bi bi-shield-lock-fill"></i>
                                    </div>
                                    <div class="menu-acl-card-content">
                                        <span class="menu-acl-card-title">{{ item.name }}</span>
                                        <span class="menu-acl-card-subtitle">ACL #{{ item.id }}</span>
                                    </div>
                                    <i class="bi bi-check-circle-fill menu-acl-card-check"></i>
                                </div>
                            {% endfor %}
                        </div>

                        <!-- Fallback & Form Synchronized Select -->
                        <div class="menu-select-wrapper menu-acl-select-fallback">
                            <i class="bi bi-shield-check menu-select-icon"></i>
                            <select class="menu-select-lg" name="acl_id" id="menuWizardAclSelect">
                                <option value="0" {% if acl_id is not defined or acl_id == 0 %}selected{% endif %}>{{ lang.mod_menu.choose_wish }}</option>
                                {% for item in mod_acl_acl_id %}
                                    <option value="{{ item.id }}" {% if acl_id is defined and acl_id == item.id %}selected{% endif %}>{{ item.name }}</option>
                                {% endfor %}
                            </select>
                            <i class="bi bi-chevron-down menu-select-chevron"></i>
                        </div>
                        <div class="menu-field-hint">
                            <i class="bi bi-info-circle"></i> {{ lang.mod_menu.help.access_control }}
                        </div>
                    </div>
                </div>

                <!-- Step 10: Publish Status & Summary -->
                <div class="menu-wizard-step" id="menuWizardStep10">
                    <div class="menu-step-badge-wrap">
                        <div class="menu-step-avatar"><i class="bi bi-toggle-on"></i></div>
                        <div class="menu-step-meta">
                            <span class="menu-step-tag">{{ lang.mod_menu.wizard.labels.step_prefix }} 10 / 10</span>
                            <h2 class="menu-step-headline">{{ lang.mod_menu.wizard.steps.step_10 }}</h2>
                        </div>
                    </div>
                    <p class="menu-step-subhead">{{ lang.mod_menu.wizard.subtitles.step_10 }}</p>

                    <div class="menu-field-group">
                        <label class="menu-field-label">{{ lang.mod_menu.admin.columns.status }}</label>
                        <div class="menu-selection-grid">
                            <div class="menu-selection-card card-status-published{% if status_val != 'n' %} active{% endif %}" data-status-value="y">
                                <i class="bi bi-eye menu-card-icon"></i>
                                <span class="menu-card-label"><span class="menu-status-dot dot-published"></span> {{ lang.mod_menu.admin.radio.publish_yes }}</span>
                                <span class="menu-card-desc">{{ lang.mod_menu.wizard.labels.status_published_desc }}</span>
                                <i class="bi bi-check-circle-fill menu-check-badge"></i>
                            </div>
                            <div class="menu-selection-card card-status-draft{% if status_val == 'n' %} active{% endif %}" data-status-value="n">
                                <i class="bi bi-eye-slash menu-card-icon"></i>
                                <span class="menu-card-label"><span class="menu-status-dot dot-draft"></span> {{ lang.mod_menu.admin.radio.publish_no }}</span>
                                <span class="menu-card-desc">{{ lang.mod_menu.wizard.labels.status_draft_desc }}</span>
                                <i class="bi bi-check-circle-fill menu-check-badge"></i>
                            </div>
                        </div>
                    </div>

                    <div class="menu-wizard-summary">
                        <div class="menu-summary-header">
                            <div class="menu-summary-header-icon">
                                <i class="bi bi-clipboard2-check-fill"></i>
                            </div>
                            <div class="menu-summary-header-text">
                                <h3>{{ lang.mod_menu.wizard.summary.title }}</h3>
                                <span>{{ lang.mod_menu.wizard.subtitles.step_10 }}</span>
                            </div>
                        </div>
                        <div class="menu-summary-list">
                            <div class="menu-summary-item">
                                <span class="menu-summary-label">{{ lang.mod_menu.wizard.summary.language }}</span>
                                <div class="menu-summary-right">
                                    <span class="menu-summary-value" id="menuSummaryLang">-</span>
                                    <button type="button" class="menu-summary-jump-btn" data-jump-step="1" title="{{ lang.mod_menu.wizard.steps.step_1 }}">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="menu-summary-item">
                                <span class="menu-summary-label">{{ lang.mod_menu.wizard.summary.name }}</span>
                                <div class="menu-summary-right">
                                    <span class="menu-summary-value" id="menuSummaryName">-</span>
                                    <button type="button" class="menu-summary-jump-btn" data-jump-step="2" title="{{ lang.mod_menu.wizard.steps.step_2 }}">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="menu-summary-item">
                                <span class="menu-summary-label">{{ lang.mod_menu.wizard.summary.parent }}</span>
                                <div class="menu-summary-right">
                                    <span class="menu-summary-value" id="menuSummaryParent">-</span>
                                    <button type="button" class="menu-summary-jump-btn" data-jump-step="3" title="{{ lang.mod_menu.wizard.steps.step_3 }}">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="menu-summary-item">
                                <span class="menu-summary-label">{{ lang.mod_menu.wizard.summary.url }}</span>
                                <div class="menu-summary-right">
                                    <span class="menu-summary-value" id="menuSummaryUrl">-</span>
                                    <button type="button" class="menu-summary-jump-btn" data-jump-step="4" title="{{ lang.mod_menu.wizard.steps.step_4 }}">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="menu-summary-item">
                                <span class="menu-summary-label">{{ lang.mod_menu.wizard.summary.target }}</span>
                                <div class="menu-summary-right">
                                    <span class="menu-summary-value" id="menuSummaryTarget">-</span>
                                    <button type="button" class="menu-summary-jump-btn" data-jump-step="8" title="{{ lang.mod_menu.wizard.steps.step_8 }}">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="menu-summary-item">
                                <span class="menu-summary-label">{{ lang.mod_menu.wizard.summary.acl }}</span>
                                <div class="menu-summary-right">
                                    <span class="menu-summary-value" id="menuSummaryAcl">-</span>
                                    <button type="button" class="menu-summary-jump-btn" data-jump-step="9" title="{{ lang.mod_menu.wizard.steps.step_9 }}">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="menu-summary-item">
                                <span class="menu-summary-label">{{ lang.mod_menu.wizard.summary.status }}</span>
                                <div class="menu-summary-right">
                                    <span class="menu-summary-value" id="menuSummaryStatus">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Footer -->
            <footer class="menu-wizard-footer">
                <button type="button" class="menu-btn-prev" id="menuWizardBtnPrev" disabled>
                    <i class="bi bi-arrow-left"></i>
                    <span>{{ lang.mod_menu.wizard.buttons.prev }}</span>
                </button>
                <button type="button" class="menu-btn-next" id="menuWizardBtnNext">
                    <span>{{ lang.mod_menu.wizard.buttons.next }}</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
                <button type="button" class="menu-btn-finish" id="menuWizardBtnFinish">
                    <i class="bi bi-check-lg"></i>
                    <span>{{ lang.mod_menu.wizard.buttons.finish }}</span>
                </button>
            </footer>
        </div>
    </form>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script src="{{ site.address }}templates/admin/assets/js/mod_menu_wizard.js?v=4.0"></script>
{% endblock %}
