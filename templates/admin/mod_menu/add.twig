{% set hide_navbar = true %}
{% extends 'admin/layout.twig' %}

{% set hide_search = true %}
{% set hide_fab = true %}

{% block title %}
	{{ lang.mod_menu.add }}
{% endblock %}

{% block headline %}
	{{ lang.mod_menu.add }}
{% endblock %}

{% macro select_nested_parent_id_function(select_nested_parent_id_result, parent_id, selected_id, self_id, level = 0, disable = false) %}
    {% if select_nested_parent_id_result[parent_id] is defined %}
        {% for entry in select_nested_parent_id_result[parent_id] %}
            {% set parent_id_loop = entry.id %}
            {% set display_name = entry.display_name %}
            <option value="{{ entry.id }}" {% if selected_id == entry.id %} selected="selected" {% endif %} {% if entry.id == self_id or disable %} disabled="disabled" {% endif %}>
                {{ '&nbsp;&nbsp;&nbsp;'|repeat(level)|raw }}{{ display_name }} ({% if entry.lang is defined %}{{ entry.lang|upper }}{% endif %})
            </option>
            {% if select_nested_parent_id_result[parent_id_loop] is defined and select_nested_parent_id_result[parent_id_loop] is iterable and parent_id_loop != parent_id and level < 20 %}
                {% set next_disable = disable or (entry.id == self_id) %}
                {{ _self.select_nested_parent_id_function(select_nested_parent_id_result, parent_id_loop, selected_id, self_id, level + 1, next_disable) }}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% block content %}
    {% set selected_parent_id = menu_selected_parent_id is defined ? menu_selected_parent_id : (parent_id is defined and parent_id != '' ? parent_id : menu_parent_default_id) %}
	<style>
		.edit-container {
			padding: 16px;
			display: flex;
			flex-direction: column;
			gap: 16px;
			padding-bottom: 120px;
		}
		.edit-card {
			background: var(--md-sys-color-surface);
			border-radius: 12px;
			padding: 20px;
			box-shadow: var(--md-sys-elevation-1);
		}
		.card-header-edit {
			display: flex;
			align-items: center;
			gap: 8px;
			margin-bottom: 16px;
			color: var(--md-sys-color-primary);
		}
		.card-header-edit i {
			font-size: 20px;
		}
		.card-header-edit h3 {
			margin: 0;
			font-size: 16px;
			font-weight: 500;
		}
		.form-row {
			margin-bottom: 20px;
		}
		.m3-input-wrapper {
			position: relative;
			margin-bottom: 4px;
		}
		.m3-input-wrapper:focus-within {
			z-index: 9999;
		}
		.m3-input-lg {
			width: 100%;
			padding: 12px 16px;
			border-radius: 8px;
			border: 1px solid var(--md-sys-color-outline);
			background: transparent;
			color: var(--md-sys-color-on-surface);
			font-size: 16px;
			outline: none;
            box-sizing: border-box;
		}
		.m3-input-lg:focus {
			border-color: var(--md-sys-color-primary);
			border-width: 2px;
			padding: 11px 15px;
		}
        textarea.m3-input-lg {
            min-height: 112px;
            resize: vertical;
            line-height: 1.4;
        }
		.m3-floating-label {
			position: absolute;
			top: 12px;
			left: 16px;
			color: var(--md-sys-color-on-surface-variant);
			font-size: 16px;
			pointer-events: none;
			transition: all 0.2s;
            z-index: 10;
		}
        .m3-input-lg:focus ~ .m3-floating-label,
		.m3-input-lg:not(:placeholder-shown) ~ .m3-floating-label,
        select.m3-input-lg ~ .m3-floating-label,
        .ts-wrapper.m3-input-lg ~ .m3-floating-label {
			top: -10px;
			left: 12px;
			font-size: 12px;
			color: var(--md-sys-color-on-surface-variant);
			background: var(--md-sys-color-surface);
			padding: 0 4px;
		}
        .m3-input-lg:focus ~ .m3-floating-label,
        select.m3-input-lg:focus ~ .m3-floating-label,
        .ts-wrapper.m3-input-lg.focus ~ .m3-floating-label {
            color: var(--md-sys-color-primary);
        }
        /* TomSelect override */
        .ts-wrapper.m3-input-lg {
            padding: 0;
            border: none;
        }
        .ts-wrapper.m3-input-lg .ts-control {
            border-radius: 8px;
            border: 1px solid var(--md-sys-color-outline);
            background: linear-gradient(180deg, rgba(255,255,255,0.92) 0%, rgba(248,246,252,0.96) 100%);
            padding: 12px 16px;
            min-height: 48px;
            font-size: 16px;
            box-shadow: none;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s, transform 0.2s;
        }
        .ts-wrapper.m3-input-lg .ts-control,
        .ts-wrapper.m3-input-lg .ts-control input,
        .ts-wrapper.m3-input-lg.single .ts-control > .item,
        .ts-wrapper.m3-input-lg.multi .ts-control > .item {
            color: var(--md-sys-color-on-surface) !important;
            -webkit-text-fill-color: var(--md-sys-color-on-surface) !important;
            opacity: 1 !important;
        }
        .ts-wrapper.m3-input-lg.single .ts-control > .item {
            display: block !important;
            visibility: visible !important;
            max-width: calc(100% - 18px);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .ts-wrapper.m3-input-lg.has-items .ts-control > input {
            opacity: 0 !important;
        }
        .m3-ts-selected-value,
        .m3-ts-option-value {
            color: var(--md-sys-color-on-surface) !important;
            -webkit-text-fill-color: var(--md-sys-color-on-surface) !important;
        }
        .m3-ts-selected-value {
            display: block;
            max-width: calc(100% - 18px);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-weight: 500;
        }
        .ts-wrapper.m3-input-lg.focus .ts-control {
            border-color: var(--md-sys-color-primary);
            border-width: 2px;
            padding: 11px 15px;
            box-shadow: 0 10px 24px rgba(103, 80, 164, 0.14);
            transform: translateY(-1px);
        }
        .ts-wrapper.single .ts-control:after {
            border-color: var(--md-sys-color-on-surface-variant) transparent transparent transparent;
            border-width: 6px 5px 0 5px;
            margin-top: -3px;
            right: 14px;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .ts-wrapper.single.dropdown-active .ts-control:after {
            transform: rotate(180deg);
            border-color: var(--md-sys-color-primary) transparent transparent transparent;
        }
        .ts-dropdown {
            border: 1px solid rgba(103, 80, 164, 0.16);
            border-radius: 18px;
            box-shadow: 0 18px 38px rgba(34, 24, 64, 0.16);
            overflow: hidden;
            padding: 8px;
            margin-top: 8px;
            background: rgba(255, 252, 255, 0.98);
            backdrop-filter: blur(14px);
        }
        .ts-dropdown .ts-dropdown-content {
            max-height: 280px;
            padding: 0;
        }
        .ts-dropdown .option,
        .ts-dropdown .create {
            border-radius: 12px;
            padding: 12px 14px;
            font-size: 14px;
            line-height: 1.35;
            color: var(--md-sys-color-on-surface);
            transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
        }
        .ts-dropdown .option:hover,
        .ts-dropdown .option.active,
        .ts-dropdown .create:hover {
            background: rgba(103, 80, 164, 0.10);
            color: var(--md-sys-color-primary);
            transform: translateX(1px);
        }
        .ts-dropdown .optgroup-header {
            padding: 10px 14px 6px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--md-sys-color-on-surface-variant);
        }
        .ts-wrapper.plugin-dropdown_input.focus.dropdown-active .ts-control,
        .ts-wrapper.dropdown-active .ts-control {
            border-color: var(--md-sys-color-primary);
        }
        .selection-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 8px;
        }
        .selection-card {
            border: 1px solid var(--md-sys-color-outline);
            border-radius: 12px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
        }
        .selection-card.active {
            background: var(--md-sys-color-primary-container);
            border-color: var(--md-sys-color-primary);
        }
        .check-icon {
            position: absolute;
            top: 8px;
            right: 8px;
            color: var(--md-sys-color-primary);
            display: none;
        }
        .selection-card.active .check-icon {
            display: block;
        }
        
        /* Icon Input Enhancements */
        .icon-input-group {
            position: relative;
            display: flex;
            align-items: center;
        }
        .icon-preview-box {
            position: absolute;
            right: 8px;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--md-sys-color-surface-variant);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--md-sys-color-on-surface-variant);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        /* Helper Text Enhancements */
        .m3-help-text {
            font-size: 12px;
            color: var(--md-sys-color-on-surface-variant);
            margin-top: 6px;
            margin-left: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .m3-help-text i {
            font-size: 14px;
            color: var(--md-sys-color-primary);
        }
        .m3-field-label {
            display: block;
            margin: 0 0 8px 4px;
            font-size: 14px;
            font-weight: 600;
            color: var(--md-sys-color-on-surface-variant);
        }
	</style>

	<form id="addForm" method="POST" action="">
		<div class="edit-container">
            {% if error is defined %}
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        Swal.fire({
                            icon: 'warning',
                            html: '<b><i class="bi bi-exclamation-triangle-fill"></i> {{ mesaj }}</b>',
                            confirmButtonText: '{{ lang.mod_menu.options.ok }}',
                            confirmButtonColor: '#ba1a1a'
                        });
                    });
                </script>
            {% endif %}

            {% if hatalar is defined %}
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        let errorHtml = '<div style="text-align: left;">';
                        {% for hata in hatalar %}
                            errorHtml += '<div style="margin-bottom: 8px;"><i class="bi bi-exclamation-triangle-fill" style="color: #ba1a1a;"></i> <b>{{ hata }}</b></div>';
                        {% endfor %}
                        errorHtml += '</div>';

                        Swal.fire({
                            icon: 'warning',
                            html: errorHtml,
                            confirmButtonText: '{{ lang.mod_menu.options.ok }}',
                            confirmButtonColor: '#ba1a1a'
                        });
                    });
                </script>
            {% endif %}

			{# Card 1: Basics #}
			<div class="edit-card">
				<div class="form-row">
					<div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="lang" id="lang" required>
                            {% for item in lang_lang %}
                                <option value="{{ item.seo }}" {% if (selected_lang is defined ? selected_lang : site.lang)|lower == item.seo|lower %}selected{% endif %}>{{ item.name }} ({{ item.seo|upper }})</option>
                            {% endfor %}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_menu.admin.columns.language }}</label>
                    </div>
				</div>

					<div class="form-row">
                        <label class="m3-field-label" for="name">{{ lang.mod_menu.admin.columns.name }}</label>
						<div class="m3-input-wrapper">
							<input type="text" class="m3-input-lg" name="name" id="name" placeholder="{{ lang.mod_menu.placeholders.menu_name }}" autocomplete="off" value="{{ name }}" required>
						</div>
				</div>

                <div class="form-row">
                    <div class="m3-input-wrapper">
                        <select class="m3-input-lg" name="parent_id" id="parent_id" required>
                            <option value="{{ menu_parent_default_id }}" {% if selected_parent_id is same as(menu_parent_default_id) %}selected{% endif %} disabled>{{ lang.mod_menu.parent_labels.select_parent }}</option>
                            {{ _self.select_nested_parent_id_function(select_nested_parent_id_result, menu_parent_root_id, selected_parent_id, 0) }}
                        </select>
                        <label class="m3-floating-label">{{ lang.mod_menu.admin.columns.parent_id }}</label>
                    </div>
                </div>
			</div>

			{# Card 2: Links & Content #}
			<div class="edit-card">

                <div class="form-row">
                    <label class="m3-field-label" for="url">{{ lang.mod_menu.admin.columns.url }}</label>
                    <div class="m3-input-wrapper">
                        <input type="text" class="m3-input-lg" name="url" id="url" placeholder="{{ lang.mod_menu.placeholders.menu_url }}" value="{{ url }}">
                    </div>
                </div>

                <div class="form-row">
                    <label class="m3-field-label" for="file">{{ lang.mod_menu.admin.columns.file }}</label>
                    <div class="m3-input-wrapper">
                        <input type="text" class="m3-input-lg" name="file" id="file" placeholder="{{ lang.mod_menu.placeholders.menu_file }}" value="{{ file }}">
                    </div>
                </div>

                <div class="form-row">
                    <label class="m3-field-label" for="icon">{{ lang.mod_menu.admin.columns.icon }}</label>
                    <div class="m3-input-wrapper icon-input-group">
                        <input type="text" class="m3-input-lg pr-5" name="icon" id="icon" placeholder="{{ lang.mod_menu.placeholders.icon_class }}" value="{{ icon }}">
                        <div class="icon-preview-box" id="iconPreview">
                            <i class="bi bi-question"></i>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <label class="m3-field-label" for="html">{{ lang.mod_menu.admin.columns.html }}</label>
                    <div class="m3-input-wrapper">
                        <textarea class="m3-input-lg" name="html" id="html" rows="3" placeholder="{{ lang.mod_menu.placeholders.menu_html }}">{{ html }}</textarea>
                    </div>
                </div>
            </div>

			{# Card 3: Display Settings #}
			<div class="edit-card">

                <div class="form-row">
                    <label class="filter-group-label" style="font-size:14px; margin-bottom:8px; display:block; font-weight: 500;">{{ lang.mod_menu.admin.columns.target }}</label>
                    <input type="hidden" name="target" value="n" id="targetHidden">
                    <div class="selection-grid">
                        <div class="selection-card active" onclick="selectTargetStatus(this, 'n')">
                            <i class="bi bi-box-arrow-in-right" style="font-size:24px;"></i>
                            <div class="selection-label">{{ lang.mod_menu.admin.select_value.target_h }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                        <div class="selection-card" onclick="selectTargetStatus(this, 'y')">
                            <i class="bi bi-box-arrow-up-right" style="font-size:24px;"></i>
                            <div class="selection-label">{{ lang.mod_menu.admin.select_value.target_e }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <label class="filter-group-label" style="font-size:14px; margin-bottom:8px; display:block; font-weight: 500;">{{ lang.mod_menu.admin.columns.status }}</label>
                    <input type="hidden" name="status" value="y" id="statusHidden">
                    <div class="selection-grid">
                        <div class="selection-card active" onclick="updateStatusSelection(this, 'y')">
                            <i class="bi bi-eye" style="font-size:24px;"></i>
                            <div class="selection-label">{{ lang.mod_menu.admin.radio.publish_yes }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                        <div class="selection-card" onclick="updateStatusSelection(this, 'n')">
                            <i class="bi bi-eye-slash" style="font-size:24px;"></i>
                            <div class="selection-label">{{ lang.mod_menu.admin.radio.publish_no }}</div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="m3-input-wrapper" style="display: flex; align-items: center; gap: 8px;">
                        <select class="m3-input-lg" name="acl_id" id="acl_id" style="flex: 1;">
                            <option value="0" selected>{{ lang.mod_menu.choose_wish }}</option>
                            {% for item in mod_acl_acl_id %}
                                <option value="{{ item.id }}">{{ item.name }}</option>
                            {% endfor %}
                        </select>
                        <a href="{{ site.saddress }}mod_acl/list" class="btn btn-sm btn-light" style="display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 8px; border: 1px solid var(--md-sys-color-outline); color: var(--md-sys-color-primary); background: var(--md-sys-color-surface);" title="{{ lang.mod_menu.form.acl_settings }}">
                            <i class="bi bi-gear" style="font-size: 20px;"></i>
                        </a>
                        <label class="m3-floating-label">{{ lang.mod_menu.admin.columns.acl_id|raw }}</label>
                    </div>
                </div>
			</div>

		</div>
	</form>
{% endblock %}

