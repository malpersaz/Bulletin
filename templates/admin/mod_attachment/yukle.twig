{% set show_fab = false %}
{% set show_navbar = false %}
{% set show_search = false %}
{% set show_sidebar = false %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set show_extra_sheets = false %}
{% set hide_contextual_bar = true %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_attachment.admin[1]|default('File Upload Area') }}{% endblock %}
{% block headline %}{{ lang.mod_attachment.admin[1]|default('File Upload Area') }}{% endblock %}

{% block styles %}
<style>
    .attachment-upload-shell {
        padding: 16px;
        display: grid;
        gap: 16px;
        padding-bottom: 120px;
    }
    .upload-hero,
    .upload-panel {
        background: var(--md-sys-color-surface);
        border-radius: 24px;
        padding: 20px;
        box-shadow: var(--md-sys-elevation-1);
    }
    .upload-hero h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -0.02em;
    }
    .upload-hero p {
        margin: 8px 0 0;
        color: var(--md-sys-color-on-surface-variant);
        line-height: 1.6;
        font-size: 13px;
    }
    .upload-dropzone {
        border: 2px dashed var(--md-sys-color-outline);
        border-radius: 24px;
        padding: 28px 20px;
        display: grid;
        justify-items: center;
        gap: 12px;
        text-align: center;
        background: linear-gradient(180deg, rgba(103, 80, 164, 0.05), rgba(0, 105, 92, 0.04));
    }
    .upload-dropzone.dragover {
        border-color: var(--md-sys-color-primary);
        background: linear-gradient(180deg, rgba(103, 80, 164, 0.10), rgba(0, 105, 92, 0.08));
    }
    .upload-dropzone i {
        font-size: 36px;
        color: var(--md-sys-color-primary);
    }
    .upload-select-btn {
        min-height: 48px;
        padding: 0 18px;
        border-radius: 999px;
        border: none;
        background: var(--md-sys-color-primary);
        color: var(--md-sys-color-on-primary);
        font-weight: 700;
        cursor: pointer;
    }
    .upload-input { display: none; }
    .upload-queue { display: grid; gap: 12px; }
    .upload-item {
        border-radius: 18px;
        padding: 14px;
        background: rgba(255,255,255,0.82);
        border: 1px solid rgba(0,0,0,0.06);
        display: grid;
        gap: 10px;
    }
    .upload-item-top {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
    }
    .upload-name {
        font-weight: 700;
        word-break: break-word;
    }
    .upload-size {
        color: var(--md-sys-color-on-surface-variant);
        font-size: 12px;
    }
    .upload-progress {
        height: 8px;
        border-radius: 999px;
        background: rgba(0,0,0,0.08);
        overflow: hidden;
    }
    .upload-progress > span {
        display: block;
        height: 100%;
        width: 0;
        background: linear-gradient(90deg, #6750a4, #00695c);
    }
    .upload-state {
        font-size: 12px;
        color: var(--md-sys-color-on-surface-variant);
    }
</style>
{% endblock %}

{% block content %}
<div class="attachment-upload-shell">
    <section class="upload-hero">
        <h2>{{ lang.mod_attachment.admin[22]|format(d[value])|default('File Upload Area') }}</h2>
        <p>{{ lang.mod_attachment.admin[2]|default('Select a file by clicking the Browse button below!') }}</p>
        <p>{{ lang.mod_attachment.admin[3]|default('You can select and upload multiple files by holding down the CTRL key on your keyboard.') }}</p>
    </section>

    <section class="upload-panel">
        <div id="uploadDropzone" class="upload-dropzone">
            <i class="bi bi-cloud-arrow-up"></i>
            <strong>{{ lang.mod_attachment.admin[1]|default('File Upload Area') }}</strong>
            <span>{{ lang.mod_attachment.admin[6]|default('Waiting in upload queue...') }}</span>
            <button type="button" class="upload-select-btn" onclick="document.getElementById('uploadInput').click()">
                {{ lang.mod_attachment.admin[11]|default('Browse') }}
            </button>
            <input id="uploadInput" class="upload-input" type="file" multiple>
        </div>
    </section>

    <section id="uploadQueue" class="upload-queue"></section>
</div>
{% endblock %}

{% block fixed_bottom %}
<div class="standard-toolbar">
    <button class="toolbar-item" onclick="history.back()">
        <i class="bi bi-chevron-left"></i>
        <span>{{ lang.mod_attachment.admin[12]|default('Back') }}</span>
    </button>

    <button class="toolbar-item" onclick="location.href='{{ site.sadres }}mod_attachment/list/{{ mod_name }}/{{ vid }}'">
        <i class="bi bi-folder2-open"></i>
        <span>{{ lang.mod_attachment.admin[14]|default('File Management') }}</span>
    </button>

    <button type="button" class="toolbar-fab" onclick="document.getElementById('uploadInput').click()">
        <i class="bi bi-upload"></i>
    </button>

    <button class="toolbar-item active" onclick="document.getElementById('uploadInput').click()">
        <i class="bi bi-cloud-arrow-up"></i>
        <span>{{ lang.mod_attachment.admin[38]|default('Add File') }}</span>
    </button>

    <button class="toolbar-item" onclick="location.href='{{ site.sadres }}mod_attachment/list/{{ mod_name }}/{{ vid }}'">
        <i class="bi bi-list-ul"></i>
        <span>{{ lang.mod_attachment.admin[14]|default('File Management') }}</span>
    </button>
</div>
{% endblock %}

{% block scripts %}
<script>
    const uploadInput = document.getElementById('uploadInput');
    const uploadQueue = document.getElementById('uploadQueue');
    const uploadDropzone = document.getElementById('uploadDropzone');

    function createUploadItem(file) {
        const article = document.createElement('article');
        article.className = 'upload-item';
        article.innerHTML = `
            <div class="upload-item-top">
                <div>
                    <div class="upload-name"></div>
                    <div class="upload-size"></div>
                </div>
                <i class="bi bi-file-earmark-arrow-up"></i>
            </div>
            <div class="upload-progress"><span></span></div>
            <div class="upload-state">{{ lang.mod_attachment.admin[6]|e('js') }}</div>
        `;
        article.querySelector('.upload-name').textContent = file.name;
        article.querySelector('.upload-size').textContent = `${Math.round(file.size / 1024)} KB`;
        uploadQueue.prepend(article);
        return article;
    }

    function uploadFiles(files) {
        Array.from(files).forEach(file => {
            const item = createUploadItem(file);
            const progressBar = item.querySelector('.upload-progress > span');
            const state = item.querySelector('.upload-state');

            const formData = new FormData();
            formData.append('file', file);
            formData.append('vid', '{{ vid }}');
            formData.append('isim', 'file');
            formData.append('sid', '{{ session.sid }}');
            formData.append('mod_name', '{{ mod_name }}');

            const xhr = new XMLHttpRequest();
            xhr.open('POST', '{{ site.sadres }}mod_attachment/up');

            xhr.upload.addEventListener('progress', event => {
                if (!event.lengthComputable) return;
                const percent = Math.round((event.loaded / event.total) * 100);
                progressBar.style.width = percent + '%';
                state.textContent = `${percent}%`;
            });

            xhr.onload = function () {
                if (xhr.status >= 200 && xhr.status < 300 && xhr.responseText && xhr.responseText !== 'ERROR') {
                    progressBar.style.width = '100%';
                    state.textContent = file.name + ' uploaded';
                    showSnackbar(file.name + ' uploaded', 'success');
                } else {
                    state.textContent = xhr.responseText || 'Upload failed';
                    showSnackbar(xhr.responseText || 'Upload failed', 'error');
                }
            };

            xhr.onerror = function () {
                state.textContent = 'Upload failed';
                showSnackbar('Upload failed', 'error');
            };

            xhr.send(formData);
        });
    }

    if (uploadInput) {
        uploadInput.addEventListener('change', event => {
            if (event.target.files?.length) uploadFiles(event.target.files);
        });
    }

    if (uploadDropzone) {
        ['dragenter', 'dragover'].forEach(type => {
            uploadDropzone.addEventListener(type, event => {
                event.preventDefault();
                uploadDropzone.classList.add('dragover');
            });
        });
        ['dragleave', 'drop'].forEach(type => {
            uploadDropzone.addEventListener(type, event => {
                event.preventDefault();
                uploadDropzone.classList.remove('dragover');
            });
        });
        uploadDropzone.addEventListener('drop', event => {
            if (event.dataTransfer?.files?.length) uploadFiles(event.dataTransfer.files);
        });
    }
</script>
{% endblock %}
