{% set show_fab = false %}
{% set show_navbar = false %}
{% set show_search = true %}
{% set show_search_filter_button = false %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set show_extra_sheets = false %}
{% set hide_contextual_bar = true %}
{% set search_placeholder = lang.mod_attachment.admin.file_name %}
{% extends is_ajax ? 'admin/layout_blank.twig' : 'admin/layout.twig' %}

{% block title %}{{ lang.mod_attachment.admin.file_management }}{% endblock %}
{% block headline %}{{ lang.mod_attachment.admin.file_management }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/mod_attachment.css?v={{ site.version|default('1.0') }}">
{% endblock %}

{% block content %}
<div id="attachmentShellRoot"
     class="attachment-shell {{ is_ajax ? 'attachment-shell--modal' : '' }}"
     data-modal-title="{{ lang.mod_attachment.admin.file_management }}"
     data-modal-icon="bi-folder2-open"
     data-site-url="{{ site.saddress }}"
     data-mod-name="{{ mod_name|default('mod_attachment') }}"
     data-vid="{{ vid|default(0) }}"
     data-sid="{{ session.sid|default('') }}"
     data-lang-new="{{ lang.mod_attachment.admin.new }}"
     data-lang-file-name="{{ lang.mod_attachment.admin.file_name }}"
     data-lang-file-edited="{{ lang.mod_attachment.admin.file_edited }}"
     data-lang-file-deleted="{{ lang.mod_attachment.admin.file_deleted }}"
     data-lang-upload-failed="{{ lang.mod_attachment.admin.file_upload_failed }}"
     data-lang-delete-title="{{ lang.mod_attachment.admin.delete_file }}"
     data-lang-delete-confirm="{{ lang.mod_attachment.admin.confirm_delete_file }}"
     data-lang-yes="{{ lang.mod_attachment.admin.yes }}"
     data-lang-cancel="{{ lang.mod_attachment.admin.cancel }}">

    <input id="attachmentInlineInput" type="file" multiple class="is-hidden">

    <section class="attachment-banner">
        <div class="attachment-banner-info">
            <h2>{{ lang.mod_attachment.admin.file_management }}</h2>
            {% if not is_global_list and record_title is defined and record_title %}
                <p class="attachment-banner-record">{{ record_title }}</p>
            {% endif %}
        </div>
        <div class="attachment-banner-meta">
            {% if is_global_list %}
                <span><i class="bi bi-collection"></i>{{ lang.mod_attachment.admin.all_files }}</span>
            {% else %}
                <span><i class="bi bi-hash"></i>{{ vid }}</span>
            {% endif %}
            <span><i class="bi bi-paperclip"></i><strong id="attachmentCount">{{ files is defined ? files|length : 0 }}</strong></span>
        </div>
    </section>

    <section class="attachment-entry-card">
        <div class="attachment-entry-copy">
            <i class="bi bi-cloud-arrow-up-fill"></i>
            <h3 class="attachment-entry-title">{{ lang.mod_attachment.admin.add_files }}</h3>
        </div>
        <button type="button" class="attachment-browse-btn" data-action="open-upload">
            <i class="bi bi-plus-lg"></i>
            <span>{{ lang.mod_attachment.admin.browse }}</span>
        </button>
    </section>

    <div class="attachment-controls-bar">
        {% if is_ajax %}
            <div class="attachment-modal-search">
                <i class="bi bi-search"></i>
                <input type="text" id="attachmentModalSearchInput" placeholder="{{ lang.mod_attachment.admin.file_name }}" autocomplete="off">
                <button type="button" id="attachmentSearchClearBtn" class="attachment-search-clear is-hidden" data-action="clear-attachment-search" aria-label="{{ lang.mod_attachment.admin.cancel }}">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        {% endif %}

        {% if not is_global_list %}
            <div class="attachment-scope-tabs" role="tablist">
                <button type="button" class="attachment-scope-tab active" data-action="scope-filter" data-scope="all">
                    <i class="bi bi-collection"></i>
                    <span>{{ lang.mod_attachment.admin.all_files }}</span>
                    <strong id="attachmentScopeAllCount">{{ files is defined ? files|length : 0 }}</strong>
                </button>
                <button type="button" class="attachment-scope-tab" data-action="scope-filter" data-scope="record">
                    <i class="bi bi-bookmark-check"></i>
                    <span>#{{ vid }}</span>
                    <strong id="attachmentScopeRecordCount">0</strong>
                </button>
            </div>
        {% endif %}
    </div>

    <div id="attachment-list" class="attachment-grid">
        {% if files is defined and files is not empty %}
            {% for file_item in files %}
                {% set current_mod_name = file_item.mod_name|default(mod_name) %}
                {% set current_vid = file_item.vid|default(vid) %}
                {% set is_record_match = (not is_global_list and current_mod_name == mod_name and current_vid == vid) or (active_file_id is defined and active_file_id == file_item.id) %}
                {% set display_name = file_item.filename|default(file_item.original_name) %}
                {% set file_ext = file_item.ext|lower %}
                {% set type_class = 'type-generic' %}
                {% set type_icon = 'bi-file-earmark' %}
                {% if file_ext in ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'svg'] %}
                    {% set type_class = 'type-image' %}
                    {% set type_icon = 'bi-file-earmark-image' %}
                {% elseif file_ext in ['pdf'] %}
                    {% set type_class = 'type-pdf' %}
                    {% set type_icon = 'bi-file-earmark-pdf' %}
                {% elseif file_ext in ['zip', 'rar', '7z', 'tar', 'gz'] %}
                    {% set type_class = 'type-archive' %}
                    {% set type_icon = 'bi-file-earmark-zip' %}
                {% elseif file_ext in ['xls', 'xlsx', 'ods', 'csv'] %}
                    {% set type_class = 'type-sheet' %}
                    {% set type_icon = 'bi-file-earmark-spreadsheet' %}
                {% elseif file_ext in ['doc', 'docx', 'odt', 'ppt', 'pptx', 'epub', 'txt'] %}
                    {% set type_class = 'type-doc' %}
                    {% set type_icon = 'bi-file-earmark-text' %}
                {% endif %}
                {% set search_text = (display_name ~ ' ' ~ file_item.original_name ~ ' ' ~ file_item.ext ~ ' ' ~ file_item.id ~ ' ' ~ current_mod_name ~ ' ' ~ current_vid)|lower %}
                <article class="attachment-card"
                         id="attachment-{{ file_item.id }}"
                         data-action="select-attachment"
                         data-id="{{ file_item.id }}"
                         data-search="{{ search_text }}"
                         data-mod-name="{{ current_mod_name }}"
                         data-vid="{{ current_vid }}"
                         data-is-record="{{ is_record_match ? '1' : '0' }}"
                         data-file-name="{{ display_name|lower }}"
                         data-original-name="{{ file_item.original_name|lower }}">
                    <div class="attachment-topline">
                        <div class="attachment-icon {{ type_class }}"><i class="bi {{ type_icon }}"></i></div>
                        <div class="attachment-body">
                            <h3 class="attachment-title" data-display>{{ display_name }}</h3>
                            <div class="attachment-meta">
                                <span class="attachment-chip {{ type_class }}">{{ file_item.ext }}</span>
                                <span>#{{ file_item.id }}</span>
                                {% if file_item.original_name and file_item.original_name != display_name %}
                                    <span>{{ file_item.original_name }}</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="attachment-card-actions">
                            <button class="attachment-rename-btn"
                                    type="button"
                                    data-action="toggle-rename"
                                    data-id="{{ file_item.id }}"
                                    title="{{ lang.mod_attachment.admin.edit_file_name }}"
                                    aria-label="{{ lang.mod_attachment.admin.edit_file_name }}">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="attachment-delete-btn"
                                    type="button"
                                    data-action="delete-attachment"
                                    data-id="{{ file_item.id }}"
                                    title="{{ lang.mod_attachment.admin.delete_file }}"
                                    aria-label="{{ lang.mod_attachment.admin.delete_file }}">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    </div>

                    <div class="attachment-inline-edit is-hidden" id="attachment-edit-{{ file_item.id }}">
                        <input class="attachment-input" type="text" id="attachment-input-{{ file_item.id }}" value="{{ display_name }}">
                        <div class="attachment-actions">
                            <button type="button" class="attachment-cancel-btn" data-action="cancel-rename" data-id="{{ file_item.id }}">
                                <i class="bi bi-x-lg"></i>
                                <span>{{ lang.mod_attachment.admin.cancel }}</span>
                            </button>
                            <button type="button" class="attachment-edit" data-action="save-rename" data-id="{{ file_item.id }}">
                                <i class="bi bi-check2"></i>
                                <span>{{ lang.mod_attachment.admin.save }}</span>
                            </button>
                        </div>
                    </div>
                </article>
            {% endfor %}
        {% endif %}
    </div>

    <section id="attachment-empty" class="attachment-empty {{ (files is defined and files is not empty) ? 'is-hidden' : '' }}">
        <div class="empty-icon-box"><i class="bi bi-folder2-open"></i></div>
        <h3>{{ lang.mod_attachment.admin.no_saved_file_found }}</h3>
        <p>{{ lang.mod_attachment.admin.select_category_add_file }}</p>
    </section>

    <section id="search-empty" class="attachment-empty is-hidden">
        <div class="empty-icon-box"><i class="bi bi-search"></i></div>
        <h3>{{ lang.mod_attachment.admin.no_file_found }}</h3>
        <p>{{ lang.mod_attachment.admin.file_name }}</p>
    </section>
</div>
{% endblock %}

{% block fixed_bottom %}
{% if not is_ajax %}
<div class="standard-toolbar attachment-toolbar">
    <button id="toolbarDelete" type="button" class="toolbar-item is-disabled" data-action="delete-selected-attachment">
        <i class="bi bi-trash3-fill"></i>
        <span>{{ lang.mod_attachment.admin.delete_file }}</span>
    </button>

    <button type="button" class="toolbar-item" data-action="nav-url" data-url="{{ site.saddress }}mod_user/panel">
        <i class="bi bi-speedometer2"></i>
        <span>{{ lang.mod_attachment.admin.panel }}</span>
    </button>

    <button type="button" class="toolbar-item active" data-action="nav-url" data-url="{{ site.saddress }}mod_attachment/list">
        <i class="bi bi-card-list"></i>
        <span>{{ lang.mod_attachment.admin.file_management }}</span>
    </button>

    {% if not is_global_list %}
        <button type="button" class="toolbar-item" data-action="nav-url" data-url="{{ site.saddress }}{{ mod_name }}/list">
            <i class="bi bi-chevron-left"></i>
            <span>{{ lang.mod_attachment.admin.back }}</span>
        </button>
    {% else %}
        <button type="button" class="toolbar-item" data-action="nav-back">
            <i class="bi bi-chevron-left"></i>
            <span>{{ lang.mod_attachment.admin.back }}</span>
        </button>
    {% endif %}
</div>

<button type="button" class="main-fab" id="mainFab" aria-label="{{ lang.mod_attachment.admin.add_files }}">
    <i class="bi bi-plus-lg"></i>
</button>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="{{ site.address }}templates/admin/assets/js/mod_attachment.js?v={{ site.version|default('1.0') }}"></script>
{% endblock %}
