{% set show_fab = false %}
{% set show_navbar = false %}
{% set show_search = false %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set show_extra_sheets = false %}
{% set hide_contextual_bar = true %}
{% extends is_ajax ? 'admin/layout_blank.twig' : 'admin/layout.twig' %}

{% block title %}{{ lang.mod_attachment.admin.upload_area }}{% endblock %}
{% block headline %}{{ lang.mod_attachment.admin.upload_area }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="{{ site.address }}templates/admin/assets/css/mod_attachment.css?v={{ site.version }}">
{% endblock %}

{% block content %}
<div id="attachmentUploadRoot"
     class="attachment-upload-shell"
     data-modal-title="{{ lang.mod_attachment.admin.upload_area }}"
     data-modal-icon="bi-cloud-arrow-up"
     data-site-url="{{ site.saddress }}"
     data-mod-name="{{ mod_name|default('mod_attachment') }}"
     data-vid="{{ vid|default(0) }}"
     data-sid="{{ session.sid|default('') }}"
     data-lang-waiting="{{ lang.mod_attachment.admin.waiting_queue }}"
     data-lang-upload-failed="{{ lang.mod_attachment.admin.file_upload_failed }}">
    <section class="upload-hero">
        <h2>{{ lang.mod_attachment.admin.content_upload_area|format(record_title|default('')) }}</h2>
        <p>{{ lang.mod_attachment.admin.select_file_instruction }}</p>
        <p>{{ lang.mod_attachment.admin.ctrl_key_instruction|striptags }}</p>
        <div class="upload-chip-row">
            <span><i class="bi bi-collection"></i>{{ mod_name }}</span>
            <span><i class="bi bi-hash"></i>{{ vid }}</span>
        </div>
    </section>

    <section class="upload-panel">
        <div id="uploadDropzone" class="upload-dropzone">
            <i class="bi bi-cloud-arrow-up"></i>
            <strong>{{ lang.mod_attachment.admin.upload_area }}</strong>
            <span>{{ lang.mod_attachment.admin.waiting_queue }}</span>
            <button type="button" class="upload-select-btn" data-action="open-upload">
                {{ lang.mod_attachment.admin.browse }}
            </button>
            <input id="uploadInput" class="upload-input" type="file" multiple>
        </div>
    </section>

    <section id="uploadQueue" class="upload-queue"></section>
</div>
{% endblock %}

{% block fixed_bottom %}
{% if not is_ajax %}
<div class="standard-toolbar attachment-toolbar">
    <button type="button" class="toolbar-item" data-action="nav-back">
        <i class="bi bi-chevron-left"></i>
        <span>{{ lang.mod_attachment.admin.back }}</span>
    </button>

    <button type="button" class="toolbar-item" data-action="nav-url" data-url="{{ site.saddress }}mod_attachment/list/{{ mod_name }}/{{ vid }}">
        <i class="bi bi-folder2-open"></i>
        <span>{{ lang.mod_attachment.admin.file_management }}</span>
    </button>

    <button type="button" class="toolbar-fab" data-action="open-upload" aria-label="{{ lang.mod_attachment.admin.add_files }}">
        <i class="bi bi-upload"></i>
    </button>

    <button type="button" class="toolbar-item active" data-action="open-upload">
        <i class="bi bi-cloud-arrow-up"></i>
        <span>{{ lang.mod_attachment.admin.add_files }}</span>
    </button>

    <button type="button" class="toolbar-item" data-action="nav-url" data-url="{{ site.saddress }}mod_attachment/list/{{ mod_name }}/{{ vid }}">
        <i class="bi bi-list-ul"></i>
        <span>{{ lang.mod_attachment.admin.file_management }}</span>
    </button>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
<script src="{{ site.address }}templates/admin/assets/js/mod_attachment.js?v={{ site.version }}"></script>
{% endblock %}
