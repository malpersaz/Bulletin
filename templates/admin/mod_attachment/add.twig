{% set show_fab = false %}
{% set show_navbar = false %}
{% set show_search = false %}
{% set show_filter_sheet = false %}
{% set show_wizards = false %}
{% set show_extra_sheets = false %}
{% set hide_contextual_bar = true %}
{% extends 'admin/layout.twig' %}

{% block title %}{{ lang.mod_attachment.admin[1] }}{% endblock %}
{% block headline %}{{ lang.mod_attachment.admin[1] }}{% endblock %}

{% block styles %}
<style>
    .attachment-upload-shell {
        padding: 16px;
        display: grid;
        gap: 16px;
        padding-bottom: 120px;
        background:
            radial-gradient(circle at top left, rgba(31, 78, 121, 0.10), transparent 24%),
            radial-gradient(circle at bottom right, rgba(11, 107, 92, 0.10), transparent 28%),
            linear-gradient(180deg, #eef4f9 0%, #f4f8f3 100%);
    }
    .upload-hero,
    .upload-panel,
    .upload-item {
        background: rgba(255, 255, 255, 0.94);
        border-radius: 24px;
        box-shadow: 0 12px 30px rgba(22, 30, 52, 0.06);
        border: 1px solid rgba(0, 0, 0, 0.06);
    }
    .upload-hero,
    .upload-panel {
        padding: 20px;
    }
    .upload-hero h2 {
        margin: 0;
        font-size: 16px;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.4;
    }
    .upload-hero p {
        margin: 8px 0 0;
        color: var(--md-sys-color-on-surface-variant);
        line-height: 1.6;
        font-size: 13px;
    }
    .upload-chip-row {
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .upload-chip-row span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 30px;
        padding: 0 12px;
        border-radius: 999px;
        background: #eef6ff;
        color: #1e4f7a;
        font-size: 12px;
        font-weight: 700;
    }
    .upload-dropzone {
        border: 2px dashed var(--md-sys-color-outline);
        border-radius: 24px;
        padding: 28px 20px;
        display: grid;
        justify-items: center;
        gap: 12px;
        text-align: center;
        background: linear-gradient(180deg, rgba(31, 78, 121, 0.06), rgba(11, 107, 92, 0.05));
    }
    .upload-dropzone.dragover {
        border-color: var(--md-sys-color-primary);
        background: linear-gradient(180deg, rgba(31, 78, 121, 0.11), rgba(11, 107, 92, 0.10));
    }
    .upload-dropzone i {
        font-size: 40px;
        color: var(--md-sys-color-primary);
    }
    .upload-dropzone strong {
        font-size: 16px;
    }
    .upload-select-btn {
        min-height: 48px;
        padding: 0 18px;
        border-radius: 999px;
        border: none;
        background: var(--md-sys-color-primary);
        color: var(--md-sys-color-on-primary);
        font-weight: 700;
        cursor: pointer;
    }
    .upload-input {
        display: none;
    }
    .upload-queue {
        display: grid;
        gap: 12px;
    }
    .upload-item {
        padding: 14px;
        display: grid;
        gap: 10px;
    }
    .upload-item-top {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
    }
    .upload-name {
        font-weight: 700;
        word-break: break-word;
    }
    .upload-size,
    .upload-state {
        color: var(--md-sys-color-on-surface-variant);
        font-size: 12px;
    }
    .upload-progress {
        height: 8px;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }
    .upload-progress > span {
        display: block;
        height: 100%;
        width: 0;
        background: linear-gradient(90deg, #1f4e79, #0b6b5c);
    }
</style>
{% endblock %}

{% block content %}
<div class="attachment-upload-shell">
    <section class="upload-hero">
        <h2>{{ lang.mod_attachment.admin[22]|format(record_title) }}</h2>
        <p>{{ lang.mod_attachment.admin[2] }}</p>
        <p>{{ lang.mod_attachment.admin[3] }}</p>
        <div class="upload-chip-row">
            <span><i class="bi bi-collection"></i>{{ mod_name }}</span>
            <span><i class="bi bi-hash"></i>{{ vid }}</span>
        </div>
    </section>

    <section class="upload-panel">
        <div id="uploadDropzone" class="upload-dropzone">
            <i class="bi bi-cloud-arrow-up"></i>
            <strong>{{ lang.mod_attachment.admin[1] }}</strong>
            <span>{{ lang.mod_attachment.admin[6] }}</span>
            <button type="button" class="upload-select-btn" onclick="document.getElementById('uploadInput').click()">
                {{ lang.mod_attachment.admin[11] }}
            </button>
            <input id="uploadInput" class="upload-input" type="file" multiple>
        </div>
    </section>

    <section id="uploadQueue" class="upload-queue"></section>
</div>
{% endblock %}

{% block fixed_bottom %}
<div class="standard-toolbar">
    <button class="toolbar-item" onclick="history.back()">
        <i class="bi bi-chevron-left"></i>
        <span>{{ lang.mod_attachment.admin[12] }}</span>
    </button>

    <button class="toolbar-item" onclick="location.href='{{ site.saddress }}mod_attachment/list/{{ mod_name }}/{{ vid }}'">
        <i class="bi bi-folder2-open"></i>
        <span>{{ lang.mod_attachment.admin[14] }}</span>
    </button>

    <button type="button" class="toolbar-fab" onclick="document.getElementById('uploadInput').click()">
        <i class="bi bi-upload"></i>
    </button>

    <button class="toolbar-item active" onclick="document.getElementById('uploadInput').click()">
        <i class="bi bi-cloud-arrow-up"></i>
        <span>{{ lang.mod_attachment.admin[38] }}</span>
    </button>

    <button class="toolbar-item" onclick="location.href='{{ site.saddress }}mod_attachment/list/{{ mod_name }}/{{ vid }}'">
        <i class="bi bi-list-ul"></i>
        <span>{{ lang.mod_attachment.admin[14] }}</span>
    </button>
</div>
{% endblock %}

{% block scripts %}
<script>
    const uploadInput = document.getElementById('uploadInput');
    const uploadQueue = document.getElementById('uploadQueue');
    const uploadDropzone = document.getElementById('uploadDropzone');

    function createUploadItem(file) {
        const article = document.createElement('article');
        article.className = 'upload-item';
        article.innerHTML = `
            <div class="upload-item-top">
                <div>
                    <div class="upload-name"></div>
                    <div class="upload-size"></div>
                </div>
                <i class="bi bi-file-earmark-arrow-up"></i>
            </div>
            <div class="upload-progress"><span></span></div>
            <div class="upload-state">{{ lang.mod_attachment.admin[6]|e('js') }}</div>
        `;
        article.querySelector('.upload-name').textContent = file.name;
        article.querySelector('.upload-size').textContent = `${Math.max(1, Math.round(file.size / 1024))} KB`;
        uploadQueue.prepend(article);
        return article;
    }

    function uploadFiles(files) {
        Array.from(files).forEach((file) => {
            const item = createUploadItem(file);
            const progressBar = item.querySelector('.upload-progress > span');
            const state = item.querySelector('.upload-state');

            const formData = new FormData();
            formData.append('file', file);
            formData.append('vid', '{{ vid }}');
            formData.append('isim', 'file');
            formData.append('sid', '{{ session.sid }}');
            formData.append('mod_name', '{{ mod_name }}');

            const xhr = new XMLHttpRequest();
            xhr.open('POST', '{{ site.saddress }}mod_attachment/upload');

            xhr.upload.addEventListener('progress', (event) => {
                if (!event.lengthComputable) {
                    return;
                }
                const percent = Math.round((event.loaded / event.total) * 100);
                progressBar.style.width = `${percent}%`;
                state.textContent = `${percent}%`;
            });

            xhr.onload = function () {
                const responseText = (xhr.responseText || '').trim();
                if (xhr.status >= 200 && xhr.status < 300 && responseText && responseText !== 'ERROR') {
                    progressBar.style.width = '100%';
                    state.textContent = responseText;
                    showSnackbar(responseText, 'success');
                    return;
                }

                state.textContent = responseText || '{{ lang.mod_attachment.admin[41]|e('js') }}';
                showSnackbar(responseText || '{{ lang.mod_attachment.admin[41]|e('js') }}', 'error');
            };

            xhr.onerror = function () {
                state.textContent = '{{ lang.mod_attachment.admin[41]|e('js') }}';
                showSnackbar('{{ lang.mod_attachment.admin[41]|e('js') }}', 'error');
            };

            xhr.send(formData);
        });
    }

    if (uploadInput) {
        uploadInput.addEventListener('change', (event) => {
            if (event.target.files?.length) {
                uploadFiles(event.target.files);
                event.target.value = '';
            }
        });
    }

    if (uploadDropzone) {
        ['dragenter', 'dragover'].forEach((type) => {
            uploadDropzone.addEventListener(type, (event) => {
                event.preventDefault();
                uploadDropzone.classList.add('dragover');
            });
        });

        ['dragleave', 'drop'].forEach((type) => {
            uploadDropzone.addEventListener(type, (event) => {
                event.preventDefault();
                uploadDropzone.classList.remove('dragover');
            });
        });

        uploadDropzone.addEventListener('drop', (event) => {
            if (event.dataTransfer?.files?.length) {
                uploadFiles(event.dataTransfer.files);
            }
        });
    }
</script>
{% endblock %}
