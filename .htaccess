RewriteEngine On

RewriteRule ^robots\.txt$ robots.php [L]

# LLMS.txt AI Index Rewrites
RewriteRule ^llms\.txt$ llms.php [L]
RewriteRule ^llms-full\.txt$ llms.php?mode=full [L]
RewriteRule ^\.well-known/llms\.txt$ llms.php [L]
RewriteRule ^([a-z]{2,3})/llms\.txt$ llms.php?lang=$1 [L]
RewriteRule ^([a-z]{2,3})/llms-full\.txt$ llms.php?lang=$1&mode=full [L]

# Your existing rewrite rules
RewriteRule ^cache/js/(.*).js$ js.php?cachefile=$1 [L]
RewriteRule ^cache/css/(.*).css$ css.php?cachefile=$1 [L]
RewriteRule ^r/(.*)/f/(.*)\.(gif|jpe?g|png)$ resize.php?file=$2.$3&options=$1 [L]

# Sitemap Rewrites
RewriteRule ^sitemap\.xml$ index.php [L]
RewriteRule ^([a-z]{2,3})/sitemap\.xml$ index.php [L]
RewriteRule ^([a-z]{2,3})/rss\.xml$ index.php [L]
RewriteRule ^([a-z]{2,3})/(news|publication|category|page)Sitemap\.xml$ index.php [L]

# Legacy Redirects
RewriteRule ^nuce/(.*)$ index.php [L]
RewriteRule ^tekst/(.*)$ index.php [L]

# Root Brand Asset Rewrites (Fallback for direct /favicon.ico and manifest requests)
RewriteRule ^favicon\.ico$ static/mod_settings/favicon.ico [L]
RewriteRule ^favicon-96x96\.png$ static/mod_settings/favicon-96x96.png [L]
RewriteRule ^apple-touch-icon\.png$ static/mod_settings/apple-touch-icon.png [L]
RewriteRule ^site\.webmanifest$ static/mod_settings/site.webmanifest [L]

# Front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Security headers
Header always set X-Content-Type-Options nosniff
Header always set X-Frame-Options DENY
Header always set X-XSS-Protection "1; mode=block"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header always set Cross-Origin-Opener-Policy "same-origin"

# Disable directory browsing
Options All -Indexes

# Leverage browser caching with mod_expires
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
</IfModule>

# Cache-Control and CORS headers
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|webp|jpe?g|png|gif|svg|woff2?|ttf|otf|eot|css|js)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font\.css|css|webmanifest|json)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
